; 语言内标准库：前端装配期并入每个模块，不需要 import；用户写同名项时那份生效，本文件对应项不参与本次编译。
; 注意  成员形态只收宿主原生尚未提供的；与原生同名的条目会经 body-first 通道压过原生实现，不写在这里。
; 函数形态收需要元素类型参数的算法，首参是容器；调用点须写显式类型实参。
((String))
; 两端去空格：只剥 U+0020，与 trimLeft / trimRight 同口径；制表符不算空白。
trim|self() -> (String,):
    return self.trimLeft().trimRight()
; 前缀判定：长度不足即假，否则按 slice 逐字素比较；空前缀恒真（slice(0, 0) 得空串）。
startsWith|self(prefix: String,) -> (Bool,):
    var m = len(prefix)
    if m > len(self):
        return false
    return self.slice(0, m) == prefix
; 后缀判定：与前缀同规，比较尾部切片；空后缀恒真。
endsWith|self(suffix: String,) -> (Bool,):
    var n = len(self)
    var m = len(suffix)
    if m > n:
        return false
    return self.slice(n - m, n) == suffix
; 全部替换：按子串匹配，不做字符集解释；空模板原样返回，不插入也不删除。
replace|self(old: String, new: String,) -> (String,):
    var n = len(self)
    var m = len(old)
    if m == 0:
        return self
    var out = ""
    var i = 0
    while i < n:
        if i + m <= n:
            if self.slice(i, i + m) == old:
                out = out + new
                i = i + m
            else:
                out = out + self.slice(i, i + 1)
                i = i + 1
        else:
            out = out + self.slice(i, i + 1)
            i = i + 1
    return out
; 重复拼接：次数非正得空串；次数按入参原样消费，不夹取上限。
repeat|self(times: I32,) -> (String,):
    var out = ""
    var i = 0
    while i < times:
        out = out + self
        i = i + 1
    return out
; 左填充：目标宽度按字素计，填充串整体重复到够宽再截断；空填充串原样返回。
padLeft|self(width: I32, fill: String,) -> (String,):
    var n = len(self)
    var m = len(fill)
    if m == 0:
        return self
    if n >= width:
        return self
    var out = ""
    var need = width - n
    while len(out) < need:
        out = out + fill
    if len(out) > need:
        out = out.slice(0, need)
    return out + self
; 右填充：与左填充同规，填充串接在接收者之后。
padRight|self(width: I32, fill: String,) -> (String,):
    var n = len(self)
    var m = len(fill)
    if m == 0:
        return self
    if n >= width:
        return self
    var out = ""
    var need = width - n
    while len(out) < need:
        out = out + fill
    if len(out) > need:
        out = out.slice(0, need)
    return self + out
; 末次出现：与 indexOf 同规取字素下标；空模板答 len(self)，缺席答 -1。
lastIndexOf|self(needle: String,) -> (I32,):
    var n = len(self)
    var m = len(needle)
    if m == 0:
        return n
    var i = n - m
    while i >= 0:
        if self.slice(i, i + m) == needle:
            return i
        i = i - 1
    return -1
; 判空：按字素数判定，空白不算空；口径与 len 一致。
isEmpty|self() -> (Bool,):
    return len(self) == 0
; 计数：按子串非重叠匹配；空模板答零，与 replace 的空模板口径一致。
count|self(sub: String,) -> (I32,):
    var n = len(self)
    var m = len(sub)
    if m == 0:
        return 0
    var total = 0
    var i = 0
    while i + m <= n:
        if self.slice(i, i + m) == sub:
            total = total + 1
            i = i + m
        else:
            i = i + 1
    return total
; 去前缀：首段相等才剥，未命中原样返回；空前缀剥出空段，结果仍是原串。
stripPrefix|self(prefix: String,) -> (String,):
    var m = len(prefix)
    if m > len(self):
        return self
    if self.slice(0, m) == prefix:
        return self.slice(m, len(self))
    return self
; 去后缀：尾段相等才剥，未命中原样返回；尾部切片按字素下标。
stripSuffix|self(suffix: String,) -> (String,):
    var n = len(self)
    var m = len(suffix)
    if m > n:
        return self
    if self.slice(n - m, n) == suffix:
        return self.slice(0, n - m)
    return self
; 补前缀：已带前缀则原样返回，否则拼在前面；空前缀恒判为已带。
ensurePrefix|self(prefix: String,) -> (String,):
    var m = len(prefix)
    if m > len(self):
        return prefix + self
    if self.slice(0, m) == prefix:
        return self
    return prefix + self
; 补后缀：已带后缀则原样返回，否则拼在后面；空后缀恒判为已带。
ensureSuffix|self(suffix: String,) -> (String,):
    var n = len(self)
    var m = len(suffix)
    if m > n:
        return self + suffix
    if self.slice(n - m, n) == suffix:
        return self
    return self + suffix
; 逆序：按字素倒拼成新串，接收者不动；空串得空串。
reversed|self() -> (String,):
    var out = ""
    var i = len(self) - 1
    while i >= 0:
        out = out + self.slice(i, i + 1)
        i = i - 1
    return out
; 首字母大写：只抬首字素，其余原样；空串得空串。
capitalized|self() -> (String,):
    if len(self) == 0:
        return self
    return self.slice(0, 1).upper() + self.slice(1, len(self))
; 居中：左右均分填充，奇数余量给右侧；空填充或已够宽原样返回。
center|self(width: I32, fill: String,) -> (String,):
    var n = len(self)
    var m = len(fill)
    if m == 0:
        return self
    if n >= width:
        return self
    var need = width - n
    var left = need / 2
    var right = need - left
    var lpad = ""
    while len(lpad) < left:
        lpad = lpad + fill
    if len(lpad) > left:
        lpad = lpad.slice(0, left)
    var rpad = ""
    while len(rpad) < right:
        rpad = rpad + fill
    if len(rpad) > right:
        rpad = rpad.slice(0, right)
    return lpad + self + rpad
; 截断：取前 width 个字素；非正宽度得空串，越界得原串。
truncate|self(width: I32,) -> (String,):
    if width <= 0:
        return ""
    if width >= len(self):
        return self
    return self.slice(0, width)

; 容器算法：泛型自由函数，首参是容器，调用点须写显式类型实参（`map<I32>(...)`）。
; 注意  不提供同名成员：扩展块写不出泛型成员，两套入口会让调用点无从选择。
; 映射：元素类型不变——空 `Array<U>` 在当前语言里构造不出，故不做跨类型映射。
map|func<T>(arr: Array<T>, f: (T,) -> (T,),) -> (Array<T>,):
    var out = arr.slice(0, 0)
    var i = 0
    while i < len(arr):
        out = out.append(f(arr[i]))
        i = i + 1
    return out

; 筛选：保持原序，谓词为真才保留；空数组得空数组。
filter|func<T>(arr: Array<T>, keep: (T,) -> (Bool,),) -> (Array<T>,):
    var out = arr.slice(0, 0)
    var i = 0
    while i < len(arr):
        if keep(arr[i]):
            out = out.append(arr[i])
        i = i + 1
    return out

; 归约：初值类型即结果类型，逐元素折叠；空数组答初值。
reduce|func<T, R>(arr: Array<T>, initial: R, combine: (R, T,) -> (R,),) -> (R,):
    var acc = initial
    var i = 0
    while i < len(arr):
        acc = combine(acc, arr[i])
        i = i + 1
    return acc

; 遍历：只按序读一遍，返回值是空元组；副作用全在回调里。
forEach|func<T>(arr: Array<T>, visit: (T,) -> (),) -> ():
    var i = 0
    while i < len(arr):
        visit(arr[i])
        i = i + 1
    return

; 逆序：产出副本，接收者不动；空数组得空数组。
reverse|func<T>(arr: Array<T>,) -> (Array<T>,):
    var out = arr.slice(0, 0)
    var i = len(arr) - 1
    while i >= 0:
        out = out.append(arr[i])
        i = i - 1
    return out

; 拼接：先左后右，两份都保留；副本语义与 `slice` 一致，接收者不动。
concat|func<T>(a: Array<T>, b: Array<T>,) -> (Array<T>,):
    var out = a
    var i = 0
    while i < len(b):
        out = out.append(b[i])
        i = i + 1
    return out

; 取前 n 个：边界语义与 `slice(0, n)` 相同，负索引从尾部计，越界夹紧。
take|func<T>(arr: Array<T>, n: I32,) -> (Array<T>,):
    return arr.slice(0, n)

; 跳过前 n 个：边界语义与 `slice(n, len(arr))` 相同，负索引从尾部计。
drop|func<T>(arr: Array<T>, n: I32,) -> (Array<T>,):
    return arr.slice(n, len(arr))

; 存在判定：谓词首次为真即真；空数组得假。
any|func<T>(arr: Array<T>, pred: (T,) -> (Bool,),) -> (Bool,):
    var i = 0
    while i < len(arr):
        if pred(arr[i]):
            return true
        i = i + 1
    return false

; 全称判定：谓词首次为假即假；空数组得真。
all|func<T>(arr: Array<T>, pred: (T,) -> (Bool,),) -> (Bool,):
    var i = 0
    while i < len(arr):
        if pred(arr[i]):
            i = i + 1
        else:
            return false
    return true

; 条件计数：逐元素读谓词，只累加真值；空数组得零。
countWhere|func<T>(arr: Array<T>, pred: (T,) -> (Bool,),) -> (I32,):
    var total = 0
    var i = 0
    while i < len(arr):
        if pred(arr[i]):
            total = total + 1
        i = i + 1
    return total

; 首命中下标：谓词为真即返数组下标；缺席答 -1，与 indexOf 同口径。
findIndex|func<T>(arr: Array<T>, pred: (T,) -> (Bool,),) -> (I32,):
    var i = 0
    while i < len(arr):
        if pred(arr[i]):
            return i
        i = i + 1
    return -1

; 取末 n 个：n 非正得空副本，越界夹紧为整份；接收者不动。
takeLast|func<T>(arr: Array<T>, n: I32,) -> (Array<T>,):
    if n <= 0:
        return arr.slice(0, 0)
    if n >= len(arr):
        return arr
    return arr.slice(len(arr) - n, len(arr))

; 弃末 n 个：n 非正得整份，越界得空副本；接收者不动。
dropLast|func<T>(arr: Array<T>, n: I32,) -> (Array<T>,):
    if n <= 0:
        return arr
    if n >= len(arr):
        return arr.slice(0, 0)
    return arr.slice(0, len(arr) - n)

; 整份重复：次数非正得空副本，逐次追加整份；接收者不动。
repeatElements|func<T>(arr: Array<T>, times: I32,) -> (Array<T>,):
    var out = arr.slice(0, 0)
    var k = 0
    var i = 0
    while k < times:
        i = 0
        while i < len(arr):
            out = out.append(arr[i])
            i = i + 1
        k = k + 1
    return out

; 轮转：把前 n 个移到末尾，n 按长度取模；空数组得空副本。
rotate|func<T>(arr: Array<T>, n: I32,) -> (Array<T>,):
    var count = len(arr)
    if count == 0:
        return arr.slice(0, 0)
    var shift = n % count
    if shift < 0:
        shift = shift + count
    var out = arr.slice(0, 0)
    var i = shift
    while i < count:
        out = out.append(arr[i])
        i = i + 1
    i = 0
    while i < shift:
        out = out.append(arr[i])
        i = i + 1
    return out

; 插位：下标夹紧到两端，在该位之前插入；接收者不动。
insertAt|func<T>(arr: Array<T>, index: I32, value: T,) -> (Array<T>,):
    var count = len(arr)
    var at = index
    if at < 0:
        at = 0
    if at > count:
        at = count
    var out = arr.slice(0, 0)
    var i = 0
    while i < at:
        out = out.append(arr[i])
        i = i + 1
    out = out.append(value)
    while i < count:
        out = out.append(arr[i])
        i = i + 1
    return out

; 删位：下标越界原样返回；否则跳过该位复制一份，接收者不动。
removeAt|func<T>(arr: Array<T>, index: I32,) -> (Array<T>,):
    var count = len(arr)
    if index < 0:
        return arr
    if index >= count:
        return arr
    var out = arr.slice(0, 0)
    var i = 0
    while i < count:
        if i != index:
            out = out.append(arr[i])
        i = i + 1
    return out
