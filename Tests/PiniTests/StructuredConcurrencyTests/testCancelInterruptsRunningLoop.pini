spin|func() => (I32,):
    var i = 0
    while i < 200000000:
        i = i + 1
    print("循环跑完了")
    return ok(i)

main|func() -> ():
    var t = spin()
    sleep(80)
    t.cancel()
    var r = wait t
    match r:
        case ok(v):
            print("完成")
        case err(e):
            if isCancel(e):
                print("已取消")
            return
    sleep(200)
    print("主流程结束")
    return