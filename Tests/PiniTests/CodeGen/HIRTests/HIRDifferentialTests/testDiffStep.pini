; while / for-in step blocks (per-iteration tail, `break` skips it). The
; HIR pipeline used to drop the step block silently — the capability sweep
; only checks that emission succeeds, so examples/step.pini showed a false
; PASS. This fixture pins the real semantics against the interpreter.
main|func() -> ():
    ; 1) while step runs once per normal body end
    var i = 0
    while i < 3:
        print(i)
        i = i + 1
    step:
        print("step")

    ; 2) break skips the step block of the loop being left
    var k = 0
    while k < 5:
        print(k)
        k = k + 1
        if k == 3:
            break
    step:
        print("skipped")

    ; 3) for-in step runs per element, and the pattern variable stays in
    ; scope there (the interpreter runs step in the loop environment)
    for (v,) in [10, 20, 30]:
        print(v)
    step:
        print(v + 1)
    return
