main|func() -> ():
    ; continue: skip evens, print odds
    var j = 0
    while j < 6:
        j = j + 1
        if j % 2 == 0:
            continue
        print(j)

    ; labeled break from inner loop (ADR-014)
    var k = 0
    outer|while k < 3:
        var m = 0
        while m < 5:
            if m == 2:
                break outer
            print(m)
            m = m + 1
        k = k + 1
    return
