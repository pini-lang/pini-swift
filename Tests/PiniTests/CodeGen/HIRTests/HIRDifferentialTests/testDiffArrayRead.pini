; G2 batch 1 (array read path): literal, subscript read, len, nested read.
; Interpreter parity: the HIR pipeline must print byte-identical output.
; Element types covered: I32 / String / Bool / F64 / nested array.
main|func() -> ():
    let a = [10, 20, 30]
    print(a[1])
    print(len(a))
    let s = ["hello", "world"]
    print(s[1])
    print(len(s))
    let b = [true, false, true]
    print(b[0])
    let f = [2.5, 4.5]
    print(f[0])
    let m = [["a", "b"], ["c", "d"]]
    print(m[0][1])
    print(len(m))
    return
