main|func() -> ():
    ; readFile caps a single read at 64 KiB. The fixture builds its own
    ; 131072-byte file (13 doublings of a 16-byte chunk, so the cost is one
    ; pass rather than a quadratic build) and prints only the length: a capped
    ; read reports 65536, an uncapped one 131072. The body is deliberately
    ; never printed — both harness channels bind a pipe and drain it only
    ; after the child exits, so 64 KiB of stdout deadlocks instead of failing.
    var path = "/tmp/pini-hir-diff-big.txt"
    var big = "0123456789abcdef"
    var i = 0
    while i < 13:
        big = big + big
        i = i + 1
    writeFile(path, big)
    print(len(readFile(path)))
    return
