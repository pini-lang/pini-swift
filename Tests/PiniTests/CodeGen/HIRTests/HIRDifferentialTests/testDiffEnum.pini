; G4 batch 1: enum declaration with associated values, bare case
; constructors, enum-typed parameters, match with positional bindings.
; Interpreter parity (expected: 12.56636 / 12.0).
[形状]
圆(F64,)
矩形(F64, F64,)

面积|func(s: 形状,) -> (F64,):
    match s:
        case 圆(r,):
            return 3.14159 * r * r
        case 矩形(w, h,):
            return w * h

main|func() -> ():
    let c = 圆(2.0,)
    let r = 矩形(3.0, 4.0,)
    print(面积(c))
    print(面积(r))
    return
