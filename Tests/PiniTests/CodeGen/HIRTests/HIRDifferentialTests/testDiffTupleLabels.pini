; 元组：具名返回分量的标签模型（两条标签规则各走一遍）
; 运行：pini run Tests/PiniTests/CodeGen/HIRTests/HIRDifferentialTests/testDiffTupleLabels.pini
; 预期：[商: 3, 余: 2] / 3 / [商: 3, 余: 2] / [商: 3, 余: 2] / [商: 3, 余: 2]
;
; 说明：具名返回类型 `-> (商: I32, 余: I32,)` 写下的分量名，解释器只在两处补写：
;       ① 显式 `return` 出口；② 带元组注解的绑定。本夹具把两条规则各走一遍，并含一个
;       不经绑定的直接调用作对照——标签属于值，不属于静态类型，三种写法必须同形。
;       注：不经 `return` 的隐式尾表达式不补写标签（解释器的隐式路径原样返回末值），
;       该形状另行立案跟踪（元组标签绑定规则，2026-09-13）。

除余|func(a: I32, b: I32,) -> (商: I32, 余: I32,):
    return (a / b, a % b)

位置|func(a: I32, b: I32,) -> ((I32, I32,),):
    return (a / b, a % b)

main|func() -> ():
    let r = 除余(17, 5)
    print(r)
    print(r.商)
    print(除余(17, 5))
    let t: (商: I32, 余: I32,) = (3, 2)
    print(t)
    let u: (商: I32, 余: I32,) = 位置(17, 5)
    print(u)
    return
