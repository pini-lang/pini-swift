main|func() -> ():
    ; 1) array: single-field pattern binding
    var acc = 0
    for (v,) in [1, 2, 3]:
        acc = acc + v
    print(acc)

    ; 2) dictionary: (k, v) two-field pattern
    let ages = ["Alice"= 30, "Bob"= 25]
    var total = 0
    for (k, v,) in ages:
        total = total + v
    print(total)

    ; 3) `_` placeholder (iteration count only)
    var cnt = 0
    for (_ ,) in [7, 8, 9]:
        cnt = cnt + 1
    print(cnt)

    ; 4) labeled break (ADR-014): single-level exit
    var s = 0
    outer|for (v,) in [1, 2, 3, 4]:
        if v == 3:
            break outer
        s = s + v
    print(s)

    ; 5) nested array iteration
    var nested = 0
    for (row,) in [[1, 2], [3, 4]]:
        nested = nested + row[0] + row[1]
    print(nested)
    return
