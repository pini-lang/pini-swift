; G40 LazyRef lazy-reference semantics (G13 batch 1: HIR channel parity).
; Semantics under test:
;   - LazyRef<T>(initializer closure): first .value access runs the closure
;     once (prints "init" exactly once) and caches; later accesses return
;     the cache.
;   - Copying the handle shares the same box (reference semantics): s.value
;     must NOT re-run the initializer.

main|func() -> ():
    var r = LazyRef<I32>(func () -> (I32,):
        print("init")
        return 42
    )
    ; first access triggers initialization (prints init once), then cache
    print(r.value)
    print(r.value)
    ; copy shares the same cache (reference semantics)
    var s = r
    print(s.value)
    return
