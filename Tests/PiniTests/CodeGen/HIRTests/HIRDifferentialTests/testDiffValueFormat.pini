; G2b batch 1: value formatting — print(array) recursive (strings raw,
; ", " separator, empty [], bools, F64 shortest round-trip, nested) and
; print(optional) some(v)/none. Interpreter parity.
main|func() -> ():
    print(["a", "b"])
    print([[1, 2], [3, 4]])
    print([true, false])
    print([2.5, 0.1])
    var w = [1, 2, 3]
    print(w.get(1))
    print(w.get(9))
    return
