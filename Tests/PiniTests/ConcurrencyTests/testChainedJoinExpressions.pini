makeOne|func() => (I32,)
    return ok(1)

addOne|func(x: I32,) => (I32,)
    return ok(x + 1)

main|func() -> ()
    var r1 = wait makeOne()
    match r1:
        case ok(a):
            var r2 = wait addOne(a)
            match r2:
                case ok(b):
                    print(b)
                case err(e):
                    print(e)
        case err(e):
            print(e)
    return