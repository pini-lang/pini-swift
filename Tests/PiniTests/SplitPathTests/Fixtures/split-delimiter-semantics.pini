; 判据：`split` 的定界符语义两路一致。LLVM 侧若把定界符当字符集、且空定界符不匹配任何字符，
;   `"ab\ncd".split("")` 只给 1 个元素（整串），解释器给 5（逐字素）—— 自举 `textAtoms` 正是 `text.split("")`。
; 权威 = 解释器：空定界符逐字素 · 非空按子串 · 省略空子序列；第 10 项是强阳性对照（组合序列应为 1）。
show|func(tag: String, parts: Array<String>,) -> ():
    print("\(tag)|len=\(len(parts))")
    var i = 0
    while i < len(parts):
        print("\(tag)|[\(i)]=\(parts[i])")
        i = i + 1
    return

main|func() -> ():
    show(tag = "1-single", parts = "a,b,c".split(","))
    show(tag = "2-multichar", parts = "a::b::c".split("::"))
    show(tag = "3-nomatch", parts = "ab".split("Xb"))
    show(tag = "4-empty-delim", parts = "ab".split(""))
    show(tag = "5-empty-src", parts = "".split(","))
    show(tag = "6-empty-both", parts = "".split(""))
    show(tag = "7-trailing", parts = "a\n".split("\n"))
    show(tag = "8-blank-line", parts = "a\n\nb".split("\n"))
    show(tag = "9-cjk", parts = "色彩".split(""))
    show(tag = "10-grapheme", parts = ("e" + chr(769)).split(""))
    show(tag = "11-tab", parts = "a\tb".split("\t"))
    return
