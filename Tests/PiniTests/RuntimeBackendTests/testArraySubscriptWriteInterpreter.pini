main|func() -> ()
    var a = [1, 2, 3]
    a[0] = 10
    a[1] = 20
    match a[1]:
        case some(v):
            a[1] = v + 5
        case none:
            break
    print(a[0])
    print(a[1])
    print(a[2])
    var m = [[1, 2], [3, 4]]
    var mrow = unsafe m[0]!
    mrow[1] = 99
    m[0] = mrow
    print(unsafe m[0]![1]!)
    var s = ["a", "b"]
    s[0] = "z"
    print(s[0])
    var b = [true, false]
    b[0] = false
    print(b[0])
    return