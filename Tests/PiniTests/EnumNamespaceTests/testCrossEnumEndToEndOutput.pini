[形状]
圆(F64,)
矩形(F64, F64,)
[几何]
圆(F64, F64,)
线(F64,)

取形状半径|func(s: 形状,) -> (F64,)
    match s:
        case 圆(r):
            return r
        case 矩形(w, h):
            return w
    return 0.0

main|func() -> ()
    print(取形状半径(形状.圆(2.0)),)
    print(取形状半径(形状.矩形(3.0, 4.0)),)
    print(形状.圆(2.0),)
    print(几何.圆(0.0, 3.0),)
    return