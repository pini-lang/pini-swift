#!/usr/bin/env bash
# hooks/commit-msg — AST 走查冻结门槛（docs/hir-ast-walk-freeze.md §1）
# 启用：git config core.hooksPath hooks
#
# 冻结 = 改动须声明，不是禁止改动。命中冻结面而提交信息没有 [ast-walk] 标记
# 即拒绝；带上标记并说明理由即可通过。判据与误报性质见上述文档 §2。
set -euo pipefail

root="$(git rev-parse --show-toplevel)"
msg="$1"

# 合并提交不声明：它本身不带新改动，两侧的提交已各自过闸。
if git rev-parse -q --verify MERGE_HEAD >/dev/null; then
  exit 0
fi

py=""
for cand in python3 python3.13 python3.12 python3.11; do
  if command -v "$cand" >/dev/null 2>&1; then
    py="$cand"
    break
  fi
done
if [ -z "$py" ]; then
  echo "    ast-walk freeze: skipped, no python3 found" >&2
  exit 0
fi

"$py" "$root/tools/ast-walk-freeze-check.py" --message-file "$msg" || exit 1
exit 0
