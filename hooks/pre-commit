#!/usr/bin/env bash
# hooks/pre-commit — 提交前门禁：① 身份登记 ② 注释判据 ③ 格式判据 ④ 合并提交再跑整条本地 CI。
# 启用：git config core.hooksPath "$(git rev-parse --show-toplevel)/hooks"
set -uo pipefail

root="$(git rev-parse --show-toplevel 2>/dev/null || echo "$PWD")"
cd "$root" || exit 1

name="$(git config user.name 2>/dev/null || true)"
email="$(git config user.email 2>/dev/null || true)"
if [ -z "$name" ] || [ -z "$email" ]; then
    echo " 行不通  [身份] user.name / user.email 未设置；先按 GIT_WORKFLOW 登记并配置" >&2
    exit 1
fi
if ! grep -Fq "| $name | $email |" GIT_WORKFLOW.md 2>/dev/null; then
    echo " 行不通  [身份] $name <$email> 未在 GIT_WORKFLOW.md 注册表登记" >&2
    echo "   已登记身份见该文件的贡献者注册表；登记后才允许提交。" >&2
    exit 1
fi

bash hooks/comment-lint.sh || exit 1

# 格式门禁：产物须与源码同批，旧产物会把新打印器的判据读成绿。
if [ ! -x "$root/.build/debug/pini" ]; then
    echo " 行不通  [格式] 缺 .build/debug/pini；先 swift build 再提交" >&2
    exit 1
fi
PINI_BIN="$root/.build/debug/pini" python3 tools/fmt-gate.py || exit 1

# 合并提交要把整棵树验一遍：并回主干就是待推送状态，等推送再验已经晚了。
# PINI_MERGE_GATE 由 pre-merge-commit 置位（那时 MERGE_HEAD 还没写），MERGE_HEAD 覆盖拦下后补的 git commit。
if [ -n "${PINI_MERGE_GATE:-}" ] || [ -e "$(git rev-parse --git-path MERGE_HEAD)" ]; then
    # 合并提交即待推送状态：只认容器里的 Linux 读数 —— 宿主的系统 · LLVM · 编译器分支都不同。
    # 行不通  宿主上直接跑 `ci/entrypoint.sh` 时，`#if canImport(Darwin)` 之外的代码从不参与编译。
    if ! docker info >/dev/null 2>&1; then
        echo " 行不通  [容器] Docker daemon 未运行，Linux 全量门禁无法执行" >&2
        echo "   先启动 daemon（macOS 用 open -a Docker；Linux 用 systemctl start docker），再重试。" >&2
        echo "   宿主读数与远程不可比，故不降级放行。" >&2
        exit 1
    fi
    PINI_CI_SKIP_BUILD=1 bash ci/run.sh || exit 1
fi

exit 0
