; 正例判据：十八个成员的代表值与边界；期望按规范手写。
标准库判据|test() -> ():
    assert(修剪(s = "  pad  ") == "pad", "trim 两端去空格")
    assert(修剪(s = "\tpad\t") == "\tpad\t", "trim 不剥制表符")
    assert(前缀(s = "hello", p = "he"), "前缀命中")
    assert(前缀(s = "hello", p = ""), "空前缀恒真")
    assert(!前缀(s = "hello", p = "hello!"), "前缀长于接收者即假")
    assert(前缀(s = "皮尼", p = "皮"), "中文前缀按字素比较")
    assert(后缀(s = "hello", p = "lo"), "后缀命中")
    assert(后缀(s = "hello", p = ""), "空后缀恒真")
    assert(!后缀(s = "hello", p = "hello!"), "后缀长于接收者即假")
    assert(后缀(s = "皮尼", p = "尼"), "中文后缀按字素比较")
    assert(替换(s = "abc", old = "", replacement = "x") == "abc", "空模板原样返回")
    assert(替换(s = "aaaa", old = "aa", replacement = "b") == "bb", "替换按非重叠匹配")
    assert(替换(s = "abc", old = "z", replacement = "x") == "abc", "缺席模板原样返回")
    assert(重复(s = "ab", times = 0) == "", "零次得空串")
    assert(重复(s = "ab", times = -1) == "", "负次得空串")
    assert(重复(s = "ab", times = 2) == "abab", "重复两次")
    assert(左填(s = "7", width = 3, fill = "0") == "007", "左填到三位")
    assert(左填(s = "7", width = 1, fill = "0") == "7", "已够宽原样返回")
    assert(左填(s = "7", width = 4, fill = "ab") == "aba7", "多字符填充截断到所需宽度")
    assert(左填(s = "7", width = 3, fill = "") == "7", "空填充原样返回")
    assert(右填(s = "7", width = 3, fill = "0") == "700", "右填到三位")
    assert(右填(s = "7", width = 1, fill = "0") == "7", "右填已够宽原样返回")
    assert(右填(s = "7", width = 4, fill = "ab") == "7aba", "右填多字符截断")
    assert(右填(s = "7", width = 3, fill = "") == "7", "右填空填充原样返回")
    assert(末位(s = "abcabc", needle = "bc") == 4, "末次出现按字素下标")
    assert(末位(s = "abc", needle = "z") == -1, "缺席答负一")
    assert(末位(s = "abc", needle = "") == 3, "空模板答长度")
    assert(判空(s = ""), "空串判空")
    assert(!判空(s = " "), "空白不算空")
    assert(!判空(s = "皮"), "单字素不为空")
    assert(计数(s = "aaaa", sub = "aa") == 2, "计数按非重叠匹配")
    assert(计数(s = "abc", sub = "") == 0, "空模板计数为零")
    assert(计数(s = "abc", sub = "z") == 0, "缺席子串计数为零")
    assert(去前缀(s = "prefix-body", prefix = "prefix-") == "body", "命中前缀即剥")
    assert(去前缀(s = "body", prefix = "prefix-") == "body", "未命中原样返回")
    assert(去前缀(s = "body", prefix = "") == "body", "空前缀剥出空段仍原样")
    assert(去后缀(s = "body-suffix", suffix = "-suffix") == "body", "命中去后缀")
    assert(去后缀(s = "body", suffix = "-suffix") == "body", "未命中去后缀原样")
    assert(去后缀(s = "body", suffix = "") == "body", "空后缀去后原样")
    assert(补前缀(s = "body", prefix = "prefix-") == "prefix-body", "缺前缀即补")
    assert(补前缀(s = "prefix-body", prefix = "prefix-") == "prefix-body", "已有前缀不重复")
    assert(补前缀(s = "body", prefix = "") == "body", "空前缀恒判已带")
    assert(补后缀(s = "body", suffix = "-suffix") == "body-suffix", "缺后缀即补")
    assert(补后缀(s = "body-suffix", suffix = "-suffix") == "body-suffix", "已有后缀不重复")
    assert(补后缀(s = "body", suffix = "") == "body", "空后缀恒判已带")
    assert(逆序(s = "皮尼") == "尼皮", "逆序按字素倒拼")
    assert(逆序(s = "") == "", "空串逆序为空")
    assert(首大(s = "pini") == "Pini", "只抬首字素")
    assert(首大(s = "") == "", "空串首大仍空")
    assert(首大(s = "皮尼") == "皮尼", "中文首字素大写不变")
    assert(居中(s = "x", width = 5, fill = "-") == "--x--", "居中左右均分")
    assert(居中(s = "x", width = 6, fill = "-") == "--x---", "奇数余量给右侧")
    assert(居中(s = "x", width = 1, fill = "-") == "x", "已够宽原样返回")
    assert(居中(s = "x", width = 5, fill = "") == "x", "空填充原样返回")
    assert(截断(s = "皮尼语言", width = 2) == "皮尼", "截断按字素取前段")
    assert(截断(s = "abc", width = 0) == "", "零宽得空串")
    assert(截断(s = "abc", width = -1) == "", "负宽得空串")
    assert(截断(s = "abc", width = 10) == "abc", "越界得原串")
    return
