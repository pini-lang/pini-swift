; 正例判据：算法库逐条断言；期望按规范手写，边界取空、越界与负索引。
算法判据|test() -> ():
    let 空数组: Array<I32> = []
    let 翻倍 = func (x: I32,) -> (I32,): return x * 2
    let 为偶 = func (x: I32,) -> (Bool,): return x % 2 == 0
    let 加 = func (a: I32, b: I32,) -> (I32,): return a + b
    let 印 = func (x: I32,) -> (): print(x)
    assert(翻倍(3) == 6, "闭包可调用")
    assert(加一(n = 1) == 2, "跨单元闭包")
    let 映 = map<I32>([1, 2, 3], 翻倍)
    assert(len(映) == 3, "map 保持长度")
    assert(映[1] == 4, "map 逐元素映射")
    let 空映 = map<I32>(空数组, 翻倍)
    assert(len(空映) == 0, "map 空数组得空")
    let 筛 = filter<I32>([1, 2, 3], 为偶)
    assert(len(筛) == 1, "filter 只保留为真")
    assert(筛[0] == 2, "filter 保持原序")
    let 空筛 = filter<I32>(空数组, 为偶)
    assert(len(空筛) == 0, "filter 空数组得空")
    let 和 = reduce<I32, I32>([1, 2, 3], 0, 加)
    assert(和 == 6, "reduce 从左折叠")
    let 初 = reduce<I32, I32>(空数组, 7, 加)
    assert(初 == 7, "reduce 空数组答初值")
    forEach<I32>([1, 2], 印)
    let 逆 = reverse<I32>([1, 2, 3])
    assert(逆[0] == 3, "reverse 逆序")
    assert(len(逆) == 3, "reverse 保持长度")
    let 空逆 = reverse<I32>(空数组)
    assert(len(空逆) == 0, "reverse 空数组得空")
    let 拼 = concat<I32>([1, 2], [3])
    assert(len(拼) == 3, "concat 拼接两份")
    assert(拼[2] == 3, "concat 先左后右")
    let 拼字 = concat<String>(["a"], ["b"])
    assert(len(拼字) == 2, "concat 字符串")
    let 取二 = take<I32>([1, 2, 3], 2)
    assert(len(取二) == 2, "take 前 n 个")
    let 取越 = take<I32>([1, 2, 3], 9)
    assert(len(取越) == 3, "take 越界夹紧")
    let 取负 = take<I32>([1, 2, 3], -1)
    assert(len(取负) == 2, "take 负索引从尾部计")
    let 跳一 = drop<I32>([1, 2, 3], 1)
    assert(跳一[0] == 2, "drop 跳过前 n 个")
    let 跳越 = drop<I32>([1, 2, 3], 9)
    assert(len(跳越) == 0, "drop 越界得空")
    let 真 = any<I32>([1, 2], 为偶)
    assert(真, "any 存在即真")
    let 假 = any<I32>(空数组, 为偶)
    assert(!假, "any 空数组得假")
    let 全真 = all<I32>([2, 4], 为偶)
    assert(全真, "all 全为真")
    let 空真 = all<I32>(空数组, 为偶)
    assert(空真, "all 空数组得真")
    let 不全 = all<I32>([1, 2], 为偶)
    assert(!不全, "all 见假即假")
    let 数 = countWhere<I32>([1, 2, 3, 4], 为偶)
    assert(数 == 2, "countWhere 只数真值")
    let 空数 = countWhere<I32>(空数组, 为偶)
    assert(空数 == 0, "countWhere 空数组得零")
    let 位 = findIndex<I32>([1, 2, 3], 为偶)
    assert(位 == 1, "findIndex 首命中下标")
    let 缺位 = findIndex<I32>([1, 3], 为偶)
    assert(缺位 == -1, "findIndex 缺席答负一")
    let 末二 = takeLast<I32>([1, 2, 3], 2)
    assert(len(末二) == 2, "takeLast 取末 n 个")
    assert(末二[0] == 2, "takeLast 顺序不变")
    let 末零 = takeLast<I32>([1, 2, 3], 0)
    assert(len(末零) == 0, "takeLast 零次得空")
    let 末越 = takeLast<I32>([1, 2, 3], 9)
    assert(len(末越) == 3, "takeLast 越界夹紧")
    let 弃二 = dropLast<I32>([1, 2, 3], 2)
    assert(len(弃二) == 1, "dropLast 弃末 n 个")
    assert(弃二[0] == 1, "dropLast 保留前段")
    let 弃越 = dropLast<I32>([1, 2, 3], 9)
    assert(len(弃越) == 0, "dropLast 越界得空")
    let 重 = repeatElements<I32>([1, 2], 2)
    assert(len(重) == 4, "repeatElements 整份重复")
    assert(重[2] == 1, "repeatElements 从首元素重来")
    let 重零 = repeatElements<I32>([1, 2], 0)
    assert(len(重零) == 0, "repeatElements 零次得空")
    let 轮 = rotate<I32>([1, 2, 3], 1)
    assert(轮[0] == 2, "rotate 前移")
    assert(轮[2] == 1, "rotate 尾部回绕")
    let 轮负 = rotate<I32>([1, 2, 3], -1)
    assert(轮负[0] == 3, "rotate 负位移从尾部补")
    let 轮满 = rotate<I32>([1, 2, 3], 3)
    assert(轮满[0] == 1, "rotate 取模回原位")
    let 插 = insertAt<I32>([1, 3], 1, 2)
    assert(len(插) == 3, "insertAt 插位")
    assert(插[1] == 2, "insertAt 在指定下标前插入")
    let 插前 = insertAt<I32>([1, 2], -5, 9)
    assert(插前[0] == 9, "insertAt 负下标夹到开头")
    let 插末 = insertAt<I32>([1, 2], 9, 9)
    assert(插末[2] == 9, "insertAt 越界夹到末尾")
    let 删 = removeAt<I32>([1, 2, 3], 1)
    assert(len(删) == 2, "removeAt 删一位")
    assert(删[0] == 1, "removeAt 保留前段")
    let 删越 = removeAt<I32>([1, 2, 3], 9)
    assert(len(删越) == 3, "removeAt 越界原样")
    let 删负 = removeAt<I32>([1, 2, 3], -1)
    assert(len(删负) == 3, "removeAt 负下标原样")
    let 有 = contains<I32>([1, 2], 2)
    assert(有, "contains 命中")
    let 无 = contains<I32>(空数组, 2)
    assert(!无, "contains 空数组得假")
    let 有字 = contains<String>(["a", "b"], "b")
    assert(有字, "contains 字符串")
    let 元位 = indexOfElement<I32>([1, 2, 3], 2)
    assert(元位 == 1, "indexOfElement 首次下标")
    let 元缺 = indexOfElement<I32>([1, 3], 2)
    assert(元缺 == -1, "indexOfElement 缺席答负一")
    let 独 = unique<I32>([1, 2, 1, 3, 2])
    assert(len(独) == 3, "unique 去掉重复")
    assert(独[2] == 3, "unique 维持首次出现序")
    let 空独 = unique<I32>(空数组)
    assert(len(空独) == 0, "unique 空数组得空")
    let 小 = minElement<I32>([3, 1, 2])
    assert(小 == 1, "minElement 取最小")
    let 单小 = minElement<I32>([5])
    assert(单小 == 5, "minElement 单元素答自身")
    let 大 = maxElement<I32>([3, 1, 2])
    assert(大 == 3, "maxElement 取最大")
    let 排 = sorted<I32>([3, 1, 2])
    assert(排[0] == 1, "sorted 升序")
    assert(排[2] == 3, "sorted 末位最大")
    let 空排 = sorted<I32>(空数组)
    assert(len(空排) == 0, "sorted 空数组得空")
    let 稳 = sorted<I32>([2, 1, 2])
    assert(稳[0] == 1, "sorted 稳定插入首段")
    let 有序 = isSorted<I32>([1, 2, 2])
    assert(有序, "isSorted 不降即有序")
    let 乱 = isSorted<I32>([2, 1])
    assert(!乱, "isSorted 见降即假")
    let 空序 = isSorted<I32>(空数组)
    assert(空序, "isSorted 空数组得真")
    let 单序 = isSorted<I32>([5])
    assert(单序, "isSorted 单元素得真")
    let 等同 = equalArrays<I32>([1, 2], [1, 2])
    assert(等同, "equalArrays 逐位相等")
    let 长短 = equalArrays<I32>([1], [1, 2])
    assert(!长短, "equalArrays 长度不等即假")
    let 差异 = equalArrays<I32>([1, 3], [1, 2])
    assert(!差异, "equalArrays 元素不等即假")
    let 空同 = equalArrays<I32>(空数组, 空数组)
    assert(空同, "equalArrays 空对空得真")
    return
