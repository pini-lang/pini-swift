[render_test|import]
_support = "../../support"

; 带主标签与备注的诊断渲染成固定形状：头行、主标签行、备注行。
渲染基本形状|test() -> ():
    let text = makeSourceText("main\nf\n")
    var d = makeDiagnostic(file = "a.pini", category = .categorySemantic, severity = .severityError, code = "E3-002", message = "未定义函数")
    d = d.addLabel(makeLabel(start = 5, end = 6, message = "此处使用", primary = true))
    d = d.addNote("检查拼写")
    let out = renderDiagnostic(d = d, text = text)
    assert(out == "a.pini:2:1: 语义错误 [E3-002] 未定义函数\n  主标签 2:1-2:2 此处使用\n  备注 检查拼写\n", out)
    return

; 主标签永远排在最前，其余标签保持登记顺序；头行位置取主标签起点。
主标签在前|test() -> ():
    let text = makeSourceText("0123456789")
    var d = makeDiagnostic(file = "a.pini", category = .categoryType, severity = .severityWarning, code = "E4-001", message = "示例")
    d = d.addLabel(makeLabel(start = 2, end = 3, message = "次", primary = false))
    d = d.addLabel(makeLabel(start = 6, end = 8, message = "主", primary = true))
    let out = renderDiagnostic(d = d, text = text)
    assert(out == "a.pini:1:7: 类型警告 [E4-001] 示例\n  主标签 1:7-1:9 主\n  次标签 1:3-1:4 次\n", out)
    return

; 没有标签的诊断只渲染头行，不带位置。
无标签只渲染头行|test() -> ():
    let text = makeSourceText("x\n")
    let d = makeDiagnostic(file = "a.pini", category = .categoryGeneral, severity = .severityNote, code = "E7-001", message = "请注意")
    let out = renderDiagnostic(d = d, text = text)
    assert(out == "a.pini: 备注 [E7-001] 请注意\n", out)
    return

; 标签没有说明时不留下行尾空格。
空标签说明|test() -> ():
    let text = makeSourceText("abcd")
    var d = makeDiagnostic(file = "a.pini", category = .categorySyntax, severity = .severityError, code = "E2-001", message = "示例")
    d = d.addLabel(makeLabel(start = 1, end = 3, message = "", primary = true))
    let out = renderDiagnostic(d = d, text = text)
    assert(out == "a.pini:1:2: 语法错误 [E2-001] 示例\n  主标签 1:2-1:4\n", out)
    return

; 跨文件按文件名序、同文件按起始偏移序；登记顺序不影响渲染结果。
顺序不影响结果|test() -> ():
    let textA = makeSourceText("0123456789\n")
    let textB = makeSourceText("xyz\n")
    var firstA = makeDiagnostic(file = "a.pini", category = .categorySemantic, severity = .severityError, code = "E3-002", message = "甲")
    firstA = firstA.addLabel(makeLabel(start = 1, end = 2, message = "一", primary = true))
    var laterA = makeDiagnostic(file = "a.pini", category = .categoryType, severity = .severityWarning, code = "E4-001", message = "乙")
    laterA = laterA.addLabel(makeLabel(start = 5, end = 6, message = "二", primary = true))
    var onlyB = makeDiagnostic(file = "b.pini", category = .categorySemantic, severity = .severityError, code = "E3-002", message = "丙")
    onlyB = onlyB.addLabel(makeLabel(start = 0, end = 1, message = "三", primary = true))
    var forward: Array<Diagnostic> = []
    forward = forward.append(firstA)
    forward = forward.append(laterA)
    forward = forward.append(onlyB)
    var backward: Array<Diagnostic> = []
    backward = backward.append(onlyB)
    backward = backward.append(laterA)
    backward = backward.append(firstA)
    let files: Array<String> = ["a.pini", "b.pini"]
    let texts: Array<SourceText> = [textA, textB]
    let one = renderAll(items = forward, files = files, texts = texts)
    let two = renderAll(items = backward, files = files, texts = texts)
    assert(one == two, "两种登记顺序应得同一输出")
    assert(one == "a.pini:1:2: 语义错误 [E3-002] 甲\n  主标签 1:2-1:3 一\na.pini:1:6: 类型警告 [E4-001] 乙\n  主标签 1:6-1:7 二\nb.pini:1:1: 语义错误 [E3-002] 丙\n  主标签 1:1-1:2 三\n", one)
    return

; 同一批诊断重复渲染逐字相同。
重复渲染相同|test() -> ():
    let text = makeSourceText("abc\n")
    var d = makeDiagnostic(file = "a.pini", category = .categorySemantic, severity = .severityError, code = "E3-002", message = "示例")
    d = d.addLabel(makeLabel(start = 0, end = 1, message = "甲", primary = true))
    var list: Array<Diagnostic> = []
    list = list.append(d)
    let files: Array<String> = ["a.pini"]
    let texts: Array<SourceText> = [text]
    let once = renderAll(items = list, files = files, texts = texts)
    let twice = renderAll(items = sortDiagnostics(list), files = files, texts = texts)
    assert(once == twice, "重复渲染应相同")
    return

; 找不到源文本的文件按无位置渲染，不崩也不借别的文件算行列。
未知文件不借位置|test() -> ():
    var d = makeDiagnostic(file = "missing.pini", category = .categoryIO, severity = .severityError, code = "E3-002", message = "读不到")
    d = d.addLabel(makeLabel(start = 3, end = 4, message = "", primary = true))
    var list: Array<Diagnostic> = []
    list = list.append(d)
    let files: Array<String> = ["a.pini"]
    let texts: Array<SourceText> = [makeSourceText("abcdef\n")]
    let out = renderAll(items = list, files = files, texts = texts)
    assert(out == "missing.pini: 输入输出错误 [E3-002] 读不到\n", out)
    return
