[location_test|import]
_support = "../../support"

; 行列都从 1 起；行首偏移落在列 1，行内偏移按标量数递增。
行首与行内|test() -> ():
    let text = makeSourceText("abc\ndef\n")
    let start = locationOf(text = text, offset = 0)
    assert(start.line == 1, "首行")
    assert(start.column == 1, "首列")
    let third = locationOf(text = text, offset = 2)
    assert(third.line == 1, "仍在第一行")
    assert(third.column == 3, "第三列")
    let second = locationOf(text = text, offset = 4)
    assert(second.line == 2, "第二行")
    assert(second.column == 1, "行首列 1")
    return

; 列按 Unicode 标量计，不按字节：一个中文字符只占一列。
多字节按标量计列|test() -> ():
    let text = makeSourceText("中文字")
    assert(locationOf(text = text, offset = 3).column == 2, "第二个标量在列 2")
    assert(locationOf(text = text, offset = 6).column == 3, "第三个标量在列 3")
    let mixed = makeSourceText("a中b")
    assert(locationOf(text = mixed, offset = 4).column == 3, "中之后的 b 在列 3")
    return

; 落在多字节序列中间的偏移回退到该标量起点，不多算一列。
标量中间回退|test() -> ():
    let text = makeSourceText("中")
    assert(locationOf(text = text, offset = 1).column == 1, "回退到标量起点")
    assert(locationOf(text = text, offset = 2).column == 1, "仍在同一标量内")
    assert(locationOf(text = text, offset = 3).column == 2, "越过标量后是列 2")
    return

; CRLF：回车属于行内容，行表只按 LF 换行。
回车计入列|test() -> ():
    let text = makeSourceText("a\r\nb")
    assert(locationOf(text = text, offset = 1).column == 2, "回车在列 2")
    let next = locationOf(text = text, offset = 3)
    assert(next.line == 2, "b 在第二行")
    assert(next.column == 1, "b 在列 1")
    return

; 越界与负偏移夹紧：负值按 0，超出按末尾。
偏移夹紧|test() -> ():
    let text = makeSourceText("ab")
    let before = locationOf(text = text, offset = -5)
    assert(before.line == 1, "负偏移在第一行")
    assert(before.column == 1, "负偏移在列 1")
    let after = locationOf(text = text, offset = 99)
    assert(after.line == 1, "末尾仍在第一行")
    assert(after.column == 3, "末尾是列 3")
    return

; 空文本答 1:1。
空文本|test() -> ():
    let text = makeSourceText("")
    let loc = locationOf(text = text, offset = 0)
    assert(loc.line == 1, "空文本第一行")
    assert(loc.column == 1, "空文本第一列")
    return
