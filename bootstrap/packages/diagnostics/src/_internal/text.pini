; 字节序比较：语言层的字符串没有大小比较，这里按 UTF-8 字节定序，结果与宿主无关。
compareText|func(left: String, right: String,) -> (I32,):
    let a = tempUtf8Bytes(left)
    let b = tempUtf8Bytes(right)
    var i = 0
    while i < len(a):
        if i >= len(b):
            return 1
        let x = tempByteToInt(a[i])
        let y = tempByteToInt(b[i])
        if x != y:
            if x < y:
                return -1
            return 1
        i = i + 1
    if i < len(b):
        return -1
    return 0

; 三值比较：小于 -1、相等 0、大于 1。
compareInt|func(left: I32, right: I32,) -> (I32,):
    if left < right:
        return -1
    if left > right:
        return 1
    return 0

; 续字节判据：0x80..0xBF；U8 不能直接与整数字面量比较，先取值。
isContinuationByte|func(byte: U8,) -> (Bool,):
    let value = tempByteToInt(byte)
    return value >= 128 && value < 192
