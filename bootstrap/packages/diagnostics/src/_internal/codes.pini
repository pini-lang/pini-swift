; 码的修复建议模板；没有建议答空串。
diagnosticSuggestion|func(_code: String,) -> (String,):
    if _code == "E1-004":
        return "删除它；标识符只用字母、数字、下划线与组合附加符号"
    if _code == "E1-005":
        return "把组合附加符号并到前一个字符上；它可以续写，不能作首字符"
    if _code == "E1-006":
        return "改用单一脚本；中文与拉丁的组合不受此限"
    if _code == "E3-001":
        return "你是想说 '{closest}' 吗？"
    if _code == "E3-002":
        return "你是想说 '{closest}' 吗？"
    if _code == "E3-003":
        return "你是想说 '{closest}' 吗？"
    if _code == "E3-013":
        return "use an explicit alias `alias = \"path\"` and call qualified as `alias.symbol"
    if _code == "E3-014":
        return "把表写成 `[(1, \"甲\"), (2, \"乙\")]` 这样的字面量；表绑定到变量当前不支持"
    if _code == "E3-015":
        return "让每行分量数与括号里的名字数相等；某个位置不要时写 `_`"
    if _code == "E3-016":
        return "换一个名字；模式名会被替换成字面量，体顶层也不声明局部变量（各轮共用一条语句列表）"
    if _code == "E3-017":
        return "删掉这条 unroll，或往表里补至少一行"
    if _code == "E3-018":
        return "把表拆成几条 unroll，或改用普通循环"
    if _code == "E3-019":
        return "两处只留一处；生成模块与手写块同名时，签名必须逐位一致"
    if _code == "E3-020":
        return "名字就是 C 符号名，只能用 ASCII 字母、数字与下划线，且不以数字开头"
    if _code == "E3-021":
        return "确认这次接口变化是有意的；有意则更新下游记录，无意说明包内公开面被意外改动"
    if _code == "E3-022":
        return "跨包只能引用目标包导出的名字；确认拼写，或让目标包导出它"
    if _code == "E4-028":
        return "C 边界只收 I8 / U8 / I32 / I64 / U64 / F64 / Bool / *T，以及形参位的 String"
    if _code == "E4-029":
        return "换成 I8 / I32 / I64 / U8 / U64 / F64 之一；U32 与 I16 这类宽度三条通道对不上"
    if _code == "E4-030":
        return "声明成 `*U8`，读出后用 `fromCString(指针)` 复制一份"
    if _code == "E4-031":
        return "实参位上写一个顶层自由函数的名字，签名与形参声明逐位相同，且不带 using"
    if _code == "E4-032":
        return "把回调的参数与返回改成 I32，两侧都按 0 / 非 0 解释"
    if _code == "E4-033":
        return "把 `|varargs` 写在函数条目上；数据符号只有读与写，没有调用点"
    if _code == "E4-034":
        return "变参尾只收 I8 / U8 / I32 / I64 / U64 / F64 / Bool / *T / String；对象与集合没有 C 布局"
    if _code == "E4-035":
        return "写在 `[名称|foreign]` 的符号声明里，或写在带 `|c` 条目的函数签名上；普通变量、字段与方法不收句柄"
    if _code == "E4-036":
        return "在实参前写 '{param} = '；若这个参数本就该按位置传，把声明改成 '_{param}: ...'"
    if _code == "E4-037":
        return "删掉实参前的 '{param} = '；声明写成 '_{param}' 就表示按位置传"
    if _code == "E4-038":
        return "每个形参只给一个实参；去掉重复的那个"
    if _code == "E4-039":
        return "只读符号的值由 C 侧给出；要在 Pini 侧改状态，改用可写的数据符号或在 C 侧提供 setter"
    if _code == "E4-040":
        return "析构写成 `deinit|self() -> ()`，只挂在对象类型上，每个类型一个"
    if _code == "E4-041":
        return "补 return，或把末句写成能交出返回类型的表达式；if 与 match 要每个分支都交出值"
    if _code == "E5-001":
        return "你是想说 '{closest}' 吗？"
    if _code == "E5-019":
        return "改用 `pini run-llvm`，或在 C 侧写一个固定参数的 shim 再声明它"
    if _code == "E5-020":
        return "改用 `pini run-llvm`，或把句柄的创建与读取都放到 C 侧"
    if _code == "E6-008":
        return "把共享状态拆到更小的一层，或改用显式参数传递"
    if _code == "E6-009":
        return "改用与所在体匹配的关键字，或改函数的异步声明"
    if _code == "E6-010":
        return "把这次等待挪到**函数体那一层**的一条语句根部：`await f()` 独占一行 · `var x = await f()` · `try await f() else …` · `match await f():`。同样的四形**嵌在** `if` / 循环体 / `match` 的 case 体里也不行 —— 续跑跳不回嵌套块"
    if _code == "E6-011":
        return "这是编译器缺陷，不是程序写错：把这条诊断连同复现用的源文件一并上报"
    if _code == "E7-001":
        return "删除它；若有意保留，加 `_` 前缀"
    if _code == "E7-002":
        return "重命名别名；若有意为之可忽略（仅提醒，不强制）"
    if _code == "E7-003":
        return "物化时它会要求自己 ⇒ `pini run` 必崩；把字段初值改成不依赖自身"
    if _code == "E7-004":
        return "该码不保证跨版本稳定；要固定它，在扩展块写 `码() -> (I32,)` 返回一个常量"
    if _code == "E7-005":
        return "C 侧无法据此区分两者；改掉其中一个手写码，若有意合并成同一个状态可忽略"
    if _code == "E7-006":
        return "换 `run-llvm`，或在 C 侧写一个固定参数的 shim 再声明它"
    if _code == "E7-007":
        return "换 `run-llvm` 或 `build --shared`；解释器会在调用点拒绝"
    if _code == "E7-008":
        return "两者的 UTS #39 骨架相同而编码不同；若是有意为之可忽略，否则改名以示区别"
    if _code == "E7-009":
        return "它会改变这段文字的显示顺序；注释里删掉，字符串里确实要输出该码点时用 chr() 拼接"
    return ""
