[lexer_test|import]
_support = "../../support"

; 测试助手：核对一条记号的类别与消费区间；类别与两个端点都不许漂移。
断言记号|func(t: Token, kind: TokenKind, start: I32, end: I32,) -> ():
    assert(isKind(t, kind), "记号类别不符，实际 " + kindName(t.kind))
    assert(t.start == start, "记号起点不符")
    assert(t.end == end, "记号终点不符")
    assert(t.consumed() == end - start, "消费字节数不符")
    return

; 测试助手：按空格分隔的关键字与运算符逐条核对类别、接续位置与词长即消费数。
断言连续|func(lexed: LexResult, kinds: Array<TokenKind>, widths: Array<I32>,) -> ():
    assert(lexed.tokenCount() >= len(kinds), "记号数不足")
    var at = 0
    var i = 0
    while i < len(kinds):
        let t = lexed.tokenAt(i)
        assert(isKind(t, kinds[i]), "第 " + "\(i)" + " 条类别不符，实际 " + kindName(t.kind))
        assert(t.start == at, "第 " + "\(i)" + " 条未接续上一条终点")
        assert(t.consumed() == widths[i], "第 " + "\(i)" + " 条消费字节数与词长不符")
        at = t.end + 1
        i = i + 1
    return

; 一行最小语句：标识符、赋值与整数各消费自身字节，行尾与末尾各一条布局记号。
简单行|test() -> ():
    let lexed = lexText("let x = 42\n")
    assert(lexed.tokenCount() == 6, "记号数")
    断言记号(lexed.tokenAt(0), .kwLet, 0, 3)
    断言记号(lexed.tokenAt(1), .identifier, 4, 5)
    断言记号(lexed.tokenAt(2), .opAssign, 6, 7)
    断言记号(lexed.tokenAt(3), .integer, 8, 10)
    断言记号(lexed.tokenAt(4), .newline, 10, 11)
    断言记号(lexed.tokenAt(5), .eof, 11, 11)
    return

; 34 个关键字全表：词长即消费数，位置逐条接续，错一条就错位。
关键字全表|test() -> ():
    let lexed = lexText("var let func enum object if elif else match case while step for in try return break continue self own defer import export nil capture await wait unsafe test foreign detach pass using unroll")
    let kinds: Array<TokenKind> = [.kwVar, .kwLet, .kwFunc, .kwEnum, .kwObject, .kwIf, .kwElif, .kwElse, .kwMatch, .kwCase, .kwWhile, .kwStep, .kwFor, .kwIn, .kwTry, .kwReturn, .kwBreak, .kwContinue, .kwSelf, .kwOwn, .kwDefer, .kwImport, .kwExport, .kwNil, .kwCapture, .kwAwait, .kwWait, .kwUnsafe, .kwTest, .kwForeign, .kwDetach, .kwPass, .kwUsing, .kwUnroll]
    let widths: Array<I32> = [3, 3, 4, 4, 6, 2, 4, 4, 5, 4, 5, 4, 3, 2, 3, 6, 5, 8, 4, 3, 5, 6, 6, 3, 7, 5, 4, 6, 4, 7, 6, 4, 5, 6]
    assert(len(kinds) == 34, "关键字表应含 34 项")
    断言连续(lexed, kinds, widths)
    return

; 缩进块：行首多出的空格合成一条零宽缩进记号，块尾在下一行行首补反缩进。
缩进与反缩进|test() -> ():
    let lexed = lexText("if x:\n    y\n")
    assert(lexed.tokenCount() == 9, "记号数")
    断言记号(lexed.tokenAt(0), .kwIf, 0, 2)
    断言记号(lexed.tokenAt(1), .identifier, 3, 4)
    断言记号(lexed.tokenAt(2), .colon, 4, 5)
    断言记号(lexed.tokenAt(3), .newline, 5, 6)
    断言记号(lexed.tokenAt(4), .indent, 10, 10)
    断言记号(lexed.tokenAt(5), .identifier, 10, 11)
    断言记号(lexed.tokenAt(6), .newline, 11, 12)
    断言记号(lexed.tokenAt(7), .dedent, 12, 12)
    断言记号(lexed.tokenAt(8), .eof, 12, 12)
    return

; 两层缩进各弹一次：反缩进都落在下一行首个记号的位置，跨度为零。
嵌套反缩进|test() -> ():
    let lexed = lexText("if a:\n    if b:\n        c\nd\n")
    assert(lexed.tokenCount() == 17, "记号数")
    断言记号(lexed.tokenAt(4), .indent, 10, 10)
    断言记号(lexed.tokenAt(9), .indent, 24, 24)
    断言记号(lexed.tokenAt(11), .newline, 25, 26)
    断言记号(lexed.tokenAt(12), .dedent, 26, 26)
    断言记号(lexed.tokenAt(13), .dedent, 26, 26)
    断言记号(lexed.tokenAt(14), .identifier, 26, 27)
    断言记号(lexed.tokenAt(15), .newline, 27, 28)
    断言记号(lexed.tokenAt(16), .eof, 28, 28)
    return

; 空行与注释行透明：不产换行、不改缩进，块靠后续有内容的行判定。
空行与注释透明|test() -> ():
    let lexed = lexText("if a:\n\n    ; c\n    b\n")
    assert(lexed.tokenCount() == 9, "记号数")
    断言记号(lexed.tokenAt(3), .newline, 5, 6)
    断言记号(lexed.tokenAt(4), .indent, 19, 19)
    断言记号(lexed.tokenAt(5), .identifier, 19, 20)
    断言记号(lexed.tokenAt(6), .newline, 20, 21)
    断言记号(lexed.tokenAt(7), .dedent, 21, 21)
    断言记号(lexed.tokenAt(8), .eof, 21, 21)
    return

; 普通括号内换行等同空白：括号内不产换行与缩进，闭括号后才恢复行结构。
括号内抑制布局|test() -> ():
    let lexed = lexText("f(\n    1,\n)\nx\n")
    assert(lexed.tokenCount() == 9, "记号数")
    断言记号(lexed.tokenAt(0), .identifier, 0, 1)
    断言记号(lexed.tokenAt(1), .leftParen, 1, 2)
    断言记号(lexed.tokenAt(2), .integer, 7, 8)
    断言记号(lexed.tokenAt(3), .comma, 8, 9)
    断言记号(lexed.tokenAt(4), .rightParen, 10, 11)
    断言记号(lexed.tokenAt(5), .newline, 11, 12)
    断言记号(lexed.tokenAt(6), .identifier, 12, 13)
    断言记号(lexed.tokenAt(7), .newline, 13, 14)
    断言记号(lexed.tokenAt(8), .eof, 14, 14)
    return

; 块携带括号：`(` 后同行紧跟 `func` 时内部布局照常，参数括号仍按普通括号抑制。
块携带括号|test() -> ():
    let lexed = lexText("f = (func (n: I32,) -> (I32,):\n    return n\n)\n")
    assert(lexed.tokenCount() == 25, "记号数")
    断言记号(lexed.tokenAt(2), .leftParen, 4, 5)
    断言记号(lexed.tokenAt(3), .kwFunc, 5, 9)
    断言记号(lexed.tokenAt(4), .leftParen, 10, 11)
    断言记号(lexed.tokenAt(16), .newline, 30, 31)
    断言记号(lexed.tokenAt(17), .indent, 35, 35)
    断言记号(lexed.tokenAt(18), .kwReturn, 35, 41)
    断言记号(lexed.tokenAt(20), .newline, 43, 44)
    断言记号(lexed.tokenAt(21), .dedent, 44, 44)
    断言记号(lexed.tokenAt(22), .rightParen, 44, 45)
    return

; 数值字面量：进制前缀与小数点按最长匹配消费，`1.foo` 拆成整数、点与标识符。
数值扫描|test() -> ():
    let lexed = lexText("0xFF 0b1010 0o777 3.14 1.0e-5 2E10 42")
    let kinds: Array<TokenKind> = [.integer, .integer, .integer, .float, .float, .float, .integer]
    let widths: Array<I32> = [4, 6, 5, 4, 6, 4, 2]
    断言连续(lexed, kinds, widths)
    let tail = lexText("1.foo")
    断言记号(tail.tokenAt(0), .integer, 0, 1)
    断言记号(tail.tokenAt(1), .dot, 1, 2)
    断言记号(tail.tokenAt(2), .identifier, 2, 5)
    return

; 运算符最长匹配：先试三字节，再两字节，最后一字节；错一步就劈成两条记号。
运算符最长匹配|test() -> ():
    let lexed = lexText("<<= << <= < >>= >> >= > == = != ! && & || | ++ + -- -")
    let kinds: Array<TokenKind> = [.opAssignShl, .opShl, .opLe, .opLt, .opAssignShr, .opShr, .opGe, .opGt, .opEq, .opAssign, .opNe, .opNot, .opAnd, .opBitAnd, .opOr, .opBitOr, .opInc, .opAdd, .opDec, .opSub]
    let widths: Array<I32> = [3, 2, 2, 1, 3, 2, 2, 1, 2, 1, 2, 1, 2, 1, 2, 1, 2, 1, 2, 1]
    断言连续(lexed, kinds, widths)
    return

; 字符串：整条跨度含两侧引号，字面段记原文区间；无插值答字符串，有插值答插值字符串。
字符串分段|test() -> ():
    let plain = lexText("\"a\\nb\"")
    assert(isKind(plain.tokenAt(0), .string), "转义不产生插值")
    assert(plain.tokenAt(0).consumed() == 6, "整条字符串消费六字节")
    assert(plain.tokenAt(0).segmentCount() == 1, "字面段数")
    assert(plain.tokenAt(0).segmentAt(0).start == 1, "字面段起点")
    assert(plain.tokenAt(0).segmentAt(0).end == 5, "字面段终点")
    let mixed = lexText("\"v=\\(x)\"")
    assert(isKind(mixed.tokenAt(0), .interpolatedString), "含插值")
    assert(mixed.tokenAt(0).consumed() == 8, "整条消费八字节")
    assert(mixed.tokenAt(0).segmentCount() == 2, "字面段加插值段")
    assert(mixed.tokenAt(0).segmentAt(0).start == 1, "字面段起点")
    assert(mixed.tokenAt(0).segmentAt(0).end == 3, "字面段终点")
    assert(mixed.tokenAt(0).segmentAt(1).start == 5, "插值段起点")
    assert(mixed.tokenAt(0).segmentAt(1).end == 6, "插值段终点")
    return

; 插值内部的括号与字符串一起配平：嵌套调用的右括号不提前收尾。
插值配平|test() -> ():
    let lexed = lexText("\"\\(f(\"x\"))\"")
    let token = lexed.tokenAt(0)
    assert(isKind(token, .interpolatedString), "含插值")
    assert(token.consumed() == 11, "整条消费十一字节")
    assert(token.segmentCount() == 1, "只有一段插值")
    assert(token.segmentAt(0).start == 3, "插值段起点")
    assert(token.segmentAt(0).end == 9, "插值段终点")
    return

; `\0` 是内容终止符：跨度仍扫到闭引号，段表在终止符处截断，其后内容不进值。
字符串终止符|test() -> ():
    let lexed = lexText("\"a\\0b\"")
    let token = lexed.tokenAt(0)
    assert(token.consumed() == 6, "跨度扫到闭引号")
    assert(token.segmentCount() == 1, "终止符之后不再分段")
    assert(token.segmentAt(0).start == 1, "字面段起点")
    assert(token.segmentAt(0).end == 4, "字面段含终止符本身")
    return

; 反引号转义：整条跨度含反引号，名字区间去掉两侧引号。
反引号标识符|test() -> ():
    let lexed = lexText("`if`")
    let token = lexed.tokenAt(0)
    assert(isKind(token, .identifier), "关键字作名字")
    assert(token.consumed() == 4, "整条消费四字节")
    assert(token.nameStart == 1, "名字起点")
    assert(token.nameEnd == 3, "名字终点")
    let broken = lexText("`ab")
    assert(isKind(broken.tokenAt(0), .identifier), "未闭合回退为单字符标识符")
    assert(broken.tokenAt(0).consumed() == 1, "回退只消费一个反引号")
    assert(isKind(broken.tokenAt(1), .identifier), "其余仍是标识符")
    assert(broken.tokenAt(1).consumed() == 2, "余下两字节")
    return

; 注释在词法层跳过：只留行尾换行，注释字节不计入任何记号。
注释跳过|test() -> ():
    let lexed = lexText("x ; note\ny\n")
    断言记号(lexed.tokenAt(0), .identifier, 0, 1)
    断言记号(lexed.tokenAt(1), .newline, 8, 9)
    断言记号(lexed.tokenAt(2), .identifier, 9, 10)
    断言记号(lexed.tokenAt(3), .newline, 10, 11)
    断言记号(lexed.tokenAt(4), .eof, 11, 11)
    return

; 制表符缩进拒绝：记一条缩进类的词法问题，扫描继续且制表符只占一列。
制表符缩进报错|test() -> ():
    let lexed = lexText("if a:\n\tb\n")
    assert(lexed.issueCount() == 1, "一条问题")
    assert(isIssue(lexed.issueAt(0), .issueTabIndent), "问题类别")
    assert(lexed.issueAt(0).start == 6, "问题起点")
    assert(lexed.issueAt(0).end == 7, "问题终点")
    assert(lexed.tokenCount() == 9, "记号数")
    断言记号(lexed.tokenAt(4), .indent, 7, 7)
    断言记号(lexed.tokenAt(5), .identifier, 7, 8)
    return

; 未识别字节与未闭合字符串都记问题，并各自消费到能恢复的位置。
坏字节与未闭合字符串|test() -> ():
    let bad = lexText("a $ b\n")
    assert(bad.issueCount() == 1, "一条问题")
    assert(isIssue(bad.issueAt(0), .issueUnknownByte), "未知字节")
    断言记号(bad.tokenAt(1), .unknown, 2, 3)
    let open = lexText("\"abc\nx\n")
    assert(open.issueCount() == 1, "一条问题")
    assert(isIssue(open.issueAt(0), .issueUnterminatedString), "字符串未闭合")
    assert(open.tokenAt(0).consumed() == 4, "扫到行尾为止")
    断言记号(open.tokenAt(1), .newline, 4, 5)
    return

; CRLF 在进入词法前归一化：偏移一律指向归一化文本，行尾只剩一个换行字节。
CRLF归一化|test() -> ():
    let lexed = lexText("x\r\ny\r\n")
    assert(lexed.tokenCount() == 5, "记号数")
    断言记号(lexed.tokenAt(0), .identifier, 0, 1)
    断言记号(lexed.tokenAt(1), .newline, 1, 2)
    断言记号(lexed.tokenAt(2), .identifier, 2, 3)
    断言记号(lexed.tokenAt(3), .newline, 3, 4)
    断言记号(lexed.tokenAt(4), .eof, 4, 4)
    return

; 末尾没有换行也要收尾：补一条零宽换行，再逐层反缩进，最后答结束。
文件末尾|test() -> ():
    let lexed = lexText("x")
    assert(lexed.tokenCount() == 3, "记号数")
    断言记号(lexed.tokenAt(0), .identifier, 0, 1)
    断言记号(lexed.tokenAt(1), .newline, 1, 1)
    断言记号(lexed.tokenAt(2), .eof, 1, 1)
    let empty = lexText("")
    assert(empty.tokenCount() == 1, "空输入只有结束")
    断言记号(empty.tokenAt(0), .eof, 0, 0)
    return

; 默认词表是英文：中文拼写在默认入口下只是标识符，整词之外的英文也不算关键字。
关键字默认英文|test() -> ():
    let 中文 = lexText("变量")
    assert(isKind(中文.tokenAt(0), .identifier), "中文拼写在默认表里是标识符")
    let 近形 = lexText("variable")
    assert(isKind(近形.tokenAt(0), .identifier), "前缀相同的长词不是关键字")
    let 英文 = lexText("var")
    assert(isKind(英文.tokenAt(0), .kwVar), "英文词表命中")
    return

; 中文词表：显式指定语言后中文拼写才是关键字，英文拼写同时退为标识符。
关键字中文表|test() -> ():
    let 词 = lexTextIn(.langChinese, "变量 let")
    assert(isKind(词.tokenAt(0), .kwVar), "变量")
    assert(isKind(词.tokenAt(1), .identifier), "英文 let 在中文表里是标识符")
    return

; 词表自洽：两张表项数相同，每一项按序号还原成同一个关键字类别。
关键字词表同序|test() -> ():
    let 英 = keywordWords(.langEnglish)
    let 中 = keywordWords(.langChinese)
    assert(len(英) == 34, "英文表应含 34 项")
    assert(len(中) == 34, "中文表应含 34 项")
    var i = 0
    while i < len(英):
        let 英字节 = tempUtf8Bytes(英[i])
        assert(kindTag(keywordKind(.langEnglish, 英字节, 0, len(英字节))) == 8 + i, "英文第 " + "\(i)" + " 项")
        let 中字节 = tempUtf8Bytes(中[i])
        assert(kindTag(keywordKind(.langChinese, 中字节, 0, len(中字节))) == 8 + i, "中文第 " + "\(i)" + " 项")
        i = i + 1
    return

; 中文关键字按整词消费：记号宽度等于该词的 UTF-8 字节数，不按字数算。
中文关键字宽度|test() -> ():
    let 词 = lexTextIn(.langChinese, "否则如果 变量")
    断言记号(词.tokenAt(0), .kwElif, 0, 12)
    断言记号(词.tokenAt(1), .kwVar, 13, 19)
    return
