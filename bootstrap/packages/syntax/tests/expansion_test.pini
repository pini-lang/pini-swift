[expansion_test|import]
_unicode = "../../unicode"

; 可达遍历：从函数体块出发数 unroll，池里的残留节点不算。
可达未展开|func(ast: Ast, blockId: I32,) -> (I32,):
    if blockId < 0 || blockId >= ast.stmtCount():
        return 0
    var total = 0
    let block = ast.stmtAt(blockId)
    var i = 0
    while i < len(block.kids):
        let kid: I32 = block.kids[i]
        if kid >= 0 && kid < ast.stmtCount():
            let node = ast.stmtAt(kid)
            if node.kind == stmtKindTag(.stmtUnroll):
                total = total + 1
            elif node.kind == stmtKindTag(.stmtBlock):
                total = total + 可达未展开(ast = ast, blockId = kid)
        i = i + 1
    return total

; 可达表达式：把块里语句的表达式 kids 收进表，供残留名字扫描。
可达表达式|func(ast: Ast, blockId: I32, out: Array<I32>,) -> (Array<I32>,):
    if blockId < 0 || blockId >= ast.stmtCount():
        return out
    var ids = out
    let block = ast.stmtAt(blockId)
    var i = 0
    while i < len(block.kids):
        let kid: I32 = block.kids[i]
        if kid >= 0 && kid < ast.stmtCount():
            let node = ast.stmtAt(kid)
            if node.kind == stmtKindTag(.stmtBlock):
                ids = 可达表达式(ast = ast, blockId = kid, out = ids)
            else:
                var k = 0
                while k < len(node.kids):
                    ids = ids.append(node.kids[k])
                    k = k + 1
        i = i + 1
    return ids

; 名字表：可达表达式里以给定两名字之一命名的标识符个数。
残留名字数|func(ast: Ast, exprIds: Array<I32>, bytes: Array<U8>,) -> (I32,):
    var total = 0
    var i = 0
    while i < len(exprIds):
        let id: I32 = exprIds[i]
        if id >= 0 && id < ast.exprCount():
            let node = ast.exprAt(id)
            if node.kind == exprKindTag(.exprIdentifier) && node.nameEnd > node.nameStart:
                let spelled = sliceBytes(bytes = bytes, start = node.nameStart, end = node.nameEnd)
                if spelled == "编号" || spelled == "标签":
                    total = total + 1
        i = i + 1
    return total

; 展开：多行多分量摊成多轮，可达语句里不再有 unroll。
展开双分量|test() -> ():
    let text = "登记|func(码: I32, 名: String,) -> ():\n    print(码)\n    return\n\nmain|func() -> ():\n    unroll (编号, 标签,) in [(2, \"甲\",), (4, \"乙\",)]:\n        登记(码 = 编号, 名 = 标签)\n    return\n"
    let parsed = parseFile(text = text, file = "t.pini")
    assert(len(parsed.diagnostics) == 0, "解析不应报错")
    let expanded = expandUnrolls(ast = parsed.ast, bytes = tempUtf8Bytes(text))
    assert(len(expanded.errors) == 0, "展开不应报错")
    var left = 0
    var d = 0
    while d < expanded.ast.declCount():
        left = left + 可达未展开(ast = expanded.ast, blockId = expanded.ast.declAt(d).body)
        d = d + 1
    assert(left == 0, "展开后可达语句里不应留下 unroll")
    return

; 替换：可达表达式里不再出现模式名，字面量已经进了调用实参。
; 体里用带标签的实参，覆盖「标签名不是标识符节点、值才是」的形态。
模式名已换|test() -> ():
    let text = "登记|func(码: I32, 名: String,) -> ():\n    print(码)\n    return\n\nmain|func() -> ():\n    unroll (编号, 标签,) in [(2, \"甲\",), (4, \"乙\",)]:\n        登记(码 = 编号, 名 = 标签)\n    return\n"
    let parsed = parseFile(text = text, file = "t.pini")
    let expanded = expandUnrolls(ast = parsed.ast, bytes = tempUtf8Bytes(text))
    assert(len(expanded.errors) == 0, "展开不应报错")
    var reachable: Array<I32> = []
    var d = 0
    while d < expanded.ast.declCount():
        reachable = 可达表达式(ast = expanded.ast, blockId = expanded.ast.declAt(d).body, out = reachable)
        d = d + 1
    assert(残留名字数(ast = expanded.ast, exprIds = reachable, bytes = tempUtf8Bytes(text)) == 0, "可达表达式里不应残留模式名")
    return

; 模式名读回：模式表答出两个名字，顺序与源序一致。
模式名读回|test() -> ():
    let text = "main|func() -> ():\n    unroll (编号, 标签,) in [(2, \"甲\",), (4, \"乙\",)]:\n        print(编号)\n    return\n"
    let parsed = parseFile(text = text, file = "t.pini")
    var worker = UnrollExpander()
    worker.ast = parsed.ast
    worker.bytes = tempUtf8Bytes(text)
    var patternId = -1
    var s = 0
    while s < worker.ast.stmtCount():
        if worker.ast.stmtAt(s).kind == stmtKindTag(.stmtUnroll):
            patternId = worker.ast.stmtAt(s).kids[0]
        s = s + 1
    assert(patternId >= 0, "应找到 unroll 语句")
    let names = worker.patternNames(exprId = patternId)
    assert(len(names) == 2, "模式应有两个名字")
    assert(names[0] == "编号", "首个模式名")
    assert(names[1] == "标签", "次个模式名")
    return

; 字节切片：按标量拼回文本，测试内只用于读名字。
sliceBytes|func(bytes: Array<U8>, start: I32, end: I32,) -> (String,):
    var out = ""
    var at = start
    while at < end && at < len(bytes):
        let unit = decodeScalarAt(bytes = bytes, offset = at)
        if unit.length == 0:
            return out
        out = out + chr(unit.code)
        at = at + unit.length
    return out

; 退役不变量：死节点是新建的空壳，名字区间、kids 与处理器块都不带。
; 原地清理式退役会留下这些字段，语义层全池扫描就会摸到，读成真名字。
退役节点是空壳|test() -> ():
    let text = "main|func() -> ():\n    unroll (编号, 标签,) in [(2, \"甲\",), (4, \"乙\",)]:\n        print(编号)\n        print(标签)\n    return\n"
    let expanded = expandUnrolls(ast = parseFile(text = text, file = "t.pini").ast, bytes = tempUtf8Bytes(text))
    assert(len(expanded.errors) == 0, "展开不应报错")
    var i = 0
    while i < expanded.ast.exprCount():
        let node = expanded.ast.exprAt(i)
        if node.kind == exprKindTag(.exprNil):
            assert(node.nameStart < 0 && node.nameEnd < 0, "死表达式不应带名字区间")
            assert(len(node.kids) == 0, "死表达式不应留 kids")
            assert(node.body < 0, "死表达式不应留处理器块")
        i = i + 1
    var s = 0
    while s < expanded.ast.stmtCount():
        let stmt = expanded.ast.stmtAt(s)
        if stmt.kind == stmtKindTag(.stmtPass):
            assert(len(stmt.kids) == 0, "死语句不应留 kids")
        s = s + 1
    return
