; 函数声明：名字、参数、返回类型与体各就各位，顶层登记一条。
函数声明形状|test() -> ():
    let result = parseText("f|func(a: I32,) -> (I32,):\n    return a\n")
    assert(len(result.diagnostics) == 0, "不应有语法诊断")
    let ast = result.ast
    assert(ast.itemCount() == 1, "一条顶层声明")
    let decl = ast.declAt(ast.itemAt(0))
    assert(ast.isDecl(id = ast.itemAt(0), kind = .declFunction), "函数声明")
    assert(decl.nameStart == 0, "函数名起点")
    assert(decl.nameEnd == 1, "函数名终点")
    assert(len(decl.kids) == 1, "一个参数")
    let param = ast.declAt(decl.kids[0])
    assert(ast.isDecl(id = decl.kids[0], kind = .declParam), "参数节点")
    assert(param.nameStart == 7, "参数名起点")
    assert(param.nameEnd == 8, "参数名终点")
    assert(param.typeId >= 0, "参数有类型")
    assert(ast.isType(id = param.typeId, kind = .typeNamed), "具名类型")
    assert(ast.typeAt(param.typeId).nameStart == 10, "类型名起点")
    assert(ast.typeAt(param.typeId).nameEnd == 13, "类型名终点")
    assert(decl.body >= 0, "有函数体")
    assert(ast.isStmt(id = decl.body, kind = .stmtBlock), "体是块")
    return

; 参数位下划线：名字含前导 `_`，名字区间原样保留，标签面由名字推出。
参数退面|test() -> ():
    let result = parseText("f|func(_a: I32, b: I32,) -> (I32,):\n    return _a\n")
    assert(len(result.diagnostics) == 0, "不应有语法诊断")
    let ast = result.ast
    let decl = ast.declAt(ast.itemAt(0))
    let first = ast.declAt(decl.kids[0])
    let second = ast.declAt(decl.kids[1])
    assert(first.nameEnd - first.nameStart == 2, "名字区间含前导下划线")
    assert(second.nameEnd - second.nameStart == 1, "未写下划线的名字原样")
    return

; 优先级：乘法先于加法，左结合；括号组不产生额外节点。
优先级与结合|test() -> ():
    let result = parseText("f|func() -> ():\n    x = a + b * c\n")
    assert(len(result.diagnostics) == 0, "不应有语法诊断")
    let ast = result.ast
    assert(ast.isStmt(id = 0, kind = .stmtAssign), "赋值语句")
    let value = ast.stmtChild(id = 0, index = 1)
    assert(ast.isExpr(id = value, kind = .exprBinary), "顶层是二元")
    assert(ast.exprAt(value).op == kindTag(.opAdd), "顶层运算符是加")
    let right = ast.childOf(id = value, index = 1)
    assert(ast.exprAt(right).op == kindTag(.opMul), "右侧先结合乘法")
    let paren = parseText("f|func() -> ():\n    x = (a + b) * c\n")
    assert(len(paren.diagnostics) == 0, "括号组不报错")
    let outer = paren.ast.stmtChild(id = 0, index = 1)
    assert(paren.ast.exprAt(outer).op == kindTag(.opMul), "括号改变了结合")
    return

; 后缀链：调用、成员与下标按出现顺序叠加，接收者始终是前一节点。
后缀链|test() -> ():
    let result = parseText("f|func() -> ():\n    f(a).b[0]\n")
    assert(len(result.diagnostics) == 0, "不应有语法诊断")
    let ast = result.ast
    assert(ast.isStmt(id = 0, kind = .stmtExpression), "表达式语句")
    let index = ast.stmtChild(id = 0, index = 0)
    assert(ast.isExpr(id = index, kind = .exprSubscript), "最外层是下标")
    let member = ast.childOf(id = index, index = 0)
    assert(ast.isExpr(id = member, kind = .exprMember), "接收者是成员")
    assert(ast.exprAt(member).nameEnd - ast.exprAt(member).nameStart == 1, "成员名宽一字节")
    let call = ast.childOf(id = member, index = 0)
    assert(ast.isExpr(id = call, kind = .exprCall), "接收者是调用")
    assert(len(ast.exprAt(call).kids) == 2, "调用含被调与一个实参")
    return

; 如果语句：条件、体、否则如果对与否则体依次入子表，缺少的分支答 -1。
如果分派|test() -> ():
    let result = parseText("f|func() -> ():\n    if a:\n        b\n    elif c:\n        d\n    else:\n        e\n")
    assert(len(result.diagnostics) == 0, "不应有语法诊断")
    let ast = result.ast
    assert(ast.isStmt(id = 0, kind = .stmtIf), "如果语句")
    let stmt = ast.stmtAt(0)
    assert(len(stmt.kids) == 5, "条件、体、否则如果条件、否则如果体、否则体")
    assert(ast.stmtChild(id = 0, index = 1) >= 0, "体存在")
    assert(ast.stmtChild(id = 0, index = 4) >= 0, "否则体存在")
    let plain = parseText("f|func() -> ():\n    if a:\n        b\n")
    assert(len(plain.ast.stmtAt(0).kids) == 2, "只有条件与体")
    return

; 循环与遍历：条件、体与 step 块三处齐全；遍历另带模式与迭代表达式。
循环与遍历|test() -> ():
    let loop = parseText("f|func() -> ():\n    while a < b:\n        f()\n    step:\n        g()\n")
    assert(len(loop.diagnostics) == 0, "循环不应有语法诊断")
    assert(loop.ast.isStmt(id = 0, kind = .stmtWhile), "循环语句")
    assert(loop.ast.stmtChild(id = 0, index = 2) >= 0, "step 块存在")
    let each = parseText("f|func() -> ():\n    for (v,) in xs:\n        f(v)\n")
    assert(len(each.diagnostics) == 0, "遍历不应有语法诊断")
    assert(each.ast.isStmt(id = 0, kind = .stmtFor), "遍历语句")
    assert(each.ast.isExpr(id = each.ast.stmtChild(id = 0, index = 0), kind = .exprTuple), "遍历模式是元组")
    assert(each.ast.stmtChild(id = 0, index = 3) == -1, "缺省 step 答 -1")
    return

; 匹配语句：主题之后逐对登记模式与块；带绑定的模式把绑定名放进子表。
匹配分派|test() -> ():
    let result = parseText("f|func() -> ():\n    match x:\n        case 甲:\n            f()\n        case 乙(v: y):\n            g(y)\n")
    assert(len(result.diagnostics) == 0, "不应有语法诊断")
    let ast = result.ast
    assert(ast.isStmt(id = 0, kind = .stmtMatch), "匹配语句")
    assert(len(ast.stmtAt(0).kids) == 5, "主题加两组模式与块")
    let pattern = ast.stmtChild(id = 0, index = 3)
    assert(ast.isExpr(id = pattern, kind = .exprCase), "第二组模式是枚举项")
    assert(len(ast.exprAt(pattern).kids) == 1, "带一个绑定")
    return

; 枚举与导入块：变体按行登记，导入项各自带别名与路径。
枚举与导入|test() -> ():
    let result = parseText("[方向]\n东\n西\n")
    assert(len(result.diagnostics) == 0, "枚举不应有语法诊断")
    let ast = result.ast
    assert(ast.isDecl(id = 0, kind = .declEnum), "枚举声明")
    assert(len(ast.declAt(0).kids) == 2, "两个变体")
    assert(ast.isDecl(id = ast.declChild(id = 0, index = 0), kind = .declVariant), "变体节点")
    let imported = parseText("[m|import]\n_p = \"../x\"\n")
    assert(len(imported.diagnostics) == 0, "导入不应有语法诊断")
    let importedAst = imported.ast
    assert(importedAst.isDecl(id = 0, kind = .declImportBlock), "导入块")
    assert(importedAst.declAt(0).nameStart == 1, "块名起点")
    assert(importedAst.declAt(0).nameEnd == 2, "块名终点")
    assert(len(importedAst.declAt(0).kids) == 1, "一个导入项")
    let entry = importedAst.declChild(id = 0, index = 0)
    assert(importedAst.declAt(entry).nameStart == 11, "别名起点")
    assert(importedAst.declAt(entry).nameEnd == 13, "别名终点")
    assert(importedAst.isExpr(id = importedAst.declChild(id = entry, index = 0), kind = .exprString), "路径是字符串字面量")
    return

; 函数字面量：参数与体同处一个表达式节点，体是单条语句块。
函数字面量|test() -> ():
    let result = parseText("f|func() -> ():\n    g = func (n,) -> (I32,): return n\n")
    assert(len(result.diagnostics) == 0, "不应有语法诊断")
    let ast = result.ast
    let value = ast.stmtChild(id = 0, index = 1)
    assert(ast.isExpr(id = value, kind = .exprFunction), "函数字面量")
    assert(len(ast.exprAt(value).kids) == 2, "一个参数加体")
    assert(ast.isDecl(id = ast.exprAt(value).kids[0], kind = .declParam), "参数节点")
    assert(ast.isStmt(id = ast.exprAt(value).kids[1], kind = .stmtBlock), "体是块")
    return

; 非法输入：给稳定码与至少一字节宽的标签，并且必须终止。
错误诊断|test() -> ():
    let broken = parseText("if\n")
    assert(len(broken.diagnostics) > 0, "必须报诊断")
    let first = broken.diagnostics[0]
    assert(len(first.code) > 0, "诊断码非空")
    assert(first.anchorEnd() > first.anchorStart(), "标签跨度非零")
    let garbage = parseText("(((\n")
    assert(garbage.ast.itemCount() == 0, "畸形输入不产声明")
    let empty = parseText("")
    assert(len(empty.diagnostics) == 0, "空输入无诊断")
    assert(empty.ast.itemCount() == 0, "空输入无声明")
    return

; 词法问题随结果透传：未闭合字符串既留记号，也留问题。
词法问题透传|test() -> ():
    let result = parseText("\"abc\n")
    assert(len(result.issues) > 0, "问题序列非空")
    assert(len(result.ast.items) == 0, "未闭合字符串不产声明")
    return

; 中文关键字解析：声明、参数、返回与缩进块走同一套类别，诊断数为零。
中文关键字解析|test() -> ():
    let result = parseTextIn(language = .langChinese, text = "加|函数(甲: I32, 乙: I32,) -> (I32,):\n    返回 甲 + 乙\n")
    assert(len(result.diagnostics) == 0, "不应有语法诊断")
    assert(result.ast.itemCount() == 1, "一条顶层声明")
    assert(result.ast.isDecl(id = result.ast.itemAt(0), kind = .declFunction), "函数声明")
    return

; 元组序号：点后接整数按成员访问记录，名字区间覆盖数字本身。
元组序号成员|test() -> ():
    let src = "f|func() -> ():\n    x = t.0\n"
    let result = parseText(src)
    assert(len(result.diagnostics) == 0, "元组序号不应报诊断")
    let value = result.ast.stmtChild(id = 0, index = 1)
    assert(result.ast.isMemberExpr(value), "应记为成员访问")
    let node = result.ast.exprAt(value)
    assert(src.substring(node.nameStart, node.nameEnd) == "0", "名字区间应覆盖数字")
    return

; 本型方法：`|own` 记为 isOwn，`|self` 仍只记 isSelf，两者互斥。
本型方法标记|test() -> ():
    let src = "((P))\n造|own() -> ():\n    return\n取|self() -> ():\n    return\n"
    let result = parseText(src)
    assert(len(result.diagnostics) == 0, "本型方法不应报诊断")
    let ast = result.ast
    assert(ast.isDecl(id = ast.itemAt(0), kind = .declExtension), "扩展块")
    let ext = ast.declAt(ast.itemAt(0))
    assert(len(ext.kids) == 2, "两个方法")
    assert(ast.declAt(ext.kids[0]).isOwn, "首个记为 |own")
    assert(!ast.declAt(ext.kids[0]).isSelf, "首个不记 |self")
    assert(ast.declAt(ext.kids[1]).isSelf, "次个记为 |self")
    assert(!ast.declAt(ext.kids[1]).isOwn, "次个不记 |own")
    return

; 返回列表：单元素即该类型本身，多元素仍是元组，空表是空元组。
返回列表|test() -> ():
    let single = parseText("f|func() -> (I32,):\n    return 1\n")
    let decl = single.ast.declAt(single.ast.itemAt(0))
    assert(single.ast.isType(id = decl.typeId, kind = .typeNamed), "单元素返回应是具名类型")
    let multi = parseText("f|func() -> (I32, Bool,):\n    return (1, true,)\n")
    let mdecl = multi.ast.declAt(multi.ast.itemAt(0))
    assert(multi.ast.isType(id = mdecl.typeId, kind = .typeTuple), "多元素返回应是元组")
    assert(len(multi.ast.typeAt(mdecl.typeId).kids) == 2, "两个分量")
    let empty = parseText("f|func() -> ():\n    return\n")
    let edecl = empty.ast.declAt(empty.ast.itemAt(0))
    assert(empty.ast.isType(id = edecl.typeId, kind = .typeTuple), "空返回仍是空元组")
    return

; 空花括号：`{}` 解析为空集合，不是空字典；字典没有空字面量形态。
空花括号|test() -> ():
    let result = parseText("main|func() -> ():\n    let s = {}\n    return\n")
    assert(len(result.diagnostics) == 0, "空花括号不应报诊断")
    let value = result.ast.stmtChild(id = 0, index = 1)
    assert(result.ast.isSetExpr(value), "应解析成集合")
    assert(len(result.ast.exprAt(value).kids) == 0, "元素数应为零")
    return

; 首个匹配语句：返回第一个 match 语句的下标，没有答 -1。
首个匹配|func(_ast: Ast,) -> (I32,):
    var i = 0
    while i < _ast.stmtCount():
        if _ast.isStmt(id = i, kind = .stmtMatch):
            return i
        i = i + 1
    return -1

; 匹配模式：限定枚举项按成员加调用成形，无载荷项按成员成形，裸枚举项按枚举项节点成形。
匹配模式|test() -> ():
    let src = "[形状]\n圆(半径: F64,)\n点\n\nf|func(x: 形状,) -> (F64,):\n    match x:\n        case 形状.圆(_, 半径):\n            return 0.0\n        case 形状.点:\n            return 0.0\n    return 0.0\n"
    let result = parseText(src)
    assert(len(result.diagnostics) == 0, "模式不应报诊断")
    let ast = result.ast
    let id = 首个匹配(ast)
    assert(id >= 0, "应有 match 语句")
    let qualified = ast.stmtChild(id = id, index = 1)
    assert(ast.isCallExpr(qualified), "限定枚举项应是调用")
    assert(len(ast.exprAt(qualified).kids) == 3, "一个被调方加两个绑定位")
    assert(ast.isMemberExpr(ast.exprAt(qualified).kids[0]), "被调方应是成员访问")
    assert(ast.isIdentifierExpr(ast.exprAt(qualified).kids[1]), "占位应是标识符")
    let bare = ast.stmtChild(id = id, index = 3)
    assert(ast.isMemberExpr(bare), "无载荷枚举项应是成员访问")
    return

; 位置绑定：裸枚举项的每个绑定位都留下，`_` 同样占位；具名绑定只留绑定变量。
位置绑定|test() -> ():
    let src = "[形状]\n圆(半径: F64, 高: F64,)\n\nf|func(x: 形状,) -> (F64,):\n    match x:\n        case 圆(_, 半径):\n            return 半径\n        case 圆(半径: r):\n            return r\n    return 0.0\n"
    let result = parseText(src)
    assert(len(result.diagnostics) == 0, "位置绑定不应报诊断")
    let ast = result.ast
    let id = 首个匹配(ast)
    let positional = ast.stmtChild(id = id, index = 1)
    assert(ast.isExpr(id = positional, kind = .exprCase), "裸枚举项应是枚举项节点")
    assert(len(ast.exprAt(positional).kids) == 2, "两个绑定位都应留下")
    assert(ast.isIdentifierExpr(ast.exprAt(positional).kids[1]), "次位应是标识符")
    let named = ast.stmtChild(id = id, index = 3)
    assert(len(ast.exprAt(named).kids) == 1, "具名绑定只留变量名")
    return

; 外部块：`[名|foreign]` 的条目与标志；块在下一裸函数声明处收尾。
外部块|test() -> ():
    let 文本 = "[libc|foreign]\nmalloc: (I64,) -> (*I8,)\nerrno|readonly: I32\nfree: (*I8,) -> ()\n\nf|func() -> ():\n    return\n"
    let 结果 = parseText(文本)
    var 诊断 = ""
    if len(结果.diagnostics) > 0:
        诊断 = 结果.diagnostics[0].message
    assert(len(结果.diagnostics) == 0, "不应有语法诊断：" + 诊断)
    let ast = 结果.ast
    assert(ast.itemCount() == 2, "外部块与函数两条")
    let 块 = ast.declAt(ast.itemAt(0))
    assert(ast.isDecl(id = ast.itemAt(0), kind = .declForeign), "外部块")
    assert(块.nameEnd - 块.nameStart == 4, "块名 libc")
    assert(len(块.kids) == 3, "三个符号")
    let 函数项 = ast.declAt(块.kids[0])
    assert(ast.isDecl(id = 块.kids[0], kind = .declForeignSymbol), "符号条目")
    assert(函数项.typeId >= 0, "符号有类型")
    assert(ast.isType(id = 函数项.typeId, kind = .typeFunction), "函数类型")
    assert(len(函数项.kids) == 0, "函数条目无标志")
    let 数据项 = ast.declAt(块.kids[1])
    assert(ast.isType(id = 数据项.typeId, kind = .typeNamed), "数据项是具名类型")
    assert(len(数据项.kids) == 1, "一个标志")
    assert(ast.isDecl(id = 数据项.kids[0], kind = .declForeignFlag), "标志节点")
    let 标志 = ast.declAt(数据项.kids[0])
    assert(标志.nameEnd - 标志.nameStart == 8, "readonly 长度")
    assert(ast.isDecl(id = ast.itemAt(1), kind = .declFunction), "函数未被吞进块")
    return

; 转换：`as` 比二元紧、比前缀一元松，可连写左结合；目标类型落在节点的 typeId。
转换形状|test() -> ():
    let src = "f|func(a: I32, b: I32,) -> ():\n    x = a * b as I64\n    y = -a as U8\n    z = a as I64 as F64\n"
    let 结果 = parseText(src)
    var 诊断 = ""
    if len(结果.diagnostics) > 0:
        诊断 = 结果.diagnostics[0].message
    assert(len(结果.diagnostics) == 0, "不应有语法诊断：" + 诊断)
    let ast = 结果.ast
    let 乘法 = ast.stmtChild(id = 0, index = 1)
    assert(ast.isExpr(id = 乘法, kind = .exprBinary), "顶层是乘法")
    let 右 = ast.childOf(id = 乘法, index = 1)
    assert(ast.isCastExpr(右), "右操作数是转换")
    assert(ast.isType(id = ast.exprAt(右).typeId, kind = .typeNamed), "目标类型是具名")
    assert(ast.typeAt(ast.exprAt(右).typeId).nameEnd - ast.typeAt(ast.exprAt(右).typeId).nameStart == 3, "目标名 I64")
    assert(ast.isIdentifierExpr(ast.exprAt(右).kids[0]), "转换的操作数是标识符")
    let 一元转换 = ast.stmtChild(id = 1, index = 1)
    assert(ast.isCastExpr(一元转换), "`-a as U8` 的顶层是转换")
    assert(ast.isExpr(id = ast.exprAt(一元转换).kids[0], kind = .exprUnary), "操作数是前缀一元")
    let 连写 = ast.stmtChild(id = 2, index = 1)
    assert(ast.isCastExpr(连写), "连写的外层是转换")
    assert(ast.typeAt(ast.exprAt(连写).typeId).nameEnd - ast.typeAt(ast.exprAt(连写).typeId).nameStart == 3, "外层目标 F64")
    let 内层 = ast.exprAt(连写).kids[0]
    assert(ast.isCastExpr(内层), "内层也是转换")
    assert(ast.typeAt(ast.exprAt(内层).typeId).nameEnd - ast.typeAt(ast.exprAt(内层).typeId).nameStart == 3, "内层目标 I64")
    return

; 上下文关键字：`as` 不在关键字表内，作变量名与右值时都是标识符。
转换作名字|test() -> ():
    let src = "f|func(a: I32,) -> (I32,):\n    as = a\n    return as\n"
    let 结果 = parseText(src)
    assert(len(结果.diagnostics) == 0, "不应有语法诊断")
    let ast = 结果.ast
    let 赋值 = ast.stmtChild(id = 0, index = 0)
    assert(ast.isAssignStmt(0), "首条是赋值语句")
    assert(ast.isIdentifierExpr(赋值), "左端是标识符")
    assert(ast.exprAt(赋值).nameEnd - ast.exprAt(赋值).nameStart == 2, "名字就是 as")
    assert(ast.isReturnStmt(1), "次条是返回")
    let 值 = ast.stmtChild(id = 1, index = 0)
    assert(ast.isIdentifierExpr(值), "右值标识符未被当成转换")
    return

; 类型写法：方括号是数组、花括号按有无冒号分集合与字典、尖号是结果糖；组件类型各占一个 kid。
类型写法|test() -> ():
    let src = "(P)\na: [I32,]\nb: {String,}\nc: {String: I32,}\nd: ^I32\n"
    let 结果 = parseText(src)
    var 诊断 = ""
    if len(结果.diagnostics) > 0:
        诊断 = 结果.diagnostics[0].message
    assert(len(结果.diagnostics) == 0, "不应有语法诊断：" + 诊断)
    let ast = 结果.ast
    let 结构 = ast.declAt(ast.itemAt(0))
    let 数组 = ast.declAt(结构.kids[0])
    assert(ast.isType(id = 数组.typeId, kind = .typeArray), "方括号是数组")
    assert(len(ast.typeAt(数组.typeId).kids) == 1, "数组一个组件")
    assert(ast.isType(id = ast.typeAt(数组.typeId).kids[0], kind = .typeNamed), "元素是具名")
    let 集合 = ast.declAt(结构.kids[1])
    assert(ast.isType(id = 集合.typeId, kind = .typeSet), "无冒号是集合")
    let 字典 = ast.declAt(结构.kids[2])
    assert(ast.isType(id = 字典.typeId, kind = .typeDictionary), "有冒号是字典")
    assert(len(ast.typeAt(字典.typeId).kids) == 2, "字典两个组件")
    let 结果类型 = ast.declAt(结构.kids[3])
    assert(ast.isType(id = 结果类型.typeId, kind = .typeResult), "尖号是结果糖")
    assert(len(ast.typeAt(结果类型.typeId).kids) == 1, "结果一个组件")
    return

; 类型写法的可选后缀：`[T,]?` 先容器后可选，与具名类型同规。
类型写法可选|test() -> ():
    let src = "(P)\na: [I32,]?\n"
    let 结果 = parseText(src)
    assert(len(结果.diagnostics) == 0, "不应有语法诊断")
    let ast = 结果.ast
    let 结构 = ast.declAt(ast.itemAt(0))
    let 字段 = ast.declAt(结构.kids[0])
    assert(ast.isType(id = 字段.typeId, kind = .typeOptional), "外层是可选")
    let 内层 = ast.typeAt(字段.typeId).kids[0]
    assert(ast.isType(id = 内层, kind = .typeArray), "内层是数组")
    return

; 错误处理：语句位与表达式位同形，错误名落区间，处理器成块；块形式与单行形式都收。
try三形态|test() -> ():
    let src = "f|func() -> (I32,):\n    try 取() else 错误: return 0\n    let 值 = try 取() else 错误: return 1\n    try 取() else 错误:\n        return 2\n    try 取() else 错误: pass\n    return 值\n"
    let 结果 = parseText(src)
    var 诊断 = ""
    if len(结果.diagnostics) > 0:
        诊断 = 结果.diagnostics[0].message
    assert(len(结果.diagnostics) == 0, "不应有语法诊断：" + 诊断)
    let ast = 结果.ast
    let 体 = ast.declAt(ast.itemAt(0)).body
    let 语句 = ast.stmtAt(体).kids
    let 语句位 = ast.stmtChild(id = 语句[0], index = 0)
    assert(ast.isTryExpr(语句位), "语句位的 try 是错误处理表达式")
    assert(ast.exprAt(语句位).body >= 0, "有处理器块")
    assert(ast.exprAt(语句位).nameEnd - ast.exprAt(语句位).nameStart == 6, "错误名占三字节的两倍：错误")
    let 处理器 = ast.exprAt(语句位).body
    assert(ast.isBlockStmt(处理器), "处理器是块")
    assert(ast.isReturnStmt(ast.stmtChild(id = 处理器, index = 0)), "单行处理器是返回")
    let 表达式位 = ast.stmtChild(id = 语句[1], index = 1)
    assert(ast.isTryExpr(表达式位), "右值位的 try 同形")
    let 块形式 = ast.stmtChild(id = 语句[2], index = 0)
    assert(ast.isTryExpr(块形式), "块形式也是错误处理表达式")
    assert(ast.isBlockStmt(ast.exprAt(块形式).body), "块形式的处理器是块")
    return

; 解包糖：`^右值` 成错误处理表达式但无处理器块，右值保持子树；中缀 `^` 仍是按位异或。
解包糖|test() -> ():
    let src = "f|func(r: ^I32, a: I32, b: I32,) -> (I32,):\n    let v = ^r\n    let x = a ^ b\n    return v + x\n"
    let 结果 = parseText(src)
    var 诊断 = ""
    if len(结果.diagnostics) > 0:
        诊断 = 结果.diagnostics[0].message
    assert(len(结果.diagnostics) == 0, "不应有语法诊断：" + 诊断)
    let ast = 结果.ast
    let 体 = ast.declAt(ast.itemAt(0)).body
    let 语句 = ast.stmtAt(体).kids
    let 解包 = ast.stmtChild(id = 语句[0], index = 1)
    assert(ast.isTryExpr(解包), "前缀尖号是解包")
    assert(ast.exprAt(解包).body < 0, "解包不落处理器块")
    assert(ast.isIdentifierExpr(ast.exprAt(解包).kids[0]), "操作数是标识符")
    let 异或 = ast.stmtChild(id = 语句[1], index = 1)
    assert(ast.isExpr(id = 异或, kind = .exprBinary), "中缀仍是二元")
    assert(ast.exprAt(异或).op == kindTag(.opBitXor), "中缀是按位异或")
    return

; 处理器白名单：单行处理器只收控制流语句与 pass，其余报语法诊断。
try处理器白名单|test() -> ():
    let src = "f|func() -> ():\n    try 取() else 错误: 记()\n"
    let 结果 = parseText(src)
    assert(len(结果.diagnostics) > 0, "非控制流处理器应报错")
    return

; 特征声明：`<名>` 体收抽象签名与变量签名；`<<名>>` 体收带默认实现的方法。
特征块|test() -> ():
    let src = "<可比较>\n比较|self(其他: own,) -> I32\n名字: String\n\n<<可比较>>\n默认比较|self(其他: own,) -> I32:\n    return 0\n\nf|func() -> ():\n    return\n"
    let 结果 = parseText(src)
    var 诊断 = ""
    if len(结果.diagnostics) > 0:
        诊断 = 结果.diagnostics[0].message
    assert(len(结果.diagnostics) == 0, "不应有语法诊断：" + 诊断)
    let ast = 结果.ast
    assert(ast.itemCount() == 3, "特征声明、特征扩展与函数三条")
    let 声明 = ast.declAt(ast.itemAt(0))
    assert(ast.isDecl(id = ast.itemAt(0), kind = .declTrait), "特征声明")
    assert(声明.nameEnd - 声明.nameStart == 9, "特征名占三字节的三倍：可比较")
    assert(len(声明.kids) == 2, "两条签名")
    let 方法 = ast.declAt(声明.kids[0])
    assert(isFunctionDeclCode(方法.kind), "抽象方法用函数声明承载")
    assert(方法.isSelf, "带自身修饰")
    assert(方法.body < 0, "抽象方法无体")
    assert(len(方法.kids) == 1, "一个形参")
    let 形参 = ast.declAt(方法.kids[0])
    assert(ast.typeAt(形参.typeId).nameEnd - ast.typeAt(形参.typeId).nameStart == 3, "形参类型是本型 own")
    let 变量 = ast.declAt(声明.kids[1])
    assert(isFieldDeclCode(变量.kind), "变量签名用字段承载")
    let 扩展 = ast.declAt(ast.itemAt(1))
    assert(ast.isDecl(id = ast.itemAt(1), kind = .declTraitExtension), "特征扩展")
    assert(len(扩展.kids) == 1, "一条默认实现")
    assert(ast.declAt(扩展.kids[0]).body >= 0, "默认实现带体")
    assert(ast.isDecl(id = ast.itemAt(2), kind = .declFunction), "顶层函数未被吞入特征体")
    return

; 导出块：条目可省目标；带目标时目标名单独成节点，符号是无修饰名。
导出块|test() -> ():
    let src = "[a|export]\n加 = 原加\n输出|c = 原输出\n\nf|func() -> ():\n    return\n"
    let 结果 = parseText(src)
    var 诊断 = ""
    if len(结果.diagnostics) > 0:
        诊断 = 结果.diagnostics[0].message
    assert(len(结果.diagnostics) == 0, "不应有语法诊断：" + 诊断)
    let ast = 结果.ast
    assert(ast.itemCount() == 2, "导出块与函数两条")
    let 块 = ast.declAt(ast.itemAt(0))
    assert(ast.isDecl(id = ast.itemAt(0), kind = .declExportBlock), "导出块")
    assert(len(块.kids) == 2, "两条导出项")
    let 首 = ast.declAt(块.kids[0])
    assert(isExportEntryCode(首.kind), "导出项")
    assert(len(首.kids) == 1, "缺省目标不落节点")
    assert(ast.isIdentifierExpr(首.kids[0]), "符号是标识符")
    let 次 = ast.declAt(块.kids[1])
    assert(len(次.kids) == 2, "带目标多一个节点")
    assert(ast.isDecl(id = 次.kids[1], kind = .declExportTarget), "目标节点")
    return

; 给定块：`[名|given]` 与对象体同规，字段可带初值。
给定块|test() -> ():
    let src = "[默认|given]\n名字: String = \"x\"\n次数: I32 = 0\n"
    let 结果 = parseText(src)
    var 诊断 = ""
    if len(结果.diagnostics) > 0:
        诊断 = 结果.diagnostics[0].message
    assert(len(结果.diagnostics) == 0, "不应有语法诊断：" + 诊断)
    let ast = 结果.ast
    let 块 = ast.declAt(ast.itemAt(0))
    assert(ast.isDecl(id = ast.itemAt(0), kind = .declGiven), "给定块")
    assert(len(块.kids) == 2, "两个字段")
    let 首 = ast.declAt(块.kids[0])
    assert(isFieldDeclCode(首.kind), "字段节点")
    assert(len(首.kids) == 1, "带初值")
    return

; 不安全前缀：`unsafe 调用()` 成专用前缀节点，操作数保持调用子树。
不安全前缀|test() -> ():
    let src = "f|func() -> ():\n    let p = unsafe 取()\n    return\n"
    let 结果 = parseText(src)
    assert(len(结果.diagnostics) == 0, "不应有语法诊断")
    let ast = 结果.ast
    let 体 = ast.declAt(ast.itemAt(0)).body
    let 语句 = ast.stmtAt(体).kids
    let 初值 = ast.stmtChild(id = 语句[0], index = 1)
    assert(ast.isUnsafeExpr(初值), "前缀是专用节点")
    assert(ast.isCallExpr(ast.exprAt(初值).kids[0]), "操作数是调用")
    return

; 声明头泛型：结构、对象、枚举、给定与特征的名字后都可带形参表，一件不落。
泛型头|test() -> ():
    let src = "(盒<T>)\nx: T\n\n[列<T>]\n无\n\n{物<T>}\nx: T\n\n[给<T>|given]\nx: T = 0\n\n<特<T>>\n取得|self() -> T\n\n<<特<T>>>\n取得|self() -> T:\n    return 0\n"
    let 结果 = parseText(src)
    var 诊断 = ""
    if len(结果.diagnostics) > 0:
        诊断 = 结果.diagnostics[0].message
    assert(len(结果.diagnostics) == 0, "不应有语法诊断：" + 诊断)
    let ast = 结果.ast
    assert(ast.itemCount() == 6, "六条声明")
    assert(len(ast.declAt(ast.itemAt(0)).generic) == 1, "结构头泛型")
    assert(len(ast.declAt(ast.itemAt(1)).generic) == 1, "枚举头泛型")
    assert(len(ast.declAt(ast.itemAt(2)).generic) == 1, "对象头泛型")
    assert(len(ast.declAt(ast.itemAt(3)).generic) == 1, "给定头泛型")
    assert(len(ast.declAt(ast.itemAt(4)).generic) == 1, "特征头泛型")
    assert(len(ast.declAt(ast.itemAt(5)).generic) == 1, "特征扩展头泛型")
    let 形参 = ast.declAt(ast.declAt(ast.itemAt(0)).generic[0])
    assert(ast.isDecl(id = ast.declAt(ast.itemAt(0)).generic[0], kind = .declParam), "形参用参数节点承载")
    assert(形参.nameEnd - 形参.nameStart == 1, "形参名一字节")
    return

; 内嵌组合：结构体首行裸类型名成一条字段，标为组合位；后续字段照常。
内嵌组合|test() -> ():
    let src = "(子)\n父\nx: I32\n"
    let 结果 = parseText(src)
    assert(len(结果.diagnostics) == 0, "不应有语法诊断")
    let ast = 结果.ast
    let 结构 = ast.declAt(ast.itemAt(0))
    assert(len(结构.kids) == 2, "组合字段加一个普通字段")
    let 组合 = ast.declAt(结构.kids[0])
    assert(组合.composed, "首行标组合位")
    assert(ast.isType(id = 组合.typeId, kind = .typeNamed), "组合字段的类型具名")
    assert(ast.typeAt(组合.typeId).nameEnd - ast.typeAt(组合.typeId).nameStart == 3, "类型名与字段名同宽：父")
    assert(!ast.declAt(结构.kids[1]).composed, "普通字段不标组合位")
    return

; 实现行：结构、对象与枚举体里的 `实现: 特征` 各成一条声明，不混入字段或用例。
实现行|test() -> ():
    let src = "(P)\n实现: 可打印\nx: I32\n\n{Q}\n实现: 相等\n\n[R]\n甲\n实现: 错误\n"
    let 结果 = parseText(src)
    var 诊断 = ""
    if len(结果.diagnostics) > 0:
        诊断 = 结果.diagnostics[0].message
    assert(len(结果.diagnostics) == 0, "不应有语法诊断：" + 诊断)
    let ast = 结果.ast
    let 结构 = ast.declAt(ast.itemAt(0))
    assert(isImplementsDeclCode(ast.declAt(结构.kids[0]).kind), "结构体首条是实现行")
    assert(ast.isType(id = ast.declAt(结构.kids[0]).typeId, kind = .typeNamed), "特征名是具名类型")
    assert(isFieldDeclCode(ast.declAt(结构.kids[1]).kind), "字段照常")
    let 对象 = ast.declAt(ast.itemAt(1))
    assert(isImplementsDeclCode(ast.declAt(对象.kids[0]).kind), "对象体实现行")
    let 枚举 = ast.declAt(ast.itemAt(2))
    assert(isVariantDeclCode(ast.declAt(枚举.kids[0]).kind), "枚举首条是用例")
    assert(isImplementsDeclCode(ast.declAt(枚举.kids[1]).kind), "枚举实现行在后")
    return

; 结构头泛型：单条声明也把形参表挂在声明上，不混进顶层登记。
结构头泛型|test() -> ():
    let 结果 = parseText("(盒<T>)\nx: T\n")
    var 诊断 = ""
    if len(结果.diagnostics) > 0:
        诊断 = 结果.diagnostics[0].message
    assert(len(结果.diagnostics) == 0, "不应有诊断：" + 诊断)
    let ast = 结果.ast
    assert(ast.itemCount() == 1, "一条声明")
    let 结构 = ast.declAt(ast.itemAt(0))
    assert(len(结构.generic) == 1, "一个形参")
    return

; 标签控制流：`名|if` / `名|while` / `名|for` 把标签记在语句上，跳出与继续各带标签。
标签控制流|test() -> ():
    let src = "f|func(表: Array<I32>,) -> ():\n    外层|while 真值:\n        内层|for (项,) in 表:\n            break 内层\n        continue 外层\n    return\n"
    let 结果 = parseText(src)
    var 诊断 = ""
    if len(结果.diagnostics) > 0:
        诊断 = 结果.diagnostics[0].message
    assert(len(结果.diagnostics) == 0, "不应有语法诊断：" + 诊断)
    let ast = 结果.ast
    let 体 = ast.declAt(ast.itemAt(0)).body
    let 外层 = ast.stmtAt(体).kids[0]
    assert(ast.isWhileStmt(外层), "外层是循环")
    assert(ast.stmtAt(外层).nameEnd - ast.stmtAt(外层).nameStart == 6, "标签占两字六字节：外层")
    let 内层 = ast.stmtAt(外层).kids[1]
    assert(ast.isBlockStmt(内层), "循环体是块")
    let 内层循环 = ast.stmtAt(内层).kids[0]
    assert(ast.isForStmt(内层循环), "内层是遍历")
    assert(ast.stmtAt(内层循环).nameEnd - ast.stmtAt(内层循环).nameStart == 6, "内层标签")
    let 内层体 = ast.stmtAt(内层循环).kids[2]
    let 跳出 = ast.stmtAt(内层体).kids[0]
    assert(ast.isBreakStmt(跳出), "跳出语句")
    let 跳出名 = ast.stmtChild(id = 跳出, index = 0)
    assert(ast.isIdentifierExpr(跳出名), "跳出带标签")
    let 继续 = ast.stmtAt(内层).kids[1]
    assert(ast.isContinueStmt(继续), "继续语句")
    let 继续名 = ast.stmtChild(id = 继续, index = 0)
    assert(ast.isIdentifierExpr(继续名), "继续带标签")
    return

; capture：函数字面量体里逐行捕获，名字落区间。
capture语句|test() -> ():
    let src = "g|func(x: I32,) -> ():\n    return\n\nf|func() -> ():\n    let 闭包 = func() -> ():\n        capture x\n        return\n    return\n"
    let 结果 = parseText(src)
    var 诊断 = ""
    if len(结果.diagnostics) > 0:
        诊断 = 结果.diagnostics[0].message
    assert(len(结果.diagnostics) == 0, "不应有语法诊断：" + 诊断)
    let ast = 结果.ast
    assert(ast.itemCount() == 2, "两个函数")
    let 体 = ast.declAt(ast.itemAt(1)).body
    let 变量 = ast.stmtAt(体).kids[0]
    let 闭包 = ast.stmtChild(id = 变量, index = 1)
    assert(ast.isExpr(id = 闭包, kind = .exprFunction), "右值是函数字面量")
    let 闭包体 = ast.exprAt(闭包).kids[len(ast.exprAt(闭包).kids) - 1]
    assert(ast.isBlockStmt(闭包体), "字面量体是块")
    let 捕获 = ast.stmtAt(闭包体).kids[0]
    assert(ast.isCaptureStmt(捕获), "首条是捕获")
    assert(ast.stmtAt(捕获).nameEnd - ast.stmtAt(捕获).nameStart == 1, "捕获名一字节")
    return

; unroll：模式、表与体三段，模式元组与遍历同构。
unroll语句|test() -> ():
    let src = "f|func(表: Array<I32>,) -> ():\n    unroll (项,) in 表:\n        return\n    return\n"
    let 结果 = parseText(src)
    var 诊断 = ""
    if len(结果.diagnostics) > 0:
        诊断 = 结果.diagnostics[0].message
    assert(len(结果.diagnostics) == 0, "不应有语法诊断：" + 诊断)
    let ast = 结果.ast
    let 体 = ast.declAt(ast.itemAt(0)).body
    let 展开 = ast.stmtAt(体).kids[0]
    assert(ast.isUnrollStmt(展开), "展开语句")
    assert(len(ast.stmtAt(展开).kids) == 3, "模式、表与体")
    assert(ast.isBlockStmt(ast.stmtAt(展开).kids[2]), "体是块")
    return

; defer 单行：冒号后同行的语句进块，与块形式同一形状。
defer单行|test() -> ():
    let src = "f|func() -> ():\n    defer 记()\n    defer:\n        记()\n    return\n"
    let 结果 = parseText(src)
    var 诊断 = ""
    if len(结果.diagnostics) > 0:
        诊断 = 结果.diagnostics[0].message
    assert(len(结果.diagnostics) == 0, "不应有语法诊断：" + 诊断)
    let ast = 结果.ast
    let 体 = ast.declAt(ast.itemAt(0)).body
    let 单行 = ast.stmtAt(体).kids[0]
    assert(ast.isDeferStmt(单行), "单行延迟")
    assert(ast.isBlockStmt(ast.stmtChild(id = 单行, index = 0)), "单行也存成块")
    let 块 = ast.stmtAt(体).kids[1]
    assert(ast.isDeferStmt(块), "块延迟")
    return

; 异步面：`=>` 置异步位，函数声明与函数字面量各一处；返回表与 `->` 同形。
异步箭头|test() -> ():
    let src = "取|func() => (I32,):\n    return 0\n\nf|func() -> ():\n    let g = func() => (I32,):\n        return 0\n    return\n"
    let 结果 = parseText(src)
    var 诊断 = ""
    if len(结果.diagnostics) > 0:
        诊断 = 结果.diagnostics[0].message
    assert(len(结果.diagnostics) == 0, "不应有语法诊断：" + 诊断)
    let ast = 结果.ast
    let 声明 = ast.declAt(ast.itemAt(0))
    assert(声明.isAsync, "`=>` 声明异步")
    assert(ast.isType(id = 声明.typeId, kind = .typeNamed), "返回表按单元素折叠")
    assert(!ast.declAt(ast.itemAt(1)).isAsync, "`->` 声明不同步")
    let 体 = ast.declAt(ast.itemAt(1)).body
    let 变量 = ast.stmtAt(体).kids[0]
    let 字面量 = ast.stmtChild(id = 变量, index = 1)
    assert(ast.isExpr(id = 字面量, kind = .exprFunction), "右值是函数字面量")
    assert(ast.exprAt(字面量).isAsync, "`=>` 字面量异步")
    return

; 等待前缀：`await` 与 `wait` 同形不同类别码，操作数是整条后缀链。
等待前缀|test() -> ():
    let src = "f|func() => (I32,):\n    let a = await 取()\n    let b = wait 取()\n    return a + b\n"
    let 结果 = parseText(src)
    var 诊断 = ""
    if len(结果.diagnostics) > 0:
        诊断 = 结果.diagnostics[0].message
    assert(len(结果.diagnostics) == 0, "不应有语法诊断：" + 诊断)
    let ast = 结果.ast
    let 体 = ast.declAt(ast.itemAt(0)).body
    let 首语句 = ast.stmtAt(体).kids[0]
    let 让出 = ast.stmtChild(id = 首语句, index = 1)
    assert(ast.isJoinExpr(让出), "await 是等待节点")
    assert(ast.exprAt(让出).op == kindTag(.kwAwait), "让出式记 await")
    assert(ast.isCallExpr(ast.exprAt(让出).kids[0]), "操作数是调用")
    let 次语句 = ast.stmtAt(体).kids[1]
    let 占用 = ast.stmtChild(id = 次语句, index = 1)
    assert(ast.isJoinExpr(占用), "wait 是等待节点")
    assert(ast.exprAt(占用).op == kindTag(.kwWait), "占用式记 wait")
    return

; 分离语句：`detach 表达式` 单条语句，表达式是唯一子节点。
分离语句|test() -> ():
    let src = "f|func() -> ():\n    detach 子任务(1)\n    return\n"
    let 结果 = parseText(src)
    var 诊断 = ""
    if len(结果.diagnostics) > 0:
        诊断 = 结果.diagnostics[0].message
    assert(len(结果.diagnostics) == 0, "不应有语法诊断：" + 诊断)
    let ast = 结果.ast
    let 体 = ast.declAt(ast.itemAt(0)).body
    let 语句 = ast.stmtAt(体).kids[0]
    assert(ast.isDetachStmt(语句), "分离语句")
    let 调用 = ast.stmtChild(id = 语句, index = 0)
    assert(ast.isCallExpr(调用), "子节点是调用")
    return

; 插值段：整条串一个节点，插值段内的表达式进池；字面段不落节点。
插值段|test() -> ():
    let src = "f|func(x: I32,) -> (String,):\n    return \"值=\\(x + 1) 完\"\n"
    let 结果 = parseText(src)
    var 诊断 = ""
    if len(结果.diagnostics) > 0:
        诊断 = 结果.diagnostics[0].message
    assert(len(结果.diagnostics) == 0, "不应有语法诊断：" + 诊断)
    let ast = 结果.ast
    let 体 = ast.declAt(ast.itemAt(0)).body
    let 语句 = ast.stmtAt(体).kids[0]
    let 串 = ast.stmtChild(id = 语句, index = 0)
    assert(ast.isInterpolatedExpr(串), "插值串节点")
    let 段内 = ast.exprAt(串).kids
    assert(len(段内) == 1, "一个插值段")
    assert(ast.isExpr(id = 段内[0], kind = .exprBinary), "段内是二元表达式")
    assert(ast.exprAt(段内[0]).op == kindTag(.opAdd), "段内是加法")
    return

; 字典条目：条目成专用节点，键值各占一个 kid；`键: 类型 = 值` 的标注落在条目的 typeId。
字典条目|test() -> ():
    let src = "f|func() -> ():\n    let a = {\"k\" = 1,}\n    let b = {\"k\": I32 = 1,}\n    return\n"
    let 结果 = parseText(src)
    var 诊断 = ""
    if len(结果.diagnostics) > 0:
        诊断 = 结果.diagnostics[0].message
    assert(len(结果.diagnostics) == 0, "不应有语法诊断：" + 诊断)
    let ast = 结果.ast
    let 体 = ast.declAt(ast.itemAt(0)).body
    let 无标注 = ast.stmtChild(id = ast.stmtAt(体).kids[0], index = 1)
    assert(ast.isDictionaryExpr(无标注), "无标注仍是字典")
    let 条 = ast.exprAt(无标注).kids[0]
    assert(ast.isDictEntryExpr(条), "条目专用节点")
    assert(len(ast.exprAt(条).kids) == 2, "键与值")
    assert(ast.exprAt(条).typeId < 0, "无标注答 -1")
    let 有标注 = ast.stmtChild(id = ast.stmtAt(体).kids[1], index = 1)
    let 带类 = ast.exprAt(有标注).kids[0]
    assert(ast.isDictEntryExpr(带类), "带标注也是条目节点")
    assert(ast.isType(id = ast.exprAt(带类).typeId, kind = .typeNamed), "标注是具名类型")
    assert(ast.typeAt(ast.exprAt(带类).typeId).nameEnd - ast.typeAt(ast.exprAt(带类).typeId).nameStart == 3, "标注名 I32")
    return

; 顶层裸变量：`名: 类型 = 值` 不在顶级声明形态表内，行首标识符后跟冒号一律报顶级错误。
顶层裸变量被拒|test() -> ():
    let src = "x: I32 = 0\n\nf|func() -> ():\n    return\n"
    let 结果 = parseText(src)
    assert(len(结果.diagnostics) > 0, "顶层裸写法应报错")
    assert(结果.diagnostics[0].code == "E2-005", "错误码 E2-005")
    assert(结果.diagnostics[0].message.contains("无效的顶级声明"), "消息指向顶级声明")
    assert(结果.ast.itemCount() == 1, "只有函数进顶层")
    assert(结果.ast.isDecl(id = 结果.ast.itemAt(0), kind = .declFunction), "唯一条目是函数")
    return

; 字典条目缺 `=`：带标注也须写赋值，缺了报专用诊断而不静默吞成集合。
字典条目缺赋值|test() -> ():
    let src = "f|func() -> ():\n    let a = {\"k\": I32 1,}\n    return\n"
    let 结果 = parseText(src)
    assert(len(结果.diagnostics) > 0, "缺赋值应报错")
    assert(结果.diagnostics[0].code == "E2-001", "错误码 E2-001")
    return

; 插值段多表达式：段内只收一条表达式，多写的部分报错而不静默丢弃。
插值段多表达式|test() -> ():
    let src = "f|func(a: I32, b: I32,) -> (String,):\n    return \"\\(a b)\"\n"
    let 结果 = parseText(src)
    assert(len(结果.diagnostics) > 0, "段内多表达式应报错")
    assert(结果.diagnostics[0].code == "E2-001", "错误码 E2-001")
    return

; 块名与关键字同形：导入块头名取文件名，`[foreign|import]` 应照常建块。
关键字块名|test() -> ():
    let 结果 = parseText("[foreign|import]\nx = \"../x\"\n")
    assert(len(结果.diagnostics) == 0, "不应有语法诊断")
    assert(结果.ast.itemCount() == 1, "一条导入块")
    assert(结果.ast.isDecl(id = 结果.ast.itemAt(0), kind = .declImportBlock), "导入块")
    return

; 扩展块闭合：成员只收 `|self` 与 `|own`，其后的 `|func` 回到顶层。
扩展块遇函数闭合|test() -> ():
    let src = "((盒))\n取|self() -> (I32,):\n    return 1\n\n自由|func() -> (I32,):\n    return 2\n"
    let 结果 = parseText(src)
    assert(len(结果.diagnostics) == 0, "不应有语法诊断")
    assert(结果.ast.itemCount() == 2, "扩展块与函数各一条")
    assert(结果.ast.isDecl(id = 结果.ast.itemAt(0), kind = .declExtension), "首条是扩展块")
    assert(结果.ast.isDecl(id = 结果.ast.itemAt(1), kind = .declFunction), "次条是顶层函数")
    let 扩展 = 结果.ast.declAt(结果.ast.itemAt(0))
    assert(len(扩展.kids) == 1, "扩展块只收一个方法")
    return

; 泛型函数：类型形参记在声明上，调用点按泛型应用收类型实参。
泛型函数头|test() -> ():
    let src = "map|func<T, R>(a: T, f: (T,) -> (R,),) -> (R,):\n    return f(a)\n\nuse|func() -> (I32,):\n    return map<I32, I32>(1, id)\n"
    let 结果 = parseText(src)
    assert(len(结果.diagnostics) == 0, "不应有语法诊断")
    let ast = 结果.ast
    let 声明 = ast.declAt(ast.itemAt(0))
    assert(len(声明.generic) == 2, "两个类型形参")
    let 首个 = ast.declAt(声明.generic[0])
    assert(首个.nameStart == 9, "T 起点")
    assert(首个.nameEnd == 10, "T 终点")
    let 使用 = ast.declAt(ast.itemAt(1))
    let 返回 = ast.stmtChild(id = 使用.body, index = 0)
    let 调用 = ast.stmtChild(id = 返回, index = 0)
    assert(ast.isExpr(id = 调用, kind = .exprGeneric), "调用点记为泛型应用")
    assert(len(ast.exprAt(调用).kids) == 2, "两个值实参")
    let 类型 = ast.typeAt(ast.exprAt(调用).typeId)
    assert(类型.kind == kindTag(.typeGeneric), "类型位是泛型类型")
    assert(len(类型.kids) == 2, "两个类型实参")
    return

; 类型形参约束不在本批范围：函数头带约束时语法面直接拒绝。
类型形参约束拒绝|test() -> ():
    let 结果 = parseText("f|func<T: I32>(a: T,) -> (T,):\n    return a\n")
    assert(len(结果.diagnostics) > 0, "应报诊断")
    assert(结果.diagnostics[0].code == "E2-001", "错误码 E2-001")
    return

; 泛型方法尚不支持：扩展块成员带类型形参时语法面直接拒绝。
泛型方法拒绝|test() -> ():
    let 结果 = parseText("((盒))\n取|self<T>(a: T,) -> (T,):\n    return a\n")
    assert(len(结果.diagnostics) > 0, "应报诊断")
    assert(结果.diagnostics[0].code == "E2-001", "错误码 E2-001")
    return
