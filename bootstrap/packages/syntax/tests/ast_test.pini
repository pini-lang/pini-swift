; 池只追加：同类别节点依次得到连续下标，旧的仍可按原下标读回。
节点池|test() -> ():
    var ast = Ast()
    let first = ast.pushExpr(exprInteger, 0, 3)
    let second = ast.pushExpr(exprIdentifier, 4, 5)
    assert(first == 0, "首个表达式下标为零")
    assert(second == 1, "第二个表达式下标为一")
    assert(ast.exprCount() == 2, "池长度随追加增长")
    assert(ast.isExpr(second, exprIdentifier), "类别判定")
    assert(ast.exprAt(first).end == 3, "旧节点跨度不变")
    return

; 跨池不串号：类型、表达式、语句与声明各自计数，互不影响。
分池计数|test() -> ():
    var ast = Ast()
    let typeId = ast.pushType(typeNamed, 0, 3)
    let stmtId = ast.pushStmt(stmtReturn, 0, 6)
    let declId = ast.pushDecl(declFunction, 0, 10)
    assert(typeId == 0, "类型池下标")
    assert(stmtId == 0, "语句池下标")
    assert(declId == 0, "声明池下标")
    assert(ast.typeCount() == 1, "类型池长度")
    assert(ast.stmtCount() == 1, "语句池长度")
    assert(ast.declCount() == 1, "声明池长度")
    assert(ast.exprCount() == 0, "表达式池空")
    return

; 缺省子节点：越界或负下标一律答 -1，调用方据此判缺省而不判崩溃。
缺省子节点|test() -> ():
    var ast = Ast()
    let id = ast.pushExpr(exprBinary, 0, 5)
    assert(ast.childOf(id, 0) == -1, "空子表越界答 -1")
    assert(ast.childOf(id, -1) == -1, "负下标答 -1")
    return

; 跨包谓词：三类表达式各自判定，互不串类。
跨包谓词|test() -> ():
    var ast = Ast()
    let ident = ast.pushExpr(exprIdentifier, 0, 1)
    let member = ast.pushExpr(exprMember, 0, 3)
    let call = ast.pushExpr(exprCall, 0, 5)
    assert(ast.isIdentifierExpr(ident), "标识符应命中")
    assert(!ast.isIdentifierExpr(member), "成员不得判作标识符")
    assert(ast.isMemberExpr(member), "成员应命中")
    assert(!ast.isMemberExpr(call), "调用不得判作成员")
    assert(ast.isCallExpr(call), "调用应命中")
    assert(!ast.isCallExpr(ident), "标识符不得判作调用")
    return

; 字面量谓词：六类各自命中，布尔覆盖真与假两种拼写。
字面量谓词|test() -> ():
    var ast = Ast()
    let integer = ast.pushExpr(exprInteger, 0, 1)
    let float = ast.pushExpr(exprFloat, 0, 3)
    let string = ast.pushExpr(exprString, 0, 5)
    let yes = ast.pushExpr(exprTrue, 0, 4)
    let no = ast.pushExpr(exprFalse, 0, 5)
    let none = ast.pushExpr(exprNil, 0, 3)
    let interp = ast.pushExpr(exprInterpolated, 0, 8)
    assert(ast.isIntegerExpr(integer), "整数应命中")
    assert(!ast.isIntegerExpr(float), "浮点不得判作整数")
    assert(ast.isFloatExpr(float), "浮点应命中")
    assert(ast.isStringExpr(string), "字符串应命中")
    assert(ast.isBoolExpr(yes), "true 应判作布尔")
    assert(ast.isBoolExpr(no), "false 应判作布尔")
    assert(!ast.isBoolExpr(integer), "整数不得判作布尔")
    assert(ast.isNilExpr(none), "空值应命中")
    assert(ast.isInterpolatedExpr(interp), "插值应命中")
    assert(!ast.isInterpolatedExpr(string), "普通字符串不得判作插值")
    return
