[printer_test|import]
_support = "../../support"

; 源码打印器：规范形、注释锚回、转义往返与展开打印；断言比整段文本，不比行数。

; 打印锚回：整行注随所属块缩进，行尾注留在同源行末，隔一空格；块首上方的空行按块内规则丢弃。
打印锚回|test() -> ():
    let source = "; 头注\n\nmain|func() -> ():\n    ; 体内\n    print(\"hi\") ; 行尾\n    return\n"
    let printed = printChecked(source)
    assert(printed.ok, "解析应通过")
    assert(printed.text == "; 头注\nmain|func() -> ():\n    ; 体内\n    print(\"hi\") ; 行尾\n    return\n", "注释按位置锚回")
    return

; 打印不动：打印结果再打印一次逐字相同。
打印不动|test() -> ():
    let source = "(点)\nx: F64 = 0.0\n\n((点))\n长度|self() -> (F64,):\n    return self.x\n"
    let once = printChecked(source)
    let twice = printChecked(once.text)
    assert(once.ok && twice.ok, "两次都应通过")
    assert(once.text == twice.text, "二次打印不动")
    return

; 打印转义：CRLF 在字符串值里是两个转义，不写成控制字节。
打印转义|test() -> ():
    let source = "main|func() -> ():\n    let a = \"x\\r\\ny\"\n    return\n"
    let printed = printChecked(source)
    assert(printed.ok, "解析应通过")
    assert(printed.text == source, "转义按规范写法保留")
    return

; 打印前缀：`!` 在操作数前是取反，不写成后缀解包。
打印前缀|test() -> ():
    let source = "main|func() -> ():\n    print(!a)\n    print(b!)\n    return\n"
    let printed = printChecked(source)
    assert(printed.ok, "解析应通过")
    assert(printed.text == source, "前后缀按源位置还原")
    return

; 展开打印：`unroll` 摊成多轮、模式名换成表里的字面量；注释不进产物。
展开打印|test() -> ():
    let source = "; 头注\nmain|func() -> ():\n    unroll (码,) in [(1,), (2,)]:\n        print(码)\n    return\n"
    let bytes = tempUtf8Bytes(source)
    let parsed = parseFile(text = source, file = "")
    let expanded = expandUnrolls(ast = parsed.ast, bytes = bytes)
    assert(len(expanded.errors) == 0, "展开不应报错")
    let text = printExpandedModule(ast = expanded.ast, bytes = bytes, source = makeSourceText(source))
    assert(text == "main|func() -> ():\n    print(1)\n    print(2)\n    return\n", "按展开后的树重建，注释不出现")
    return
