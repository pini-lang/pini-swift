; 语法树：四类节点分池存放，子节点用池下标引用；池只追加，节点身份即下标。
(Ast)
types: Array<TypeNode> = []
exprs: Array<ExprNode> = []
stmts: Array<StmtNode> = []
decls: Array<DeclNode> = []
items: Array<I32> = []

; 类型节点：`kids` 是元素或实参，函数类型另用 `ret` 指向返回类型。
(TypeNode)
kind: I32 = 0
start: I32 = 0
end: I32 = 0
nameStart: I32 = -1
nameEnd: I32 = -1
kids: Array<I32> = []
ret: I32 = -1

; 表达式节点：`op` 是运算符记号码，`typeId` 是转换节点的目标类型与字典条目的值标注，
; `body` 是 try 的处理器块；`isAsync` 只对函数字面量成立，`kids` 按源序排列。
(ExprNode)
kind: I32 = 0
start: I32 = 0
end: I32 = 0
nameStart: I32 = -1
nameEnd: I32 = -1
op: I32 = 0
typeId: I32 = -1
body: I32 = -1
isAsync: Bool = false
kids: Array<I32> = []

; 语句节点：块与分支体都是语句池下标，`kids` 的排布由类别码决定；
; `nameStart`/`nameEnd` 只给带标签的控制流与 capture 用。
(StmtNode)
kind: I32 = 0
start: I32 = 0
end: I32 = 0
op: I32 = 0
typeId: I32 = -1
nameStart: I32 = -1
nameEnd: I32 = -1
kids: Array<I32> = []

; 声明节点：参数、字段、变体与导入项同池，`typeId` 与 `body` 按需填写；
; `generic` 是类型形参表，只有可带泛型的声明用它；`isAsync` 由 `=>` 置位。
(DeclNode)
kind: I32 = 0
start: I32 = 0
end: I32 = 0
nameStart: I32 = -1
nameEnd: I32 = -1
typeId: I32 = -1
body: I32 = -1
mutable: Bool = false
isTest: Bool = false
isForeign: Bool = false
isOwn: Bool = false
isUsing: Bool = false
isSelf: Bool = false
isAsync: Bool = false
kids: Array<I32> = []
generic: Array<I32> = []
composed: Bool = false

; 表达式类别：前缀避开记号类别名，包内枚举项名不得重名。
[ExprKind]
exprUnknown
exprInteger
exprFloat
exprString
exprInterpolated
exprTrue
exprFalse
exprNil
exprIdentifier
exprCase
exprMember
exprSubscript
exprSlice
exprCall
exprUnary
exprBinary
exprTuple
exprArray
exprDictionary
exprSet
exprFunction
exprCast
exprTry
exprUnsafe
exprJoin
exprDictEntry

; 语句类别：`stmtIf` 的 `kids` 是条件、体、否则如果对与否则体，缺省体答 -1。
[StmtKind]
stmtUnknown
stmtBlock
stmtVariable
stmtAssign
stmtExpression
stmtIf
stmtWhile
stmtFor
stmtMatch
stmtReturn
stmtBreak
stmtContinue
stmtPass
stmtDefer
stmtCapture
stmtUnroll
stmtDetach

; 声明类别：函数、测试与方法同形，差别在 `isTest` 与 `isSelf`。
[DeclKind]
declUnknown
declStruct
declObject
declEnum
declExtension
declFunction
declVariable
declImportBlock
declImportEntry
declField
declParam
declVariant
declForeign
declForeignSymbol
declForeignFlag
declTrait
declTraitExtension
declExportBlock
declExportEntry
declExportTarget
declGiven
declImplements

; 类型类别：`typeGeneric` 的 `kids` 是实参，`typeFunction` 的 `kids` 是形参、`ret` 是返回。
; 容器四类是类型位的写法糖，`kids` 即组件类型：数组与集合一个，字典两个，结果为被包裹者。
[TypeKind]
typeUnknown
typeNamed
typeGeneric
typeOptional
typePointer
typeTuple
typeFunction
typeArray
typeSet
typeDictionary
typeResult

; 表达式类别码：只用于比较与索引，不参与枚举相等。
exprKindTag|func(_kind: ExprKind,) -> (I32,):
    match _kind:
        case exprUnknown:
            return 0
        case exprInteger:
            return 1
        case exprFloat:
            return 2
        case exprString:
            return 3
        case exprInterpolated:
            return 4
        case exprTrue:
            return 5
        case exprFalse:
            return 6
        case exprNil:
            return 7
        case exprIdentifier:
            return 8
        case exprCase:
            return 9
        case exprMember:
            return 10
        case exprSubscript:
            return 11
        case exprSlice:
            return 12
        case exprCall:
            return 13
        case exprUnary:
            return 14
        case exprBinary:
            return 15
        case exprTuple:
            return 16
        case exprArray:
            return 17
        case exprDictionary:
            return 18
        case exprSet:
            return 19
        case exprFunction:
            return 20
        case exprCast:
            return 21
        case exprTry:
            return 22
        case exprUnsafe:
            return 23
        case exprJoin:
            return 24
        case exprDictEntry:
            return 25
    return 0

; 语句类别码。
stmtKindTag|func(_kind: StmtKind,) -> (I32,):
    match _kind:
        case stmtUnknown:
            return 0
        case stmtBlock:
            return 1
        case stmtVariable:
            return 2
        case stmtAssign:
            return 3
        case stmtExpression:
            return 4
        case stmtIf:
            return 5
        case stmtWhile:
            return 6
        case stmtFor:
            return 7
        case stmtMatch:
            return 8
        case stmtReturn:
            return 9
        case stmtBreak:
            return 10
        case stmtContinue:
            return 11
        case stmtPass:
            return 12
        case stmtDefer:
            return 13
        case stmtCapture:
            return 14
        case stmtUnroll:
            return 15
        case stmtDetach:
            return 16
    return 0

; 声明类别码。
declKindTag|func(_kind: DeclKind,) -> (I32,):
    match _kind:
        case declUnknown:
            return 0
        case declStruct:
            return 1
        case declObject:
            return 2
        case declEnum:
            return 3
        case declExtension:
            return 4
        case declFunction:
            return 5
        case declVariable:
            return 6
        case declImportBlock:
            return 7
        case declImportEntry:
            return 8
        case declField:
            return 9
        case declParam:
            return 10
        case declVariant:
            return 11
        case declForeign:
            return 12
        case declForeignSymbol:
            return 13
        case declForeignFlag:
            return 14
        case declTrait:
            return 15
        case declTraitExtension:
            return 16
        case declExportBlock:
            return 17
        case declExportEntry:
            return 18
        case declExportTarget:
            return 19
        case declGiven:
            return 20
        case declImplements:
            return 21
    return 0

; 类型类别码。
typeKindTag|func(_kind: TypeKind,) -> (I32,):
    match _kind:
        case typeUnknown:
            return 0
        case typeNamed:
            return 1
        case typeGeneric:
            return 2
        case typeOptional:
            return 3
        case typePointer:
            return 4
        case typeTuple:
            return 5
        case typeFunction:
            return 6
        case typeArray:
            return 7
        case typeSet:
            return 8
        case typeDictionary:
            return 9
        case typeResult:
            return 10
    return 0

((Ast))
; 追加类型节点：返回新节点下标；池只增不减，既有下标保持有效。
pushType|self(kind: TypeKind, start: I32, end: I32,) -> (I32,):
    var node = TypeNode()
    node.kind = typeKindTag(kind)
    node.start = start
    node.end = end
    self.types = self.types.append(node)
    return len(self.types) - 1
; 追加表达式节点：跨度是源内字节区间，名字区间由调用方另填。
pushExpr|self(kind: ExprKind, start: I32, end: I32,) -> (I32,):
    var node = ExprNode()
    node.kind = exprKindTag(kind)
    node.start = start
    node.end = end
    self.exprs = self.exprs.append(node)
    return len(self.exprs) - 1
pushStmt|self(kind: StmtKind, start: I32, end: I32,) -> (I32,):
    var node = StmtNode()
    node.kind = stmtKindTag(kind)
    node.start = start
    node.end = end
    self.stmts = self.stmts.append(node)
    return len(self.stmts) - 1
pushDecl|self(kind: DeclKind, start: I32, end: I32,) -> (I32,):
    var node = DeclNode()
    node.kind = declKindTag(kind)
    node.start = start
    node.end = end
    self.decls = self.decls.append(node)
    return len(self.decls) - 1
; 顶层登记：模块按源序保存声明下标。
addItem|self(_id: I32,) -> ():
    self.items = self.items.append(_id)
    return
typeCount|self() -> (I32,):
    return len(self.types)
exprCount|self() -> (I32,):
    return len(self.exprs)
stmtCount|self() -> (I32,):
    return len(self.stmts)
declCount|self() -> (I32,):
    return len(self.decls)
itemCount|self() -> (I32,):
    return len(self.items)
typeAt|self(_id: I32,) -> (TypeNode,):
    return self.types[_id]
exprAt|self(_id: I32,) -> (ExprNode,):
    return self.exprs[_id]
stmtAt|self(_id: I32,) -> (StmtNode,):
    return self.stmts[_id]
declAt|self(_id: I32,) -> (DeclNode,):
    return self.decls[_id]
itemAt|self(_index: I32,) -> (I32,):
    return self.items[_index]
; 节点身份判定：类别码是唯一判据。
isType|self(id: I32, kind: TypeKind,) -> (Bool,):
    return self.types[id].kind == typeKindTag(kind)
isExpr|self(id: I32, kind: ExprKind,) -> (Bool,):
    return self.exprs[id].kind == exprKindTag(kind)
; 跨包谓词：枚举值不能跨包引用，表达式类别只经这里分流。
isIdentifierExpr|self(_id: I32,) -> (Bool,):
    return self.exprs[_id].kind == exprKindTag(exprIdentifier)
isCaseExpr|self(_id: I32,) -> (Bool,):
    return self.exprs[_id].kind == exprKindTag(exprCase)
isMemberExpr|self(_id: I32,) -> (Bool,):
    return self.exprs[_id].kind == exprKindTag(exprMember)
isCallExpr|self(_id: I32,) -> (Bool,):
    return self.exprs[_id].kind == exprKindTag(exprCall)
isBinaryExpr|self(_id: I32,) -> (Bool,):
    return self.exprs[_id].kind == exprKindTag(exprBinary)
; 标签实参：二元节点、名字区间非空且运算符为赋值，三者同时成立。
isLabeledArgument|self(_id: I32,) -> (Bool,):
    if !self.isBinaryExpr(_id):
        return false
    let node = self.exprs[_id]
    if node.nameEnd <= node.nameStart:
        return false
    return node.op == kindTag(opAssign)
isIntegerExpr|self(_id: I32,) -> (Bool,):
    return self.exprs[_id].kind == exprKindTag(exprInteger)
isFloatExpr|self(_id: I32,) -> (Bool,):
    return self.exprs[_id].kind == exprKindTag(exprFloat)
isStringExpr|self(_id: I32,) -> (Bool,):
    return self.exprs[_id].kind == exprKindTag(exprString)
isBoolExpr|self(_id: I32,) -> (Bool,):
    if self.exprs[_id].kind == exprKindTag(exprTrue):
        return true
    return self.exprs[_id].kind == exprKindTag(exprFalse)
isNilExpr|self(_id: I32,) -> (Bool,):
    return self.exprs[_id].kind == exprKindTag(exprNil)
isInterpolatedExpr|self(_id: I32,) -> (Bool,):
    return self.exprs[_id].kind == exprKindTag(exprInterpolated)
isArrayExpr|self(_id: I32,) -> (Bool,):
    return self.exprs[_id].kind == exprKindTag(exprArray)
isTupleExpr|self(_id: I32,) -> (Bool,):
    return self.exprs[_id].kind == exprKindTag(exprTuple)
isDictionaryExpr|self(_id: I32,) -> (Bool,):
    return self.exprs[_id].kind == exprKindTag(exprDictionary)
isSetExpr|self(_id: I32,) -> (Bool,):
    return self.exprs[_id].kind == exprKindTag(exprSet)
isSubscriptExpr|self(_id: I32,) -> (Bool,):
    return self.exprs[_id].kind == exprKindTag(exprSubscript)
isSliceExpr|self(_id: I32,) -> (Bool,):
    return self.exprs[_id].kind == exprKindTag(exprSlice)
; 显式转换：目标类型在 `typeId`，操作数是唯一子节点。
isCastExpr|self(_id: I32,) -> (Bool,):
    return self.exprs[_id].kind == exprKindTag(exprCast)
; 错误处理：操作数是唯一子节点，错误名在名字区间，处理器块在 `body`；`body` 为 -1 即 `^` 解包糖。
isTryExpr|self(_id: I32,) -> (Bool,):
    return self.exprs[_id].kind == exprKindTag(exprTry)
; 不安全前缀：操作数是唯一子节点。
isUnsafeExpr|self(_id: I32,) -> (Bool,):
    return self.exprs[_id].kind == exprKindTag(exprUnsafe)
; 等待前缀：`await` 与 `wait` 同形，`op` 记关键字类别码以区分让出与占用。
isJoinExpr|self(_id: I32,) -> (Bool,):
    return self.exprs[_id].kind == exprKindTag(exprJoin)
; 字典条目：`kids` 是键与值，`typeId` 是值类型标注，缺省答 -1。
isDictEntryExpr|self(_id: I32,) -> (Bool,):
    return self.exprs[_id].kind == exprKindTag(exprDictEntry)
; 字面量：六类基本字面量合判，容器补判元素类型时用来分流。
isLiteralExpr|self(_id: I32,) -> (Bool,):
    if self.isIntegerExpr(_id) || self.isFloatExpr(_id):
        return true
    if self.isStringExpr(_id) || self.isInterpolatedExpr(_id):
        return true
    if self.isBoolExpr(_id) || self.isNilExpr(_id):
        return true
    return false
isStmt|self(id: I32, kind: StmtKind,) -> (Bool,):
    return self.stmts[id].kind == stmtKindTag(kind)
; 跨包谓词：枚举值不能跨包引用，语句类别只经这里分流。
isBlockStmt|self(_id: I32,) -> (Bool,):
    return self.stmts[_id].kind == stmtKindTag(stmtBlock)
isVariableStmt|self(_id: I32,) -> (Bool,):
    return self.stmts[_id].kind == stmtKindTag(stmtVariable)
; 变量语句的可变性：`var` 记可变，`let` 记不可变。
isMutableVariableStmt|self(_id: I32,) -> (Bool,):
    return self.stmts[_id].op == kindTag(kwVar)
isAssignStmt|self(_id: I32,) -> (Bool,):
    return self.stmts[_id].kind == stmtKindTag(stmtAssign)
isExpressionStmt|self(_id: I32,) -> (Bool,):
    return self.stmts[_id].kind == stmtKindTag(stmtExpression)
isIfStmt|self(_id: I32,) -> (Bool,):
    return self.stmts[_id].kind == stmtKindTag(stmtIf)
isWhileStmt|self(_id: I32,) -> (Bool,):
    return self.stmts[_id].kind == stmtKindTag(stmtWhile)
isForStmt|self(_id: I32,) -> (Bool,):
    return self.stmts[_id].kind == stmtKindTag(stmtFor)
isMatchStmt|self(_id: I32,) -> (Bool,):
    return self.stmts[_id].kind == stmtKindTag(stmtMatch)
isReturnStmt|self(_id: I32,) -> (Bool,):
    return self.stmts[_id].kind == stmtKindTag(stmtReturn)
isBreakStmt|self(_id: I32,) -> (Bool,):
    return self.stmts[_id].kind == stmtKindTag(stmtBreak)
isContinueStmt|self(_id: I32,) -> (Bool,):
    return self.stmts[_id].kind == stmtKindTag(stmtContinue)
isPassStmt|self(_id: I32,) -> (Bool,):
    return self.stmts[_id].kind == stmtKindTag(stmtPass)
isDeferStmt|self(_id: I32,) -> (Bool,):
    return self.stmts[_id].kind == stmtKindTag(stmtDefer)
isCaptureStmt|self(_id: I32,) -> (Bool,):
    return self.stmts[_id].kind == stmtKindTag(stmtCapture)
isUnrollStmt|self(_id: I32,) -> (Bool,):
    return self.stmts[_id].kind == stmtKindTag(stmtUnroll)
isDetachStmt|self(_id: I32,) -> (Bool,):
    return self.stmts[_id].kind == stmtKindTag(stmtDetach)
isDecl|self(id: I32, kind: DeclKind,) -> (Bool,):
    return self.decls[id].kind == declKindTag(kind)
; 子节点读取：越界答 -1，调用方按 -1 表示缺省。
childOf|self(id: I32, index: I32,) -> (I32,):
    if id < 0 || index < 0 || index >= len(self.exprs[id].kids):
        return -1
    return self.exprs[id].kids[index]
; 语句子节点：与表达式子节点同规。
stmtChild|self(id: I32, index: I32,) -> (I32,):
    if id < 0 || index < 0 || index >= len(self.stmts[id].kids):
        return -1
    return self.stmts[id].kids[index]
; 声明子节点：与表达式子节点同规。
declChild|self(id: I32, index: I32,) -> (I32,):
    if id < 0 || index < 0 || index >= len(self.decls[id].kids):
        return -1
    return self.decls[id].kids[index]
; 类型子节点：与表达式子节点同规。
typeChild|self(id: I32, index: I32,) -> (I32,):
    if id < 0 || index < 0 || index >= len(self.types[id].kids):
        return -1
    return self.types[id].kids[index]

; 类别判定：下游只问「是不是某类声明」，不自己比较类别码，也不依赖码值。
isStructDeclCode|func(_code: I32,) -> (Bool,):
    return _code == declKindTag(declStruct)

isObjectDeclCode|func(_code: I32,) -> (Bool,):
    return _code == declKindTag(declObject)

isEnumDeclCode|func(_code: I32,) -> (Bool,):
    return _code == declKindTag(declEnum)

isFunctionDeclCode|func(_code: I32,) -> (Bool,):
    return _code == declKindTag(declFunction)

isVariableDeclCode|func(_code: I32,) -> (Bool,):
    return _code == declKindTag(declVariable)

isExtensionDeclCode|func(_code: I32,) -> (Bool,):
    return _code == declKindTag(declExtension)

isImportBlockCode|func(_code: I32,) -> (Bool,):
    return _code == declKindTag(declImportBlock)

isImportEntryCode|func(_code: I32,) -> (Bool,):
    return _code == declKindTag(declImportEntry)

isFieldDeclCode|func(_code: I32,) -> (Bool,):
    return _code == declKindTag(declField)

isParamDeclCode|func(_code: I32,) -> (Bool,):
    return _code == declKindTag(declParam)

isVariantDeclCode|func(_code: I32,) -> (Bool,):
    return _code == declKindTag(declVariant)

isForeignDeclCode|func(_code: I32,) -> (Bool,):
    return _code == declKindTag(declForeign)

isForeignSymbolCode|func(_code: I32,) -> (Bool,):
    return _code == declKindTag(declForeignSymbol)

isForeignFlagCode|func(_code: I32,) -> (Bool,):
    return _code == declKindTag(declForeignFlag)

isTraitDeclCode|func(_code: I32,) -> (Bool,):
    return _code == declKindTag(declTrait)

isTraitExtensionCode|func(_code: I32,) -> (Bool,):
    return _code == declKindTag(declTraitExtension)

isExportBlockCode|func(_code: I32,) -> (Bool,):
    return _code == declKindTag(declExportBlock)

isExportEntryCode|func(_code: I32,) -> (Bool,):
    return _code == declKindTag(declExportEntry)

isGivenDeclCode|func(_code: I32,) -> (Bool,):
    return _code == declKindTag(declGiven)

isImplementsDeclCode|func(_code: I32,) -> (Bool,):
    return _code == declKindTag(declImplements)

; 类型类别判定：语义层按同一组入口分流，不自己认识类别码。
isNamedTypeCode|func(_code: I32,) -> (Bool,):
    return _code == typeKindTag(typeNamed)

isGenericTypeCode|func(_code: I32,) -> (Bool,):
    return _code == typeKindTag(typeGeneric)

isOptionalTypeCode|func(_code: I32,) -> (Bool,):
    return _code == typeKindTag(typeOptional)

isPointerTypeCode|func(_code: I32,) -> (Bool,):
    return _code == typeKindTag(typePointer)

isTupleTypeCode|func(_code: I32,) -> (Bool,):
    return _code == typeKindTag(typeTuple)

isFunctionTypeCode|func(_code: I32,) -> (Bool,):
    return _code == typeKindTag(typeFunction)

isArrayTypeCode|func(_code: I32,) -> (Bool,):
    return _code == typeKindTag(typeArray)

isSetTypeCode|func(_code: I32,) -> (Bool,):
    return _code == typeKindTag(typeSet)

isDictionaryTypeCode|func(_code: I32,) -> (Bool,):
    return _code == typeKindTag(typeDictionary)

isResultTypeCode|func(_code: I32,) -> (Bool,):
    return _code == typeKindTag(typeResult)
