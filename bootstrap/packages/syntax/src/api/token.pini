        case 19:
            return .kwStep
        case 20:
            return .kwFor
        case 21:
            return .kwIn
        case 22:
            return .kwTry
        case 23:
            return .kwReturn
        case 24:
            return .kwBreak
        case 25:
            return .kwContinue
        case 26:
            return .kwSelf
        case 27:
            return .kwOwn
        case 28:
            return .kwDefer
        case 29:
            return .kwImport
        case 30:
            return .kwExport
        case 31:
            return .kwNil
        case 32:
            return .kwCapture
        case 33:
            return .kwAwait
        case 34:
            return .kwWait
        case 35:
            return .kwUnsafe
        case 36:
            return .kwTest
        case 37:
            return .kwForeign
        case 38:
            return .kwDetach
        case 39:
            return .kwPass
        case 40:
            return .kwUsing
        case 41:
            return .kwUnroll
        case 42:
            return .opAdd
        case 43:
            return .opSub
        case 44:
            return .opMul
        case 45:
            return .opDiv
        case 46:
            return .opMod
        case 47:
            return .opInc
        case 48:
            return .opDec
        case 49:
            return .opAnd
        case 50:
            return .opOr
        case 51:
            return .opNot
        case 52:
            return .opEq
        case 53:
            return .opNe
        case 54:
            return .opLe
        case 55:
            return .opGe
        case 56:
            return .opLt
        case 57:
            return .opGt
        case 58:
            return .opBitAnd
        case 59:
            return .opBitOr
        case 60:
            return .opBitXor
        case 61:
            return .opBitNot
        case 62:
            return .opShl
        case 63:
            return .opShr
        case 64:
            return .opAssign
        case 65:
            return .opAssignAdd
        case 66:
            return .opAssignSub
        case 67:
            return .opAssignMul
        case 68:
            return .opAssignDiv
        case 69:
            return .opAssignMod
        case 70:
            return .opAssignBitAnd
        case 71:
            return .opAssignBitOr
        case 72:
            return .opAssignBitXor
        case 73:
            return .opAssignShl
        case 74:
            return .opAssignShr
        case 75:
            return .leftParen
        case 76:
            return .rightParen
        case 77:
            return .leftBracket
        case 78:
            return .rightBracket
        case 79:
            return .leftBrace
        case 80:
            return .rightBrace
        case 81:
            return .colon
        case 82:
