; 定界符。
leftParen
rightParen
leftBracket
rightBracket
leftBrace
rightBrace
colon
comma
arrow
fatArrow
dot
question
atSign
; 布局记号，由缩进栈与行尾扫描合成，跨度可为零。
newline
indent
dedent
eof

; 类别码：区间边界即类别边界，字面量 0..7、关键字 8..41、运算符 42..74、定界符 75..87、布局 88..91。
; 分支按解析期的命中频率排序，返回值仍按区间分配；顺序只影响匹配快慢，不参与语义。
kindTag|func(kind: TokenKind,) -> (I32,):
    match kind:
        case identifier:
            return 1
        case newline:
            return 88
        case colon:
            return 81
        case comma:
            return 82
        case leftParen:
            return 75
        case rightParen:
            return 76
        case eof:
            return 91
        case opAssign:
            return 64
        case arrow:
            return 83
        case dot:
            return 85
        case question:
            return 86
        case opLt:
            return 56
        case opGt:
            return 57
        case opSub:
            return 43
        case opAdd:
            return 42
        case opMul:
            return 44
        case leftBracket:
            return 77
        case rightBracket:
            return 78
        case string:
            return 4
        case integer:
            return 2
        case float:
            return 3
        case unknown:
            return 0
        case indent:
            return 89
        case dedent:
            return 90
        case opEq:
            return 52
        case opNe:
            return 53
        case opLe:
            return 54
        case opGe:
            return 55
        case opDiv:
            return 45
        case opMod:
            return 46
        case opAnd:
            return 49
        case opOr:
            return 50
        case opNot:
            return 51
        case opBitAnd:
            return 58
        case opBitOr:
            return 59
        case opBitXor:
            return 60
        case opShl:
            return 62
        case opShr:
            return 63
        case opBitNot:
            return 61
        case opInc:
            return 47
        case opDec:
            return 48
        case opAssignAdd:
            return 65
        case opAssignSub:
            return 66
        case opAssignMul:
            return 67
        case opAssignDiv:
            return 68
        case opAssignMod:
            return 69
        case opAssignBitAnd:
            return 70
        case opAssignBitOr:
            return 71
        case opAssignBitXor:
            return 72
        case opAssignShl:
            return 73
        case opAssignShr:
            return 74
        case fatArrow:
            return 84
        case atSign:
            return 87
        case leftBrace:
            return 79
        case rightBrace:
            return 80
        case trueLiteral:
            return 6
        case falseLiteral:
            return 7
        case interpolatedString:
            return 5
        case kwVar:
            return 8
        case kwLet:
            return 9
        case kwFunc:
            return 10
        case kwEnum:
            return 11
        case kwObject:
            return 12
        case kwIf:
            return 13
        case kwElif:
            return 14
        case kwElse:
            return 15
        case kwMatch:
            return 16
        case kwCase:
            return 17
        case kwWhile:
            return 18
        case kwStep:
            return 19
        case kwFor:
            return 20
        case kwIn:
            return 21
        case kwTry:
            return 22
        case kwReturn:
            return 23
        case kwBreak:
            return 24
        case kwContinue:
            return 25
        case kwSelf:
            return 26
        case kwOwn:
            return 27
        case kwDefer:
            return 28
        case kwImport:
            return 29
        case kwExport:
            return 30
        case kwNil:
            return 31
        case kwCapture:
            return 32
        case kwAwait:
            return 33
        case kwWait:
            return 34
        case kwUnsafe:
            return 35
        case kwTest:
            return 36
        case kwForeign:
            return 37
        case kwDetach:
            return 38
        case kwPass:
            return 39
        case kwUsing:
            return 40
        case kwUnroll:
            return 41
    return 0

; 类别名：诊断与测试用的可读拼写，取该类别的默认语言写法。
kindName|func(kind: TokenKind,) -> (String,):
    match kind:
        case unknown:
            return "unknown"
        case identifier:
            return "identifier"
        case integer:
            return "integer"
        case float:
            return "float"
        case string:
            return "string"
        case interpolatedString:
            return "interpolated string"
        case trueLiteral:
            return "true"
        case falseLiteral:
            return "false"
        case kwVar:
            return "var"
        case kwLet:
            return "let"
        case kwFunc:
            return "func"
        case kwEnum:
            return "enum"
        case kwObject:
            return "object"
        case kwIf:
            return "if"
        case kwElif:
            return "elif"
        case kwElse:
            return "else"
        case kwMatch:
            return "match"
        case kwCase:
            return "case"
        case kwWhile:
            return "while"
        case kwStep:
            return "step"
        case kwFor:
            return "for"
        case kwIn:
            return "in"
        case kwTry:
            return "try"
        case kwReturn:
            return "return"
        case kwBreak:
            return "break"
        case kwContinue:
            return "continue"
        case kwSelf:
            return "self"
        case kwOwn:
            return "own"
        case kwDefer:
            return "defer"
        case kwImport:
            return "import"
        case kwExport:
            return "export"
        case kwNil:
            return "nil"
        case kwCapture:
            return "capture"
        case kwAwait:
            return "await"
        case kwWait:
            return "wait"
        case kwUnsafe:
            return "unsafe"
        case kwTest:
            return "test"
        case kwForeign:
            return "foreign"
        case kwDetach:
            return "detach"
        case kwPass:
            return "pass"
        case kwUsing:
            return "using"
        case kwUnroll:
            return "unroll"
        case opAdd:
            return "+"
        case opSub:
            return "-"
        case opMul:
            return "*"
        case opDiv:
            return "/"
        case opMod:
            return "%"
        case opInc:
            return "++"
        case opDec:
            return "--"
        case opAnd:
            return "&&"
        case opOr:
            return "||"
        case opNot:
            return "!"
        case opEq:
            return "=="
        case opNe:
            return "!="
        case opLe:
            return "<="
        case opGe:
            return ">="
        case opLt:
            return "<"
        case opGt:
            return ">"
        case opBitAnd:
            return "&"
        case opBitOr:
            return "|"
        case opBitXor:
            return "^"
        case opBitNot:
            return "~"
        case opShl:
            return "<<"
        case opShr:
            return ">>"
        case opAssign:
            return "="
        case opAssignAdd:
            return "+="
        case opAssignSub:
            return "-="
        case opAssignMul:
            return "*="
        case opAssignDiv:
            return "/="
        case opAssignMod:
            return "%="
        case opAssignBitAnd:
            return "&="
        case opAssignBitOr:
            return "|="
        case opAssignBitXor:
            return "^="
        case opAssignShl:
            return "<<="
        case opAssignShr:
            return ">>="
        case leftParen:
            return "("
        case rightParen:
            return ")"
        case leftBracket:
            return "["
        case rightBracket:
            return "]"
        case leftBrace:
            return "{"
        case rightBrace:
            return "}"
        case colon:
            return ":"
        case comma:
            return ","
        case arrow:
            return "->"
        case fatArrow:
            return "=>"
        case dot:
            return "."
        case question:
            return "?"
        case atSign:
            return "@"
        case newline:
            return "newline"
        case indent:
            return "indent"
        case dedent:
            return "dedent"
        case eof:
            return "end of file"
    return "unknown"

; 类别码反查：关键字词表靠区间起点与下标合成类别，不做第二份顺序表。
kindFromTag|func(tag: I32,) -> (TokenKind,):
    match tag:
        case 0:
            return .unknown
        case 1:
            return .identifier
        case 2:
            return .integer
        case 3:
            return .float
        case 4:
            return .string
        case 5:
            return .interpolatedString
        case 6:
            return .trueLiteral
        case 7:
            return .falseLiteral
        case 8:
            return .kwVar
        case 9:
            return .kwLet
        case 10:
            return .kwFunc
        case 11:
            return .kwEnum
        case 12:
            return .kwObject
        case 13:
            return .kwIf
        case 14:
