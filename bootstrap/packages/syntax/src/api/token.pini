; 类别码：区间边界即类别边界，字面量 0..7、关键字 8..41、运算符 42..74、定界符 75..87、布局 88..91。
kindTag|func(kind: TokenKind,) -> (I32,):
    match kind:
        case 未知:
            return 0
        case 标识符:
            return 1
        case 整数:
            return 2
        case 浮点:
            return 3
        case 字符串:
            return 4
        case 插值字符串:
            return 5
        case 真:
            return 6
        case 假:
            return 7
        case 变量:
            return 8
        case 常量:
            return 9
        case 函数:
            return 10
        case 枚举:
            return 11
        case 对象:
            return 12
        case 如果:
            return 13
        case 否则如果:
            return 14
        case 否则:
            return 15
        case 匹配:
            return 16
        case 分支:
            return 17
        case 循环:
            return 18
        case 步:
            return 19
        case 遍历:
            return 20
        case 在:
            return 21
        case 尝试:
            return 22
        case 返回:
            return 23
        case 跳出:
            return 24
        case 继续:
            return 25
        case 自身:
            return 26
        case 自有:
            return 27
        case 延迟:
            return 28
        case 导入:
            return 29
        case 导出:
            return 30
        case 空:
            return 31
        case 捕获:
            return 32
        case 异步等:
            return 33
        case 等待:
            return 34
        case 不安全:
            return 35
        case 测试:
            return 36
        case 外部:
            return 37
        case 分离:
            return 38
        case 通过:
            return 39
        case 使用:
            return 40
        case 展开:
            return 41
        case 加:
            return 42
        case 减:
            return 43
        case 星号:
            return 44
        case 除:
            return 45
        case 取余:
            return 46
        case 自增:
            return 47
        case 自减:
            return 48
        case 逻辑与:
            return 49
        case 逻辑或:
            return 50
        case 逻辑非:
            return 51
        case 等于:
            return 52
        case 不等:
            return 53
        case 小于等于:
            return 54
        case 大于等于:
            return 55
        case 小于:
            return 56
        case 大于:
            return 57
        case 位与:
            return 58
        case 竖线:
            return 59
        case 位异或:
            return 60
        case 位取反:
            return 61
        case 左移:
            return 62
        case 右移:
            return 63
        case 赋值:
            return 64
        case 加赋值:
            return 65
        case 减赋值:
            return 66
        case 乘赋值:
            return 67
        case 除赋值:
            return 68
        case 取余赋值:
            return 69
        case 位与赋值:
            return 70
        case 竖线赋值:
            return 71
        case 位异或赋值:
            return 72
        case 左移赋值:
            return 73
        case 右移赋值:
            return 74
        case 左圆:
            return 75
        case 右圆:
            return 76
        case 左方:
            return 77
        case 右方:
            return 78
        case 左花:
            return 79
        case 右花:
            return 80
        case 冒号:
            return 81
        case 逗号:
            return 82
        case 箭头:
            return 83
        case 双箭头:
            return 84
        case 点:
            return 85
        case 问号:
            return 86
        case 艾特:
            return 87
        case 换行:
            return 88
        case 缩进:
            return 89
        case 反缩进:
            return 90
        case 结束:
            return 91
    return 0

; 类别名：用于诊断消息与测试断言，与枚举名同字。
kindName|func(kind: TokenKind,) -> (String,):
    match kind:
        case 未知:
            return "未知"
        case 标识符:
            return "标识符"
        case 整数:
            return "整数"
