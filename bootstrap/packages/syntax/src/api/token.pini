; 同一类别判定：只比构造点算好的类别码，省掉每处重算。
isKind|func(token: Token, kind: TokenKind,) -> (Bool,):
    return token.tag == kindTag(kind)

; 字面量区间不含 `unknown`：未识别字节不算字面量。
isLiteralKind|func(kind: TokenKind,) -> (Bool,):
    let tag = kindTag(kind)
    return tag >= 1 && tag <= 7

isKeywordKind|func(kind: TokenKind,) -> (Bool,):
    let tag = kindTag(kind)
    return tag >= 8 && tag <= 41

isOperatorKind|func(kind: TokenKind,) -> (Bool,):
    let tag = kindTag(kind)
    return tag >= 42 && tag <= 74

isDelimiterKind|func(kind: TokenKind,) -> (Bool,):
    let tag = kindTag(kind)
    return tag >= 75 && tag <= 87

; 布局记号：解析器靠它切分块边界，普通表达式扫描里一律跳过。
isLayoutKind|func(kind: TokenKind,) -> (Bool,):
    return kindTag(kind) >= 88

((Token))
; 扫描消费的字节数：区间长度，布局记号可为零。
consumed|self() -> (I32,):
    return self.end - self.start
; 名字跨度是否非空：反引号名去掉引号后才是名字。
hasName|self() -> (Bool,):
    return self.nameEnd > self.nameStart
segmentCount|self() -> (I32,):
    return len(self.segments)
segmentAt|self(index: I32,) -> (Segment,):
    return self.segments[index]

; 运算符拼写：按类别码回符号本身，非运算符答空串；诊断与语义判定共用这一条。
opSymbol|func(tag: I32,) -> (String,):
    if tag == kindTag(opAdd):
        return "+"
    if tag == kindTag(opSub):
        return "-"
    if tag == kindTag(opMul):
        return "*"
    if tag == kindTag(opDiv):
        return "/"
    if tag == kindTag(opMod):
        return "%"
    if tag == kindTag(opInc):
        return "++"
    if tag == kindTag(opDec):
        return "--"
    if tag == kindTag(opAnd):
        return "&&"
    if tag == kindTag(opOr):
        return "||"
    if tag == kindTag(opNot):
        return "!"
    if tag == kindTag(opEq):
        return "=="
    if tag == kindTag(opNe):
        return "!="
    if tag == kindTag(opLe):
        return "<="
    if tag == kindTag(opGe):
        return ">="
    if tag == kindTag(opLt):
        return "<"
    if tag == kindTag(opGt):
        return ">"
    if tag == kindTag(opBitAnd):
        return "&"
    if tag == kindTag(opBitOr):
        return "|"
    if tag == kindTag(opBitXor):
        return "^"
    if tag == kindTag(opBitNot):
        return "~"
    if tag == kindTag(opShl):
        return "<<"
    if tag == kindTag(opShr):
        return ">>"
    if tag == kindTag(opAssign):
        return "="
    if tag == kindTag(opAssignAdd):
        return "+="
    if tag == kindTag(opAssignSub):
        return "-="
    if tag == kindTag(opAssignMul):
        return "*="
    if tag == kindTag(opAssignDiv):
        return "/="
    if tag == kindTag(opAssignMod):
        return "%="
    if tag == kindTag(opAssignBitAnd):
        return "&="
    if tag == kindTag(opAssignBitOr):
        return "|="
    if tag == kindTag(opAssignBitXor):
        return "^="
    if tag == kindTag(opAssignShl):
        return "<<="
    if tag == kindTag(opAssignShr):
        return ">>="
    return ""
