; 记号：类别、类别码、源内字节区间与名字区间；码在构造点算好，判定不再重算。
(Token)
kind: TokenKind = .unknown
tag: I32 = 0
start: I32 = 0
end: I32 = 0
nameStart: I32 = 0
nameEnd: I32 = 0
segments: Array<Segment> = []

; 字符串段：字面段的范围含转义原文，插值段的范围是括号内的表达式，都不含两侧定界。
(Segment)
kind: SegmentKind = .segmentLiteral
start: I32 = 0
end: I32 = 0

[SegmentKind]
segmentLiteral
segmentInterpolation

; 记号类别：字面量、关键字、运算符、定界符、布局五段，码按此顺序分配。
[TokenKind]
unknown
identifier
integer
float
string
interpolatedString
trueLiteral
falseLiteral
; 关键字，识别时按长度分流再逐字节比对。
kwVar
kwLet
kwFunc
kwEnum
