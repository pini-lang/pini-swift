; 同一类别判定：两通道都不支持枚举相等比较，因此一律比类别码。
isKind|func(token: Token, kind: TokenKind,) -> (Bool,):
    return kindTag(token.kind) == kindTag(kind)

; 字面量区间不含 `未知`：未识别字节不算字面量。
isLiteralKind|func(kind: TokenKind,) -> (Bool,):
    let tag = kindTag(kind)
    return tag >= 1 && tag <= 7

isKeywordKind|func(kind: TokenKind,) -> (Bool,):
    let tag = kindTag(kind)
    return tag >= 8 && tag <= 41

isOperatorKind|func(kind: TokenKind,) -> (Bool,):
    let tag = kindTag(kind)
    return tag >= 42 && tag <= 74

isDelimiterKind|func(kind: TokenKind,) -> (Bool,):
    let tag = kindTag(kind)
    return tag >= 75 && tag <= 87

; 布局记号：解析器靠它切分块边界，普通表达式扫描里一律跳过。
isLayoutKind|func(kind: TokenKind,) -> (Bool,):
    return kindTag(kind) >= 88

; 关键字词表：按词长分流再逐字节比对，非关键字答 `.标识符`。
keywordKind|func(bytes: Array<U8>, start: I32, end: I32,) -> (TokenKind,):
    let n = end - start
    if n == 2:
        if matchesAscii(bytes, start, "if"):
            return .如果
        if matchesAscii(bytes, start, "in"):
            return .在
    if n == 3:
        if matchesAscii(bytes, start, "var"):
            return .变量
        if matchesAscii(bytes, start, "let"):
            return .常量
        if matchesAscii(bytes, start, "for"):
            return .遍历
        if matchesAscii(bytes, start, "try"):
            return .尝试
        if matchesAscii(bytes, start, "nil"):
            return .空
        if matchesAscii(bytes, start, "own"):
            return .自有
    if n == 4:
        if matchesAscii(bytes, start, "func"):
            return .函数
        if matchesAscii(bytes, start, "enum"):
            return .枚举
        if matchesAscii(bytes, start, "case"):
            return .分支
        if matchesAscii(bytes, start, "else"):
            return .否则
        if matchesAscii(bytes, start, "step"):
            return .步
        if matchesAscii(bytes, start, "wait"):
            return .等待
        if matchesAscii(bytes, start, "test"):
            return .测试
        if matchesAscii(bytes, start, "self"):
            return .自身
        if matchesAscii(bytes, start, "pass"):
            return .通过
        if matchesAscii(bytes, start, "elif"):
            return .否则如果
    if n == 5:
        if matchesAscii(bytes, start, "match"):
            return .匹配
        if matchesAscii(bytes, start, "while"):
            return .循环
        if matchesAscii(bytes, start, "break"):
            return .跳出
        if matchesAscii(bytes, start, "await"):
            return .异步等
        if matchesAscii(bytes, start, "using"):
            return .使用
        if matchesAscii(bytes, start, "defer"):
            return .延迟
    if n == 6:
        if matchesAscii(bytes, start, "object"):
            return .对象
        if matchesAscii(bytes, start, "return"):
            return .返回
        if matchesAscii(bytes, start, "import"):
            return .导入
        if matchesAscii(bytes, start, "export"):
            return .导出
        if matchesAscii(bytes, start, "unsafe"):
            return .不安全
        if matchesAscii(bytes, start, "detach"):
            return .分离
        if matchesAscii(bytes, start, "unroll"):
            return .展开
    if n == 7:
        if matchesAscii(bytes, start, "capture"):
            return .捕获
        if matchesAscii(bytes, start, "foreign"):
            return .外部
    if n == 8:
        if matchesAscii(bytes, start, "continue"):
            return .继续
    return .标识符

matchesAscii|func(bytes: Array<U8>, start: I32, word: String,) -> (Bool,):
    let want = tempUtf8Bytes(word)
    if start + len(want) > len(bytes):
        return false
    var i = 0
    while i < len(want):
        if bytes[start + i] != want[i]:
            return false
        i = i + 1
    return true

((Token))
; 扫描消费的字节数：区间长度，布局记号可为零。
consumed|self() -> (I32,):
    return self.end - self.start
; 名字跨度是否非空：反引号名去掉引号后才是名字。
hasName|self() -> (Bool,):
    return self.nameEnd > self.nameStart
segmentCount|self() -> (I32,):
    return len(self.segments)
segmentAt|self(index: I32,) -> (Segment,):
    return self.segments[index]
