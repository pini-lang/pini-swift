        self.advance()
    if self.at(.opLt):
        ; 限定泛型头不收：诊断照记，实参照吃，节点照建——解析器必须前进到右括号。
        if qualified:
            self.report(code = "E2-008", message = "限定类型名后不接泛型实参")
        self.advance()
        var args: Array<I32> = []
        self.skipNewlines()
        while !self.at(.opGt) && !self.atEnd():
            let arg: I32 = self.parseType()
            if arg >= 0:
                args = args.append(arg)
            if self.at(.comma):
                self.advance()
            self.skipNewlines()
        self.expect(kind = .opGt, what = "`>`")
        let id: I32 = self.newType(kind = .typeGeneric, start = start, end = self.previousEnd())
        self.setTypeName(id = id, start = nameStart, end = nameEnd)
        self.setTypeKids(id = id, kids = args)
        return self.maybeOptional(id)
    let id: I32 = self.newType(kind = .typeNamed, start = start, end = self.previousEnd())
    self.setTypeName(id = id, start = nameStart, end = nameEnd)
    return self.maybeOptional(id)
; 结果类型糖：`^T` 即 `Result<T, Error>`，错误实参由类型面补。
parseResultType|self() -> (I32,):
    let start: I32 = self.current().start
    self.advance()
    let inner: I32 = self.parseType()
    var args: Array<I32> = []
    args = args.append(inner)
    let id: I32 = self.newType(kind = .typeResult, start = start, end = self.previousEnd())
    self.setTypeKids(id = id, kids = args)
    return self.maybeOptional(id)
; 数组类型：`[T,]` 与 `[T]` 同义，元素类型只写一个。
parseArrayType|self() -> (I32,):
    let start: I32 = self.current().start
    self.advance()
    let inner: I32 = self.parseType()
    if self.at(.comma):
        self.advance()
    self.expect(kind = .rightBracket, what = "`]`")
    var args: Array<I32> = []
    args = args.append(inner)
    let id: I32 = self.newType(kind = .typeArray, start = start, end = self.previousEnd())
    self.setTypeKids(id = id, kids = args)
    return self.maybeOptional(id)
; 集合与字典类型：首项后见冒号是字典 `{K: V,}`，否则是集合 `{T,}`；空类型位无组件类型。
parseBraceType|self() -> (I32,):
    let start: I32 = self.current().start
    self.advance()
    if self.at(.rightBrace):
        self.report(code = "E2-008", message = "空类型位 `{}` 无组件类型")
        self.advance()
        return -1
    let first: I32 = self.parseType()
    var kind = .typeSet
    var args: Array<I32> = []
    args = args.append(first)
    if self.at(.colon):
        kind = .typeDictionary
        self.advance()
        args = args.append(self.parseType())
    if self.at(.comma):
        self.advance()
    self.expect(kind = .rightBrace, what = "`}`")
    let id: I32 = self.newType(kind = kind, start = start, end = self.previousEnd())
    self.setTypeKids(id = id, kids = args)
    return self.maybeOptional(id)
; 返回列表：括号内单元素且无标签即该元素本身，空表、多元素与带标签保持元组形状。
; 折叠后仍是元组，说明源里多包了一层：`((T,),)` 折成 `(T,)` 后仍是元组。
hasExtraParens|self(raw: I32, collapsed: I32,) -> (Bool,):
    if raw == collapsed || collapsed < 0:
        return false
    return isTupleTypeCode(self.ast.typeAt(collapsed).kind)
collapseReturn|self(_id: I32,) -> (I32,):
    if _id < 0:
        return _id
    let node = self.ast.typeAt(_id)
    if !isTupleTypeCode(node.kind):
        return _id
    if len(node.kids) != 1 || len(node.labels) > 0:
        return _id
    return node.kids[0]
; 后缀问号：包成可选类型；`T??` 逐层包裹。
maybeOptional|self(_id: I32,) -> (I32,):
    var out = _id
    while self.at(.question):
        self.advance()
        let wrapped: I32 = self.newType(kind = .typeOptional, start = self.ast.typeAt(out).start, end = self.previousEnd())
        self.pushTypeKid(id = wrapped, kid = out)
        out = wrapped
    return out
; 圆括号类型：元素可带 `标签:` 前缀；见到箭头即整体成为函数类型的形参部分。
parseParenType|self() -> (I32,):
    let start: I32 = self.current().start
    self.advance()
    var items: Array<I32> = []
    var labels = ""
    var labeled = false
    self.skipNewlines()
    while !self.at(.rightParen) && !self.atEnd():
        let label: String = self.parseTypeLabel()
        let item: I32 = self.parseType()
        if item >= 0:
            if len(items) > 0:
                labels = labels + ","
            labels = labels + label
            if len(label) > 0:
                labeled = true
            items = items.append(item)
        if self.at(.comma):
            self.advance()
        self.skipNewlines()
    self.expect(kind = .rightParen, what = "`)`")
    if self.at(.arrow):
        self.advance()
        let ret: I32 = self.collapseReturn(self.parseType())
        let id: I32 = self.newType(kind = .typeFunction, start = start, end = self.previousEnd())
        self.setTypeKids(id = id, kids = items)
        self.setTypeRet(id = id, ret = ret)
        return id
    let id: I32 = self.newType(kind = .typeTuple, start = start, end = self.previousEnd())
    self.setTypeKids(id = id, kids = items)
    if labeled:
        self.setTypeLabels(id = id, labels = labels)
    return id
; 类型元素标签：`标识符:` 前缀；不是标签就原样返回空串，游标不动。
parseTypeLabel|self() -> (String,):
    if !self.at(.identifier) || !self.isKindAt(offset = 1, kind = .colon):
        return ""
    let nameStart: I32 = self.current().nameStart
    let nameEnd: I32 = self.current().nameEnd
    let text: String = spellOf(bytes = self.bytes, start = nameStart, end = nameEnd)
    self.advance()
    self.advance()
    return text
; 表达式：按二元优先级爬升，一元与后缀在更低层解析。
parseExpression|self(_minPrecedence: I32,) -> (I32,):
    var left: I32 = self.parseCast()
    var climbing = true
    while climbing && left >= 0:
        let precedence: I32 = binaryPrecedence(self.current().kind)
        if precedence < _minPrecedence || precedence == 0:
            climbing = false
        else:
            let op: TokenKind = self.current().kind
            self.advance()
            let right: I32 = self.parseExpression(precedence + 1)
            let id: I32 = self.newExpr(kind = .exprBinary, start = self.ast.exprAt(left).start, end = self.ast.exprAt(left).end)
            self.setExprOp(id = id, op = op)
            self.pushExprKid(id = id, kid = left)
            self.pushExprKid(id = id, kid = right)
            left = id
    return left
; 转换：`操作数 as 目标类型`，比二元紧、比前缀一元松，可连写左结合。
; `as` 是上下文关键字：只在操作数已完整的位置按转换解释，其余位置是普通标识符。
parseCast|self() -> (I32,):
    var left: I32 = self.parseUnary()
    while left >= 0 && self.isIdentifierWord("as"):
        self.advance()
        let target: I32 = self.parseType()
        let id: I32 = self.newExpr(kind = .exprCast, start = self.ast.exprAt(left).start, end = self.previousEnd())
        self.setExprType(id = id, typeId = target)
        self.pushExprKid(id = id, kid = left)
        left = id
    return left
parseUnary|self() -> (I32,):
    if self.at(.kwTry):
        return self.parseTryExpr()
    if self.at(.opBitXor):
        return self.parseUnwrapExpr()
    if self.at(.kwAwait) || self.at(.kwWait):
        let start: I32 = self.current().start
        let op: TokenKind = self.current().kind
        self.advance()
        let operand: I32 = self.parseUnary()
        let id: I32 = self.newExpr(kind = .exprJoin, start = start, end = self.previousEnd())
        self.setExprOp(id = id, op = op)
        self.pushExprKid(id = id, kid = operand)
        return id
    if self.at(.kwUnsafe):
        let start: I32 = self.current().start
        self.advance()
        let operand: I32 = self.parseUnary()
        let id: I32 = self.newExpr(kind = .exprUnsafe, start = start, end = self.previousEnd())
        self.pushExprKid(id = id, kid = operand)
        return id
    if self.at(.kwWeak):
        let start: I32 = self.current().start
        self.advance()
        let operand: I32 = self.parseUnary()
        let id: I32 = self.newExpr(kind = .exprWeakRef, start = start, end = self.previousEnd())
        self.pushExprKid(id = id, kid = operand)
        return id
    let kind: TokenKind = self.current().kind
    if isUnaryKind(kind):
        let start: I32 = self.current().start
        self.advance()
        let operand: I32 = self.parseUnary()
        let id: I32 = self.newExpr(kind = .exprUnary, start = start, end = self.previousEnd())
        self.setExprOp(id = id, op = kind)
        self.pushExprKid(id = id, kid = operand)
        return id
    return self.parsePostfix()
; try 表达式：`try 操作数 else 错误名: 处理器`，语句位与表达式位同形；
; 处理器是块，单行形态只收 return / break / continue / pass。
parseTryExpr|self() -> (I32,):
    let start: I32 = self.current().start
    self.advance()
    let operand: I32 = self.parseExpression(1)
    if !self.expect(kind = .kwElse, what = "`else`"):
        self.recover()
        return operand
    var nameStart = -1
    var nameEnd = -1
    if self.at(.identifier):
        nameStart = self.current().nameStart
        nameEnd = self.current().nameEnd
        self.advance()
    else:
        self.report(code = "E2-001", message = "期望错误名")
    let handler: I32 = self.parseTryHandler()
    let id: I32 = self.newExpr(kind = .exprTry, start = start, end = self.previousEnd())
    self.setExprName(id = id, start = nameStart, end = nameEnd)
    self.pushExprKid(id = id, kid = operand)
    var node = self.ast.exprs[id]
    node.body = handler
    self.ast.exprs[id] = node
    return id
; `^` 解包糖：`^右值` 等价 `try 右值 else err: return err`，`body` 留空表示处理器是合成的。
parseUnwrapExpr|self() -> (I32,):
    let start: I32 = self.current().start
    self.advance()
    let operand: I32 = self.parseUnary()
    let id: I32 = self.newExpr(kind = .exprTry, start = start, end = self.previousEnd())
    self.pushExprKid(id = id, kid = operand)
    return id
; try 处理器：冒号后换行是块，同行是单条控制流语句；其余语句按非法处理器报错。
parseTryHandler|self() -> (I32,):
    if !self.expect(kind = .colon, what = "`:`"):
        self.recover()
        return -1
    if self.at(.newline):
        return self.parseIndentedBlock()
    let start: I32 = self.current().start
    var id = -1
    if self.at(.kwReturn):
        id = self.parseReturn()
    elif self.at(.kwBreak):
        id = self.parseBreak()
    elif self.at(.kwContinue):
        id = self.parseContinue()
    elif self.at(.kwPass):
        id = self.parsePass()
    else:
        self.report(code = "E2-001", message = "try 的处理器只能是 return、break、continue 或 pass")
        self.recover()
    let block: I32 = self.newStmt(kind = .stmtBlock, start = start, end = self.previousEnd())
    if id >= 0:
        self.pushStmtKid(id = block, kid = id)
    return block
; 后缀链：调用、下标、切片与成员访问按出现顺序叠加。
parsePostfix|self() -> (I32,):
    var expr: I32 = self.parsePrimary()
    var chaining = true
    while chaining && expr >= 0:
        if self.at(.leftParen):
            expr = self.finishCall(expr)
        elif self.at(.leftBracket):
            expr = self.finishIndex(expr)
        elif self.at(.dot):
            expr = self.finishMember(expr)
        elif self.at(.opNot):
            expr = self.finishUnwrap(expr)
        else:
            chaining = false
    return expr
; 后缀解包：`值!` 与调用、下标同级，结合最紧；节点仍是带运算符的一元。
finishUnwrap|self(_expr: I32,) -> (I32,):
    let start = self.ast.exprAt(_expr).start
    let op: TokenKind = self.current().kind
    self.advance()
    let id: I32 = self.newExpr(kind = .exprUnary, start = start, end = self.previousEnd())
    self.setExprOp(id = id, op = op)
    self.pushExprKid(id = id, kid = _expr)
    return id
; 成员访问：点后接名字或元组序号；序号取整数记号的名字区间，与名字共用成员节点。
finishMember|self(_expr: I32,) -> (I32,):
    let start = self.ast.exprAt(_expr).start
    self.advance()
    var nameStart = -1
    var nameEnd = -1
    if self.at(.identifier) || self.at(.integer):
        nameStart = self.current().nameStart
        nameEnd = self.current().nameEnd
        self.advance()
    else:
        self.report(code = "E2-001", message = "期望成员名或元组序号")
        return _expr
    let id: I32 = self.newExpr(kind = .exprMember, start = start, end = self.previousEnd())
    self.setExprName(id = id, start = nameStart, end = nameEnd)
    self.pushExprKid(id = id, kid = _expr)
    return id
; 调用：实参可带 `名字 = 值` 标签，尾随逗号合法。
finishCall|self(_callee: I32,) -> (I32,):
    let start = self.ast.exprAt(_callee).start
    self.advance()
    let id: I32 = self.newExpr(kind = .exprCall, start = start, end = self.previousEnd())
    self.pushExprKid(id = id, kid = _callee)
    self.parseCallArguments(id = id)
    self.expect(kind = .rightParen, what = "`)`")
    self.setExprEnd(id = id, end = self.previousEnd())
    return id
; 实参表：游标在 `(` 之后，逐条收位置实参与 `名字 = 值` 标签实参，尾随逗号合法。
; 调用、泛型构造与元组共用同一份条目排布。
parseCallArguments|self(id: I32,) -> ():
    self.skipNewlines()
    while !self.at(.rightParen) && !self.atEnd():
        let before = self.pos
        let arg: I32 = self.parseArgumentItem()
        if arg >= 0:
            self.pushExprKid(id = id, kid = arg)
        if self.at(.comma):
            self.advance()
        if self.pos == before:
            self.advance()
        self.skipNewlines()
    return
; 实参或元组元素：`名字 = 值` 成二元节点，标签进名字区间；无标签时就是那条表达式。
; 标签的节点形状只有这一处定义，调用面与元组面因此同形。
parseArgumentItem|self() -> (I32,):
    if self.at(.identifier) && self.isKindAt(offset = 1, kind = .opAssign):
        let labelStart: I32 = self.current().nameStart
        let labelEnd: I32 = self.current().nameEnd
        self.advance()
        self.advance()
        let value: I32 = self.parseExpression(1)
        if value < 0:
            return value
        let arg: I32 = self.newExpr(kind = .exprBinary, start = labelStart, end = self.ast.exprAt(value).end)
        self.setExprName(id = arg, start = labelStart, end = labelEnd)
        self.setExprOp(id = arg, op = .opAssign)
        self.pushExprKid(id = arg, kid = value)
        return arg
    return self.parseExpression(1)
; 泛型应用前瞻：`名<类型实参>(...)`，函数调用与类型构造共用同一形状。
; 只扫记号形状不建节点，判定失手仍按标识符解析，`a < b` 比较不受影响。
looksLikeGenericConstruct|self() -> (Bool,):
    var i: I32 = self.pos + 1
    if i >= self.total || !isKind(token = self.tokens[i], kind = .opLt):
        return false
    i = i + 1
    var depth: I32 = 1
    while i < self.total && depth > 0:
        if isKind(token = self.tokens[i], kind = .opLt):
            depth = depth + 1
        elif isKind(token = self.tokens[i], kind = .opGt):
            depth = depth - 1
        elif isKind(token = self.tokens[i], kind = .newline):
            return false
        i = i + 1
    if depth != 0:
        return false
    return i < self.total && isKind(token = self.tokens[i], kind = .leftParen)
; 泛型应用：类型位收被调名与类型实参，实参按调用表排布；
; 是函数调用还是类型构造由语义面按符号判。
parseGenericConstruct|self() -> (I32,):
    let start: I32 = self.current().start
    let typeId: I32 = self.parseType()
    let id: I32 = self.newExpr(kind = .exprGeneric, start = start, end = self.previousEnd())
    self.setExprType(id = id, typeId = typeId)
    if self.at(.leftParen):
        self.advance()
        self.parseCallArguments(id = id)
        self.expect(kind = .rightParen, what = "`)`")
    self.setExprEnd(id = id, end = self.previousEnd())
    return id
; 下标或切片：`a[i]` 与 `a[i:j]`，两端都可省略。
finishIndex|self(_target: I32,) -> (I32,):
    let start = self.ast.exprAt(_target).start
    self.advance()
    self.skipNewlines()
    var lower = -1
    if !self.at(.colon) && !self.at(.rightBracket):
        lower = self.parseExpression(1)
    if self.at(.colon):
        self.advance()
        var upper = -1
        if !self.at(.rightBracket):
            upper = self.parseExpression(1)
        self.expect(kind = .rightBracket, what = "`]`")
        let id: I32 = self.newExpr(kind = .exprSlice, start = start, end = self.previousEnd())
        self.pushExprKid(id = id, kid = _target)
        self.pushExprKid(id = id, kid = lower)
        self.pushExprKid(id = id, kid = upper)
        return id
    self.expect(kind = .rightBracket, what = "`]`")
    let id: I32 = self.newExpr(kind = .exprSubscript, start = start, end = self.previousEnd())
    self.pushExprKid(id = id, kid = _target)
    self.pushExprKid(id = id, kid = lower)
    return id
; 基本表达式：字面量、名字、枚举项、括号组、容器字面量与函数字面量。
parsePrimary|self() -> (I32,):
    let token: Token = self.current()
    let start = token.start
    if isKind(token = token, kind = .integer):
        self.advance()
        return self.newExpr(kind = .exprInteger, start = start, end = token.end)
    if isKind(token = token, kind = .float):
        self.advance()
        return self.newExpr(kind = .exprFloat, start = start, end = token.end)
    if isKind(token = token, kind = .string):
        self.advance()
        return self.newExpr(kind = .exprString, start = start, end = token.end)
    if isKind(token = token, kind = .interpolatedString):
        return self.parseInterpolated(token = token)
    if isKind(token = token, kind = .trueLiteral):
        self.advance()
        return self.newExpr(kind = .exprTrue, start = start, end = token.end)
    if isKind(token = token, kind = .falseLiteral):
        self.advance()
        return self.newExpr(kind = .exprFalse, start = start, end = token.end)
    if isKind(token = token, kind = .kwNil):
        self.advance()
        return self.newExpr(kind = .exprNil, start = start, end = token.end)
    if isKind(token = token, kind = .dot):
        self.advance()
        let nameStart: I32 = self.current().nameStart
        let nameEnd: I32 = self.current().nameEnd
        if !self.expect(kind = .identifier, what = "枚举项名"):
            return -1
        let id: I32 = self.newExpr(kind = .exprCase, start = start, end = self.previousEnd())
        self.setExprName(id = id, start = nameStart, end = nameEnd)
        return id
    if isKind(token = token, kind = .identifier) && self.looksLikeGenericConstruct():
        return self.parseGenericConstruct()
    if isKind(token = token, kind = .identifier) || isKind(token = token, kind = .kwSelf):
        self.advance()
        let id: I32 = self.newExpr(kind = .exprIdentifier, start = start, end = token.end)
        self.setExprName(id = id, start = token.nameStart, end = token.nameEnd)
        return id
    if isKind(token = token, kind = .leftParen):
        return self.parseParenExpr()
    if isKind(token = token, kind = .leftBracket):
        return self.parseArrayLiteral()
    if isKind(token = token, kind = .leftBrace):
        return self.parseBraceLiteral()
    if isKind(token = token, kind = .kwFunc):
        return self.parseLambda()
    self.report(code = "E2-006", message = "无效的表达式，实际得到" + kindName(token.kind))
    return -1
; 插值串：整条串一个节点，`kids` 按段序只收插值段的子表达式，字面段不落节点。
parseInterpolated|self(token: Token,) -> (I32,):
    self.advance()
    let id: I32 = self.newExpr(kind = .exprInterpolated, start = token.start, end = token.end)
    var kids: Array<I32> = []
    var i = 0
    while i < token.segmentCount():
        let segment: Segment = self.segments[token.segmentBase + i]
        if segment.code == 1:
            let inner: I32 = self.parseFragment(start = segment.start, end = segment.end)
            if inner >= 0:
                kids = kids.append(inner)
        i = i + 1
    self.setExprKids(id = id, kids = kids)
    var node = self.ast.exprs[id]
    node.op = token.segmentBase
    node.body = token.segmentCount()
    self.ast.exprs[id] = node
    return id
; 片段解析：只把游标临时换到段内记号上，节点池与诊断共用；
; 段内记号本就用源内绝对偏移，故子节点跨度无需平移。
parseFragment|self(start: I32, end: I32,) -> (I32,):
    let fragment: LexResult = scanFragment(language = self.language, bytes = self.bytes, start = start, end = end)
    let savedTokens = self.tokens
    let savedTotal = self.total
    let savedPos = self.pos
    self.tokens = fragment.tokens
    self.total = len(fragment.tokens)
    self.pos = 0
    let expr: I32 = self.parseExpression(1)
    if !self.atEnd():
        self.report(code = "E2-001", message = "插值段只收一条表达式")
    self.tokens = savedTokens
    self.total = savedTotal
    self.pos = savedPos
    return expr
; 括号表达式：单元素无标签是分组，多元素或带标签的单元素构成元组；尾随逗号是元组标记。
parseParenExpr|self() -> (I32,):
    let start: I32 = self.current().start
    self.advance()
    self.skipNewlines()
    if self.at(.rightParen):
        self.advance()
        return self.newExpr(kind = .exprTuple, start = start, end = self.previousEnd())
    let first: I32 = self.parseArgumentItem()
    if !self.at(.comma):
        self.expect(kind = .rightParen, what = "`)`")
        ; 单元素带标签仍是元组：标签是读法，不能被分组解包吃掉。
        if first >= 0 && self.ast.isLabeledArgument(first):
            var one: Array<I32> = []
            one = one.append(first)
            let id: I32 = self.newExpr(kind = .exprTuple, start = start, end = self.previousEnd())
            self.setExprKids(id = id, kids = one)
            return id
        return first
    var items: Array<I32> = []
    if first >= 0:
        items = items.append(first)
    while self.at(.comma):
        self.advance()
        self.skipNewlines()
        if !self.at(.rightParen):
            let item: I32 = self.parseArgumentItem()
            if item >= 0:
                items = items.append(item)
        self.skipNewlines()
    self.expect(kind = .rightParen, what = "`)`")
    let id: I32 = self.newExpr(kind = .exprTuple, start = start, end = self.previousEnd())
    self.setExprKids(id = id, kids = items)
    return id
; 数组字面量：`[a, b]`；元素之间允许跨行。
parseArrayLiteral|self() -> (I32,):
    let start: I32 = self.current().start
    self.advance()
    var items: Array<I32> = []
    self.skipNewlines()
    while !self.at(.rightBracket) && !self.atEnd():
        let before = self.pos
        let item: I32 = self.parseExpression(1)
        if item >= 0:
            items = items.append(item)
        if self.at(.comma):
            self.advance()
        if self.pos == before:
            self.advance()
        self.skipNewlines()
    self.expect(kind = .rightBracket, what = "`]`")
    let id: I32 = self.newExpr(kind = .exprArray, start = start, end = self.previousEnd())
    self.setExprKids(id = id, kids = items)
    return id
; 花括号字面量：首项后跟 `=` 或 `:` 即字典，否则是集合；空括号恒为空集合，字典没有空字面量形态。
parseBraceLiteral|self() -> (I32,):
    let start: I32 = self.current().start
    self.advance()
    self.skipNewlines()
    if self.at(.rightBrace):
        self.advance()
        return self.newExpr(kind = .exprSet, start = start, end = self.previousEnd())
    let first: I32 = self.parseExpression(1)
    if self.at(.opAssign) || self.at(.colon):
        return self.parseDictionaryBody(start = start, first = first)
    var items: Array<I32> = []
    items = items.append(first)
    while self.at(.comma):
        self.advance()
        self.skipNewlines()
        if !self.at(.rightBrace):
            let item: I32 = self.parseExpression(1)
            if item >= 0:
                items = items.append(item)
    self.expect(kind = .rightBrace, what = "`}`")
    let id: I32 = self.newExpr(kind = .exprSet, start = start, end = self.previousEnd())
    self.setExprKids(id = id, kids = items)
    return id
; 字典条目串：首键已读，逐条收 `键 = 值` 或 `键: 类型 = 值`，尾逗号可省；
; 条目成 `exprDictEntry`，`kids` 是键与值，类型标注落在条目的 `typeId`。
parseDictionaryBody|self(start: I32, first: I32,) -> (I32,):
    var entries: Array<I32> = []
    var key = first
    var reading = true
    while reading:
        if key < 0:
            self.recover()
            reading = false
        else:
            var annotation = -1
            if self.at(.colon):
                self.advance()
                annotation = self.parseType()
            if !self.at(.opAssign):
                self.report(code = "E2-001", message = "字典条目缺少 `=`")
                self.recover()
                reading = false
            else:
                self.advance()
                let value: I32 = self.parseExpression(1)
                let entry: I32 = self.newExpr(kind = .exprDictEntry, start = self.ast.exprAt(key).start, end = self.previousEnd())
                self.setExprType(id = entry, typeId = annotation)
                self.pushExprKid(id = entry, kid = key)
                self.pushExprKid(id = entry, kid = value)
                entries = entries.append(entry)
                if self.at(.comma):
                    self.advance()
                    self.skipNewlines()
                    if self.at(.rightBrace):
                        reading = false
                    else:
                        key = self.parseExpression(1)
                else:
                    reading = false
    self.expect(kind = .rightBrace, what = "`}`")
    let id: I32 = self.newExpr(kind = .exprDictionary, start = start, end = self.previousEnd())
    self.setExprKids(id = id, kids = entries)
    return id
; 函数字面量：`func (参数,) -> (返回,):` 后接缩进块或同行语句；返回箭头写 `=>` 即异步。
parseLambda|self() -> (I32,):
    let start: I32 = self.current().start
    self.advance()
    if !self.at(.leftParen):
        self.report(code = "E2-001", message = "期望参数表 `(`")
        return -1
    let params = self.parseParams()
    var returnType = -1
    var isAsync = false
    if self.at(.fatArrow):
        isAsync = true
        self.advance()
        returnType = self.collapseReturn(self.parseType())
    elif self.at(.arrow):
        self.advance()
        returnType = self.collapseReturn(self.parseType())
    if !self.expect(kind = .colon, what = "`:`"):
        return -1
    var body = -1
    if self.at(.newline):
        body = self.parseIndentedBlock()
    else:
        body = self.parseInlineBlock()
    let id: I32 = self.newExpr(kind = .exprFunction, start = start, end = self.previousEnd())
    var kids: Array<I32> = []
    var i = 0
    while i < len(params):
        kids = kids.append(params[i])
        i = i + 1
    if body >= 0:
        kids = kids.append(body)
    self.setExprKids(id = id, kids = kids)
    var node = self.ast.exprs[id]
    node.op = returnType
    node.isAsync = isAsync
    self.ast.exprs[id] = node
    return id
; 缩进块：换行 + 缩进开启，逐条语句读到反缩进；空块报缺少块体。
parseIndentedBlock|self() -> (I32,):
    let start: I32 = self.current().start
    if !self.at(.newline):
        self.report(code = "E2-009", message = "缺少块体")
        return -1
    self.advance()
    if !self.at(.indent):
        self.report(code = "E2-003", message = "缺少缩进")
        return -1
    self.advance()
    var ids: Array<I32> = []
    self.skipNewlines()
    while !self.atEnd() && !self.at(.dedent):
        let before = self.pos
        let id: I32 = self.parseStatement()
        if id >= 0:
            ids = ids.append(id)
        if self.pos == before:
            self.advance()
        self.skipNewlines()
    if self.at(.dedent):
        self.advance()
    let id: I32 = self.newStmt(kind = .stmtBlock, start = start, end = self.previousEnd())
    self.setStmtKids(id = id, kids = ids)
    return id
; 同行块体：`:` 之后直接一条语句，用于单行函数字面量与单行函数体。
parseInlineBlock|self() -> (I32,):
    let start: I32 = self.current().start
    let id: I32 = self.parseStatement()
    let block: I32 = self.newStmt(kind = .stmtBlock, start = start, end = self.previousEnd())
    if id >= 0:
        self.pushStmtKid(id = block, kid = id)
    return block
; 语句分派：关键字开头各有专用形状，其余按表达式或赋值处理。
; `名|if` / `名|while` / `名|for` 是带标签控制流，标签只在控制流关键字前成立。
parseStatement|self() -> (I32,):
    if self.at(.kwCapture):
        return self.parseCapture()
    if self.at(.identifier) && self.isKindAt(offset = 1, kind = .opBitOr) && self.isKindAt(offset = 2, kind = .kwIf):
        return self.parseLabelled(what = .kwIf)
    if self.at(.identifier) && self.isKindAt(offset = 1, kind = .opBitOr) && self.isKindAt(offset = 2, kind = .kwWhile):
        return self.parseLabelled(what = .kwWhile)
    if self.at(.identifier) && self.isKindAt(offset = 1, kind = .opBitOr) && self.isKindAt(offset = 2, kind = .kwFor):
        return self.parseLabelled(what = .kwFor)
    if self.at(.kwVar) || self.at(.kwLet):
        return self.parseVariableDecl()
    if self.at(.kwIf):
        return self.parseIf()
    if self.at(.kwWhile):
        return self.parseWhile()
    if self.at(.kwFor):
        return self.parseFor()
    if self.at(.kwMatch):
        return self.parseMatch()
    if self.at(.kwReturn):
        return self.parseReturn()
    if self.at(.kwBreak):
        return self.parseBreak()
    if self.at(.kwContinue):
        return self.parseContinue()
    if self.at(.kwPass):
        return self.parsePass()
    if self.at(.kwUnroll):
        return self.parseUnroll()
    if self.at(.kwDefer):
        return self.parseDefer()
    if self.at(.kwDetach):
        return self.parseDetach()
    return self.parseExprStatement()
; 分离语句：`detach 表达式` 派发非结构化任务，表达式是唯一子节点。
parseDetach|self() -> (I32,):
    let start: I32 = self.current().start
    self.advance()
    let operand: I32 = self.parseExpression(1)
    let id: I32 = self.newStmt(kind = .stmtDetach, start = start, end = self.previousEnd())
    self.pushStmtKid(id = id, kid = operand)
    return id
; 带标签控制流：标签名先记下，再交对应控制流解析；标签不进 kids。
parseLabelled|self(what: TokenKind,) -> (I32,):
    let labelStart: I32 = self.current().nameStart
    let labelEnd: I32 = self.current().nameEnd
    self.advance()
    self.advance()
    var id = -1
    if kindTag(what) == kindTag(.kwIf):
        id = self.parseIf()
    elif kindTag(what) == kindTag(.kwWhile):
        id = self.parseWhile()
    elif kindTag(what) == kindTag(.kwFor):
        id = self.parseFor()
    if id >= 0:
        self.setStmtName(id = id, start = labelStart, end = labelEnd)
    return id
; capture 语句：`capture 名字`，每行恰一个捕获；名字区间原样保留。
parseCapture|self() -> (I32,):
    let start: I32 = self.current().start
    self.advance()
    var nameStart = -1
    var nameEnd = -1
    if self.at(.identifier):
        nameStart = self.current().nameStart
        nameEnd = self.current().nameEnd
        self.advance()
    else:
        self.report(code = "E2-001", message = "capture 后须恰有一个标识符")
    if !self.atStatementEnd():
        self.report(code = "E2-001", message = "capture 每行只允许一个标识符")
        self.recover()
    let id: I32 = self.newStmt(kind = .stmtCapture, start = start, end = self.previousEnd())
    self.setStmtName(id = id, start = nameStart, end = nameEnd)
    return id
; unroll 语句：`unroll (模式,) in 表:` 后接块，按静态展开语义处理。
parseUnroll|self() -> (I32,):
    let start: I32 = self.current().start
    self.advance()
    var pattern = -1
    if self.at(.leftParen):
        pattern = self.parseParenExpr()
    elif self.at(.identifier):
        let token = self.current()
        self.advance()
        pattern = self.newExpr(kind = .exprIdentifier, start = token.start, end = token.end)
        self.setExprName(id = pattern, start = token.nameStart, end = token.nameEnd)
    else:
        self.report(code = "E2-007", message = "缺少展开模式")
    if !self.expect(kind = .kwIn, what = "`in`"):
        self.recover()
        return -1
    let table: I32 = self.parseExpression(1)
    if !self.expect(kind = .colon, what = "`:`"):
        self.recover()
        return -1
    let body: I32 = self.parseIndentedBlock()
    let id: I32 = self.newStmt(kind = .stmtUnroll, start = start, end = self.previousEnd())
    self.pushStmtKid(id = id, kid = pattern)
    self.pushStmtKid(id = id, kid = table)
    self.pushStmtKid(id = id, kid = body)
    return id
; defer 语句：`defer:` 加缩进块是块形式，`defer 语句` 是相邻单行形式；两者都存成块。
parseDefer|self() -> (I32,):
    let start: I32 = self.current().start
    self.advance()
    var body = -1
    if self.at(.colon):
        self.advance()
        body = self.parseIndentedBlock()
    else:
        let bodyStart: I32 = self.current().start
        let single: I32 = self.parseStatement()
        body = self.newStmt(kind = .stmtBlock, start = bodyStart, end = self.previousEnd())
        if single >= 0:
            self.pushStmtKid(id = body, kid = single)
    let id: I32 = self.newStmt(kind = .stmtDefer, start = start, end = self.previousEnd())
    if body >= 0:
        self.pushStmtKid(id = id, kid = body)
    return id
; 变量语句：`var|let` 后接名字或元组模式，可选类型与初值。
; 变量声明：`var` / `let` 开头，只在块内成立；顶层没有这一形态，行首同名写法交顶级分派报错。
; 解构写在括号里，标注与初值按序读；无初值的形态只有标注。
parseVariableDecl|self() -> (I32,):
    let start: I32 = self.current().start
    let keyword: TokenKind = self.current().kind
    self.advance()
    var pattern = -1
    if self.at(.leftParen):
        pattern = self.parseParenExpr()
    elif self.at(.identifier):
        let token: Token = self.current()
        self.advance()
        pattern = self.newExpr(kind = .exprIdentifier, start = token.start, end = token.end)
        self.setExprName(id = pattern, start = token.nameStart, end = token.nameEnd)
    else:
        self.report(code = "E2-007", message = "缺少变量名")
        self.recover()
        return -1
    var typeId = -1
    if self.at(.colon):
        self.advance()
        typeId = self.parseType()
    var init = -1
    if self.at(.opAssign):
        self.advance()
        init = self.parseExpression(1)
    let id: I32 = self.newStmt(kind = .stmtVariable, start = start, end = self.previousEnd())
    self.setStmtOp(id = id, op = keyword)
    self.setStmtType(id = id, typeId = typeId)
    self.pushStmtKid(id = id, kid = pattern)
    self.pushStmtKid(id = id, kid = init)
    return id
; 如果语句：`if` / `elif` / `else` 三段，子块各自缩进。
parseIf|self() -> (I32,):
    let start: I32 = self.current().start
    let id: I32 = self.newStmt(kind = .stmtIf, start = start, end = start)
    self.advance()
    let cond: I32 = self.parseExpression(1)
    if !self.expect(kind = .colon, what = "`:`"):
        self.recover()
        return id
    let thenBlock: I32 = self.parseIndentedBlock()
    self.pushStmtKid(id = id, kid = cond)
    self.pushStmtKid(id = id, kid = thenBlock)
    var parsing = true
    while parsing && !self.atEnd():
        if self.at(.kwElif):
            self.advance()
            let elifCond: I32 = self.parseExpression(1)
            if !self.expect(kind = .colon, what = "`:`"):
                self.recover()
                parsing = false
            else:
                let elifBlock: I32 = self.parseIndentedBlock()
                self.pushStmtKid(id = id, kid = elifCond)
                self.pushStmtKid(id = id, kid = elifBlock)
        elif self.at(.kwElse):
            self.advance()
            self.expect(kind = .colon, what = "`:`")
            let elseBlock: I32 = self.parseIndentedBlock()
            self.pushStmtKid(id = id, kid = elseBlock)
            parsing = false
        else:
            parsing = false
    self.setStmtEnd(id = id, end = self.previousEnd())
    return id
; 循环语句：条件块后可选 `step:`，其块每轮末尾执行。
parseWhile|self() -> (I32,):
    let start: I32 = self.current().start
    let id: I32 = self.newStmt(kind = .stmtWhile, start = start, end = start)
    self.advance()
    let cond: I32 = self.parseExpression(1)
    if !self.expect(kind = .colon, what = "`:`"):
        self.recover()
        return id
    let body: I32 = self.parseIndentedBlock()
    var stepBlock = -1
    if self.at(.kwStep):
        self.advance()
        self.expect(kind = .colon, what = "`:`")
        stepBlock = self.parseIndentedBlock()
    self.pushStmtKid(id = id, kid = cond)
    self.pushStmtKid(id = id, kid = body)
    self.pushStmtKid(id = id, kid = stepBlock)
    return id
; 遍历语句：`for (模式,) in 表达式:` 后接块与可选 `step:`。
parseFor|self() -> (I32,):
    let start: I32 = self.current().start
    let id = self.newStmt(kind = .stmtFor, start = start, end = start)
    self.advance()
    var pattern = -1
    if self.at(.leftParen):
        pattern = self.parseParenExpr()
    elif self.at(.identifier):
        let token: Token = self.current()
        self.advance()
        pattern = self.newExpr(kind = .exprIdentifier, start = token.start, end = token.end)
        self.setExprName(id = pattern, start = token.nameStart, end = token.nameEnd)
    else:
        self.report(code = "E2-007", message = "缺少遍历模式")
    if !self.expect(kind = .kwIn, what = "`in`"):
        self.recover()
        return id
    let iter: I32 = self.parseExpression(1)
    if !self.expect(kind = .colon, what = "`:`"):
        self.recover()
        return id
    let body: I32 = self.parseIndentedBlock()
    var stepBlock = -1
    if self.at(.kwStep):
        self.advance()
        self.expect(kind = .colon, what = "`:`")
        stepBlock = self.parseIndentedBlock()
    self.setStmtEnd(id = id, end = self.previousEnd())
    self.pushStmtKid(id = id, kid = pattern)
    self.pushStmtKid(id = id, kid = iter)
    self.pushStmtKid(id = id, kid = body)
    self.pushStmtKid(id = id, kid = stepBlock)
    return id
; 匹配语句：主题后接缩进块，块内逐条 `case 模式:` 子块。
parseMatch|self() -> (I32,):
    let start: I32 = self.current().start
    let id = self.newStmt(kind = .stmtMatch, start = start, end = start)
    self.advance()
    let subject: I32 = self.parseExpression(1)
    if !self.expect(kind = .colon, what = "`:`"):
        self.recover()
        return id
    if !self.at(.newline):
        self.report(code = "E2-009", message = "缺少块体")
        return id
    self.advance()
    if !self.at(.indent):
        self.report(code = "E2-003", message = "缺少缩进")
        return id
    self.advance()
    self.pushStmtKid(id = id, kid = subject)
    self.skipNewlines()
    while self.at(.kwCase) && !self.atEnd():
        self.advance()
        let pattern: I32 = self.parsePattern()
        if !self.expect(kind = .colon, what = "`:`"):
            self.recover()
        else:
            let block: I32 = self.parseIndentedBlock()
            self.pushStmtKid(id = id, kid = pattern)
            self.pushStmtKid(id = id, kid = block)
        self.skipNewlines()
    if self.at(.dedent):
        self.advance()
    self.setStmtEnd(id = id, end = self.previousEnd())
    return id
; 模式：裸枚举项可带绑定，`名字: 变量` 记具名绑定，裸名字与 `_` 各占一位。
parsePattern|self() -> (I32,):
    if self.at(.identifier) && self.isKindAt(offset = 1, kind = .leftParen):
        let token: Token = self.current()
        self.advance()
        self.advance()
        let id: I32 = self.newExpr(kind = .exprCase, start = token.start, end = token.end)
        self.setExprName(id = id, start = token.nameStart, end = token.nameEnd)
        while !self.at(.rightParen) && !self.atEnd():
            if self.at(.identifier) && self.isKindAt(offset = 1, kind = .colon):
                let labelStart: I32 = self.current().nameStart
                let labelEnd: I32 = self.current().nameEnd
                self.advance()
                self.advance()
                if self.at(.identifier):
                    let bind = self.current()
                    self.advance()
                    let binding: I32 = self.newExpr(kind = .exprIdentifier, start = bind.start, end = bind.end)
                    self.setExprName(id = binding, start = bind.nameStart, end = bind.nameEnd)
                    self.setExprLabel(id = binding, start = labelStart, end = labelEnd)
                    self.pushExprKid(id = id, kid = binding)
            elif self.at(.identifier):
                let bind = self.current()
                self.advance()
                let binding: I32 = self.newExpr(kind = .exprIdentifier, start = bind.start, end = bind.end)
                self.setExprName(id = binding, start = bind.nameStart, end = bind.nameEnd)
                self.pushExprKid(id = id, kid = binding)
            else:
                self.advance()
            if self.at(.comma):
                self.advance()
        self.expect(kind = .rightParen, what = "`)`")
        self.setExprEnd(id = id, end = self.previousEnd())
        return id
    return self.parseExpression(1)
; 返回语句：无值返回与带值返回同形，缺省值答 -1；值在收尾符前结束，故单行处理器里可裸写 return。
parseReturn|self() -> (I32,):
    let start: I32 = self.current().start
    self.advance()
    var value = -1
    if !self.atStatementEnd():
        value = self.parseExpression(1)
    let id: I32 = self.newStmt(kind = .stmtReturn, start = start, end = self.previousEnd())
    self.pushStmtKid(id = id, kid = value)
    return id
; 语句收尾：换行、块边界与三种收尾括号都表示语句到头。
atStatementEnd|self() -> (Bool,):
    if self.atEnd() || self.at(.newline) || self.at(.dedent):
        return true
    if self.at(.rightParen) || self.at(.rightBracket) || self.at(.rightBrace):
        return true
    return self.at(.comma)
; 继续语句：可带标签，标签按标识符表达式登记。
parseContinue|self() -> (I32,):
    let start: I32 = self.current().start
    self.advance()
    var nameStart = -1
    var nameEnd = -1
    if self.at(.identifier):
        nameStart = self.current().nameStart
        nameEnd = self.current().nameEnd
        self.advance()
    let id: I32 = self.newStmt(kind = .stmtContinue, start = start, end = self.previousEnd())
    self.setStmtName(id = id, start = nameStart, end = nameEnd)
    return id
; 通过语句：空语句，处理器里的显式吞错。
parsePass|self() -> (I32,):
    let start: I32 = self.current().start
    self.advance()
    return self.newStmt(kind = .stmtPass, start = start, end = self.previousEnd())
; 跳出语句：可带标签，标签记在语句名位，不进表达式池。
parseBreak|self() -> (I32,):
    let start: I32 = self.current().start
    self.advance()
    var nameStart = -1
    var nameEnd = -1
    if self.at(.identifier):
        nameStart = self.current().nameStart
        nameEnd = self.current().nameEnd
        self.advance()
    let id: I32 = self.newStmt(kind = .stmtBreak, start = start, end = self.previousEnd())
    self.setStmtName(id = id, start = nameStart, end = nameEnd)
    return id
; 表达式语句：先读表达式，紧跟赋值运算符时改记赋值语句。
parseExprStatement|self() -> (I32,):
    let start: I32 = self.current().start
    let expr: I32 = self.parseExpression(1)
    if expr < 0:
        self.recover()
        return -1
    let kind: TokenKind = self.current().kind
    if isAssignOp(kind):
        self.advance()
        let value: I32 = self.parseExpression(1)
        let id: I32 = self.newStmt(kind = .stmtAssign, start = start, end = self.previousEnd())
        self.setStmtOp(id = id, op = kind)
        self.pushStmtKid(id = id, kid = expr)
        self.pushStmtKid(id = id, kid = value)
        return id
    let id: I32 = self.newStmt(kind = .stmtExpression, start = start, end = self.ast.exprAt(expr).end)
    self.pushStmtKid(id = id, kid = expr)
    return id
; 赋值运算符判定：简单赋值与十一类复合赋值。
previousEnd|self() -> (I32,):
    if self.pos == 0:
        return 0
    return self.tokens[self.pos - 1].end

((Parser))
; 节点构造：类别加上跨度，字段由调用方补齐。
newType|self(kind: TypeKind, start: I32, end: I32,) -> (I32,):
    return self.ast.pushType(kind = kind, start = start, end = end)
newExpr|self(kind: ExprKind, start: I32, end: I32,) -> (I32,):
    return self.ast.pushExpr(kind = kind, start = start, end = end)
newStmt|self(kind: StmtKind, start: I32, end: I32,) -> (I32,):
    return self.ast.pushStmt(kind = kind, start = start, end = end)
newDecl|self(kind: DeclKind, start: I32, end: I32,) -> (I32,):
    return self.ast.pushDecl(kind = kind, start = start, end = end)
; 字段写入：先取节点、改字段、再整体写回，避免按下标直接改字段。
setTypeName|self(id: I32, start: I32, end: I32,) -> ():
    var node = self.ast.types[id]
    node.nameStart = start
    node.nameEnd = end
    self.ast.types[id] = node
    return
setTypeKids|self(id: I32, kids: Array<I32>,) -> ():
    var node = self.ast.types[id]
    node.kids = kids
    self.ast.types[id] = node
    return
; 元组标签串：逐分量以逗号分隔，空段表示该分量无标签。
setTypeLabels|self(id: I32, labels: String,) -> ():
    var node = self.ast.types[id]
    node.labels = labels
    self.ast.types[id] = node
    return
pushTypeKid|self(id: I32, kid: I32,) -> ():
    var node = self.ast.types[id]
    node.kids = node.kids.append(kid)
    self.ast.types[id] = node
    return
setExprName|self(id: I32, start: I32, end: I32,) -> ():
    var node = self.ast.exprs[id]
    node.nameStart = start
    node.nameEnd = end
    self.ast.exprs[id] = node
    return
setExprOp|self(id: I32, op: TokenKind,) -> ():
    var node = self.ast.exprs[id]
    node.op = kindTag(op)
    self.ast.exprs[id] = node
    return
; 表达式类型位：转换节点写目标类型，其余节点用不到。
setExprType|self(id: I32, typeId: I32,) -> ():
    var node = self.ast.exprs[id]
    node.typeId = typeId
    self.ast.exprs[id] = node
    return
setExprKids|self(id: I32, kids: Array<I32>,) -> ():
    var node = self.ast.exprs[id]
    node.kids = kids
    self.ast.exprs[id] = node
    return
pushExprKid|self(id: I32, kid: I32,) -> ():
    var node = self.ast.exprs[id]
    node.kids = node.kids.append(kid)
    self.ast.exprs[id] = node
    return
setStmtOp|self(id: I32, op: TokenKind,) -> ():
    var node = self.ast.stmts[id]
    node.op = kindTag(op)
    self.ast.stmts[id] = node
    return
setStmtKids|self(id: I32, kids: Array<I32>,) -> ():
    var node = self.ast.stmts[id]
    node.kids = kids
    self.ast.stmts[id] = node
    return
pushStmtKid|self(id: I32, kid: I32,) -> ():
    var node = self.ast.stmts[id]
    node.kids = node.kids.append(kid)
    self.ast.stmts[id] = node
    return
setDeclName|self(id: I32, start: I32, end: I32,) -> ():
    var node = self.ast.decls[id]
    node.nameStart = start
    node.nameEnd = end
    self.ast.decls[id] = node
    return
setDeclType|self(id: I32, typeId: I32,) -> ():
    var node = self.ast.decls[id]
    node.typeId = typeId
    self.ast.decls[id] = node
    return
setDeclBody|self(id: I32, body: I32,) -> ():
    var node = self.ast.decls[id]
    node.body = body
    self.ast.decls[id] = node
    return
setDeclKids|self(id: I32, kids: Array<I32>,) -> ():
    var node = self.ast.decls[id]
    node.kids = kids
    self.ast.decls[id] = node
    return
pushDeclKid|self(id: I32, kid: I32,) -> ():
    var node = self.ast.decls[id]
    node.kids = node.kids.append(kid)
    self.ast.decls[id] = node
    return
; 函数修饰写回：测试、自身、本型与外部声明各一位，自身与本型互斥。
setFunctionMarks|self(id: I32, isTest: Bool, isSelf: Bool, isOwn: Bool, isForeign: Bool, isUnsafe: Bool,) -> ():
    var node = self.ast.decls[id]
    node.isTest = isTest
    node.isSelf = isSelf
    node.isOwn = isOwn
    node.isForeign = isForeign
    node.isUnsafe = isUnsafe
    self.ast.decls[id] = node
    return
; 参数前缀写回：own / using / self 三者互斥。
setParamMarks|self(id: I32, isOwn: Bool, isUsing: Bool, isSelf: Bool,) -> ():
    var node = self.ast.decls[id]
    node.isOwn = isOwn
    node.isUsing = isUsing
    node.isSelf = isSelf
    self.ast.decls[id] = node
    return
; 返回位多包一层括号的标记写回。
setDeclReturnNested|self(id: I32, value: Bool,) -> ():
    var node = self.ast.decls[id]
    node.returnNested = value
    self.ast.decls[id] = node
    return
; 模式绑定的具名标签写回：只记区间，打印按它还原 `标签: 绑定`。
setExprLabel|self(id: I32, start: I32, end: I32,) -> ():
    var node = self.ast.exprs[id]
    node.labelStart = start
    node.labelEnd = end
    self.ast.exprs[id] = node
    return
; `|func` 标记写回：只记源里写没写，打印与签名都按它还原。
setDeclFuncMark|self(id: I32, value: Bool,) -> ():
    var node = self.ast.decls[id]
    node.isFunc = value
    self.ast.decls[id] = node
    return
; 异步位写回：只由 `=>` 置位，函数声明与函数字面量各走一条。
setDeclAsync|self(id: I32, value: Bool,) -> ():
    var node = self.ast.decls[id]
    node.isAsync = value
    self.ast.decls[id] = node
    return
setExprAsync|self(id: I32, value: Bool,) -> ():
    var node = self.ast.exprs[id]
    node.isAsync = value
    self.ast.exprs[id] = node
    return
setDeclGeneric|self(id: I32, kids: Array<I32>,) -> ():
    var node = self.ast.decls[id]
    node.generic = kids
    self.ast.decls[id] = node
    return
setDeclComposed|self(id: I32, value: Bool,) -> ():
    var node = self.ast.decls[id]
    node.composed = value
    self.ast.decls[id] = node
    return
setTypeRet|self(id: I32, ret: I32,) -> ():
    var node = self.ast.types[id]
    node.ret = ret
    self.ast.types[id] = node
    return
setExprEnd|self(id: I32, end: I32,) -> ():
    var node = self.ast.exprs[id]
    node.end = end
    self.ast.exprs[id] = node
    return
setStmtType|self(id: I32, typeId: I32,) -> ():
    var node = self.ast.stmts[id]
    node.typeId = typeId
    self.ast.stmts[id] = node
    return
setStmtEnd|self(id: I32, end: I32,) -> ():
    var node = self.ast.stmts[id]
    node.end = end
    self.ast.stmts[id] = node
    return
setStmtName|self(id: I32, start: I32, end: I32,) -> ():
    var node = self.ast.stmts[id]
    node.nameStart = start
    node.nameEnd = end
    self.ast.stmts[id] = node
    return
