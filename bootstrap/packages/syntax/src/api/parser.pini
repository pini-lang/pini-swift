[parser|import]
_diagnostics = "../../../diagnostics"

; 解析状态：记号游标、节点池与诊断序列；所有推进都经由本文件的方法。
(Parser)
tokens: Array<Token> = []
pos: I32 = 0
total: I32 = 0
file: String = ""
ast: Ast = Ast()
diagnostics: Array<Diagnostic> = []

; 解析结果：树、语法诊断与词法问题分列；问题不参与语法判定。
(ParseResult)
ast: Ast = Ast()
diagnostics: Array<Diagnostic> = []
issues: Array<LexIssue> = []

; 解析文本：先归一化行尾再扫描；文件名留空，位置映射由调用方补。
parseText|func(text: String,) -> (ParseResult,):
    return parseFile(text, "")

; 解析文本并登记文件名：诊断里的文件名即此参数。
parseFile|func(text: String, file: String,) -> (ParseResult,):
    let lexed = lexText(text)
    var p = Parser()
    p.tokens = lexed.tokens
    p.total = len(lexed.tokens)
    p.file = file
    p.parseModule()
    var out = ParseResult()
    out.ast = p.ast
    out.diagnostics = p.diagnostics
    out.issues = lexed.issues
    return out

binaryPrecedence|func(kind: TokenKind,) -> (I32,):
    let tag: I32 = kindTag(kind)
    if tag == kindTag(逻辑或):
        return 1
    if tag == kindTag(逻辑与):
        return 2
    if tag == kindTag(等于) || tag == kindTag(不等):
        return 3
    if tag == kindTag(小于) || tag == kindTag(大于) || tag == kindTag(小于等于) || tag == kindTag(大于等于):
        return 4
    if tag == kindTag(位与) || tag == kindTag(竖线) || tag == kindTag(位异或) || tag == kindTag(左移) || tag == kindTag(右移):
        return 5
    if tag == kindTag(加) || tag == kindTag(减):
        return 6
    if tag == kindTag(星号) || tag == kindTag(除) || tag == kindTag(取余):
        return 7
    return 0

; 一元前缀：`-` `+` `!` `~` `^` `&` `++` `--` 右结合。
isUnaryKind|func(kind: TokenKind,) -> (Bool,):
    let tag: I32 = kindTag(kind)
    if tag == kindTag(减) || tag == kindTag(加) || tag == kindTag(逻辑非):
        return true
    if tag == kindTag(位取反) || tag == kindTag(位异或) || tag == kindTag(位与):
        return true
    return tag == kindTag(自增) || tag == kindTag(自减)

isAssignOp|func(kind: TokenKind,) -> (Bool,):
    let tag: I32 = kindTag(kind)
    if tag == kindTag(赋值):
        return true
    return tag >= kindTag(加赋值) && tag <= kindTag(右移赋值)

; 上一条记号的终点：新节点收尾时用作跨度终点。
((Parser))
; 当前记号：越界答结束记号，循环判界靠 `atEnd`。
current|self() -> (Token,):
    if self.pos >= self.total:
        var token = Token()
        token.kind = 结束
        return token
    return self.tokens[self.pos]
; 前瞻第 n 条记号：越界一律答结束，调用方无需重复判界。
kindAt|self(offset: I32,) -> (TokenKind,):
    let index = self.pos + offset
    if index < 0 || index >= self.total:
        return 结束
    return self.tokens[index].kind
atEnd|self() -> (Bool,):
    if self.pos >= self.total:
        return true
    return isKind(self.current(), 结束)
at|self(kind: TokenKind,) -> (Bool,):
    return isKind(self.current(), kind)
isKindAt|self(offset: I32, kind: TokenKind,) -> (Bool,):
    return kindTag(self.kindAt(offset)) == kindTag(kind)
advance|self() -> ():
    if self.pos < self.total:
        self.pos = self.pos + 1
    return
; 跳过行尾：块内语句之间只允许换行。
skipNewlines|self() -> ():
    while self.at(换行):
        self.advance()
    return
; 报一条语法诊断：跨度为当前记号；到达文件末尾时改用上一条记号的终点。
report|self(code: String, message: String,) -> ():
    var start = self.current().start
    var end = self.current().end
    if self.atEnd() && self.pos > 0:
        start = self.tokens[self.pos - 1].end
        end = start
    var d = makeDiagnostic(self.file, categorySyntax(), severityError(), code, message)
    d = d.addLabel(makeLabel(start, end, message, true))
    self.diagnostics = self.diagnostics.append(d)
    return
; 期望某类记号：命中即消费并答真，否则记 E2-001 并答假。
expect|self(kind: TokenKind, what: String,) -> (Bool,):
    if self.at(kind):
        self.advance()
        return true
    self.report("E2-001", "期望" + what + "，实际得到" + kindName(self.current().kind))
    return false
; 错误恢复：跳到行尾或块边界，保证每次失败至少前进一条记号。
recover|self() -> ():
    if self.atEnd():
        return
    while !self.atEnd() && !self.at(换行) && !self.at(反缩进):
        self.advance()
    if self.at(换行):
        self.advance()
    return
; 模块：逐条顶级声明；某条解析不动就恢复，避免原地打转。
parseModule|self() -> ():
    self.skipNewlines()
    while !self.atEnd():
        let before = self.pos
        self.parseTopLevel()
        if self.pos == before:
            self.report("E2-005", "无效的顶级声明")
            self.advance()
        self.skipNewlines()
    return
; 顶级分派：行首记号决定声明种类，其余按名字后的竖线区分函数与变量。
parseTopLevel|self() -> ():
    if self.at(左方):
        self.parseBracketDecl()
        return
    if self.at(左圆):
        self.parseParenDecl()
        return
    if self.at(左花):
        self.parseBraceDecl()
        return
    if self.at(标识符) && self.isKindAt(1, 竖线):
        let id = self.parseFunctionDecl()
        if id >= 0:
            self.ast.addItem(id)
        return
    if self.at(标识符) && self.isKindAt(1, 冒号):
        let id = self.parseVariableDecl(true)
        if id >= 0:
            self.ast.addItem(id)
        return
    self.report("E2-005", "无效的顶级声明")
    self.recover()
    return
; 方括号声明：`[名|import]`、`[名]` 枚举与 `[[名]]` 扩展三种形态。
parseBracketDecl|self() -> ():
    let start: I32 = self.current().start
    if self.isKindAt(1, 标识符) && self.isKindAt(2, 竖线) && self.isKindAt(3, 导入):
        self.parseImportBlock(start)
        return
    if self.isKindAt(1, 左方):
        self.advance()
        self.advance()
        let nameStart: I32 = self.current().nameStart
        let nameEnd: I32 = self.current().nameEnd
        if self.expect(标识符, "扩展目标名"):
            self.expect(右方, "`]]`")
            self.expect(右方, "`]]`")
            let id: I32 = self.newDecl(项扩展, start, self.previousEnd())
            self.setDeclName(id, nameStart, nameEnd)
            let members: Array<I32> = self.parseMethodLines()
            self.setDeclKids(id, members)
        return
    self.advance()
    let nameStart: I32 = self.current().nameStart
    let nameEnd: I32 = self.current().nameEnd
    if !self.expect(标识符, "枚举名"):
        self.recover()
        return
    if !self.expect(右方, "`]`"):
        self.recover()
        return
    let id: I32 = self.newDecl(项枚举, start, self.previousEnd())
    self.setDeclName(id, nameStart, nameEnd)
    let variants: Array<I32> = self.parseVariantLines()
    self.setDeclKids(id, variants)
    return
; 导入块：条目形如 `别名 = "包路径"`，遇到非条目行即收尾。
parseImportBlock|self(start: I32,) -> ():
    self.advance()
    let nameStart: I32 = self.current().nameStart
    let nameEnd: I32 = self.current().nameEnd
    self.advance()
    self.advance()
    self.expect(导入, "`import`")
    self.expect(右方, "`]`")
    let id: I32 = self.newDecl(项导入块, start, self.previousEnd())
    self.ast.addItem(id)
    self.setDeclName(id, nameStart, nameEnd)
    var entries: Array<I32> = []
    self.skipNewlines()
    while self.at(标识符) && self.isKindAt(1, 赋值):
        let entryStart: I32 = self.current().start
        let aliasStart: I32 = self.current().nameStart
        let aliasEnd: I32 = self.current().nameEnd
        self.advance()
        self.advance()
        if self.at(字符串):
            let path: I32 = self.parsePrimary()
            let entry: I32 = self.newDecl(项导入项, entryStart, self.previousEnd())
            self.setDeclName(entry, aliasStart, aliasEnd)
            self.pushDeclKid(entry, path)
            entries = entries.append(entry)
            self.advance()
        else:
            self.report("E2-001", "期望包路径字符串")
            self.recover()
        self.skipNewlines()
    self.setDeclKids(id, entries)
    return
; 圆括号声明：`(名)` 结构块与 `((名))` 结构扩展。
parseParenDecl|self() -> ():
    let start: I32 = self.current().start
    if self.isKindAt(1, 左圆):
        self.advance()
        self.advance()
        let nameStart: I32 = self.current().nameStart
        let nameEnd: I32 = self.current().nameEnd
        if self.expect(标识符, "扩展目标名"):
            self.expect(右圆, "`))`")
            self.expect(右圆, "`))`")
            let id: I32 = self.newDecl(项扩展, start, self.previousEnd())
            self.setDeclName(id, nameStart, nameEnd)
            self.setDeclKids(id, self.parseMethodLines())
        return
    self.advance()
    let nameStart: I32 = self.current().nameStart
    let nameEnd: I32 = self.current().nameEnd
    if !self.expect(标识符, "结构名"):
        self.recover()
        return
    if !self.expect(右圆, "`)`"):
        self.recover()
        return
    let id: I32 = self.newDecl(项结构, start, self.previousEnd())
    self.setDeclName(id, nameStart, nameEnd)
    self.setDeclKids(id, self.parseFieldLines())
    return
; 花括号声明：`{名}` 对象块与 `{{名}}` 对象扩展。
parseBraceDecl|self() -> ():
    let start: I32 = self.current().start
    if self.isKindAt(1, 左花):
        self.advance()
        self.advance()
        let nameStart: I32 = self.current().nameStart
        let nameEnd: I32 = self.current().nameEnd
        if self.expect(标识符, "扩展目标名"):
            self.expect(右花, "`}}`")
            self.expect(右花, "`}}`")
            let id: I32 = self.newDecl(项扩展, start, self.previousEnd())
            self.setDeclName(id, nameStart, nameEnd)
            self.setDeclKids(id, self.parseMethodLines())
        return
    self.advance()
    let nameStart: I32 = self.current().nameStart
    let nameEnd: I32 = self.current().nameEnd
    if !self.expect(标识符, "对象名"):
        self.recover()
        return
    if !self.expect(右花, "`}`"):
        self.recover()
        return
    let id: I32 = self.newDecl(项对象, start, self.previousEnd())
    self.setDeclName(id, nameStart, nameEnd)
    self.setDeclKids(id, self.parseFieldLines())
    return
; 字段块：`名字: 类型 [= 初值]` 逐行读取，遇到非字段行即收尾。
parseFieldLines|self() -> (Array<I32>,):
    var fields: Array<I32> = []
    self.skipNewlines()
    while self.at(标识符) && self.isKindAt(1, 冒号):
        let start: I32 = self.current().start
        let nameStart: I32 = self.current().nameStart
        let nameEnd: I32 = self.current().nameEnd
        self.advance()
        self.advance()
        let typeId: I32 = self.parseType()
        var init = -1
        if self.at(赋值):
            self.advance()
            init = self.parseExpression(1)
        let id: I32 = self.newDecl(项字段, start, self.previousEnd())
        self.setDeclName(id, nameStart, nameEnd)
        self.setDeclType(id, typeId)
        if init >= 0:
            self.pushDeclKid(id, init)
        fields = fields.append(id)
        self.skipNewlines()
    return fields
; 枚举体：`变体` 或 `变体(字段, ...)`；带载荷的字段按参数形状登记。
parseVariantLines|self() -> (Array<I32>,):
    var variants: Array<I32> = []
    self.skipNewlines()
    while self.at(标识符) && !self.isKindAt(1, 竖线):
        let start: I32 = self.current().start
        let nameStart: I32 = self.current().nameStart
        let nameEnd: I32 = self.current().nameEnd
        self.advance()
        var fields: Array<I32> = []
        if self.at(左圆):
            fields = self.parseParams()
        let id: I32 = self.newDecl(项变体, start, self.previousEnd())
        self.setDeclName(id, nameStart, nameEnd)
        self.setDeclKids(id, fields)
        variants = variants.append(id)
        self.skipNewlines()
    return variants
; 方法块：`名字|self(...)` 逐行读取，遇到非方法行即收尾。
parseMethodLines|self() -> (Array<I32>,):
    var methods: Array<I32> = []
    self.skipNewlines()
    while self.at(标识符) && self.isKindAt(1, 竖线):
        let id: I32 = self.parseFunctionDecl()
        if id >= 0:
            methods = methods.append(id)
        self.skipNewlines()
    return methods
; 函数声明：`名字|func|test|self|foreign(params,) -> (返回,)` 后接块体或同行语句。
parseFunctionDecl|self() -> (I32,):
    let start: I32 = self.current().start
    let nameStart: I32 = self.current().nameStart
    let nameEnd: I32 = self.current().nameEnd
    self.advance()
    if !self.expect(竖线, "`|`"):
        self.recover()
        return -1
    var isTest = false
    var isSelf = false
    var isForeign = false
    if self.at(测试):
        isTest = true
        self.advance()
    elif self.at(自身):
        isSelf = true
        self.advance()
    elif self.at(外部):
        isForeign = true
        self.advance()
    elif !self.at(函数):
        self.report("E2-001", "期望 `func`、`test`、`self` 或 `foreign`")
        self.recover()
        return -1
    else:
        self.advance()
    if !self.at(左圆):
        self.report("E2-001", "期望参数表 `(`")
        self.recover()
        return -1
    let params = self.parseParams()
    var returnType = -1
    if self.at(箭头):
        self.advance()
        returnType = self.parseType()
    if !self.expect(冒号, "`:`"):
        self.recover()
        return -1
    var body = -1
    if self.at(换行):
        body = self.parseIndentedBlock()
    else:
        body = self.parseInlineBlock()
    let id: I32 = self.newDecl(项函数, start, self.previousEnd())
    self.setDeclName(id, nameStart, nameEnd)
    self.setDeclKids(id, params)
    self.setDeclType(id, returnType)
    self.setDeclBody(id, body)
    self.setFunctionMarks(id, isTest, isSelf, isForeign)
    return id
; 参数表：`(` 到 `)`，每项可带 own / using / self 前缀与默认值。
parseParams|self() -> (Array<I32>,):
    var params: Array<I32> = []
    self.advance()
    self.skipNewlines()
    while !self.at(右圆) && !self.atEnd():
        let start: I32 = self.current().start
        var isOwn = false
        var isUsing = false
        var isSelf = false
        if self.at(自有):
            isOwn = true
            self.advance()
        elif self.at(使用):
            isUsing = true
            self.advance()
        elif self.at(自身):
            isSelf = true
            self.advance()
        var nameStart = self.current().start
        var nameEnd = self.current().end
        if self.at(标识符) || self.at(自身):
            nameStart = self.current().nameStart
            nameEnd = self.current().nameEnd
            self.advance()
        else:
            self.report("E2-012", "缺少参数名")
        var typeId = -1
        if self.at(冒号):
            self.advance()
            typeId = self.parseType()
        var def = -1
        if self.at(赋值):
            self.advance()
            def = self.parseExpression(1)
        let id: I32 = self.newDecl(项参数, start, self.previousEnd())
        self.setDeclName(id, nameStart, nameEnd)
        self.setDeclType(id, typeId)
        if def >= 0:
            self.pushDeclKid(id, def)
        self.setParamMarks(id, isOwn, isUsing, isSelf)
        params = params.append(id)
        if self.at(逗号):
            self.advance()
        self.skipNewlines()
    self.expect(右圆, "`)`")
    return params
; 类型：前缀星号、圆括号元组或函数、具名与泛型实参、后缀问号。
parseType|self() -> (I32,):
    if self.at(星号):
        let start: I32 = self.current().start
        self.advance()
        let inner: I32 = self.parseType()
        let id: I32 = self.newType(型指针, start, self.previousEnd())
        self.pushTypeKid(id, inner)
        return id
    if self.at(左圆):
        return self.parseParenType()
    if !self.at(标识符):
        self.report("E2-008", "缺少类型名")
        return -1
    let start: I32 = self.current().start
    let nameStart: I32 = self.current().nameStart
    let nameEnd: I32 = self.current().nameEnd
    self.advance()
    if self.at(小于):
        self.advance()
        var args: Array<I32> = []
        self.skipNewlines()
        while !self.at(大于) && !self.atEnd():
            let arg: I32 = self.parseType()
            if arg >= 0:
                args = args.append(arg)
            if self.at(逗号):
                self.advance()
            self.skipNewlines()
        self.expect(大于, "`>`")
        let id: I32 = self.newType(型泛型, start, self.previousEnd())
        self.setTypeName(id, nameStart, nameEnd)
        self.setTypeKids(id, args)
        return self.maybeOptional(id)
    let id: I32 = self.newType(型具名, start, self.previousEnd())
    self.setTypeName(id, nameStart, nameEnd)
    return self.maybeOptional(id)
; 后缀问号：包成可选类型；`T??` 逐层包裹。
maybeOptional|self(id: I32,) -> (I32,):
    var out = id
    while self.at(问号):
        self.advance()
        let wrapped: I32 = self.newType(型可选, self.ast.typeAt(out).start, self.previousEnd())
        self.pushTypeKid(wrapped, out)
        out = wrapped
    return out
; 圆括号类型：先按元素列表读，见到箭头即整体成为函数类型的形参部分。
parseParenType|self() -> (I32,):
    let start: I32 = self.current().start
    self.advance()
    var items: Array<I32> = []
    self.skipNewlines()
    while !self.at(右圆) && !self.atEnd():
        let item: I32 = self.parseType()
        if item >= 0:
            items = items.append(item)
        if self.at(逗号):
            self.advance()
        self.skipNewlines()
    self.expect(右圆, "`)`")
    if self.at(箭头):
        self.advance()
        let ret: I32 = self.parseType()
        let id: I32 = self.newType(型函数, start, self.previousEnd())
        self.setTypeKids(id, items)
        self.setTypeRet(id, ret)
        return id
    let id: I32 = self.newType(型元组, start, self.previousEnd())
    self.setTypeKids(id, items)
    return id
; 表达式：按二元优先级爬升，一元与后缀在更低层解析。
parseExpression|self(minPrecedence: I32,) -> (I32,):
    var left: I32 = self.parseUnary()
    var climbing = true
    while climbing && left >= 0:
        let precedence: I32 = binaryPrecedence(self.current().kind)
        if precedence < minPrecedence || precedence == 0:
            climbing = false
        else:
            let op: TokenKind = self.current().kind
            self.advance()
            let right: I32 = self.parseExpression(precedence + 1)
            let id: I32 = self.newExpr(式二元, self.ast.exprAt(left).start, self.ast.exprAt(left).end)
            self.setExprOp(id, op)
            self.pushExprKid(id, left)
            self.pushExprKid(id, right)
            left = id
    return left
parseUnary|self() -> (I32,):
    let kind: TokenKind = self.current().kind
    if isUnaryKind(kind):
        let start: I32 = self.current().start
        self.advance()
        let operand: I32 = self.parseUnary()
        let id: I32 = self.newExpr(式一元, start, self.previousEnd())
        self.setExprOp(id, kind)
        self.pushExprKid(id, operand)
        return id
    return self.parsePostfix()
; 后缀链：调用、下标、切片与成员访问按出现顺序叠加。
parsePostfix|self() -> (I32,):
    var expr: I32 = self.parsePrimary()
    var chaining = true
    while chaining && expr >= 0:
        if self.at(左圆):
            expr = self.finishCall(expr)
        elif self.at(左方):
            expr = self.finishIndex(expr)
        elif self.at(点):
            let start = self.ast.exprAt(expr).start
            self.advance()
            let nameStart: I32 = self.current().nameStart
            let nameEnd: I32 = self.current().nameEnd
            if !self.expect(标识符, "成员名"):
                return expr
            let id: I32 = self.newExpr(式成员, start, self.previousEnd())
            self.setExprName(id, nameStart, nameEnd)
            self.pushExprKid(id, expr)
            expr = id
        else:
            chaining = false
    return expr
; 调用：实参可带 `名字 = 值` 标签，尾随逗号合法。
finishCall|self(callee: I32,) -> (I32,):
    let start = self.ast.exprAt(callee).start
    self.advance()
    let id: I32 = self.newExpr(式调用, start, self.previousEnd())
    self.pushExprKid(id, callee)
    self.skipNewlines()
    while !self.at(右圆) && !self.atEnd():
        let before = self.pos
        if self.at(标识符) && self.isKindAt(1, 赋值):
            let labelStart: I32 = self.current().nameStart
            let labelEnd: I32 = self.current().nameEnd
            self.advance()
            self.advance()
            let value: I32 = self.parseExpression(1)
            let arg: I32 = self.newExpr(式二元, labelStart, self.ast.exprAt(value).end)
            self.setExprName(arg, labelStart, labelEnd)
            self.setExprOp(arg, 赋值)
            self.pushExprKid(arg, value)
            self.pushExprKid(id, arg)
        else:
            let arg: I32 = self.parseExpression(1)
            if arg >= 0:
                self.pushExprKid(id, arg)
        if self.at(逗号):
            self.advance()
        if self.pos == before:
            self.advance()
        self.skipNewlines()
    self.expect(右圆, "`)`")
    self.setExprEnd(id, self.previousEnd())
    return id
; 下标或切片：`a[i]` 与 `a[i:j]`，两端都可省略。
finishIndex|self(target: I32,) -> (I32,):
    let start = self.ast.exprAt(target).start
    self.advance()
    self.skipNewlines()
    var lower = -1
    if !self.at(冒号) && !self.at(右方):
        lower = self.parseExpression(1)
    if self.at(冒号):
        self.advance()
        var upper = -1
        if !self.at(右方):
            upper = self.parseExpression(1)
        self.expect(右方, "`]`")
        let id: I32 = self.newExpr(式切片, start, self.previousEnd())
        self.pushExprKid(id, target)
        self.pushExprKid(id, lower)
        self.pushExprKid(id, upper)
        return id
    self.expect(右方, "`]`")
    let id: I32 = self.newExpr(式下标, start, self.previousEnd())
    self.pushExprKid(id, target)
    self.pushExprKid(id, lower)
    return id
; 基本表达式：字面量、名字、枚举项、括号组、容器字面量与函数字面量。
parsePrimary|self() -> (I32,):
    let token: Token = self.current()
    let start = token.start
    if isKind(token, 整数):
        self.advance()
        return self.newExpr(式整数, start, token.end)
    if isKind(token, 浮点):
        self.advance()
        return self.newExpr(式浮点, start, token.end)
    if isKind(token, 字符串):
        self.advance()
        return self.newExpr(式字符串, start, token.end)
    if isKind(token, 插值字符串):
        self.advance()
        return self.newExpr(式插值, start, token.end)
    if isKind(token, 真):
        self.advance()
        return self.newExpr(式真, start, token.end)
    if isKind(token, 假):
        self.advance()
        return self.newExpr(式假, start, token.end)
    if isKind(token, 空):
        self.advance()
        return self.newExpr(式空, start, token.end)
    if isKind(token, 点):
        self.advance()
        let nameStart: I32 = self.current().nameStart
        let nameEnd: I32 = self.current().nameEnd
        if !self.expect(标识符, "枚举项名"):
            return -1
        let id: I32 = self.newExpr(式枚举项, start, self.previousEnd())
        self.setExprName(id, nameStart, nameEnd)
        return id
    if isKind(token, 标识符) || isKind(token, 自身):
        self.advance()
        let id: I32 = self.newExpr(式标识符, start, token.end)
        self.setExprName(id, token.nameStart, token.nameEnd)
        return id
    if isKind(token, 左圆):
        return self.parseParenExpr()
    if isKind(token, 左方):
        return self.parseArrayLiteral()
    if isKind(token, 左花):
        return self.parseBraceLiteral()
    if isKind(token, 函数):
        return self.parseLambda()
    self.report("E2-006", "无效的表达式，实际得到" + kindName(token.kind))
    return -1
; 括号表达式：单个元素是分组，多个元素构成元组；尾随逗号是元组标记。
parseParenExpr|self() -> (I32,):
    let start: I32 = self.current().start
    self.advance()
    self.skipNewlines()
    if self.at(右圆):
        self.advance()
        return self.newExpr(式元组, start, self.previousEnd())
    let first: I32 = self.parseExpression(1)
    if !self.at(逗号):
        self.expect(右圆, "`)`")
        return first
    var items: Array<I32> = []
    if first >= 0:
        items = items.append(first)
    while self.at(逗号):
        self.advance()
        self.skipNewlines()
        if !self.at(右圆):
            let item: I32 = self.parseExpression(1)
            if item >= 0:
                items = items.append(item)
        self.skipNewlines()
    self.expect(右圆, "`)`")
    let id: I32 = self.newExpr(式元组, start, self.previousEnd())
    self.setExprKids(id, items)
    return id
; 数组字面量：`[a, b]`；元素之间允许跨行。
parseArrayLiteral|self() -> (I32,):
    let start: I32 = self.current().start
    self.advance()
    var items: Array<I32> = []
    self.skipNewlines()
    while !self.at(右方) && !self.atEnd():
        let before = self.pos
        let item: I32 = self.parseExpression(1)
        if item >= 0:
            items = items.append(item)
        if self.at(逗号):
            self.advance()
        if self.pos == before:
            self.advance()
        self.skipNewlines()
    self.expect(右方, "`]`")
    let id: I32 = self.newExpr(式数组, start, self.previousEnd())
    self.setExprKids(id, items)
    return id
; 花括号字面量：首项后跟 `=` 即字典，否则是集合；空括号答空字典。
parseBraceLiteral|self() -> (I32,):
    let start: I32 = self.current().start
    self.advance()
    self.skipNewlines()
    if self.at(右花):
        self.advance()
        return self.newExpr(式字典, start, self.previousEnd())
    let first: I32 = self.parseExpression(1)
    if self.at(赋值):
        self.advance()
        let value: I32 = self.parseExpression(1)
        var items: Array<I32> = []
        items = items.append(first)
        items = items.append(value)
        while self.at(逗号):
            self.advance()
            self.skipNewlines()
            if !self.at(右花):
                let key: I32 = self.parseExpression(1)
                self.expect(赋值, "`=`")
                let item: I32 = self.parseExpression(1)
                items = items.append(key)
                items = items.append(item)
        self.expect(右花, "`}`")
        let id: I32 = self.newExpr(式字典, start, self.previousEnd())
        self.setExprKids(id, items)
        return id
    var items: Array<I32> = []
    items = items.append(first)
    while self.at(逗号):
        self.advance()
        self.skipNewlines()
        if !self.at(右花):
            let item: I32 = self.parseExpression(1)
            if item >= 0:
                items = items.append(item)
    self.expect(右花, "`}`")
    let id: I32 = self.newExpr(式集合, start, self.previousEnd())
    self.setExprKids(id, items)
    return id
; 函数字面量：`func (参数,) -> (返回,):` 后接缩进块或同行语句。
parseLambda|self() -> (I32,):
    let start: I32 = self.current().start
    self.advance()
    if !self.at(左圆):
        self.report("E2-001", "期望参数表 `(`")
        return -1
    let params = self.parseParams()
    var returnType = -1
    if self.at(箭头):
        self.advance()
        returnType = self.parseType()
    if !self.expect(冒号, "`:`"):
        return -1
    var body = -1
    if self.at(换行):
        body = self.parseIndentedBlock()
    else:
        body = self.parseInlineBlock()
    let id: I32 = self.newExpr(式函数, start, self.previousEnd())
    var kids: Array<I32> = []
    var i = 0
    while i < len(params):
        kids = kids.append(params[i])
        i = i + 1
    if body >= 0:
        kids = kids.append(body)
    self.setExprKids(id, kids)
    var node = self.ast.exprs[id]
    node.op = returnType
    self.ast.exprs[id] = node
    return id
; 缩进块：换行 + 缩进开启，逐条语句读到反缩进；空块报缺少块体。
parseIndentedBlock|self() -> (I32,):
    let start: I32 = self.current().start
    if !self.at(换行):
        self.report("E2-009", "缺少块体")
        return -1
    self.advance()
    if !self.at(缩进):
        self.report("E2-003", "缺少缩进")
        return -1
    self.advance()
    var ids: Array<I32> = []
    self.skipNewlines()
    while !self.atEnd() && !self.at(反缩进):
        let before = self.pos
        let id: I32 = self.parseStatement()
        if id >= 0:
            ids = ids.append(id)
        if self.pos == before:
            self.advance()
        self.skipNewlines()
    if self.at(反缩进):
        self.advance()
    let id: I32 = self.newStmt(句块, start, self.previousEnd())
    self.setStmtKids(id, ids)
    return id
; 同行块体：`:` 之后直接一条语句，用于单行函数字面量与单行函数体。
parseInlineBlock|self() -> (I32,):
    let start: I32 = self.current().start
    let id: I32 = self.parseStatement()
    let block: I32 = self.newStmt(句块, start, self.previousEnd())
    if id >= 0:
        self.pushStmtKid(block, id)
    return block
; 语句分派：关键字开头各有专用形状，其余按表达式或赋值处理。
parseStatement|self() -> (I32,):
    if self.at(变量) || self.at(常量):
        return self.parseVariableDecl(false)
    if self.at(如果):
        return self.parseIf()
    if self.at(循环):
        return self.parseWhile()
    if self.at(遍历):
        return self.parseFor()
    if self.at(匹配):
        return self.parseMatch()
    if self.at(返回):
        return self.parseReturn()
    if self.at(跳出):
        return self.parseBreak()
    if self.at(继续):
        let start: I32 = self.current().start
        self.advance()
        return self.newStmt(句继续, start, self.previousEnd())
    if self.at(通过):
        let start: I32 = self.current().start
        self.advance()
        return self.newStmt(句通过, start, self.previousEnd())
    if self.at(延迟):
        let start: I32 = self.current().start
        self.advance()
        if !self.expect(冒号, "`:`"):
            self.recover()
            return -1
        let body: I32 = self.parseIndentedBlock()
        let id: I32 = self.newStmt(句延迟, start, self.previousEnd())
        if body >= 0:
            self.pushStmtKid(id, body)
        return id
    return self.parseExprStatement()
; 变量语句：`var|let` 后接名字或元组模式，可选类型与初值。
parseVariableDecl|self(topLevel: Bool,) -> (I32,):
    let start: I32 = self.current().start
    let keyword: TokenKind = self.current().kind
    self.advance()
    var pattern = -1
    if self.at(左圆):
        pattern = self.parseParenExpr()
    elif self.at(标识符):
        let token: Token = self.current()
        self.advance()
        pattern = self.newExpr(式标识符, token.start, token.end)
        self.setExprName(pattern, token.nameStart, token.nameEnd)
    else:
        self.report("E2-007", "缺少变量名")
        self.recover()
        return -1
    var typeId = -1
    if self.at(冒号):
        self.advance()
        typeId = self.parseType()
    var init = -1
    if self.at(赋值):
        self.advance()
        init = self.parseExpression(1)
    if topLevel:
        let id: I32 = self.newDecl(项变量, start, self.previousEnd())
        self.setDeclName(id, self.ast.exprAt(pattern).nameStart, self.ast.exprAt(pattern).nameEnd)
        self.setDeclType(id, typeId)
        if init >= 0:
            self.pushDeclKid(id, init)
        self.setDeclMutable(id, kindTag(keyword) == kindTag(变量))
        return id
    let id: I32 = self.newStmt(句变量, start, self.previousEnd())
    self.setStmtOp(id, keyword)
    self.setStmtType(id, typeId)
    self.pushStmtKid(id, pattern)
    self.pushStmtKid(id, init)
    return id
; 如果语句：`if` / `elif` / `else` 三段，子块各自缩进。
parseIf|self() -> (I32,):
    let start: I32 = self.current().start
    let id: I32 = self.newStmt(句如果, start, start)
    self.advance()
    let cond: I32 = self.parseExpression(1)
    if !self.expect(冒号, "`:`"):
        self.recover()
        return id
    let thenBlock: I32 = self.parseIndentedBlock()
    self.pushStmtKid(id, cond)
    self.pushStmtKid(id, thenBlock)
    var parsing = true
    while parsing && !self.atEnd():
        if self.at(否则如果):
            self.advance()
            let elifCond: I32 = self.parseExpression(1)
            if !self.expect(冒号, "`:`"):
                self.recover()
                parsing = false
            else:
                let elifBlock: I32 = self.parseIndentedBlock()
                self.pushStmtKid(id, elifCond)
                self.pushStmtKid(id, elifBlock)
        elif self.at(否则):
            self.advance()
            self.expect(冒号, "`:`")
            let elseBlock: I32 = self.parseIndentedBlock()
            self.pushStmtKid(id, elseBlock)
            parsing = false
        else:
            parsing = false
    self.setStmtEnd(id, self.previousEnd())
    return id
; 循环语句：条件块后可选 `step:`，其块每轮末尾执行。
parseWhile|self() -> (I32,):
    let start: I32 = self.current().start
    let id: I32 = self.newStmt(句循环, start, start)
    self.advance()
    let cond: I32 = self.parseExpression(1)
    if !self.expect(冒号, "`:`"):
        self.recover()
        return id
    let body: I32 = self.parseIndentedBlock()
    var stepBlock = -1
    if self.at(步):
        self.advance()
        self.expect(冒号, "`:`")
        stepBlock = self.parseIndentedBlock()
    self.pushStmtKid(id, cond)
    self.pushStmtKid(id, body)
    self.pushStmtKid(id, stepBlock)
    return id
; 遍历语句：`for (模式,) in 表达式:` 后接块与可选 `step:`。
parseFor|self() -> (I32,):
    let start: I32 = self.current().start
    let id = self.newStmt(句遍历, start, start)
    self.advance()
    var pattern = -1
    if self.at(左圆):
        pattern = self.parseParenExpr()
    elif self.at(标识符):
        let token: Token = self.current()
        self.advance()
        pattern = self.newExpr(式标识符, token.start, token.end)
        self.setExprName(pattern, token.nameStart, token.nameEnd)
    else:
        self.report("E2-007", "缺少遍历模式")
    if !self.expect(在, "`in`"):
        self.recover()
        return id
    let iter: I32 = self.parseExpression(1)
    if !self.expect(冒号, "`:`"):
        self.recover()
        return id
    let body: I32 = self.parseIndentedBlock()
    var stepBlock = -1
    if self.at(步):
        self.advance()
        self.expect(冒号, "`:`")
        stepBlock = self.parseIndentedBlock()
    self.setStmtEnd(id, self.previousEnd())
    self.pushStmtKid(id, pattern)
    self.pushStmtKid(id, iter)
    self.pushStmtKid(id, body)
    self.pushStmtKid(id, stepBlock)
    return id
; 匹配语句：主题后接缩进块，块内逐条 `case 模式:` 子块。
parseMatch|self() -> (I32,):
    let start: I32 = self.current().start
    let id = self.newStmt(句匹配, start, start)
    self.advance()
    let subject: I32 = self.parseExpression(1)
    if !self.expect(冒号, "`:`"):
        self.recover()
        return id
    if !self.at(换行):
        self.report("E2-009", "缺少块体")
        return id
    self.advance()
    if !self.at(缩进):
        self.report("E2-003", "缺少缩进")
        return id
    self.advance()
    self.pushStmtKid(id, subject)
    self.skipNewlines()
    while self.at(分支) && !self.atEnd():
        self.advance()
        let pattern: I32 = self.parsePattern()
        if !self.expect(冒号, "`:`"):
            self.recover()
        else:
            let block: I32 = self.parseIndentedBlock()
            self.pushStmtKid(id, pattern)
            self.pushStmtKid(id, block)
        self.skipNewlines()
    if self.at(反缩进):
        self.advance()
    self.setStmtEnd(id, self.previousEnd())
    return id
; 模式：枚举项可带具名绑定 `case 甲(x: v):`，其余按普通表达式读。
parsePattern|self() -> (I32,):
    if self.at(标识符) && self.isKindAt(1, 左圆):
        let token: Token = self.current()
        self.advance()
        self.advance()
        let id: I32 = self.newExpr(式枚举项, token.start, token.end)
        self.setExprName(id, token.nameStart, token.nameEnd)
        while !self.at(右圆) && !self.atEnd():
            if self.at(标识符) && self.isKindAt(1, 冒号):
                self.advance()
                self.advance()
                if self.at(标识符):
                    let bind = self.current()
                    self.advance()
                    let binding: I32 = self.newExpr(式标识符, bind.start, bind.end)
                    self.setExprName(binding, bind.nameStart, bind.nameEnd)
                    self.pushExprKid(id, binding)
            else:
                self.advance()
            if self.at(逗号):
                self.advance()
        self.expect(右圆, "`)`")
        self.setExprEnd(id, self.previousEnd())
        return id
    return self.parseExpression(1)
; 返回语句：无值返回与带值返回同形，缺省值答 -1。
parseReturn|self() -> (I32,):
    let start: I32 = self.current().start
    self.advance()
    var value = -1
    if !self.at(换行) && !self.at(反缩进) && !self.atEnd():
        value = self.parseExpression(1)
    let id: I32 = self.newStmt(句返回, start, self.previousEnd())
    self.pushStmtKid(id, value)
    return id
; 跳出语句：可带标签，标签按标识符表达式登记。
parseBreak|self() -> (I32,):
    let start: I32 = self.current().start
    self.advance()
    var label = -1
    if self.at(标识符):
        let token: Token = self.current()
        self.advance()
        label = self.newExpr(式标识符, token.start, token.end)
        self.setExprName(label, token.nameStart, token.nameEnd)
    let id: I32 = self.newStmt(句跳出, start, self.previousEnd())
    self.pushStmtKid(id, label)
    return id
; 表达式语句：先读表达式，紧跟赋值运算符时改记赋值语句。
parseExprStatement|self() -> (I32,):
    let start: I32 = self.current().start
    let expr: I32 = self.parseExpression(1)
    if expr < 0:
        self.recover()
        return -1
    let kind: TokenKind = self.current().kind
    if isAssignOp(kind):
        self.advance()
        let value: I32 = self.parseExpression(1)
        let id: I32 = self.newStmt(句赋值, start, self.previousEnd())
        self.setStmtOp(id, kind)
        self.pushStmtKid(id, expr)
        self.pushStmtKid(id, value)
        return id
    let id: I32 = self.newStmt(句表达式, start, self.ast.exprAt(expr).end)
    self.pushStmtKid(id, expr)
    return id
; 赋值运算符判定：简单赋值与十一类复合赋值。
previousEnd|self() -> (I32,):
    if self.pos == 0:
        return 0
    return self.tokens[self.pos - 1].end

((Parser))
; 节点构造：类别加上跨度，字段由调用方补齐。
newType|self(kind: TypeKind, start: I32, end: I32,) -> (I32,):
    return self.ast.pushType(kind, start, end)
newExpr|self(kind: ExprKind, start: I32, end: I32,) -> (I32,):
    return self.ast.pushExpr(kind, start, end)
newStmt|self(kind: StmtKind, start: I32, end: I32,) -> (I32,):
    return self.ast.pushStmt(kind, start, end)
newDecl|self(kind: DeclKind, start: I32, end: I32,) -> (I32,):
    return self.ast.pushDecl(kind, start, end)
; 字段写入：先取节点、改字段、再整体写回，避免按下标直接改字段。
setTypeName|self(id: I32, start: I32, end: I32,) -> ():
    var node = self.ast.types[id]
    node.nameStart = start
    node.nameEnd = end
    self.ast.types[id] = node
    return
setTypeKids|self(id: I32, kids: Array<I32>,) -> ():
    var node = self.ast.types[id]
    node.kids = kids
    self.ast.types[id] = node
    return
pushTypeKid|self(id: I32, kid: I32,) -> ():
    var node = self.ast.types[id]
    node.kids = node.kids.append(kid)
    self.ast.types[id] = node
    return
setExprName|self(id: I32, start: I32, end: I32,) -> ():
    var node = self.ast.exprs[id]
    node.nameStart = start
    node.nameEnd = end
    self.ast.exprs[id] = node
    return
setExprOp|self(id: I32, op: TokenKind,) -> ():
    var node = self.ast.exprs[id]
    node.op = kindTag(op)
    self.ast.exprs[id] = node
    return
setExprKids|self(id: I32, kids: Array<I32>,) -> ():
    var node = self.ast.exprs[id]
    node.kids = kids
    self.ast.exprs[id] = node
    return
pushExprKid|self(id: I32, kid: I32,) -> ():
    var node = self.ast.exprs[id]
    node.kids = node.kids.append(kid)
    self.ast.exprs[id] = node
    return
setStmtOp|self(id: I32, op: TokenKind,) -> ():
    var node = self.ast.stmts[id]
    node.op = kindTag(op)
    self.ast.stmts[id] = node
    return
setStmtKids|self(id: I32, kids: Array<I32>,) -> ():
    var node = self.ast.stmts[id]
    node.kids = kids
    self.ast.stmts[id] = node
    return
pushStmtKid|self(id: I32, kid: I32,) -> ():
    var node = self.ast.stmts[id]
    node.kids = node.kids.append(kid)
    self.ast.stmts[id] = node
    return
setDeclName|self(id: I32, start: I32, end: I32,) -> ():
    var node = self.ast.decls[id]
    node.nameStart = start
    node.nameEnd = end
    self.ast.decls[id] = node
    return
setDeclType|self(id: I32, typeId: I32,) -> ():
    var node = self.ast.decls[id]
    node.typeId = typeId
    self.ast.decls[id] = node
    return
setDeclBody|self(id: I32, body: I32,) -> ():
    var node = self.ast.decls[id]
    node.body = body
    self.ast.decls[id] = node
    return
setDeclKids|self(id: I32, kids: Array<I32>,) -> ():
    var node = self.ast.decls[id]
    node.kids = kids
    self.ast.decls[id] = node
    return
pushDeclKid|self(id: I32, kid: I32,) -> ():
    var node = self.ast.decls[id]
    node.kids = node.kids.append(kid)
    self.ast.decls[id] = node
    return
; 函数修饰写回：测试、方法与外部声明各自一位。
setFunctionMarks|self(id: I32, isTest: Bool, isSelf: Bool, isForeign: Bool,) -> ():
    var node = self.ast.decls[id]
    node.isTest = isTest
    node.isSelf = isSelf
    node.isForeign = isForeign
    self.ast.decls[id] = node
    return
; 参数前缀写回：own / using / self 三者互斥。
setParamMarks|self(id: I32, isOwn: Bool, isUsing: Bool, isSelf: Bool,) -> ():
    var node = self.ast.decls[id]
    node.isOwn = isOwn
    node.isUsing = isUsing
    node.isSelf = isSelf
    self.ast.decls[id] = node
    return
setDeclMutable|self(id: I32, value: Bool,) -> ():
    var node = self.ast.decls[id]
    node.mutable = value
    self.ast.decls[id] = node
    return
setTypeRet|self(id: I32, ret: I32,) -> ():
    var node = self.ast.types[id]
    node.ret = ret
    self.ast.types[id] = node
    return
setExprEnd|self(id: I32, end: I32,) -> ():
    var node = self.ast.exprs[id]
    node.end = end
    self.ast.exprs[id] = node
    return
setStmtType|self(id: I32, typeId: I32,) -> ():
    var node = self.ast.stmts[id]
    node.typeId = typeId
    self.ast.stmts[id] = node
    return
setStmtEnd|self(id: I32, end: I32,) -> ():
    var node = self.ast.stmts[id]
    node.end = end
    self.ast.stmts[id] = node
    return
