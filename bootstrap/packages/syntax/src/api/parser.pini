[parser|import]
_diagnostics = "../../../diagnostics"

; 解析状态：记号游标、节点池与诊断序列；所有推进都经由本文件的方法。
; `bytes` 与词法共用同一份归一化源，上下文关键字比对与插值取段都读它；
; `language` 只供插值段补扫时沿用同一套关键字表。
(Parser)
tokens: Array<Token> = []
pos: I32 = 0
total: I32 = 0
file: String = ""
language: KeywordLanguage = .langEnglish
bytes: Array<U8> = []
ast: Ast = Ast()
segments: Array<Segment> = []
diagnostics: Array<Diagnostic> = []

; 解析结果：树、语法诊断与词法问题分列；问题不参与语法判定。
(ParseResult)
ast: Ast = Ast()
segments: Array<Segment> = []
diagnostics: Array<Diagnostic> = []
issues: Array<LexIssue> = []

; 解析文本：默认按英文关键字；文件名留空，位置映射由调用方补。
parseText|func(_text: String,) -> (ParseResult,):
    return parseFile(text = _text, file = "")

; 解析文本并登记文件名：诊断里的文件名即此参数。
parseFile|func(text: String, file: String,) -> (ParseResult,):
    return parseFileIn(language = .langEnglish, text = text, file = file)

; 按指定关键字语言解析文本；关键字语言只影响词法分类，语法层只认类别。
parseTextIn|func(language: KeywordLanguage, text: String,) -> (ParseResult,):
    return parseFileIn(language = language, text = text, file = "")

; 按指定关键字语言解析并登记文件名。
parseFileIn|func(language: KeywordLanguage, text: String, file: String,) -> (ParseResult,):
    let lexed = lexTextIn(language = language, text = text)
    var p = Parser()
    p.tokens = lexed.tokens
    p.total = len(lexed.tokens)
    p.file = file
    p.language = language
    p.bytes = lexed.bytes
    p.segments = lexed.segments
    p.parseModule()
    var out = ParseResult()
    out.ast = p.ast
    out.segments = lexed.segments
    out.diagnostics = p.diagnostics
    out.issues = lexed.issues
    return out

binaryPrecedence|func(_kind: TokenKind,) -> (I32,):
    let tag: I32 = kindTag(_kind)
    if tag == kindTag(.opOr):
        return 1
    if tag == kindTag(.opAnd):
        return 2
    if tag == kindTag(.opEq) || tag == kindTag(.opNe):
        return 3
    if tag == kindTag(.opLt) || tag == kindTag(.opGt) || tag == kindTag(.opLe) || tag == kindTag(.opGe):
        return 4
    if tag == kindTag(.opBitAnd) || tag == kindTag(.opBitOr) || tag == kindTag(.opBitXor) || tag == kindTag(.opShl) || tag == kindTag(.opShr):
        return 5
    if tag == kindTag(.opAdd) || tag == kindTag(.opSub):
        return 6
    if tag == kindTag(.opMul) || tag == kindTag(.opDiv) || tag == kindTag(.opMod):
        return 7
    return 0

; 一元前缀：`-` `+` `!` `~` `^` `&` `++` `--` 右结合。
isUnaryKind|func(_kind: TokenKind,) -> (Bool,):
    let tag: I32 = kindTag(_kind)
    if tag == kindTag(.opSub) || tag == kindTag(.opAdd) || tag == kindTag(.opNot):
        return true
    if tag == kindTag(.opBitNot) || tag == kindTag(.opBitXor) || tag == kindTag(.opBitAnd):
        return true
    return tag == kindTag(.opInc) || tag == kindTag(.opDec)

isAssignOp|func(_kind: TokenKind,) -> (Bool,):
    let tag: I32 = kindTag(_kind)
    if tag == kindTag(.opAssign):
        return true
    return tag >= kindTag(.opAssignAdd) && tag <= kindTag(.opAssignShr)

; 上一条记号的终点：新节点收尾时用作跨度终点。
((Parser))
; 当前记号：越界答结束记号，循环判界靠 `atEnd`。
current|self() -> (Token,):
    if self.pos >= self.total:
        var token = Token()
        token.kind = .eof
        token.tag = kindTag(.eof)
        return token
    return self.tokens[self.pos]
; 前瞻第 n 条记号：越界一律答结束，调用方无需重复判界。
kindAt|self(_offset: I32,) -> (TokenKind,):
    let index = self.pos + _offset
    if index < 0 || index >= self.total:
        return .eof
    return self.tokens[index].kind
atEnd|self() -> (Bool,):
    if self.pos >= self.total:
        return true
    return self.tokens[self.pos].tag == kindTag(.eof)
at|self(_kind: TokenKind,) -> (Bool,):
    if self.pos >= self.total:
        return kindTag(.eof) == kindTag(_kind)
    return self.tokens[self.pos].tag == kindTag(_kind)
isKindAt|self(offset: I32, kind: TokenKind,) -> (Bool,):
    let index = self.pos + offset
    if index < 0 || index >= self.total:
        return kindTag(.eof) == kindTag(kind)
    return self.tokens[index].tag == kindTag(kind)
advance|self() -> ():
    if self.pos < self.total:
        self.pos = self.pos + 1
    return
; 上下文关键字：当前记号是标识符且拼写等于给定词；不查关键字表，故它仍可作名字。
isIdentifierWord|self(_word: String,) -> (Bool,):
    let token = self.current()
    if !isKind(token = token, kind = .identifier):
        return false
    return matchesWord(bytes = self.bytes, start = token.start, end = token.end, word = _word)
; 前瞻同规：看第 n 条记号是否为给定拼写的标识符。
isWordAt|self(offset: I32, word: String,) -> (Bool,):
    let index = self.pos + offset
    if index < 0 || index >= self.total:
        return false
    let token = self.tokens[index]
    if !isKind(token = token, kind = .identifier):
        return false
    return matchesWord(bytes = self.bytes, start = token.start, end = token.end, word = word)
; 跳过行尾：块内语句之间只允许换行。
skipNewlines|self() -> ():
    while self.pos < self.total && self.tokens[self.pos].tag == kindTag(.newline):
        self.pos = self.pos + 1
    return
; 缩进体开头：跳换行与块缩进；没有缩进即空体，按空块继续。
; 声明体的解析器（字段、变体、方法）各自只读「块内行」，开闭由调用方成对处理。
openIndentedBody|self() -> ():
    self.skipNewlines()
    if self.at(.indent):
        self.advance()
        self.skipNewlines()
    return
; 缩进体收尾：块末的反缩进一并吃掉，外层继续按顶级声明或语句读。
closeIndentedBody|self() -> ():
    self.skipNewlines()
    if self.at(.dedent):
        self.advance()
    return
; 报一条语法诊断：跨度为当前记号；到达文件末尾时改用上一条记号的终点。
report|self(code: String, message: String,) -> ():
    var start = self.current().start
    var end = self.current().end
    if self.atEnd() && self.pos > 0:
        start = self.tokens[self.pos - 1].end
        end = start
    var d = makeDiagnostic(file = self.file, category = syntaxCategory(), severity = errorSeverity(), code = code, message = message)
    d = d.addLabel(makeLabel(start = start, end = end, message = message, primary = true))
    self.diagnostics = self.diagnostics.append(d)
    return
; 期望某类记号：命中即消费并答真，否则记 E2-001 并答假。
expect|self(kind: TokenKind, what: String,) -> (Bool,):
    if self.at(kind):
        self.advance()
        return true
    self.report(code = "E2-001", message = "期望" + what + "，实际得到" + kindName(self.current().kind))
    return false
; 错误恢复：跳到行尾或块边界，保证每次失败至少前进一条记号。
recover|self() -> ():
    if self.atEnd():
        return
    while !self.atEnd() && !self.at(.newline) && !self.at(.dedent):
        self.advance()
    if self.at(.newline):
        self.advance()
    return
; 模块：逐条顶级声明；某条解析不动就恢复，避免原地打转。
parseModule|self() -> ():
    self.skipNewlines()
    while !self.atEnd():
        let before = self.pos
        self.parseTopLevel()
        if self.pos == before:
            self.report(code = "E2-005", message = "无效的顶级声明")
            self.advance()
        self.skipNewlines()
    return
; 顶级分派：行首记号决定声明种类，其余按名字后的竖线区分函数与变量。
parseTopLevel|self() -> ():
    if self.at(.opLt) || self.at(.opShl):
        let id: I32 = self.parseAngleDecl()
        if id >= 0:
            self.ast.addItem(id)
        return
    if self.at(.leftBracket):
        let id: I32 = self.parseBracketDecl()
        if id >= 0:
            self.ast.addItem(id)
        return
    if self.at(.leftParen):
        let id: I32 = self.parseParenDecl()
        if id >= 0:
            self.ast.addItem(id)
        return
    if self.at(.leftBrace):
        let id: I32 = self.parseBraceDecl()
        if id >= 0:
            self.ast.addItem(id)
        return
    if self.at(.identifier) && self.isKindAt(offset = 1, kind = .opBitOr):
        let id = self.parseFunctionDecl()
        if id >= 0:
            self.ast.addItem(id)
        return
    if self.at(.identifier) && self.isKindAt(offset = 1, kind = .leftParen):
        let bare = self.parseFunctionDecl()
        if bare >= 0:
            self.ast.addItem(bare)
        return
    self.report(code = "E2-005", message = "无效的顶级声明")
    self.recover()
    return
; 尖括号声明：`<名>` 特征声明与 `<<名>>` 特征扩展；体是签名或带默认实现的方法。
parseAngleDecl|self() -> (I32,):
    let start: I32 = self.current().start
    if self.at(.opShl):
        self.advance()
        let nameStart: I32 = self.current().nameStart
        let nameEnd: I32 = self.current().nameEnd
        if !self.expect(kind = .identifier, what = "特征名"):
            self.recover()
            return -1
        let hadGenerics: Bool = self.at(.opLt)
        let generics: Array<I32> = self.parseGenericParamItems()
        if hadGenerics && self.at(.opShr):
            self.advance()
            self.expect(kind = .opGt, what = "`>`")
        else:
            if hadGenerics && self.at(.opGt):
                self.advance()
            self.closeTraitHeader()
        let id: I32 = self.newDecl(kind = .declTraitExtension, start = start, end = self.previousEnd())
        self.setDeclName(id = id, start = nameStart, end = nameEnd)
        self.setDeclGeneric(id = id, kids = generics)
        self.setDeclKids(id = id, kids = self.parseTraitBody(true))
        return id
    self.advance()
    let nameStart: I32 = self.current().nameStart
    let nameEnd: I32 = self.current().nameEnd
    if !self.expect(kind = .identifier, what = "特征名"):
        self.recover()
        return -1
    let generics: Array<I32> = self.parseGenericParams()
    if self.at(.opShr):
        self.advance()
    else:
        if !self.expect(kind = .opGt, what = "`>`"):
            self.recover()
            return -1
    let id: I32 = self.newDecl(kind = .declTrait, start = start, end = self.previousEnd())
    self.setDeclName(id = id, start = nameStart, end = nameEnd)
    self.setDeclGeneric(id = id, kids = generics)
    self.setDeclKids(id = id, kids = self.parseTraitBody(false))
    return id
; 特征扩展头收尾：`>>` 可能并成一条右移记号，也可能是两条大于号。
closeTraitHeader|self() -> ():
    if self.at(.opShr):
        self.advance()
        return
    self.expect(kind = .opGt, what = "`>`")
    self.expect(kind = .opGt, what = "`>`")
    return
; 特征体：变量签名、抽象方法签名与带默认实现的方法三种；遇到下一个顶级声明收尾。
parseTraitBody|self(_isExtension: Bool,) -> (Array<I32>,):
    var entries: Array<I32> = []
    self.openIndentedBody()
    while !self.atEnd():
        if self.at(.identifier) && self.isKindAt(offset = 1, kind = .colon):
            let fields: Array<I32> = self.parseFieldLines()
            var i = 0
            while i < len(fields):
                entries = entries.append(fields[i])
                i = i + 1
            continue
        if self.at(.leftBrace) && self.isKindAt(offset = 1, kind = .identifier) && self.isKindAt(offset = 2, kind = .rightBrace) && self.isKindAt(offset = 3, kind = .leftParen):
            entries = entries.append(self.parseBraceTraitSignature())
            self.skipNewlines()
            continue
        if self.at(.identifier) && self.isKindAt(offset = 1, kind = .opBitOr) && (self.isKindAt(offset = 2, kind = .kwFunc) || self.isKindAt(offset = 2, kind = .kwTest) || self.isKindAt(offset = 2, kind = .kwForeign)):
            break
        if self.at(.identifier) && self.isKindAt(offset = 1, kind = .opBitOr):
            entries = entries.append(self.parseTraitSignature())
            self.skipNewlines()
            continue
        if self.at(.identifier) && self.isKindAt(offset = 1, kind = .leftParen):
            entries = entries.append(self.parseTraitSignature())
            self.skipNewlines()
            continue
        break
    self.closeIndentedBody()
    return entries
; `{名}(参数,) -> (返回,)` 形态的抽象签名：先吃花括号名，再走共用签名尾巴。
parseBraceTraitSignature|self() -> (I32,):
    let start: I32 = self.current().start
    self.advance()
    let nameStart: I32 = self.current().nameStart
    let nameEnd: I32 = self.current().nameEnd
    self.advance()
    self.advance()
    return self.finishTraitSignature(start = start, nameStart = nameStart, nameEnd = nameEnd)
; 特征方法签名：名字后接可选 `|修饰符`、参数与返回；带冒号即默认实现，落块体。
parseTraitSignature|self() -> (I32,):
    let start: I32 = self.current().start
    let nameStart: I32 = self.current().nameStart
    let nameEnd: I32 = self.current().nameEnd
    self.advance()
    return self.finishTraitSignature(start = start, nameStart = nameStart, nameEnd = nameEnd)
; 签名尾巴：修饰符、参数、返回类型与可选体；无体时 body 留 -1。
finishTraitSignature|self(start: I32, nameStart: I32, nameEnd: I32,) -> (I32,):
    var isFunc = false
    var isSelf = false
    var isOwn = false
    var isForeign = false
    var isUnsafe = false
    if self.at(.opBitOr):
        self.advance()
        if self.at(.kwSelf):
            isSelf = true
            self.advance()
        elif self.at(.kwOwn):
            isOwn = true
            self.advance()
        elif self.at(.kwForeign):
            isForeign = true
            self.advance()
        elif self.at(.kwUnsafe):
            isUnsafe = true
            self.advance()
        elif self.at(.kwFunc):
            isFunc = true
            self.advance()
        else:
            self.report(code = "E2-001", message = "期望特征方法的修饰符")
    var params: Array<I32> = []
    if self.at(.leftParen):
        params = self.parseParams()
    var returnType = -1
    if self.at(.arrow):
        self.advance()
        returnType = self.collapseReturn(self.parseType())
    var body = -1
    if self.at(.colon):
        self.advance()
        if self.at(.newline):
            body = self.parseIndentedBlock()
        else:
            body = self.parseInlineBlock()
    let id: I32 = self.newDecl(kind = .declFunction, start = start, end = self.previousEnd())
    self.setDeclName(id = id, start = nameStart, end = nameEnd)
    self.setDeclKids(id = id, kids = params)
    self.setDeclType(id = id, typeId = returnType)
    self.setDeclBody(id = id, body = body)
    self.setFunctionMarks(id = id, isTest = false, isSelf = isSelf, isOwn = isOwn, isForeign = isForeign, isUnsafe = isUnsafe)
    self.setDeclFuncMark(id = id, value = isFunc)
    return id
; 块名：导入、导出、外部与给定块的头名取文件名，可与关键字同形（`foreign.pini` 即 `[foreign|import]`）。
; 只放行名字这一格，`|` 之后的修饰符仍按词判定；非标识符且非关键字照旧报错。
acceptBlockName|self(what: String,) -> (Bool,):
    if self.at(.identifier) || isKeywordKind(self.current().kind):
        self.advance()
        return true
    self.report(code = "E2-001", message = "期望" + what + "，实际得到" + kindName(self.current().kind))
    return false
; 方括号声明：`[名|import]`、`[名|export]`、`[名|foreign]`、`[名|given]`、`[名|object]`、
; `[名]` 枚举与 `[[名]]` 扩展；名字后可带类型形参表，修饰符按词区分。
parseBracketDecl|self() -> (I32,):
    let start: I32 = self.current().start
    if self.isKindAt(offset = 1, kind = .leftBracket):
        self.advance()
        self.advance()
        let nameStart: I32 = self.current().nameStart
        let nameEnd: I32 = self.current().nameEnd
        if !self.expect(kind = .identifier, what = "扩展目标名"):
            self.recover()
            return -1
        let generics: Array<I32> = self.parseGenericParams()
        self.expect(kind = .rightBracket, what = "`]]`")
        self.expect(kind = .rightBracket, what = "`]]`")
        let id: I32 = self.newDecl(kind = .declExtension, start = start, end = self.previousEnd())
        self.setDeclName(id = id, start = nameStart, end = nameEnd)
        self.setDeclGeneric(id = id, kids = generics)
        self.setDeclKids(id = id, kids = self.parseMethodBlock())
        return id
    self.advance()
    let nameStart: I32 = self.current().nameStart
    let nameEnd: I32 = self.current().nameEnd
    if !self.acceptBlockName(what = "声明名"):
        self.recover()
        return -1
    let generics: Array<I32> = self.parseGenericParams()
    var modifier = 0
    if self.at(.opBitOr):
        self.advance()
        if self.at(.kwImport):
            self.advance()
            self.expect(kind = .rightBracket, what = "`]`")
            return self.parseImportBody(start = start, nameStart = nameStart, nameEnd = nameEnd)
        if self.at(.kwForeign):
            self.advance()
            self.expect(kind = .rightBracket, what = "`]`")
            return self.parseForeignBody(start = start, nameStart = nameStart, nameEnd = nameEnd)
        if self.at(.kwExport):
            self.advance()
            self.expect(kind = .rightBracket, what = "`]`")
            return self.parseExportBody(start = start, nameStart = nameStart, nameEnd = nameEnd)
        if self.isIdentifierWord("given"):
            self.advance()
            modifier = 1
        elif self.at(.kwObject):
            self.advance()
            modifier = 2
        elif self.at(.kwEnum):
            self.advance()
            modifier = 3
        else:
            self.report(code = "E2-005", message = "无效的方括号声明修饰符")
            self.recover()
            return -1
    if !self.expect(kind = .rightBracket, what = "`]`"):
        self.recover()
        return -1
    if modifier == 1:
        let 给定节点: I32 = self.newDecl(kind = .declGiven, start = start, end = self.previousEnd())
        self.setDeclName(id = 给定节点, start = nameStart, end = nameEnd)
        self.setDeclGeneric(id = 给定节点, kids = generics)
        self.setDeclKids(id = 给定节点, kids = self.parseFieldBlock())
        return 给定节点
    if modifier == 2:
        let 对象节点: I32 = self.newDecl(kind = .declObject, start = start, end = self.previousEnd())
        self.setDeclName(id = 对象节点, start = nameStart, end = nameEnd)
        self.setDeclGeneric(id = 对象节点, kids = generics)
        self.setDeclKids(id = 对象节点, kids = self.parseFieldBlock())
        return 对象节点
    let id: I32 = self.newDecl(kind = .declEnum, start = start, end = self.previousEnd())
    self.setDeclName(id = id, start = nameStart, end = nameEnd)
    self.setDeclGeneric(id = id, kids = generics)
    self.setDeclKids(id = id, kids = self.parseVariantBlock())
    return id
; 导入体：`[名|import]` 的 `]` 已被消费；条目形如 `别名 = "包路径"`，遇到非条目行即收尾。
parseImportBody|self(start: I32, nameStart: I32, nameEnd: I32,) -> (I32,):
    let id: I32 = self.newDecl(kind = .declImportBlock, start = start, end = self.previousEnd())
    self.setDeclName(id = id, start = nameStart, end = nameEnd)
    var entries: Array<I32> = []
    self.skipNewlines()
    while self.at(.identifier) && self.isKindAt(offset = 1, kind = .opAssign):
        let entryStart: I32 = self.current().start
        let aliasStart: I32 = self.current().nameStart
        let aliasEnd: I32 = self.current().nameEnd
        self.advance()
        self.advance()
        if self.at(.string):
            let path: I32 = self.parsePrimary()
            let entry: I32 = self.newDecl(kind = .declImportEntry, start = entryStart, end = self.previousEnd())
            self.setDeclName(id = entry, start = aliasStart, end = aliasEnd)
            self.pushDeclKid(id = entry, kid = path)
            entries = entries.append(entry)
            self.advance()
        else:
            self.report(code = "E2-001", message = "期望包路径字符串")
            self.recover()
        self.skipNewlines()
    self.setDeclKids(id = id, kids = entries)
    return id
; 导出体：`[文件|export]` 的 `]` 已被消费；条目写 `名 = 符号` 或 `名|目标 = 符号`，缺省目标不落节点。
parseExportBody|self(start: I32, nameStart: I32, nameEnd: I32,) -> (I32,):
    let id: I32 = self.newDecl(kind = .declExportBlock, start = start, end = self.previousEnd())
    self.setDeclName(id = id, start = nameStart, end = nameEnd)
    var entries: Array<I32> = []
    self.skipNewlines()
    while self.at(.identifier):
        let hasTarget: Bool = self.isKindAt(offset = 1, kind = .opBitOr) && self.isKindAt(offset = 2, kind = .identifier) && self.isKindAt(offset = 3, kind = .opAssign)
        if !self.isKindAt(offset = 1, kind = .opAssign) && !hasTarget:
            break
        let entryStart: I32 = self.current().start
        let entryNameStart: I32 = self.current().nameStart
        let entryNameEnd: I32 = self.current().nameEnd
        self.advance()
        var target = -1
        if hasTarget:
            self.advance()
            let targetStart: I32 = self.current().nameStart
            let targetEnd: I32 = self.current().nameEnd
            self.advance()
            target = self.newDecl(kind = .declExportTarget, start = targetStart, end = targetEnd)
            self.setDeclName(id = target, start = targetStart, end = targetEnd)
        if !self.expect(kind = .opAssign, what = "`=`"):
            self.recover()
            continue
        var symbol = -1
        if self.at(.identifier):
            let token = self.current()
            self.advance()
            symbol = self.newExpr(kind = .exprIdentifier, start = token.start, end = token.end)
