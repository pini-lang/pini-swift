; 关键字语言：词法入口按它选词表。英文是默认语言，中文只在调用处显式指定时生效。
[KeywordLanguage]
langEnglish
langChinese

; 语言码：只用于比较与分流，不依赖枚举相等。
languageTag|func(_language: KeywordLanguage,) -> (I32,):
    match _language:
        case langEnglish:
            return 0
        case langChinese:
            return 1
    return 0

; 语言名：诊断与测试用的可读名。
languageName|func(_language: KeywordLanguage,) -> (String,):
    if languageTag(_language) == 1:
        return "中文"
    return "英文"

; 关键字词表：下标即关键字类别区的序号，两种语言同序，靠 `kindFromTag(8 + 下标)` 得类别。
keywordWords|func(_language: KeywordLanguage,) -> (Array<String>,):
    if languageTag(_language) == 1:
        return [
            "变量",
            "常量",
            "函数",
            "枚举",
            "对象",
            "如果",
            "否则如果",
            "否则",
            "匹配",
            "分支",
            "循环",
            "步",
            "遍历",
            "在",
            "尝试",
            "返回",
            "跳出",
            "继续",
            "自身",
            "自有",
            "延迟",
            "导入",
            "导出",
            "空",
            "捕获",
            "等待",
            "稍候",
            "不安全",
            "测试",
            "外部",
            "分离",
            "通过",
            "使用",
            "展开",
            "弱引用",
        ]
    return [
        "var",
        "let",
        "func",
        "enum",
        "object",
        "if",
        "elif",
        "else",
        "match",
        "case",
        "while",
        "step",
        "for",
        "in",
        "try",
        "return",
        "break",
        "continue",
        "self",
        "own",
        "defer",
        "import",
        "export",
        "nil",
        "capture",
        "await",
        "wait",
        "unsafe",
        "test",
        "foreign",
        "detach",
        "pass",
        "using",
        "unroll",
        "weak",
    ]

; 关键字表：按语言把词表摊平成一块字节池；第 i 个词落在 starts[i] 起、宽 widths[i] 处。
; 词法入口建一次并随状态传递，比对只读字节，不再逐词物化字符串。
(KeywordTable)
bytes: Array<U8> = []
starts: Array<I32> = []
widths: Array<I32> = []

makeKeywordTable|func(_language: KeywordLanguage,) -> (KeywordTable,):
    let words = keywordWords(_language)
    var table = KeywordTable()
    var i = 0
    while i < len(words):
        let word = tempUtf8Bytes(words[i])
        table.starts = table.starts.append(len(table.bytes))
        table.widths = table.widths.append(len(word))
        var j = 0
        while j < len(word):
            table.bytes = table.bytes.append(word[j])
            j = j + 1
        i = i + 1
    return table

; 关键字匹配：按语言建表再判；逐词法入口复用已建好的表。
keywordKind|func(language: KeywordLanguage, bytes: Array<U8>, start: I32, end: I32,) -> (TokenKind,):
    return keywordKindIn(table = makeKeywordTable(language), bytes = bytes, start = start, end = end)

; 关键字判定：真假字面量按字长先行剪枝，其余按词表序比对，命中即得类别码。
keywordKindIn|func(table: KeywordTable, bytes: Array<U8>, start: I32, end: I32,) -> (TokenKind,):
    let width = end - start
    if width == 4 && matchesWord(bytes = bytes, start = start, end = end, word = "true"):
        return .trueLiteral
    if width == 5 && matchesWord(bytes = bytes, start = start, end = end, word = "false"):
        return .falseLiteral
    var index = 0
    while index < len(table.widths):
        if matchesTableWord(table = table, index = index, bytes = bytes, start = start, end = end):
            ; `weak` 排在词表末位，类别码单独留在布局段之后，故不按 8 + 下标推。
            if index == 34:
                return .kwWeak
            return kindFromTag(8 + index)
        index = index + 1
    return .identifier

; 整词比对：宽度不等先剪掉，再逐字节比。
matchesTableWord|func(table: KeywordTable, index: I32, bytes: Array<U8>, start: I32, end: I32,) -> (Bool,):
    let width = table.widths[index]
    if width != end - start:
        return false
    let base = table.starts[index]
    var i = 0
    while i < width:
        if table.bytes[base + i] != bytes[start + i]:
            return false
        i = i + 1
    return true

; 整词比对：先比字节宽度再逐字节比；词表里的词都是字面量，宽度即其 UTF-8 字节数。
matchesWord|func(bytes: Array<U8>, start: I32, end: I32, word: String,) -> (Bool,):
    let want = tempUtf8Bytes(word)
    if len(want) != end - start:
        return false
    var i = 0
    while i < len(want):
        if bytes[start + i] != want[i]:
            return false
        i = i + 1
    return true
