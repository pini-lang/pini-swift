    assert(发射含子串(text = result.text, needle = "@__stdinp = external global ptr"), "应声明标准输入流")
    return

; 外部数据：符号声明随模块走，取址即符号名。
外部数据取址|test() -> ():
    var module = IrModule()
    module.types = 发射造指针池()
    module.texts = ["counter"]
    var row = IrExternData()
    row.name = "counter"
    row.typeId = 0
    module.externData = module.externData.append(row)
    var nodes = IrNodePool()
    var address = irMakeNode(kind = tagOfName(name = "foreignDataAddress"), typeId = 1)
    address.text = 0
    let placedAddress = irAppendNode(pool = nodes, node = address)
    nodes = placedAddress.pool
    var load = irMakeNode(kind = tagOfName(name = "pointerLoad"), typeId = 0)
    load.kids = [placedAddress.id]
    let placedLoad = irAppendNode(pool = nodes, node = load)
    nodes = placedLoad.pool
    var back = irMakeNode(kind = tagOfName(name = "returnStmt"), typeId = -1)
    back.kids = [placedLoad.id]
    let placedBack = irAppendNode(pool = nodes, node = back)
    nodes = placedBack.pool
    module.nodes = nodes
    var fn = IrFunction()
    fn.name = "main"
    fn.returnType = 0
    fn.body = [placedBack.id]
    module.functions = module.functions.append(fn)
    let result = emitModule(entry = 发射造记录(outputCode = 1), target = defaultTarget(), module = module)
    assert(!result.failed, "外部数据模块应发得出来")
    assert(发射含子串(text = result.text, needle = "@counter = external global i32"), "数据声明应随模块出")
    assert(发射含子串(text = result.text, needle = "ptr @counter"), "取址应指向符号本身")
    return

; 闭包间接调用：体挂在节点上，函数条目出定义，调用走 `{ ptr, ptr }` 协议。
闭包间接调用|test() -> ():
    var module = IrModule()
    module.types = 发射造指针池()
    let fnType = irFunctionType(pool = module.types, params = [0], ret = 0, uses = [])
    module.types = fnType.pool
    module.texts = ["__closure_0"]
    var nodes = IrNodePool()
    var loadNode = irMakeNode(kind = tagOfName(name = "load"), typeId = 0)
    loadNode.intValue = 0
    let placedLoad = irAppendNode(pool = nodes, node = loadNode)
    nodes = placedLoad.pool
    var back = irMakeNode(kind = tagOfName(name = "returnStmt"), typeId = -1)
    back.kids = [placedLoad.id]
    let placedBack = irAppendNode(pool = nodes, node = back)
    nodes = placedBack.pool
    var literal = irMakeNode(kind = tagOfName(name = "closureLiteral"), typeId = fnType.id)
    literal.text = 0
    literal.intValue = 0
    literal.kids = [placedBack.id]
    let placedLiteral = irAppendNode(pool = nodes, node = literal)
    nodes = placedLiteral.pool
    var arg = irMakeNode(kind = tagOfName(name = "intConst"), typeId = 0)
    arg.intValue = 4
    let placedArg = irAppendNode(pool = nodes, node = arg)
    nodes = placedArg.pool
    var call = irMakeNode(kind = tagOfName(name = "indirectCall"), typeId = 0)
    call.kids = [placedLiteral.id, placedArg.id]
    let placedCall = irAppendNode(pool = nodes, node = call)
    nodes = placedCall.pool
    var ret = irMakeNode(kind = tagOfName(name = "returnStmt"), typeId = -1)
    ret.kids = [placedCall.id]
    let placedRet = irAppendNode(pool = nodes, node = ret)
    nodes = placedRet.pool
    var fn = IrFunction()
    fn.name = "__closure_0"
    fn.returnType = 0
    fn.isClosure = true
    fn.closureId = 0
    var param = IrParam()
    param.name = "a"
    param.typeId = 0
    param.slot = 0
    fn.params = [param]
    fn.body = [placedBack.id]
    module.functions = module.functions.append(fn)
    var mainFn = IrFunction()
    mainFn.name = "main"
    mainFn.returnType = 0
    mainFn.body = [placedRet.id]
    module.functions = module.functions.append(mainFn)
    module.nodes = nodes
    let result = emitModule(entry = 发射造记录(outputCode = 1), target = defaultTarget(), module = module)
    assert(!result.failed, "闭包模块应发得出来")
    assert(发射含子串(text = result.text, needle = "define i32 @__closure_0(ptr %env, i32 %p0)"), "闭包定义应带 env")
    assert(发射含子串(text = result.text, needle = "call i32 %"), "间接调用应按函数指针发")
    return

; 惰性引用：构造收 wrapper / code / env，取值按元素拼写读盒。
惰性引用发射|test() -> ():
    var module = IrModule()
    var pool = IrTypePool()
    let intType = irScalarTypeOfCode(pool = pool, code = 1, name = "i32")
    pool = intType.pool
    let lazy = irInternType(pool = pool, kind = irTypeClassOf(code = 18), name = "", kids = [0], ret = -1, uses = [], flags = 0)
    pool = lazy.pool
    let fnType = irFunctionType(pool = pool, params = [], ret = 0, uses = [])
    module.types = fnType.pool
    module.texts = ["__closure_1"]
    var nodes = IrNodePool()
    var seven = irMakeNode(kind = tagOfName(name = "intConst"), typeId = 0)
    seven.intValue = 7
    let placedSeven = irAppendNode(pool = nodes, node = seven)
    nodes = placedSeven.pool
    var back = irMakeNode(kind = tagOfName(name = "returnStmt"), typeId = -1)
    back.kids = [placedSeven.id]
    let placedBack = irAppendNode(pool = nodes, node = back)
    nodes = placedBack.pool
    var literal = irMakeNode(kind = tagOfName(name = "closureLiteral"), typeId = fnType.id)
    literal.text = 0
    literal.intValue = 1
    literal.kids = [placedBack.id]
    let placedLiteral = irAppendNode(pool = nodes, node = literal)
    nodes = placedLiteral.pool
    var construct = irMakeNode(kind = tagOfName(name = "lazyRefConstruct"), typeId = lazy.id)
    construct.kids = [placedLiteral.id]
    let placedConstruct = irAppendNode(pool = nodes, node = construct)
    nodes = placedConstruct.pool
    var read = irMakeNode(kind = tagOfName(name = "lazyRefValue"), typeId = 0)
    read.kids = [placedConstruct.id]
    let placedRead = irAppendNode(pool = nodes, node = read)
    nodes = placedRead.pool
    var ret = irMakeNode(kind = tagOfName(name = "returnStmt"), typeId = -1)
    ret.kids = [placedRead.id]
    let placedRet = irAppendNode(pool = nodes, node = ret)
    nodes = placedRet.pool
    var fn = IrFunction()
    fn.name = "__closure_1"
    fn.returnType = 0
    fn.isClosure = true
    fn.closureId = 1
    fn.body = [placedBack.id]
    module.functions = module.functions.append(fn)
    var mainFn = IrFunction()
    mainFn.name = "main"
    mainFn.returnType = 0
    mainFn.body = [placedRet.id]
    module.functions = module.functions.append(mainFn)
    module.nodes = nodes
    let result = emitModule(entry = 发射造记录(outputCode = 1), target = defaultTarget(), module = module)
    assert(!result.failed, "惰性引用模块应发得出来")
    assert(发射含子串(text = result.text, needle = "define ptr @__lazyref_wrapper_i32"), "应出 i32 装箱包装")
    assert(发射含子串(text = result.text, needle = "call ptr @bk_lazyref_create(ptr @__lazyref_wrapper_i32, ptr "), "构造应走运行时入口")
    assert(发射含子串(text = result.text, needle = "call ptr @bk_lazyref_value(ptr "), "取值应走运行时入口")
    return

; 等待：句柄读出来交给运行时段，三槽归一化后按 Result 拼回。
等待发射|test() -> ():
    var module = IrModule()
    var pool = IrTypePool()
    let intType = irScalarTypeOfCode(pool = pool, code = 1, name = "i32")
    pool = intType.pool
    let settled = irInternType(pool = pool, kind = irTypeClassOf(code = 10), name = "", kids = [0], ret = -1, uses = [], flags = 0)
    pool = settled.pool
    let handle = irInternType(pool = pool, kind = irTypeClassOf(code = 11), name = "", kids = [0], ret = -1, uses = [], flags = 0)
    module.types = handle.pool
    var nodes = IrNodePool()
    var alloc = irMakeNode(kind = tagOfName(name = "allocVar"), typeId = handle.id)
    alloc.intValue = 0
    let placedAlloc = irAppendNode(pool = nodes, node = alloc)
    nodes = placedAlloc.pool
    var load = irMakeNode(kind = tagOfName(name = "load"), typeId = handle.id)
    load.intValue = 0
    let placedLoad = irAppendNode(pool = nodes, node = load)
    nodes = placedLoad.pool
    var join = irMakeNode(kind = tagOfName(name = "join"), typeId = settled.id)
    join.op = 1
    join.kids = [placedLoad.id]
    let placedJoin = irAppendNode(pool = nodes, node = join)
    nodes = placedJoin.pool
    var ret = irMakeNode(kind = tagOfName(name = "returnStmt"), typeId = -1)
    ret.kids = [placedJoin.id]
    let placedRet = irAppendNode(pool = nodes, node = ret)
    nodes = placedRet.pool
    module.nodes = nodes
    var fn = IrFunction()
    fn.name = "main"
    fn.returnType = settled.id
    fn.body = [placedAlloc.id, placedRet.id]
    module.functions = module.functions.append(fn)
    let result = emitModule(entry = 发射造记录(outputCode = 1), target = defaultTarget(), module = module)
    assert(!result.failed, "等待模块应发得出来")
    assert(发射含子串(text = result.text, needle = "call i32 @bk_task_join(ptr "), "等待应走运行时段入口")
    assert(发射含子串(text = result.text, needle = "insertvalue { i64, i32, i64 }"), "结算值按三槽拼回")
    return
