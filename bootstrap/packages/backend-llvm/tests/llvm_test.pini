[llvm_test|import]
_ir = "../../ir"
_backend_kit = "../../backend-kit"

; 发射判据：手搭模块只喂发射器，不经过装配链；真实模块由 lower 与 validate 另行验证。
; 每条判据只钉一类行：函数头、槽位、二元指令、缺口与确定性；手搭反而能精确到一条。

; 发射造记录：族表照后端自己声明的那份，入口码取二；测试与驱动因此不会各说一套。
发射造记录|func(outputCode: I32,) -> (BackendEntry,):
    return makeBackendOf(name = "llvm", outputCode = outputCode, families = llvmFamilies(), entry = 2)

; 发射造类型池：一个 i32。
发射造类型池|func() -> (IrTypePool,):
    var pool = IrTypePool()
    let intType = irScalarTypeOfCode(pool = pool, code = 1, name = "i32")
    return intType.pool

; 发射造模块：main 里一条变量声明、一条返回；变量槽为零。
; 常量先入池，再入声明与返回，体按装入序给两条语句。
发射造模块|func() -> (IrModule,):
    var module = IrModule()
    module.types = 发射造类型池()
    var nodes = IrNodePool()
    var literal = irMakeNode(kind = tagOfName(name = "intConst"), typeId = 0)
    literal.intValue = 2
    let placedLiteral = irAppendNode(pool = nodes, node = literal)
    nodes = placedLiteral.pool
    var alloc = irMakeNode(kind = tagOfName(name = "allocVar"), typeId = 0)
    alloc.text = 0
    alloc.intValue = 0
    alloc.kids = [placedLiteral.id]
    let placedAlloc = irAppendNode(pool = nodes, node = alloc)
    nodes = placedAlloc.pool
    var back = irMakeNode(kind = tagOfName(name = "returnStmt"), typeId = -1)
    let placedBack = irAppendNode(pool = nodes, node = back)
    nodes = placedBack.pool
    module.nodes = nodes
    module.texts = module.texts.append("a")
    var fn = IrFunction()
    fn.name = "main"
    fn.returnType = -1
    fn.body = [placedAlloc.id, placedBack.id]
    module.functions = module.functions.append(fn)
    return module

; 含子串：成员被调走参数接收者，避开「字段读后直接成员被调」的定型盲区。
发射含子串|func(text: String, needle: String,) -> (Bool,):
    return text.indexOf(needle) >= 0

; 函数头与槽位：main 按 i32 出，变量按槽位名出，常量直接进存储。
发射形状|test() -> ():
    let module = 发射造模块()
    let result = emitModule(entry = 发射造记录(outputCode = 1), target = defaultTarget(), module = module)
    assert(!result.failed, "最小模块应发得出来")
    assert(发射含子串(text = result.text, needle = "define i32 @main() {"), "main 应按 i32 出定义")
    assert(发射含子串(text = result.text, needle = "%s0 = alloca i32"), "变量应按槽位名出 alloca")
    assert(发射含子串(text = result.text, needle = "store i32 2, ptr %s0"), "初始值应直接进存储")
    assert(发射含子串(text = result.text, needle = "ret i32 0"), "main 应补零返回")
    return

; 外部声明：模块表里的函数按签名出 declare，调用点直呼 C 名字，不按内部编码。
; 变参在固定形参后留省略号；两者都只凭模块算，不查后端私有表。
外部声明|test() -> ():
    var module = IrModule()
    module.types = 发射造类型池()
    var nodes = IrNodePool()
    var literal = irMakeNode(kind = tagOfName(name = "intConst"), typeId = 0)
    literal.intValue = 5
    let placedLiteral = irAppendNode(pool = nodes, node = literal)
    nodes = placedLiteral.pool
    var called = irMakeNode(kind = tagOfName(name = "call"), typeId = 0)
    called.text = 0
    called.kids = [placedLiteral.id]
    let placedCalled = irAppendNode(pool = nodes, node = called)
    nodes = placedCalled.pool
    var back = irMakeNode(kind = tagOfName(name = "returnStmt"), typeId = -1)
    back.kids = [placedCalled.id]
    let placedBack = irAppendNode(pool = nodes, node = back)
    nodes = placedBack.pool
    module.nodes = nodes
    module.texts = module.texts.append("abs")
    var fn = IrFunction()
    fn.name = "main"
    fn.returnType = 0
    fn.body = [placedBack.id]
    module.functions = module.functions.append(fn)
    var declared = IrExternFunction()
    declared.name = "abs"
    declared.returnType = 0
    declared.params = declared.params.append(0)
    module.externs = module.externs.append(declared)
    let result = emitModule(entry = 发射造记录(outputCode = 1), target = defaultTarget(), module = module)
    assert(!result.failed, "外部声明应发得出来")
    assert(发射含子串(text = result.text, needle = "call i32 @abs(i32"), "调用点应直呼 C 名字")
    assert(发射含子串(text = result.text, needle = "declare i32 @abs(i32)"), "应按模块表出 declare")
    return

; 外部变参：定参后留省略号，返回 void 时不写类型。
外部变参|test() -> ():
    var module = IrModule()
    module.types = 发射造类型池()
    var nodes = IrNodePool()
    var called = irMakeNode(kind = tagOfName(name = "call"), typeId = -1)
    called.text = 0
    let placedCalled = irAppendNode(pool = nodes, node = called)
    nodes = placedCalled.pool
    var stmt = irMakeNode(kind = tagOfName(name = "exprStmt"), typeId = -1)
    stmt.kids = [placedCalled.id]
    let placedStmt = irAppendNode(pool = nodes, node = stmt)
    nodes = placedStmt.pool
    var back = irMakeNode(kind = tagOfName(name = "returnStmt"), typeId = -1)
    let placedBack = irAppendNode(pool = nodes, node = back)
    nodes = placedBack.pool
    module.nodes = nodes
    module.texts = module.texts.append("fake")
    var fn = IrFunction()
    fn.name = "main"
    fn.returnType = -1
    fn.body = [placedStmt.id, placedBack.id]
    module.functions = module.functions.append(fn)
    var declared = IrExternFunction()
    declared.name = "fake"
    declared.returnType = -1
    declared.params = declared.params.append(0)
    declared.isVarargs = true
    module.externs = module.externs.append(declared)
    let result = emitModule(entry = 发射造记录(outputCode = 1), target = defaultTarget(), module = module)
    var why = "无缺口"
    if len(result.gaps) > 0:
        why = result.gaps[0]
    assert(!result.failed, "变参声明应发得出来：" + why)
    assert(发射含子串(text = result.text, needle = "declare void @fake(i32, ...)"), "变参应在定参后留省略号")
    return

; 缺口：族未声明时按族报，且整份文本不出；失败不静默。
; 声明表由入口给，故这里交一份空表来覆盖这条缺口；后端自己的族表已全声明。
族未声明|test() -> ():
    var module = 发射造模块()
    var pool = module.nodes
    var pending = irMakeNode(kind = tagOfName(name = "functionValue"), typeId = 0)
    let placed = irAppendNode(pool = pool, node = pending)
    module.nodes = placed.pool
    module.functions[0].body = [placed.id]
    var entry = 发射造记录(outputCode = 1)
    entry.families = [0]
    let result = emitModule(entry = entry, target = defaultTarget(), module = module)
    assert(result.failed, "未声明族的节点应失败")
    assert(len(result.text) == 0, "失败时不应出半份文本")
    assert(emitGapCount(result = result) > 0, "失败应带缺口")
    assert(发射含子串(text = result.gaps[0], needle = "族未声明 calls"), "缺口应点名族")
    return

; 缺口：族已声明而节点没接时按类别码报，不与「族未声明」混成一句。
族已声明未接|test() -> ():
    var module = 发射造模块()
    var pool = module.nodes
    var literal = irMakeNode(kind = tagOfName(name = "floatConst"), typeId = 0)
    let placed = irAppendNode(pool = pool, node = literal)
    module.nodes = placed.pool
    module.functions[0].body = [placed.id]
    let result = emitModule(entry = 发射造记录(outputCode = 1), target = defaultTarget(), module = module)
    assert(result.failed, "未接节点应失败")
    assert(发射含子串(text = result.gaps[0], needle = "未接"), "缺口应说未接")
    return

; 档次：转储档次不接受，直接拒发；记录与发射器判据同源。
档次不符|test() -> ():
    let module = 发射造模块()
    let result = emitModule(entry = 发射造记录(outputCode = 3), target = defaultTarget(), module = module)
    assert(result.failed, "非本机码档次应失败")
    assert(发射含子串(text = result.detail, needle = "不接受档次 dump"), "细节应点名档次")
    return

; 确定性：同一模块两遍发射逐字节相同，行读数与换行数相等。
发射确定性|test() -> ():
    let module = 发射造模块()
    let once = emitModule(entry = 发射造记录(outputCode = 1), target = defaultTarget(), module = module)
    let twice = emitModule(entry = 发射造记录(outputCode = 1), target = defaultTarget(), module = module)
    assert(once.text == twice.text, "两遍发射应逐字节相同")
    assert(once.lines == twice.lines, "两遍行读数应相同")
    return

; 打印模块的类型池：i32、String、Bool 三个标量。
发射造打印类型池|func() -> (IrTypePool,):
    var pool = IrTypePool()
    let intType = irScalarTypeOfCode(pool = pool, code = 1, name = "i32")
    pool = intType.pool
    let textType = irScalarTypeOfCode(pool = pool, code = 8, name = "String")
    pool = textType.pool
    let boolType = irScalarTypeOfCode(pool = pool, code = 7, name = "Bool")
    return boolType.pool

; 打印模块：一个字符串常量，一条单参打印，一条真断言，末尾返回。
; 字面量「值」三个字节、一个标量，常量总长 = 四字节头加四字节计数、载荷与 NUL。
发射造打印模块|func() -> (IrModule,):
    var module = IrModule()
    module.types = 发射造打印类型池()
    module.texts = module.texts.append("值")
    var nodes = IrNodePool()
    var literal = irMakeNode(kind = tagOfName(name = "stringConst"), typeId = 1)
    literal.text = 0
    let placedLiteral = irAppendNode(pool = nodes, node = literal)
    nodes = placedLiteral.pool
    var printed = irMakeNode(kind = tagOfName(name = "printCall"), typeId = -1)
    printed.kids = [placedLiteral.id]
    let placedPrintCall = irAppendNode(pool = nodes, node = printed)
    nodes = placedPrintCall.pool
    var printStmt = irMakeNode(kind = tagOfName(name = "exprStmt"), typeId = -1)
    printStmt.kids = [placedPrintCall.id]
    let placedPrint = irAppendNode(pool = nodes, node = printStmt)
    nodes = placedPrint.pool
    var cond = irMakeNode(kind = tagOfName(name = "boolConst"), typeId = 2)
    cond.intValue = 1
    let placedCond = irAppendNode(pool = nodes, node = cond)
    nodes = placedCond.pool
    var checked = irMakeNode(kind = tagOfName(name = "assertCall"), typeId = -1)
    checked.kids = [placedCond.id, placedLiteral.id]
    let placedAssertCall = irAppendNode(pool = nodes, node = checked)
    nodes = placedAssertCall.pool
    var assertStmt = irMakeNode(kind = tagOfName(name = "exprStmt"), typeId = -1)
    assertStmt.kids = [placedAssertCall.id]
    let placedAssert = irAppendNode(pool = nodes, node = assertStmt)
    nodes = placedAssert.pool
    var back = irMakeNode(kind = tagOfName(name = "returnStmt"), typeId = -1)
    let placedBack = irAppendNode(pool = nodes, node = back)
    nodes = placedBack.pool
    module.nodes = nodes
    var fn = IrFunction()
    fn.name = "main"
    fn.returnType = -1
    fn.body = [placedPrint.id, placedAssert.id, placedBack.id]
    module.functions = module.functions.append(fn)
    return module

; 打印与断言：整行由锁连成一段，字符串走 `%s`，断言为假跳陷阱。
打印与断言|test() -> ():
    let module = 发射造打印模块()
    let result = emitModule(entry = 发射造记录(outputCode = 1), target = defaultTarget(), module = module)
    if result.failed:
        assert(false, "缺口：" + result.gaps[0])
    assert(发射含子串(text = result.text, needle = "call void @bk_print_lock()"), "整行应先取锁")
    assert(发射含子串(text = result.text, needle = "call i32 (ptr, ...) @printf(ptr @fmt_string, ptr %t0)"), "字符串应走 %s")
    assert(发射含子串(text = result.text, needle = "call i32 (ptr, ...) @printf(ptr @fmt_newline)"), "行末应补终止符")
    assert(发射含子串(text = result.text, needle = "call void @bk_print_unlock()"), "整行应还锁")
    assert(发射含子串(text = result.text, needle = "declare i32 @printf(ptr, ...)"), "被调外部符号应出声明")
    assert(发射含子串(text = result.text, needle = "call void @bk_panic(ptr"), "断言为假应跳陷阱")
    assert(发射含子串(text = result.text, needle = "assert.fail."), "断言应有失败块")
    return

; 字符串常量：头部四格与载荷同序，总长含头、载荷与 NUL；两遍常量号不漂。
字符串常量形状|test() -> ():
    let module = 发射造打印模块()
    let result = emitModule(entry = 发射造记录(outputCode = 1), target = defaultTarget(), module = module)
    assert(发射含子串(text = result.text, needle = "@.str0 = private global [20 x i8] c\"\\00\\00\\00\\00\\03\\00\\00\\00\\03\\00\\00\\00\\01\\00\\00\\00\\E5\\80\\BC\\00\", align 16"), "常量应按头加载荷出字节")
    assert(发射含子串(text = result.text, needle = "getelementptr [20 x i8], ptr @.str0, i32 0, i32 16"), "取串应跳过十六字节头")
    return

; 容器模块的类型池：i32 与 Array<I32>；数组类型的首分量就是元素类型。
发射造容器类型池|func() -> (IrTypePool,):
    var pool = IrTypePool()
    let intType = irScalarTypeOfCode(pool = pool, code = 1, name = "i32")
    let arrayType = irWrapTypeOfCode(pool = intType.pool, code = 12, name = "", inner = intType.id)
    return arrayType.pool

; 容器模块：空字面量建句柄、追加一个元素并写回、打印长度，末尾返回。
; 槽位零用于数组变量；追加是命名调用，名字登记在文本池首格。
发射造容器模块|func() -> (IrModule,):
    var module = IrModule()
    module.types = 发射造容器类型池()
    module.texts = module.texts.append("Array.append")
    var nodes = IrNodePool()
    var literal = irMakeNode(kind = tagOfName(name = "arrayLiteral"), typeId = 1)
    let placedLiteral = irAppendNode(pool = nodes, node = literal)
    nodes = placedLiteral.pool
    var alloc = irMakeNode(kind = tagOfName(name = "allocVar"), typeId = 1)
    alloc.intValue = 0
    alloc.kids = [placedLiteral.id]
    let placedAlloc = irAppendNode(pool = nodes, node = alloc)
    nodes = placedAlloc.pool
    var reading = irMakeNode(kind = tagOfName(name = "load"), typeId = 1)
    reading.intValue = 0
    let placedReading = irAppendNode(pool = nodes, node = reading)
    nodes = placedReading.pool
    var seven = irMakeNode(kind = tagOfName(name = "intConst"), typeId = 0)
    seven.intValue = 7
    let placedSeven = irAppendNode(pool = nodes, node = seven)
    nodes = placedSeven.pool
    var appended = irMakeNode(kind = tagOfName(name = "call"), typeId = 1)
    appended.text = 0
    appended.kids = [placedReading.id, placedSeven.id]
    let placedAppend = irAppendNode(pool = nodes, node = appended)
    nodes = placedAppend.pool
    var stored = irMakeNode(kind = tagOfName(name = "storeVar"), typeId = 1)
    stored.intValue = 0
    stored.kids = [placedAppend.id]
    let placedStore = irAppendNode(pool = nodes, node = stored)
    nodes = placedStore.pool
    var reloaded = irMakeNode(kind = tagOfName(name = "load"), typeId = 1)
    reloaded.intValue = 0
    let placedReloaded = irAppendNode(pool = nodes, node = reloaded)
    nodes = placedReloaded.pool
    var counted = irMakeNode(kind = tagOfName(name = "lenCall"), typeId = 0)
    counted.kids = [placedReloaded.id]
    let placedCount = irAppendNode(pool = nodes, node = counted)
    nodes = placedCount.pool
    var printed = irMakeNode(kind = tagOfName(name = "printCall"), typeId = -1)
    printed.kids = [placedCount.id]
    let placedPrintCall = irAppendNode(pool = nodes, node = printed)
    nodes = placedPrintCall.pool
    var printStmt = irMakeNode(kind = tagOfName(name = "exprStmt"), typeId = -1)
    printStmt.kids = [placedPrintCall.id]
    let placedPrint = irAppendNode(pool = nodes, node = printStmt)
    nodes = placedPrint.pool
    var back = irMakeNode(kind = tagOfName(name = "returnStmt"), typeId = -1)
    let placedBack = irAppendNode(pool = nodes, node = back)
    nodes = placedBack.pool
    module.nodes = nodes
    var fn = IrFunction()
    fn.name = "main"
    fn.returnType = -1
    fn.body = [placedAlloc.id, placedStore.id, placedPrint.id, placedBack.id]
    module.functions = module.functions.append(fn)
    return module

; 容器长度与追加：字面量先建空句柄，追加按元素宽度与标签装箱，长度按接收者类别选符号。
容器长度与追加|test() -> ():
    let module = 发射造容器模块()
    let result = emitModule(entry = 发射造记录(outputCode = 1), target = defaultTarget(), module = module)
    if result.failed:
        assert(false, "缺口：" + result.gaps[0])
    assert(发射含子串(text = result.text, needle = "%t0 = call ptr @bk_array_create(i32 0)"), "空字面量应建零长句柄")
    assert(发射含子串(text = result.text, needle = "store i32 7, ptr %ebox, align 4"), "元素应先落装箱台")
    assert(发射含子串(text = result.text, needle = "call ptr @bk_array_append(ptr %t1, ptr %ebox, i32 4, i32 0)"), "追加应带宽度与标签")
    assert(发射含子串(text = result.text, needle = "call i32 @bk_array_len(ptr %t3)"), "数组长度应走数组族符号")
    assert(发射含子串(text = result.text, needle = "declare ptr @bk_array_append(ptr, ptr, i32, i32)"), "追加符号应出声明")
    assert(发射含子串(text = result.text, needle = "declare i32 @bk_array_len(ptr)"), "长度符号应出声明")
    assert(发射含子串(text = result.text, needle = "%ebox = alloca [8 x i8], align 8"), "装箱台应在函数入口分配")
    return

; 字符模块的类型池：i32、字符、字串、U8、字符数组与字节数组。
发射造字符类型池|func() -> (IrTypePool,):
    var pool = IrTypePool()
    let intType = irScalarTypeOfCode(pool = pool, code = 1, name = "i32")
    pool = intType.pool
    let charType = irScalarTypeOfCode(pool = pool, code = 9, name = "char")
    pool = charType.pool
    let textType = irScalarTypeOfCode(pool = pool, code = 8, name = "String")
    pool = textType.pool
    let byteType = irScalarTypeOfCode(pool = pool, code = 4, name = "u8")
    pool = byteType.pool
    let charArray = irWrapTypeOfCode(pool = pool, code = 12, name = "", inner = charType.id)
    pool = charArray.pool
    let byteArray = irWrapTypeOfCode(pool = pool, code = 12, name = "", inner = byteType.id)
    return byteArray.pool

; 字符模块：chr、ord、chars 与字节桥各一条调用；结果丢弃，只验发射形状。
发射造字符模块|func() -> (IrModule,):
    var module = IrModule()
    module.types = 发射造字符类型池()
    module.texts = module.texts.append("chr")
    module.texts = module.texts.append("ord")
    module.texts = module.texts.append("ab")
    module.texts = module.texts.append("chars")
    module.texts = module.texts.append("tempUtf8Bytes")
    var nodes = IrNodePool()
    var letter = irMakeNode(kind = tagOfName(name = "intConst"), typeId = 0)
    letter.intValue = 65
    let placedLetter = irAppendNode(pool = nodes, node = letter)
    nodes = placedLetter.pool
    var made = irMakeNode(kind = tagOfName(name = "call"), typeId = 1)
    made.text = 0
    made.kids = [placedLetter.id]
    let placedMade = irAppendNode(pool = nodes, node = made)
    nodes = placedMade.pool
    var code = irMakeNode(kind = tagOfName(name = "call"), typeId = 0)
    code.text = 1
    code.kids = [placedMade.id]
    let placedCode = irAppendNode(pool = nodes, node = code)
    nodes = placedCode.pool
    var text = irMakeNode(kind = tagOfName(name = "stringConst"), typeId = 2)
    text.text = 2
    let placedText = irAppendNode(pool = nodes, node = text)
    nodes = placedText.pool
    var split = irMakeNode(kind = tagOfName(name = "call"), typeId = 4)
    split.text = 3
    split.kids = [placedText.id]
    let placedSplit = irAppendNode(pool = nodes, node = split)
    nodes = placedSplit.pool
    var bytes = irMakeNode(kind = tagOfName(name = "call"), typeId = 5)
    bytes.text = 4
    bytes.kids = [placedText.id]
    let placedBytes = irAppendNode(pool = nodes, node = bytes)
    nodes = placedBytes.pool
    var first = irMakeNode(kind = tagOfName(name = "exprStmt"), typeId = -1)
    first.kids = [placedMade.id]
    let placedFirst = irAppendNode(pool = nodes, node = first)
    nodes = placedFirst.pool
    var second = irMakeNode(kind = tagOfName(name = "exprStmt"), typeId = -1)
    second.kids = [placedCode.id]
    let placedSecond = irAppendNode(pool = nodes, node = second)
    nodes = placedSecond.pool
    var third = irMakeNode(kind = tagOfName(name = "exprStmt"), typeId = -1)
    third.kids = [placedSplit.id]
    let placedThird = irAppendNode(pool = nodes, node = third)
    nodes = placedThird.pool
    var fourth = irMakeNode(kind = tagOfName(name = "exprStmt"), typeId = -1)
    fourth.kids = [placedBytes.id]
    let placedFourth = irAppendNode(pool = nodes, node = fourth)
    nodes = placedFourth.pool
    var back = irMakeNode(kind = tagOfName(name = "returnStmt"), typeId = -1)
    let placedBack = irAppendNode(pool = nodes, node = back)
    nodes = placedBack.pool
    module.nodes = nodes
    var fn = IrFunction()
    fn.name = "main"
    fn.returnType = -1
    fn.body = [placedFirst.id, placedSecond.id, placedThird.id, placedFourth.id, placedBack.id]
    module.functions = module.functions.append(fn)
    return module

; 字符与字节内建：四行各按自身签名出调用，字符值以 i64 装箱。
字符与字节内建|test() -> ():
    let module = 发射造字符模块()
    let result = emitModule(entry = 发射造记录(outputCode = 1), target = defaultTarget(), module = module)
    if result.failed:
        assert(false, "缺口：" + result.gaps[0])
    assert(发射含子串(text = result.text, needle = "call i64 @bk_chr(i32 65)"), "chr 应 i32 进、i64 出")
    assert(发射含子串(text = result.text, needle = "call i32 @bk_ord(i64"), "ord 应 i64 进、i32 出")
    assert(发射含子串(text = result.text, needle = "call ptr @bk_chars(ptr"), "chars 应串进、句柄出")
    assert(发射含子串(text = result.text, needle = "call ptr @bk_temp_utf8_bytes(ptr"), "字节桥应串进、句柄出")
    assert(发射含子串(text = result.text, needle = "declare i64 @bk_chr(i32)"), "chr 声明应与调用同形")
    assert(发射含子串(text = result.text, needle = "declare i32 @bk_ord(i64)"), "ord 声明应与调用同形")
    assert(发射含子串(text = result.text, needle = "declare ptr @bk_chars(ptr)"), "chars 声明应与调用同形")
    assert(发射含子串(text = result.text, needle = "declare ptr @bk_temp_utf8_bytes(ptr)"), "字节桥声明应与调用同形")
    return

; 名义模块的类型池：i32 与值语义名义类型 Point；对象位为零。
发射造名义类型池|func() -> (IrTypePool,):
    var pool = IrTypePool()
    let intType = irScalarTypeOfCode(pool = pool, code = 1, name = "i32")
    let point = irScalarTypeOfCode(pool = intType.pool, code = 14, name = "Point")
    return point.pool

; 名义模块：类型、一条字段声明、槽表基准与三条语句；声明与槽表先建局部再整体写回。
发射造名义模块|func() -> (IrModule,):
    var module = IrModule()
    module.types = 发射造名义类型池()
    var decl = IrDecl()
    decl.typeId = 1
    decl.name = "Point"
    var field = IrField()
    field.name = "x"
    field.typeId = 0
    decl.fields = decl.fields.append(field)
    var decls = IrDeclTable()
    decls.entries = decls.entries.append(decl)
    module.decls = decls
    var slots = IrSlotTable()
    slots.headSlots = 4
    slots.payloadBase = 5
    module.slots = slots
    var nodes = IrNodePool()
    var seven = irMakeNode(kind = tagOfName(name = "intConst"), typeId = 0)
    seven.intValue = 7
    let placedSeven = irAppendNode(pool = nodes, node = seven)
    nodes = placedSeven.pool
    var made = irMakeNode(kind = tagOfName(name = "construct"), typeId = 1)
    let placedMade = irAppendNode(pool = nodes, node = made)
    nodes = placedMade.pool
    var alloc = irMakeNode(kind = tagOfName(name = "allocVar"), typeId = 1)
    alloc.intValue = 0
    alloc.kids = [placedMade.id]
    let placedAlloc = irAppendNode(pool = nodes, node = alloc)
    nodes = placedAlloc.pool
    var base = irMakeNode(kind = tagOfName(name = "load"), typeId = 1)
    base.intValue = 0
    let placedBase = irAppendNode(pool = nodes, node = base)
    nodes = placedBase.pool
    var stored = irMakeNode(kind = tagOfName(name = "fieldStore"), typeId = 0)
    stored.op = 0
    stored.kids = [placedBase.id, placedSeven.id]
    let placedStored = irAppendNode(pool = nodes, node = stored)
    nodes = placedStored.pool
    var reloaded = irMakeNode(kind = tagOfName(name = "load"), typeId = 1)
    reloaded.intValue = 0
    let placedReloaded = irAppendNode(pool = nodes, node = reloaded)
    nodes = placedReloaded.pool
    var read = irMakeNode(kind = tagOfName(name = "fieldGet"), typeId = 0)
    read.op = 0
    read.kids = [placedReloaded.id]
    let placedRead = irAppendNode(pool = nodes, node = read)
    nodes = placedRead.pool
    var printed = irMakeNode(kind = tagOfName(name = "printCall"), typeId = -1)
    printed.kids = [placedRead.id]
    let placedPrintCall = irAppendNode(pool = nodes, node = printed)
    nodes = placedPrintCall.pool
    var printStmt = irMakeNode(kind = tagOfName(name = "exprStmt"), typeId = -1)
    printStmt.kids = [placedPrintCall.id]
    let placedPrint = irAppendNode(pool = nodes, node = printStmt)
    nodes = placedPrint.pool
    var back = irMakeNode(kind = tagOfName(name = "returnStmt"), typeId = -1)
    let placedBack = irAppendNode(pool = nodes, node = back)
    nodes = placedBack.pool
    module.nodes = nodes
    var fn = IrFunction()
    fn.name = "main"
    fn.returnType = -1
    fn.body = [placedAlloc.id, placedStored.id, placedPrint.id, placedBack.id]
    module.functions = module.functions.append(fn)
    return module

; 名义面：聚合按头四格加字段出声明，构造分配箱并清零，字段读写落在第 4 槽。
名义构造与字段|test() -> ():
    let module = 发射造名义模块()
    let result = emitModule(entry = 发射造记录(outputCode = 1), target = defaultTarget(), module = module)
    if result.failed:
        assert(false, "缺口：" + result.gaps[0])
    assert(发射含子串(text = result.text, needle = "%struct.Point = type { i32, i32, i32, ptr, i32 }"), "聚合应按头加字段出声明")
    assert(发射含子串(text = result.text, needle = "call ptr @bk_nominal_alloc(i64"), "构造应分配名义箱")
    assert(发射含子串(text = result.text, needle = "getelementptr %struct.Point, ptr null, i32 1"), "箱尺寸应取过尾指针")
    assert(发射含子串(text = result.text, needle = "getelementptr %struct.Point, ptr %t2, i32 0, i32 4"), "字段应先清零")
    assert(发射含子串(text = result.text, needle = "store i32 0, ptr %t3"), "清零应写零值")
    assert(发射含子串(text = result.text, needle = "getelementptr %struct.Point, ptr %t4, i32 0, i32 4"), "字段写应落在第 4 槽")
    assert(发射含子串(text = result.text, needle = "store i32 7, ptr %t5"), "字段写应存值")
    assert(发射含子串(text = result.text, needle = "load i32, ptr %t7"), "字段读应按字段类型读")
    assert(发射含子串(text = result.text, needle = "declare ptr @bk_nominal_alloc(i64, i32)"), "分配符号应出声明")
    return

; 枚举模块：i32 与枚举 Color（一个带 I32 载荷的用例），标签与载荷各读一次。
发射造枚举模块|func() -> (IrModule,):
    var module = IrModule()
    var pool = IrTypePool()
    let intType = irScalarTypeOfCode(pool = pool, code = 1, name = "i32")
    pool = intType.pool
    let color = irScalarTypeOfCode(pool = pool, code = 15, name = "Color")
    module.types = color.pool
    var decl = IrDecl()
    decl.typeId = 1
    decl.name = "Color"
    decl.kind = irDeclKindOf(shapeCode = 3)
    var only = IrCase()
    only.name = "red"
    only.tag = 0
    only.payload = only.payload.append(0)
    decl.cases = decl.cases.append(only)
    var decls = IrDeclTable()
    decls.entries = decls.entries.append(decl)
    module.decls = decls
    var slots = IrSlotTable()
    slots.headSlots = 4
    slots.payloadBase = 5
    module.slots = slots
    module.texts = module.texts.append("red")
    var nodes = IrNodePool()
    var payload = irMakeNode(kind = tagOfName(name = "intConst"), typeId = 0)
    payload.intValue = 5
    let placedPayload = irAppendNode(pool = nodes, node = payload)
    nodes = placedPayload.pool
    var made = irMakeNode(kind = tagOfName(name = "enumConstruct"), typeId = 1)
    made.op = 0
    made.text = 0
    made.kids = [placedPayload.id]
    let placedMade = irAppendNode(pool = nodes, node = made)
    nodes = placedMade.pool
    var alloc = irMakeNode(kind = tagOfName(name = "allocVar"), typeId = 1)
    alloc.intValue = 0
    alloc.kids = [placedMade.id]
    let placedAlloc = irAppendNode(pool = nodes, node = alloc)
    nodes = placedAlloc.pool
    var base = irMakeNode(kind = tagOfName(name = "load"), typeId = 1)
    base.intValue = 0
    let placedBase = irAppendNode(pool = nodes, node = base)
    nodes = placedBase.pool
    var tagRead = irMakeNode(kind = tagOfName(name = "enumTagGet"), typeId = 0)
    tagRead.kids = [placedBase.id]
    let placedTag = irAppendNode(pool = nodes, node = tagRead)
    nodes = placedTag.pool
    var tagPrintCall = irMakeNode(kind = tagOfName(name = "printCall"), typeId = -1)
    tagPrintCall.kids = [placedTag.id]
    let placedTagPrint = irAppendNode(pool = nodes, node = tagPrintCall)
    nodes = placedTagPrint.pool
    var tagStmt = irMakeNode(kind = tagOfName(name = "exprStmt"), typeId = -1)
    tagStmt.kids = [placedTagPrint.id]
    let placedTagStmt = irAppendNode(pool = nodes, node = tagStmt)
    nodes = placedTagStmt.pool
    var again = irMakeNode(kind = tagOfName(name = "load"), typeId = 1)
    again.intValue = 0
    let placedAgain = irAppendNode(pool = nodes, node = again)
    nodes = placedAgain.pool
    var valueRead = irMakeNode(kind = tagOfName(name = "enumPayloadGet"), typeId = 0)
    valueRead.op = 0
    valueRead.text = 0
    valueRead.kids = [placedAgain.id]
    let placedValue = irAppendNode(pool = nodes, node = valueRead)
    nodes = placedValue.pool
    var valuePrintCall = irMakeNode(kind = tagOfName(name = "printCall"), typeId = -1)
    valuePrintCall.kids = [placedValue.id]
    let placedValuePrint = irAppendNode(pool = nodes, node = valuePrintCall)
    nodes = placedValuePrint.pool
    var valueStmt = irMakeNode(kind = tagOfName(name = "exprStmt"), typeId = -1)
    valueStmt.kids = [placedValuePrint.id]
    let placedValueStmt = irAppendNode(pool = nodes, node = valueStmt)
    nodes = placedValueStmt.pool
    var back = irMakeNode(kind = tagOfName(name = "returnStmt"), typeId = -1)
    let placedBack = irAppendNode(pool = nodes, node = back)
    nodes = placedBack.pool
    module.nodes = nodes
    var fn = IrFunction()
    fn.name = "main"
    fn.returnType = -1
    fn.body = [placedAlloc.id, placedTagStmt.id, placedValueStmt.id, placedBack.id]
    module.functions = module.functions.append(fn)
    return module

; 枚举面：标签进第 4 槽、载荷从第 5 槽起；读侧按标签格与载荷窗口各取一次。
枚举构造与读|test() -> ():
    let module = 发射造枚举模块()
    let result = emitModule(entry = 发射造记录(outputCode = 1), target = defaultTarget(), module = module)
    if result.failed:
        assert(false, "缺口：" + result.gaps[0])
    assert(发射含子串(text = result.text, needle = "%enum.Color = type { i32, i32, i32, ptr, i32, i32 }"), "枚举应按头加标签加最宽载荷出声明")
    assert(发射含子串(text = result.text, needle = "getelementptr %enum.Color, ptr %t2, i32 0, i32 4"), "标签应写第 4 槽")
    assert(发射含子串(text = result.text, needle = "getelementptr %enum.Color, ptr %t2, i32 0, i32 5"), "载荷应写第 5 槽")
    assert(发射含子串(text = result.text, needle = "store i32 0, ptr %t3"), "标签应写声明序")
    assert(发射含子串(text = result.text, needle = "load i32, ptr %t6"), "标签应按 i32 读")
    assert(发射含子串(text = result.text, needle = "load i32, ptr %t9"), "载荷应按自身类型读")
    return

; 字符串模块：字串常量两个，contains 与 indexOf 各一次；宿主查询三条。
发射造字符串模块|func() -> (IrModule,):
    var module = IrModule()
    var pool = IrTypePool()
    let intType = irScalarTypeOfCode(pool = pool, code = 1, name = "i32")
    pool = intType.pool
    let boolType = irScalarTypeOfCode(pool = pool, code = 7, name = "Bool")
    pool = boolType.pool
    let textType = irScalarTypeOfCode(pool = pool, code = 8, name = "String")
    module.types = textType.pool
    module.texts = module.texts.append("ab")
    module.texts = module.texts.append("b")
    var nodes = IrNodePool()
    var haystack = irMakeNode(kind = tagOfName(name = "stringConst"), typeId = 2)
    haystack.text = 0
    let placedHaystack = irAppendNode(pool = nodes, node = haystack)
    nodes = placedHaystack.pool
    var needle = irMakeNode(kind = tagOfName(name = "stringConst"), typeId = 2)
    needle.text = 1
    let placedNeedle = irAppendNode(pool = nodes, node = needle)
    nodes = placedNeedle.pool
    var found = irMakeNode(kind = tagOfName(name = "stringContains"), typeId = 1)
    found.kids = [placedHaystack.id, placedNeedle.id]
    let placedFound = irAppendNode(pool = nodes, node = found)
    nodes = placedFound.pool
    var foundPrintCall = irMakeNode(kind = tagOfName(name = "printCall"), typeId = -1)
    foundPrintCall.kids = [placedFound.id]
    let placedFoundPrint = irAppendNode(pool = nodes, node = foundPrintCall)
    nodes = placedFoundPrint.pool
    var foundStmt = irMakeNode(kind = tagOfName(name = "exprStmt"), typeId = -1)
    foundStmt.kids = [placedFoundPrint.id]
    let placedFoundStmt = irAppendNode(pool = nodes, node = foundStmt)
    nodes = placedFoundStmt.pool
    var at = irMakeNode(kind = tagOfName(name = "stringIndexOf"), typeId = 0)
    at.kids = [placedHaystack.id, placedNeedle.id]
    let placedAt = irAppendNode(pool = nodes, node = at)
    nodes = placedAt.pool
    var atPrintCall = irMakeNode(kind = tagOfName(name = "printCall"), typeId = -1)
    atPrintCall.kids = [placedAt.id]
    let placedAtPrint = irAppendNode(pool = nodes, node = atPrintCall)
    nodes = placedAtPrint.pool
    var atStmt = irMakeNode(kind = tagOfName(name = "exprStmt"), typeId = -1)
    atStmt.kids = [placedAtPrint.id]
    let placedAtStmt = irAppendNode(pool = nodes, node = atStmt)
    nodes = placedAtStmt.pool
    var root = irMakeNode(kind = tagOfName(name = "call"), typeId = 2)
    root.text = 2
    let placedRoot = irAppendNode(pool = nodes, node = root)
    nodes = placedRoot.pool
    var present = irMakeNode(kind = tagOfName(name = "call"), typeId = 1)
    present.text = 3
    present.kids = [placedHaystack.id]
    let placedPresent = irAppendNode(pool = nodes, node = present)
    nodes = placedPresent.pool
    var presentPrintCall = irMakeNode(kind = tagOfName(name = "printCall"), typeId = -1)
    presentPrintCall.kids = [placedPresent.id]
    let placedPresentPrint = irAppendNode(pool = nodes, node = presentPrintCall)
    nodes = placedPresentPrint.pool
    var presentStmt = irMakeNode(kind = tagOfName(name = "exprStmt"), typeId = -1)
    presentStmt.kids = [placedPresentPrint.id]
    let placedPresentStmt = irAppendNode(pool = nodes, node = presentStmt)
    nodes = placedPresentStmt.pool
    var back = irMakeNode(kind = tagOfName(name = "returnStmt"), typeId = -1)
    let placedBack = irAppendNode(pool = nodes, node = back)
    nodes = placedBack.pool
    module.nodes = nodes
    module.texts = module.texts.append("moduleRoot")
    module.texts = module.texts.append("exists")
    var fn = IrFunction()
    fn.name = "main"
    fn.returnType = -1
    var rootStmt = irMakeNode(kind = tagOfName(name = "exprStmt"), typeId = -1)
    rootStmt.kids = [placedRoot.id]
    let placedRootStmt = irAppendNode(pool = nodes, node = rootStmt)
    module.nodes = placedRootStmt.pool
    fn.body = [placedFoundStmt.id, placedAtStmt.id, placedRootStmt.id, placedPresentStmt.id, placedBack.id]
    module.functions = module.functions.append(fn)
    return module

; 串一元模块：一个字串常量，upper/lower/trimLeft/trimRight 各一次，四条表达式语句后返回。
发射造串一元模块|func() -> (IrModule,):
    var module = IrModule()
    module.types = 发射造打印类型池()
    module.texts = module.texts.append("ab")
    var nodes = IrNodePool()
    var literal = irMakeNode(kind = tagOfName(name = "stringConst"), typeId = 1)
    literal.text = 0
    let placedLiteral = irAppendNode(pool = nodes, node = literal)
    nodes = placedLiteral.pool
    var upper = irMakeNode(kind = tagOfName(name = "stringCase"), typeId = 1)
    upper.op = 1
    upper.kids = [placedLiteral.id]
    let placedUpper = irAppendNode(pool = nodes, node = upper)
    nodes = placedUpper.pool
    var lower = irMakeNode(kind = tagOfName(name = "stringCase"), typeId = 1)
    lower.op = 0
    lower.kids = [placedLiteral.id]
    let placedLower = irAppendNode(pool = nodes, node = lower)
    nodes = placedLower.pool
    var trimmedLeft = irMakeNode(kind = tagOfName(name = "stringTrimLeft"), typeId = 1)
    trimmedLeft.kids = [placedLiteral.id]
    let placedTrimLeft = irAppendNode(pool = nodes, node = trimmedLeft)
    nodes = placedTrimLeft.pool
    var trimmedRight = irMakeNode(kind = tagOfName(name = "stringTrimRight"), typeId = 1)
    trimmedRight.kids = [placedLiteral.id]
    let placedTrimRight = irAppendNode(pool = nodes, node = trimmedRight)
    nodes = placedTrimRight.pool
    var calls: Array<I32> = [placedUpper.id, placedLower.id, placedTrimLeft.id, placedTrimRight.id]
    var body: Array<I32> = []
    var i = 0
    while i < len(calls):
        var stmt = irMakeNode(kind = tagOfName(name = "exprStmt"), typeId = -1)
        stmt.kids = [calls[i]]
        let placed = irAppendNode(pool = nodes, node = stmt)
        nodes = placed.pool
        body = body.append(placed.id)
        i = i + 1
    var back = irMakeNode(kind = tagOfName(name = "returnStmt"), typeId = -1)
    let placedBack = irAppendNode(pool = nodes, node = back)
    nodes = placedBack.pool
    module.nodes = nodes
    body = body.append(placedBack.id)
    var fn = IrFunction()
    fn.name = "main"
    fn.returnType = -1
    fn.body = body
    module.functions = module.functions.append(fn)
    return module

; 串一元面：upper/lower 按 op 分符号，左右修剪各一条声明，四条都按一元进、串出。
字符串一元|test() -> ():
    let module = 发射造串一元模块()
    let result = emitModule(entry = 发射造记录(outputCode = 1), target = defaultTarget(), module = module)
    if result.failed:
        assert(false, "缺口：" + result.gaps[0])
    assert(发射含子串(text = result.text, needle = "call ptr @bk_string_upper(ptr "), "upper 应一元进、串出")
    assert(发射含子串(text = result.text, needle = "call ptr @bk_string_lower(ptr "), "lower 应一元进、串出")
    assert(发射含子串(text = result.text, needle = "call ptr @bk_string_trim_left(ptr "), "trimLeft 应一元进、串出")
    assert(发射含子串(text = result.text, needle = "call ptr @bk_string_trim_right(ptr "), "trimRight 应一元进、串出")
    assert(发射含子串(text = result.text, needle = "declare ptr @bk_string_upper(ptr)"), "upper 应出声明")
    assert(发射含子串(text = result.text, needle = "declare ptr @bk_string_lower(ptr)"), "lower 应出声明")
    assert(发射含子串(text = result.text, needle = "declare ptr @bk_string_trim_left(ptr)"), "trimLeft 应出声明")
    assert(发射含子串(text = result.text, needle = "declare ptr @bk_string_trim_right(ptr)"), "trimRight 应出声明")
    return

; 字符串与宿主面：双参串调用收成 i1 或 i32，无参内建按零参直呼，谓词把 i32 收成 i1。
字符串与宿主|test() -> ():
    let module = 发射造字符串模块()
    let result = emitModule(entry = 发射造记录(outputCode = 1), target = defaultTarget(), module = module)
    if result.failed:
        assert(false, "缺口：" + result.gaps[0])
    assert(发射含子串(text = result.text, needle = "call i32 @bk_string_contains(ptr %t0, ptr %t1)"), "contains 应两串进、i32 出")
    assert(发射含子串(text = result.text, needle = "icmp ne i32 %t2, 0"), "contains 应收成 i1")
    assert(发射含子串(text = result.text, needle = "call i32 @bk_string_index_of(ptr"), "indexOf 应两串进、i32 出")
    assert(发射含子串(text = result.text, needle = "call ptr @bk_module_root()"), "零参内建应按零参直呼")
    assert(发射含子串(text = result.text, needle = "call i32 @bk_exists(ptr"), "谓词内建应按 i32 出")
    assert(发射含子串(text = result.text, needle = "declare ptr @bk_module_root()"), "零参声明应无形参")
    return

; 容器模块：数组字面量、负下标读、切片各一次。
发射造下标模块|func() -> (IrModule,):
    var module = IrModule()
    var pool = IrTypePool()
    let intType = irScalarTypeOfCode(pool = pool, code = 1, name = "i32")
    pool = intType.pool
    let arrayType = irWrapTypeOfCode(pool = pool, code = 12, name = "", inner = intType.id)
    module.types = arrayType.pool
    var nodes = IrNodePool()
    var literal = irMakeNode(kind = tagOfName(name = "arrayLiteral"), typeId = 1)
    let placedLiteral = irAppendNode(pool = nodes, node = literal)
    nodes = placedLiteral.pool
    var alloc = irMakeNode(kind = tagOfName(name = "allocVar"), typeId = 1)
    alloc.intValue = 0
    alloc.kids = [placedLiteral.id]
    let placedAlloc = irAppendNode(pool = nodes, node = alloc)
    nodes = placedAlloc.pool
    var base = irMakeNode(kind = tagOfName(name = "load"), typeId = 1)
    base.intValue = 0
    let placedBase = irAppendNode(pool = nodes, node = base)
    nodes = placedBase.pool
    var minusOne = irMakeNode(kind = tagOfName(name = "intConst"), typeId = 0)
    minusOne.intValue = 0 - 1
    let placedMinus = irAppendNode(pool = nodes, node = minusOne)
    nodes = placedMinus.pool
    var read = irMakeNode(kind = tagOfName(name = "subscriptGet"), typeId = 0)
    read.kids = [placedBase.id, placedMinus.id]
    let placedRead = irAppendNode(pool = nodes, node = read)
    nodes = placedRead.pool
    var printed = irMakeNode(kind = tagOfName(name = "printCall"), typeId = -1)
    printed.kids = [placedRead.id]
    let placedPrintCall = irAppendNode(pool = nodes, node = printed)
    nodes = placedPrintCall.pool
    var printStmt = irMakeNode(kind = tagOfName(name = "exprStmt"), typeId = -1)
    printStmt.kids = [placedPrintCall.id]
    let placedPrint = irAppendNode(pool = nodes, node = printStmt)
    nodes = placedPrint.pool
    var zero = irMakeNode(kind = tagOfName(name = "intConst"), typeId = 0)
    let placedZero = irAppendNode(pool = nodes, node = zero)
    nodes = placedZero.pool
    var again = irMakeNode(kind = tagOfName(name = "load"), typeId = 1)
    again.intValue = 0
    let placedAgain = irAppendNode(pool = nodes, node = again)
    nodes = placedAgain.pool
    var two = irMakeNode(kind = tagOfName(name = "intConst"), typeId = 0)
    two.intValue = 2
    let placedTwo = irAppendNode(pool = nodes, node = two)
    nodes = placedTwo.pool
    var sliced = irMakeNode(kind = tagOfName(name = "sliceCall"), typeId = 1)
    sliced.kids = [placedAgain.id, placedZero.id, placedTwo.id]
    let placedSliced = irAppendNode(pool = nodes, node = sliced)
    nodes = placedSliced.pool
    var sliceStmt = irMakeNode(kind = tagOfName(name = "exprStmt"), typeId = -1)
    sliceStmt.kids = [placedSliced.id]
    let placedSliceStmt = irAppendNode(pool = nodes, node = sliceStmt)
    nodes = placedSliceStmt.pool
    var back = irMakeNode(kind = tagOfName(name = "returnStmt"), typeId = -1)
    let placedBack = irAppendNode(pool = nodes, node = back)
    nodes = placedBack.pool
    module.nodes = nodes
    var fn = IrFunction()
    fn.name = "main"
    fn.returnType = -1
    fn.body = [placedAlloc.id, placedPrint.id, placedSliceStmt.id, placedBack.id]
    module.functions = module.functions.append(fn)
    return module

; 容器面：负下标先取长度再换算，切片夹界后建新句柄并逐元素搬。
下标与切片|test() -> ():
    let module = 发射造下标模块()
    let result = emitModule(entry = 发射造记录(outputCode = 1), target = defaultTarget(), module = module)
    if result.failed:
        assert(false, "缺口：" + result.gaps[0])
    assert(发射含子串(text = result.text, needle = "call i32 @bk_array_len(ptr %t1)"), "负下标应先取长度")
    assert(发射含子串(text = result.text, needle = "select i1 %t3, i32 %t4, i32 -1"), "负下标应按尾计数换算")
    assert(发射含子串(text = result.text, needle = "call ptr @bk_array_get(ptr %t1, i32 %t5)"), "下标读应取元素地址")
    assert(发射含子串(text = result.text, needle = "call ptr @bk_array_create(i32 %t"), "切片应先建新句柄")
    assert(发射含子串(text = result.text, needle = "call ptr @bk_array_set(ptr"), "切片应逐元素写新句柄")
    assert(发射含子串(text = result.text, needle = "br label %slice.cond.0"), "切片应进循环")
    return

; 测试发射计划：一个组、一条选中，格式串只要非空即可，措辞归调用方。
发射造测试计划|func(selection: Array<String>,) -> (EmitTestPlan,):
    var plan = EmitTestPlan()
    plan.header = "测试目标: 工作区 /w（1 个测试 target）"
    plan.selection = selection
    var group = EmitTestGroup()
    group.label = "pkg / target"
    group.basePath = "/w/pkg"
    group.firstTest = 0
    group.count = len(selection)
    plan.groups = [group]
    plan.fmtGroup = "包 %s（%d 个测试，%d 通过）\n"
    plan.fmtGroupSkipped = "包 %s（%d 个测试，--skip 全数排除）\n"
    plan.fmtFail = " ✗ %s: %s\n"
    plan.fmtResult = "结果: %d 通过, %d 失败\n"
    return plan

; 测试模式：测试函数里的断言置失败位并返回，跑器、入口与切基准由发射器合成。
测试模式发射|test() -> ():
    var module = 发射造打印模块()
    var fn = module.functions[0]
    fn.name = "probeTest"
    fn.isTest = true
    module.functions[0] = fn
    let plan = 发射造测试计划(selection = ["probeTest"])
    let result = emitTestModule(entry = 发射造记录(outputCode = 1), target = defaultTarget(), module = module, plan = plan)
    if result.failed:
        assert(false, "缺口：" + result.detail)
    assert(发射含子串(text = result.text, needle = "define i32 @__pini_test_main() {"), "应合成跑器")
    assert(发射含子串(text = result.text, needle = "define i32 @main() {"), "应合成进程入口")
    assert(发射含子串(text = result.text, needle = "@__pini_test_failed = internal global i32 0"), "应有失败位")
    assert(发射含子串(text = result.text, needle = "store i32 1, ptr @__pini_test_failed"), "断言失败应置位")
    assert(发射含子串(text = result.text, needle = "call void @probeTest()"), "跑器应调用选中测试")
    assert(发射含子串(text = result.text, needle = "call void @bk_set_program_base(ptr"), "组首应切基准")
    assert(!发射含子串(text = result.text, needle = "call void @bk_panic"), "测试态不应走陷阱")
    let normal = emitModule(entry = 发射造记录(outputCode = 1), target = defaultTarget(), module = module)
    assert(发射含子串(text = normal.text, needle = "call void @bk_panic"), "普通态仍走陷阱")
    return

; 测试计划校验：选中名不在模块里即拒发，不合成一份少跑一条的跑器。
测试计划拒发|test() -> ():
    let module = 发射造打印模块()
    let plan = 发射造测试计划(selection = ["没有这条"])
    let result = emitTestModule(entry = 发射造记录(outputCode = 1), target = defaultTarget(), module = module, plan = plan)
    assert(result.failed, "缺测试应拒发")
    assert(发射含子串(text = result.detail, needle = "测试函数不在模块里"), "应指出缺哪条")
    return

; 指针池：i32 在前，`*i32` 在后；类别码 21 即指针。
发射造指针池|func() -> (IrTypePool,):
    var pool = IrTypePool()
    let intType = irScalarTypeOfCode(pool = pool, code = 1, name = "i32")
    pool = intType.pool
    let pointer = irWrapTypeOfCode(pool = pool, code = 21, name = "", inner = 0)
    return pointer.pool

; 指针读写：取址、写、读都直出指令，不经运行时段。
指针读写|test() -> ():
    var module = IrModule()
    module.types = 发射造指针池()
    var nodes = IrNodePool()
    var literal = irMakeNode(kind = tagOfName(name = "intConst"), typeId = 0)
    literal.intValue = 7
    let placedLiteral = irAppendNode(pool = nodes, node = literal)
    nodes = placedLiteral.pool
    var alloc = irMakeNode(kind = tagOfName(name = "allocVar"), typeId = 0)
    alloc.intValue = 0
    alloc.kids = [placedLiteral.id]
    let placedAlloc = irAppendNode(pool = nodes, node = alloc)
    nodes = placedAlloc.pool
    var address = irMakeNode(kind = tagOfName(name = "addressOfVar"), typeId = 1)
    address.intValue = 0
    let placedAddress = irAppendNode(pool = nodes, node = address)
    nodes = placedAddress.pool
    var nine = irMakeNode(kind = tagOfName(name = "intConst"), typeId = 0)
    nine.intValue = 9
    let placedNine = irAppendNode(pool = nodes, node = nine)
    nodes = placedNine.pool
    var store = irMakeNode(kind = tagOfName(name = "pointerStore"), typeId = -1)
    store.kids = [placedAddress.id, placedNine.id]
    let placedStore = irAppendNode(pool = nodes, node = store)
    nodes = placedStore.pool
    var stmt = irMakeNode(kind = tagOfName(name = "exprStmt"), typeId = -1)
    stmt.kids = [placedStore.id]
    let placedStmt = irAppendNode(pool = nodes, node = stmt)
    nodes = placedStmt.pool
    var load = irMakeNode(kind = tagOfName(name = "pointerLoad"), typeId = 0)
    load.kids = [placedAddress.id]
    let placedLoad = irAppendNode(pool = nodes, node = load)
    nodes = placedLoad.pool
    var back = irMakeNode(kind = tagOfName(name = "returnStmt"), typeId = -1)
    back.kids = [placedLoad.id]
    let placedBack = irAppendNode(pool = nodes, node = back)
    nodes = placedBack.pool
    module.nodes = nodes
    var fn = IrFunction()
    fn.name = "main"
    fn.returnType = 0
    fn.body = [placedAlloc.id, placedStmt.id, placedBack.id]
    module.functions = module.functions.append(fn)
    assert(supportsFamily(entry = 发射造记录(outputCode = 1), family = 7), "指针族应已声明")
    let result = emitModule(entry = 发射造记录(outputCode = 1), target = defaultTarget(), module = module)
    assert(!result.failed, "指针模块应发得出来")
    assert(发射含子串(text = result.text, needle = "store i32 9, ptr %s0"), "写应落到槽地址")
    assert(发射含子串(text = result.text, needle = "load i32, ptr %s0"), "读应从槽地址取")
    return

; 文件池：i32、字符串、空元组、结果四个类型。
发射造文件池|func() -> (IrTypePool,):
    var pool = IrTypePool()
    let intType = irScalarTypeOfCode(pool = pool, code = 1, name = "i32")
    pool = intType.pool
    let text = irScalarTypeOfCode(pool = pool, code = 8, name = "string")
    pool = text.pool
    let unit = irTupleType(pool = pool, fields = [])
    pool = unit.pool
    let outcome = irWrapTypeOfCode(pool = pool, code = 10, name = "", inner = unit.id)
    return outcome.pool

; 文件写与读：路径与内容按 C 串借出，读写各走一条运行时段入口。
文件读写|test() -> ():
    var module = IrModule()
    module.types = 发射造文件池()
    module.texts = ["out.txt", "hi"]
    var nodes = IrNodePool()
    var path = irMakeNode(kind = tagOfName(name = "stringConst"), typeId = 1)
    path.text = 0
    let placedPath = irAppendNode(pool = nodes, node = path)
    nodes = placedPath.pool
    var content = irMakeNode(kind = tagOfName(name = "stringConst"), typeId = 1)
    content.text = 1
    let placedContent = irAppendNode(pool = nodes, node = content)
    nodes = placedContent.pool
    var write = irMakeNode(kind = tagOfName(name = "fileWrite"), typeId = -1)
    write.kids = [placedPath.id, placedContent.id]
    let placedWrite = irAppendNode(pool = nodes, node = write)
    nodes = placedWrite.pool
    var stmt = irMakeNode(kind = tagOfName(name = "exprStmt"), typeId = -1)
    stmt.kids = [placedWrite.id]
    let placedStmt = irAppendNode(pool = nodes, node = stmt)
    nodes = placedStmt.pool
    var read = irMakeNode(kind = tagOfName(name = "fileRead"), typeId = 1)
    read.kids = [placedPath.id]
    let placedRead = irAppendNode(pool = nodes, node = read)
    nodes = placedRead.pool
    var back = irMakeNode(kind = tagOfName(name = "returnStmt"), typeId = -1)
    back.kids = [placedRead.id]
    let placedBack = irAppendNode(pool = nodes, node = back)
    nodes = placedBack.pool
    module.nodes = nodes
    var fn = IrFunction()
    fn.name = "main"
    fn.returnType = 1
    fn.body = [placedStmt.id, placedBack.id]
    module.functions = module.functions.append(fn)
    assert(supportsFamily(entry = 发射造记录(outputCode = 1), family = 8), "整份读写族应已声明")
    let result = emitModule(entry = 发射造记录(outputCode = 1), target = defaultTarget(), module = module)
    assert(!result.failed, "文件模块应发得出来")
    assert(发射含子串(text = result.text, needle = "call void @bk_write_file(ptr "), "写应走整份写入口")
    assert(发射含子串(text = result.text, needle = "call ptr @bk_read_file(ptr "), "读应走整份读入口")
    return

; 可接住写：错误字即返回值，聚合标签按是否有错置位。
可接住写|test() -> ():
    var module = IrModule()
    module.types = 发射造文件池()
    module.texts = ["out.txt", "hi"]
    var nodes = IrNodePool()
