    fn.body = [placedStmt.id, placedBack.id]
    module.functions = module.functions.append(fn)
    assert(supportsFamily(entry = 发射造记录(outputCode = 1), family = 9), "可接住读写族应已声明")
    let result = emitModule(entry = 发射造记录(outputCode = 1), target = defaultTarget(), module = module)
    assert(!result.failed, "可接住写应发得出来")
    assert(发射含子串(text = result.text, needle = "call i64 @bk_try_write_file(ptr "), "应走可接住写入口")
    assert(发射含子串(text = result.text, needle = "insertvalue { i64, ptr, i64 }"), "结果按三槽聚合拼回")
    return

; 读行：栈缓冲加 fgets，标准输入流与空串兜底一并出。
读行|test() -> ():
    var module = IrModule()
    module.types = 发射造文件池()
    var nodes = IrNodePool()
