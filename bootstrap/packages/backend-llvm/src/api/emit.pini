[emit|import]
_semantics = "../../../semantics"
_ir = "../../../ir"
_backend_kit = "../../../backend-kit"

; 发射入口：先类型声明，再逐函数；有体出定义，无体跳过，不编外部签名。
; 有缺口即整份不出：失败只回缺口清单，不落半份文本。
; 收尾按函数补：未由返回收口的块补 void 或 main 的零返回，保证每块有终结指令。

; 能力族：本后端声明为已接的族码，驱动按这份登记，测试也照抄，三处不再各写一串。
; 族码与 backend-kit 同序；未登记的族在缺口里写作「族未声明」，与「已声明但没接」分开。
llvmFamilies|func() -> (Array<I32>,):
    return [0, 1, 2, 3, 4, 5, 6, 10]

; 无体函数跳过：它是降载缺口，声明出来也只会在链接期报缺符号。
needsBody|func(fn: IrFunction,) -> (Bool,):
    return len(fn.body) > 0

; 收尾补返回：已收口的不补；main 补零，其余按声明返回类型补零值。
;  行不通  一律补 ret void：非空返回的函数会在校验期被判类型不符。
closeFunction|func(ctx: BodyCtx, module: IrModule,) -> (BodyCtx,):
    var out = ctx
    if out.closed:
        return out
    let fn = module.functions[out.fnIndex]
    out = releaseOwned(ctx = out, module = module)
    if fn.name == "main" && fn.returnType < 0:
        appendLine(sink = out.lines, text = "  ret i32 0")
    elif fn.returnType < 0:
        appendLine(sink = out.lines, text = "  ret void")
    else:
        let ty = llvmTypeName(pool = module.types, typeId = fn.returnType)
        appendLine(sink = out.lines, text = "  ret " + ty + " " + zeroTextOf(typeName = ty))
    out.closed = true
    return out

; 同名定义：模块里同名的第二份定义在链接期必撞，调用点也只认首个，故只发第一份。
alreadyEmitted|func(names: Array<String>, name: String,) -> (Bool,):
    var i = 0
    while i < len(names):
        if names[i] == name:
            return true
        i = i + 1
    return false

; 参数落槽：形参按各自槽位出 alloca 与 store，值名按位置编号。
; 形参份额由调用方交出，故槽本身是这一份的持有者，函数出口要还。
seedParams|func(ctx: BodyCtx, module: IrModule, fn: IrFunction,) -> (BodyCtx,):
    var out = ctx
    var i = 0
    while i < len(fn.params):
        let slot = fn.params[i].slot
        let ty = llvmTypeName(pool = module.types, typeId = fn.params[i].typeId)
        appendLine(sink = out.lines, text = "  " + slotName(slot = slot) + " = alloca " + ty)
        appendLine(sink = out.lines, text = "  store " + ty + " %p" + countText(i) + ", ptr " + slotName(slot = slot))
        if irHoldsShare(pool = module.types, typeId = fn.params[i].typeId):
            out.ownedSlots = out.ownedSlots.append(slotName(slot = slot))
            out.ownedTypes = out.ownedTypes.append(fn.params[i].typeId)
        i = i + 1
    return out

; 转抄：把旁支容器的行按序补进主容器。
; 函数体先写旁支，首块栈槽才能排在它前面：栈槽落在 entry 里，循环体里不再按次长栈。
copyLines|func(sink: LineSink, from: Array<String>,) -> ():
    var i = 0
    while i < len(from):
        appendLine(sink = sink, text = from[i])
        i = i + 1
    return

; 缺口合并：按类别全局去重，同一类只留一条；跨函数重复不再按函数计数。
mergeGap|func(gaps: Array<String>, gap: String,) -> (Array<String>,):
    var i = 0
    while i < len(gaps):
        if gaps[i] == gap:
            return gaps
        i = i + 1
    return gaps.append(gap)

; 发射：档次不是本机码即拒；缺口按类别去重，决定是否出文本。
emitModule|func(entry: BackendEntry, target: TargetProfile, module: IrModule,) -> (EmitResult,):
    if backendOutputCode(entry.output) != backendOutputNativeCode():
        return failedEmit(detail = "LLVM 后端不接受档次 " + backendOutputName(entry.output))
    var sink = LineSink()
    let head = llvmHeader(entry = entry, target = target)
    var i = 0
    while i < len(head):
        appendLine(sink = sink, text = head[i])
        i = i + 1
    let 类型行 = llvmTypeDecls(module = module)
    i = 0
    while i < len(类型行):
        appendLine(sink = sink, text = 类型行[i])
        i = i + 1
    var gaps: Array<String> = []
    let families = irContractFamilies()
    let builtins = builtinTable()
    var strings = StringPool()
    var externs = ExternUse()
    var emitted: Array<String> = []
    let 胶水 = llvmReleaseGlues(module = module)
    if len(胶水) > 0:
        ; 胶水体自己要用三条归还入口，登记一次，免得只在胶水里出现的符号漏声明。
        useExtern(use = externs, name = "bk_str_release")
        useExtern(use = externs, name = "bk_handle_release")
        useExtern(use = externs, name = "bk_nominal_release")
    i = 0
    while i < len(胶水):
        appendLine(sink = sink, text = 胶水[i])
        i = i + 1
    i = 0
    while i < len(module.functions):
        let fn = module.functions[i]
        if needsBody(fn = fn) && !alreadyEmitted(names = emitted, name = fn.name):
            emitted = emitted.append(fn.name)
            appendLine(sink = sink, text = llvmSignature(pool = module.types, fn = fn, isDefine = true) + " {")
            appendLine(sink = sink, text = "entry:")
            appendLine(sink = sink, text = "  " + boxName() + " = alloca [8 x i8], align 8")
            var body = LineSink()
            var ctx = BodyCtx()
            ctx.lines = body
            ctx.fnIndex = i
            ctx.families = families
            ctx.declared = entry.families
            ctx.strings = strings
            ctx.externs = externs
            ctx.builtins = builtins
            ctx.pointerBytes = target.pointerWidth
            ctx = seedParams(ctx = ctx, module = module, fn = fn)
            ctx = emitStmts(ctx = ctx, module = module, ids = fn.body)
            ctx = closeFunction(ctx = ctx, module = module)
            copyLines(sink = sink, from = ctx.head)
            copyLines(sink = sink, from = body.lines)
            var k = 0
            while k < len(ctx.gaps):
                gaps = mergeGap(gaps = gaps, gap = ctx.gaps[k])
                k = k + 1
            appendLine(sink = sink, text = "}")
        i = i + 1
    i = 0
    while i < externUseCount(use = externs):
        appendLine(sink = sink, text = externSignature(name = externs.names[i]))
        i = i + 1
    let formats = formatConstants()
    i = 0
    while i < len(formats):
        appendLine(sink = sink, text = formats[i])
        i = i + 1
    i = 0
    while i < len(strings.values):
        appendLine(sink = sink, text = stringGlobalLine(pool = strings, index = i))
        i = i + 1
    var result = EmitResult()
    result.detail = "llvm"
    result.gaps = gaps
    if len(gaps) > 0:
        result.failed = true
        return result
    result.text = sinkText(sink = sink)
    result.lines = sinkCount(sink = sink)
    return result
