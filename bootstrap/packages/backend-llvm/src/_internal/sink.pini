; 行容器：引用语义承载，追加就地增长；行数组若随上下文逐层传值，每次追加都会复制整段。
{LineSink}
lines: Array<String> = []

; 追加一行：唯一写入点，缩进由调用方拼好；写回字段后旧数组即释放。
appendLine|func(sink: LineSink, text: String,) -> ():
    sink.lines = sink.lines.append(text)

; 行数：与文本换行数相等，末尾恒有一个换行。
sinkCount|func(sink: LineSink,) -> (I32,):
    return len(sink.lines)

; 整份文本：按行拼接，末尾补一个换行。
sinkText|func(sink: LineSink,) -> (String,):
    return sink.lines.join("\n") + "\n"
