[builtins|import]
_ir = "../../../ir"

; 内建名映射：源码层内建名加接收者类别，落到运行时段符号与一种搬参形状。
; 表只登记符号与搬参法，指令由发射面按形状补；同形状加内建只加行，新形状先落发射面。
; 接收者类别取类型类别码：同名内建落在不同容器上就是两行，表外名字照旧报缺口。

; 形状码：一 句柄计数；二 元素追加；三 单参直呼；四 零参直呼；五 谓词；六 结果读取；
; 七 数组聚合等待；八 带时限等待。后两种把结算值写三槽后整块读回。
shapeHandleCount|func() -> (I32,):
    return 1

shapeElementAppend|func() -> (I32,):
    return 2

shapeDirectCall|func() -> (I32,):
    return 3

shapeZeroCall|func() -> (I32,):
    return 4

shapePredicate|func() -> (I32,):
    return 5

shapeTryRead|func() -> (I32,):
    return 6

shapeJoinAll|func() -> (I32,):
    return 7

shapeJoinWithin|func() -> (I32,):
    return 8

; 内建行：名字、接收者类别、符号与形状；`symbol` 空即未登记，调用方据此报缺口。
(BuiltinEntry)
name: String = ""
receiver: I32 = -1
symbol: String = ""
shape: I32 = 0

; 建行：四个字段一次给全，调用点漏一格会当场看出来。
makeBuiltinOf|func(name: String, receiver: I32, symbol: String, shape: I32,) -> (BuiltinEntry,):
    var out = BuiltinEntry()
    out.name = name
    out.receiver = receiver
    out.symbol = symbol
    out.shape = shape
    return out

; 内建表：一行一条；接收者类别码是类型类别（i32 一、u8 四、字串八、字符九、任务十一、数组十二、字典十六、集合十七）。
; 零参内建没有接收者，类别记负一，查表按名字与负一双命中。
builtinTable|func() -> (Array<BuiltinEntry>,):
    var out: Array<BuiltinEntry> = []
    out = out.append(makeBuiltinOf(name = "len", receiver = 12, symbol = "bk_array_len", shape = 1))
    out = out.append(makeBuiltinOf(name = "len", receiver = 16, symbol = "bk_dict_len", shape = 1))
    out = out.append(makeBuiltinOf(name = "len", receiver = 17, symbol = "bk_set_len", shape = 1))
    out = out.append(makeBuiltinOf(name = "len", receiver = 8, symbol = "bk_string_count", shape = 1))
    out = out.append(makeBuiltinOf(name = "chr", receiver = 1, symbol = "bk_chr", shape = 3))
    out = out.append(makeBuiltinOf(name = "ord", receiver = 9, symbol = "bk_ord", shape = 3))
    out = out.append(makeBuiltinOf(name = "chars", receiver = 8, symbol = "bk_chars", shape = 3))
    out = out.append(makeBuiltinOf(name = "tempUtf8Bytes", receiver = 8, symbol = "bk_temp_utf8_bytes", shape = 3))
    out = out.append(makeBuiltinOf(name = "tempByteToInt", receiver = 4, symbol = "bk_temp_byte_to_int", shape = 3))
    out = out.append(makeBuiltinOf(name = "tempIntToByte", receiver = 1, symbol = "bk_temp_int_to_byte", shape = 3))
    out = out.append(makeBuiltinOf(name = "listDir", receiver = 8, symbol = "bk_list_dir", shape = 3))
    out = out.append(makeBuiltinOf(name = "exists", receiver = 8, symbol = "bk_exists", shape = 5))
    out = out.append(makeBuiltinOf(name = "isDir", receiver = 8, symbol = "bk_is_dir", shape = 5))
    out = out.append(makeBuiltinOf(name = "argv", receiver = -1, symbol = "bk_argv", shape = 4))
    out = out.append(makeBuiltinOf(name = "moduleRoot", receiver = -1, symbol = "bk_module_root", shape = 4))
    ; 片睡：并发内建里唯一降载成普通调用的一个，落点是运行时入口而不是 libc。
    out = out.append(makeBuiltinOf(name = "sleep", receiver = 1, symbol = "bk_sleep", shape = 3))
    ; 取消：句柄进、无返回；同属并发族，落点也是运行时入口。
    out = out.append(makeBuiltinOf(name = "cancel", receiver = irFutureTypeTag(), symbol = "bk_task_cancel", shape = 3))
    ; 取回：C 串按 NUL 读成 Pini 串，入参是指针、出参是字串句柄，与单参直呼同形。
    out = out.append(makeBuiltinOf(name = "fromCString", receiver = 21, symbol = "bk_str_from_cstr", shape = 3))
    out = out.append(makeBuiltinOf(name = "Array.append", receiver = 12, symbol = "bk_array_append", shape = 2))
    ; 错误值：消息串进、擦除字出；取消错误只差标志位，判定经谓词入口。
    out = out.append(makeBuiltinOf(name = "Error", receiver = 8, symbol = "bk_error_create", shape = 3))
    out = out.append(makeBuiltinOf(name = "CancelError", receiver = 8, symbol = "bk_cancel_error_create", shape = 3))
    out = out.append(makeBuiltinOf(name = "isCancel", receiver = 2, symbol = "bk_error_is_cancel", shape = 5))
    ; 聚合等待：数组盒逐槽取句柄；带时限等待吃单个句柄与毫秒。
    out = out.append(makeBuiltinOf(name = "joinAll", receiver = 12, symbol = "bk_task_join_all_box", shape = 7))
    out = out.append(makeBuiltinOf(name = "joinWithin", receiver = 11, symbol = "bk_task_join_within", shape = 8))
    return out

; 查表：名字与接收者类别都对上才算命中；未命中答空行，不猜同族符号。
builtinLookup|func(table: Array<BuiltinEntry>, name: String, receiver: I32,) -> (BuiltinEntry,):
    var i = 0
    while i < len(table):
        let row = table[i]
        if row.name == name && row.receiver == receiver:
            return row
        i = i + 1
    return BuiltinEntry()
