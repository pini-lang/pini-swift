[decls|import]
_semantics = "../../../semantics"
_ir = "../../../ir"
_backend_kit = "../../../backend-kit"
_unicode = "../../../unicode"

; 声明面：函数头、形参表与符号拼写；有体出定义，无体出声明。
; 符号只按 IR 名编码一次；目标前缀留给外部符号，内部函数不带，两代之间符号不漂。
; 参数名按位置编号，与源码名字无关：源码名可能在模块里重复，槽位才是身份。

; 形参表：类型 + 位置名；无参答空串，调用点与定义共用这一份拼法。
; 闭包在形参前多一个 env 指针，与 `{ ptr, ptr }` 调用协议同序。
llvmParams|func(pool: IrTypePool, fn: IrFunction,) -> (String,):
    var out = ""
    if fn.isClosure:
        out = "ptr %env"
    var i = 0
    while i < len(fn.params):
        if len(out) > 0:
            out = out + ", "
        out = out + llvmTypeName(pool = pool, typeId = fn.params[i].typeId) + " %p" + countText(i)
        i = i + 1
    return out

; 返回类型：无返回类型答 void；main 例外按 i32 出，退出码由运行时约定。
llvmReturnType|func(pool: IrTypePool, fn: IrFunction,) -> (String,):
    if fn.name == "main" && fn.returnType < 0:
        return "i32"
    return llvmTypeName(pool = pool, typeId = fn.returnType)

; 函数头：define 或 declare 加返回类型、编码名与形参表。
llvmSignature|func(pool: IrTypePool, fn: IrFunction, isDefine: Bool,) -> (String,):
    var head = "declare"
    if isDefine:
        head = "define"
    return head + " " + llvmReturnType(pool = pool, fn = fn) + " @" + mangleName(name = fn.name) + "(" + llvmParams(pool = pool, fn = fn) + ")"

; 外部声明：名字保留 C 拼写，不做内部编码；变参在固定形参后留省略号。
llvmExternSignature|func(pool: IrTypePool, fn: IrExternFunction,) -> (String,):
    var out = "declare " + llvmTypeName(pool = pool, typeId = fn.returnType) + " @" + fn.name + "("
    var i = 0
    while i < len(fn.params):
        if i > 0:
            out = out + ", "
        out = out + llvmTypeName(pool = pool, typeId = fn.params[i])
        i = i + 1
    if fn.isVarargs:
        if len(fn.params) > 0:
            out = out + ", ..."
        else:
            out = out + "..."
    return out + ")"

; 名字键：按 NFC 归一，等价拼写（如分解形式）落到同一个键上。
nameKey|func(name: String,) -> (String,):
    let bytes = tempUtf8Bytes(name)
    let decoded = decodeUtf8(identifierKeyBytes(bytes = bytes, start = 0, end = len(bytes)))
    var out = ""
    var i = 0
    while i < len(decoded.scalars):
        out = out + "\(chr(decoded.scalars[i].code))"
        i = i + 1
    return out

; 非 ASCII：等价拼写只可能出现在这类名字上；纯 ASCII 名跳过归一扫描。
hasNonAscii|func(name: String,) -> (Bool,):
    let bytes = tempUtf8Bytes(name)
    var i = 0
    while i < len(bytes):
        if tempByteToInt(bytes[i]) >= 128:
            return true
        i = i + 1
    return false

; 函数表位置：先按原拼写查，未命中再按 NFC 键查等价拼写；都未命中答 -1。
; 发射器据此判调用点是内部还是外部，符号拼写取命中的声明名。
findIrFunctionIndex|func(module: IrModule, name: String,) -> (I32,):
    var i = 0
    while i < len(module.functions):
        if module.functions[i].name == name:
            return i
        i = i + 1
    if !hasNonAscii(name = name):
        return -1
    let key = nameKey(name = name)
    i = 0
    while i < len(module.functions):
        if nameKey(name = module.functions[i].name) == key:
            return i
        i = i + 1
    return -1
