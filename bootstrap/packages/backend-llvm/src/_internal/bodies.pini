[bodies|import]
_semantics = "../../../semantics"
_ir = "../../../ir"
_backend_kit = "../../../backend-kit"

; 函数体：表达式逐节点出临时值，语句按类别分派；未接的类别记缺口，不产占位指令。
; 临时值与标签按遍历序编号，同一模块两遍发射逐字节相同。
; 块终结按段记：返回收口的段不补跳转，两段都收口时整条分支也收口。

; 发射上下文：行容器、临时值水位、标签水位、循环帧、缺口与失败位；每函数一份。
; 行容器是引用，函数级状态是值：上下文复制便宜，状态也不互相污染。
{BodyCtx}
lines: LineSink = LineSink()
temp: I32 = 0
label: I32 = 0
gaps: Array<String> = []
failed: Bool = false
fnIndex: I32 = 0
closed: Bool = false
families: Array<I32> = []
declared: Array<I32> = []
strings: StringPool = StringPool()
externs: ExternUse = ExternUse()
builtins: Array<BuiltinEntry> = []
pointerBytes: I32 = 8
loopEnds: Array<String> = []
loopHeads: Array<String> = []
; 延迟体：按登记序存语句节点，`deferOwners` 记登记时的循环层数，跳出时据此筛。
deferIds: Array<I32> = []
deferOwners: Array<I32> = []
slotNames: Array<String> = []
slotUses: Array<I32> = []
head: Array<String> = []
held: Array<String> = []
heldTypes: Array<I32> = []
ownedSlots: Array<String> = []
ownedTypes: Array<I32> = []
pendingSlot: I32 = -1
testExit: Bool = false
; 断言位置表：只在测试态非空，条目是「节点下标 → 文件:行:列」的两串平行数组。
testLocNodes: Array<I32> = []
testLocTexts: Array<String> = []
taskDefs: TaskDefs = TaskDefs()
givenDefs: GivenDefs = GivenDefs()
lazyDefs: LazyRefDefs = LazyRefDefs()

; 表达式结果：上下文与值串；值串只给操作数，类型由所在指令给；flag 给并列的第二值串。
(ExprOut)
ctx: BodyCtx = BodyCtx()
text: String = ""
flag: String = "1"

; 临时值名：按水位编号，不按源码名。
tempName|func(index: I32,) -> (String,):
    return "%t" + countText(index)

; 槽名：按槽位编号；同名变量的不同声明因此在文本里也分得开。
slotName|func(slot: I32,) -> (String,):
    return "%s" + countText(slot)

; 槽名解析：同号槽在不同块里会被重新声明，故以最近一次声明为准；未声明时用默认名。
slotNameOf|func(ctx: BodyCtx, slot: I32,) -> (String,):
    if slot >= 0 && slot < len(ctx.slotNames):
        if len(ctx.slotNames[slot]) > 0:
            return ctx.slotNames[slot]
    return slotName(slot = slot)

; 槽名登记：两张并排数组一起补到目标位，后到的 defineSlot 才不会越界读用量表。
setSlotName|func(ctx: BodyCtx, slot: I32, name: String,) -> (BodyCtx,):
    var out = ctx
    if slot < 0:
        return out
    var names = out.slotNames
    var uses = out.slotUses
    while len(names) <= slot:
        names = names.append("")
        uses = uses.append(0)
    names[slot] = name
    out.slotNames = names
    out.slotUses = uses
    return out

; 槽声明：同号槽第几次声明就带第几号后缀，同名不同块的两条 alloca 才不撞。
defineSlot|func(ctx: BodyCtx, slot: I32,) -> (ExprOut,):
    var out = ExprOut()
    out.ctx = ctx
    var names = out.ctx.slotNames
    var uses = out.ctx.slotUses
    while len(names) <= slot:
        names = names.append("")
        uses = uses.append(0)
    var name = slotName(slot = slot)
    if uses[slot] > 0:
        name = slotName(slot = slot) + "." + countText(uses[slot])
    names[slot] = name
    uses[slot] = uses[slot] + 1
    out.ctx.slotNames = names
    out.ctx.slotUses = uses
    out.text = name
    return out

; 份额账：本次求值造出、尚无接收方的新份额，语句收尾时统一归还。
; 只记类型不记类码：归还入口与释放胶水都按类型查表，多记一份类码就有两处会走偏。
holdShare|func(ctx: BodyCtx, name: String, typeId: I32,) -> (BodyCtx,):
    var out = ctx
    out.held = out.held.append(name)
    out.heldTypes = out.heldTypes.append(typeId)
    return out

; 在账判定：同名仍在账上，说明这一份还没交出去，接收方可以直接取走。
isHeld|func(ctx: BodyCtx, name: String,) -> (Bool,):
    var i = 0
    while i < len(ctx.held):
        if ctx.held[i] == name:
            return true
        i = i + 1
    return false

; 销账：份额随值交给接收方，语句收尾不再归还。
forgetShare|func(ctx: BodyCtx, name: String,) -> (BodyCtx,):
    var out = ctx
    var names: Array<String> = []
    var types: Array<I32> = []
    var i = 0
    while i < len(out.held):
        if out.held[i] != name:
            names = names.append(out.held[i])
            types = types.append(out.heldTypes[i])
        i = i + 1
    out.held = names
    out.heldTypes = types
    return out

; 还入口名：按族码选；字符是内联值，运行时不按计数持有，故族码 0 不给入口。
releaseSymbolOf|func(family: I32,) -> (String,): ; 入参是族码，不是细分码也不是类型下标
    if family == 1:
        return "bk_str_release"
    if family == 2:
        return "bk_handle_release"
    if family == 3:
        return "bk_nominal_release"
    return ""

; 留入口名：与还入口同族配对；名义箱的保留不带返回值。
retainSymbolOf|func(family: I32,) -> (String,): ; 入参是族码：0 答空串即静默不动作，误传类型下标就是这后果
    if family == 1:
        return "bk_str_retain"
    if family == 2:
        return "bk_handle_retain"
    if family == 3:
        return "bk_nominal_retain"
    return ""

; 整块聚合留份：与归还同一份成员名单、同一个按标签选择的口径，两侧因此恒对称。
retainAggregateValue|func(ctx: BodyCtx, module: IrModule, name: String, typeId: I32,) -> (BodyCtx,):
    var out = ctx
    let entry = irTypeAt(pool = module.types, id = typeId)
    let tag = irTypeTag(entry.kind)
    let aggregate = llvmTypeName(pool = module.types, typeId = typeId)
    if tag == irTypeTag(.irTypeOptional):
        if len(entry.kids) == 0:
            return out
        let memberType = entry.kids[0]
        if !irHoldsShare(pool = module.types, typeId = memberType):
            return out
        let memberEntry = irTypeAt(pool = module.types, id = memberType)
        if irTypeTag(memberEntry.kind) != irTypeTag(.irTypeNominal) || memberEntry.flags % 2 == 0:
            return out
        let memberSpelling = llvmTypeName(pool = module.types, typeId = memberType)
        let tagAt = out.temp
        out.temp = tagAt + 1
        let tagText = tempName(index = tagAt)
        appendLine(sink = out.lines, text = "  " + tagText + " = extractvalue " + aggregate + " " + name + ", 0")
        let cmpAt = out.temp
        out.temp = cmpAt + 1
        let cmpText = tempName(index = cmpAt)
        appendLine(sink = out.lines, text = "  " + cmpText + " = icmp eq i64 " + tagText + ", 0")
        let valueAt = out.temp
        out.temp = valueAt + 1
        let valueText = tempName(index = valueAt)
        appendLine(sink = out.lines, text = "  " + valueText + " = extractvalue " + aggregate + " " + name + ", 1")
        let chosenAt = out.temp
        out.temp = chosenAt + 1
        let chosen = tempName(index = chosenAt)
        appendLine(sink = out.lines, text = "  " + chosen + " = select i1 " + cmpText + ", " + memberSpelling + " " + valueText + ", " + memberSpelling + " " + zeroTextOf(typeName = memberSpelling))
        return adoptValue(ctx = out, module = module, name = chosen, typeId = memberType, adopt = 3)
    if tag == irTypeTag(.irTypeTuple):
        var i = 0
        while i < len(entry.kids):
            let memberType = entry.kids[i]
            if irHoldsShare(pool = module.types, typeId = memberType):
                let memberAt = out.temp
                out.temp = memberAt + 1
                let memberText = tempName(index = memberAt)
                appendLine(sink = out.lines, text = "  " + memberText + " = extractvalue " + aggregate + " " + name + ", " + countText(i))
                out = adoptValue(ctx = out, module = module, name = memberText, typeId = memberType, adopt = 3)
            i = i + 1
        return out
    return out

; 整块聚合归还：可选与结果只还选中的载荷，元组逐成员还；未选中的槽按零值跳过。
;  行不通  直接 extractvalue 未选中槽去归还：那格是 undef，读到的是栈垃圾。
releaseAggregateValue|func(ctx: BodyCtx, module: IrModule, name: String, typeId: I32,) -> (BodyCtx,):
    var out = ctx
    let entry = irTypeAt(pool = module.types, id = typeId)
    let tag = irTypeTag(entry.kind)
    let aggregate = llvmTypeName(pool = module.types, typeId = typeId)
    if tag == irTypeTag(.irTypeOptional):
        if len(entry.kids) == 0:
            return out
        let memberType = entry.kids[0]
        if !irHoldsShare(pool = module.types, typeId = memberType):
            return out
        let memberEntry = irTypeAt(pool = module.types, id = memberType)
        if irTypeTag(memberEntry.kind) != irTypeTag(.irTypeNominal) || memberEntry.flags % 2 == 0:
            return out
        let memberSpelling = llvmTypeName(pool = module.types, typeId = memberType)
        let tagAt = out.temp
        out.temp = tagAt + 1
        let tagText = tempName(index = tagAt)
        appendLine(sink = out.lines, text = "  " + tagText + " = extractvalue " + aggregate + " " + name + ", 0")
        let cmpAt = out.temp
        out.temp = cmpAt + 1
        let cmpText = tempName(index = cmpAt)
        appendLine(sink = out.lines, text = "  " + cmpText + " = icmp eq i64 " + tagText + ", 0")
        let valueAt = out.temp
        out.temp = valueAt + 1
        let valueText = tempName(index = valueAt)
        appendLine(sink = out.lines, text = "  " + valueText + " = extractvalue " + aggregate + " " + name + ", 1")
        let chosenAt = out.temp
        out.temp = chosenAt + 1
        let chosen = tempName(index = chosenAt)
        appendLine(sink = out.lines, text = "  " + chosen + " = select i1 " + cmpText + ", " + memberSpelling + " " + valueText + ", " + memberSpelling + " " + zeroTextOf(typeName = memberSpelling))
        return releaseValue(ctx = out, module = module, name = chosen, typeId = memberType)
    if tag == irTypeTag(.irTypeTuple):
        var i = 0
        while i < len(entry.kids):
            let memberType = entry.kids[i]
            if irHoldsShare(pool = module.types, typeId = memberType):
                let memberAt = out.temp
                out.temp = memberAt + 1
                let memberText = tempName(index = memberAt)
                appendLine(sink = out.lines, text = "  " + memberText + " = extractvalue " + aggregate + " " + name + ", " + countText(i))
                out = releaseValue(ctx = out, module = module, name = memberText, typeId = memberType)
            i = i + 1
        return out
    return out

; 归还一个已具名的值：名义箱先走逐类型胶水，归还其字段后再还箱本身。
;  注意  值语义箱按名义族记账；按细分码认会把它整族漏掉。
releaseValue|func(ctx: BodyCtx, module: IrModule, name: String, typeId: I32,) -> (BodyCtx,):
    var out = ctx
    if len(name) == 0:
        return out
    if irShareClassOf(pool = module.types, typeId = typeId) == 2 && irHoldsShare(pool = module.types, typeId = typeId):
        return releaseAggregateValue(ctx = out, module = module, name = name, typeId = typeId)
    let family = irRetainFamilyOf(pool = module.types, typeId = typeId) ; 族码已含值语义箱；细分码答 0 会漏还整族
    if family == 3:
        ; 没有声明条目的名义类型发不出胶水，退回只还箱体：漏字段，但不会引用未定义符号。
        if releaseGlueExists(module = module, typeId = typeId):
            let glue = releaseGlueName(typeId = typeId)
            useExtern(use = out.externs, name = glue)
            appendLine(sink = out.lines, text = "  call void @" + glue + "(ptr " + name + ")")
            return out
        useExtern(use = out.externs, name = "bk_nominal_release")
        appendLine(sink = out.lines, text = "  call i32 @bk_nominal_release(ptr " + name + ")")
        return out
    let symbol = releaseSymbolOf(family = family)
    if len(symbol) == 0:
        return out
    useExtern(use = out.externs, name = symbol)
    appendLine(sink = out.lines, text = "  call void @" + symbol + "(ptr " + name + ")")
    return out

; 语句收尾：把没交出去的份额逐条归还并清账。
;  行不通  在已收口的块上补指令：终结指令之后不得再有指令，那几条留给进程退出。
flushHeld|func(ctx: BodyCtx, module: IrModule,) -> (BodyCtx,):
    var out = ctx
    var emptied: Array<String> = []
    var emptiedTypes: Array<I32> = []
    var i = 0
    while !out.closed && i < len(out.held):
        out = releaseValue(ctx = out, module = module, name = out.held[i], typeId = out.heldTypes[i])
        i = i + 1
    out.held = emptied
    out.heldTypes = emptiedTypes
    return out

; 段内归还：只还第 keep 条之后记的账，之前那几条属于外层块，留到外层收尾。
; 用在右支这类自带块的子求值上：那里造的值出了本块就没有支配关系，不能再带出去。
flushHeldFrom|func(ctx: BodyCtx, module: IrModule, keep: I32,) -> (BodyCtx,):
    var out = ctx
    var i = keep
    while i < len(out.held):
        out = releaseValue(ctx = out, module = module, name = out.held[i], typeId = out.heldTypes[i])
        i = i + 1
    var names: Array<String> = []
    var types: Array<I32> = []
    var k = 0
    while k < keep && k < len(out.held):
        names = names.append(out.held[k])
        types = types.append(out.heldTypes[k])
        k = k + 1
    out.held = names
    out.heldTypes = types
    return out

; 接收动作：移交取走账上那一份，保留则另加一份给接收方。
; 新份额已被前一个接收点取走时按保留处理，同名两处存不会共用一份。
adoptValue|func(ctx: BodyCtx, module: IrModule, name: String, typeId: I32, adopt: I32,) -> (BodyCtx,):
    var out = ctx
    if adopt == 0 || len(name) == 0:
        return out
    if irShareClassOf(pool = module.types, typeId = typeId) == 2:
        if adopt == 3 && irHoldsShare(pool = module.types, typeId = typeId):
            return retainAggregateValue(ctx = out, module = module, name = name, typeId = typeId)
        ; 聚合移交同样要销账：账上还挂着，语句末尾会再还一次，槽里就成了悬垂。
        if adopt == 1 && isHeld(ctx = out, name = name):
            return forgetShare(ctx = out, name = name)
        return out
    let family = irRetainFamilyOf(pool = module.types, typeId = typeId) ; 族码已含值语义箱；细分码答 0 则它从不留份
    if family == 0:
        return out
    if adopt == 1 && isHeld(ctx = out, name = name):
        return forgetShare(ctx = out, name = name)
    let symbol = retainSymbolOf(family = family)
    if len(symbol) == 0:
        return out
    useExtern(use = out.externs, name = symbol)
    appendLine(sink = out.lines, text = "  call void @" + symbol + "(ptr " + name + ")")
    return out

; 存储点接收：值语义结构体先拷出独立的一份，其余动作原样交给份额账。
; 返回新值串：拷贝时是拷出的临时名，调用点必须拿它去 store，不能用原值串。
;  行不通  只留一份份额：别名与源箱共用一个箱，改副本会写回源处。
adoptAtStore|func(ctx: BodyCtx, module: IrModule, name: String, typeId: I32, adopt: I32,) -> (ExprOut,):
    var out = ExprOut()
    out.ctx = ctx
    out.text = name
    if adopt != 2 || len(name) == 0:
        out.ctx = adoptValue(ctx = out.ctx, module = module, name = name, typeId = typeId, adopt = adopt)
        return out
    if !copyGlueExists(module = module, typeId = typeId):
        ; 发不出胶水的类型退回保留：共享是可观察的偏差，悬垂不是。
        out.ctx = adoptValue(ctx = out.ctx, module = module, name = name, typeId = typeId, adopt = 3)
        return out
    let id = out.ctx.temp
    out.ctx.temp = id + 1
    let copied = tempName(index = id)
    appendLine(sink = out.ctx.lines, text = "  " + copied + " = call ptr @" + copyGlueName(typeId = typeId) + "(ptr " + name + ")")
    out.text = copied
    return out

; 最左叶子槽：拼接与追加都把最左操作数当接收者，顺着左子树往下找到读槽为止。
;  行不通  不认自赋值：x = x.append(y) 返回的可能就是同一个箱，覆盖时再还一次就把槽里的值还成悬垂。
leftLeafSlot|func(module: IrModule, nodeId: I32, depth: I32,) -> (I32,):
    if nodeId < 0 || nodeId >= irNodeCount(module.nodes) || depth > 8:
        return -1
    let node = irNodeAt(pool = module.nodes, id = nodeId)
    if node.kind == 5:
        return node.intValue as I32
    if node.kind == 6 || node.kind == 8:
        if len(node.kids) > 0:
            return leftLeafSlot(module = module, nodeId = node.kids[0], depth = depth + 1)
    return -1

; 最左叶子的字段号：字段写右侧若从同一个字段起步，追加返回的箱可能复用同一块存储。
;  行不通  照常还旧值：新值脚下的存储就是旧值那块，还掉它等于把刚写进去的值还成悬垂。
leftLeafFieldOp|func(module: IrModule, nodeId: I32, depth: I32,) -> (I32,):
    if nodeId < 0 || nodeId >= irNodeCount(module.nodes) || depth > 8:
        return -1
    let node = irNodeAt(pool = module.nodes, id = nodeId)
    if node.kind == 28:
        return node.op
    if node.kind == 6 || node.kind == 8 || node.kind == 21:
        if len(node.kids) > 0:
            return leftLeafFieldOp(module = module, nodeId = node.kids[0], depth = depth + 1)
    return -1

; 旧值归还：覆盖槽或字段之前先还旧份额；容器元素由运行时在写入口归还，不走这条。
releaseOldValue|func(ctx: BodyCtx, module: IrModule, at: String, typeId: I32,) -> (BodyCtx,):
    var out = ctx
    if !irHoldsShare(pool = module.types, typeId = typeId):
        return out
    let typeName = llvmTypeName(pool = module.types, typeId = typeId)
    let id = out.temp
    out.temp = id + 1
    let name = tempName(index = id)
    appendLine(sink = out.lines, text = "  " + name + " = load " + typeName + ", ptr " + at)
    return releaseValue(ctx = out, module = module, name = name, typeId = typeId)

; 函数出口：本函数的槽与形参逐格归还；格子已在首块清零，未赋值的格是空指针。
releaseOwned|func(ctx: BodyCtx, module: IrModule,) -> (BodyCtx,):
    var out = ctx
    var i = 0
    while i < len(out.ownedSlots):
        out = releaseOldValue(ctx = out, module = module, at = out.ownedSlots[i], typeId = out.ownedTypes[i])
        i = i + 1
    return out

; 标签名：前缀加编号，前缀只作可读性，不参与判等。
labelName|func(prefix: String, index: I32,) -> (String,):
    return prefix + countText(index)

; 装箱台：函数入口的一块固定缓冲，追加元素时把值存进去再交地址。
; 它必须留在入口：放在循环体里会按次长栈，追加正是循环里最常见的一步。
boxName|func() -> (String,):
    return "%ebox"

; 记缺口：去重后追加；同一类别码只留一条，行数不随节点数膨胀。
addGap|func(ctx: BodyCtx, gap: String,) -> (BodyCtx,):
    var out = ctx
    out.failed = true
    var i = 0
    while i < len(out.gaps):
        if out.gaps[i] == gap:
            return out
        i = i + 1
    out.gaps = out.gaps.append(gap)
    return out

; 族已声明：族码在记录表里即算；空表表示不声明任何族。
hasFamily|func(ids: Array<I32>, family: I32,) -> (Bool,):
    var i = 0
    while i < len(ids):
        if ids[i] == family:
            return true
        i = i + 1
    return false

; 缺口按声明写：先认类别码，再认族；族未声明与「族已声明但没接」分开说，不混成一类。
nodeGap|func(ctx: BodyCtx, kind: I32,) -> (String,):
    var family = -1
    if kind >= 0 && kind < len(ctx.families):
        family = ctx.families[kind]
    if family < 0:
        return "类别码 " + countText(kind) + " 不在契约表"
    if !hasFamily(ids = ctx.declared, family = family):
        return "族未声明 " + backendFamilyName(code = family) + " 类别码 " + countText(kind)
    return "类别码 " + countText(kind) + " 未接"

; 节点类型是否为浮点：二元与一元据此换指令族。
isFloatNode|func(module: IrModule, nodeId: I32,) -> (Bool,):
    return typeTagOf(module = module, nodeId = nodeId) == 6

; 节点类型的类别码：容器分派与内建查表都按它判，取不到答负一。
typeTagOf|func(module: IrModule, nodeId: I32,) -> (I32,):
    if nodeId < 0 || nodeId >= irNodeCount(module.nodes):
        return -1
    return typeTagAt(module = module, typeId = irNodeAt(pool = module.nodes, id = nodeId).typeId)

; 类型下标的类别码：越界答负一；装箱报缺口时也用它点名。
typeTagAt|func(module: IrModule, typeId: I32,) -> (I32,):
    if typeId < 0 || typeId >= irTypeCount(module.types):
        return -1
    return irTypeTag(irTypeAt(pool = module.types, id = typeId).kind)

; 串族判据：只有串能在拼接里把旧份交出去（ownsLhs），其余自赋值一律还旧箱。
isStringShare|func(module: IrModule, typeId: I32,) -> (Bool,):
    let tag = typeTagAt(module = module, typeId = typeId)
    return tag == 8 || tag == 23

; 整数宽度：只认整数与布尔六类，其余答零；转换方向按它判。
intWidthOf|func(tag: I32,) -> (I32,):
    if tag == 7:
        return 1
    if tag == 4 || tag == 5:
        return 8
    if tag == 1:
        return 32
    if tag == 2 || tag == 3:
        return 64
    return 0

; 无符号类别：u8 与 u64 两类；加宽与转浮点按它选零扩展还是符号扩展。
isUnsignedTag|func(tag: I32,) -> (Bool,):
    return tag == 3 || tag == 4

; 调用接收者类别：首个实参即接收者；无实参答负一，命不中任何内建行。
receiverTagOf|func(module: IrModule, node: IrNode,) -> (I32,):
    if len(node.kids) == 0:
        return -1
    return typeTagOf(module = module, nodeId = node.kids[0])

; 零值常量：按拼写给，聚合用零初始化；存储与构造清格共用这一份判据。
zeroTextOf|func(typeName: String,) -> (String,):
    if typeName == "double":
        return "0.0"
    if typeName == "ptr":
        return "null"
    if typeName.indexOf("{") == 0:
        return "zeroinitializer"
    if typeName == "void":
        return "null"
    return "0"

; 二元指令：整数一套，浮点一套；min/max 走比较加选择，其余直出。
binaryOpText|func(op: I32, isFloat: Bool,) -> (String,):
    if op == 1:
        if isFloat:
            return "fadd"
        return "add"
    if op == 2:
        if isFloat:
            return "fsub"
        return "sub"
    if op == 3:
        if isFloat:
            return "fmul"
        return "mul"
    if op == 4:
        if isFloat:
            return "fdiv"
        return "sdiv"
    if op == 5:
        return "srem"
    if op == 6:
        if isFloat:
            return "fcmp oeq"
        return "icmp eq"
    if op == 7:
        if isFloat:
            return "fcmp une"
        return "icmp ne"
    if op == 8:
        if isFloat:
            return "fcmp olt"
        return "icmp slt"
    if op == 9:
        if isFloat:
            return "fcmp ole"
        return "icmp sle"
    if op == 10:
        if isFloat:
            return "fcmp ogt"
        return "icmp sgt"
    if op == 11:
        if isFloat:
            return "fcmp oge"
        return "icmp sge"
    if op == 12:
        return "and"
    if op == 13:
        return "or"
    if op == 14:
        return "xor"
    if op == 15:
        return "shl"
    if op == 16:
        return "ashr"
    return ""

; 一元指令：取负写 sub 零减，取反写异或全一，逻辑非写比较；绝对值走选择，转换另计。
unaryOpText|func(op: I32,) -> (String,):
    if op == 1:
        return "sub"
    if op == 2:
        return "icmp eq"
    if op == 3:
        return "xor"
    return ""

; 外部名到运行时符号：`toCString` 在边界上换成 shim 名，其余按原名交链接器。
runtimeSymbolOf|func(name: String,) -> (String,):
    if name == "toCString":
        return "bk_cstr"
    return name

; 表达式：先按份额判据记账，再发本节点；新份额留给语句收尾归还。
; 判据来自中端：节点求值造出份额即入账，借用与不参与不入账，本层不按拼写反推。
emitExpr|func(ctx: BodyCtx, module: IrModule, nodeId: I32,) -> (ExprOut,):
    var out = emitExprCore(ctx = ctx, module = module, nodeId = nodeId)
    if nodeId < 0 || nodeId >= irNodeCount(module.nodes):
        return out
    if len(out.text) == 0:
        return out
    if irShareEffectOf(pool = module.types, nodes = module.nodes, nodeId = nodeId) != 1:
        return out
    let heldType = irNodeAt(pool = module.nodes, id = nodeId).typeId
    ;  注意  按份额类别认，不按细分码：值语义箱的细分码是 0，按细分码判会让它的新份额从不入账。
    if !irHoldsShare(pool = module.types, typeId = heldType):
        return out
    out.ctx = holdShare(ctx = out.ctx, name = out.text, typeId = heldType)
    return out

; 表达式内核：先发子节点，再发本节点；值串交给上层拼指令。
emitExprCore|func(ctx: BodyCtx, module: IrModule, nodeId: I32,) -> (ExprOut,):
    var out = ExprOut()
    out.ctx = ctx
    out.text = "0"
    if nodeId < 0 || nodeId >= irNodeCount(module.nodes):
        out.ctx = addGap(ctx = out.ctx, gap = "悬空表达式")
        return out
    let node = irNodeAt(pool = module.nodes, id = nodeId)
    let typeName = llvmTypeName(pool = module.types, typeId = node.typeId)
    if node.kind == 1:
        out.text = countText(node.intValue as I32)
        return out
    if node.kind == 2:
        out.text = floatConstantText(node.floatValue)
        return out
    if node.kind == 3:
        let flag = node.intValue as I32
        if flag != 0:
            out.text = "true"
        else:
            out.text = "false"
        return out
    if node.kind == 5:
        let slot = node.intValue as I32
        let id = out.ctx.temp
        out.ctx.temp = id + 1
        let name = tempName(index = id)
        appendLine(sink = out.ctx.lines, text = "  " + name + " = load " + typeName + ", ptr " + slotNameOf(ctx = out.ctx, slot = slot))
        out.text = name
        return out
    if node.kind == 6:
        return emitBinary(out = out, module = module, node = node)
    if node.kind == 7:
        return emitUnary(out = out, module = module, node = node)
    if node.kind == 4:
        let value = textAt(module = module, id = node.text)
        let at = internString(pool = out.ctx.strings, value = value)
        let id = out.ctx.temp
        out.ctx.temp = id + 1
        out.text = stringValue(lines = out.ctx.lines, pool = out.ctx.strings, index = at, temp = id)
        return out
    if node.kind == 8:
        let callee = textAt(module = module, id = node.text)
        let row = builtinLookup(table = out.ctx.builtins, name = callee, receiver = receiverTagOf(module = module, node = node))
        if len(row.symbol) > 0:
            return emitBuiltinCall(out = out, module = module, node = node, row = row)
        var symbol = mangleName(name = callee)
        let target = findIrFunctionIndex(module = module, name = callee)
        if target >= 0:
            symbol = mangleName(name = module.functions[target].name)
        if target >= 0 && typeTagAt(module = module, typeId = node.typeId) == irFutureTypeTag():
            ; 站点类型是任务句柄：这条调用是派发，不是直呼。
            return emitTaskSpawn(out = out, module = module, node = node, target = target)
        var declaredAt = -1
        if target < 0:
            declaredAt = findExternFunction(module = module, name = callee)
            ; 数学内建的落点：模块没显式声明同名外部函数时改走 LLVM 内建，目标不连数学库。
            if declaredAt < 0:
                if callee == "abs":
                    return emitAbsCall(ctx = out.ctx, module = module, node = node)
                if callee == "sqrt":
                    return emitDirectCall(ctx = out.ctx, module = module, node = node, symbol = "llvm.sqrt.f64")
                if callee == "sin":
                    return emitDirectCall(ctx = out.ctx, module = module, node = node, symbol = "llvm.sin.f64")
                if callee == "cos":
                    return emitDirectCall(ctx = out.ctx, module = module, node = node, symbol = "llvm.cos.f64")
                if callee == "tan":
                    return emitTanCall(ctx = out.ctx, module = module, node = node)
                if callee == "min":
                    return emitMinMaxCall(ctx = out.ctx, module = module, node = node, isMin = true)
                if callee == "max":
                    return emitMinMaxCall(ctx = out.ctx, module = module, node = node, isMin = false)
            ; 数组末位两名成员：运行时只给长度与取元素，两段在此拼成。
            if callee == "Array.last":
                return emitArrayLastCall(ctx = out.ctx, module = module, node = node)
            if callee == "Array.pop":
                return emitArrayPopCall(ctx = out.ctx, module = module, node = node)
            declaredAt = findExternFunction(module = module, name = callee)
            if declaredAt < 0 && len(externSignature(name = callee)) == 0:
                out.ctx = addGap(ctx = out.ctx, gap = "外部调用 " + callee)
                return out
            symbol = runtimeSymbolOf(name = callee)
            useExtern(use = out.ctx.externs, name = symbol)
        var args = ""
        var i = 0
        while i < len(node.kids):
            let one = emitExpr(ctx = out.ctx, module = module, nodeId = node.kids[i])
            out.ctx = one.ctx
            let fromType = irNodeAt(pool = module.nodes, id = node.kids[i]).typeId
            var argType = fromType
            if target >= 0 && i < len(module.functions[target].params):
                argType = module.functions[target].params[i].typeId
            elif declaredAt >= 0 && i < len(module.externs[declaredAt].params):
                ; 外部签名是实参形状的唯一出处：C 函数指针位要的是裸指针，不是闭包聚合。
                argType = module.externs[declaredAt].params[i]
            if i > 0:
                args = args + ", "
            if declaredAt >= 0 && i < len(module.externs[declaredAt].params) && typeTagAt(module = module, typeId = argType) == irTypeTag(.irTypeFunction):
                ; C 函数指针位：直接交具名函数的代码符号，闭包协议在 C 侧不存在。
                let argNode = irNodeAt(pool = module.nodes, id = node.kids[i])
                var handed = ""
                if argNode.kind == irExprTag(.irFunctionValue):
                    let adapterName = textAt(module = module, id = argNode.text)
                    let adapterAt = findIrFunctionIndex(module = module, name = adapterName)
                    if adapterAt >= 0 && len(module.functions[adapterAt].adapterTarget) > 0:
                        handed = "ptr @" + mangleName(name = module.functions[adapterAt].adapterTarget)
                if len(handed) == 0:
                    out.ctx = addGap(ctx = out.ctx, gap = "C 函数指针位只收具名函数")
                    out.text = ""
                    return out
                args = args + handed
            else:
                let shaped = storeValue(ctx = out.ctx, module = module, text = one.text, fromType = fromType, toType = argType)
                out.ctx = shaped.ctx
                if target >= 0:
                    ; 形参归被调方所有：账上有就交出去，没有就另留一份，否则返回后被调方读到的是空壳。
                    out.ctx = adoptValue(ctx = out.ctx, module = module, name = shaped.text, typeId = argType, adopt = 1)
                args = args + llvmTypeName(pool = module.types, typeId = argType) + " " + shaped.text
            i = i + 1
        let id = out.ctx.temp
        out.ctx.temp = id + 1
        let name = tempName(index = id)
        let retType = llvmTypeName(pool = module.types, typeId = node.typeId)
        if retType == "void":
            appendLine(sink = out.ctx.lines, text = "  call void @" + symbol + "(" + args + ")")
            out.text = ""
        else:
            appendLine(sink = out.ctx.lines, text = "  " + name + " = call " + retType + " @" + symbol + "(" + args + ")")
            out.text = name
        return out
    if node.kind == 9:
        out.ctx = emitPrintArgs(ctx = out.ctx, module = module, ids = node.kids, spaced = false)
        out.text = ""
        return out
    if node.kind == 10:
        out.ctx = emitPrintArgs(ctx = out.ctx, module = module, ids = node.kids, spaced = true)
        out.text = ""
        return out
    if node.kind == 14:
        out.ctx = emitAssert(ctx = out.ctx, module = module, node = node, nodeId = nodeId)
        out.text = ""
        return out
    if node.kind == 15:
        return emitResultConstruct(out = out, module = module, node = node)
    if node.kind == 16:
        return emitOptionalConstruct(out = out, module = module, node = node)
    if node.kind == 17:
        return emitOptionalGet(out = out, module = module, node = node)
    if node.kind == 52:
        return emitTaskJoin(out = out, module = module, node = node)
    if node.kind == 53:
        return emitGivenInstance(out = out, module = module, node = node)
    if node.kind == 18:
        return emitArrayLiteral(out = out, module = module, node = node)
    if node.kind == 19:
        return emitDictLiteral(out = out, module = module, node = node)
    if node.kind == 20:
        return emitSetLiteral(out = out, module = module, node = node)
    if node.kind == 21:
        return emitSubscriptGet(out = out, module = module, node = node)
    if node.kind == 22:
        if len(node.kids) == 0:
            out.ctx = addGap(ctx = out.ctx, gap = "长度缺实参")
            return out
        let tag = typeTagOf(module = module, nodeId = node.kids[0])
        let row = builtinLookup(table = out.ctx.builtins, name = "len", receiver = tag)
        if len(row.symbol) == 0:
            out.ctx = addGap(ctx = out.ctx, gap = "长度不支持 类别码 " + countText(tag))
            return out
        return emitHandleCount(ctx = out.ctx, module = module, argId = node.kids[0], symbol = row.symbol)
    if node.kind == 23:
        return emitSliceCall(out = out, module = module, node = node)
    if node.kind == 24:
        return emitTupleConstruct(out = out, module = module, node = node)
    if node.kind == 25:
        return emitTupleIndexGet(out = out, module = module, node = node)
    if node.kind == 26:
        return emitConstruct(out = out, module = module, node = node)
    if node.kind == 27:
        return emitEnumConstruct(out = out, module = module, node = node)
    if node.kind == 28:
        return emitFieldGet(out = out, module = module, node = node)
    if node.kind == 40:
        if node.op == 1:
            return emitStringUnaryCall(out = out, module = module, node = node, symbol = "bk_string_upper")
        return emitStringUnaryCall(out = out, module = module, node = node, symbol = "bk_string_lower")
    if node.kind == 41:
        return emitStringPairCall(out = out, module = module, node = node, symbol = "bk_string_contains", asBool = true)
    if node.kind == 42:
        return emitStringSubstring(out = out, module = module, node = node)
    if node.kind == 43:
        return emitStringPairCall(out = out, module = module, node = node, symbol = "bk_string_split", asBool = false)
    if node.kind == 44:
        return emitArrayJoin(out = out, module = module, node = node)
    if node.kind == 46:
        return emitInterp(out = out, module = module, node = node)
    if node.kind == 47:
        return emitStringUnaryCall(out = out, module = module, node = node, symbol = "bk_string_trim_left")
    if node.kind == 48:
        return emitStringUnaryCall(out = out, module = module, node = node, symbol = "bk_string_trim_right")
    if node.kind == 49:
        return emitStringPairCall(out = out, module = module, node = node, symbol = "bk_string_index_of", asBool = false)
    if node.kind == 56:
        return emitShortCircuit(out = out, module = module, node = node)
    if node.kind == 57:
        return emitEnumTagGet(out = out, module = module, node = node)
    if node.kind == 58:
        return emitEnumPayloadGet(out = out, module = module, node = node)
    if node.kind == 29:
        return emitPointerLoad(out = out, module = module, node = node)
    if node.kind == 30:
        return emitPointerStore(out = out, module = module, node = node)
    if node.kind == 12:
        return emitFunctionValue(out = out, module = module, node = node)
    if node.kind == 11:
        return emitIndirectCall(out = out, module = module, node = node)
    if node.kind == 13:
        return emitClosureLiteral(out = out, module = module, node = node)
    if node.kind == 50:
        return emitLazyRefConstruct(out = out, module = module, node = node)
    if node.kind == 51:
        return emitLazyRefValue(out = out, module = module, node = node)
    if node.kind == 59:
        return emitWeakRefConstruct(out = out, module = module, node = node)
    if node.kind == 60:
        return emitWeakRefValue(out = out, module = module, node = node)
    if node.kind == 61 || node.kind == 62:
        ; 无主引用不产生指令：构造与解引用都只是同一个对象指针的搬运。
        return emitExpr(ctx = out.ctx, module = module, nodeId = node.kids[0])
    if node.kind == 31:
        return emitAddressOfVar(out = out, node = node)
    if node.kind == 32:
        return emitFileWrite(out = out, module = module, node = node, symbol = "bk_write_file")
    if node.kind == 33:
        return emitFileRead(out = out, module = module, node = node)
    if node.kind == 34:
        return emitReadLine(out = out, module = module)
    if node.kind == 35:
        return emitFileWrite(out = out, module = module, node = node, symbol = "bk_append_file")
    if node.kind == 36:
        return emitTryReadCall(ctx = out.ctx, module = module, node = node, symbol = "bk_try_read_file")
    if node.kind == 37:
        return emitTryUnitWrite(out = out, module = module, node = node, symbol = "bk_try_write_file")
    if node.kind == 38:
        return emitTryUnitWrite(out = out, module = module, node = node, symbol = "bk_try_append_file")
    if node.kind == 54:
        return emitForeignDataAddress(out = out, module = module, node = node)
    out.ctx = addGap(ctx = out.ctx, gap = nodeGap(ctx = out.ctx, kind = node.kind))
    return out

; 二元运算：整数一套、浮点一套；min/max 用比较加选择，其余按码出指令。
emitBinary|func(out: ExprOut, module: IrModule, node: IrNode,) -> (ExprOut,):
    var done = out
    let left = emitExpr(ctx = done.ctx, module = module, nodeId = node.kids[0])
    done.ctx = left.ctx
    let right = emitExpr(ctx = done.ctx, module = module, nodeId = node.kids[1])
    done.ctx = right.ctx
    let isFloat = isFloatNode(module = module, nodeId = node.kids[0])
    let opType = llvmTypeName(pool = module.types, typeId = irNodeAt(pool = module.nodes, id = node.kids[0]).typeId)
    let lhsTag = typeTagOf(module = module, nodeId = node.kids[0])
    let rhsTag = typeTagOf(module = module, nodeId = node.kids[1])
    if lhsTag == 9 || rhsTag == 9 || lhsTag == 8 || rhsTag == 8:
        return emitStringFaceBinary(out = done, module = module, node = node, left = left.text, right = right.text, lhsTag = lhsTag, rhsTag = rhsTag)
    if node.op == 17 || node.op == 18:
        if opType == "double" || opType == "i1":
            done.ctx = addGap(ctx = done.ctx, gap = "二元运算码 " + countText(node.op))
            return done
        let id = done.ctx.temp
        done.ctx.temp = id + 1
        let name = tempName(index = id)
        var cmp = "icmp slt"
        if node.op == 18:
            cmp = "icmp sgt"
        appendLine(sink = done.ctx.lines, text = "  " + name + " = " + cmp + " " + opType + " " + left.text + ", " + right.text)
        let pickId = done.ctx.temp
        done.ctx.temp = pickId + 1
        let pick = tempName(index = pickId)
        appendLine(sink = done.ctx.lines, text = "  " + pick + " = select i1 " + name + ", " + opType + " " + left.text + ", " + opType + " " + right.text)
        done.text = pick
        return done
    let opText = binaryOpText(op = node.op, isFloat = isFloat)
    if len(opText) == 0:
        done.ctx = addGap(ctx = done.ctx, gap = "二元运算码 " + countText(node.op))
        return done
    let id = done.ctx.temp
    done.ctx.temp = id + 1
    let name = tempName(index = id)
    appendLine(sink = done.ctx.lines, text = "  " + name + " = " + opText + " " + opType + " " + left.text + ", " + right.text)
    done.text = name
    return done

; 字符串面二元：拼接走运行时拼接内核，比较走 strcmp 或字符相等通道。
; 字符是八字节内联值，与串比较时必须交给运行时按内容判，不能把它当指针传。
emitStringFaceBinary|func(out: ExprOut, module: IrModule, node: IrNode, left: String, right: String, lhsTag: I32, rhsTag: I32,) -> (ExprOut,):
    var done = out
    if node.op == 1:
        let lhsPtr = stringFacePointer(ctx = done.ctx, text = left, tag = lhsTag)
        done.ctx = lhsPtr.ctx
        let rhsPtr = stringFacePointer(ctx = done.ctx, text = right, tag = rhsTag)
        done.ctx = rhsPtr.ctx
        useExtern(use = done.ctx.externs, name = "bk_str_concat")
        let id = done.ctx.temp
        done.ctx.temp = id + 1
        let name = tempName(index = id)
        var take = 0
        if done.ctx.pendingSlot >= 0 && len(node.kids) > 0:
            let leaf = irNodeAt(pool = module.nodes, id = node.kids[0])
            if leaf.kind == 5 && leaf.intValue as I32 == done.ctx.pendingSlot:
                take = 1
                done.ctx.pendingSlot = -1
        let args = "ptr " + lhsPtr.text + ", ptr " + rhsPtr.text + ", i32 " + countText(take)
        appendLine(sink = done.ctx.lines, text = "  " + name + " = call ptr @bk_str_concat(" + args + ")")
        done.text = name
        return done
    if node.op < 6 || node.op > 11:
        done.ctx = addGap(ctx = done.ctx, gap = "字符串面二元运算码 " + countText(node.op))
        return done
    if lhsTag == 9 && rhsTag == 9:
        var cmp = "icmp ne"
        if node.op == 6:
            cmp = "icmp eq"
        let id = done.ctx.temp
        done.ctx.temp = id + 1
        let name = tempName(index = id)
        appendLine(sink = done.ctx.lines, text = "  " + name + " = " + cmp + " i64 " + left + ", " + right)
        done.text = name
        return done
    if lhsTag == 9 || rhsTag == 9:
        if node.op != 6 && node.op != 7:
            done.ctx = addGap(ctx = done.ctx, gap = "字符与其他串比大小")
            return done
        var charText = left
        var stringText = right
        if rhsTag == 9:
            charText = right
            stringText = left
        useExtern(use = done.ctx.externs, name = "bk_char_equal_string")
        let hitId = done.ctx.temp
        done.ctx.temp = hitId + 1
        let hit = tempName(index = hitId)
        appendLine(sink = done.ctx.lines, text = "  " + hit + " = call i32 @bk_char_equal_string(i64 " + charText + ", ptr " + stringText + ")")
        var cmp = "icmp eq"
        if node.op == 6:
            cmp = "icmp ne"
        let id = done.ctx.temp
        done.ctx.temp = id + 1
        let name = tempName(index = id)
        appendLine(sink = done.ctx.lines, text = "  " + name + " = " + cmp + " i32 " + hit + ", 0")
        done.text = name
        return done
    useExtern(use = done.ctx.externs, name = "strcmp")
    let hitId = done.ctx.temp
    done.ctx.temp = hitId + 1
    let hit = tempName(index = hitId)
    appendLine(sink = done.ctx.lines, text = "  " + hit + " = call i32 @strcmp(ptr " + left + ", ptr " + right + ")")
    var cmp = "icmp eq"
    if node.op == 7:
        cmp = "icmp ne"
    if node.op == 8:
        cmp = "icmp slt"
    if node.op == 9:
        cmp = "icmp sle"
    if node.op == 10:
        cmp = "icmp sgt"
    if node.op == 11:
        cmp = "icmp sge"
    let id = done.ctx.temp
    done.ctx.temp = id + 1
    let name = tempName(index = id)
    appendLine(sink = done.ctx.lines, text = "  " + name + " = " + cmp + " i32 " + hit + ", 0")
    done.text = name
    return done

; 字符落串：字符按内联字交给运行时展开，其余按现有指针直接用。
stringFacePointer|func(ctx: BodyCtx, text: String, tag: I32,) -> (ExprOut,):
    var out = ExprOut()
    out.ctx = ctx
    out.text = text
    if tag != 9:
        return out
    useExtern(use = out.ctx.externs, name = "bk_char_to_heap_string")
    let id = out.ctx.temp
    out.ctx.temp = id + 1
    let name = tempName(index = id)
    appendLine(sink = out.ctx.lines, text = "  " + name + " = call ptr @bk_char_to_heap_string(i64 " + text + ")")
    out.text = name
    return out

; 一元运算：取负、取反、逻辑非、绝对值与转换；转换按源与目标的宽度和符号性选指令。
emitUnary|func(out: ExprOut, module: IrModule, node: IrNode,) -> (ExprOut,):
    var done = out
    let one = emitExpr(ctx = done.ctx, module = module, nodeId = node.kids[0])
    done.ctx = one.ctx
    let opType = llvmTypeName(pool = module.types, typeId = irNodeAt(pool = module.nodes, id = node.kids[0]).typeId)
    if node.op == 5:
        return emitCast(ctx = done.ctx, module = module, node = node, text = one.text)
    if node.op == 4:
        if opType == "double" || opType == "i1":
            done.ctx = addGap(ctx = done.ctx, gap = "绝对值不支持 " + opType)
            return done
        let negId = done.ctx.temp
        done.ctx.temp = negId + 1
        let neg = tempName(index = negId)
        appendLine(sink = done.ctx.lines, text = "  " + neg + " = sub " + opType + " 0, " + one.text)
        let condId = done.ctx.temp
        done.ctx.temp = condId + 1
        let cond = tempName(index = condId)
        appendLine(sink = done.ctx.lines, text = "  " + cond + " = icmp slt " + opType + " " + one.text + ", 0")
        let id = done.ctx.temp
        done.ctx.temp = id + 1
        let name = tempName(index = id)
        appendLine(sink = done.ctx.lines, text = "  " + name + " = select i1 " + cond + ", " + opType + " " + neg + ", " + opType + " " + one.text)
        done.text = name
        return done
    let opText = unaryOpText(op = node.op)
    if len(opText) == 0:
        done.ctx = addGap(ctx = done.ctx, gap = "一元运算码 " + countText(node.op))
        return done
    let id = done.ctx.temp
    done.ctx.temp = id + 1
    let name = tempName(index = id)
    if node.op == 1:
        if opType == "double":
            appendLine(sink = done.ctx.lines, text = "  " + name + " = fneg " + opType + " " + one.text)
        else:
            appendLine(sink = done.ctx.lines, text = "  " + name + " = sub " + opType + " 0, " + one.text)
    elif node.op == 2:
        appendLine(sink = done.ctx.lines, text = "  " + name + " = xor i1 " + one.text + ", 1")
    else:
        appendLine(sink = done.ctx.lines, text = "  " + name + " = xor " + opType + " " + one.text + ", -1")
    done.text = name
    return done

; 转换：同拼写不出指令；浮点与整数互转按符号性选指令，整数之间加宽选扩展、收窄选截断。
; 指针与整数互转走 ptrtoint / inttoptr；其余组合报缺口，不硬塞一条错拼的指令。
emitCast|func(ctx: BodyCtx, module: IrModule, node: IrNode, text: String,) -> (ExprOut,):
    let srcType = irNodeAt(pool = module.nodes, id = node.kids[0]).typeId
    return emitConvert(ctx = ctx, module = module, text = text, srcType = srcType, dstType = node.typeId)

; 存储位取值：两侧拼写不同时先转一格；store 的两个操作数必须同型，靠 LLVM 自动放宽不存在。
storeValue|func(ctx: BodyCtx, module: IrModule, text: String, fromType: I32, toType: I32,) -> (ExprOut,):
    return emitConvert(ctx = ctx, module = module, text = text, srcType = fromType, dstType = toType)

; 转换内核：源与目标各给一个类型下标，调用点不必先造节点。
emitConvert|func(ctx: BodyCtx, module: IrModule, text: String, srcType: I32, dstType: I32,) -> (ExprOut,):
    var out = ExprOut()
    out.ctx = ctx
    let srcName = llvmTypeName(pool = module.types, typeId = srcType)
    let dstName = llvmTypeName(pool = module.types, typeId = dstType)
    if srcName == dstName:
        out.text = text
        return out
    let srcTag = typeTagAt(module = module, typeId = srcType)
    let dstTag = typeTagAt(module = module, typeId = dstType)
    let srcWidth = intWidthOf(tag = srcTag)
    let dstWidth = intWidthOf(tag = dstTag)
    var op = ""
    if srcTag == 9 && dstTag == 8:
        ; 字符转串：字符是八字节内联值，必须交给运行时展开成带头串，不能当指针转。
        useExtern(use = out.ctx.externs, name = "bk_char_to_heap_string")
        let id = out.ctx.temp
        out.ctx.temp = id + 1
        let name = tempName(index = id)
        appendLine(sink = out.ctx.lines, text = "  " + name + " = call ptr @bk_char_to_heap_string(i64 " + text + ")")
        out.text = name
        return out
    if srcTag == 7 && dstWidth > 1:
        ; 布尔转整数：零扩展即真值一，与数值语义不冲突。
        op = "zext"
    elif srcWidth > 0 && dstTag == 7:
        let id = out.ctx.temp
        out.ctx.temp = id + 1
        let name = tempName(index = id)
        appendLine(sink = out.ctx.lines, text = "  " + name + " = icmp ne " + srcName + " " + text + ", 0")
        out.text = name
        return out
    elif srcName == "double":
        op = "fptosi"
        if isUnsignedTag(tag = dstTag):
            op = "fptoui"
    elif dstName == "double":
        op = "sitofp"
        if isUnsignedTag(tag = srcTag):
            op = "uitofp"
    elif srcWidth > 0 && dstWidth > srcWidth:
        op = "sext"
        if isUnsignedTag(tag = srcTag):
            op = "zext"
    elif srcWidth > 0 && dstWidth > 0 && dstWidth < srcWidth:
        op = "trunc"
    elif srcName == "ptr" && dstWidth > 0:
        op = "ptrtoint"
    elif srcWidth > 0 && dstName == "ptr":
        op = "inttoptr"
    if srcTag == irTypeTag(.irTypeFunction) && dstTag == irTypeTag(.irTypeCFunction):
        ; 函数值转 C 函数指针：只取代码槽；C 侧没有环境位，有捕获的闭包不该走到这里。
        let id = out.ctx.temp
        out.ctx.temp = id + 1
        let name = tempName(index = id)
        appendLine(sink = out.ctx.lines, text = "  " + name + " = extractvalue { ptr, ptr } " + text + ", 0")
        out.text = name
        return out
    if len(op) == 0:
        out.ctx = addGap(ctx = out.ctx, gap = "转换 " + srcName + " 到 " + dstName)
        return out
    let id = out.ctx.temp
    out.ctx.temp = id + 1
    let name = tempName(index = id)
    appendLine(sink = out.ctx.lines, text = "  " + name + " = " + op + " " + srcName + " " + text + " to " + dstName)
    out.text = name
    return out

; 内建调用：符号与搬参法都来自表，本函数只按形状码补指令。
emitBuiltinCall|func(out: ExprOut, module: IrModule, node: IrNode, row: BuiltinEntry,) -> (ExprOut,):
    var done = out
    if row.shape == shapeHandleCount() && len(node.kids) == 1:
        return emitHandleCount(ctx = done.ctx, module = module, argId = node.kids[0], symbol = row.symbol)
    if row.shape == shapeElementAppend() && len(node.kids) == 2:
        let receiver = emitExpr(ctx = done.ctx, module = module, nodeId = node.kids[0])
        return emitElementAppend(ctx = receiver.ctx, module = module, receiverText = receiver.text, valueId = node.kids[1], symbol = row.symbol)
    if row.shape == shapeDirectCall() && len(node.kids) == 1:
        return emitDirectCall(ctx = done.ctx, module = module, node = node, symbol = row.symbol)
    if row.shape == shapeZeroCall() && len(node.kids) == 0:
        return emitZeroCall(ctx = done.ctx, module = module, node = node, symbol = row.symbol)
    if row.shape == shapePredicate() && len(node.kids) == 1:
        return emitPredicateCall(ctx = done.ctx, module = module, node = node, symbol = row.symbol)
    if row.shape == shapeTryRead() && len(node.kids) == 1:
        return emitTryReadCall(ctx = done.ctx, module = module, node = node, symbol = row.symbol)
    if row.shape == shapeJoinAll() && len(node.kids) == 1:
        return emitJoinAllCall(ctx = done.ctx, module = module, node = node)
    if row.shape == shapeJoinWithin() && len(node.kids) == 2:
        return emitJoinWithinCall(ctx = done.ctx, module = module, node = node)
    done.ctx = addGap(ctx = done.ctx, gap = "内建形状 " + row.name + " " + countText(row.shape))
    return done

; 聚合等待：数组盒交给运行时逐槽取句柄，结算值写三槽后整块读回。
emitJoinAllCall|func(ctx: BodyCtx, module: IrModule, node: IrNode,) -> (ExprOut,):
    var out = ExprOut()
    out.ctx = ctx
    let arg = emitExpr(ctx = out.ctx, module = module, nodeId = node.kids[0])
    out.ctx = arg.ctx
    let resultName = llvmTypeName(pool = module.types, typeId = node.typeId)
    let slot = allocSlot(ctx = out.ctx, typeName = resultName)
    out.ctx = slot.ctx
    appendLine(sink = out.ctx.lines, text = "  store " + resultName + " zeroinitializer, ptr " + slot.text)
    useExtern(use = out.ctx.externs, name = "bk_task_join_all_box")
    let statusId = out.ctx.temp
    out.ctx.temp = statusId + 1
    let status = tempName(index = statusId)
    appendLine(sink = out.ctx.lines, text = "  " + status + " = call i32 @bk_task_join_all_box(ptr " + arg.text + ", ptr " + slot.text + ")")
    let id = out.ctx.temp
    out.ctx.temp = id + 1
    let name = tempName(index = id)
    appendLine(sink = out.ctx.lines, text = "  " + name + " = load " + resultName + ", ptr " + slot.text)
    out.text = name
    return out

; 带时限等待：与 `wait` 共用三槽装配，多一个毫秒实参。
emitJoinWithinCall|func(ctx: BodyCtx, module: IrModule, node: IrNode,) -> (ExprOut,):
    var out = ExprOut()
    out.ctx = ctx
    let handle = emitExpr(ctx = out.ctx, module = module, nodeId = node.kids[0])
    out.ctx = handle.ctx
    let limit = emitExpr(ctx = out.ctx, module = module, nodeId = node.kids[1])
    out.ctx = limit.ctx
    let resultName = llvmTypeName(pool = module.types, typeId = node.typeId)
    let slot = allocSlot(ctx = out.ctx, typeName = resultName)
    out.ctx = slot.ctx
    appendLine(sink = out.ctx.lines, text = "  store " + resultName + " zeroinitializer, ptr " + slot.text)
    useExtern(use = out.ctx.externs, name = "bk_task_join_within")
    let statusId = out.ctx.temp
    out.ctx.temp = statusId + 1
    let status = tempName(index = statusId)
    let args = "ptr " + handle.text + ", i32 " + limit.text + ", ptr " + slot.text
    appendLine(sink = out.ctx.lines, text = "  " + status + " = call i32 @bk_task_join_within(" + args + ")")
    let id = out.ctx.temp
    out.ctx.temp = id + 1
    let name = tempName(index = id)
    appendLine(sink = out.ctx.lines, text = "  " + name + " = load " + resultName + ", ptr " + slot.text)
    out.text = name
    return out

; 句柄计数：一个句柄进、i32 出；句柄在本层一律是 ptr，容器与串同一条指令。
emitHandleCount|func(ctx: BodyCtx, module: IrModule, argId: I32, symbol: String,) -> (ExprOut,):
    var out = ExprOut()
    let arg = emitExpr(ctx = ctx, module = module, nodeId = argId)
    out.ctx = arg.ctx
    useExtern(use = out.ctx.externs, name = symbol)
    let id = out.ctx.temp
    out.ctx.temp = id + 1
    let name = tempName(index = id)
    appendLine(sink = out.ctx.lines, text = "  " + name + " = call i32 @" + symbol + "(ptr " + arg.text + ")")
    out.text = name
    return out

; 元素追加：值先落装箱台，再连同宽度与标签交给运行时；新句柄是返回值，旧句柄不保证原地变。
; 接收者按值串传入，字面量接管新建的句柄时不必再造一个节点。
emitElementAppend|func(ctx: BodyCtx, module: IrModule, receiverText: String, valueId: I32, symbol: String,) -> (ExprOut,):
    var out = ExprOut()
    out.ctx = ctx
    let valueType = irNodeAt(pool = module.nodes, id = valueId).typeId
    let width = elementWidth(pool = module.types, typeId = valueType, pointerBytes = ctx.pointerBytes)
    let tag = arrayElementTag(pool = module.types, typeId = valueType)
    if width == 0 || tag < 0:
        out.ctx = addGap(ctx = out.ctx, gap = "元素装箱 类别码 " + countText(typeTagAt(module = module, typeId = valueType)))
        return out
    let value = emitExpr(ctx = out.ctx, module = module, nodeId = valueId)
    out.ctx = value.ctx
    let valueTypeName = llvmTypeName(pool = module.types, typeId = valueType)
    appendLine(sink = out.ctx.lines, text = "  store " + valueTypeName + " " + value.text + ", ptr " + boxName() + ", align " + countText(width))
    ; 追加入口消费元素那一份，故账上那一份随之交出。
    out.ctx = adoptValue(ctx = out.ctx, module = module, name = value.text, typeId = valueType, adopt = 1)
    useExtern(use = out.ctx.externs, name = symbol)
    let id = out.ctx.temp
    out.ctx.temp = id + 1
    let name = tempName(index = id)
    let args = "ptr " + receiverText + ", ptr " + boxName() + ", i32 " + countText(width) + ", i32 " + countText(tag)
    appendLine(sink = out.ctx.lines, text = "  " + name + " = call ptr @" + symbol + "(" + args + ")")
    out.text = name
    return out

; 单参直呼：实参按自身类型传，结果按节点类型出；空返回不取临时值。
emitDirectCall|func(ctx: BodyCtx, module: IrModule, node: IrNode, symbol: String,) -> (ExprOut,):
    var out = ExprOut()
    let argId = node.kids[0]
    let arg = emitExpr(ctx = ctx, module = module, nodeId = argId)
    out.ctx = arg.ctx
    useExtern(use = out.ctx.externs, name = symbol)
    let argType = llvmTypeName(pool = module.types, typeId = irNodeAt(pool = module.nodes, id = argId).typeId)
    let retType = llvmTypeName(pool = module.types, typeId = node.typeId)
    if retType == "void":
        appendLine(sink = out.ctx.lines, text = "  call void @" + symbol + "(" + argType + " " + arg.text + ")")
        out.text = ""
        return out
    let id = out.ctx.temp
    out.ctx.temp = id + 1
    let name = tempName(index = id)
    appendLine(sink = out.ctx.lines, text = "  " + name + " = call " + retType + " @" + symbol + "(" + argType + " " + arg.text + ")")
    out.text = name
    return out

; 绝对值：i32 摊成比较加取负，与 sqrt 同样不引入数学库依赖。
emitAbsCall|func(ctx: BodyCtx, module: IrModule, node: IrNode,) -> (ExprOut,):
    var out = ExprOut()
    let arg = emitExpr(ctx = ctx, module = module, nodeId = node.kids[0])
    out.ctx = arg.ctx
    let negId = out.ctx.temp
    out.ctx.temp = negId + 1
    let neg = tempName(index = negId)
    appendLine(sink = out.ctx.lines, text = "  " + neg + " = sub i32 0, " + arg.text)
    let cmpId = out.ctx.temp
    out.ctx.temp = cmpId + 1
    let cmp = tempName(index = cmpId)
    appendLine(sink = out.ctx.lines, text = "  " + cmp + " = icmp slt i32 " + arg.text + ", 0")
    let id = out.ctx.temp
    out.ctx.temp = id + 1
    let name = tempName(index = id)
    appendLine(sink = out.ctx.lines, text = "  " + name + " = select i1 " + cmp + ", i32 " + neg + ", i32 " + arg.text)
    out.text = name
    return out

; 正切：没有对应内建，按 sin 除 cos 展开；实参只求一次，两段都读同一个值。
emitTanCall|func(ctx: BodyCtx, module: IrModule, node: IrNode,) -> (ExprOut,):
    var out = ExprOut()
    let arg = emitExpr(ctx = ctx, module = module, nodeId = node.kids[0])
    out.ctx = arg.ctx
    useExtern(use = out.ctx.externs, name = "llvm.sin.f64")
    useExtern(use = out.ctx.externs, name = "llvm.cos.f64")
    let sinId = out.ctx.temp
    out.ctx.temp = sinId + 1
    let sine = tempName(index = sinId)
    appendLine(sink = out.ctx.lines, text = "  " + sine + " = call double @llvm.sin.f64(double " + arg.text + ")")
    let cosId = out.ctx.temp
    out.ctx.temp = cosId + 1
    let cosine = tempName(index = cosId)
    appendLine(sink = out.ctx.lines, text = "  " + cosine + " = call double @llvm.cos.f64(double " + arg.text + ")")
    let id = out.ctx.temp
    out.ctx.temp = id + 1
    let name = tempName(index = id)
    appendLine(sink = out.ctx.lines, text = "  " + name + " = fdiv double " + sine + ", " + cosine)
    out.text = name
    return out

; 最值：两个 i32 按有符号比较，结果由 select 取一，不另找目标符号。
emitMinMaxCall|func(ctx: BodyCtx, module: IrModule, node: IrNode, isMin: Bool,) -> (ExprOut,):
    var out = ExprOut()
    let first = emitExpr(ctx = ctx, module = module, nodeId = node.kids[0])
    out.ctx = first.ctx
    let second = emitExpr(ctx = out.ctx, module = module, nodeId = node.kids[1])
    out.ctx = second.ctx
    var predicate = "sgt"
    if isMin:
        predicate = "slt"
    let cmpId = out.ctx.temp
    out.ctx.temp = cmpId + 1
    let cmp = tempName(index = cmpId)
    appendLine(sink = out.ctx.lines, text = "  " + cmp + " = icmp " + predicate + " i32 " + first.text + ", " + second.text)
    let id = out.ctx.temp
    out.ctx.temp = id + 1
    let name = tempName(index = id)
    appendLine(sink = out.ctx.lines, text = "  " + name + " = select i1 " + cmp + ", i32 " + first.text + ", i32 " + second.text)
    out.text = name
    return out

; 末元素：长度减一取自运行时，取元素入口自带越界陷阱，空数组即终止。
emitArrayLastCall|func(ctx: BodyCtx, module: IrModule, node: IrNode,) -> (ExprOut,):
    var out = ExprOut()
    let recv = emitExpr(ctx = ctx, module = module, nodeId = node.kids[0])
    out.ctx = recv.ctx
    useExtern(use = out.ctx.externs, name = "bk_array_len")
    useExtern(use = out.ctx.externs, name = "bk_array_get")
    let lenId = out.ctx.temp
    out.ctx.temp = lenId + 1
    let count = tempName(index = lenId)
    appendLine(sink = out.ctx.lines, text = "  " + count + " = call i32 @bk_array_len(ptr " + recv.text + ")")
    let idxId = out.ctx.temp
    out.ctx.temp = idxId + 1
    let index = tempName(index = idxId)
    appendLine(sink = out.ctx.lines, text = "  " + index + " = sub i32 " + count + ", 1")
    let boxId = out.ctx.temp
    out.ctx.temp = boxId + 1
    let box = tempName(index = boxId)
    appendLine(sink = out.ctx.lines, text = "  " + box + " = call ptr @bk_array_get(ptr " + recv.text + ", i32 " + index + ")")
    let elemName = llvmTypeName(pool = module.types, typeId = node.typeId)
    let id = out.ctx.temp
    out.ctx.temp = id + 1
    let name = tempName(index = id)
    appendLine(sink = out.ctx.lines, text = "  " + name + " = load " + elemName + ", ptr " + box)
    out.text = name
    return out

; 末元素出栈：末元素照 last 取，余下部分按切片 [0, -1] 复制，两段拼成二元组。
emitArrayPopCall|func(ctx: BodyCtx, module: IrModule, node: IrNode,) -> (ExprOut,):
    var out = ExprOut()
    let kids = irTypeAt(pool = module.types, id = node.typeId).kids
    if len(kids) < 2:
        out.ctx = addGap(ctx = ctx, gap = "出栈结果缺数组或元素类型")
        return out
    let resultArrayType = kids[0]
    let popElemType = kids[1]
    let recv = emitExpr(ctx = ctx, module = module, nodeId = node.kids[0])
    out.ctx = recv.ctx
    useExtern(use = out.ctx.externs, name = "bk_array_len")
    useExtern(use = out.ctx.externs, name = "bk_array_get")
    let lenId = out.ctx.temp
    out.ctx.temp = lenId + 1
    let count = tempName(index = lenId)
    appendLine(sink = out.ctx.lines, text = "  " + count + " = call i32 @bk_array_len(ptr " + recv.text + ")")
    let idxId = out.ctx.temp
    out.ctx.temp = idxId + 1
    let index = tempName(index = idxId)
    appendLine(sink = out.ctx.lines, text = "  " + index + " = sub i32 " + count + ", 1")
    let boxId = out.ctx.temp
    out.ctx.temp = boxId + 1
    let box = tempName(index = boxId)
    appendLine(sink = out.ctx.lines, text = "  " + box + " = call ptr @bk_array_get(ptr " + recv.text + ", i32 " + index + ")")
    let elemName = llvmTypeName(pool = module.types, typeId = popElemType)
    let valueId = out.ctx.temp
    out.ctx.temp = valueId + 1
    let value = tempName(index = valueId)
    appendLine(sink = out.ctx.lines, text = "  " + value + " = load " + elemName + ", ptr " + box)
    var sliceNode = irMakeNode(kind = irExprTag(.irSliceCall), typeId = resultArrayType)
    let sliced = emitArraySlice(out = out, module = module, node = sliceNode, containerText = recv.text, startText = "0", startHas = "1", endText = "-1", endHas = "1")
    var done = sliced
    if sliced.text == "":
        return done
    let aggregate = llvmTypeName(pool = module.types, typeId = node.typeId)
    let arrayName = llvmTypeName(pool = module.types, typeId = resultArrayType)
    let firstId = done.ctx.temp
    done.ctx.temp = firstId + 1
    let withArray = tempName(index = firstId)
    appendLine(sink = done.ctx.lines, text = "  " + withArray + " = insertvalue " + aggregate + " zeroinitializer, " + arrayName + " " + sliced.text + ", 0")
    let secondId = done.ctx.temp
    done.ctx.temp = secondId + 1
    let name = tempName(index = secondId)
    appendLine(sink = done.ctx.lines, text = "  " + name + " = insertvalue " + aggregate + " " + withArray + ", " + elemName + " " + value + ", 1")
    done.text = name
    return done

; 零参直呼：结果按节点类型出；宿主查询族没有接收者，查表时接收者类别记负一。
emitZeroCall|func(ctx: BodyCtx, module: IrModule, node: IrNode, symbol: String,) -> (ExprOut,):
    var out = ExprOut()
    out.ctx = ctx
    useExtern(use = out.ctx.externs, name = symbol)
    let retType = llvmTypeName(pool = module.types, typeId = node.typeId)
    let id = out.ctx.temp
    out.ctx.temp = id + 1
    let name = tempName(index = id)
    appendLine(sink = out.ctx.lines, text = "  " + name + " = call " + retType + " @" + symbol + "()")
    out.text = name
    return out

; 谓词：运行时答 i32，本层收成 i1；布尔在 IR 上是 i1，不能把 i32 直接当条件跳。
; 实参按自身类型传：句柄与擦除字都走这一条。
emitPredicateCall|func(ctx: BodyCtx, module: IrModule, node: IrNode, symbol: String,) -> (ExprOut,):
    var out = ExprOut()
    let arg = emitExpr(ctx = ctx, module = module, nodeId = node.kids[0])
    out.ctx = arg.ctx
    useExtern(use = out.ctx.externs, name = symbol)
    let argType = llvmTypeName(pool = module.types, typeId = irNodeAt(pool = module.nodes, id = node.kids[0]).typeId)
    let hitId = out.ctx.temp
    out.ctx.temp = hitId + 1
    let hit = tempName(index = hitId)
    appendLine(sink = out.ctx.lines, text = "  " + hit + " = call i32 @" + symbol + "(" + argType + " " + arg.text + ")")
    let id = out.ctx.temp
    out.ctx.temp = id + 1
    let name = tempName(index = id)
    appendLine(sink = out.ctx.lines, text = "  " + name + " = icmp ne i32 " + hit + ", 0")
    out.text = name
    return out

; 结果读取：错误字走调用方给的出参槽，内容非空即 ok；两路拼回结果聚合，位置按契约三槽。
emitTryReadCall|func(ctx: BodyCtx, module: IrModule, node: IrNode, symbol: String,) -> (ExprOut,):
    var out = ExprOut()
    let arg = emitExpr(ctx = ctx, module = module, nodeId = node.kids[0])
    out.ctx = arg.ctx
    let slot = allocSlot(ctx = out.ctx, typeName = "i64")
    out.ctx = slot.ctx
    appendLine(sink = out.ctx.lines, text = "  store i64 0, ptr " + slot.text)
    useExtern(use = out.ctx.externs, name = symbol)
    let contentId = out.ctx.temp
    out.ctx.temp = contentId + 1
    let content = tempName(index = contentId)
    appendLine(sink = out.ctx.lines, text = "  " + content + " = call ptr @" + symbol + "(ptr " + arg.text + ", ptr " + slot.text + ")")
    let okId = out.ctx.temp
    out.ctx.temp = okId + 1
    let ok = tempName(index = okId)
    appendLine(sink = out.ctx.lines, text = "  " + ok + " = icmp ne ptr " + content + ", null")
    let tagId = out.ctx.temp
    out.ctx.temp = tagId + 1
    let tag = tempName(index = tagId)
    appendLine(sink = out.ctx.lines, text = "  " + tag + " = select i1 " + ok + ", i64 0, i64 1")
    let agg = llvmTypeName(pool = module.types, typeId = node.typeId)
    let taggedId = out.ctx.temp
    out.ctx.temp = taggedId + 1
    let tagged = tempName(index = taggedId)
    appendLine(sink = out.ctx.lines, text = "  " + tagged + " = insertvalue " + agg + " zeroinitializer, i64 " + tag + ", 0")
    let filledId = out.ctx.temp
    out.ctx.temp = filledId + 1
    let filled = tempName(index = filledId)
    appendLine(sink = out.ctx.lines, text = "  " + filled + " = insertvalue " + agg + " " + tagged + ", ptr " + content + ", 1")
    let wordId = out.ctx.temp
    out.ctx.temp = wordId + 1
    let word = tempName(index = wordId)
    appendLine(sink = out.ctx.lines, text = "  " + word + " = load i64, ptr " + slot.text)
    let id = out.ctx.temp
    out.ctx.temp = id + 1
    let name = tempName(index = id)
    appendLine(sink = out.ctx.lines, text = "  " + name + " = insertvalue " + agg + " " + filled + ", i64 " + word + ", 2")
    out.text = name
    return out

; 指针读：指令直出，不经运行时段；节点类型即元素类型。
emitPointerLoad|func(out: ExprOut, module: IrModule, node: IrNode,) -> (ExprOut,):
    var done = out
    if len(node.kids) == 0:
        done.ctx = addGap(ctx = done.ctx, gap = "指针读缺操作数")
        return done
    let pointer = emitExpr(ctx = done.ctx, module = module, nodeId = node.kids[0])
    done.ctx = pointer.ctx
    let element = llvmTypeName(pool = module.types, typeId = node.typeId)
    let id = done.ctx.temp
    done.ctx.temp = id + 1
    let loaded = tempName(index = id)
    appendLine(sink = done.ctx.lines, text = "  " + loaded + " = load " + element + ", ptr " + pointer.text)
    done.text = loaded
    return done

; 指针写：值先降到元素类型（窄元素截断），再 store；写本身不产出值。
; 元素类型取自指针操作数的类型，取值自身的类型会让 `store(&x, 1)` 把 i32 写进 i64 槽。
emitPointerStore|func(out: ExprOut, module: IrModule, node: IrNode,) -> (ExprOut,):
    var done = out
    if len(node.kids) < 2:
        done.ctx = addGap(ctx = done.ctx, gap = "指针写缺操作数")
        return done
    var element = -1
    let pointerType = irNodeAt(pool = module.nodes, id = node.kids[0]).typeId
    if pointerType >= 0 && pointerType < irTypeCount(module.types):
        let target = irTypeAt(pool = module.types, id = pointerType)
        if irTypeTag(target.kind) == 21 && len(target.kids) > 0:
            element = target.kids[0]
    if element < 0:
        done.ctx = addGap(ctx = done.ctx, gap = "指针写缺元素类型")
        return done
    let pointer = emitExpr(ctx = done.ctx, module = module, nodeId = node.kids[0])
    done.ctx = pointer.ctx
    let value = emitExpr(ctx = done.ctx, module = module, nodeId = node.kids[1])
    done.ctx = value.ctx
    let shaped = storeValue(ctx = done.ctx, module = module, text = value.text, fromType = irNodeAt(pool = module.nodes, id = node.kids[1]).typeId, toType = element)
    done.ctx = shaped.ctx
    appendLine(sink = done.ctx.lines, text = "  store " + llvmTypeName(pool = module.types, typeId = element) + " " + shaped.text + ", ptr " + pointer.text)
    done.text = ""
    return done

; 间接调用：取函数值的 code 与 env，按统一协议 `code(ptr env, 实参…)` 调用。
; 形参按签名定型并把份额交给被调方，与具名调用的归属规则一致。
emitIndirectCall|func(out: ExprOut, module: IrModule, node: IrNode,) -> (ExprOut,):
    var done = out
    let calleeValue = irNodeAt(pool = module.nodes, id = node.kids[0])
    let signature = irTypeAt(pool = module.types, id = calleeValue.typeId)
    let closure = emitExpr(ctx = done.ctx, module = module, nodeId = node.kids[0])
    done.ctx = closure.ctx
    let codeAt = done.ctx.temp
    done.ctx.temp = codeAt + 1
    let code = tempName(index = codeAt)
    appendLine(sink = done.ctx.lines, text = "  " + code + " = extractvalue { ptr, ptr } " + closure.text + ", 0")
    let envAt = done.ctx.temp
    done.ctx.temp = envAt + 1
    let env = tempName(index = envAt)
    appendLine(sink = done.ctx.lines, text = "  " + env + " = extractvalue { ptr, ptr } " + closure.text + ", 1")
    var args = "ptr " + env
    var i = 1
    while i < len(node.kids):
        let one = emitExpr(ctx = done.ctx, module = module, nodeId = node.kids[i])
        done.ctx = one.ctx
        var argType = irNodeAt(pool = module.nodes, id = node.kids[i]).typeId
        if i - 1 < len(signature.kids):
            argType = signature.kids[i - 1]
        let shaped = storeValue(ctx = done.ctx, module = module, text = one.text, fromType = irNodeAt(pool = module.nodes, id = node.kids[i]).typeId, toType = argType)
        done.ctx = shaped.ctx
        done.ctx = adoptValue(ctx = done.ctx, module = module, name = shaped.text, typeId = argType, adopt = 1)
        args = args + ", " + llvmTypeName(pool = module.types, typeId = argType) + " " + shaped.text
        i = i + 1
    let retType = llvmTypeName(pool = module.types, typeId = node.typeId)
    if retType == "void":
        appendLine(sink = done.ctx.lines, text = "  call void " + code + "(" + args + ")")
        done.text = ""
        return done
    let at = done.ctx.temp
    done.ctx.temp = at + 1
    let value = tempName(index = at)
    appendLine(sink = done.ctx.lines, text = "  " + value + " = call " + retType + " " + code + "(" + args + ")")
    done.text = value
    return done

; 函数值：`{ ptr code, ptr null }`；具名函数没有捕获，环境槽恒为空。
; 符号按 IR 名编码，与同名函数定义处的符号同源。
emitFunctionValue|func(out: ExprOut, module: IrModule, node: IrNode,) -> (ExprOut,):
    var done = out
    let name = textAt(module = module, id = node.text)
    let symbol = mangleName(name = name)
    let at = done.ctx.temp
    done.ctx.temp = at + 1
    let code = tempName(index = at)
    appendLine(sink = done.ctx.lines, text = "  " + code + " = insertvalue { ptr, ptr } { ptr @" + symbol + ", ptr null }, ptr @" + symbol + ", 0")
    done.text = code
    return done

; 闭包值：`{ ptr code, ptr env }`；有捕获才分配 env，字段按捕获序存外层槽地址。
; 定义由同名函数条目发射，这里只造值，不重复出体。
emitClosureLiteral|func(out: ExprOut, module: IrModule, node: IrNode,) -> (ExprOut,):
    var done = out
    let name = textAt(module = module, id = node.text)
    var env = "null"
    if len(node.captureSlots) > 0:
        useExtern(use = done.ctx.externs, name = "malloc")
        let bufAt = done.ctx.temp
        done.ctx.temp = bufAt + 1
        let buf = tempName(index = bufAt)
        appendLine(sink = done.ctx.lines, text = "  " + buf + " = call ptr @malloc(i64 " + countText(len(node.captureSlots) * 8) + ")")
        let envType = "%__closure_env_" + countText(node.intValue as I32)
        var i = 0
        while i < len(node.captureSlots):
            let at = done.ctx.temp
            done.ctx.temp = at + 1
            let field = tempName(index = at)
            appendLine(sink = done.ctx.lines, text = "  " + field + " = getelementptr " + envType + ", ptr " + buf + ", i32 0, i32 " + countText(i))
            appendLine(sink = done.ctx.lines, text = "  store ptr " + slotNameOf(ctx = done.ctx, slot = node.captureSlots[i]) + ", ptr " + field)
            i = i + 1
        env = buf
    let codeAt = done.ctx.temp
    done.ctx.temp = codeAt + 1
    let code = tempName(index = codeAt)
    let symbol = mangleName(name = name)
    appendLine(sink = done.ctx.lines, text = "  " + code + " = insertvalue { ptr, ptr } { ptr @" + symbol + ", ptr null }, ptr @" + symbol + ", 0")
    let closureAt = done.ctx.temp
    done.ctx.temp = closureAt + 1
    let closure = tempName(index = closureAt)
    appendLine(sink = done.ctx.lines, text = "  " + closure + " = insertvalue { ptr, ptr } " + code + ", ptr " + env + ", 1")
    done.text = closure
    return done

; 惰性引用构造：取闭包的 code/env，按元素 ABI 交给运行时段；句柄按 ptr 交回。
emitLazyRefConstruct|func(out: ExprOut, module: IrModule, node: IrNode,) -> (ExprOut,):
    var done = out
    let closure = emitExpr(ctx = done.ctx, module = module, nodeId = node.kids[0])
    done.ctx = closure.ctx
    let entry = irTypeAt(pool = module.types, id = node.typeId)
    if len(entry.kids) != 1:
        done.ctx = addGap(ctx = done.ctx, gap = "惰性引用缺元素类型")
        return done
    let element = entry.kids[0]
    let bytes = lazyRefBytes(pool = module.types, id = element)
    if bytes < 0:
        done.ctx = addGap(ctx = done.ctx, gap = "惰性引用元素不支持装箱")
        return done
    let wrapper = ensureLazyRefWrapper(defs = done.ctx.lazyDefs, pool = module.types, element = element)
    let codeAt = done.ctx.temp
    done.ctx.temp = codeAt + 1
    let code = tempName(index = codeAt)
    appendLine(sink = done.ctx.lines, text = "  " + code + " = extractvalue { ptr, ptr } " + closure.text + ", 0")
    let envAt = done.ctx.temp
    done.ctx.temp = envAt + 1
    let env = tempName(index = envAt)
    appendLine(sink = done.ctx.lines, text = "  " + env + " = extractvalue { ptr, ptr } " + closure.text + ", 1")
    useExtern(use = done.ctx.externs, name = "bk_lazyref_create")
    let handleAt = done.ctx.temp
    done.ctx.temp = handleAt + 1
    let handle = tempName(index = handleAt)
    appendLine(sink = done.ctx.lines, text = "  " + handle + " = call ptr @bk_lazyref_create(ptr @" + wrapper + ", ptr " + code + ", ptr " + env + ", i32 " + countText(bytes) + ", i32 " + countText(lazyRefTag(pool = module.types, id = element)) + ")")
    done.text = handle
    return done

; 惰性引用取值：运行时回元素盒，按元素拼写读一格；首次读取的求值由运行时承担。
emitLazyRefValue|func(out: ExprOut, module: IrModule, node: IrNode,) -> (ExprOut,):
    var done = out
    let handle = emitExpr(ctx = done.ctx, module = module, nodeId = node.kids[0])
    done.ctx = handle.ctx
    useExtern(use = done.ctx.externs, name = "bk_lazyref_value")
    let boxAt = done.ctx.temp
    done.ctx.temp = boxAt + 1
    let box = tempName(index = boxAt)
    appendLine(sink = done.ctx.lines, text = "  " + box + " = call ptr @bk_lazyref_value(ptr " + handle.text + ")")
    let valueAt = done.ctx.temp
    done.ctx.temp = valueAt + 1
    let value = tempName(index = valueAt)
    let spelling = llvmTypeName(pool = module.types, typeId = node.typeId)
    appendLine(sink = done.ctx.lines, text = "  " + value + " = load " + spelling + ", ptr " + box)
    done.text = value
    return done

; 弱引用构造：目标指针进运行时旁表，返回不透明句柄；不碰目标的强计数。
emitWeakRefConstruct|func(out: ExprOut, module: IrModule, node: IrNode,) -> (ExprOut,):
    var done = out
    let target = emitExpr(ctx = done.ctx, module = module, nodeId = node.kids[0])
    done.ctx = target.ctx
    useExtern(use = done.ctx.externs, name = "bk_weak_create")
    let handleAt = done.ctx.temp
    done.ctx.temp = handleAt + 1
    let handle = tempName(index = handleAt)
    appendLine(sink = done.ctx.lines, text = "  " + handle + " = call ptr @bk_weak_create(ptr " + target.text + ")")
    done.text = handle
    return done

; 弱引用取值：存活时留一份计数并包成 `some`，已销毁包成 `none`；载荷槽恒写具体值，不留 undef。
emitWeakRefValue|func(out: ExprOut, module: IrModule, node: IrNode,) -> (ExprOut,):
    var done = out
    let handle = emitExpr(ctx = done.ctx, module = module, nodeId = node.kids[0])
    done.ctx = handle.ctx
    useExtern(use = done.ctx.externs, name = "bk_weak_value")
    let objectAt = done.ctx.temp
    done.ctx.temp = objectAt + 1
    let targetPtr = tempName(index = objectAt)
    appendLine(sink = done.ctx.lines, text = "  " + targetPtr + " = call ptr @bk_weak_value(ptr " + handle.text + ")")
    useExtern(use = done.ctx.externs, name = "bk_nominal_retain")
    appendLine(sink = done.ctx.lines, text = "  call void @bk_nominal_retain(ptr " + targetPtr + ")")
    let missingAt = done.ctx.temp
    done.ctx.temp = missingAt + 1
    let missing = tempName(index = missingAt)
    appendLine(sink = done.ctx.lines, text = "  " + missing + " = icmp eq ptr " + targetPtr + ", null")
    let tagAt = done.ctx.temp
    done.ctx.temp = tagAt + 1
    let tag = tempName(index = tagAt)
    appendLine(sink = done.ctx.lines, text = "  " + tag + " = select i1 " + missing + ", i64 1, i64 0")
    let spelling = llvmTypeName(pool = module.types, typeId = node.typeId)
    let withTagAt = done.ctx.temp
    done.ctx.temp = withTagAt + 1
    let withTag = tempName(index = withTagAt)
    appendLine(sink = done.ctx.lines, text = "  " + withTag + " = insertvalue " + spelling + " undef, i64 " + tag + ", 0")
    let withPayloadAt = done.ctx.temp
    done.ctx.temp = withPayloadAt + 1
    let withPayload = tempName(index = withPayloadAt)
    appendLine(sink = done.ctx.lines, text = "  " + withPayload + " = insertvalue " + spelling + " " + withTag + ", ptr " + targetPtr + ", 1")
    done.text = withPayload
    return done

; 元素字节数：按 IR 类别给装箱宽度；未登记答 -1，调用点据此报缺口。
lazyRefBytes|func(pool: IrTypePool, id: I32,) -> (I32,):
    if id < 0 || id >= irTypeCount(pool):
        return -1
    let tag = irTypeTag(irTypeAt(pool = pool, id = id).kind)
    if tag == 1 || tag == 4:
        return 4
    if tag == 5 || tag == 7:
        return 1
    if tag == 2 || tag == 3 || tag == 6 || tag == 9:
        return 8
    if tag == 8:
        return 8
    return -1

; 元素装箱标签：0 按值、1 浮点、2 布尔、4 字符串裸指针；与运行时段同号。
lazyRefTag|func(pool: IrTypePool, id: I32,) -> (I32,):
    if id < 0 || id >= irTypeCount(pool):
        return 0
    let tag = irTypeTag(irTypeAt(pool = pool, id = id).kind)
    if tag == 6:
        return 1
    if tag == 7:
        return 2
    if tag == 8:
        return 4
    return 0

; 包装后缀：同元素拼写共用一个装箱函数；未登记类别按 IR 类别码兜底，避免两类型撞名。
lazyRefSuffix|func(pool: IrTypePool, id: I32,) -> (String,):
    let tag = irTypeTag(irTypeAt(pool = pool, id = id).kind)
    if tag == 1:
        return "i32"
    if tag == 2:
        return "i64"
    if tag == 4:
        return "u8"
    if tag == 5:
        return "i8"
    if tag == 6:
        return "f64"
    if tag == 7:
        return "i1"
    if tag == 8:
        return "ptr"
    if tag == 9:
        return "i64c"
    return "t" + countText(tag)

; 装箱包装：`ptr (code, env, out)` 一个 ABI 通吃元素类型，堆盒由运行时段分配。
ensureLazyRefWrapper|func(defs: LazyRefDefs, pool: IrTypePool, element: I32,) -> (String,):
    let suffix = lazyRefSuffix(pool = pool, id = element)
    let name = "__lazyref_wrapper_" + suffix
    var i = 0
    while i < len(defs.names):
        if defs.names[i] == name:
            return name
        i = i + 1
    defs.names = defs.names.append(name)
    let spelling = llvmTypeName(pool = pool, typeId = element)
    defs.lines = defs.lines.append("define ptr @" + name + "(ptr %code, ptr %env, ptr %out) {")
    defs.lines = defs.lines.append("  %v = call " + spelling + " %code(ptr %env)")
    defs.lines = defs.lines.append("  store " + spelling + " %v, ptr %out")
    defs.lines = defs.lines.append("  ret ptr %out")
    defs.lines = defs.lines.append("}")
    return name

; 取址：槽名与 alloca 同源，故取槽地址即地址；名字只作诊断。
emitAddressOfVar|func(out: ExprOut, node: IrNode,) -> (ExprOut,):
    var done = out
    done.text = slotNameOf(ctx = done.ctx, slot = node.intValue as I32)
    return done

; 外部数据取址：符号名就是地址；声明由模块的外部数据表统一出。
emitForeignDataAddress|func(out: ExprOut, module: IrModule, node: IrNode,) -> (ExprOut,):
    var done = out
    done.text = "@" + mangleName(name = textAt(module = module, id = node.text))
    return done

; 整份写与追加：路径与内容都按 C 串借出，写失败由运行时段陷阱，无返回值。
emitFileWrite|func(out: ExprOut, module: IrModule, node: IrNode, symbol: String,) -> (ExprOut,):
    var done = out
    if len(node.kids) < 2:
        done.ctx = addGap(ctx = done.ctx, gap = "文件写缺操作数")
        return done
    let path = emitExpr(ctx = done.ctx, module = module, nodeId = node.kids[0])
    done.ctx = path.ctx
    let content = emitExpr(ctx = done.ctx, module = module, nodeId = node.kids[1])
    done.ctx = content.ctx
    useExtern(use = done.ctx.externs, name = symbol)
    appendLine(sink = done.ctx.lines, text = "  call void @" + symbol + "(ptr " + path.text + ", ptr " + content.text + ")")
    done.text = ""
    return done

; 整份读：结果按 C 串交回；与宿主的 `readFile` 同形，长度不在这里重算。
emitFileRead|func(out: ExprOut, module: IrModule, node: IrNode,) -> (ExprOut,):
    var done = out
    if len(node.kids) == 0:
        done.ctx = addGap(ctx = done.ctx, gap = "文件读缺路径")
        return done
    let path = emitExpr(ctx = done.ctx, module = module, nodeId = node.kids[0])
    done.ctx = path.ctx
    useExtern(use = done.ctx.externs, name = "bk_read_file")
    let id = done.ctx.temp
    done.ctx.temp = id + 1
    let text = tempName(index = id)
    appendLine(sink = done.ctx.lines, text = "  " + text + " = call ptr @bk_read_file(ptr " + path.text + ")")
    done.text = text
    return done

; 读行：固定栈缓冲加 `fgets`；EOF 折成空串，避免 `%s` 读到空指针。
; 行终止符保留，上限与宿主同一口径（255 字节可见）。
emitReadLine|func(out: ExprOut, module: IrModule,) -> (ExprOut,):
    var done = out
    let slot = allocSlot(ctx = done.ctx, typeName = "[256 x i8]")
    done.ctx = slot.ctx
    let baseId = done.ctx.temp
    done.ctx.temp = baseId + 1
    let base = tempName(index = baseId)
    appendLine(sink = done.ctx.lines, text = "  " + base + " = getelementptr [256 x i8], ptr " + slot.text + ", i32 0, i32 0")
    let streamId = done.ctx.temp
    done.ctx.temp = streamId + 1
    let stream = tempName(index = streamId)
    appendLine(sink = done.ctx.lines, text = "  " + stream + " = load ptr, ptr @__stdinp")
    useExtern(use = done.ctx.externs, name = "fgets")
    let lineId = done.ctx.temp
    done.ctx.temp = lineId + 1
    let line = tempName(index = lineId)
    appendLine(sink = done.ctx.lines, text = "  " + line + " = call ptr @fgets(ptr " + base + ", i32 256, ptr " + stream + ")")
    let emptyId = done.ctx.temp
    done.ctx.temp = emptyId + 1
    let empty = internString(pool = done.ctx.strings, value = "")
    let emptyName = stringValue(lines = done.ctx.lines, pool = done.ctx.strings, index = empty, temp = emptyId)
    let goneId = done.ctx.temp
    done.ctx.temp = goneId + 1
    let gone = tempName(index = goneId)
    appendLine(sink = done.ctx.lines, text = "  " + gone + " = icmp eq ptr " + line + ", null")
    let pickId = done.ctx.temp
    done.ctx.temp = pickId + 1
    let picked = tempName(index = pickId)
    appendLine(sink = done.ctx.lines, text = "  " + picked + " = select i1 " + gone + ", ptr " + emptyName + ", ptr " + line)
    done.text = picked
    return done

; 可接住的写：错误字即返回值，0 为成功；成功侧载荷是空元组，槽里留零值。
emitTryUnitWrite|func(out: ExprOut, module: IrModule, node: IrNode, symbol: String,) -> (ExprOut,):
    var done = out
    if len(node.kids) < 2:
        done.ctx = addGap(ctx = done.ctx, gap = "可接住写缺操作数")
        return done
    let path = emitExpr(ctx = done.ctx, module = module, nodeId = node.kids[0])
    done.ctx = path.ctx
    let content = emitExpr(ctx = done.ctx, module = module, nodeId = node.kids[1])
    done.ctx = content.ctx
    useExtern(use = done.ctx.externs, name = symbol)
    let wordId = done.ctx.temp
    done.ctx.temp = wordId + 1
    let word = tempName(index = wordId)
    appendLine(sink = done.ctx.lines, text = "  " + word + " = call i64 @" + symbol + "(ptr " + path.text + ", ptr " + content.text + ")")
    let agg = llvmTypeName(pool = module.types, typeId = node.typeId)
    let failedId = done.ctx.temp
    done.ctx.temp = failedId + 1
    let failed = tempName(index = failedId)
    appendLine(sink = done.ctx.lines, text = "  " + failed + " = icmp ne i64 " + word + ", 0")
    let tagId = done.ctx.temp
    done.ctx.temp = tagId + 1
    let tag = tempName(index = tagId)
    appendLine(sink = done.ctx.lines, text = "  " + tag + " = select i1 " + failed + ", i64 1, i64 0")
    let taggedId = done.ctx.temp
    done.ctx.temp = taggedId + 1
    let tagged = tempName(index = taggedId)
    appendLine(sink = done.ctx.lines, text = "  " + tagged + " = insertvalue " + agg + " zeroinitializer, i64 " + tag + ", 0")
    let id = done.ctx.temp
    done.ctx.temp = id + 1
    let filled = tempName(index = id)
    appendLine(sink = done.ctx.lines, text = "  " + filled + " = insertvalue " + agg + " " + tagged + ", i64 " + word + ", 2")
    done.text = filled
    return done

; 元素钩子登记：名义元素的新句柄建好后立刻登记，之后的分裂、追加与销毁才走同一对动作。
registerAggHooks|func(ctx: BodyCtx, module: IrModule, handle: String, elementType: I32,) -> (BodyCtx,):
    var out = ctx
    if !aggElement(module = module, typeId = elementType):
        return out
    useExtern(use = out.externs, name = "bk_array_set_element_hooks")
    let hooks = "ptr @" + aggRetainName(typeId = elementType) + ", ptr @" + aggReleaseName(typeId = elementType)
    appendLine(sink = out.lines, text = "  call void @bk_array_set_element_hooks(ptr " + handle + ", " + hooks + ")")
    return out

; 数组字面量：先建空句柄，再逐元素追加；元素类型取自数组类型的首分量。
emitArrayLiteral|func(out: ExprOut, module: IrModule, node: IrNode,) -> (ExprOut,):
    var done = out
    var elementType = -1
    if node.typeId >= 0 && node.typeId < irTypeCount(module.types):
        let kids = irTypeAt(pool = module.types, id = node.typeId).kids
        if len(kids) > 0:
            elementType = kids[0]
    let width = elementWidth(pool = module.types, typeId = elementType, pointerBytes = done.ctx.pointerBytes)
    if width == 0:
        done.ctx = addGap(ctx = done.ctx, gap = "数组元素装箱 类别码 " + countText(typeTagAt(module = module, typeId = elementType)))
        return done
    useExtern(use = done.ctx.externs, name = "bk_array_create")
    let at = done.ctx.temp
    done.ctx.temp = at + 1
    let head = tempName(index = at)
    appendLine(sink = done.ctx.lines, text = "  " + head + " = call ptr @bk_array_create(i32 0)")
    done.ctx = registerAggHooks(ctx = done.ctx, module = module, handle = head, elementType = elementType)
    done.text = head
    var i = 0
    while i < len(node.kids):
        let one = emitElementAppend(ctx = done.ctx, module = module, receiverText = done.text, valueId = node.kids[i], symbol = "bk_array_append")
        done.ctx = one.ctx
        if len(one.text) == 0:
            return done
        done.text = one.text
        i = i + 1
    return done

; 字典字面量：先建空句柄再逐条写入，条目在 kids 里按键、值交替排。
; 键走独立槽、值走共享装箱台，与下标写的装箱口径同源。
emitDictLiteral|func(out: ExprOut, module: IrModule, node: IrNode,) -> (ExprOut,):
    var done = out
    let entry = irTypeAt(pool = module.types, id = node.typeId)
    if len(entry.kids) < 2:
        done.ctx = addGap(ctx = done.ctx, gap = "字典字面量缺键值类型")
        return done
    let keyType = entry.kids[0]
    let valueType = entry.kids[1]
    let keyWidth = elementWidth(pool = module.types, typeId = keyType, pointerBytes = done.ctx.pointerBytes)
    let keyTag = elementTag(pool = module.types, typeId = keyType)
    let valueWidth = elementWidth(pool = module.types, typeId = valueType, pointerBytes = done.ctx.pointerBytes)
    let valueTag = elementTag(pool = module.types, typeId = valueType)
    if keyWidth == 0 || keyTag < 0 || valueWidth == 0 || valueTag < 0:
        done.ctx = addGap(ctx = done.ctx, gap = "字典条目装箱 类别码 " + countText(typeTagAt(module = module, typeId = keyType)))
        return done
    let keyName = llvmTypeName(pool = module.types, typeId = keyType)
    let valueName = llvmTypeName(pool = module.types, typeId = valueType)
    useExtern(use = done.ctx.externs, name = "bk_dict_create")
    let at = done.ctx.temp
    done.ctx.temp = at + 1
    let head = tempName(index = at)
    appendLine(sink = done.ctx.lines, text = "  " + head + " = call ptr @bk_dict_create()")
    done.text = head
    var i = 0
    while i + 1 < len(node.kids):
        let key = emitExpr(ctx = done.ctx, module = module, nodeId = node.kids[i])
        done.ctx = key.ctx
        let value = emitExpr(ctx = done.ctx, module = module, nodeId = node.kids[i + 1])
        done.ctx = value.ctx
        let keyBox = allocSlot(ctx = done.ctx, typeName = keyName)
        done.ctx = keyBox.ctx
        appendLine(sink = done.ctx.lines, text = "  store " + keyName + " " + key.text + ", ptr " + keyBox.text)
        appendLine(sink = done.ctx.lines, text = "  store " + valueName + " " + value.text + ", ptr " + boxName())
        ; 写入消费键值各一份，账上那两份随之交出去。
        done.ctx = adoptValue(ctx = done.ctx, module = module, name = key.text, typeId = keyType, adopt = 1)
        done.ctx = adoptValue(ctx = done.ctx, module = module, name = value.text, typeId = valueType, adopt = 1)
        useExtern(use = done.ctx.externs, name = "bk_dict_set")
        let nextId = done.ctx.temp
        done.ctx.temp = nextId + 1
        let next = tempName(index = nextId)
        var args = "ptr " + done.text + ", ptr " + keyBox.text + ", i32 " + countText(keyWidth) + ", i32 " + countText(keyTag)
        args = args + ", ptr " + boxName() + ", i32 " + countText(valueWidth) + ", i32 " + countText(valueTag)
        appendLine(sink = done.ctx.lines, text = "  " + next + " = call ptr @bk_dict_set(" + args + ")")
        done.text = next
        i = i + 2
    return done

; 集合字面量：先建空句柄，再逐元素追加；追加返回新句柄，旧句柄不保证原地变。
emitSetLiteral|func(out: ExprOut, module: IrModule, node: IrNode,) -> (ExprOut,):
    var done = out
    let entry = irTypeAt(pool = module.types, id = node.typeId)
    if len(entry.kids) == 0:
        done.ctx = addGap(ctx = done.ctx, gap = "集合字面量缺元素类型")
        return done
    let elementType = entry.kids[0]
    let width = elementWidth(pool = module.types, typeId = elementType, pointerBytes = done.ctx.pointerBytes)
    let tag = elementTag(pool = module.types, typeId = elementType)
    if width == 0 || tag < 0:
        done.ctx = addGap(ctx = done.ctx, gap = "集合元素装箱 类别码 " + countText(typeTagAt(module = module, typeId = elementType)))
        return done
    useExtern(use = done.ctx.externs, name = "bk_set_create")
    let at = done.ctx.temp
    done.ctx.temp = at + 1
    let head = tempName(index = at)
    appendLine(sink = done.ctx.lines, text = "  " + head + " = call ptr @bk_set_create()")
    done.text = head
    var i = 0
    while i < len(node.kids):
        let one = emitSetAppend(ctx = done.ctx, module = module, receiverText = done.text, valueId = node.kids[i])
        done.ctx = one.ctx
        if len(one.text) == 0:
            return done
        done.text = one.text
        i = i + 1
    return done

; 集合追加：元素按自身类型落装箱台，宽度与标签交给运行时；新句柄即返回值。
emitSetAppend|func(ctx: BodyCtx, module: IrModule, receiverText: String, valueId: I32,) -> (ExprOut,):
    var out = ExprOut()
    out.ctx = ctx
    let valueType = irNodeAt(pool = module.nodes, id = valueId).typeId
    let width = elementWidth(pool = module.types, typeId = valueType, pointerBytes = ctx.pointerBytes)
    let tag = elementTag(pool = module.types, typeId = valueType)
    if width == 0 || tag < 0:
        out.ctx = addGap(ctx = out.ctx, gap = "集合元素装箱 类别码 " + countText(typeTagAt(module = module, typeId = valueType)))
        return out
    let value = emitExpr(ctx = out.ctx, module = module, nodeId = valueId)
    out.ctx = value.ctx
    let valueTypeName = llvmTypeName(pool = module.types, typeId = valueType)
    appendLine(sink = out.ctx.lines, text = "  store " + valueTypeName + " " + value.text + ", ptr " + boxName())
    out.ctx = adoptValue(ctx = out.ctx, module = module, name = value.text, typeId = valueType, adopt = 1)
    useExtern(use = out.ctx.externs, name = "bk_set_add")
    let id = out.ctx.temp
    out.ctx.temp = id + 1
    let name = tempName(index = id)
    let args = "ptr " + receiverText + ", ptr " + boxName() + ", i32 " + countText(width) + ", i32 " + countText(tag)
    appendLine(sink = out.ctx.lines, text = "  " + name + " = call ptr @bk_set_add(" + args + ")")
    out.text = name
    return out

; 打印一组实参：整行由锁连成一段，逐参展示后补行终止符；多参之间一个空格。
; 锁与格式串的开销只在这一处登记，调用点不再各记一遍。
emitPrintArgs|func(ctx: BodyCtx, module: IrModule, ids: Array<I32>, spaced: Bool,) -> (BodyCtx,):
    var out = ctx
    useExtern(use = out.externs, name = "printf")
    useExtern(use = out.externs, name = "bk_print_lock")
    useExtern(use = out.externs, name = "bk_print_unlock")
    appendLine(sink = out.lines, text = "  call void @bk_print_lock()")
    var i = 0
    while i < len(ids):
        if spaced && i > 0:
            appendLine(sink = out.lines, text = "  call i32 (ptr, ...) @printf(ptr @fmt_space)")
        out = printValue(ctx = out, module = module, nodeId = ids[i])
        i = i + 1
    appendLine(sink = out.lines, text = "  call i32 (ptr, ...) @printf(ptr @fmt_newline)")
    appendLine(sink = out.lines, text = "  call void @bk_print_unlock()")
    return out

; 标量打印：值文本加类型下标，按 LLVM 拼写选格式与加宽方向。
; 带标签值里只有可选有逐值通道；枚举按整数兜底会印出标签而非用例名，故记缺口不出假值。
printScalar|func(ctx: BodyCtx, module: IrModule, text: String, typeId: I32,) -> (BodyCtx,):
    var out = ctx
    let ty = llvmTypeName(pool = module.types, typeId = typeId)
    let valueTag = typeTagAt(module = module, typeId = typeId)
    if valueTag == 13:
        return emitOptionalPrint(ctx = out, module = module, text = text, typeId = typeId)
    if valueTag == 15:
        return emitEnumPrint(ctx = out, module = module, text = text, typeId = typeId)
    if ty == "i1":
        let id = out.temp
        out.temp = id + 1
        let sel = tempName(index = id)
        appendLine(sink = out.lines, text = "  " + sel + " = select i1 " + text + ", ptr @fmt_bool_true, ptr @fmt_bool_false")
        appendLine(sink = out.lines, text = "  call i32 (ptr, ...) @printf(ptr " + sel + ")")
        return out
    if ty == "i8":
        let id = out.temp
        out.temp = id + 1
        let wide = tempName(index = id)
        appendLine(sink = out.lines, text = "  " + wide + " = sext i8 " + text + " to i32")
        appendLine(sink = out.lines, text = "  call i32 (ptr, ...) @printf(ptr @fmt_int, i32 " + wide + ")")
        return out
    if ty == "i32":
        appendLine(sink = out.lines, text = "  call i32 (ptr, ...) @printf(ptr @fmt_int, i32 " + text + ")")
        return out
    if ty == "i64":
        let id = out.temp
        out.temp = id + 1
        let narrow = tempName(index = id)
        appendLine(sink = out.lines, text = "  " + narrow + " = trunc i64 " + text + " to i32")
        appendLine(sink = out.lines, text = "  call i32 (ptr, ...) @printf(ptr @fmt_int, i32 " + narrow + ")")
        return out
    if ty == "double":
        useExtern(use = out.externs, name = "bk_double_to_string")
        useExtern(use = out.externs, name = "bk_str_release")
        let id = out.temp
        out.temp = id + 1
        let rendered = tempName(index = id)
        appendLine(sink = out.lines, text = "  " + rendered + " = call ptr @bk_double_to_string(double " + text + ")")
        appendLine(sink = out.lines, text = "  call i32 (ptr, ...) @printf(ptr @fmt_string, ptr " + rendered + ")")
        appendLine(sink = out.lines, text = "  call void @bk_str_release(ptr " + rendered + ")")
        return out
    if ty == "ptr":
        appendLine(sink = out.lines, text = "  call i32 (ptr, ...) @printf(ptr @fmt_string, ptr " + text + ")")
        return out
    appendLine(sink = out.lines, text = "  call i32 (ptr, ...) @printf(ptr @fmt_int, " + ty + " " + text + ")")
    return out

; 枚举打印：按标签分派到用例名，载荷接在括号里；标签与载荷窗口取自槽位表。
emitEnumPrint|func(ctx: BodyCtx, module: IrModule, text: String, typeId: I32,) -> (BodyCtx,):
    var out = ctx
    let decl = declAt(table = module.decls, typeId = typeId)
    if len(decl.cases) == 0:
        return addGap(ctx = out, gap = "打印枚举缺用例表")
    let agg = llvmAggregateName(pool = module.types, typeId = typeId)
    ; 枚举值在运行时是指针，标签与载荷要先按聚合类型装回值再取。
    let loadId = out.temp
    out.temp = loadId + 1
    let loaded = tempName(index = loadId)
    appendLine(sink = out.lines, text = "  " + loaded + " = load " + agg + ", ptr " + text)
    let tagId = out.temp
    out.temp = tagId + 1
    let tag = tempName(index = tagId)
    appendLine(sink = out.lines, text = "  " + tag + " = extractvalue " + agg + " " + loaded + ", " + countText(module.slots.headSlots))
    let at = out.label
    out.label = at + 1
    let endLabel = labelName(prefix = "enum.end.", index = at)
    var i = 0
    while i < len(decl.cases):
        let hitLabel = labelName(prefix = "enum.case.", index = at) + "." + countText(i)
        let nextLabel = labelName(prefix = "enum.next.", index = at) + "." + countText(i)
        let cmpId = out.temp
        out.temp = cmpId + 1
        let cmp = tempName(index = cmpId)
        appendLine(sink = out.lines, text = "  " + cmp + " = icmp eq i32 " + tag + ", " + countText(i))
        appendLine(sink = out.lines, text = "  br i1 " + cmp + ", label %" + hitLabel + ", label %" + nextLabel)
        appendLine(sink = out.lines, text = hitLabel + ":")
        let placed = internString(pool = out.strings, value = decl.cases[i].name)
        let nameId = out.temp
        out.temp = nameId + 1
        let handle = stringValue(lines = out.lines, pool = out.strings, index = placed, temp = nameId)
        appendLine(sink = out.lines, text = "  call i32 (ptr, ...) @printf(ptr @fmt_string, ptr " + handle + ")")
        if len(decl.cases[i].payload) > 0:
            appendLine(sink = out.lines, text = "  call i32 (ptr, ...) @printf(ptr @fmt_lparen)")
            var k = 0
            while k < len(decl.cases[i].payload):
                let fieldId = out.temp
                out.temp = fieldId + 1
                let field = tempName(index = fieldId)
                appendLine(sink = out.lines, text = "  " + field + " = extractvalue " + agg + " " + loaded + ", " + countText(module.slots.payloadBase + k))
                out = printScalar(ctx = out, module = module, text = field, typeId = decl.cases[i].payload[k])
                if k + 1 < len(decl.cases[i].payload):
                    appendLine(sink = out.lines, text = "  call i32 (ptr, ...) @printf(ptr @fmt_comma)")
                k = k + 1
            appendLine(sink = out.lines, text = "  call i32 (ptr, ...) @printf(ptr @fmt_rparen)")
        appendLine(sink = out.lines, text = "  br label %" + endLabel)
        appendLine(sink = out.lines, text = nextLabel + ":")
        i = i + 1
    appendLine(sink = out.lines, text = "  br label %" + endLabel)
    appendLine(sink = out.lines, text = endLabel + ":")
    return out

; 可选打印：标签零印 some 与载荷，其余印 none；载荷按自身类别回到标量通道。
emitOptionalPrint|func(ctx: BodyCtx, module: IrModule, text: String, typeId: I32,) -> (BodyCtx,):
    var out = ctx
    useExtern(use = out.externs, name = "printf")
    let entry = irTypeAt(pool = module.types, id = typeId)
    let aggregate = llvmTypeName(pool = module.types, typeId = typeId)
    let tagId = out.temp
    out.temp = tagId + 1
    let tagName = tempName(index = tagId)
    appendLine(sink = out.lines, text = "  " + tagName + " = extractvalue " + aggregate + " " + text + ", 0")
    let someId = out.temp
    out.temp = someId + 1
    let someName = tempName(index = someId)
    appendLine(sink = out.lines, text = "  " + someName + " = icmp eq i64 " + tagName + ", 0")
    let at = out.label
    out.label = at + 1
    let someLabel = labelName(prefix = "opt.some.", index = at)
    let noneLabel = labelName(prefix = "opt.none.", index = at)
    let endLabel = labelName(prefix = "opt.prn.", index = at)
    appendLine(sink = out.lines, text = "  br i1 " + someName + ", label %" + someLabel + ", label %" + noneLabel)
    appendLine(sink = out.lines, text = someLabel + ":")
    appendLine(sink = out.lines, text = "  call i32 (ptr, ...) @printf(ptr @fmt_some_open)")
    if len(entry.kids) > 0:
        let valueId = out.temp
        out.temp = valueId + 1
        let valueName = tempName(index = valueId)
        appendLine(sink = out.lines, text = "  " + valueName + " = extractvalue " + aggregate + " " + text + ", 1")
        out = printScalar(ctx = out, module = module, text = valueName, typeId = entry.kids[0])
    appendLine(sink = out.lines, text = "  call i32 (ptr, ...) @printf(ptr @fmt_rparen)")
    appendLine(sink = out.lines, text = "  br label %" + endLabel)
    appendLine(sink = out.lines, text = noneLabel + ":")
    appendLine(sink = out.lines, text = "  call i32 (ptr, ...) @printf(ptr @fmt_none)")
    appendLine(sink = out.lines, text = "  br label %" + endLabel)
    appendLine(sink = out.lines, text = endLabel + ":")
    return out

; 数组打印：方括号包住、逗号分隔，元素按自身类别逐个出。
; 索引走栈槽，循环四段与 while 同形；元素从装箱台按自身宽度读回。
emitArrayPrint|func(ctx: BodyCtx, module: IrModule, arrayText: String, elemType: I32,) -> (BodyCtx,):
    var out = ctx
    let elemTag = typeTagAt(module = module, typeId = elemType)
    let printable = elemTag == 1 || elemTag == 2 || elemTag == 3 || elemTag == 4 || elemTag == 5
    if !printable && elemTag != 6 && elemTag != 7 && elemTag != 8 && elemTag != 9 && elemTag != 12 && elemTag != 16 && elemTag != 19:
        out = addGap(ctx = out, gap = "打印数组元素 类别码 " + countText(elemTag))
        return out
    useExtern(use = out.externs, name = "bk_array_len")
    useExtern(use = out.externs, name = "bk_array_get")
    let elemName = llvmTypeName(pool = module.types, typeId = elemType)
    let at = out.label
    out.label = at + 1
    let condLabel = labelName(prefix = "arr.cond.", index = at)
    let elemLabel = labelName(prefix = "arr.elem.", index = at)
    let sepLabel = labelName(prefix = "arr.sep.", index = at)
    let putLabel = labelName(prefix = "arr.put.", index = at)
    let incLabel = labelName(prefix = "arr.inc.", index = at)
    let endLabel = labelName(prefix = "arr.end.", index = at)
    let idxName = "%arridx" + countText(at)
    let lenName = "%arrlen" + countText(at)
    appendLine(sink = out.lines, text = "  " + idxName + " = alloca i32")
    appendLine(sink = out.lines, text = "  store i32 0, ptr " + idxName)
    appendLine(sink = out.lines, text = "  call i32 (ptr, ...) @printf(ptr @fmt_lbracket)")
    appendLine(sink = out.lines, text = "  " + lenName + " = call i32 @bk_array_len(ptr " + arrayText + ")")
    appendLine(sink = out.lines, text = "  br label %" + condLabel)
    appendLine(sink = out.lines, text = condLabel + ":")
    let indexId = out.temp
    out.temp = indexId + 1
    let index = tempName(index = indexId)
    appendLine(sink = out.lines, text = "  " + index + " = load i32, ptr " + idxName)
    let moreId = out.temp
    out.temp = moreId + 1
    let more = tempName(index = moreId)
    appendLine(sink = out.lines, text = "  " + more + " = icmp slt i32 " + index + ", " + lenName)
    appendLine(sink = out.lines, text = "  br i1 " + more + ", label %" + elemLabel + ", label %" + endLabel)
    appendLine(sink = out.lines, text = elemLabel + ":")
    let firstId = out.temp
    out.temp = firstId + 1
    let first = tempName(index = firstId)
    appendLine(sink = out.lines, text = "  " + first + " = icmp eq i32 " + index + ", 0")
    appendLine(sink = out.lines, text = "  br i1 " + first + ", label %" + putLabel + ", label %" + sepLabel)
    appendLine(sink = out.lines, text = sepLabel + ":")
    appendLine(sink = out.lines, text = "  call i32 (ptr, ...) @printf(ptr @fmt_comma)")
    appendLine(sink = out.lines, text = "  br label %" + putLabel)
    appendLine(sink = out.lines, text = putLabel + ":")
    let boxId = out.temp
    out.temp = boxId + 1
    let box = tempName(index = boxId)
    appendLine(sink = out.lines, text = "  " + box + " = call ptr @bk_array_get(ptr " + arrayText + ", i32 " + index + ")")
    let valueId = out.temp
    out.temp = valueId + 1
    let value = tempName(index = valueId)
    appendLine(sink = out.lines, text = "  " + value + " = load " + elemName + ", ptr " + box)
    out = printAnyValue(ctx = out, module = module, text = value, typeId = elemType)
    appendLine(sink = out.lines, text = "  br label %" + incLabel)
    appendLine(sink = out.lines, text = incLabel + ":")
    let nextId = out.temp
    out.temp = nextId + 1
    let next = tempName(index = nextId)
    appendLine(sink = out.lines, text = "  " + next + " = add i32 " + index + ", 1")
    appendLine(sink = out.lines, text = "  store i32 " + next + ", ptr " + idxName)
    appendLine(sink = out.lines, text = "  br label %" + condLabel)
    appendLine(sink = out.lines, text = endLabel + ":")
    appendLine(sink = out.lines, text = "  call i32 (ptr, ...) @printf(ptr @fmt_rbracket)")
    return out

; 集合打印：花括号包住、逗号分隔，元素按自身类别出；顺序即运行时去重后的迭代序。
emitSetPrint|func(ctx: BodyCtx, module: IrModule, setText: String, elemType: I32,) -> (BodyCtx,):
    var out = ctx
    let elemTag = typeTagAt(module = module, typeId = elemType)
    let printable = elemTag == 1 || elemTag == 2 || elemTag == 3 || elemTag == 4 || elemTag == 5
    if !printable && elemTag != 6 && elemTag != 7 && elemTag != 8 && elemTag != 9 && elemTag != 12 && elemTag != 16 && elemTag != 19:
        out = addGap(ctx = out, gap = "打印集合元素 类别码 " + countText(elemTag))
        return out
    useExtern(use = out.externs, name = "bk_set_len")
    useExtern(use = out.externs, name = "bk_set_at")
    let elemName = llvmTypeName(pool = module.types, typeId = elemType)
    let at = out.label
    out.label = at + 1
    let condLabel = labelName(prefix = "set.cond.", index = at)
    let elemLabel = labelName(prefix = "set.elem.", index = at)
    let sepLabel = labelName(prefix = "set.sep.", index = at)
    let putLabel = labelName(prefix = "set.put.", index = at)
    let incLabel = labelName(prefix = "set.inc.", index = at)
    let endLabel = labelName(prefix = "set.end.", index = at)
    let idxName = "%setidx" + countText(at)
    let lenName = "%setlen" + countText(at)
    appendLine(sink = out.lines, text = "  " + idxName + " = alloca i32")
    appendLine(sink = out.lines, text = "  store i32 0, ptr " + idxName)
    appendLine(sink = out.lines, text = "  call i32 (ptr, ...) @printf(ptr @fmt_lbrace)")
    appendLine(sink = out.lines, text = "  " + lenName + " = call i32 @bk_set_len(ptr " + setText + ")")
    appendLine(sink = out.lines, text = "  br label %" + condLabel)
    appendLine(sink = out.lines, text = condLabel + ":")
    let indexId = out.temp
    out.temp = indexId + 1
    let index = tempName(index = indexId)
    appendLine(sink = out.lines, text = "  " + index + " = load i32, ptr " + idxName)
    let moreId = out.temp
    out.temp = moreId + 1
    let more = tempName(index = moreId)
    appendLine(sink = out.lines, text = "  " + more + " = icmp slt i32 " + index + ", " + lenName)
    appendLine(sink = out.lines, text = "  br i1 " + more + ", label %" + elemLabel + ", label %" + endLabel)
    appendLine(sink = out.lines, text = elemLabel + ":")
    let firstId = out.temp
    out.temp = firstId + 1
    let first = tempName(index = firstId)
    appendLine(sink = out.lines, text = "  " + first + " = icmp eq i32 " + index + ", 0")
    appendLine(sink = out.lines, text = "  br i1 " + first + ", label %" + putLabel + ", label %" + sepLabel)
    appendLine(sink = out.lines, text = sepLabel + ":")
    appendLine(sink = out.lines, text = "  call i32 (ptr, ...) @printf(ptr @fmt_comma)")
    appendLine(sink = out.lines, text = "  br label %" + putLabel)
    appendLine(sink = out.lines, text = putLabel + ":")
    let boxId = out.temp
    out.temp = boxId + 1
    let box = tempName(index = boxId)
    appendLine(sink = out.lines, text = "  " + box + " = call ptr @bk_set_at(ptr " + setText + ", i32 " + index + ")")
    let valueId = out.temp
    out.temp = valueId + 1
    let value = tempName(index = valueId)
    appendLine(sink = out.lines, text = "  " + value + " = load " + elemName + ", ptr " + box)
    out = printAnyValue(ctx = out, module = module, text = value, typeId = elemType)
    appendLine(sink = out.lines, text = "  br label %" + incLabel)
    appendLine(sink = out.lines, text = incLabel + ":")
    let nextId = out.temp
    out.temp = nextId + 1
    let next = tempName(index = nextId)
    appendLine(sink = out.lines, text = "  " + next + " = add i32 " + index + ", 1")
    appendLine(sink = out.lines, text = "  store i32 " + next + ", ptr " + idxName)
    appendLine(sink = out.lines, text = "  br label %" + condLabel)
    appendLine(sink = out.lines, text = endLabel + ":")
    appendLine(sink = out.lines, text = "  call i32 (ptr, ...) @printf(ptr @fmt_rbrace)")
    return out

; 字典打印：花括号包住、逗号分隔，键与值各按自身类别出。
emitDictPrint|func(ctx: BodyCtx, module: IrModule, dictText: String, keyType: I32, valueType: I32,) -> (BodyCtx,):
    var out = ctx
    useExtern(use = out.externs, name = "bk_dict_len")
    useExtern(use = out.externs, name = "bk_dict_key_at")
    useExtern(use = out.externs, name = "bk_dict_val_at")
    let keyName = llvmTypeName(pool = module.types, typeId = keyType)
    let valueName = llvmTypeName(pool = module.types, typeId = valueType)
    let at = out.label
    out.label = at + 1
    let condLabel = labelName(prefix = "dict.cond.", index = at)
    let elemLabel = labelName(prefix = "dict.elem.", index = at)
    let sepLabel = labelName(prefix = "dict.sep.", index = at)
    let putLabel = labelName(prefix = "dict.put.", index = at)
    let incLabel = labelName(prefix = "dict.inc.", index = at)
    let endLabel = labelName(prefix = "dict.end.", index = at)
    let idxName = "%dictidx" + countText(at)
    let lenName = "%dictlen" + countText(at)
    appendLine(sink = out.lines, text = "  " + idxName + " = alloca i32")
    appendLine(sink = out.lines, text = "  store i32 0, ptr " + idxName)
    appendLine(sink = out.lines, text = "  call i32 (ptr, ...) @printf(ptr @fmt_lbrace)")
    appendLine(sink = out.lines, text = "  " + lenName + " = call i32 @bk_dict_len(ptr " + dictText + ")")
    appendLine(sink = out.lines, text = "  br label %" + condLabel)
    appendLine(sink = out.lines, text = condLabel + ":")
    let indexId = out.temp
    out.temp = indexId + 1
    let index = tempName(index = indexId)
    appendLine(sink = out.lines, text = "  " + index + " = load i32, ptr " + idxName)
    let moreId = out.temp
    out.temp = moreId + 1
    let more = tempName(index = moreId)
    appendLine(sink = out.lines, text = "  " + more + " = icmp slt i32 " + index + ", " + lenName)
    appendLine(sink = out.lines, text = "  br i1 " + more + ", label %" + elemLabel + ", label %" + endLabel)
    appendLine(sink = out.lines, text = elemLabel + ":")
    let firstId = out.temp
    out.temp = firstId + 1
    let first = tempName(index = firstId)
    appendLine(sink = out.lines, text = "  " + first + " = icmp eq i32 " + index + ", 0")
    appendLine(sink = out.lines, text = "  br i1 " + first + ", label %" + putLabel + ", label %" + sepLabel)
    appendLine(sink = out.lines, text = sepLabel + ":")
    appendLine(sink = out.lines, text = "  call i32 (ptr, ...) @printf(ptr @fmt_comma)")
    appendLine(sink = out.lines, text = "  br label %" + putLabel)
    appendLine(sink = out.lines, text = putLabel + ":")
    let keyBoxId = out.temp
    out.temp = keyBoxId + 1
    let keyBox = tempName(index = keyBoxId)
    appendLine(sink = out.lines, text = "  " + keyBox + " = call ptr @bk_dict_key_at(ptr " + dictText + ", i32 " + index + ")")
    let keyId = out.temp
    out.temp = keyId + 1
    let key = tempName(index = keyId)
    appendLine(sink = out.lines, text = "  " + key + " = load " + keyName + ", ptr " + keyBox)
    out = printAnyValue(ctx = out, module = module, text = key, typeId = keyType)
    appendLine(sink = out.lines, text = "  call i32 (ptr, ...) @printf(ptr @fmt_colon)")
    let valBoxId = out.temp
    out.temp = valBoxId + 1
    let valBox = tempName(index = valBoxId)
    appendLine(sink = out.lines, text = "  " + valBox + " = call ptr @bk_dict_val_at(ptr " + dictText + ", i32 " + index + ")")
    let valId = out.temp
    out.temp = valId + 1
    let val = tempName(index = valId)
    appendLine(sink = out.lines, text = "  " + val + " = load " + valueName + ", ptr " + valBox)
    out = printAnyValue(ctx = out, module = module, text = val, typeId = valueType)
    appendLine(sink = out.lines, text = "  br label %" + incLabel)
    appendLine(sink = out.lines, text = incLabel + ":")
    let nextId = out.temp
    out.temp = nextId + 1
    let next = tempName(index = nextId)
    appendLine(sink = out.lines, text = "  " + next + " = add i32 " + index + ", 1")
    appendLine(sink = out.lines, text = "  store i32 " + next + ", ptr " + idxName)
    appendLine(sink = out.lines, text = "  br label %" + condLabel)
    appendLine(sink = out.lines, text = endLabel + ":")
    appendLine(sink = out.lines, text = "  call i32 (ptr, ...) @printf(ptr @fmt_rbrace)")
    return out

; 元组打印：方括号包住、逗号分隔，成员按自身类别出。
emitTuplePrint|func(ctx: BodyCtx, module: IrModule, text: String, typeId: I32,) -> (BodyCtx,):
    var out = ctx
    let entry = irTypeAt(pool = module.types, id = typeId)
    let aggregate = llvmTypeName(pool = module.types, typeId = typeId)
    appendLine(sink = out.lines, text = "  call i32 (ptr, ...) @printf(ptr @fmt_lbracket)")
    var i = 0
    while i < len(entry.kids):
        if i > 0:
            appendLine(sink = out.lines, text = "  call i32 (ptr, ...) @printf(ptr @fmt_comma)")
        let id = out.temp
        out.temp = id + 1
        let name = tempName(index = id)
        appendLine(sink = out.lines, text = "  " + name + " = extractvalue " + aggregate + " " + text + ", " + countText(i))
        out = printAnyValue(ctx = out, module = module, text = name, typeId = entry.kids[i])
        i = i + 1
    appendLine(sink = out.lines, text = "  call i32 (ptr, ...) @printf(ptr @fmt_rbracket)")
    return out

; 展示一个值：容器、集合与元组各走自己的形状，其余回到标量通道。
printAnyValue|func(ctx: BodyCtx, module: IrModule, text: String, typeId: I32,) -> (BodyCtx,):
    let tag = typeTagAt(module = module, typeId = typeId)
    if tag == 12:
        let entry = irTypeAt(pool = module.types, id = typeId)
        if len(entry.kids) == 0:
            return addGap(ctx = ctx, gap = "打印数组缺元素类型")
        return emitArrayPrint(ctx = ctx, module = module, arrayText = text, elemType = entry.kids[0])
    if tag == 17:
        let entry = irTypeAt(pool = module.types, id = typeId)
        if len(entry.kids) == 0:
            return addGap(ctx = ctx, gap = "打印集合缺元素类型")
        return emitSetPrint(ctx = ctx, module = module, setText = text, elemType = entry.kids[0])
    if tag == 16:
        let entry = irTypeAt(pool = module.types, id = typeId)
        if len(entry.kids) < 2:
            return addGap(ctx = ctx, gap = "打印字典缺键值类型")
        return emitDictPrint(ctx = ctx, module = module, dictText = text, keyType = entry.kids[0], valueType = entry.kids[1])
    if tag == 19:
        return emitTuplePrint(ctx = ctx, module = module, text = text, typeId = typeId)
    return printScalar(ctx = ctx, module = module, text = text, typeId = typeId)

; 展示一个值：先求值再按类别分派。
printValue|func(ctx: BodyCtx, module: IrModule, nodeId: I32,) -> (BodyCtx,):
    let one = emitExpr(ctx = ctx, module = module, nodeId = nodeId)
    let node = irNodeAt(pool = module.nodes, id = nodeId)
    return printAnyValue(ctx = one.ctx, module = module, text = one.text, typeId = node.typeId)

; 位置查表：命中答位置串，未命中答空串；表按节点下标存，线性扫一遍即可。
testLocTextOf|func(ctx: BodyCtx, node: I32,) -> (String,):
    var i = 0
    while i < len(ctx.testLocNodes):
        if ctx.testLocNodes[i] == node:
            return ctx.testLocTexts[i]
        i = i + 1
    return ""

; 断言：条件为真直落；为假时测试函数置失败位并立刻返回，其余函数调陷阱。
; 消息缺省一句固定串，不空指针；测试态的消息与位置留给报告期打印，故不归还份额。
emitAssert|func(ctx: BodyCtx, module: IrModule, node: IrNode, nodeId: I32,) -> (BodyCtx,):
    var out = ctx
    if !out.testExit:
        useExtern(use = out.externs, name = "bk_panic")
    let cond = emitExpr(ctx = out, module = module, nodeId = node.kids[0])
    out = cond.ctx
    var msgIndex = -1
    if len(node.kids) > 1:
        let msgNode = irNodeAt(pool = module.nodes, id = node.kids[1])
        msgIndex = internString(pool = out.strings, value = textAt(module = module, id = msgNode.text))
    else:
        msgIndex = internString(pool = out.strings, value = "assert failed")
    let id = out.temp
    out.temp = id + 1
    let msgAt = stringValue(lines = out.lines, pool = out.strings, index = msgIndex, temp = id)
    let at = out.label
    out.label = at + 1
    let passLabel = labelName(prefix = "assert.pass.", index = at)
    let failLabel = labelName(prefix = "assert.fail.", index = at)
    let endLabel = labelName(prefix = "assert.end.", index = at)
    appendLine(sink = out.lines, text = "  br i1 " + cond.text + ", label %" + passLabel + ", label %" + failLabel)
    appendLine(sink = out.lines, text = failLabel + ":")
    if out.testExit:
        ; 位置与消息同序存放：驱动器只在失败时读这两格，先写位置与消息再置位，读到的是完整一对。
        ; 查不到条目时退回用例声明文件 —— 句子没有位置（手搭 IR），报告仍指得到文件。
        var locText = testLocTextOf(ctx = out, node = nodeId)
        if len(locText) == 0:
            locText = module.functions[out.fnIndex].sourceFile
        let locIndex = internString(pool = out.strings, value = locText)
        let locId = out.temp
        out.temp = locId + 1
        let locAt = stringValue(lines = out.lines, pool = out.strings, index = locIndex, temp = locId)
        appendLine(sink = out.lines, text = "  store ptr " + locAt + ", ptr @__pini_test_loc")
        appendLine(sink = out.lines, text = "  store ptr " + msgAt + ", ptr @__pini_test_msg")
        appendLine(sink = out.lines, text = "  store i32 1, ptr @__pini_test_failed")
        appendLine(sink = out.lines, text = "  ret void")
    else:
        appendLine(sink = out.lines, text = "  call void @bk_panic(ptr " + msgAt + ")")
        appendLine(sink = out.lines, text = "  br label %" + endLabel)
    appendLine(sink = out.lines, text = passLabel + ":")
    appendLine(sink = out.lines, text = "  br label %" + endLabel)
    appendLine(sink = out.lines, text = endLabel + ":")
    return out

; 栈槽：按类型名开一格，登记进 head 由发射入口统一放到函数首块。
;  行不通  就地 alloca：循环体里按次长栈，长跑进程的内存随迭代数线性上涨。
allocSlot|func(ctx: BodyCtx, typeName: String,) -> (ExprOut,):
    var out = ExprOut()
    out.ctx = ctx
    let id = out.ctx.temp
    out.ctx.temp = id + 1
    let name = tempName(index = id)
    out.ctx.head = out.ctx.head.append("  " + name + " = alloca " + typeName)
    out.text = name
    return out

; 槽地址：聚合指针加常量槽号；槽号由调用方按槽表算好，这里只出 GEP。
slotPtr|func(ctx: BodyCtx, agg: String, base: String, slot: I32,) -> (ExprOut,):
    var out = ExprOut()
    out.ctx = ctx
    let id = out.ctx.temp
    out.ctx.temp = id + 1
    let name = tempName(index = id)
    appendLine(sink = out.ctx.lines, text = "  " + name + " = getelementptr " + agg + ", ptr " + base + ", i32 0, i32 " + countText(slot))
    out.text = name
    return out

; 名义箱：尺寸取聚合的过尾指针，类型标识取 IR 类型下标；头四格由运行时段写。
nominalAlloc|func(ctx: BodyCtx, agg: String, typeId: I32,) -> (ExprOut,):
    var out = ExprOut()
    out.ctx = ctx
    let endId = out.ctx.temp
    out.ctx.temp = endId + 1
    let endName = tempName(index = endId)
    appendLine(sink = out.ctx.lines, text = "  " + endName + " = getelementptr " + agg + ", ptr null, i32 1")
    let sizeId = out.ctx.temp
    out.ctx.temp = sizeId + 1
    let sizeName = tempName(index = sizeId)
    appendLine(sink = out.ctx.lines, text = "  " + sizeName + " = ptrtoint ptr " + endName + " to i64")
    useExtern(use = out.ctx.externs, name = "bk_nominal_alloc")
    let boxId = out.ctx.temp
    out.ctx.temp = boxId + 1
    let box = tempName(index = boxId)
    appendLine(sink = out.ctx.lines, text = "  " + box + " = call ptr @bk_nominal_alloc(i64 " + sizeName + ", i32 " + countText(typeId) + ")")
    out.text = box
    return out

; 具名构造：分配箱后逐字段清零，再按「字段号 + 表达式」对覆盖带初值的字段。
; 对子是降载期展开的声明初值，按字段声明序给；没有对子的字段保留零值。
emitConstruct|func(out: ExprOut, module: IrModule, node: IrNode,) -> (ExprOut,):
    var done = out
    let agg = llvmAggregateName(pool = module.types, typeId = node.typeId)
    if len(agg) == 0:
        done.ctx = addGap(ctx = done.ctx, gap = "构造的类型不是名义类型")
        return done
    let box = nominalAlloc(ctx = done.ctx, agg = agg, typeId = node.typeId)
    done.ctx = box.ctx
    done.text = box.text
    let decl = declAt(table = module.decls, typeId = node.typeId)
    var i = 0
    while i < len(decl.fields):
        let fieldType = decl.fields[i].typeId
        if fieldType >= 0:
            let typeName = llvmTypeName(pool = module.types, typeId = fieldType)
            let at = slotPtr(ctx = done.ctx, agg = agg, base = done.text, slot = fieldSlotIndex(table = module.slots, fieldIndex = i))
            done.ctx = at.ctx
            appendLine(sink = done.ctx.lines, text = "  store " + typeName + " " + zeroTextOf(typeName = typeName) + ", ptr " + at.text)
        i = i + 1
    var k = 0
    while k + 1 < len(node.kids):
        let fieldIndex = irNodeAt(pool = module.nodes, id = node.kids[k]).intValue as I32
        let value = emitExpr(ctx = done.ctx, module = module, nodeId = node.kids[k + 1])
        done.ctx = value.ctx
        if fieldIndex >= 0 && fieldIndex < len(decl.fields):
            let fieldType = decl.fields[fieldIndex].typeId
            if fieldType >= 0:
                let typeName = llvmTypeName(pool = module.types, typeId = fieldType)
                let at = slotPtr(ctx = done.ctx, agg = agg, base = done.text, slot = fieldSlotIndex(table = module.slots, fieldIndex = fieldIndex))
                done.ctx = at.ctx
                let fromType = irNodeAt(pool = module.nodes, id = node.kids[k + 1]).typeId
                let shaped = storeValue(ctx = done.ctx, module = module, text = value.text, fromType = fromType, toType = fieldType)
                done.ctx = shaped.ctx
                ; 字段归新箱所有：账上那一份交出去，语句收尾不再归还。
                done.ctx = adoptValue(ctx = done.ctx, module = module, name = shaped.text, typeId = fieldType, adopt = 1)
                appendLine(sink = done.ctx.lines, text = "  store " + typeName + " " + shaped.text + ", ptr " + at.text)
        k = k + 2
    return done

; 枚举载荷槽类型：聚合按最宽用例占位，故同一下标的槽类型取那条用例的声明类型。
enumSlotType|func(module: IrModule, typeId: I32, index: I32, fallback: I32,) -> (I32,):
    let decl = declAt(table = module.decls, typeId = typeId)
    let widest = widestCaseIndex(cases = decl.cases)
    if widest >= 0:
        let payload = decl.cases[widest].payload
        if index >= 0 && index < len(payload):
            return payload[index]
    return fallback

; 枚举构造：分配箱后写标签，再按用例载荷序逐格存值；载荷类型取聚合的槽类型。
emitEnumConstruct|func(out: ExprOut, module: IrModule, node: IrNode,) -> (ExprOut,):
    var done = out
    let agg = llvmAggregateName(pool = module.types, typeId = node.typeId)
    if len(agg) == 0:
        done.ctx = addGap(ctx = done.ctx, gap = "枚举构造的类型不是枚举")
        return done
    let box = nominalAlloc(ctx = done.ctx, agg = agg, typeId = node.typeId)
    done.ctx = box.ctx
    done.text = box.text
    let tagAt = slotPtr(ctx = done.ctx, agg = agg, base = done.text, slot = module.slots.headSlots)
    done.ctx = tagAt.ctx
    appendLine(sink = done.ctx.lines, text = "  store i32 " + countText(node.op) + ", ptr " + tagAt.text)
    var i = 0
    while i < len(node.kids):
        let value = emitExpr(ctx = done.ctx, module = module, nodeId = node.kids[i])
        done.ctx = value.ctx
        let fieldType = enumSlotType(module = module, typeId = node.typeId, index = i, fallback = irNodeAt(pool = module.nodes, id = node.kids[i]).typeId)
        let typeName = llvmTypeName(pool = module.types, typeId = fieldType)
        let at = slotPtr(ctx = done.ctx, agg = agg, base = done.text, slot = module.slots.payloadBase + i)
        done.ctx = at.ctx
        let shaped = storeValue(ctx = done.ctx, module = module, text = value.text, fromType = irNodeAt(pool = module.nodes, id = node.kids[i]).typeId, toType = fieldType)
        done.ctx = shaped.ctx
        ; 载荷格的接收动作与存储点同规：结构体载荷拷出独立的一份，其余按份额落账。
        let effect = irShareEffectOf(pool = module.types, nodes = module.nodes, nodeId = node.kids[i])
        let adopt = irAdoptOf(pool = module.types, targetTypeId = fieldType, effect = effect, sharingStructs = false)
        let adopted = adoptAtStore(ctx = done.ctx, module = module, name = shaped.text, typeId = fieldType, adopt = adopt)
        done.ctx = adopted.ctx
        appendLine(sink = done.ctx.lines, text = "  store " + typeName + " " + adopted.text + ", ptr " + at.text)
        i = i + 1
    return done

; 字段读：基址是名义箱，槽号按槽表换算；读出的类型取节点类型，不按槽猜。
emitFieldGet|func(out: ExprOut, module: IrModule, node: IrNode,) -> (ExprOut,):
    var done = out
    if len(node.kids) == 0:
        done.ctx = addGap(ctx = done.ctx, gap = "字段读缺接收者")
        return done
    let base = emitExpr(ctx = done.ctx, module = module, nodeId = node.kids[0])
    done.ctx = base.ctx
    let baseType = irNodeAt(pool = module.nodes, id = node.kids[0]).typeId
    let agg = llvmAggregateName(pool = module.types, typeId = baseType)
    if len(agg) == 0:
        done.ctx = addGap(ctx = done.ctx, gap = "字段读的接收者不是名义类型")
        return done
    let at = slotPtr(ctx = done.ctx, agg = agg, base = base.text, slot = fieldSlotIndex(table = module.slots, fieldIndex = node.op))
    done.ctx = at.ctx
    let typeName = llvmTypeName(pool = module.types, typeId = node.typeId)
    let id = done.ctx.temp
    done.ctx.temp = id + 1
    let name = tempName(index = id)
    appendLine(sink = done.ctx.lines, text = "  " + name + " = load " + typeName + ", ptr " + at.text)
    done.text = name
    return done

; 字段写：与字段读同一槽号口径；写进箱里的是值本身，份额动作由中端另标，本层不算。
emitFieldStore|func(ctx: BodyCtx, module: IrModule, node: IrNode,) -> (BodyCtx,):
    var out = ctx
    if len(node.kids) < 2:
        return addGap(ctx = out, gap = "字段写缺操作数")
    let base = emitExpr(ctx = out, module = module, nodeId = node.kids[0])
    out = base.ctx
    let value = emitExpr(ctx = out, module = module, nodeId = node.kids[1])
    out = value.ctx
    let baseType = irNodeAt(pool = module.nodes, id = node.kids[0]).typeId
    let agg = llvmAggregateName(pool = module.types, typeId = baseType)
    if len(agg) == 0:
        return addGap(ctx = out, gap = "字段写的接收者不是名义类型")
    let at = slotPtr(ctx = out, agg = agg, base = base.text, slot = fieldSlotIndex(table = module.slots, fieldIndex = node.op))
    out = at.ctx
    let typeName = llvmTypeName(pool = module.types, typeId = node.typeId)
    let shaped = storeValue(ctx = out, module = module, text = value.text, fromType = irNodeAt(pool = module.nodes, id = node.kids[1]).typeId, toType = node.typeId)
    out = shaped.ctx
    let adopted = adoptAtStore(ctx = out, module = module, name = shaped.text, typeId = node.typeId, adopt = node.adopt)
    out = adopted.ctx
    ; 自追加：右侧从同一个字段起步。串的旧份已随拼接交出；容器则须还旧箱，理由同槽赋值。
    let selfGrow = leftLeafFieldOp(module = module, nodeId = node.kids[1], depth = 0) == node.op
    if node.releaseOld && (!selfGrow || !isStringShare(module = module, typeId = node.typeId)):
        out = releaseOldValue(ctx = out, module = module, at = at.text, typeId = node.typeId)
    appendLine(sink = out.lines, text = "  store " + typeName + " " + adopted.text + ", ptr " + at.text)
    return out

; 标签读：枚举读箱里的标签格，可选与结果读聚合首格；三族都收成 i32。
emitEnumTagGet|func(out: ExprOut, module: IrModule, node: IrNode,) -> (ExprOut,):
    var done = out
    if len(node.kids) == 0:
        done.ctx = addGap(ctx = done.ctx, gap = "标签读缺操作数")
        return done
    let base = emitExpr(ctx = done.ctx, module = module, nodeId = node.kids[0])
    done.ctx = base.ctx
    let baseType = irNodeAt(pool = module.nodes, id = node.kids[0]).typeId
    let tag = typeTagAt(module = module, typeId = baseType)
    if tag == 15:
        let agg = llvmAggregateName(pool = module.types, typeId = baseType)
        if len(agg) == 0:
            done.ctx = addGap(ctx = done.ctx, gap = "标签读的枚举没有聚合名")
            return done
        let at = slotPtr(ctx = done.ctx, agg = agg, base = base.text, slot = module.slots.headSlots)
        done.ctx = at.ctx
        let id = done.ctx.temp
        done.ctx.temp = id + 1
        let name = tempName(index = id)
        appendLine(sink = done.ctx.lines, text = "  " + name + " = load i32, ptr " + at.text)
        done.text = name
        return done
    if tag == 10 || tag == 13:
        let agg = llvmTypeName(pool = module.types, typeId = baseType)
        let wideId = done.ctx.temp
        done.ctx.temp = wideId + 1
        let wide = tempName(index = wideId)
        appendLine(sink = done.ctx.lines, text = "  " + wide + " = extractvalue " + agg + " " + base.text + ", 0")
        let id = done.ctx.temp
        done.ctx.temp = id + 1
        let name = tempName(index = id)
        appendLine(sink = done.ctx.lines, text = "  " + name + " = trunc i64 " + wide + " to i32")
        done.text = name
        return done
    done.ctx = addGap(ctx = done.ctx, gap = "标签读的操作数不是带标签值 类别码 " + countText(tag))
    return done

; 载荷读：枚举按载荷窗口取格，结果按用例名分 ok 与错误字两格，可选只有一格。
emitEnumPayloadGet|func(out: ExprOut, module: IrModule, node: IrNode,) -> (ExprOut,):
    var done = out
    if len(node.kids) == 0:
        done.ctx = addGap(ctx = done.ctx, gap = "载荷读缺操作数")
        return done
    let base = emitExpr(ctx = done.ctx, module = module, nodeId = node.kids[0])
    done.ctx = base.ctx
    let baseType = irNodeAt(pool = module.nodes, id = node.kids[0]).typeId
    let tag = typeTagAt(module = module, typeId = baseType)
    let typeName = llvmTypeName(pool = module.types, typeId = node.typeId)
    if tag == 15:
        let agg = llvmAggregateName(pool = module.types, typeId = baseType)
        if len(agg) == 0:
            done.ctx = addGap(ctx = done.ctx, gap = "载荷读的枚举没有聚合名")
            return done
        let at = slotPtr(ctx = done.ctx, agg = agg, base = base.text, slot = module.slots.payloadBase + node.op)
        done.ctx = at.ctx
        let id = done.ctx.temp
        done.ctx.temp = id + 1
        let name = tempName(index = id)
        appendLine(sink = done.ctx.lines, text = "  " + name + " = load " + typeName + ", ptr " + at.text)
        done.text = name
        return done
    if tag == 10 || tag == 13:
        var slot = node.op + 1
        if tag == 10 && node.text >= 0:
            let caseName = textAt(module = module, id = node.text)
            if caseName != "ok":
                slot = 2
        let agg = llvmTypeName(pool = module.types, typeId = baseType)
        let id = done.ctx.temp
        done.ctx.temp = id + 1
        let name = tempName(index = id)
        appendLine(sink = done.ctx.lines, text = "  " + name + " = extractvalue " + agg + " " + base.text + ", " + countText(slot))
        done.text = name
        return done
    done.ctx = addGap(ctx = done.ctx, gap = "载荷读的操作数不是带标签值 类别码 " + countText(tag))
    return done

; 可选构造：两槽聚合（标签 · 载荷），标签 some 记 0、none 记 1，与匹配面的固定标签同源。
; 载荷按自身类型入槽，并按求值效果移交份额：聚合持有它，别名先留一份。
; 元组构造：聚合从零值起逐位插入成员；成员是计数族时按效果留份或交出。
emitTupleConstruct|func(out: ExprOut, module: IrModule, node: IrNode,) -> (ExprOut,):
    var done = out
    let aggregate = llvmTypeName(pool = module.types, typeId = node.typeId)
    var current = "zeroinitializer"
    var i = 0
    while i < len(node.kids):
        let one = emitExpr(ctx = done.ctx, module = module, nodeId = node.kids[i])
        done.ctx = one.ctx
        let memberType = irNodeAt(pool = module.nodes, id = node.kids[i]).typeId
        let memberName = llvmTypeName(pool = module.types, typeId = memberType)
        let id = done.ctx.temp
        done.ctx.temp = id + 1
        let name = tempName(index = id)
        appendLine(sink = done.ctx.lines, text = "  " + name + " = insertvalue " + aggregate + " " + current + ", " + memberName + " " + one.text + ", " + countText(i))
        let effect = irShareEffectOf(pool = module.types, nodes = module.nodes, nodeId = node.kids[i])
        var adopt = 3
        if effect == 1:
            adopt = 1
        done.ctx = adoptValue(ctx = done.ctx, module = module, name = one.text, typeId = memberType, adopt = adopt)
        current = name
        i = i + 1
    done.text = current
    return done

; 元组成员读：序号即声明序，类型由节点给。
emitTupleIndexGet|func(out: ExprOut, module: IrModule, node: IrNode,) -> (ExprOut,):
    var done = out
    if len(node.kids) < 1:
        done.ctx = addGap(ctx = done.ctx, gap = "元组成员读没有接收者")
        return done
    let base = emitExpr(ctx = done.ctx, module = module, nodeId = node.kids[0])
    done.ctx = base.ctx
    let baseType = irNodeAt(pool = module.nodes, id = node.kids[0]).typeId
    let aggregate = llvmTypeName(pool = module.types, typeId = baseType)
    let id = done.ctx.temp
    done.ctx.temp = id + 1
    let name = tempName(index = id)
    appendLine(sink = done.ctx.lines, text = "  " + name + " = extractvalue " + aggregate + " " + base.text + ", " + countText(node.op))
    done.text = name
    return done

emitOptionalConstruct|func(out: ExprOut, module: IrModule, node: IrNode,) -> (ExprOut,):
    var done = out
    let agg = llvmTypeName(pool = module.types, typeId = node.typeId)
    if node.op != 0:
        let tagId = done.ctx.temp
        done.ctx.temp = tagId + 1
        let tagged = tempName(index = tagId)
        appendLine(sink = done.ctx.lines, text = "  " + tagged + " = insertvalue " + agg + " zeroinitializer, i64 1, 0")
        done.text = tagged
        return done
    if len(node.kids) == 0:
        done.ctx = addGap(ctx = done.ctx, gap = "可选构造缺载荷")
        return done
    let one = emitExpr(ctx = done.ctx, module = module, nodeId = node.kids[0])
    done.ctx = one.ctx
    let tagId = done.ctx.temp
    done.ctx.temp = tagId + 1
    let tagged = tempName(index = tagId)
    appendLine(sink = done.ctx.lines, text = "  " + tagged + " = insertvalue " + agg + " zeroinitializer, i64 0, 0")
    let payloadType = irNodeAt(pool = module.nodes, id = node.kids[0]).typeId
    let payloadSpelling = llvmTypeName(pool = module.types, typeId = payloadType)
    let effect = irShareEffectOf(pool = module.types, nodes = module.nodes, nodeId = node.kids[0])
    var adopt = 3
    if effect == 1:
        adopt = 1
    done.ctx = adoptValue(ctx = done.ctx, module = module, name = one.text, typeId = payloadType, adopt = adopt)
    let id = done.ctx.temp
    done.ctx.temp = id + 1
    let name = tempName(index = id)
    appendLine(sink = done.ctx.lines, text = "  " + name + " = insertvalue " + agg + " " + tagged + ", " + payloadSpelling + " " + one.text + ", 1")
    done.text = name
    return done

; 宽容读：界内取值、界外 none；负索引按尾计数，数组与字串共用一个形状。
; 结果先按 none 写进临时槽，命中分支覆写为 some，合流处再读回。
emitOptionalGet|func(out: ExprOut, module: IrModule, node: IrNode,) -> (ExprOut,):
    var done = out
    if len(node.kids) < 2:
        done.ctx = addGap(ctx = done.ctx, gap = "宽容读缺操作数")
        return done
    let container = emitExpr(ctx = done.ctx, module = module, nodeId = node.kids[0])
    done.ctx = container.ctx
    let index = emitExpr(ctx = done.ctx, module = module, nodeId = node.kids[1])
    done.ctx = index.ctx
    let containerTag = typeTagOf(module = module, nodeId = node.kids[0])
    var lenSymbol = ""
    if containerTag == 12:
        lenSymbol = "bk_array_len"
    elif containerTag == 8:
        lenSymbol = "bk_string_count"
    else:
        done.ctx = addGap(ctx = done.ctx, gap = "宽容读容器 类别码 " + countText(containerTag))
        return done
    let agg = llvmTypeName(pool = module.types, typeId = node.typeId)
    let entry = irTypeAt(pool = module.types, id = node.typeId)
    var payloadType = -1
    if len(entry.kids) > 0:
        payloadType = entry.kids[0]
    var payloadName = "i64"
    if payloadType >= 0:
        payloadName = llvmTypeName(pool = module.types, typeId = payloadType)
    let slot = allocSlot(ctx = done.ctx, typeName = agg)
    done.ctx = slot.ctx
    let noneId = done.ctx.temp
    done.ctx.temp = noneId + 1
    let noneName = tempName(index = noneId)
    appendLine(sink = done.ctx.lines, text = "  " + noneName + " = insertvalue " + agg + " zeroinitializer, i64 1, 0")
    appendLine(sink = done.ctx.lines, text = "  store " + agg + " " + noneName + ", ptr " + slot.text)
    useExtern(use = done.ctx.externs, name = lenSymbol)
    let lenId = done.ctx.temp
    done.ctx.temp = lenId + 1
    let lenName = tempName(index = lenId)
    appendLine(sink = done.ctx.lines, text = "  " + lenName + " = call i32 @" + lenSymbol + "(ptr " + container.text + ")")
    let tail = tailAdjust(ctx = done.ctx, lenText = lenName, indexText = index.text)
    done.ctx = tail.ctx
    let lowId = done.ctx.temp
    done.ctx.temp = lowId + 1
    let lowName = tempName(index = lowId)
    appendLine(sink = done.ctx.lines, text = "  " + lowName + " = icmp sge i32 " + tail.text + ", 0")
    let highId = done.ctx.temp
    done.ctx.temp = highId + 1
    let highName = tempName(index = highId)
    appendLine(sink = done.ctx.lines, text = "  " + highName + " = icmp slt i32 " + tail.text + ", " + lenName)
    let inId = done.ctx.temp
    done.ctx.temp = inId + 1
    let inName = tempName(index = inId)
    appendLine(sink = done.ctx.lines, text = "  " + inName + " = and i1 " + lowName + ", " + highName)
    let at = done.ctx.label
    done.ctx.label = at + 1
    let hitLabel = labelName(prefix = "opt.hit.", index = at)
    let endLabel = labelName(prefix = "opt.end.", index = at)
    appendLine(sink = done.ctx.lines, text = "  br i1 " + inName + ", label %" + hitLabel + ", label %" + endLabel)
    appendLine(sink = done.ctx.lines, text = hitLabel + ":")
    let valueId = done.ctx.temp
    done.ctx.temp = valueId + 1
    let payloadText = tempName(index = valueId)
    if containerTag == 12:
        useExtern(use = done.ctx.externs, name = "bk_array_get")
        let boxId = done.ctx.temp
        done.ctx.temp = boxId + 1
        let boxName = tempName(index = boxId)
        appendLine(sink = done.ctx.lines, text = "  " + boxName + " = call ptr @bk_array_get(ptr " + container.text + ", i32 " + tail.text + ")")
        appendLine(sink = done.ctx.lines, text = "  " + payloadText + " = load " + payloadName + ", ptr " + boxName)
    else:
        useExtern(use = done.ctx.externs, name = "bk_string_char_at")
        appendLine(sink = done.ctx.lines, text = "  " + payloadText + " = call i64 @bk_string_char_at(ptr " + container.text + ", i32 " + tail.text + ")")
    let someId = done.ctx.temp
    done.ctx.temp = someId + 1
    let someName = tempName(index = someId)
    appendLine(sink = done.ctx.lines, text = "  " + someName + " = insertvalue " + agg + " zeroinitializer, i64 0, 0")
    let fullId = done.ctx.temp
    done.ctx.temp = fullId + 1
    let fullName = tempName(index = fullId)
    appendLine(sink = done.ctx.lines, text = "  " + fullName + " = insertvalue " + agg + " " + someName + ", " + payloadName + " " + payloadText + ", 1")
    appendLine(sink = done.ctx.lines, text = "  store " + agg + " " + fullName + ", ptr " + slot.text)
    appendLine(sink = done.ctx.lines, text = "  br label %" + endLabel)
    appendLine(sink = done.ctx.lines, text = endLabel + ":")
    let outId = done.ctx.temp
    done.ctx.temp = outId + 1
    let outName = tempName(index = outId)
    appendLine(sink = done.ctx.lines, text = "  " + outName + " = load " + agg + ", ptr " + slot.text)
    done.text = outName
    return done

; 负下标尾计数：长度由调用方取好，这里只做加减与选择。
tailAdjust|func(ctx: BodyCtx, lenText: String, indexText: String,) -> (ExprOut,):
    var out = ExprOut()
    out.ctx = ctx
    let negId = out.ctx.temp
    out.ctx.temp = negId + 1
    let negName = tempName(index = negId)
    appendLine(sink = out.ctx.lines, text = "  " + negName + " = icmp slt i32 " + indexText + ", 0")
    let adjId = out.ctx.temp
    out.ctx.temp = adjId + 1
    let adjName = tempName(index = adjId)
    appendLine(sink = out.ctx.lines, text = "  " + adjName + " = add i32 " + lenText + ", " + indexText)
    let id = out.ctx.temp
    out.ctx.temp = id + 1
    let name = tempName(index = id)
    appendLine(sink = out.ctx.lines, text = "  " + name + " = select i1 " + negName + ", i32 " + adjName + ", i32 " + indexText)
    out.text = name
    return out

; 负下标尾计数：取长度后加上下标，从尾部数；越界由运行时陷阱，本层不夹界。
tailIndex|func(ctx: BodyCtx, containerText: String, indexText: String,) -> (ExprOut,):
    var out = ExprOut()
    out.ctx = ctx
    useExtern(use = out.ctx.externs, name = "bk_array_len")
    let lenId = out.ctx.temp
    out.ctx.temp = lenId + 1
    let lenName = tempName(index = lenId)
    appendLine(sink = out.ctx.lines, text = "  " + lenName + " = call i32 @bk_array_len(ptr " + containerText + ")")
    let negId = out.ctx.temp
    out.ctx.temp = negId + 1
    let negName = tempName(index = negId)
    appendLine(sink = out.ctx.lines, text = "  " + negName + " = icmp slt i32 " + indexText + ", 0")
    let adjId = out.ctx.temp
    out.ctx.temp = adjId + 1
    let adjName = tempName(index = adjId)
    appendLine(sink = out.ctx.lines, text = "  " + adjName + " = add i32 " + lenName + ", " + indexText)
    let id = out.ctx.temp
    out.ctx.temp = id + 1
    let name = tempName(index = id)
    appendLine(sink = out.ctx.lines, text = "  " + name + " = select i1 " + negName + ", i32 " + adjName + ", i32 " + indexText)
    out.text = name
    return out

; 下标读：按容器类别分派；数组负值尾计数，字串走字素通道，字典按键取。
emitSubscriptGet|func(out: ExprOut, module: IrModule, node: IrNode,) -> (ExprOut,):
    var done = out
    if len(node.kids) < 2:
        done.ctx = addGap(ctx = done.ctx, gap = "下标读缺操作数")
        return done
    let container = emitExpr(ctx = done.ctx, module = module, nodeId = node.kids[0])
    done.ctx = container.ctx
    let index = emitExpr(ctx = done.ctx, module = module, nodeId = node.kids[1])
    done.ctx = index.ctx
    let containerTag = typeTagOf(module = module, nodeId = node.kids[0])
    if containerTag == 8:
        useExtern(use = done.ctx.externs, name = "bk_string_char_at")
        let id = done.ctx.temp
        done.ctx.temp = id + 1
        let name = tempName(index = id)
        let args = "ptr " + container.text + ", i32 " + index.text
        appendLine(sink = done.ctx.lines, text = "  " + name + " = call i64 @bk_string_char_at(" + args + ")")
        done.text = name
        return done
    if containerTag == 16:
        return emitDictGet(ctx = done.ctx, module = module, node = node, containerText = container.text, keyText = index.text)
    let eff = tailIndex(ctx = done.ctx, containerText = container.text, indexText = index.text)
    done.ctx = eff.ctx
    useExtern(use = done.ctx.externs, name = "bk_array_get")
    let boxId = done.ctx.temp
    done.ctx.temp = boxId + 1
    let box = tempName(index = boxId)
    appendLine(sink = done.ctx.lines, text = "  " + box + " = call ptr @bk_array_get(ptr " + container.text + ", i32 " + eff.text + ")")
    let typeName = llvmTypeName(pool = module.types, typeId = node.typeId)
    let id = done.ctx.temp
    done.ctx.temp = id + 1
    let name = tempName(index = id)
    appendLine(sink = done.ctx.lines, text = "  " + name + " = load " + typeName + ", ptr " + box)
    done.text = name
    return done

; 字典读：键先按自身宽度与标签装箱，再交给运行时；取回的是元素地址，按值类型读。
emitDictGet|func(ctx: BodyCtx, module: IrModule, node: IrNode, containerText: String, keyText: String,) -> (ExprOut,):
    var out = ExprOut()
    out.ctx = ctx
    let keyType = irNodeAt(pool = module.nodes, id = node.kids[1]).typeId
    let width = elementWidth(pool = module.types, typeId = keyType, pointerBytes = out.ctx.pointerBytes)
    let keyTag = elementTag(pool = module.types, typeId = keyType)
    if width == 0 || keyTag < 0:
        out.ctx = addGap(ctx = out.ctx, gap = "字典键装箱 类别码 " + countText(typeTagAt(module = module, typeId = keyType)))
        return out
    let keyName = llvmTypeName(pool = module.types, typeId = keyType)
    let box = allocSlot(ctx = out.ctx, typeName = keyName)
    out.ctx = box.ctx
    appendLine(sink = out.ctx.lines, text = "  store " + keyName + " " + keyText + ", ptr " + box.text)
    useExtern(use = out.ctx.externs, name = "bk_dict_get")
    let rawId = out.ctx.temp
    out.ctx.temp = rawId + 1
    let raw = tempName(index = rawId)
    let args = "ptr " + containerText + ", ptr " + box.text + ", i32 " + countText(width) + ", i32 " + countText(keyTag)
    appendLine(sink = out.ctx.lines, text = "  " + raw + " = call ptr @bk_dict_get(" + args + ")")
    let valueName = llvmTypeName(pool = module.types, typeId = node.typeId)
    let id = out.ctx.temp
    out.ctx.temp = id + 1
    let name = tempName(index = id)
    appendLine(sink = out.ctx.lines, text = "  " + name + " = load " + valueName + ", ptr " + raw)
    out.text = name
    return out

; 下标写：值先装箱，再交给运行时写元素；返回的新句柄写回容器所在的槽或字段。
emitSubscriptStore|func(ctx: BodyCtx, module: IrModule, node: IrNode,) -> (BodyCtx,):
    var out = ctx
    if len(node.kids) < 3:
        return addGap(ctx = out, gap = "下标写缺操作数")
    let container = emitExpr(ctx = out, module = module, nodeId = node.kids[0])
    out = container.ctx
    let index = emitExpr(ctx = out, module = module, nodeId = node.kids[1])
    out = index.ctx
    let value = emitExpr(ctx = out, module = module, nodeId = node.kids[2])
    out = value.ctx
    let width = elementWidth(pool = module.types, typeId = node.typeId, pointerBytes = out.pointerBytes)
    let containerTag = typeTagOf(module = module, nodeId = node.kids[0])
    var elemTag = arrayElementTag(pool = module.types, typeId = node.typeId)
    if containerTag == 16:
        elemTag = elementTag(pool = module.types, typeId = node.typeId)
    if width == 0 || elemTag < 0:
        return addGap(ctx = out, gap = "下标写元素装箱 类别码 " + countText(typeTagAt(module = module, typeId = node.typeId)))
    let typeName = llvmTypeName(pool = module.types, typeId = node.typeId)
    let box = allocSlot(ctx = out, typeName = typeName)
    out = box.ctx
    let shaped = storeValue(ctx = out, module = module, text = value.text, fromType = irNodeAt(pool = module.nodes, id = node.kids[2]).typeId, toType = node.typeId)
    out = shaped.ctx
    ; 元素份额由写入口消费，故这里把账上那一份交出去，语句收尾不再归还。
    out = adoptValue(ctx = out, module = module, name = shaped.text, typeId = node.typeId, adopt = 1)
    appendLine(sink = out.lines, text = "  store " + typeName + " " + shaped.text + ", ptr " + box.text)
    if containerTag == 16:
        return emitDictStore(ctx = out, module = module, node = node, containerText = container.text, keyText = index.text, box = box.text, width = width, tag = elemTag)
    useExtern(use = out.externs, name = "bk_array_set")
    let nextId = out.temp
    out.temp = nextId + 1
    let next = tempName(index = nextId)
    let args = "ptr " + container.text + ", i32 " + index.text + ", ptr " + box.text + ", i32 " + countText(width) + ", i32 " + countText(elemTag)
    appendLine(sink = out.lines, text = "  " + next + " = call ptr @bk_array_set(" + args + ")")
    return storeHandleBack(ctx = out, module = module, containerId = node.kids[0], text = next)

; 字典写：键与值各装一箱，返回的新句柄同样写回容器所在位置。
emitDictStore|func(ctx: BodyCtx, module: IrModule, node: IrNode, containerText: String, keyText: String, box: String, width: I32, tag: I32,) -> (BodyCtx,):
    var out = ctx
    let keyType = irNodeAt(pool = module.nodes, id = node.kids[1]).typeId
    let keyWidth = elementWidth(pool = module.types, typeId = keyType, pointerBytes = out.pointerBytes)
    let keyTag = elementTag(pool = module.types, typeId = keyType)
    if keyWidth == 0 || keyTag < 0:
        return addGap(ctx = out, gap = "字典写键装箱 类别码 " + countText(typeTagAt(module = module, typeId = keyType)))
    let keyName = llvmTypeName(pool = module.types, typeId = keyType)
    let keyBox = allocSlot(ctx = out, typeName = keyName)
    out = keyBox.ctx
    appendLine(sink = out.lines, text = "  store " + keyName + " " + keyText + ", ptr " + keyBox.text)
    useExtern(use = out.externs, name = "bk_dict_set")
    let nextId = out.temp
    out.temp = nextId + 1
    let next = tempName(index = nextId)
    var args = "ptr " + containerText + ", ptr " + keyBox.text + ", i32 " + countText(keyWidth) + ", i32 " + countText(keyTag)
    args = args + ", ptr " + box + ", i32 " + countText(width) + ", i32 " + countText(tag)
    appendLine(sink = out.lines, text = "  " + next + " = call ptr @bk_dict_set(" + args + ")")
    return storeHandleBack(ctx = out, module = module, containerId = node.kids[0], text = next)

; 句柄写回：写容器换出的新句柄必须被槽或字段接住，否则那次写只落在旧箱上。
storeHandleBack|func(ctx: BodyCtx, module: IrModule, containerId: I32, text: String,) -> (BodyCtx,):
    var out = ctx
    let node = irNodeAt(pool = module.nodes, id = containerId)
    if node.kind == 5:
        appendLine(sink = out.lines, text = "  store ptr " + text + ", ptr " + slotNameOf(ctx = out, slot = node.intValue as I32))
        return out
    if node.kind == 28:
        let baseType = irNodeAt(pool = module.nodes, id = node.kids[0]).typeId
        let agg = llvmAggregateName(pool = module.types, typeId = baseType)
        if len(agg) > 0:
            let base = emitExpr(ctx = out, module = module, nodeId = node.kids[0])
            out = base.ctx
            let at = slotPtr(ctx = out, agg = agg, base = base.text, slot = fieldSlotIndex(table = module.slots, fieldIndex = node.op))
            out = at.ctx
            appendLine(sink = out.lines, text = "  store ptr " + text + ", ptr " + at.text)
    return out

; 切片：字串交给运行时段按字素切，数组按元素逐个搬进新句柄；两界都先夹到 [0, len]。
emitSliceCall|func(out: ExprOut, module: IrModule, node: IrNode,) -> (ExprOut,):
    var done = out
    if len(node.kids) < 3:
        done.ctx = addGap(ctx = done.ctx, gap = "切片缺操作数")
        return done
    let container = emitExpr(ctx = done.ctx, module = module, nodeId = node.kids[0])
    done.ctx = container.ctx
    let start = emitExpr(ctx = done.ctx, module = module, nodeId = node.kids[1])
    done.ctx = start.ctx
    let startBound = sliceBound(ctx = done.ctx, module = module, nodeId = node.kids[1], text = start.text)
    done.ctx = startBound.ctx
    let end = emitExpr(ctx = done.ctx, module = module, nodeId = node.kids[2])
    done.ctx = end.ctx
    let endBound = sliceBound(ctx = done.ctx, module = module, nodeId = node.kids[2], text = end.text)
    done.ctx = endBound.ctx
    let containerTag = typeTagOf(module = module, nodeId = node.kids[0])
    if containerTag == 8:
        useExtern(use = done.ctx.externs, name = "bk_string_slice")
        let id = done.ctx.temp
        done.ctx.temp = id + 1
        let name = tempName(index = id)
        var args = "ptr " + container.text + ", i32 " + startBound.flag + ", i32 " + startBound.text
        args = args + ", i32 " + endBound.flag + ", i32 " + endBound.text
        appendLine(sink = done.ctx.lines, text = "  " + name + " = call ptr @bk_string_slice(" + args + ")")
        done.text = name
        return done
    return emitArraySlice(out = done, module = module, node = node, containerText = container.text, startText = startBound.text, startHas = startBound.flag, endText = endBound.text, endHas = endBound.flag)

; 切片边界：实参是可选时拆成「有无」与「值」，裸值恒有；有无按 i32 落 flag，值落 text。
sliceBound|func(ctx: BodyCtx, module: IrModule, nodeId: I32, text: String,) -> (ExprOut,):
    var out = ExprOut()
    out.ctx = ctx
    out.text = text
    out.flag = "1"
    if typeTagOf(module = module, nodeId = nodeId) != 13:
        return out
    let typeId = irNodeAt(pool = module.nodes, id = nodeId).typeId
    let aggregate = llvmTypeName(pool = module.types, typeId = typeId)
    let tagId = out.ctx.temp
    out.ctx.temp = tagId + 1
    let tagName = tempName(index = tagId)
    appendLine(sink = out.ctx.lines, text = "  " + tagName + " = extractvalue " + aggregate + " " + text + ", 0")
    let hasId = out.ctx.temp
    out.ctx.temp = hasId + 1
    let hasText = tempName(index = hasId)
    appendLine(sink = out.ctx.lines, text = "  " + hasText + " = icmp eq i64 " + tagName + ", 0")
    let wideId = out.ctx.temp
    out.ctx.temp = wideId + 1
    let wideText = tempName(index = wideId)
    appendLine(sink = out.ctx.lines, text = "  " + wideText + " = zext i1 " + hasText + " to i32")
    let valueId = out.ctx.temp
    out.ctx.temp = valueId + 1
    let valueName = tempName(index = valueId)
    appendLine(sink = out.ctx.lines, text = "  " + valueName + " = extractvalue " + aggregate + " " + text + ", 1")
    out.text = valueName
    out.flag = wideText
    return out

; 界夹取：负数按尾计数，无边界取默认值，再夹到 [0, count]；返回一个 i32 值串。
clampBound|func(ctx: BodyCtx, lenText: String, boundText: String, hasText: String, defaultText: String,) -> (ExprOut,):
    var out = ExprOut()
    out.ctx = ctx
    let negId = out.ctx.temp
    out.ctx.temp = negId + 1
    let neg = tempName(index = negId)
    appendLine(sink = out.ctx.lines, text = "  " + neg + " = icmp slt i32 " + boundText + ", 0")
    let adjId = out.ctx.temp
    out.ctx.temp = adjId + 1
    let adj = tempName(index = adjId)
    appendLine(sink = out.ctx.lines, text = "  " + adj + " = add i32 " + lenText + ", " + boundText)
    let baseId = out.ctx.temp
    out.ctx.temp = baseId + 1
    let base = tempName(index = baseId)
    appendLine(sink = out.ctx.lines, text = "  " + base + " = select i1 " + neg + ", i32 " + adj + ", i32 " + boundText)
    let hasOneId = out.ctx.temp
    out.ctx.temp = hasOneId + 1
    let hasOne = tempName(index = hasOneId)
    appendLine(sink = out.ctx.lines, text = "  " + hasOne + " = icmp ne i32 " + hasText + ", 0")
    let pickId = out.ctx.temp
    out.ctx.temp = pickId + 1
    let pick = tempName(index = pickId)
    appendLine(sink = out.ctx.lines, text = "  " + pick + " = select i1 " + hasOne + ", i32 " + base + ", i32 " + defaultText)
    let lowId = out.ctx.temp
    out.ctx.temp = lowId + 1
    let low = tempName(index = lowId)
    appendLine(sink = out.ctx.lines, text = "  " + low + " = icmp slt i32 " + pick + ", 0")
    let zeroId = out.ctx.temp
    out.ctx.temp = zeroId + 1
    let zero = tempName(index = zeroId)
    appendLine(sink = out.ctx.lines, text = "  " + zero + " = select i1 " + low + ", i32 0, i32 " + pick)
    let highId = out.ctx.temp
    out.ctx.temp = highId + 1
    let high = tempName(index = highId)
    appendLine(sink = out.ctx.lines, text = "  " + high + " = icmp sgt i32 " + zero + ", " + lenText)
    let id = out.ctx.temp
    out.ctx.temp = id + 1
    let name = tempName(index = id)
    appendLine(sink = out.ctx.lines, text = "  " + name + " = select i1 " + high + ", i32 " + lenText + ", i32 " + zero)
    out.text = name
    return out

; 数组切片：先夹界再建新句柄，逐元素搬字节；源数组不动，结果自带一份存储。
emitArraySlice|func(out: ExprOut, module: IrModule, node: IrNode, containerText: String, startText: String, startHas: String, endText: String, endHas: String,) -> (ExprOut,):
    var done = out
    var elementType = -1
    if node.typeId >= 0 && node.typeId < irTypeCount(module.types):
        let kids = irTypeAt(pool = module.types, id = node.typeId).kids
        if len(kids) > 0:
            elementType = kids[0]
    let width = elementWidth(pool = module.types, typeId = elementType, pointerBytes = done.ctx.pointerBytes)
    let elemTag = arrayElementTag(pool = module.types, typeId = elementType)
    if width == 0 || elemTag < 0:
        done.ctx = addGap(ctx = done.ctx, gap = "切片元素装箱 类别码 " + countText(typeTagAt(module = module, typeId = elementType)))
        return done
    useExtern(use = done.ctx.externs, name = "bk_array_len")
    let countId = done.ctx.temp
    done.ctx.temp = countId + 1
    let count = tempName(index = countId)
    appendLine(sink = done.ctx.lines, text = "  " + count + " = call i32 @bk_array_len(ptr " + containerText + ")")
    let lo = clampBound(ctx = done.ctx, lenText = count, boundText = startText, hasText = startHas, defaultText = "0")
    done.ctx = lo.ctx
    let hi = clampBound(ctx = done.ctx, lenText = count, boundText = endText, hasText = endHas, defaultText = count)
    done.ctx = hi.ctx
    let spanId = done.ctx.temp
    done.ctx.temp = spanId + 1
    let span = tempName(index = spanId)
    appendLine(sink = done.ctx.lines, text = "  " + span + " = sub i32 " + hi.text + ", " + lo.text)
    let negId = done.ctx.temp
    done.ctx.temp = negId + 1
    let neg = tempName(index = negId)
    appendLine(sink = done.ctx.lines, text = "  " + neg + " = icmp slt i32 " + span + ", 0")
    let lenId = done.ctx.temp
    done.ctx.temp = lenId + 1
    let length = tempName(index = lenId)
    appendLine(sink = done.ctx.lines, text = "  " + length + " = select i1 " + neg + ", i32 0, i32 " + span)
    useExtern(use = done.ctx.externs, name = "bk_array_create")
    let makeId = done.ctx.temp
    done.ctx.temp = makeId + 1
    let made = tempName(index = makeId)
    appendLine(sink = done.ctx.lines, text = "  " + made + " = call ptr @bk_array_create(i32 " + length + ")")
    done.ctx = registerAggHooks(ctx = done.ctx, module = module, handle = made, elementType = elementType)
    let hold = allocSlot(ctx = done.ctx, typeName = "ptr")
    done.ctx = hold.ctx
    appendLine(sink = done.ctx.lines, text = "  store ptr " + made + ", ptr " + hold.text)
    let cursor = allocSlot(ctx = done.ctx, typeName = "i32")
    done.ctx = cursor.ctx
    appendLine(sink = done.ctx.lines, text = "  store i32 0, ptr " + cursor.text)
    let at = done.ctx.label
    done.ctx.label = at + 1
    let condLabel = labelName(prefix = "slice.cond.", index = at)
    let bodyLabel = labelName(prefix = "slice.body.", index = at)
    let incLabel = labelName(prefix = "slice.inc.", index = at)
    let endLabel = labelName(prefix = "slice.end.", index = at)
    appendLine(sink = done.ctx.lines, text = "  br label %" + condLabel)
    appendLine(sink = done.ctx.lines, text = condLabel + ":")
    let kId = done.ctx.temp
    done.ctx.temp = kId + 1
    let k = tempName(index = kId)
    appendLine(sink = done.ctx.lines, text = "  " + k + " = load i32, ptr " + cursor.text)
    let inId = done.ctx.temp
    done.ctx.temp = inId + 1
    let inside = tempName(index = inId)
    appendLine(sink = done.ctx.lines, text = "  " + inside + " = icmp slt i32 " + k + ", " + length)
    appendLine(sink = done.ctx.lines, text = "  br i1 " + inside + ", label %" + bodyLabel + ", label %" + endLabel)
    appendLine(sink = done.ctx.lines, text = bodyLabel + ":")
    let curId = done.ctx.temp
    done.ctx.temp = curId + 1
    let cur = tempName(index = curId)
    appendLine(sink = done.ctx.lines, text = "  " + cur + " = load ptr, ptr " + hold.text)
    let srcId = done.ctx.temp
    done.ctx.temp = srcId + 1
    let src = tempName(index = srcId)
    appendLine(sink = done.ctx.lines, text = "  " + src + " = add i32 " + lo.text + ", " + k)
    useExtern(use = done.ctx.externs, name = "bk_array_get")
    let boxId = done.ctx.temp
    done.ctx.temp = boxId + 1
    let box = tempName(index = boxId)
    appendLine(sink = done.ctx.lines, text = "  " + box + " = call ptr @bk_array_get(ptr " + containerText + ", i32 " + src + ")")
    ; 元素按箱共享：源数组仍握着那一份，新数组必须自带一份，否则两边只付一次。
    if aggElement(module = module, typeId = elementType):
        useExtern(use = done.ctx.externs, name = "bk_nominal_retain")
        let keptId = done.ctx.temp
        done.ctx.temp = keptId + 1
        let kept = tempName(index = keptId)
        appendLine(sink = done.ctx.lines, text = "  " + kept + " = load ptr, ptr " + box)
        appendLine(sink = done.ctx.lines, text = "  call void @bk_nominal_retain(ptr " + kept + ")")
    useExtern(use = done.ctx.externs, name = "bk_array_set")
    let nextId = done.ctx.temp
    done.ctx.temp = nextId + 1
    let next = tempName(index = nextId)
    var args = "ptr " + cur + ", i32 " + k + ", ptr " + box
    args = args + ", i32 " + countText(width) + ", i32 " + countText(elemTag)
    appendLine(sink = done.ctx.lines, text = "  " + next + " = call ptr @bk_array_set(" + args + ")")
    appendLine(sink = done.ctx.lines, text = "  store ptr " + next + ", ptr " + hold.text)
    appendLine(sink = done.ctx.lines, text = "  br label %" + incLabel)
    appendLine(sink = done.ctx.lines, text = incLabel + ":")
    let stepId = done.ctx.temp
    done.ctx.temp = stepId + 1
    let moved = tempName(index = stepId)
    appendLine(sink = done.ctx.lines, text = "  " + moved + " = load i32, ptr " + cursor.text)
    let bumpedId = done.ctx.temp
    done.ctx.temp = bumpedId + 1
    let bumped = tempName(index = bumpedId)
    appendLine(sink = done.ctx.lines, text = "  " + bumped + " = add i32 " + moved + ", 1")
    appendLine(sink = done.ctx.lines, text = "  store i32 " + bumped + ", ptr " + cursor.text)
    appendLine(sink = done.ctx.lines, text = "  br label %" + condLabel)
    appendLine(sink = done.ctx.lines, text = endLabel + ":")
    let id = done.ctx.temp
    done.ctx.temp = id + 1
    let name = tempName(index = id)
    appendLine(sink = done.ctx.lines, text = "  " + name + " = load ptr, ptr " + hold.text)
    done.text = name
    return done

; 短路：先求左侧，结果已定就不求值右侧；两侧都汇到同一出口，右侧块只被条件边进入。
emitShortCircuit|func(out: ExprOut, module: IrModule, node: IrNode,) -> (ExprOut,):
    var done = out
    let lhs = emitExpr(ctx = done.ctx, module = module, nodeId = node.kids[0])
    done.ctx = lhs.ctx
    let slot = allocSlot(ctx = done.ctx, typeName = "i1")
    done.ctx = slot.ctx
    appendLine(sink = done.ctx.lines, text = "  store i1 " + lhs.text + ", ptr " + slot.text)
    let at = done.ctx.label
    done.ctx.label = at + 1
    let rhsLabel = labelName(prefix = "sc.rhs.", index = at)
    let endLabel = labelName(prefix = "sc.end.", index = at)
    if node.op == 2:
        appendLine(sink = done.ctx.lines, text = "  br i1 " + lhs.text + ", label %" + endLabel + ", label %" + rhsLabel)
    else:
        appendLine(sink = done.ctx.lines, text = "  br i1 " + lhs.text + ", label %" + rhsLabel + ", label %" + endLabel)
    appendLine(sink = done.ctx.lines, text = rhsLabel + ":")
    let keep = len(done.ctx.held)
    let rhs = emitExpr(ctx = done.ctx, module = module, nodeId = node.kids[1])
    done.ctx = rhs.ctx
    appendLine(sink = done.ctx.lines, text = "  store i1 " + rhs.text + ", ptr " + slot.text)
    done.ctx = flushHeldFrom(ctx = done.ctx, module = module, keep = keep)
    appendLine(sink = done.ctx.lines, text = "  br label %" + endLabel)
    appendLine(sink = done.ctx.lines, text = endLabel + ":")
    let id = done.ctx.temp
    done.ctx.temp = id + 1
    let name = tempName(index = id)
    appendLine(sink = done.ctx.lines, text = "  " + name + " = load i1, ptr " + slot.text)
    done.text = name
    return done

; 一元字符串调用：接收者求值一次后交给运行时段，upper/lower 与左右修剪共用这一形状。
emitStringUnaryCall|func(out: ExprOut, module: IrModule, node: IrNode, symbol: String,) -> (ExprOut,):
    var done = out
    if len(node.kids) < 1:
        done.ctx = addGap(ctx = done.ctx, gap = "字串一元成员缺接收者")
        return done
    let receiver = emitExpr(ctx = done.ctx, module = module, nodeId = node.kids[0])
    done.ctx = receiver.ctx
    useExtern(use = done.ctx.externs, name = symbol)
    let id = done.ctx.temp
    done.ctx.temp = id + 1
    let name = tempName(index = id)
    appendLine(sink = done.ctx.lines, text = "  " + name + " = call ptr @" + symbol + "(ptr " + receiver.text + ")")
    done.text = name
    return done

; 双参字符串调用：接收者与实参各求值一次；判据收 i32 再收成 i1，切分与查位按节点类型回值。
emitStringPairCall|func(out: ExprOut, module: IrModule, node: IrNode, symbol: String, asBool: Bool,) -> (ExprOut,):
    var done = out
    let receiver = emitExpr(ctx = done.ctx, module = module, nodeId = node.kids[0])
    done.ctx = receiver.ctx
    let arg = emitExpr(ctx = done.ctx, module = module, nodeId = node.kids[1])
    done.ctx = arg.ctx
    useExtern(use = done.ctx.externs, name = symbol)
    let hitId = done.ctx.temp
    done.ctx.temp = hitId + 1
    let hit = tempName(index = hitId)
    var retType = llvmTypeName(pool = module.types, typeId = node.typeId)
    if asBool:
        retType = "i32"
    appendLine(sink = done.ctx.lines, text = "  " + hit + " = call " + retType + " @" + symbol + "(ptr " + receiver.text + ", ptr " + arg.text + ")")
    if asBool:
        let id = done.ctx.temp
        done.ctx.temp = id + 1
        let name = tempName(index = id)
        appendLine(sink = done.ctx.lines, text = "  " + name + " = icmp ne i32 " + hit + ", 0")
        done.text = name
        return done
    done.text = hit
    return done

; 子串：两界原样交给运行时段，负值尾计数与夹界都在那一侧，调用点不重复实现。
emitStringSubstring|func(out: ExprOut, module: IrModule, node: IrNode,) -> (ExprOut,):
    var done = out
    let receiver = emitExpr(ctx = done.ctx, module = module, nodeId = node.kids[0])
    done.ctx = receiver.ctx
    let start = emitExpr(ctx = done.ctx, module = module, nodeId = node.kids[1])
    done.ctx = start.ctx
    let end = emitExpr(ctx = done.ctx, module = module, nodeId = node.kids[2])
    done.ctx = end.ctx
    useExtern(use = done.ctx.externs, name = "bk_substring")
    let id = done.ctx.temp
    done.ctx.temp = id + 1
    let name = tempName(index = id)
    var args = "ptr " + receiver.text + ", i32 " + start.text + ", i32 " + end.text
    appendLine(sink = done.ctx.lines, text = "  " + name + " = call ptr @bk_substring(" + args + ")")
    done.text = name
    return done

; 追加一段：把指针交给运行时拼接，句柄槽接住新句柄；空槽由运行时按零长度起步。
appendToBuffer|func(ctx: BodyCtx, slot: String, piece: String,) -> (BodyCtx,):
    var out = ctx
    useExtern(use = out.externs, name = "bk_str_append_cstr")
    let curId = out.temp
    out.temp = curId + 1
    let cur = tempName(index = curId)
    appendLine(sink = out.lines, text = "  " + cur + " = load ptr, ptr " + slot)
    let nextId = out.temp
    out.temp = nextId + 1
    let next = tempName(index = nextId)
    appendLine(sink = out.lines, text = "  " + next + " = call ptr @bk_str_append_cstr(ptr " + cur + ", ptr " + piece + ", i32 1)")
    appendLine(sink = out.lines, text = "  store ptr " + next + ", ptr " + slot)
    return out

; 插值段：先求值成节点值，再按类型渲染成 C 串；越界节点只报缺口，不猜类型。
emitPiece|func(ctx: BodyCtx, module: IrModule, nodeId: I32,) -> (ExprOut,):
    var out = ExprOut()
    out.ctx = ctx
    if nodeId < 0 || nodeId >= irNodeCount(module.nodes):
        out.ctx = addGap(ctx = out.ctx, gap = "悬空插值段")
        return out
    let node = irNodeAt(pool = module.nodes, id = nodeId)
    let value = emitExpr(ctx = out.ctx, module = module, nodeId = nodeId)
    return renderValue(ctx = value.ctx, module = module, text = value.text, typeId = node.typeId)

; 值渲染：串直接借出，布尔与标量就地格式化，数组递归逐元素展开。
; 未认类别报缺口并留空串，调用方据空串停止拼接，不拿占位文本充数。
renderValue|func(ctx: BodyCtx, module: IrModule, text: String, typeId: I32,) -> (ExprOut,):
    var out = ExprOut()
    out.ctx = ctx
    let tag = typeTagAt(module = module, typeId = typeId)
    if tag == 8:
        out.text = text
        return out
    if tag == 7:
        let id = out.ctx.temp
        out.ctx.temp = id + 1
        let sel = tempName(index = id)
        appendLine(sink = out.ctx.lines, text = "  " + sel + " = select i1 " + text + ", ptr @fmt_bool_true, ptr @fmt_bool_false")
        out.text = sel
        return out
    if tag == 6:
        useExtern(use = out.ctx.externs, name = "bk_double_to_string")
        let id = out.ctx.temp
        out.ctx.temp = id + 1
        let name = tempName(index = id)
        appendLine(sink = out.ctx.lines, text = "  " + name + " = call ptr @bk_double_to_string(double " + text + ")")
        out.text = name
        return out
    if tag == 9:
        useExtern(use = out.ctx.externs, name = "bk_char_to_heap_string")
        let id = out.ctx.temp
        out.ctx.temp = id + 1
        let name = tempName(index = id)
        appendLine(sink = out.ctx.lines, text = "  " + name + " = call ptr @bk_char_to_heap_string(i64 " + text + ")")
        out.text = name
        return out
    if tag == 1 || tag == 2 || tag == 3 || tag == 4 || tag == 5:
        var wide = text
        if tag == 2 || tag == 3:
            let wideId = out.ctx.temp
            out.ctx.temp = wideId + 1
            let name = tempName(index = wideId)
            appendLine(sink = out.ctx.lines, text = "  " + name + " = trunc i64 " + text + " to i32")
            wide = name
        if tag == 4 || tag == 5:
            let smallId = out.ctx.temp
            out.ctx.temp = smallId + 1
            let small = tempName(index = smallId)
            appendLine(sink = out.ctx.lines, text = "  " + small + " = sext i8 " + text + " to i32")
            wide = small
        let buf = allocSlot(ctx = out.ctx, typeName = "[32 x i8]")
        out.ctx = buf.ctx
        useExtern(use = out.ctx.externs, name = "snprintf")
        let args = "ptr " + buf.text + ", i64 32, ptr @fmt_int, i32 " + wide
        appendLine(sink = out.ctx.lines, text = "  call i32 (ptr, i64, ptr, ...) @snprintf(" + args + ")")
        out.text = buf.text
        return out
    if tag == 12:
        return renderArray(ctx = out.ctx, module = module, text = text, typeId = typeId)
    out.ctx = addGap(ctx = out.ctx, gap = "插值段 类别码 " + countText(tag))
    return out

; 数组渲染：`[` 加逐元素递归再加 `]`，首个元素前不补分隔符，空数组得 `[]`。
; 元素串由拼接按所有权接管，循环内不再单独归还；元素类别未接时沿用同一张缺口表。
renderArray|func(ctx: BodyCtx, module: IrModule, text: String, typeId: I32,) -> (ExprOut,):
    var out = ExprOut()
    out.ctx = ctx
    var elemType = -1
    if typeId >= 0 && typeId < irTypeCount(module.types):
        let entry = irTypeAt(pool = module.types, id = typeId)
        if len(entry.kids) > 0:
            elemType = entry.kids[0]
    let spelling = llvmTypeName(pool = module.types, typeId = elemType)
    useExtern(use = out.ctx.externs, name = "bk_array_len")
    useExtern(use = out.ctx.externs, name = "bk_array_get")
    let slot = allocSlot(ctx = out.ctx, typeName = "ptr")
    out.ctx = slot.ctx
    appendLine(sink = out.ctx.lines, text = "  store ptr null, ptr " + slot.text)
    out.ctx = appendToBuffer(ctx = out.ctx, slot = slot.text, piece = "@fmt_lbracket")
    let countId = out.ctx.temp
    out.ctx.temp = countId + 1
    let count = tempName(index = countId)
    appendLine(sink = out.ctx.lines, text = "  " + count + " = call i32 @bk_array_len(ptr " + text + ")")
    let cursor = allocSlot(ctx = out.ctx, typeName = "i32")
    out.ctx = cursor.ctx
    appendLine(sink = out.ctx.lines, text = "  store i32 0, ptr " + cursor.text)
    let at = out.ctx.label
    out.ctx.label = at + 1
    let condLabel = labelName(prefix = "arr.cond.", index = at)
    let bodyLabel = labelName(prefix = "arr.body.", index = at)
    let sepLabel = labelName(prefix = "arr.sep.", index = at)
    let elemLabel = labelName(prefix = "arr.elem.", index = at)
    let incLabel = labelName(prefix = "arr.inc.", index = at)
    let endLabel = labelName(prefix = "arr.end.", index = at)
    appendLine(sink = out.ctx.lines, text = "  br label %" + condLabel)
    appendLine(sink = out.ctx.lines, text = condLabel + ":")
    let kId = out.ctx.temp
    out.ctx.temp = kId + 1
    let k = tempName(index = kId)
    appendLine(sink = out.ctx.lines, text = "  " + k + " = load i32, ptr " + cursor.text)
    let inId = out.ctx.temp
    out.ctx.temp = inId + 1
    let inside = tempName(index = inId)
    appendLine(sink = out.ctx.lines, text = "  " + inside + " = icmp slt i32 " + k + ", " + count)
    appendLine(sink = out.ctx.lines, text = "  br i1 " + inside + ", label %" + bodyLabel + ", label %" + endLabel)
    appendLine(sink = out.ctx.lines, text = bodyLabel + ":")
    let firstId = out.ctx.temp
    out.ctx.temp = firstId + 1
    let first = tempName(index = firstId)
    appendLine(sink = out.ctx.lines, text = "  " + first + " = icmp eq i32 " + k + ", 0")
    appendLine(sink = out.ctx.lines, text = "  br i1 " + first + ", label %" + elemLabel + ", label %" + sepLabel)
    appendLine(sink = out.ctx.lines, text = sepLabel + ":")
    out.ctx = appendToBuffer(ctx = out.ctx, slot = slot.text, piece = "@fmt_comma")
    appendLine(sink = out.ctx.lines, text = "  br label %" + elemLabel)
    appendLine(sink = out.ctx.lines, text = elemLabel + ":")
    let boxId = out.ctx.temp
    out.ctx.temp = boxId + 1
    let box = tempName(index = boxId)
    appendLine(sink = out.ctx.lines, text = "  " + box + " = call ptr @bk_array_get(ptr " + text + ", i32 " + k + ")")
    let elemId = out.ctx.temp
    out.ctx.temp = elemId + 1
    let elem = tempName(index = elemId)
    appendLine(sink = out.ctx.lines, text = "  " + elem + " = load " + spelling + ", ptr " + box)
    let piece = renderValue(ctx = out.ctx, module = module, text = elem, typeId = elemType)
    out.ctx = piece.ctx
    if len(piece.text) == 0:
        return out
    out.ctx = appendToBuffer(ctx = out.ctx, slot = slot.text, piece = piece.text)
    appendLine(sink = out.ctx.lines, text = "  br label %" + incLabel)
    appendLine(sink = out.ctx.lines, text = incLabel + ":")
    let stepId = out.ctx.temp
    out.ctx.temp = stepId + 1
    let moved = tempName(index = stepId)
    appendLine(sink = out.ctx.lines, text = "  " + moved + " = load i32, ptr " + cursor.text)
    let bumpedId = out.ctx.temp
    out.ctx.temp = bumpedId + 1
    let bumped = tempName(index = bumpedId)
    appendLine(sink = out.ctx.lines, text = "  " + bumped + " = add i32 " + moved + ", 1")
    appendLine(sink = out.ctx.lines, text = "  store i32 " + bumped + ", ptr " + cursor.text)
    appendLine(sink = out.ctx.lines, text = "  br label %" + condLabel)
    appendLine(sink = out.ctx.lines, text = endLabel + ":")
    out.ctx = appendToBuffer(ctx = out.ctx, slot = slot.text, piece = "@fmt_rbracket")
    let id = out.ctx.temp
    out.ctx.temp = id + 1
    let name = tempName(index = id)
    appendLine(sink = out.ctx.lines, text = "  " + name + " = load ptr, ptr " + slot.text)
    out.text = name
    return out

; 插值串：逐段追加进同一条句柄，段间不再各造一次常量；结果按节点类型是串。
emitInterp|func(out: ExprOut, module: IrModule, node: IrNode,) -> (ExprOut,):
    var done = out
    let slot = allocSlot(ctx = done.ctx, typeName = "ptr")
    done.ctx = slot.ctx
    appendLine(sink = done.ctx.lines, text = "  store ptr null, ptr " + slot.text)
    var i = 0
    while i < len(node.kids):
        let piece = emitPiece(ctx = done.ctx, module = module, nodeId = node.kids[i])
        done.ctx = piece.ctx
        if len(piece.text) == 0:
            return done
        done.ctx = appendToBuffer(ctx = done.ctx, slot = slot.text, piece = piece.text)
        i = i + 1
    let id = done.ctx.temp
    done.ctx.temp = id + 1
    let name = tempName(index = id)
    appendLine(sink = done.ctx.lines, text = "  " + name + " = load ptr, ptr " + slot.text)
    done.text = name
    return done

; 数组连接：首个元素前不加分隔符，其余逐个先补分隔符再追加；空数组得空串。
emitArrayJoin|func(out: ExprOut, module: IrModule, node: IrNode,) -> (ExprOut,):
    var done = out
    let array = emitExpr(ctx = done.ctx, module = module, nodeId = node.kids[0])
    done.ctx = array.ctx
    let separator = emitExpr(ctx = done.ctx, module = module, nodeId = node.kids[1])
    done.ctx = separator.ctx
    useExtern(use = done.ctx.externs, name = "bk_array_len")
    let countId = done.ctx.temp
    done.ctx.temp = countId + 1
    let count = tempName(index = countId)
    appendLine(sink = done.ctx.lines, text = "  " + count + " = call i32 @bk_array_len(ptr " + array.text + ")")
    let slot = allocSlot(ctx = done.ctx, typeName = "ptr")
    done.ctx = slot.ctx
    appendLine(sink = done.ctx.lines, text = "  store ptr null, ptr " + slot.text)
    let cursor = allocSlot(ctx = done.ctx, typeName = "i32")
    done.ctx = cursor.ctx
    appendLine(sink = done.ctx.lines, text = "  store i32 0, ptr " + cursor.text)
    let at = done.ctx.label
    done.ctx.label = at + 1
    let condLabel = labelName(prefix = "join.cond.", index = at)
    let bodyLabel = labelName(prefix = "join.body.", index = at)
    let sepLabel = labelName(prefix = "join.sep.", index = at)
    let elemLabel = labelName(prefix = "join.elem.", index = at)
    let incLabel = labelName(prefix = "join.inc.", index = at)
    let endLabel = labelName(prefix = "join.end.", index = at)
    appendLine(sink = done.ctx.lines, text = "  br label %" + condLabel)
    appendLine(sink = done.ctx.lines, text = condLabel + ":")
    let kId = done.ctx.temp
    done.ctx.temp = kId + 1
    let k = tempName(index = kId)
    appendLine(sink = done.ctx.lines, text = "  " + k + " = load i32, ptr " + cursor.text)
    let inId = done.ctx.temp
    done.ctx.temp = inId + 1
    let inside = tempName(index = inId)
    appendLine(sink = done.ctx.lines, text = "  " + inside + " = icmp slt i32 " + k + ", " + count)
    appendLine(sink = done.ctx.lines, text = "  br i1 " + inside + ", label %" + bodyLabel + ", label %" + endLabel)
    appendLine(sink = done.ctx.lines, text = bodyLabel + ":")
    let firstId = done.ctx.temp
    done.ctx.temp = firstId + 1
    let first = tempName(index = firstId)
    appendLine(sink = done.ctx.lines, text = "  " + first + " = icmp eq i32 " + k + ", 0")
    appendLine(sink = done.ctx.lines, text = "  br i1 " + first + ", label %" + elemLabel + ", label %" + sepLabel)
    appendLine(sink = done.ctx.lines, text = sepLabel + ":")
    done.ctx = appendToBuffer(ctx = done.ctx, slot = slot.text, piece = separator.text)
    appendLine(sink = done.ctx.lines, text = "  br label %" + elemLabel)
    appendLine(sink = done.ctx.lines, text = elemLabel + ":")
    useExtern(use = done.ctx.externs, name = "bk_array_get")
    let boxId = done.ctx.temp
    done.ctx.temp = boxId + 1
    let box = tempName(index = boxId)
    appendLine(sink = done.ctx.lines, text = "  " + box + " = call ptr @bk_array_get(ptr " + array.text + ", i32 " + k + ")")
    let elemId = done.ctx.temp
    done.ctx.temp = elemId + 1
    let elem = tempName(index = elemId)
    appendLine(sink = done.ctx.lines, text = "  " + elem + " = load ptr, ptr " + box)
    done.ctx = appendToBuffer(ctx = done.ctx, slot = slot.text, piece = elem)
    appendLine(sink = done.ctx.lines, text = "  br label %" + incLabel)
    appendLine(sink = done.ctx.lines, text = incLabel + ":")
    let stepId = done.ctx.temp
    done.ctx.temp = stepId + 1
    let moved = tempName(index = stepId)
    appendLine(sink = done.ctx.lines, text = "  " + moved + " = load i32, ptr " + cursor.text)
    let bumpedId = done.ctx.temp
    done.ctx.temp = bumpedId + 1
    let bumped = tempName(index = bumpedId)
    appendLine(sink = done.ctx.lines, text = "  " + bumped + " = add i32 " + moved + ", 1")
    appendLine(sink = done.ctx.lines, text = "  store i32 " + bumped + ", ptr " + cursor.text)
    appendLine(sink = done.ctx.lines, text = "  br label %" + condLabel)
    appendLine(sink = done.ctx.lines, text = endLabel + ":")
    let id = done.ctx.temp
    done.ctx.temp = id + 1
    let name = tempName(index = id)
    appendLine(sink = done.ctx.lines, text = "  " + name + " = load ptr, ptr " + slot.text)
    done.text = name
    return done

; 语句序列：逐条发射；块已由返回收口时，后续语句不再发，免出不可达指令。
; 登记延迟体：只记节点与当前循环层数，不发射。
addDefer|func(ctx: BodyCtx, nodeId: I32,) -> (BodyCtx,):
    var out = ctx
    out.deferIds = out.deferIds.append(nodeId)
    out.deferOwners = out.deferOwners.append(len(out.loopEnds))
    return out

; 摘除一条：体发射前先摘，体里的 return 才不会把同一条再跑一遍。
removeDefer|func(ctx: BodyCtx, index: I32,) -> (BodyCtx,):
    var out = ctx
    var ids: Array<I32> = []
    var owners: Array<I32> = []
    var i = 0
    while i < len(out.deferIds):
        if i != index:
            ids = ids.append(out.deferIds[i])
            owners = owners.append(out.deferOwners[i])
        i = i + 1
    out.deferIds = ids
    out.deferOwners = owners
    return out

; 跑延迟体：倒序发射下标不小于 mark、且所属循环深于 floor 的条目。
; 块尾用 floor = -1 收本层全部；break / continue 用目标循环下标收内层。
runDefers|func(ctx: BodyCtx, module: IrModule, floor: I32, mark: I32,) -> (BodyCtx,):
    var out = ctx
    var k = len(out.deferIds) - 1
    while k >= 0:
        if k >= mark && out.deferOwners[k] > floor:
            let node = irNodeAt(pool = module.nodes, id = out.deferIds[k])
            out = removeDefer(ctx = out, index = k)
            out = emitStmts(ctx = out, module = module, ids = node.kids)
        k = k - 1
    return out

emitStmts|func(ctx: BodyCtx, module: IrModule, ids: Array<I32>,) -> (BodyCtx,):
    var out = ctx
    let mark = len(out.deferIds)
    var i = 0
    while i < len(ids) && !out.closed:
        out = emitStmt(ctx = out, module = module, nodeId = ids[i])
        i = i + 1
    if out.closed:
        ; 出口已由 return / break / continue 收过延迟体，这里只截断本层登记。
        while len(out.deferIds) > mark:
            out = removeDefer(ctx = out, index = len(out.deferIds) - 1)
        return out
    return runDefers(ctx = out, module = module, floor = -1, mark = mark)

; 单条语句：发完本句后清账，没被接收点取走的份额在这里归还。
; 账按句清算，是因为临时值的寿命止于本句：跨句只经槽与字段，那两处已经留了一份。
emitStmt|func(ctx: BodyCtx, module: IrModule, nodeId: I32,) -> (BodyCtx,):
    return flushHeld(ctx = emitStmtCore(ctx = ctx, module = module, nodeId = nodeId), module = module)

; 语句内核：按类别码分派；未接的类别记缺口，不产占位指令。
emitStmtCore|func(ctx: BodyCtx, module: IrModule, nodeId: I32,) -> (BodyCtx,):
    var out = ctx
    if nodeId < 0 || nodeId >= irNodeCount(module.nodes):
        return addGap(ctx = out, gap = "悬空语句")
    let node = irNodeAt(pool = module.nodes, id = nodeId)
    if node.kind == 101:
        let slot = node.intValue as I32
        let typeName = llvmTypeName(pool = module.types, typeId = node.typeId)
        let defined = defineSlot(ctx = out, slot = slot)
        out = defined.ctx
        out.head = out.head.append("  " + defined.text + " = alloca " + typeName)
        if irHoldsShare(pool = module.types, typeId = node.typeId):
            ; 握份额的格子先在首块清零：提前返回时它可能还没赋值，归还空值才是安全的。
            out.head = out.head.append("  store " + typeName + " " + zeroTextOf(typeName = typeName) + ", ptr " + defined.text)
            out.ownedSlots = out.ownedSlots.append(defined.text)
            out.ownedTypes = out.ownedTypes.append(node.typeId)
        if len(node.kids) > 0:
            let one = emitExpr(ctx = out, module = module, nodeId = node.kids[0])
            out = one.ctx
            let shaped = storeValue(ctx = out, module = module, text = one.text, fromType = irNodeAt(pool = module.nodes, id = node.kids[0]).typeId, toType = node.typeId)
            out = shaped.ctx
            let adopted = adoptAtStore(ctx = out, module = module, name = shaped.text, typeId = node.typeId, adopt = node.adopt)
            out = adopted.ctx
            ; 同一条声明可能被循环再执行：槽里上一轮的值要先还，否则只留最后一轮、其余全泄。
            ; 首轮槽在入口已清零，还空值是空操作。
            if irHoldsShare(pool = module.types, typeId = node.typeId):
                out = releaseOldValue(ctx = out, module = module, at = defined.text, typeId = node.typeId)
            appendLine(sink = out.lines, text = "  store " + typeName + " " + adopted.text + ", ptr " + defined.text)
        return out
    if node.kind == 118:
        let slot = node.intValue as I32
        let at = slotNameOf(ctx = out, slot = slot)
        out = releaseOldValue(ctx = out, module = module, at = at, typeId = node.typeId)
        let typeName = llvmTypeName(pool = module.types, typeId = node.typeId)
        appendLine(sink = out.lines, text = "  store " + typeName + " " + zeroTextOf(typeName = typeName) + ", ptr " + at)
        return out
    if node.kind == 102:
        let slot = node.intValue as I32
        let typeName = llvmTypeName(pool = module.types, typeId = node.typeId)
        let at = slotNameOf(ctx = out, slot = slot)
        ; 自赋值：右侧最左叶子就是本槽。串的旧份已随拼接交出去，不能再还；
        ; 容器追加恒出新箱，旧箱必须还 —— 不还则存储 refs 只增不减，此后每次追加都深拷整段。
        let selfAppend = leftLeafSlot(module = module, nodeId = node.kids[0], depth = 0) == slot
        if selfAppend:
            out.pendingSlot = slot
        let one = emitExpr(ctx = out, module = module, nodeId = node.kids[0])
        out = one.ctx
        out.pendingSlot = -1
        let shaped = storeValue(ctx = out, module = module, text = one.text, fromType = irNodeAt(pool = module.nodes, id = node.kids[0]).typeId, toType = node.typeId)
        out = shaped.ctx
        let adopted = adoptAtStore(ctx = out, module = module, name = shaped.text, typeId = node.typeId, adopt = node.adopt)
        out = adopted.ctx
        if node.releaseOld && (!selfAppend || !isStringShare(module = module, typeId = node.typeId)):
            out = releaseOldValue(ctx = out, module = module, at = at, typeId = node.typeId)
        appendLine(sink = out.lines, text = "  store " + typeName + " " + adopted.text + ", ptr " + at)
        return out
    if node.kind == 103:
        return emitIf(ctx = out, module = module, node = node)
    if node.kind == 104:
        return emitWhile(ctx = out, module = module, node = node)
    if node.kind == 106:
        return emitReturn(ctx = out, module = module, node = node)
    if node.kind == 107:
        if len(node.kids) == 0:
            return out
        let one = emitExpr(ctx = out, module = module, nodeId = node.kids[0])
        return one.ctx
    if node.kind == 110:
        return emitSubscriptStore(ctx = out, module = module, node = node)
    if node.kind == 111:
        return emitJump(ctx = out, module = module, depth = node.op, isBreak = true)
    if node.kind == 112:
        return emitJump(ctx = out, module = module, depth = node.op, isBreak = false)
    if node.kind == 108:
        return addDefer(ctx = out, nodeId = nodeId)
    if node.kind == 105:
        return emitForIn(ctx = out, module = module, node = node)
    if node.kind == 109:
        return emitTry(ctx = out, module = module, node = node)
    if node.kind == 113:
        return emitPanic(ctx = out, module = module, node = node)
    if node.kind == 115:
        return emitFieldStore(ctx = out, module = module, node = node)
    if node.kind == 117:
        var boxed = ExprOut()
        boxed.ctx = out
        let detached = emitTaskDetach(out = boxed, module = module, node = node)
        return detached.ctx
    return addGap(ctx = out, gap = nodeGap(ctx = out, kind = node.kind))

; 跳出：帧深从一数，一即最内层循环；没有可跳的帧时报缺口，不产裸跳转。
emitJump|func(ctx: BodyCtx, module: IrModule, depth: I32, isBreak: Bool,) -> (BodyCtx,):
    var out = ctx
    if depth < 1 || depth > len(out.loopEnds):
        return addGap(ctx = out, gap = "跳出深度 " + countText(depth))
    let at = len(out.loopEnds) - depth
    out = runDefers(ctx = out, module = module, floor = at, mark = 0)
    var target = out.loopEnds[at]
    if !isBreak:
        target = out.loopHeads[at]
    appendLine(sink = out.lines, text = "  br label %" + target)
    out.closed = true
    return out

; 无条件陷阱：消息先入常量池，再交给运行时段；陷阱不返回，块以 unreachable 收口。
emitPanic|func(ctx: BodyCtx, module: IrModule, node: IrNode,) -> (BodyCtx,):
    var out = ctx
    var message = "Pini runtime error: panic"
    if node.text >= 0:
        message = textAt(module = module, id = node.text)
    let at = internString(pool = out.strings, value = message)
    let id = out.temp
    out.temp = id + 1
    let pointer = stringValue(lines = out.lines, pool = out.strings, index = at, temp = id)
    useExtern(use = out.externs, name = "bk_panic")
    appendLine(sink = out.lines, text = "  call void @bk_panic(ptr " + pointer + ")")
    appendLine(sink = out.lines, text = "  unreachable")
    out.closed = true
    return out

; 条件分支：条件求值后跳两段，未收口的段补跳转；两段都已返回时整条分支收口。
; 收口状态按段各记一份：一段返回一段落空是常态，不能拿一段的状态替另一段判。
emitIf|func(ctx: BodyCtx, module: IrModule, node: IrNode,) -> (BodyCtx,):
    var out = ctx
    let cond = emitExpr(ctx = out, module = module, nodeId = node.kids[0])
    out = cond.ctx
    var thenIds: Array<I32> = []
    var elseIds: Array<I32> = []
    var i = 1
    while i < len(node.kids):
        if i < node.tail:
            thenIds = thenIds.append(node.kids[i])
        else:
            elseIds = elseIds.append(node.kids[i])
        i = i + 1
    let at = out.label
    out.label = at + 1
    let thenLabel = labelName(prefix = "if.then.", index = at)
    let elseLabel = labelName(prefix = "if.else.", index = at)
    let endLabel = labelName(prefix = "if.end.", index = at)
    appendLine(sink = out.lines, text = "  br i1 " + cond.text + ", label %" + thenLabel + ", label %" + elseLabel)
    appendLine(sink = out.lines, text = thenLabel + ":")
    var thenCtx = emitStmts(ctx = out, module = module, ids = thenIds)
    let thenClosed = thenCtx.closed
    if !thenClosed:
        appendLine(sink = thenCtx.lines, text = "  br label %" + endLabel)
    var elseCtx = thenCtx
    elseCtx.closed = false
    appendLine(sink = elseCtx.lines, text = elseLabel + ":")
    elseCtx = emitStmts(ctx = elseCtx, module = module, ids = elseIds)
    let elseClosed = elseCtx.closed
    if !elseClosed:
        appendLine(sink = elseCtx.lines, text = "  br label %" + endLabel)
    var done = elseCtx
    if thenClosed && elseClosed:
        done.closed = true
    else:
        appendLine(sink = done.lines, text = endLabel + ":")
        done.closed = false
    return done

; 循环：头块判条件，体块回跳；体内已返回时省掉回跳，跳出边仍落在尾块。
; 循环帧只给体内语句用，出循环即还原，嵌套时各层各记自己的一对标签。
; `step` 块在体正常结束与无标签 continue 后各执行一次，break 直接跳尾块、跳过它。
emitWhile|func(ctx: BodyCtx, module: IrModule, node: IrNode,) -> (BodyCtx,):
    var out = ctx
    var bodyIds: Array<I32> = []
    var stepIds: Array<I32> = []
    var i = 1
    while i < len(node.kids):
        if i < node.tail:
            bodyIds = bodyIds.append(node.kids[i])
        else:
            stepIds = stepIds.append(node.kids[i])
        i = i + 1
    let at = out.label
    out.label = at + 1
    let condLabel = labelName(prefix = "while.cond.", index = at)
    let bodyLabel = labelName(prefix = "while.body.", index = at)
    let stepLabel = labelName(prefix = "while.step.", index = at)
    let endLabel = labelName(prefix = "while.end.", index = at)
    var headLabel = condLabel
    if len(stepIds) > 0:
        headLabel = stepLabel
    appendLine(sink = out.lines, text = "  br label %" + condLabel)
    appendLine(sink = out.lines, text = condLabel + ":")
    let cond = emitExpr(ctx = out, module = module, nodeId = node.kids[0])
    out = cond.ctx
    appendLine(sink = out.lines, text = "  br i1 " + cond.text + ", label %" + bodyLabel + ", label %" + endLabel)
    appendLine(sink = out.lines, text = bodyLabel + ":")
    let savedEnds = out.loopEnds
    let savedHeads = out.loopHeads
    out.loopEnds = out.loopEnds.append(endLabel)
    out.loopHeads = out.loopHeads.append(headLabel)
    var bodyCtx = emitStmts(ctx = out, module = module, ids = bodyIds)
    bodyCtx.loopEnds = savedEnds
    bodyCtx.loopHeads = savedHeads
    if !bodyCtx.closed:
        if len(stepIds) > 0:
            appendLine(sink = bodyCtx.lines, text = "  br label %" + stepLabel)
            appendLine(sink = bodyCtx.lines, text = stepLabel + ":")
            bodyCtx = emitStmts(ctx = bodyCtx, module = module, ids = stepIds)
        if !bodyCtx.closed:
            appendLine(sink = bodyCtx.lines, text = "  br label %" + condLabel)
    bodyCtx.closed = false
    appendLine(sink = bodyCtx.lines, text = endLabel + ":")
    return bodyCtx

; 遍历：模式槽在轮首写入；体尾走 step，continue 也落到 step；break 跳过 step。
; 种类码：一数组、二字典、三集合；字典写键与值两槽，槽号由降载按声明序给。
emitForIn|func(ctx: BodyCtx, module: IrModule, node: IrNode,) -> (BodyCtx,):
    var out = ctx
    if len(node.kids) < 2:
        return addGap(ctx = out, gap = "遍历缺目标或体")
    let iterable = emitExpr(ctx = out, module = module, nodeId = node.kids[0])
    out = iterable.ctx
    let iterText = iterable.text
    ; 迭代目标要活过整段循环：先从逐句账上摘下，循环出口再显式归还。
    out = forgetShare(ctx = out, name = iterText)
    let iterType = irNodeAt(pool = module.nodes, id = node.kids[0]).typeId
    if iterType < 0 || iterType >= irTypeCount(module.types):
        return addGap(ctx = out, gap = "遍历目标类型未定")
    let entry = irTypeAt(pool = module.types, id = iterType)
    let kind = node.op
    var lenSymbol = "bk_array_len"
    var elemType = -1
    var keyType = -1
    if kind == 2:
        lenSymbol = "bk_dict_len"
        if len(entry.kids) > 1:
            keyType = entry.kids[0]
            elemType = entry.kids[1]
    else:
        if kind == 3:
            lenSymbol = "bk_set_len"
        if len(entry.kids) > 0:
            elemType = entry.kids[0]
    if elemType < 0 || kind == 2 && keyType < 0:
        return addGap(ctx = out, gap = "遍历元素类型缺")
    let elemName = llvmTypeName(pool = module.types, typeId = elemType)
    var firstType = elemType
    if kind == 2:
        firstType = keyType
    let firstSpelling = llvmTypeName(pool = module.types, typeId = firstType)
    let firstSlot = defineSlot(ctx = out, slot = node.intValue as I32)
    out = firstSlot.ctx
    out.head = out.head.append("  " + firstSlot.text + " = alloca " + firstSpelling)
    out.head = out.head.append("  store " + firstSpelling + " " + zeroTextOf(typeName = firstSpelling) + ", ptr " + firstSlot.text)
    if irHoldsShare(pool = module.types, typeId = firstType):
        out.ownedSlots = out.ownedSlots.append(firstSlot.text)
        out.ownedTypes = out.ownedTypes.append(firstType)
    var secondSlot = ExprOut()
    secondSlot.ctx = out
    if kind == 2:
        let second = defineSlot(ctx = out, slot = node.adopt)
        out = second.ctx
        out.head = out.head.append("  " + second.text + " = alloca " + elemName)
        out.head = out.head.append("  store " + elemName + " " + zeroTextOf(typeName = elemName) + ", ptr " + second.text)
        if irHoldsShare(pool = module.types, typeId = elemType):
            out.ownedSlots = out.ownedSlots.append(second.text)
            out.ownedTypes = out.ownedTypes.append(elemType)
        secondSlot.ctx = out
        secondSlot.text = second.text
    let cursor = allocSlot(ctx = out, typeName = "i32")
    out = cursor.ctx
    appendLine(sink = out.lines, text = "  store i32 0, ptr " + cursor.text)
    useExtern(use = out.externs, name = lenSymbol)
    let at = out.label
    out.label = at + 1
    let condLabel = labelName(prefix = "for.cond.", index = at)
    let bodyLabel = labelName(prefix = "for.body.", index = at)
    let stepLabel = labelName(prefix = "for.step.", index = at)
    let incLabel = labelName(prefix = "for.inc.", index = at)
    let endLabel = labelName(prefix = "for.end.", index = at)
    var bodyIds: Array<I32> = []
    var stepIds: Array<I32> = []
    var i = 1
    while i < len(node.kids):
        if i < node.tail:
            bodyIds = bodyIds.append(node.kids[i])
        else:
            stepIds = stepIds.append(node.kids[i])
        i = i + 1
    var headLabel = incLabel
    if len(stepIds) > 0:
        headLabel = stepLabel
    appendLine(sink = out.lines, text = "  br label %" + condLabel)
    appendLine(sink = out.lines, text = condLabel + ":")
    let indexId = out.temp
    out.temp = indexId + 1
    let index = tempName(index = indexId)
    appendLine(sink = out.lines, text = "  " + index + " = load i32, ptr " + cursor.text)
    let lenId = out.temp
    out.temp = lenId + 1
    let lenName = tempName(index = lenId)
    appendLine(sink = out.lines, text = "  " + lenName + " = call i32 @" + lenSymbol + "(ptr " + iterText + ")")
    let moreId = out.temp
    out.temp = moreId + 1
    let more = tempName(index = moreId)
    appendLine(sink = out.lines, text = "  " + more + " = icmp slt i32 " + index + ", " + lenName)
    appendLine(sink = out.lines, text = "  br i1 " + more + ", label %" + bodyLabel + ", label %" + endLabel)
    appendLine(sink = out.lines, text = bodyLabel + ":")
    out = emitForBind(ctx = out, module = module, kind = kind, handle = iterText, firstSlot = firstSlot.text, firstSpelling = firstSpelling, firstType = firstType, secondSlot = secondSlot.text, secondSpelling = elemName, secondType = elemType, index = index)
    let savedEnds = out.loopEnds
    let savedHeads = out.loopHeads
    out.loopEnds = out.loopEnds.append(endLabel)
    out.loopHeads = out.loopHeads.append(headLabel)
    var bodyCtx = emitStmts(ctx = out, module = module, ids = bodyIds)
    bodyCtx.loopEnds = savedEnds
    bodyCtx.loopHeads = savedHeads
    if !bodyCtx.closed:
        if len(stepIds) > 0:
            appendLine(sink = bodyCtx.lines, text = "  br label %" + stepLabel)
            appendLine(sink = bodyCtx.lines, text = stepLabel + ":")
            bodyCtx = emitStmts(ctx = bodyCtx, module = module, ids = stepIds)
        if !bodyCtx.closed:
            appendLine(sink = bodyCtx.lines, text = "  br label %" + incLabel)
    bodyCtx.closed = false
    appendLine(sink = bodyCtx.lines, text = incLabel + ":")
    let nextId = bodyCtx.temp
    bodyCtx.temp = nextId + 1
    let next = tempName(index = nextId)
    appendLine(sink = bodyCtx.lines, text = "  " + next + " = add i32 " + index + ", 1")
    appendLine(sink = bodyCtx.lines, text = "  store i32 " + next + ", ptr " + cursor.text)
    appendLine(sink = bodyCtx.lines, text = "  br label %" + condLabel)
    appendLine(sink = bodyCtx.lines, text = endLabel + ":")
    bodyCtx = releaseValue(ctx = bodyCtx, module = module, name = iterText, typeId = iterType)
    return bodyCtx

; 轮首绑定：按种类取元素写入模式槽；取出的元素是借用，写槽前先留一份、再还旧值。
emitForBind|func(ctx: BodyCtx, module: IrModule, kind: I32, handle: String, firstSlot: String, firstSpelling: String, firstType: I32, secondSlot: String, secondSpelling: String, secondType: I32, index: String,) -> (BodyCtx,):
    var out = ctx
    var symbol = "bk_array_get"
    if kind == 2:
        symbol = "bk_dict_key_at"
    elif kind == 3:
        symbol = "bk_set_at"
    useExtern(use = out.externs, name = symbol)
    let boxId = out.temp
    out.temp = boxId + 1
    let box = tempName(index = boxId)
    appendLine(sink = out.lines, text = "  " + box + " = call ptr @" + symbol + "(ptr " + handle + ", i32 " + index + ")")
    let firstId = out.temp
    out.temp = firstId + 1
    let first = tempName(index = firstId)
    appendLine(sink = out.lines, text = "  " + first + " = load " + firstSpelling + ", ptr " + box)
    out = adoptValue(ctx = out, module = module, name = first, typeId = firstType, adopt = 3)
    out = releaseOldValue(ctx = out, module = module, at = firstSlot, typeId = firstType)
    appendLine(sink = out.lines, text = "  store " + firstSpelling + " " + first + ", ptr " + firstSlot)
    if kind == 2:
        useExtern(use = out.externs, name = "bk_dict_val_at")
        let valBoxId = out.temp
        out.temp = valBoxId + 1
        let valBox = tempName(index = valBoxId)
        appendLine(sink = out.lines, text = "  " + valBox + " = call ptr @bk_dict_val_at(ptr " + handle + ", i32 " + index + ")")
        let secondId = out.temp
        out.temp = secondId + 1
        let second = tempName(index = secondId)
        appendLine(sink = out.lines, text = "  " + second + " = load " + secondSpelling + ", ptr " + valBox)
        out = adoptValue(ctx = out, module = module, name = second, typeId = secondType, adopt = 3)
        out = releaseOldValue(ctx = out, module = module, at = secondSlot, typeId = secondType)
        appendLine(sink = out.lines, text = "  store " + secondSpelling + " " + second + ", ptr " + secondSlot)
    return out

; 错误处理：操作数按标签分两支；错误支把擦除后的错误字写槽再走处理器。
; 语句位（okTarget 为负）丢弃成功载荷，表达式位的载荷存进给定槽。
emitTry|func(ctx: BodyCtx, module: IrModule, node: IrNode,) -> (BodyCtx,):
    var out = ctx
    if len(node.kids) < 1:
        return addGap(ctx = out, gap = "错误处理缺操作数")
    let operand = emitExpr(ctx = out, module = module, nodeId = node.kids[0])
    out = operand.ctx
    let typeId = irNodeAt(pool = module.nodes, id = node.kids[0]).typeId
    if typeId < 0 || typeId >= irTypeCount(module.types):
        return addGap(ctx = out, gap = "错误处理操作数类型未定")
    let entry = irTypeAt(pool = module.types, id = typeId)
    let aggregate = llvmTypeName(pool = module.types, typeId = typeId)
    let errSlot = defineSlot(ctx = out, slot = node.adopt)
    out = errSlot.ctx
    out.head = out.head.append("  " + errSlot.text + " = alloca i64")
    out.head = out.head.append("  store i64 0, ptr " + errSlot.text)
    let tagId = out.temp
    out.temp = tagId + 1
    let tagName = tempName(index = tagId)
    appendLine(sink = out.lines, text = "  " + tagName + " = extractvalue " + aggregate + " " + operand.text + ", 0")
    let okId = out.temp
    out.temp = okId + 1
    let okName = tempName(index = okId)
    appendLine(sink = out.lines, text = "  " + okName + " = icmp eq i64 " + tagName + ", 0")
    let at = out.label
    out.label = at + 1
    let okLabel = labelName(prefix = "try.ok.", index = at)
    let errLabel = labelName(prefix = "try.err.", index = at)
    let endLabel = labelName(prefix = "try.end.", index = at)
    appendLine(sink = out.lines, text = "  br i1 " + okName + ", label %" + okLabel + ", label %" + errLabel)
    appendLine(sink = out.lines, text = okLabel + ":")
    if len(entry.kids) > 0:
        let payloadType = entry.kids[0]
        let valueId = out.temp
        out.temp = valueId + 1
        let valueName = tempName(index = valueId)
        appendLine(sink = out.lines, text = "  " + valueName + " = extractvalue " + aggregate + " " + operand.text + ", 1")
        if node.intValue as I32 >= 0:
            let payloadName = llvmTypeName(pool = module.types, typeId = payloadType)
            appendLine(sink = out.lines, text = "  store " + payloadName + " " + valueName + ", ptr " + slotNameOf(ctx = out, slot = node.intValue as I32))
        elif irHoldsShare(pool = module.types, typeId = payloadType):
            out = releaseValue(ctx = out, module = module, name = valueName, typeId = payloadType)
    appendLine(sink = out.lines, text = "  br label %" + endLabel)
    appendLine(sink = out.lines, text = errLabel + ":")
    let errId = out.temp
    out.temp = errId + 1
    let errName = tempName(index = errId)
    appendLine(sink = out.lines, text = "  " + errName + " = extractvalue " + aggregate + " " + operand.text + ", 2")
    appendLine(sink = out.lines, text = "  store i64 " + errName + ", ptr " + errSlot.text)
    var handlerIds: Array<I32> = []
    var i = 1
    while i < len(node.kids):
        handlerIds = handlerIds.append(node.kids[i])
        i = i + 1
    var handlerCtx = emitStmts(ctx = out, module = module, ids = handlerIds)
    if !handlerCtx.closed:
        appendLine(sink = handlerCtx.lines, text = "  br label %" + endLabel)
    handlerCtx.closed = false
    appendLine(sink = handlerCtx.lines, text = endLabel + ":")
    return handlerCtx

; 返回：有值按函数返回类型出，无值出 void；main 例外恒返回零。
emitReturn|func(ctx: BodyCtx, module: IrModule, node: IrNode,) -> (BodyCtx,):
    var out = ctx
    let fn = module.functions[out.fnIndex]
    if fn.name == "main" && fn.returnType < 0:
        out = runDefers(ctx = out, module = module, floor = -1, mark = 0)
        out = releaseOwned(ctx = out, module = module)
        appendLine(sink = out.lines, text = "  ret i32 0")
        out.closed = true
        return out
    if len(node.kids) == 0:
        out = runDefers(ctx = out, module = module, floor = -1, mark = 0)
        out = releaseOwned(ctx = out, module = module)
        let emptyType = llvmTypeName(pool = module.types, typeId = fn.returnType)
        if emptyType == "void":
            appendLine(sink = out.lines, text = "  ret void")
        else:
            ; 空载荷异步体结算成空元组：签名有宽度就得交一个零值，不能发 void。
            appendLine(sink = out.lines, text = "  ret " + emptyType + " zeroinitializer")
        out.closed = true
        return out
    let one = emitExpr(ctx = out, module = module, nodeId = node.kids[0])
    out = one.ctx
    let typeName = llvmTypeName(pool = module.types, typeId = fn.returnType)
    let shaped = storeValue(ctx = out, module = module, text = one.text, fromType = irNodeAt(pool = module.nodes, id = node.kids[0]).typeId, toType = fn.returnType)
    out = shaped.ctx
    ; 返回值交给调用方：值语义结构体拷出一份，其余账上有就交出、没有就另留一份。
    let adopted = adoptAtStore(ctx = out, module = module, name = shaped.text, typeId = fn.returnType, adopt = node.adopt)
    out = adopted.ctx
    ; 返回值已定，再跑延迟体：体里改变量不影响已算好的返回份。
    out = runDefers(ctx = out, module = module, floor = -1, mark = 0)
    out = releaseOwned(ctx = out, module = module)
    appendLine(sink = out.lines, text = "  ret " + typeName + " " + adopted.text)
    out.closed = true
    return out

; 胶水是否存在：与生成侧同一判据，缺一格的类型既不出定义也不出调用。
releaseGlueExists|func(module: IrModule, typeId: I32,) -> (Bool,):
    if len(llvmAggregateName(pool = module.types, typeId = typeId)) == 0:
        return false
    let tag = irTypeTag(irTypeAt(pool = module.types, id = typeId).kind)
    if tag != 14 && tag != 15:
        return false
    return len(declAt(table = module.decls, typeId = typeId).name) > 0

; 释放胶水名：按类型下标唯一；名义箱与枚举箱共用一套名字。
releaseGlueName|func(typeId: I32,) -> (String,):
    return "__release_box_" + countText(typeId)

; 字段归还：按字段类型选入口，名义与枚举字段递归走它自己的胶水。
appendReleaseCall|func(lines: Array<String>, module: IrModule, name: String, typeId: I32,) -> (Array<String>,):
    var out = lines
    let family = irRetainFamilyOf(pool = module.types, typeId = typeId) ; 族码已含值语义箱；细分码答 0 会漏还整族
    if family == 3:
        if releaseGlueExists(module = module, typeId = typeId):
            return out.append("  call void @" + releaseGlueName(typeId = typeId) + "(ptr " + name + ")")
        return out.append("  call i32 @bk_nominal_release(ptr " + name + ")")
    let symbol = releaseSymbolOf(family = family)
    if len(symbol) > 0:
        ; 容器字段与变量槽同一套账：进来时留了一份，箱归零时还掉；入参对空句柄是空操作。
        return out.append("  call void @" + symbol + "(ptr " + name + ")")
    return out

; 结构体胶水：空箱直接返回；计数归零才逐字段归还，再放开箱体。
;  不变量  函数出口统一归还全部槽，未赋值的格就是空指针；入口必须让空箱走旁路。
;  行不通  先还字段再减计数：箱还有别的持有者时，字段会被提前释放。
appendFieldGlue|func(lines: Array<String>, module: IrModule, typeId: I32,) -> (Array<String>,):
    var out = lines
    let decl = declAt(table = module.decls, typeId = typeId)
    let agg = llvmAggregateName(pool = module.types, typeId = typeId)
    if len(agg) == 0 || len(decl.name) == 0:
        return out
    out = out.append("define void @" + releaseGlueName(typeId = typeId) + "(ptr %box) {")
    out = out.append("entry:")
    out = out.append("  %isnull = icmp eq ptr %box, null")
    out = out.append("  br i1 %isnull, label %done, label %live")
    out = out.append("live:")
    out = out.append("  %rc = call i32 @bk_nominal_release(ptr %box)")
    out = out.append("  %dead = icmp ne i32 %rc, 0")
    out = out.append("  br i1 %dead, label %sweep, label %done")
    out = out.append("sweep:")
    var i = 0
    while i < len(decl.fields):
        let fieldType = decl.fields[i].typeId
        if fieldType >= 0 && irHoldsShare(pool = module.types, typeId = fieldType):
            let at = fieldSlotIndex(table = module.slots, fieldIndex = i)
            let typeName = llvmTypeName(pool = module.types, typeId = fieldType)
            out = out.append("  %f" + countText(i) + " = getelementptr " + agg + ", ptr %box, i32 0, i32 " + countText(at))
            out = out.append("  %v" + countText(i) + " = load " + typeName + ", ptr %f" + countText(i))
            out = appendReleaseCall(lines = out, module = module, name = "%v" + countText(i), typeId = fieldType)
        i = i + 1
    out = out.append("  call void @free(ptr %box)")
    out = out.append("  br label %done")
    out = out.append("done:")
    out = out.append("  ret void")
    out = out.append("}")
    return out

; 枚举胶水：空箱直接返回；计数归零才按标签分派，只还当前用例的载荷，再放开箱体。
; 载荷格按最宽用例定型，故只归还类型与之逐格相同的用例；类型不同的用例宁可不还，不按别的形状读同一格。
;  不变量  函数出口统一归还全部槽，未赋值的格就是空指针；标签读在解引用前必须让空箱走旁路。
appendEnumGlue|func(lines: Array<String>, module: IrModule, typeId: I32,) -> (Array<String>,):
    var out = lines
    let decl = declAt(table = module.decls, typeId = typeId)
    let agg = llvmAggregateName(pool = module.types, typeId = typeId)
    if len(agg) == 0 || len(decl.name) == 0:
        return out
    let widest = widestCaseIndex(cases = decl.cases)
    var 可还用例: Array<I32> = []
    if widest >= 0:
        let 最宽载荷 = decl.cases[widest].payload
        var c = 0
        while c < len(decl.cases):
            if 载荷同形(a = decl.cases[c].payload, b = 最宽载荷):
                可还用例 = 可还用例.append(c)
            c = c + 1
    out = out.append("define void @" + releaseGlueName(typeId = typeId) + "(ptr %box) {")
    out = out.append("entry:")
    out = out.append("  %isnull = icmp eq ptr %box, null")
    out = out.append("  br i1 %isnull, label %done, label %live")
    out = out.append("live:")
    out = out.append("  %rc = call i32 @bk_nominal_release(ptr %box)")
    out = out.append("  %dead = icmp ne i32 %rc, 0")
    out = out.append("  br i1 %dead, label %sweep, label %done")
    out = out.append("sweep:")
    if len(可还用例) > 0:
        out = out.append("  %tagp = getelementptr " + agg + ", ptr %box, i32 0, i32 " + countText(module.slots.headSlots))
        out = out.append("  %tag = load i32, ptr %tagp")
        out = out.append("  switch i32 %tag, label %after [")
        var s = 0
        while s < len(可还用例):
            out = out.append("    i32 " + countText(可还用例[s]) + ", label %case" + countText(可还用例[s]))
            s = s + 1
        out = out.append("  ]")
        s = 0
        while s < len(可还用例):
            let caseIndex = 可还用例[s]
            let payload = decl.cases[caseIndex].payload
            out = out.append("case" + countText(caseIndex) + ":")
            var j = 0
            while j < len(payload):
                let fieldType = payload[j]
                if fieldType >= 0 && irHoldsShare(pool = module.types, typeId = fieldType):
                    let slot = module.slots.payloadBase + j
                    let typeName = llvmTypeName(pool = module.types, typeId = fieldType)
                    out = out.append("  %c" + countText(caseIndex) + "v" + countText(j) + " = getelementptr " + agg + ", ptr %box, i32 0, i32 " + countText(slot))
                    out = out.append("  %c" + countText(caseIndex) + "l" + countText(j) + " = load " + typeName + ", ptr %c" + countText(caseIndex) + "v" + countText(j))
                    out = appendReleaseCall(lines = out, module = module, name = "%c" + countText(caseIndex) + "l" + countText(j), typeId = fieldType)
                j = j + 1
            out = out.append("  br label %after")
            s = s + 1
        out = out.append("after:")
    out = out.append("  call void @free(ptr %box)")
    out = out.append("  br label %done")
    out = out.append("done:")
    out = out.append("  ret void")
    out = out.append("}")
    return out

; 拷贝胶水名：按类型下标唯一；与释放胶水各占一套名字。
copyGlueName|func(typeId: I32,) -> (String,):
    return "__copy_box_" + countText(typeId)

; 拷贝胶水是否存在：对象按引用语义不拷；缺声明条目的类型既不出定义也不出调用。
copyGlueExists|func(module: IrModule, typeId: I32,) -> (Bool,):
    if len(llvmAggregateName(pool = module.types, typeId = typeId)) == 0:
        return false
    if irTypeTag(irTypeAt(pool = module.types, id = typeId).kind) != 14:
        return false
    if irIsObjectType(pool = module.types, id = typeId):
        return false
    return len(declAt(table = module.decls, typeId = typeId).name) > 0

; 拷贝胶水：空箱答空箱，其余分配同型新箱并逐字段搬值。
; 递归规则与宿主一致：结构体字段递归拷贝，对象、枚举、容器与串各留一份，标量直接搬。
;  行不通  浅拷整个箱：两个箱会指同一批子箱，改一处两处都变。
appendCopyGlue|func(lines: Array<String>, module: IrModule, typeId: I32,) -> (Array<String>,):
    var out = lines
    let decl = declAt(table = module.decls, typeId = typeId)
    let agg = llvmAggregateName(pool = module.types, typeId = typeId)
    if len(agg) == 0 || len(decl.name) == 0:
        return out
    out = out.append("define ptr @" + copyGlueName(typeId = typeId) + "(ptr %src) {")
    out = out.append("entry:")
    out = out.append("  %isnull = icmp eq ptr %src, null")
    out = out.append("  br i1 %isnull, label %nullsrc, label %copy")
    out = out.append("nullsrc:")
    out = out.append("  ret ptr null")
    out = out.append("copy:")
    out = out.append("  %end = getelementptr " + agg + ", ptr null, i32 1")
    out = out.append("  %size = ptrtoint ptr %end to i64")
    out = out.append("  %dst = call ptr @bk_nominal_alloc(i64 %size, i32 " + countText(typeId) + ")")
    var i = 0
    while i < len(decl.fields):
        let fieldType = decl.fields[i].typeId
        if fieldType >= 0:
            out = appendCopyField(lines = out, module = module, agg = agg, fieldType = fieldType, index = i)
        i = i + 1
    out = out.append("  ret ptr %dst")
    out = out.append("}")
    return out

; 拷贝一个字段：读源格，按字段类别定动作，再写进新箱的同号槽。
; 动作只有三种：递归拷贝（结构体）、留一份（对象·枚举·容器·串）、直接搬（标量）。
appendCopyField|func(lines: Array<String>, module: IrModule, agg: String, fieldType: I32, index: I32,) -> (Array<String>,):
    var out = lines
    let typeName = llvmTypeName(pool = module.types, typeId = fieldType)
    let at = fieldSlotIndex(table = module.slots, fieldIndex = index)
    out = out.append("  %sf" + countText(index) + " = getelementptr " + agg + ", ptr %src, i32 0, i32 " + countText(at))
    out = out.append("  %sv" + countText(index) + " = load " + typeName + ", ptr %sf" + countText(index))
    var kept = "%sv" + countText(index)
    ;  注意  值语义箱按类别认，按细分码认会把它当成不需要动。
    let classTag = irShareClassOf(pool = module.types, typeId = fieldType)
    if classTag == 3 && copyGlueExists(module = module, typeId = fieldType):
        out = out.append("  %sc" + countText(index) + " = call ptr @" + copyGlueName(typeId = fieldType) + "(ptr %sv" + countText(index) + ")")
        kept = "%sc" + countText(index)
    let family = irRetainFamilyOf(pool = module.types, typeId = fieldType) ; 族码含值语义箱；细分码答 0 会漏留份
    if family == 3:
        if kept == "%sv" + countText(index):
            out = out.append("  call void @bk_nominal_retain(ptr %sv" + countText(index) + ")")
    if family != 3:
        let symbol = retainSymbolOf(family = family)
        if len(symbol) > 0:
            out = out.append("  call void @" + symbol + "(ptr %sv" + countText(index) + ")")
    out = out.append("  %df" + countText(index) + " = getelementptr " + agg + ", ptr %dst, i32 0, i32 " + countText(at))
    out = out.append("  store " + typeName + " " + kept + ", ptr %df" + countText(index))
    return out

; 载荷同形：逐格类型相同；长度不同即不同形。
载荷同形|func(a: Array<I32>, b: Array<I32>,) -> (Bool,):
    if len(a) != len(b):
        return false
    var i = 0
    while i < len(a):
        if a[i] != b[i]:
            return false
        i = i + 1
    return true

; 胶水总表：结构体与枚举各出一份，类型下标即胶水名的编号。
llvmReleaseGlues|func(module: IrModule,) -> (Array<String>,):
    var lines: Array<String> = []
    var i = 0
    while i < irTypeCount(module.types):
        let tag = irTypeTag(irTypeAt(pool = module.types, id = i).kind)
        if tag == 14:
            lines = appendFieldGlue(lines = lines, module = module, typeId = i)
        if tag == 15:
            lines = appendEnumGlue(lines = lines, module = module, typeId = i)
        i = i + 1
    return lines

; 拷贝胶水总表：只给值语义结构体出，按类型下标序。
llvmCopyGlues|func(module: IrModule,) -> (Array<String>,):
    var lines: Array<String> = []
    var i = 0
    while i < irTypeCount(module.types):
        if copyGlueExists(module = module, typeId = i):
            lines = appendCopyGlue(lines = lines, module = module, typeId = i)
        i = i + 1
    return lines

; 元素是否按聚合记账：名义箱与枚举箱在数组元素格里存的都是箱指针。
aggElement|func(module: IrModule, typeId: I32,) -> (Bool,):
    if typeId < 0 || typeId >= irTypeCount(module.types):
        return false
    let tag = irTypeTag(irTypeAt(pool = module.types, id = typeId).kind)
    return tag == 14 || tag == 15

; 钩子名：按元素类型下标唯一；留份与归还各一个。
aggRetainName|func(typeId: I32,) -> (String,):
    return "__bk_agg_" + countText(typeId) + "_retain"

aggReleaseName|func(typeId: I32,) -> (String,):
    return "__bk_agg_" + countText(typeId) + "_release"

; 聚合元素钩子：数组销毁与分裂时按元素箱里的箱指针留份或归还。
;  注意  归还走逐类型胶水，箱的字段才跟着走；直接调 bk_nominal_release 只减计数。
appendAggHook|func(lines: Array<String>, module: IrModule, elementType: I32,) -> (Array<String>,):
    var out = lines
    out = out.append("define void @" + aggRetainName(typeId = elementType) + "(ptr %slot) {")
    out = out.append("entry:")
    out = out.append("  %v = load ptr, ptr %slot")
    out = out.append("  call void @bk_nominal_retain(ptr %v)")
    out = out.append("  ret void")
    out = out.append("}")
    out = out.append("define void @" + aggReleaseName(typeId = elementType) + "(ptr %slot) {")
    out = out.append("entry:")
    out = out.append("  %w = load ptr, ptr %slot")
    if releaseGlueExists(module = module, typeId = elementType):
        out = out.append("  call void @" + releaseGlueName(typeId = elementType) + "(ptr %w)")
    else:
        out = out.append("  call i32 @bk_nominal_release(ptr %w)")
    out = out.append("  ret void")
    out = out.append("}")
    return out

; 钩子总表：数组元素里出现的名义类型各一对，按类型下标序；同类型只出一份。
llvmAggHooks|func(module: IrModule,) -> (Array<String>,):
    var lines: Array<String> = []
    var seen: Array<I32> = []
    var i = 0
    while i < irTypeCount(module.types):
        let entry = irTypeAt(pool = module.types, id = i)
        if irTypeTag(entry.kind) == 12 && len(entry.kids) > 0:
            let elem = entry.kids[0]
            if aggElement(module = module, typeId = elem) && !seenType(seen = seen, typeId = elem):
                seen = seen.append(elem)
                lines = appendAggHook(lines = lines, module = module, elementType = elem)
        i = i + 1
    return lines

; 已出过钩子：表很短，线性比较即可。
seenType|func(seen: Array<I32>, typeId: I32,) -> (Bool,):
    var i = 0
    while i < len(seen):
        if seen[i] == typeId:
            return true
        i = i + 1
    return false
