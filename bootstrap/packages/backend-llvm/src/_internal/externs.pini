; 外部符号面：首版接的 C 库与运行时段符号，签名照 `runtime-api` 与 C 标准库抄，不猜。
; 只声明被调用到的符号：没人调用的声明只拖长文本，也不证明任何能力。
; 调用点与声明共用这一张表：表里没有的名字按「外部调用未登记」报缺口。

; 使用集合：按首次调用序记录，发射时逐条出 declare。
{ExternUse}
names: Array<String> = []

; 登记：同名字只留一次，顺序即首次调用序。
useExtern|func(use: ExternUse, name: String,) -> ():
    var i = 0
    while i < len(use.names):
        if use.names[i] == name:
            return
        i = i + 1
    use.names = use.names.append(name)

; 已登记数：下标合法区间是 0 到 count - 1。
externUseCount|func(use: ExternUse,) -> (I32,):
    return len(use.names)

; 签名：返回完整 declare 行，未登记答空串；变参符号在固定参数后留省略号。
externSignature|func(name: String,) -> (String,):
    if name == "printf":
        return "declare i32 @printf(ptr, ...)"
    if name == "bk_print_lock":
        return "declare void @bk_print_lock()"
    if name == "bk_print_unlock":
        return "declare void @bk_print_unlock()"
    if name == "bk_panic":
        return "declare void @bk_panic(ptr) noreturn"
    if name == "bk_double_to_string":
        return "declare ptr @bk_double_to_string(double)"
    if name == "bk_str_release":
        return "declare void @bk_str_release(ptr)"
    ; 计数族：接收点留一份、语句收尾还一份；名义箱的归还答计数，调用点不回读。
    if name == "bk_str_retain":
        return "declare void @bk_str_retain(ptr)"
    if name == "bk_handle_retain":
        return "declare void @bk_handle_retain(ptr)"
    if name == "bk_handle_release":
        return "declare void @bk_handle_release(ptr)"
    if name == "bk_nominal_retain":
        return "declare void @bk_nominal_retain(ptr)"
    if name == "bk_nominal_release":
        return "declare i32 @bk_nominal_release(ptr)"
    ; 数组元素钩子：聚合元素的留份与归还由发射层合成，运行时段在分裂与销毁时回调。
    if name == "bk_array_set_element_hooks":
        return "declare void @bk_array_set_element_hooks(ptr, ptr, ptr)"
    if name == "free":
        return "declare void @free(ptr)"
    if name == "bk_array_create":
        return "declare ptr @bk_array_create(i32)"
    if name == "bk_array_len":
        return "declare i32 @bk_array_len(ptr)"
    if name == "bk_array_append":
        return "declare ptr @bk_array_append(ptr, ptr, i32, i32)"
    if name == "bk_dict_len":
        return "declare i32 @bk_dict_len(ptr)"
    if name == "bk_set_len":
        return "declare i32 @bk_set_len(ptr)"
    if name == "bk_string_count":
        return "declare i32 @bk_string_count(ptr)"
    ; 字符族：字符值以 i64 装箱，串入参按借出。
    if name == "bk_chr":
        return "declare i64 @bk_chr(i32)"
    if name == "bk_ord":
        return "declare i32 @bk_ord(i64)"
    if name == "bk_chars":
        return "declare ptr @bk_chars(ptr)"
    if name == "bk_temp_utf8_bytes":
        return "declare ptr @bk_temp_utf8_bytes(ptr)"
    if name == "bk_temp_byte_to_int":
        return "declare i32 @bk_temp_byte_to_int(i8)"
    if name == "bk_temp_int_to_byte":
        return "declare i8 @bk_temp_int_to_byte(i32)"
    if name == "bk_char_to_heap_string":
        return "declare ptr @bk_char_to_heap_string(i64)"
    ; 字符串族：入参按 C 串借出，结果按带头串交回。
    if name == "bk_str_concat":
        return "declare ptr @bk_str_concat(ptr, ptr, i32)"
    if name == "bk_char_equal_string":
        return "declare i32 @bk_char_equal_string(i64, ptr)"
    if name == "strcmp":
        return "declare i32 @strcmp(ptr, ptr)"
    ; 惰性引用族：创建收 wrapper / code / env 与元素 ABI，取值回元素盒。
    if name == "bk_lazyref_create":
        return "declare ptr @bk_lazyref_create(ptr, ptr, ptr, i32, i32)"
    if name == "bk_lazyref_value":
        return "declare ptr @bk_lazyref_value(ptr)"
    if name == "malloc":
        return "declare ptr @malloc(i64)"
    if name == "bk_string_contains":
        return "declare i32 @bk_string_contains(ptr, ptr)"
    if name == "bk_string_index_of":
        return "declare i32 @bk_string_index_of(ptr, ptr)"
    if name == "bk_substring":
        return "declare ptr @bk_substring(ptr, i32, i32)"
    if name == "bk_string_slice":
        return "declare ptr @bk_string_slice(ptr, i32, i32, i32, i32)"
    if name == "bk_string_split":
        return "declare ptr @bk_string_split(ptr, ptr)"
    if name == "bk_string_char_at":
        return "declare i64 @bk_string_char_at(ptr, i32)"
    if name == "bk_string_upper":
        return "declare ptr @bk_string_upper(ptr)"
    if name == "bk_string_lower":
        return "declare ptr @bk_string_lower(ptr)"
    if name == "bk_string_trim_left":
        return "declare ptr @bk_string_trim_left(ptr)"
    if name == "bk_string_trim_right":
        return "declare ptr @bk_string_trim_right(ptr)"
    if name == "bk_str_append_cstr":
        return "declare ptr @bk_str_append_cstr(ptr, ptr, i32)"
    ; 容器族：元素按地址搬运，宽度与标签由发射层给。
    if name == "bk_array_get":
        return "declare ptr @bk_array_get(ptr, i32)"
    if name == "bk_array_set":
        return "declare ptr @bk_array_set(ptr, i32, ptr, i32, i32)"
    if name == "bk_dict_get":
        return "declare ptr @bk_dict_get(ptr, ptr, i32, i32)"
    if name == "bk_dict_set":
        return "declare ptr @bk_dict_set(ptr, ptr, i32, i32, ptr, i32, i32)"
    ; 任务族：帧按字节数分配，句柄由运行时段持有；等待的三槽由调用方给。
    if name == "bk_task_frame":
        return "declare ptr @bk_task_frame(i64)"
    if name == "bk_task_spawn":
        return "declare ptr @bk_task_spawn(ptr, ptr, ptr, i32, i32)"
    if name == "bk_task_join":
        return "declare i32 @bk_task_join(ptr, ptr)"
    if name == "bk_task_detach":
        return "declare i32 @bk_task_detach(ptr)"
    ; 默认实例族：槽、初始化函数与字节数三件交给运行时段，返回程序级那一个盒。
    if name == "bk_given_get":
        return "declare ptr @bk_given_get(ptr, ptr, i64)"
    if name == "memcpy":
        return "declare void @memcpy(ptr, ptr, i64)"
    ; 名义箱族：头四格由运行时段写，尺寸与类型标识由发射层给。
    if name == "bk_nominal_alloc":
        return "declare ptr @bk_nominal_alloc(i64, i32)"
    ; IO 与宿主查询族：路径按 C 串借出，读出内容按带头串交回。
    if name == "bk_read_file":
        return "declare ptr @bk_read_file(ptr)"
    if name == "bk_write_file":
        return "declare void @bk_write_file(ptr, ptr)"
    if name == "bk_append_file":
        return "declare void @bk_append_file(ptr, ptr)"
    if name == "bk_try_write_file":
        return "declare i64 @bk_try_write_file(ptr, ptr)"
    if name == "bk_try_append_file":
        return "declare i64 @bk_try_append_file(ptr, ptr)"
    if name == "fgets":
        return "declare ptr @fgets(ptr, i32, ptr)"
    if name == "bk_list_dir":
        return "declare ptr @bk_list_dir(ptr)"
    if name == "bk_exists":
        return "declare i32 @bk_exists(ptr)"
    if name == "bk_is_dir":
        return "declare i32 @bk_is_dir(ptr)"
    if name == "bk_try_read_file":
        return "declare ptr @bk_try_read_file(ptr, ptr)"
    if name == "bk_argv":
        return "declare ptr @bk_argv()"
    if name == "bk_module_root":
        return "declare ptr @bk_module_root()"
    if name == "bk_set_program_base":
        return "declare void @bk_set_program_base(ptr)"
    ; 格式化族：插值与非串元素渲染都按定长缓冲写，长度含 NUL。
    if name == "snprintf":
        return "declare i32 @snprintf(ptr, i64, ptr, ...)"
    return ""
