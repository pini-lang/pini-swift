[types|import]
_ir = "../../../ir"
_backend_kit = "../../../backend-kit"

; 类型面：IR 类型下标到 LLVM 类型拼写，外加名义类型的聚合声明。
; 标量与内联聚合直出；字符串、容器、指针与名义箱一律 ptr，运行时按句柄搬。
; 结果与可选按整块聚合出：标签格在前，载荷与错误字各占一格，不做箱。

; 类型拼写：无类型答 void；越界与未认类别答 ptr，宁可宽一格也不出错误拼写。
llvmTypeName|func(pool: IrTypePool, typeId: I32,) -> (String,):
    if typeId < 0:
        return "void"
    if typeId >= irTypeCount(pool):
        return "ptr"
    let entry = irTypeAt(pool = pool, id = typeId)
    let tag = irTypeTag(entry.kind)
    if tag == 1:
        return "i32"
    if tag == 2:
        return "i64"
    if tag == 3:
        return "i64"
    if tag == 4:
        return "i8"
    if tag == 5:
        return "i8"
    if tag == 6:
        return "double"
    if tag == 7:
        return "i1"
    if tag == 9:
        return "i64"
    if tag == 10:
        return resultSpelling(pool = pool, kids = entry.kids)
    if tag == 13:
        return optionalSpelling(pool = pool, kids = entry.kids)
    if tag == 18:
        ; 惰性引用是不透明句柄：运行时段按 ptr 收发，元素类型只用于装箱 ABI。
        return "ptr"
    if tag == 24:
        ; 弱引用同样是不透明句柄；元素类型只决定 `.value` 的载荷拼写。
        return "ptr"
    if tag == 20:
        ; 函数值：代码指针加捕获环境，调用协议固定为 `{ ptr, ptr }`。
        return "{ ptr, ptr }"
    return "ptr"

; 结果拼写：三槽，标签 · ok 载荷 · 错误字；载荷缺席时按 i64 兜底，错误字恒为 i64。
resultSpelling|func(pool: IrTypePool, kids: Array<I32>,) -> (String,):
    var payload = "i64"
    if len(kids) > 0:
        payload = llvmTypeName(pool = pool, typeId = kids[0])
    return "{ i64, " + payload + ", i64 }"

; 可选拼写：两槽，标签 · 载荷；载荷缺席时按 i64 兜底。
optionalSpelling|func(pool: IrTypePool, kids: Array<I32>,) -> (String,):
    var payload = "i64"
    if len(kids) > 0:
        payload = llvmTypeName(pool = pool, typeId = kids[0])
    return "{ i64, " + payload + " }"

; 聚合名：结构、对象、枚举各一前缀，同名不同类型因此不撞；非名义类型答空串。
llvmAggregateName|func(pool: IrTypePool, typeId: I32,) -> (String,):
    if typeId < 0 || typeId >= irTypeCount(pool):
        return ""
    let entry = irTypeAt(pool = pool, id = typeId)
    let tag = irTypeTag(entry.kind)
    if tag == 14:
        if irIsObjectType(pool = pool, id = typeId):
            return "%object." + mangleName(name = entry.name)
        return "%struct." + mangleName(name = entry.name)
    if tag == 15:
        return "%enum." + mangleName(name = entry.name)
    return ""

; 结构体身：头四格照运行时头的拼写（计数 · 弱计数 · 类型标识 · 旁表），字段按自身类型排在后面。
structBody|func(pool: IrTypePool, decl: IrDecl,) -> (String,):
    var out = " { i32, i32, i32, ptr"
    var i = 0
    while i < len(decl.fields):
        out = out + ", " + llvmTypeName(pool = pool, typeId = decl.fields[i].typeId)
        i = i + 1
    return out + " }"

; 枚举体：头四格后是标签格，载荷窗口按最宽用例占位；窄用例只写自己的前几格。
enumBody|func(pool: IrTypePool, decl: IrDecl,) -> (String,):
    var out = " { i32, i32, i32, ptr, i32"
    let widest = widestCaseIndex(cases = decl.cases)
    if widest >= 0:
        let payload = decl.cases[widest].payload
        var i = 0
        while i < len(payload):
            out = out + ", " + llvmTypeName(pool = pool, typeId = payload[i])
            i = i + 1
    return out + " }"

; 最宽用例：载荷个数最多的那一条，并列取声明序在前者；载荷窗口的拼写只认它。
widestCaseIndex|func(cases: Array<IrCase>,) -> (I32,):
    var best = -1
    var width = 0
    var i = 0
    while i < len(cases):
        if len(cases[i].payload) > width:
            width = len(cases[i].payload)
            best = i
        i = i + 1
    return best

; 元素装箱宽度：按字节给，认不出答零；容器族搬元素只认这一个数。
; 指针宽度的类别随目标走，其余按标量自身宽度，与槽宽无关。
elementWidth|func(pool: IrTypePool, typeId: I32, pointerBytes: I32,) -> (I32,):
    if typeId < 0 || typeId >= irTypeCount(pool):
        return 0
    let tag = irTypeTag(irTypeAt(pool = pool, id = typeId).kind)
    if tag == 1:
        return 4
    if tag == 2 || tag == 3 || tag == 6 || tag == 9:
        return 8
    if tag == 4 || tag == 5 || tag == 7:
        return 1
    if tag == 8 || tag == 11 || tag == 12 || tag == 16 || tag == 17 || tag == 21:
        return pointerBytes
    if tag == 14 || tag == 15:
        return pointerBytes
    return 0

; 元素装箱标签：决定销毁与覆盖时如何归还成员，认不出答负一。
; 串与字符按裸指针记：本后端不 retain，若按计数标签，覆盖时运行时会释放别处仍在读的值。
elementTag|func(pool: IrTypePool, typeId: I32,) -> (I32,):
    if typeId < 0 || typeId >= irTypeCount(pool):
        return -1
    let tag = irTypeTag(irTypeAt(pool = pool, id = typeId).kind)
    if tag == 1 || tag == 2 || tag == 3 || tag == 4 || tag == 5:
        return 0
    if tag == 6:
        return 1
    if tag == 7:
        return 2
    ; 串元素按裸指针放：容器覆盖时不归还，别处仍在读的串不会被提前释放。
    if tag == 8:
        return 6
    if tag == 9:
        return 6
    if tag == 11 || tag == 21:
        return 6
    if tag == 12 || tag == 16 || tag == 17:
        return 4
    if tag == 14 || tag == 15:
        return 6
    return -1

; 数组元素标签：名义箱按聚合登记成员钩子，其余交给通用表。
;  注意  与字典分开：字典还没有成员钩子，按聚合记账会只搬字节不还成员。
arrayElementTag|func(pool: IrTypePool, typeId: I32,) -> (I32,):
    if typeId >= 0 && typeId < irTypeCount(pool):
        let tag = irTypeTag(irTypeAt(pool = pool, id = typeId).kind)
        if tag == 14 || tag == 15:
            return 8
    return elementTag(pool = pool, typeId = typeId)

; 类型声明：结构、对象、枚举三族各出聚合；无声明条目的类型跳过，取值点会自行报缺口。
llvmTypeDecls|func(module: IrModule,) -> (Array<String>,):
    var lines: Array<String> = []
    var i = 0
    while i < irTypeCount(module.types):
        let entry = irTypeAt(pool = module.types, id = i)
        let tag = irTypeTag(entry.kind)
        if tag == 14 || tag == 15:
            let decl = declAt(table = module.decls, typeId = i)
            if len(decl.name) > 0:
                let name = llvmAggregateName(pool = module.types, typeId = i)
                var body = structBody(pool = module.types, decl = decl)
                if tag == 15:
                    body = enumBody(pool = module.types, decl = decl)
                lines = lines.append(name + " = type" + body)
        i = i + 1
    return lines
