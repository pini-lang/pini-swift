; 给定块读成步骤：块名即步骤名，三字段按名取值，顺序与源序一致。
给定块读成步骤|test() -> ():
    let 文本 = "[cstr|given]\n    头文件: String = \"include/cstr.h\"\n    包含路径: [String,] = [\"include\",]\n    定义: [String,] = [\"_GNU_SOURCE\",]\n\n[mathf|given]\n    头文件: String = \"include/mathf.h\"\n    包含路径: [String,] = []\n"
    let 脚本 = parseBuildScript(text = 文本, path = "build.pini")
    assert(len(脚本.errors) == 0, "不应有错误：" + 首条错误(脚本.errors))
    assert(len(脚本.steps) == 2, "两条步骤")
    assert(脚本.steps[0].name == "cstr", "块名即步骤名")
    assert(脚本.steps[0].headerPath == "include/cstr.h", "头文件去掉引号")
    assert(脚本.steps[0].includePaths[0] == "include", "包含路径按源序")
    assert(脚本.steps[0].defines[0] == "_GNU_SOURCE", "定义按源序")
    assert(len(脚本.steps[1].includePaths) == 0, "空数组合法")
    return

; 缺脚本不算错：没有 build.pini 的包照常进计划，步骤为空。
缺脚本不算错|test() -> ():
    let 脚本 = readBuildScript(packageAbs = "fixtures/build-script/pkg/src")
    assert(!脚本.present, "该目录没有 build.pini")
    assert(len(脚本.errors) == 0, "缺脚本不报错")
    assert(len(脚本.steps) == 0, "没有步骤")
    return

; 只收给定块：函数声明出现在构建脚本里，按非给定块报错。
只收给定块|test() -> ():
    let 脚本 = parseBuildScript(text = "旁路|func() -> ():\n    return\n", path = "build.pini")
    assert(len(脚本.errors) == 1, "一条错误")
    assert(isErrorKind(e = 脚本.errors[0], kind = .errorBuildScriptDecl), "非给定块")
    return

; 字段面固定：未知字段、缺头文件、取值不是字面量各报一条。
字段面固定|test() -> ():
    let 未知 = parseBuildScript(text = "[cstr|given]\n    头文件: String = \"a.h\"\n    输出: String = \"x\"\n", path = "build.pini")
    assert(len(未知.errors) == 1, "未知字段一条")
    assert(isErrorKind(e = 未知.errors[0], kind = .errorBuildStepField), "未知字段归类")
    let 缺失 = parseBuildScript(text = "[cstr|given]\n    包含路径: [String,] = []\n", path = "build.pini")
    assert(len(缺失.errors) == 1, "缺头文件一条")
    assert(缺失.errors[0].detail.contains("缺 头文件"), "缺头文件点名")
    let 非字面量 = parseBuildScript(text = "[cstr|given]\n    头文件: String = 拼(\"a\", \"b\")\n", path = "build.pini")
    assert(len(非字面量.errors) == 1, "非字面量一条")
    assert(isErrorKind(e = 非字面量.errors[0], kind = .errorBuildStepField), "非字面量归类")
    return

; 步骤重名：包内两份同名块只留先出现的一份，并报一条重名。
步骤重名|test() -> ():
    let 文本 = "[dup|given]\n    头文件: String = \"a.h\"\n\n[dup|given]\n    头文件: String = \"b.h\"\n"
    let 脚本 = parseBuildScript(text = 文本, path = "build.pini")
    assert(len(脚本.steps) == 1, "只留一份")
    assert(脚本.steps[0].headerPath == "a.h", "留先出现的")
    assert(len(脚本.errors) == 1, "重名一条")
    assert(isErrorKind(e = 脚本.errors[0], kind = .errorBuildStepName), "重名归类")
    return

; 计划带步骤：产物路径按 profile 与包名生成，计划文本逐行铺开。
计划带步骤|test() -> ():
    let 计划 = planWorkspace("./fixtures/build-script")
    assert(计划.isOK(), "不应有错误：" + planText(计划))
    let 包 = 计划.packageAt(0)
    assert(len(包.steps) == 2, "计划带两条步骤")
    assert(包.steps[0].outputPath == "./fixtures/build-script/.build/debug/packages/builddemo/generated/cstr.pini", "产物落在包内 generated")
    let 文本 = planText(计划)
    assert(文本.contains("step cstr header=include/cstr.h include=include defs=_GNU_SOURCE out="), "步骤行按字段序")
    assert(文本.contains("step mathf header=include/mathf.h out="), "空字段不占位")
    return

; 测试助手：错误表首条文本；空表答空串，用于断言里的失败信息。
首条错误|func(_errors: Array<ManifestError>,) -> (String,):
    if len(_errors) == 0:
        return ""
    return manifestErrorText(_errors[0])
