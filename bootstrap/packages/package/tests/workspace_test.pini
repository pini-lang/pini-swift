; 工作区识别：按工作区根运行时 `.` 即根清单目录；注释里的 [workspace] 不算。
工作区标记可识别|test() -> ():
    assert(hasWorkspace("."), "工作区根必须能被识别")
    return

; 根清单装配：九个成员、固定拓扑序、无错误；两次装配文本逐字相同。
根计划可装配|test() -> ():
    let 计划 = planWorkspace(".")
    assert(计划.isOK(), "不应有错误：" + planText(计划))
    assert(计划.packageCount() == 9, "九个包")
    assert(计划.packageAt(0).name == "support", "基础包最先")
    assert(计划.packageAt(5).name == "syntax", "语法包在装载器之前")
    assert(计划.packageAt(6).name == "module_loader", "装载器依赖四包")
    assert(计划.packageAt(7).name == "runtime_api", "运行时段包无依赖，排在语义层之前")
    assert(计划.packageAt(8).name == "semantics", "语义层依赖装载器，排最后")
    let 首 = 计划.packageAt(0).targets[0]
    assert(首.irPath == "./.build/debug/packages/support/support.ll", "库产物路径")
    assert(planText(计划) == planText(planWorkspace(".")), "两次装配逐字相同")
    return
