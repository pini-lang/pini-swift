; 工作区识别：按工作区根运行时 `.` 即根清单目录；注释里的 [workspace] 不算。
工作区标记可识别|test() -> ():
    assert(hasWorkspace("."), "工作区根必须能被识别")
    return

; 根清单装配：十六个成员、固定拓扑序、无错误；两次装配文本逐字相同。
根计划可装配|test() -> ():
    let 计划 = planWorkspace(".")
    assert(计划.isOK(), "不应有错误：" + planText(计划))
    assert(计划.packageCount() == 16, "十六个包")
    assert(计划.packageAt(0).name == "support", "基础包最先")
    assert(计划.packageAt(1).name == "diagnostics", "诊断包只依赖 support")
    assert(计划.packageAt(2).name == "unicode", "Unicode 表只依赖 support")
    assert(计划.packageAt(3).name == "syntax", "语法包在清单包之前")
    assert(计划.packageAt(4).name == "package", "清单包读构建脚本，依赖语法包")
    assert(计划.packageAt(5).name == "module_loader", "装载器依赖四包")
    assert(计划.packageAt(6).name == "semantics", "语义层依赖装载器")
    assert(计划.packageAt(7).name == "ir", "中间层排在语义层之后")
    assert(计划.packageAt(8).name == "backend_kit", "后端接缝包排在中间层之后")
    assert(计划.packageAt(9).name == "backend_dump", "转储后端依赖接缝包")
    assert(计划.packageAt(10).name == "backend_json", "JSON 后端与转储后端同层")
    assert(计划.packageAt(11).name == "backend_llvm", "LLVM 后端与两条结构转储同层")
    assert(计划.packageAt(12).name == "hostproc", "进程包无依赖，落在后端之后")
    assert(计划.packageAt(13).name == "testkit", "测试工具依赖基础包与中间层")
    assert(计划.packageAt(14).name == "driver", "驱动依赖全部前置包")
    assert(计划.packageAt(15).name == "runtime_api", "运行时段包无依赖，排在最后")
    let 首 = 计划.packageAt(0).targets[0]
    assert(首.irPath == "./.build/" + 计划.profile + "/packages/support/support.ll", "库产物路径")
    assert(planText(计划) == planText(planWorkspace(".")), "两次装配逐字相同")
    return
