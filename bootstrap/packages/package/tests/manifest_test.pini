; 工作区清单：members 与 profile 取值；profile 缺省为 debug。
工作区清单|test() -> ():
    let 解析 = parseWorkspaceManifest(text = "[workspace]\nmembers = [\"a\", \"b\"]\n", rootPath = ".", path = "pini.toml")
    assert(len(解析.errors) == 0, "不应有错误")
    assert(len(解析.manifest.members) == 2, "两个成员")
    assert(解析.manifest.profile == "debug", "profile 缺省")
    return

; 包清单：三类 target 按清单顺序展开，require 的键是依赖名。
包清单|test() -> ():
    let 文本 = "[package]\nname = \"demo\"\n\n[require]\nsupport = \"*\"\n\n[lib]\nname = \"demo\"\nentry = \"src/api/lit.pini\"\n\n[[bin]]\nname = \"tool\"\nentry = \"src/api/main.pini\"\n\n[[test]]\nname = \"demo-tests\"\nentry = \"tests\"\n"
    let 解析 = parsePackageManifest(text = 文本, rootPath = "pkg", path = "pkg/pini.toml")
    assert(len(解析.errors) == 0, "不应有错误")
    assert(解析.manifest.name == "demo", "包名")
    assert(len(解析.manifest.requires) == 1, "一条依赖")
    assert(解析.manifest.requires[0] == "support", "依赖名")
    assert(len(解析.manifest.targets) == 3, "三类 target")
    assert(isTargetKind(kind = 解析.manifest.targets[0].kind, expected = targetLibrary), "首个是库")
    assert(解析.manifest.targets[1].name == "tool", "可执行名")
    assert(isTargetKind(kind = 解析.manifest.targets[2].kind, expected = targetTest), "末个是测试")
    return

; 成员缺失、profile 带斜杠、包缺 target、入口含 ..、target 重名各有专用错误。
错误用例|test() -> ():
    let 空 = parseWorkspaceManifest(text = "[workspace]\nprofile = \"debug\"\n", rootPath = ".", path = "pini.toml")
    assert(isErrorKind(e = 空.errors[0], kind = .errorMembersEmpty), "缺 members")
    let 斜 = parseWorkspaceManifest(text = "[workspace]\nmembers = [\"a\"]\nprofile = \"x/y\"\n", rootPath = ".", path = "pini.toml")
    assert(isErrorKind(e = 斜.errors[0], kind = .errorProfileInvalid), "profile 带斜杠")
    let 无目标 = parsePackageManifest(text = "[package]\nname = \"p\"\n", rootPath = "p", path = "p/pini.toml")
    assert(isErrorKind(e = 无目标.errors[0], kind = .errorMissingTargets), "缺 target")
    let 坏入口 = parsePackageManifest(text = "[package]\nname = \"p\"\n[lib]\nname = \"p\"\nentry = \"../x.pini\"\n", rootPath = "p", path = "p/pini.toml")
    assert(isErrorKind(e = 坏入口.errors[0], kind = .errorEntryPath), "入口越界")
    let 重名 = parsePackageManifest(text = "[package]\nname = \"p\"\n[lib]\nname = \"p\"\nentry = \"src/a.pini\"\n[[bin]]\nname = \"p\"\nentry = \"src/main.pini\"\n", rootPath = "p", path = "p/pini.toml")
    assert(isErrorKind(e = 重名.errors[0], kind = .errorDuplicateTarget), "target 重名")
    return

; 缺 [package] 表与缺 [workspace] 表都按缺表报，不退化成默认值。
缺表|test() -> ():
    let 包 = parsePackageManifest(text = "[lib]\nname = \"p\"\nentry = \"src/a.pini\"\n", rootPath = "p", path = "p/pini.toml")
    assert(isErrorKind(e = 包.errors[0], kind = .errorTableMissing), "缺 [package]")
    let 工作区 = parseWorkspaceManifest(text = "[package]\nname = \"p\"\n", rootPath = ".", path = "pini.toml")
    assert(isErrorKind(e = 工作区.errors[0], kind = .errorTableMissing), "缺 [workspace]")
    return
