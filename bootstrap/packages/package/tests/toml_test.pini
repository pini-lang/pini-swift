; 平表与点分子表：表名原样保留，点分不拆层级。
平表与点分|test() -> ():
    let doc = parseToml(text = "[package]\nname = \"demo\"\n\n[require.core]\npath = \"../x\"\n", path = "p.toml")
    assert(len(doc.errors) == 0, "不应有形状错误")
    assert(tomlHasTable(doc = doc, name = "package"), "package 表应存在")
    assert(tomlValue(doc = doc, table = "package", key = "name") == "demo", "name 取值")
    assert(tomlHasTable(doc = doc, name = "require.core"), "点分子表按原名保留")
    assert(tomlValue(doc = doc, table = "require.core", key = "path") == "../x", "子表取值")
    return

; 数组表分行：同名表的两行各自成条目，行号从 0 递增。
数组表分行|test() -> ():
    let doc = parseToml(text = "[[bin]]\nname = \"a\"\nentry = \"src/a.pini\"\n\n[[bin]]\nname = \"b\"\nentry = \"src/b.pini\"\n", path = "p.toml")
    assert(len(doc.errors) == 0, "不应有形状错误")
    assert(tomlRowCount(doc = doc, table = "bin") == 2, "两行")
    assert(tomlRowValue(doc = doc, table = "bin", row = 0, key = "name") == "a", "首行")
    assert(tomlRowValue(doc = doc, table = "bin", row = 1, key = "entry") == "src/b.pini", "次行")
    return

; 内联数组与引号内井号：数组拆成元素，引号里的 # 属于值。
数组与注释|test() -> ():
    let doc = parseToml(text = "[workspace]\nmembers = [\"a\", \"b/c\"] # 两成员\nnote = \"x # y\"\n", path = "p.toml")
    assert(len(doc.errors) == 0, "不应有形状错误")
    let members = tomlArray(doc = doc, table = "workspace", key = "members")
    assert(len(members) == 2, "两个元素")
    assert(members[1] == "b/c", "元素取值")
    assert(tomlValue(doc = doc, table = "workspace", key = "note") == "x # y", "引号里的 # 不截断")
    return

; 形状错误各自记账：表外键、缺等号、重复键。
形状错误|test() -> ():
    let 外 = parseToml(text = "name = \"x\"\n", path = "p.toml")
    assert(len(外.errors) == 1, "表外键记一条")
    assert(isErrorKind(e = 外.errors[0], kind = .errorKeyOutsideTable), "类别应为表外键")
    let 坏 = parseToml(text = "[a]\nbad line\n", path = "p.toml")
    assert(isErrorKind(e = 坏.errors[0], kind = .errorTomlShape), "缺等号")
    let 重 = parseToml(text = "[a]\nk = 1\nk = 2\n", path = "p.toml")
    assert(isErrorKind(e = 重.errors[0], kind = .errorDuplicateKey), "重复键")
    return

; 整行注释与空行不产条目。
注释与空行|test() -> ():
    let doc = parseToml(text = "# 说明\n\n  \n[a]\nk = \"v\" # 尾注\n", path = "p.toml")
    assert(len(doc.errors) == 0, "不应有形状错误")
    assert(len(tomlKeys(doc = doc, table = "a")) == 1, "只剩一个键")
    assert(tomlValue(doc = doc, table = "a", key = "k") == "v", "尾注不影响取值")
    return
