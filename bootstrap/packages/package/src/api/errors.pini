; 清单错误类别：每一类对应一种可判定的失效；文案由类别名与细节拼出，不在各处另写。
[ManifestErrorKind]
errorTomlShape
errorKeyOutsideTable
errorMissingKey
errorDuplicateKey
errorTableMissing
errorMembersEmpty
errorManifestMissing
errorMemberPath
errorMemberDuplicated
errorProfileInvalid
errorPackageName
errorMissingTargets
errorTargetName
errorEntryPath
errorDuplicateTarget
errorDuplicatePackage
errorExecutableCollision
errorDependencyCycle
errorFFIABI
errorFFILibrary
errorVersionConstraint
errorBuildScriptSyntax
errorBuildScriptDecl
errorBuildStepName
errorBuildStepField

; 清单错误：类别、出错清单路径与细节；细节带具体包名、target 名或成员路径。
(ManifestError)
kind: ManifestErrorKind = .errorTomlShape
path: String = ""
detail: String = ""

; 造错误：三处共用同一构造，字段顺序固定。
manifestError|func(kind: ManifestErrorKind, path: String, detail: String,) -> (ManifestError,):
    var out = ManifestError()
    out.kind = kind
    out.path = path
    out.detail = detail
    return out

; 类别名：诊断消息与测试断言共用一份拼写。
manifestErrorKindName|func(_kind: ManifestErrorKind,) -> (String,):
    match _kind:
        case errorTomlShape:
            return "行不是表头也不是键值对"
        case errorKeyOutsideTable:
            return "键值对不在任何表内"
        case errorMissingKey:
            return "键为空"
        case errorDuplicateKey:
            return "同一表内重复键"
        case errorTableMissing:
            return "缺必需的表"
        case errorMembersEmpty:
            return "members 必须是非空路径数组"
        case errorManifestMissing:
            return "缺少清单文件"
        case errorMemberPath:
            return "工作区成员路径非法"
        case errorMemberDuplicated:
            return "同一目录被重复登记"
        case errorProfileInvalid:
            return "profile 必须是单一路径分量"
        case errorPackageName:
            return "包名缺失或非法"
        case errorMissingTargets:
            return "成员未声明 target"
        case errorTargetName:
            return "target 名缺失或非法"
        case errorEntryPath:
            return "入口必须是包根相对路径"
        case errorDuplicateTarget:
            return "包内 target 重名"
        case errorDuplicatePackage:
            return "工作区包名重复"
        case errorExecutableCollision:
            return "可执行产物重名"
        case errorDependencyCycle:
            return "工作区依赖成环"
        case errorFFIABI:
            return "ffi.abi 只认 C"
        case errorFFILibrary:
            return "ffi.libs 的名字不带 -l"
        case errorVersionConstraint:
            return "版本约束不可解析"
        case errorBuildScriptSyntax:
            return "构建脚本读不出"
        case errorBuildScriptDecl:
            return "构建脚本只收给定块"
        case errorBuildStepName:
            return "翻译步名缺失、非法或重复"
        case errorBuildStepField:
            return "翻译步字段缺失、未知或取值不是字面量"
    return "清单错误"

; 同类别判定：枚举相等比较不可用，按名称比。
isErrorKind|func(e: ManifestError, kind: ManifestErrorKind,) -> (Bool,):
    return manifestErrorKindName(e.kind) == manifestErrorKindName(kind)

; 错误文本：路径 + 类别名 + 细节；细节为空时不印空括号。
manifestErrorText|func(_e: ManifestError,) -> (String,):
    if len(_e.detail) == 0:
        return _e.path + "：" + manifestErrorKindName(_e.kind)
    return _e.path + "：" + manifestErrorKindName(_e.kind) + "（" + _e.detail + "）"
