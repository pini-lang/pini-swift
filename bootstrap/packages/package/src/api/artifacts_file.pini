; 产物记录：包名、根相对 IR 路径、整份文本摘要与依赖接口摘要；记录只描述上次发射出的包产物。
; 渲染按包名升序，同一输入两次逐字节相同；读回不合法时不答条目，交给调用方当无记录处理。
(ArtifactEntry)
name: String = ""
path: String = ""
hash: String = ""
deps: Array<InterfaceDep> = []

; 产物记录：profile 与按包名排好的条目。
(ArtifactLedger)
profile: String = "debug"
entries: Array<ArtifactEntry> = []

; 记录版本：格式改了就升，旧记录读回按版本不符处理。
artifactLedgerVersion|func() -> (I32,):
    return 1

; 记录路径：`<根>/.build/<profile>/artifacts.toml`。
artifactLedgerPath|func(root: String, profile: String,) -> (String,):
    return root + "/.build/" + profile + "/artifacts.toml"

; 产物路径：`<根>/.build/<profile>/packages/<包>/<包>.ll`，由 emit --packages 写。
artifactPath|func(root: String, profile: String, name: String,) -> (String,):
    return root + "/.build/" + profile + "/packages/" + name + "/" + name + ".ll"

; 排序：按包名字节序插入排序，输入顺序不影响输出。
sortArtifacts|func(entries: Array<ArtifactEntry>,) -> (Array<ArtifactEntry>,):
    var out = entries
    var i = 1
    while i < len(out):
        let value = out[i]
        var j = i - 1
        while j >= 0 && comparePlanText(a = out[j].name, b = value.name) > 0:
            out[j + 1] = out[j]
            j = j - 1
        out[j + 1] = value
        i = i + 1
    return out

; 渲染：头段一次、条目逐段；依赖串与路径都带引号，行序固定。
artifactLedgerText|func(_ledger: ArtifactLedger,) -> (String,):
    var text = "[artifacts]\nversion = \(artifactLedgerVersion())\nprofile = \"" + _ledger.profile + "\"\n"
    let entries = sortArtifacts(entries = _ledger.entries)
    var i = 0
    while i < len(entries):
        let one = entries[i]
        text = text + "\n[[artifact]]\n"
        text = text + "package = \"" + one.name + "\"\n"
        text = text + "path = \"" + one.path + "\"\n"
        text = text + "hash = \"" + one.hash + "\"\n"
        text = text + "deps = \"" + depsText(deps = one.deps) + "\"\n"
        i = i + 1
    return text

; 记录读取结果：profile、条目与不合法原因；errors 非空时条目表不可用。
(ArtifactRead)
profile: String = "debug"
entries: Array<ArtifactEntry> = []
errors: Array<ManifestError> = []

; 按包名查条目：未命中答 -1。
findArtifactName|func(entries: Array<ArtifactEntry>, name: String,) -> (I32,):
    var i = 0
    while i < len(entries):
        if entries[i].name == name:
            return i
        i = i + 1
    return -1

; 解析记录：版本不符或形状非法答不合法原因；重复包名与缺 package 各记一条。
parseArtifactLedger|func(text: String, path: String,) -> (ArtifactRead,):
    var out = ArtifactRead()
    let doc = parseToml(text = text, path = path)
    if len(doc.errors) > 0:
        out.errors = doc.errors
        return out
    out.profile = tomlValue(doc = doc, table = "artifacts", key = "profile")
    if tomlValue(doc = doc, table = "artifacts", key = "version") != "\(artifactLedgerVersion())":
        out.errors = out.errors.append(manifestError(kind = .errorTomlShape, path = path, detail = "产物记录版本与当前不符"))
        return out
    var r = 0
    while r < tomlRowCount(doc = doc, table = "artifact"):
        var one = ArtifactEntry()
        one.name = tomlRowValue(doc = doc, table = "artifact", row = r, key = "package")
        one.path = tomlRowValue(doc = doc, table = "artifact", row = r, key = "path")
        one.hash = tomlRowValue(doc = doc, table = "artifact", row = r, key = "hash")
        if len(one.name) == 0:
            out.errors = out.errors.append(manifestError(kind = .errorMissingKey, path = path, detail = "artifact 条目缺 package"))
        elif findArtifactName(entries = out.entries, name = one.name) >= 0:
            out.errors = out.errors.append(manifestError(kind = .errorDuplicateKey, path = path, detail = "产物记录里包名重复：" + one.name))
        else:
            let parsed = parseDeps(text = tomlRowValue(doc = doc, table = "artifact", row = r, key = "deps"), path = path, owner = one.name)
            one.deps = parsed.deps
            out.errors = appendErrors(errors = out.errors, extra = parsed.errors)
            out.entries = out.entries.append(one)
        r = r + 1
    return out
