; 版本模型：点分十进制版本、`^` / `~` / `=` / 区间与 `*` 约束、补零比较与最小版本选择。
; 解析失败不抛：版本答空表、约束答 ok=false，由调用方决定报错（refresh）还是当未知（tidy 写 `*`）。

; 比较方向：`^` 与 `~` 各展开成上下界两个原子，故只有这三种。
[VersionOp]
versionGe
versionLt
versionEq

; 约束原子：方向与版本分量；`Constraint.atoms` 为空即任意版本。
(VersionAtom)
op: VersionOp = .versionGe
parts: Array<I32> = []

; 约束：全部原子都满足才算满足；raw 是清单里写下的原文，写进诊断与锁文件。
(Constraint)
atoms: Array<VersionAtom> = []
raw: String = "*"
ok: Bool = true

; 方向名：枚举相等比较不可用，按名称比。
versionOpName|func(_op: VersionOp,) -> (String,):
    match _op:
        case versionGe:
            return "ge"
        case versionLt:
            return "lt"
        case versionEq:
            return "eq"
    return "ge"

; 同方向判定：约束求值只用它，不依赖枚举值的内部次序。
isVersionOp|func(op: VersionOp, expected: VersionOp,) -> (Bool,):
    return versionOpName(op) == versionOpName(expected)

; 版本分量：按点拆开，逐段剥 `v` 前缀后只收纯数字段；一段都收不到答空表。
versionParts|func(_text: String,) -> (Array<I32>,):
    var out: Array<I32> = []
    let parts = _text.split(".")
    var i = 0
    while i < len(parts):
        let part = stripVersionPrefix(parts[i])
        if isDigitRun(part):
            out = out.append(digitValue(part))
        i = i + 1
    return out

; 剥 `v` / `V` 前缀：规范化而非兜底；剥出的串会进锁文件与 tag 名。
stripVersionPrefix|func(_text: String,) -> (String,):
    if len(_text) == 0:
        return _text
    let head = ord(_text[0])
    if head == 118 || head == 86:
        return _text.substring(1, len(_text))
    return _text

; 纯数字判定：空串答否，任一段非 0-9 答否。
isDigitRun|func(_text: String,) -> (Bool,):
    if len(_text) == 0:
        return false
    var i = 0
    while i < len(_text):
        let code = ord(_text[i])
        if code < 48 || code > 57:
            return false
        i = i + 1
    return true

; 数字段求值：调用前已确认为纯数字。
digitValue|func(_text: String,) -> (I32,):
    var value = 0
    var i = 0
    while i < len(_text):
        value = value * 10 + (ord(_text[i]) - 48)
        i = i + 1
    return value

; 分量比较：补零到同长逐段比，小于 / 等于 / 大于答 -1 / 0 / 1。
compareParts|func(first: Array<I32>, second: Array<I32>,) -> (I32,):
    var count = len(first)
    if len(second) > count:
        count = len(second)
    var i = 0
    while i < count:
        var left = 0
        var right = 0
        if i < len(first):
            left = first[i]
        if i < len(second):
            right = second[i]
        if left < right:
            return -1
        if left > right:
            return 1
        i = i + 1
    return 0

; 造原子：方向与分量一次填好，调用点不再分两行赋值。
makeVersionAtom|func(op: VersionOp, parts: Array<I32>,) -> (VersionAtom,):
    var out = VersionAtom()
    out.op = op
    out.parts = parts
    return out

; 解析约束：逗号分隔的原子合取；空串与 `*` 都是任意版本；任一段不可解析答 ok=false。
parseConstraint|func(_raw: String,) -> (Constraint,):
    var out = Constraint()
    out.raw = trimSpace(_raw)
    if len(out.raw) == 0 || out.raw == "*":
        return out
    if endsWith(text = out.raw, suffix = ","):
        out.ok = false
        return out
    let parts = out.raw.split(",")
    var i = 0
    while i < len(parts):
        out = appendConstraintPart(out, trimSpace(parts[i]))
        if !out.ok:
            return out
        i = i + 1
    return out

; 追加一段约束：`^` / `~` 各出上下界，`=` 出等值，`>=` 与裸版本出下界，`<` 出上界。
appendConstraintPart|func(_out: Constraint, _part: String,) -> (Constraint,):
    var out = _out
    if len(_part) == 0:
        out.ok = false
        return out
    if startsWith(text = _part, prefix = "^"):
        let base = versionParts(_part.substring(1, len(_part)))
        if len(base) == 0:
            out.ok = false
            return out
        out.atoms = out.atoms.append(makeVersionAtom(op = .versionGe, parts = base))
        out.atoms = out.atoms.append(makeVersionAtom(op = .versionLt, parts = caretUpper(base)))
        return out
    if startsWith(text = _part, prefix = "~"):
        let base = versionParts(_part.substring(1, len(_part)))
        if len(base) == 0:
            out.ok = false
            return out
        out.atoms = out.atoms.append(makeVersionAtom(op = .versionGe, parts = base))
        out.atoms = out.atoms.append(makeVersionAtom(op = .versionLt, parts = tildeUpper(base)))
        return out
    if startsWith(text = _part, prefix = ">="):
        let base = versionParts(_part.substring(2, len(_part)))
        if len(base) == 0:
            out.ok = false
            return out
        out.atoms = out.atoms.append(makeVersionAtom(op = .versionGe, parts = base))
        return out
    if startsWith(text = _part, prefix = "="):
        let base = versionParts(_part.substring(1, len(_part)))
        if len(base) == 0:
            out.ok = false
            return out
        out.atoms = out.atoms.append(makeVersionAtom(op = .versionEq, parts = base))
        return out
    if startsWith(text = _part, prefix = "<"):
        let base = versionParts(_part.substring(1, len(_part)))
        if len(base) == 0:
            out.ok = false
            return out
        out.atoms = out.atoms.append(makeVersionAtom(op = .versionLt, parts = base))
        return out
    let base = versionParts(_part)
    if len(base) == 0:
        out.ok = false
        return out
    out.atoms = out.atoms.append(makeVersionAtom(op = .versionGe, parts = base))
    return out

; `^` 上界：major>0 进到下个 major，major=0 进到下个 minor（npm 语义）。
caretUpper|func(_v: Array<I32>,) -> (Array<I32>,):
    var out: Array<I32> = []
    if _v[0] > 0:
        out = out.append(_v[0] + 1)
        out = out.append(0)
        out = out.append(0)
        return out
    var minor = 0
    if len(_v) > 1:
        minor = _v[1]
    out = out.append(0)
    out = out.append(minor + 1)
    out = out.append(0)
    return out

; `~` 上界：进到下个 minor（npm 语义）。
tildeUpper|func(_v: Array<I32>,) -> (Array<I32>,):
    var minor = 0
    if len(_v) > 1:
        minor = _v[1]
    var out: Array<I32> = []
    out = out.append(_v[0])
    out = out.append(minor + 1)
    out = out.append(0)
    return out

; 约束求值：全部原子满足才答真；空原子表答真。
constraintSatisfies|func(_c: Constraint, _parts: Array<I32>,) -> (Bool,):
    var i = 0
    while i < len(_c.atoms):
        let atom = _c.atoms[i]
        let order = compareParts(first = _parts, second = atom.parts)
        if isVersionOp(op = atom.op, expected = .versionGe) && order < 0:
            return false
        if isVersionOp(op = atom.op, expected = .versionLt) && order >= 0:
            return false
        if isVersionOp(op = atom.op, expected = .versionEq) && order != 0:
            return false
        i = i + 1
    return true

; 候选升序：按分量补零比较插入，同版本只留先出现的一条。
sortVersionTexts|func(_items: Array<String>,) -> (Array<String>,):
    var out: Array<String> = []
    var i = 0
    while i < len(_items):
        out = insertVersionText(out, _items[i])
        i = i + 1
    return out

; 插入一条候选：已存在同版本时原样返回。
insertVersionText|func(_items: Array<String>, _value: String,) -> (Array<String>,):
    var out: Array<String> = []
    var placed = false
    let valueParts = versionParts(_value)
    var i = 0
    while i < len(_items):
        if !placed:
            let order = compareParts(first = valueParts, second = versionParts(_items[i]))
            if order == 0:
                return _items
            if order < 0:
                out = out.append(_value)
                placed = true
        out = out.append(_items[i])
        i = i + 1
    if !placed:
        out = out.append(_value)
    return out

; 选择结果：版本与是否选中并列；未选中时版本为空串，调用方据此报不可满足。
(VersionPick)
version: String = ""
ok: Bool = false

; 最小版本选择：升序里第一个满足全部约束者；全部约束为 `*` 时取最高版本（回填语义）。
; 约束不可解析或没有候选满足都答 ok=false，调用方据此报不可满足，不静默退回某个版本。
selectVersion|func(candidates: Array<String>, constraints: Array<String>,) -> (VersionPick,):
    let ordered = sortVersionTexts(candidates)
    var effective: Array<Constraint> = []
    var i = 0
    while i < len(constraints):
        let parsed = parseConstraint(constraints[i])
        if !parsed.ok:
            return VersionPick()
        if len(parsed.atoms) > 0:
            effective = effective.append(parsed)
        i = i + 1
    if len(ordered) == 0:
        return VersionPick()
    if len(effective) == 0:
        return makeVersionPick(ordered[len(ordered) - 1])
    var j = 0
    while j < len(ordered):
        let parts = versionParts(ordered[j])
        if satisfiesAll(effective, parts):
            return makeVersionPick(ordered[j])
        j = j + 1
    return VersionPick()

; 选中结果：ok 置真，版本填好。
makeVersionPick|func(_version: String,) -> (VersionPick,):
    var out = VersionPick()
    out.version = _version
    out.ok = true
    return out

; 全部约束求值：任一不满足即答否。
satisfiesAll|func(_constraints: Array<Constraint>, _parts: Array<I32>,) -> (Bool,):
    var i = 0
    while i < len(_constraints):
        if !constraintSatisfies(_constraints[i], _parts):
            return false
        i = i + 1
    return true
