; 目标类别：库、可执行与测试；测试目标不进普通构建产物。
[TargetKind]
targetLibrary
targetExecutable
targetTest

; 目标声明：名字、类别与包根相对入口；入口是文件或目录。
(TargetSpec)
name: String = ""
kind: TargetKind = .targetLibrary
entry: String = ""

; FFI 配置：库绑定与宏求值的输入；abi 全局唯一，数组按清单顺序原样保留。
(FFIConfig)
abi: String = "C"
searchPaths: Array<String> = []
libs: Array<String> = []
headers: Array<String> = []
includePaths: Array<String> = []
defines: Array<String> = []

; 包清单：包名、包根相对路径、声明依赖、全部目标、构建排除项与 FFI 配置。
(PackageManifest)
name: String = ""
rootPath: String = ""
requires: Array<String> = []
targets: Array<TargetSpec> = []
excludes: Array<String> = []
ffi: FFIConfig = FFIConfig()

; 工作区清单：根路径、成员相对路径与构建 profile。
(WorkspaceManifest)
rootPath: String = ""
members: Array<String> = []
profile: String = "debug"

; 解析结果：清单与错误并列；构建脚本的步骤与路径随包一起交出。
(PackageParse)
manifest: PackageManifest = PackageManifest()
steps: Array<BuildStep> = []
scriptPath: String = ""
errors: Array<ManifestError> = []

; FFI 解析结果：配置与错误并列；错误非空时配置仍可读，建计划前会整体拦下。
(FFIParse)
config: FFIConfig = FFIConfig()
errors: Array<ManifestError> = []

(WorkspaceParse)
manifest: WorkspaceManifest = WorkspaceManifest()
errors: Array<ManifestError> = []

; 解析工作区清单：只认 [workspace] 的 members 与 profile；形状错误在 TOML 层已记账。
parseWorkspaceManifest|func(text: String, rootPath: String, path: String,) -> (WorkspaceParse,):
    var out = WorkspaceParse()
    let doc = parseToml(text = text, path = path)
    out.errors = doc.errors
    var manifest = WorkspaceManifest()
    manifest.rootPath = rootPath
    if !tomlHasTable(doc = doc, name = "workspace"):
        out.errors = out.errors.append(manifestError(kind = .errorTableMissing, path = path, detail = "workspace"))
        out.manifest = manifest
        return out
    manifest.members = tomlArray(doc = doc, table = "workspace", key = "members")
    if len(manifest.members) == 0:
        out.errors = out.errors.append(manifestError(kind = .errorMembersEmpty, path = path, detail = "members"))
    let profile = tomlValue(doc = doc, table = "workspace", key = "profile")
    if len(profile) == 0:
        manifest.profile = "debug"
    elif isPathComponent(profile):
        manifest.profile = profile
    else:
        out.errors = out.errors.append(manifestError(kind = .errorProfileInvalid, path = path, detail = profile))
    out.manifest = manifest
    return out

; 解析包清单：包名、依赖键与三类 target；名字与入口的规则在这里一次判完。
parsePackageManifest|func(text: String, rootPath: String, path: String,) -> (PackageParse,):
    var out = PackageParse()
    let doc = parseToml(text = text, path = path)
    out.errors = doc.errors
    var manifest = PackageManifest()
    manifest.rootPath = rootPath
    if !tomlHasTable(doc = doc, name = "package"):
        out.errors = out.errors.append(manifestError(kind = .errorTableMissing, path = path, detail = "package"))
        out.manifest = manifest
        return out
    manifest.name = tomlValue(doc = doc, table = "package", key = "name")
    if len(manifest.name) == 0:
        out.errors = out.errors.append(manifestError(kind = .errorPackageName, path = path, detail = "缺 name"))
    elif !isPathComponent(manifest.name):
        out.errors = out.errors.append(manifestError(kind = .errorPackageName, path = path, detail = manifest.name))
    manifest.requires = tomlKeys(doc = doc, table = "require")
    manifest.targets = collectTargets(doc)
    manifest.excludes = tomlArray(doc = doc, table = "build", key = "exclude")
    let ffi = parseFFIConfig(doc = doc, path = path, errors = out.errors)
    manifest.ffi = ffi.config
    out.errors = checkTargets(manifest = manifest, path = path, errors = ffi.errors)
    out.manifest = manifest
    return out

; 解析 [ffi]：缺表即全默认；abi 只认 C，库名不得带 -l，坏值逐条记账。
parseFFIConfig|func(doc: TomlDocument, path: String, errors: Array<ManifestError>,) -> (FFIParse,):
    var out = FFIParse()
    out.errors = errors
    if !tomlHasTable(doc = doc, name = "ffi"):
        return out
    var config = FFIConfig()
    let abiAt = findEntry(doc = doc, table = "ffi", row = -1, key = "abi")
    if abiAt >= 0:
        let abi = doc.entries[abiAt].value
        if abi == "C":
            config.abi = abi
        else:
            out.errors = out.errors.append(manifestError(kind = .errorFFIABI, path = path, detail = abi))
    config.searchPaths = tomlArray(doc = doc, table = "ffi", key = "search_paths")
    config.libs = tomlArray(doc = doc, table = "ffi", key = "libs")
    config.headers = tomlArray(doc = doc, table = "ffi", key = "headers")
    config.includePaths = tomlArray(doc = doc, table = "ffi", key = "include_paths")
    config.defines = tomlArray(doc = doc, table = "ffi", key = "defines")
    out.errors = checkFFILibs(libs = config.libs, path = path, errors = out.errors)
    out.config = config
    return out

; 库名判定：名字不带 -l，带前缀即报错，避免链接参数拼成 -l-lfoo。
checkFFILibs|func(libs: Array<String>, path: String, errors: Array<ManifestError>,) -> (Array<ManifestError>,):
    var out = errors
    var i = 0
    while i < len(libs):
        if startsWith(text = libs[i], prefix = "-l"):
            out = out.append(manifestError(kind = .errorFFILibrary, path = path, detail = libs[i]))
        i = i + 1
    return out

; 收集三类 target：[lib] 至多一个，[[bin]] 与 [[test]] 按行展开。
collectTargets|func(_doc: TomlDocument,) -> (Array<TargetSpec>,):
    var out: Array<TargetSpec> = []
    if tomlHasTable(doc = _doc, name = "lib"):
        var target = TargetSpec()
        target.kind = .targetLibrary
        target.name = tomlValue(doc = _doc, table = "lib", key = "name")
        target.entry = tomlValue(doc = _doc, table = "lib", key = "entry")
        out = out.append(target)
    out = appendRows(doc = _doc, table = "bin", kind = .targetExecutable, out = out)
    out = appendRows(doc = _doc, table = "test", kind = .targetTest, out = out)
    return out

; 数组表按行展开成 target，行序即清单里的出现顺序。
appendRows|func(doc: TomlDocument, table: String, kind: TargetKind, out: Array<TargetSpec>,) -> (Array<TargetSpec>,):
    var result = out
    let rows = tomlRowCount(doc = doc, table = table)
    var row = 0
    while row < rows:
        var target = TargetSpec()
        target.kind = kind
        target.name = tomlRowValue(doc = doc, table = table, row = row, key = "name")
        target.entry = tomlRowValue(doc = doc, table = table, row = row, key = "entry")
        result = result.append(target)
        row = row + 1
    return result

; 目标校验：至少一个 target，逐个查名字、入口与重名；一条 target 只报首个问题。
checkTargets|func(manifest: PackageManifest, path: String, errors: Array<ManifestError>,) -> (Array<ManifestError>,):
    var out = errors
    if len(manifest.targets) == 0:
        out = out.append(manifestError(kind = .errorMissingTargets, path = path, detail = manifest.name))
        return out
    var i = 0
    while i < len(manifest.targets):
        let target = manifest.targets[i]
        if len(target.name) == 0:
            out = out.append(manifestError(kind = .errorTargetName, path = path, detail = manifest.name + "：" + targetKindName(target.kind) + " 缺 name"))
        elif !isPathComponent(target.name):
            out = out.append(manifestError(kind = .errorTargetName, path = path, detail = target.name))
        elif !isCleanEntry(target.entry):
            out = out.append(manifestError(kind = .errorEntryPath, path = path, detail = target.name + "：" + target.entry))
        elif hasEarlierTarget(targets = manifest.targets, at = i, name = target.name):
            out = out.append(manifestError(kind = .errorDuplicateTarget, path = path, detail = manifest.name + "/" + target.name))
        i = i + 1
    return out

; 重名判定只看名字：同一包内 lib 与 bin 同名同样会撞产物。
hasEarlierTarget|func(targets: Array<TargetSpec>, at: I32, name: String,) -> (Bool,):
    var i = 0
    while i < at:
        if targets[i].name == name:
            return true
        i = i + 1
    return false

; 目标类别的清单拼写：诊断与计划文本共用。
targetKindName|func(_kind: TargetKind,) -> (String,):
    match _kind:
        case targetLibrary:
            return "lib"
        case targetExecutable:
            return "bin"
        case targetTest:
            return "test"
    return "lib"

; 同类别判定：枚举相等比较不可用，按名称比。
isTargetKind|func(kind: TargetKind, expected: TargetKind,) -> (Bool,):
    return targetKindName(kind) == targetKindName(expected)
