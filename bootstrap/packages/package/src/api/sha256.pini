; SHA-256（FIPS 180-4）：32 位无符号在 I64 上承载，每次加法与左移后按 2^32 截断。
; 计划文件的脚本哈希与输入指纹走这里，与宿主同一算法，两边写出的计划互认。

; 掩码：32 位无符号的上界；加、左移之后都要过一遍。
shaMask|func() -> (I64,):
    return hexWord(text = "FFFFFFFF")

; 十六进制字：八位进制数按 I64 累加；常量表用它绕开超界的十进制字面量。
hexWord|func(text: String,) -> (I64,):
    let pieces = chars(text)
    var out: I64 = 0
    var i = 0
    while i < len(pieces):
        let code = ord(pieces[i])
        var digit: I64 = 0
        if code >= 48 && code <= 57:
            digit = (code - 48) as I64
        elif code >= 65 && code <= 70:
            digit = (code - 55) as I64
        elif code >= 97 && code <= 102:
            digit = (code - 87) as I64
        out = out * 16 as I64 + digit
        i = i + 1
    return out

; 文本哈希：先取 UTF-8 字节，再走字节版。
sha256Hex|func(_text: String,) -> (String,):
    return sha256HexOfBytes(tempUtf8Bytes(_text))

; 字节哈希：补位、分块、压缩、小写十六进制，四步各自独立。
sha256HexOfBytes|func(_bytes: Array<U8>,) -> (String,):
    let padded = shaPad(bytes = _bytes)
    let k = shaConstants()
    var state: Array<I64> = []
    state = state.append(hexWord(text = "6A09E667"))
    state = state.append(hexWord(text = "BB67AE85"))
    state = state.append(hexWord(text = "3C6EF372"))
    state = state.append(hexWord(text = "A54FF53A"))
    state = state.append(hexWord(text = "510E527F"))
    state = state.append(hexWord(text = "9B05688C"))
    state = state.append(hexWord(text = "1F83D9AB"))
    state = state.append(hexWord(text = "5BE0CD19"))
    var offset = 0
    while offset < len(padded):
        state = shaCompress(state = state, w = shaSchedule(bytes = padded, offset = offset), k = k)
        offset = offset + 64
    return shaHexOf(state = state)

; 补位：先补 0x80，再补零到 56 (mod 64)，最后写八字节大端位长。
shaPad|func(bytes: Array<U8>,) -> (Array<U8>,):
    var out = bytes
    out = out.append(tempIntToByte(128))
    while len(out) % 64 != 56:
        out = out.append(tempIntToByte(0))
    let bits = len(bytes) as I64 * 8 as I64
    var shift = 56
    while shift >= 0:
        out = out.append(tempIntToByte((bits >> shift as I64 & 255 as I64) as I32))
        shift = shift - 8
    return out

; 消息扩展：前十六字按大端取，其余按 σ0 / σ1 递推。
shaSchedule|func(bytes: Array<U8>, offset: I32,) -> (Array<I64>,):
    var w: Array<I64> = []
    var i = 0
    while i < 16:
        let at = offset + i * 4
        var word: I64 = 0
        word = word * 256 as I64 + tempByteToInt(bytes[at]) as I64
        word = word * 256 as I64 + tempByteToInt(bytes[at + 1]) as I64
        word = word * 256 as I64 + tempByteToInt(bytes[at + 2]) as I64
        word = word * 256 as I64 + tempByteToInt(bytes[at + 3]) as I64
        w = w.append(word)
        i = i + 1
    while i < 64:
        let x = w[i - 15]
        let y = w[i - 2]
        let s0 = shaRotr(x = x, n = 7) ^ shaRotr(x = x, n = 18) ^ (x >> 3 as I64)
        let s1 = shaRotr(x = y, n = 17) ^ shaRotr(x = y, n = 19) ^ (y >> 10 as I64)
        w = w.append(shaAdd(shaAdd(shaAdd(w[i - 16], s0), w[i - 7]), s1))
        i = i + 1
    return w

; 压缩：八变量轮转，六十四轮；每轮两式相加后再截断到 32 位。
shaCompress|func(state: Array<I64>, w: Array<I64>, k: Array<I64>,) -> (Array<I64>,):
    var a = state[0]
    var b = state[1]
    var c = state[2]
    var d = state[3]
    var e = state[4]
    var f = state[5]
    var g = state[6]
    var h = state[7]
    var i = 0
    while i < 64:
        let s1 = shaRotr(x = e, n = 6) ^ shaRotr(x = e, n = 11) ^ shaRotr(x = e, n = 25)
        let ch = e & f ^ (shaNot(e) & g)
        let t1 = shaAdd(shaAdd(shaAdd(shaAdd(h, s1), ch), k[i]), w[i])
        let s0 = shaRotr(x = a, n = 2) ^ shaRotr(x = a, n = 13) ^ shaRotr(x = a, n = 22)
        let maj = a & b ^ (a & c) ^ (b & c)
        let t2 = shaAdd(s0, maj)
        h = g
        g = f
        f = e
        e = shaAdd(d, t1)
        d = c
        c = b
        b = a
        a = shaAdd(t1, t2)
        i = i + 1
    var out = state
    out[0] = shaAdd(state[0], a)
    out[1] = shaAdd(state[1], b)
    out[2] = shaAdd(state[2], c)
    out[3] = shaAdd(state[3], d)
    out[4] = shaAdd(state[4], e)
    out[5] = shaAdd(state[5], f)
    out[6] = shaAdd(state[6], g)
    out[7] = shaAdd(state[7], h)
    return out

; 输出：八个字各出八位小写十六进制，顺序即摘要字节序。
shaHexOf|func(state: Array<I64>,) -> (String,):
    var text = ""
    var i = 0
    while i < len(state):
        var shift = 28
        while shift >= 0:
            text = text + shaHexDigit(value = state[i] >> shift as I64 & 15 as I64)
            shift = shift - 4
        i = i + 1
    return text

; 十六进制位：0 到 9 走数字，10 到 15 走小写字母。
shaHexDigit|func(value: I64,) -> (String,):
    if value < 10 as I64:
        return "\(chr(48 + value as I32))"
    return "\(chr(87 + value as I32))"

; 循环右移：右移按逻辑取，左移靠乘 2^n 再截断，避免依赖有符号移位。
shaRotr|func(x: I64, n: I32,) -> (I64,):
    let right = x >> n as I64
    let left = x * shaPow2(n = 32 - n) & shaMask()
    return right | left & shaMask()

; 2 的幂：n 在 0 到 31 之间，逐个乘二即可，不依赖移位。
shaPow2|func(n: I32,) -> (I64,):
    var out: I64 = 1
    var i = 0
    while i < n:
        out = out * 2 as I64
        i = i + 1
    return out

; 三十二位加法：超出上界由掩码截断，等价于模 2^32。
shaAdd|func(_x: I64, _y: I64,) -> (I64,):
    return _x + _y & shaMask()

; 按位取反：与上界异或即得三十二位反码。
shaNot|func(_x: I64,) -> (I64,):
    return _x ^ shaMask()

; 轮常量：FIPS 180-4 的六十四项，按前六十四位素数立方根取前 32 位。
shaConstants|func() -> (Array<I64>,):
    var out: Array<I64> = []
    out = out.append(hexWord(text = "428A2F98"))
    out = out.append(hexWord(text = "71374491"))
    out = out.append(hexWord(text = "B5C0FBCF"))
    out = out.append(hexWord(text = "E9B5DBA5"))
    out = out.append(hexWord(text = "3956C25B"))
    out = out.append(hexWord(text = "59F111F1"))
    out = out.append(hexWord(text = "923F82A4"))
    out = out.append(hexWord(text = "AB1C5ED5"))
