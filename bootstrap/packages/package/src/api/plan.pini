; 目标计划：名字、类别、入口、源码根与三类产物路径；测试目标不进默认构建。
(TargetPlan)
name: String = ""
kind: TargetKind = .targetLibrary
entry: String = ""
sourceRoot: String = ""
irPath: String = ""
interfacePath: String = ""
executablePath: String = ""
isBuiltByDefault: Bool = true

; 包计划：包名、包根相对路径、声明依赖、构建排除项、FFI 配置、翻译步与按清单顺序排好的 target。
(PackagePlan)
name: String = ""
rootPath: String = ""
requires: Array<String> = []
targets: Array<TargetPlan> = []
excludes: Array<String> = []
ffi: FFIConfig = FFIConfig()
scriptPath: String = ""
scriptHash: String = ""
steps: Array<BuildStep> = []

; 构建计划：根、profile、拓扑序上的包与全部错误；错误非空时 packages 为空。
(BuildPlan)
rootPath: String = ""
profile: String = "debug"
packages: Array<PackagePlan> = []
errors: Array<ManifestError> = []

; 计划是否可用：有错即不可用，调用方不得拿它去建产物。
((BuildPlan))
isOK|self() -> (Bool,):
    return len(self.errors) == 0
errorCount|self() -> (I32,):
    return len(self.errors)
errorAt|self(_index: I32,) -> (ManifestError,):
    return self.errors[_index]
packageCount|self() -> (I32,):
    return len(self.packages)
packageAt|self(_index: I32,) -> (PackagePlan,):
    return self.packages[_index]

; 计划文本：包与 target 按拓扑序逐行铺开，错误在前；同一计划两次渲染逐字相同。
planText|func(_plan: BuildPlan,) -> (String,):
    var text = "root=" + _plan.rootPath + " profile=" + _plan.profile + "\n"
    var i = 0
    while i < len(_plan.errors):
        text = text + "error " + manifestErrorText(_plan.errors[i]) + "\n"
        i = i + 1
    i = 0
    while i < len(_plan.packages):
        let pkg = _plan.packages[i]
        text = text + "package " + pkg.name + " @ " + pkg.rootPath + "\n"
        var t = 0
        while t < len(pkg.targets):
            let target = pkg.targets[t]
            text = text + "  " + targetKindName(target.kind) + " " + target.name
            text = text + " src=" + target.sourceRoot + " entry=" + target.entry
            text = text + " ir=" + target.irPath + "\n"
            if len(target.executablePath) > 0:
                text = text + "  exe " + target.executablePath + "\n"
            t = t + 1
        var s = 0
        while s < len(pkg.steps):
            let one = pkg.steps[s]
            var line = "  step " + one.name + " header=" + one.headerPath
            if len(one.includePaths) > 0:
                line = line + " include=" + joinPlanArray(one.includePaths)
            if len(one.defines) > 0:
                line = line + " defs=" + joinPlanArray(one.defines)
            text = text + line + " out=" + one.outputPath + "\n"
            s = s + 1
        text = text + ffiPlanText(pkg.ffi)
        i = i + 1
    return text

; FFI 计划行：全默认时不占行；字段序与参考件的表一致，数组按清单顺序逗号连接。
ffiPlanText|func(_ffi: FFIConfig,) -> (String,):
    if _ffi.abi == "C" && len(_ffi.searchPaths) == 0 && len(_ffi.libs) == 0:
        if len(_ffi.headers) == 0 && len(_ffi.includePaths) == 0 && len(_ffi.defines) == 0:
            return ""
    var text = "  ffi abi=" + _ffi.abi
    if len(_ffi.searchPaths) > 0:
        text = text + " search_paths=" + joinPlanArray(_ffi.searchPaths)
    if len(_ffi.libs) > 0:
        text = text + " libs=" + joinPlanArray(_ffi.libs)
    if len(_ffi.headers) > 0:
        text = text + " headers=" + joinPlanArray(_ffi.headers)
    if len(_ffi.includePaths) > 0:
        text = text + " include_paths=" + joinPlanArray(_ffi.includePaths)
    if len(_ffi.defines) > 0:
        text = text + " defines=" + joinPlanArray(_ffi.defines)
    return text + "\n"

; 逗号连接：按给定顺序拼接，空数组答空串。
joinPlanArray|func(_items: Array<String>,) -> (String,):
    var text = ""
    var i = 0
    while i < len(_items):
        if i > 0:
            text = text + ","
        text = text + _items[i]
        i = i + 1
    return text

; 装配计划：先规范化成员，再查重名与产物冲突，最后按依赖排序并生成路径。
; 任一错误都让计划不带包返回——半张计划比报错更危险。
assemblePlan|func(workspace: WorkspaceParse, parses: Array<PackageParse>,) -> (BuildPlan,):
    var plan = BuildPlan()
    plan.rootPath = workspace.manifest.rootPath
    plan.profile = workspace.manifest.profile
    plan.errors = workspace.errors
    var packages: Array<PackageManifest> = []
    var members: Array<String> = []
    var i = 0
    while i < len(workspace.manifest.members):
        let raw = workspace.manifest.members[i]
        i = i + 1
        let norm = normalizeMemberPath(raw)
        if !norm.ok:
            plan.errors = plan.errors.append(manifestError(kind = .errorMemberPath, path = plan.rootPath, detail = raw + "：" + norm.reason))
            continue
        if _containsPlanText(items = members, value = norm.value):
            plan.errors = plan.errors.append(manifestError(kind = .errorMemberDuplicated, path = plan.rootPath, detail = norm.value))
            continue
        members = members.append(norm.value)
        let at = findParse(parses = parses, rootPath = norm.value)
        if at < 0:
            plan.errors = plan.errors.append(manifestError(kind = .errorManifestMissing, path = plan.rootPath, detail = norm.value))
            continue
        plan.errors = appendErrors(errors = plan.errors, extra = parses[at].errors)
        packages = packages.append(parses[at].manifest)
    i = 0
    while i < len(packages):
        if hasEarlierPackage(packages = packages, at = i, name = packages[i].name):
            plan.errors = plan.errors.append(manifestError(kind = .errorDuplicatePackage, path = plan.rootPath, detail = packages[i].name))
        i = i + 1
    plan.errors = checkExecutableNames(packages = packages, rootPath = plan.rootPath, errors = plan.errors)
    let topo = topoOrder(packages = packages, rootPath = plan.rootPath, errors = plan.errors)
    plan.errors = topo.errors
    if len(plan.errors) > 0:
        return plan
    i = 0
    while i < len(topo.order):
        let at = findPackage(packages = packages, name = topo.order[i])
        let parsed = findParse(parses = parses, rootPath = packages[at].rootPath)
        var steps: Array<BuildStep> = []
        var scriptPath = ""
        var scriptHash = ""
        if parsed >= 0:
            steps = parses[parsed].steps
            scriptPath = parses[parsed].scriptPath
            scriptHash = parses[parsed].scriptHash
        plan.packages = plan.packages.append(packagePlan(pkg = packages[at], root = plan.rootPath, profile = plan.profile, steps = steps, scriptPath = scriptPath, scriptHash = scriptHash))
        i = i + 1
    return plan

; 读盘入口：根清单与每个成员的清单各读一次，随后交给纯装配。
; 成员路径先规范化再拼路径，越界成员在读盘之前就被挡下。
planWorkspace|func(_root: String,) -> (BuildPlan,):
    let rootManifest = _root + "/pini.toml"
    if !exists(rootManifest):
        var plan = BuildPlan()
        plan.rootPath = _root
        plan.errors = plan.errors.append(manifestError(kind = .errorManifestMissing, path = rootManifest, detail = "pini.toml"))
        return plan
    let workspace = parseWorkspaceManifest(text = readFile(rootManifest), rootPath = _root, path = rootManifest)
    var parses: Array<PackageParse> = []
    var i = 0
    while i < len(workspace.manifest.members):
        let norm = normalizeMemberPath(workspace.manifest.members[i])
        i = i + 1
        if !norm.ok:
            continue
        let memberManifest = _root + "/" + norm.value + "/pini.toml"
        if !exists(memberManifest):
            var missing = PackageParse()
            missing.manifest.rootPath = norm.value
            missing.errors = missing.errors.append(manifestError(kind = .errorManifestMissing, path = memberManifest, detail = norm.value))
            parses = parses.append(missing)
            continue
        var parse = parsePackageManifest(text = readFile(memberManifest), rootPath = norm.value, path = memberManifest)
        let script = readBuildScript(packageAbs = _root + "/" + norm.value)
        parse.steps = script.steps
        parse.scriptPath = script.path
        parse.scriptHash = script.hash
        parse.errors = appendErrors(errors = parse.errors, extra = script.errors)
        parses = parses.append(parse)
    return assemblePlan(workspace = workspace, parses = parses)

; 隐式模块：裸包根没声明 target 时，整目录的 .pini 就是一个库；只在入口通道收下。
; 工作区成员仍按规范要求显式 target，这条宽松只对「直接进包目录」生效。
acceptImplicitModule|func(parse: PackageParse,) -> (PackageParse,):
    if len(parse.errors) == 0:
        return parse
    var i = 0
    while i < len(parse.errors):
        if !isErrorKind(e = parse.errors[i], kind = .errorMissingTargets):
            return parse
        i = i + 1
    var out = parse
    var 空表: Array<ManifestError> = []
    out.errors = 空表
    var target = TargetSpec()
    target.kind = .targetLibrary
    target.name = parse.manifest.name
    out.manifest.targets = out.manifest.targets.append(target)
    return out

; 裸包计划：入口清单只有 [package] 时按单成员装配，成员即根；包根记 "."，路径拼接各处同形。
; 与宿主同口径：`check <包目录>` 与 `check <工作区根>` 都成立，源码不复制不搬动。
planPackageRoot|func(entry: String,) -> (BuildPlan,):
    let path = entry + "/pini.toml"
    if !exists(path):
        var plan = BuildPlan()
        plan.rootPath = entry
        plan.errors = plan.errors.append(manifestError(kind = .errorManifestMissing, path = path, detail = "pini.toml"))
        return plan
    return planFromPackage(entry = entry, parse = parsePackageManifest(text = readFile(path), rootPath = ".", path = path))

; 单包装配：构建脚本并入步骤与错误，隐式模块在此收下，再按 profile 出计划。
planFromPackage|func(entry: String, parse: PackageParse,) -> (BuildPlan,):
    var plan = BuildPlan()
    plan.rootPath = entry
    var 收下 = parse
    let script = readBuildScript(packageAbs = entry)
    收下.steps = script.steps
    收下.scriptPath = script.path
    收下.scriptHash = script.hash
    收下.errors = appendErrors(errors = 收下.errors, extra = script.errors)
    收下 = acceptImplicitModule(parse = 收下)
    plan.errors = 收下.errors
    if len(收下.errors) > 0:
        return plan
    let pkg = packagePlan(pkg = 收下.manifest, root = entry, profile = plan.profile, steps = 收下.steps, scriptPath = 收下.scriptPath, scriptHash = 收下.scriptHash)
    plan.packages = plan.packages.append(pkg)
    return plan

; 上级目录：最后一个斜杠之前的部分；无斜杠答空串。
parentDirOf|func(_path: String,) -> (String,):
    var at = -1
    var i = 0
    while i < len(_path):
        if _path[i] == "/":
            at = i
        i = i + 1
    if at <= 0:
        return ""
    return _path.substring(0, at)

; 外层工作区：从入口的上级开始向上找第一份带 [workspace] 的清单，最多八层；找不到答空串。
enclosingWorkspace|func(entry: String,) -> (String,):
    var dir = parentDirOf(entry)
    var depth = 0
    while depth < 8 && len(dir) > 0:
        if exists(dir + "/pini.toml") && hasWorkspace(dir):
            return dir
        dir = parentDirOf(dir)
        depth = depth + 1
    return ""

; 依赖闭包：从入口包沿 requires 逐层收，外包计划按拓扑序只留这些包。
; 入口不在成员表时答空计划，调用方据此回落到裸包通道。
closurePlan|func(workspace: String, entryName: String,) -> (BuildPlan,):
    let full = planWorkspace(workspace)
    if !full.isOK():
        return BuildPlan()
    var keep: Array<String> = [entryName]
    var 有入口 = false
    var cursor = 0
    while cursor < len(keep):
        let name = keep[cursor]
        var i = 0
        while i < len(full.packages):
            if full.packages[i].name == name:
                if name == entryName:
                    有入口 = true
                var r = 0
                while r < len(full.packages[i].requires):
                    let dep = full.packages[i].requires[r]
                    if !_containsPlanText(items = keep, value = dep):
                        keep = keep.append(dep)
                    r = r + 1
            i = i + 1
        cursor = cursor + 1
    if !有入口:
        return BuildPlan()
    var out = full
    var kept: Array<PackagePlan> = []
    var p = 0
    while p < len(full.packages):
        if _containsPlanText(items = keep, value = full.packages[p].name):
            kept = kept.append(full.packages[p])
        p = p + 1
    out.packages = kept
    return out

; 入口计划：工作区根按工作区装配；包目录先按外层工作区取依赖闭包，取不到再按裸包。
planEntry|func(_entry: String,) -> (BuildPlan,):
    let path = _entry + "/pini.toml"
    if !exists(path):
        return planPackageRoot(entry = _entry)
    if hasWorkspace(_entry):
        return planWorkspace(_entry)
    let parse = parsePackageManifest(text = readFile(path), rootPath = ".", path = path)
    let outer = enclosingWorkspace(entry = _entry)
    if len(outer) > 0 && len(parse.manifest.name) > 0:
        let 闭包 = closurePlan(workspace = outer, entryName = parse.manifest.name)
        if 闭包.packageCount() > 0:
            return 闭包
    return planFromPackage(entry = _entry, parse = parse)

; 单包计划：产物目录按 profile 定；翻译步落在包内的 generated 目录，测试目标不默认构建。
packagePlan|func(pkg: PackageManifest, root: String, profile: String, steps: Array<BuildStep>, scriptPath: String, scriptHash: String,) -> (PackagePlan,):
    var out = PackagePlan()
    out.name = pkg.name
    out.rootPath = pkg.rootPath
    out.requires = pkg.requires
    out.excludes = pkg.excludes
    out.ffi = pkg.ffi
    out.scriptPath = scriptPath
    out.scriptHash = scriptHash
    var s = 0
    while s < len(steps):
        var one = steps[s]
        one.outputPath = ".build/" + profile + "/packages/" + pkg.name + "/generated/" + one.name + ".pini"
        out.steps = out.steps.append(one)
        s = s + 1
    let buildDir = root + "/.build/" + profile + "/packages/" + pkg.name
    var i = 0
    while i < len(pkg.targets):
        let target = pkg.targets[i]
        var plan = TargetPlan()
        plan.name = target.name
        plan.kind = target.kind
        plan.entry = target.entry
        plan.sourceRoot = sourceRootOf(target)
        plan.irPath = buildDir + "/" + target.name + ".ll"
        plan.interfacePath = buildDir + "/interface.txt"
        if isTargetKind(kind = target.kind, expected = .targetExecutable):
            plan.executablePath = root + "/.build/" + profile + "/bin/" + target.name
        plan.isBuiltByDefault = !isTargetKind(kind = target.kind, expected = .targetTest)
        out.targets = out.targets.append(plan)
        i = i + 1
    return out

; 源码根：库与可执行从 src 取生产源码，测试目标从入口目录取；扫描规则归装载面。
; 库目标入口为空＝隐式多文件模块，源码根是包根，整目录的 .pini 同属一个库。
sourceRootOf|func(_target: TargetSpec,) -> (String,):
    if isTargetKind(kind = _target.kind, expected = .targetTest):
        return _target.entry
    if len(_target.entry) == 0:
        return ""
    return "src"

; 测试目标判定：测试目标不进普通构建产物，装载面据此决定是否并入测试源码。
isTestTarget|func(_target: TargetPlan,) -> (Bool,):
    return isTargetKind(kind = _target.kind, expected = .targetTest)

; 可执行产物名在工作区内唯一：跨包同名会让两份产物落到同一个 bin 路径。
checkExecutableNames|func(packages: Array<PackageManifest>, rootPath: String, errors: Array<ManifestError>,) -> (Array<ManifestError>,):
    var out = errors
    var seen: Array<String> = []
    var i = 0
    while i < len(packages):
        let pkg = packages[i]
        var t = 0
        while t < len(pkg.targets):
            let target = pkg.targets[t]
            if isTargetKind(kind = target.kind, expected = .targetExecutable):
                if _containsPlanText(items = seen, value = target.name):
                    out = out.append(manifestError(kind = .errorExecutableCollision, path = rootPath, detail = target.name + " @ " + pkg.name))
                else:
                    seen = seen.append(target.name)
            t = t + 1
        i = i + 1
    return out

; 拓扑序：根按包名升序深度优先，依赖同样升序；后序追加即依赖先于使用方。
(TopoFrame)
name: String = ""
deps: Array<String> = []
next: I32 = 0

(TopoResult)
order: Array<String> = []
errors: Array<ManifestError> = []

; 深度优先用具名帧而不是递归调用：帧里带依赖表与游标，回溯时不必重算。
topoOrder|func(packages: Array<PackageManifest>, rootPath: String, errors: Array<ManifestError>,) -> (TopoResult,):
    var out = TopoResult()
    out.errors = errors
    let names = sortedPackageNames(packages)
    var state: Array<I32> = []
    var i = 0
    while i < len(packages):
        state = state.append(0)
        i = i + 1
    var frames: Array<TopoFrame> = []
    var depth = 0
    var n = 0
    while n < len(names):
        let start = findPackage(packages = packages, name = names[n])
        n = n + 1
        if state[start] == 2:
            continue
        state[start] = 1
        var frame = TopoFrame()
        frame.name = names[n - 1]
        frame.deps = sortedRequires(packages = packages, requires = packages[start].requires)
        frames = pushFrame(frames = frames, depth = depth, frame = frame)
        depth = depth + 1
        while depth > 0:
            let at = depth - 1
            var top = frames[at]
            if top.next < len(top.deps):
                let dep = top.deps[top.next]
                top.next = top.next + 1
                frames[at] = top
                let found = findPackage(packages = packages, name = dep)
                if found < 0:
                    continue
                if state[found] == 2:
                    continue
                if state[found] == 1:
                    out.errors = out.errors.append(manifestError(kind = .errorDependencyCycle, path = rootPath, detail = cycleChain(frames = frames, depth = depth, dep = dep)))
                    return out
                state[found] = 1
                var child = TopoFrame()
                child.name = dep
                child.deps = sortedRequires(packages = packages, requires = packages[found].requires)
                frames = pushFrame(frames = frames, depth = depth, frame = child)
                depth = depth + 1
            else:
                let done = findPackage(packages = packages, name = top.name)
                state[done] = 2
                out.order = out.order.append(top.name)
                depth = depth - 1
    return out

; 压帧：槽位复用，避免弹出后数组无限增长。
pushFrame|func(frames: Array<TopoFrame>, depth: I32, frame: TopoFrame,) -> (Array<TopoFrame>,):
    if depth < len(frames):
        frames[depth] = frame
        return frames
    return frames.append(frame)

; 环链：从栈里首次出现的重复名为起点，按栈序拼到当前依赖。
cycleChain|func(frames: Array<TopoFrame>, depth: I32, dep: String,) -> (String,):
    var start = 0
    var i = 0
    while i < depth:
        if frames[i].name == dep:
            start = i
            break
        i = i + 1
    var text = ""
    i = start
    while i < depth:
        text = text + frames[i].name + " -> "
        i = i + 1
    return text + dep

; 依赖表：只留工作区内的包名，去重后升序；外部依赖不进本地图。
sortedRequires|func(packages: Array<PackageManifest>, requires: Array<String>,) -> (Array<String>,):
    var kept: Array<String> = []
    var i = 0
    while i < len(requires):
        if findPackage(packages = packages, name = requires[i]) >= 0 && !_containsPlanText(items = kept, value = requires[i]):
            kept = kept.append(requires[i])
        i = i + 1
    return sortedTexts(kept)

; 包名升序：深度优先的根顺序由它定，重复执行结果不变。
sortedPackageNames|func(_packages: Array<PackageManifest>,) -> (Array<String>,):
    var names: Array<String> = []
    var i = 0
    while i < len(_packages):
        names = names.append(_packages[i].name)
        i = i + 1
    return sortedTexts(names)

; 字符串升序：按 UTF-8 字节比较，与平台 locale 无关。
sortedTexts|func(_items: Array<String>,) -> (Array<String>,):
    var out = _items
    var i = 1
    while i < len(out):
        let value = out[i]
        var j = i - 1
        while j >= 0 && comparePlanText(a = out[j], b = value) > 0:
            out[j + 1] = out[j]
            j = j - 1
        out[j + 1] = value
        i = i + 1
    return out

; 字节序比较：先比公共前缀，再比长度；返回 -1 / 0 / 1。
comparePlanText|func(a: String, b: String,) -> (I32,):
    let left = tempUtf8Bytes(a)
    let right = tempUtf8Bytes(b)
    var i = 0
    while i < len(left) && i < len(right):
        let x = tempByteToInt(left[i])
        let y = tempByteToInt(right[i])
        if x < y:
            return -1
        if x > y:
            return 1
        i = i + 1
    if len(left) < len(right):
        return -1
    if len(left) > len(right):
        return 1
    return 0

; 按名查包：未命中答 -1，依赖表与成员表共用这一处。
findPackage|func(packages: Array<PackageManifest>, name: String,) -> (I32,):
    var i = 0
    while i < len(packages):
        if packages[i].name == name:
            return i
        i = i + 1
    return -1

; 按包根查解析结果：成员路径与清单根路径必须逐字相同。
findParse|func(parses: Array<PackageParse>, rootPath: String,) -> (I32,):
    var i = 0
    while i < len(parses):
        if parses[i].manifest.rootPath == rootPath:
            return i
        i = i + 1
    return -1

; 同名包判定：只看更早的条目，重复名报一次即可。
hasEarlierPackage|func(packages: Array<PackageManifest>, at: I32, name: String,) -> (Bool,):
    var i = 0
    while i < at:
        if packages[i].name == name:
            return true
        i = i + 1
    return false

; 串表查找：名字与路径去重共用。
_containsPlanText|func(items: Array<String>, value: String,) -> (Bool,):
    var i = 0
    while i < len(items):
        if items[i] == value:
            return true
        i = i + 1
    return false

; 错误表拼接：解析阶段的错误按成员顺序并入计划。
appendErrors|func(errors: Array<ManifestError>, extra: Array<ManifestError>,) -> (Array<ManifestError>,):
    var out = errors
    var i = 0
    while i < len(extra):
        out = out.append(extra[i])
        i = i + 1
    return out

; 依赖分波：按依赖深度分层，空依赖落第 0 波，供外部步骤并行调度。
; 计划已按拓扑序排好，算某包时它的依赖必已算过，故一趟即可。
planWaveOf|func(_plan: BuildPlan,) -> (Array<I32>,):
    var out: Array<I32> = []
    var i = 0
    while i < len(_plan.packages):
        let one = _plan.packages[i]
        var depth = 0
        var r = 0
        while r < len(one.requires):
            let at = findPlanPackage(_plan, name = one.requires[r])
            if at >= 0 && out[at] + 1 > depth:
                depth = out[at] + 1
            r = r + 1
        out = out.append(depth)
        i = i + 1
    return out

; 计划内按包名查位：分波时用，缺项答 -1。
findPlanPackage|func(_plan: BuildPlan, name: String,) -> (I32,):
    var i = 0
    while i < len(_plan.packages):
        if _plan.packages[i].name == name:
            return i
        i = i + 1
    return -1
