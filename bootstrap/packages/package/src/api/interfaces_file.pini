; 接口记录：包名、快照路径、接口文本摘要与逐依赖摘要；记录只描述上次见过的接口。
; 渲染按包名升序，同一输入两次逐字节相同；读回不合法时不答条目，交给调用方当无记录处理。
(InterfaceDep)
name: String = ""
hash: String = ""

; 接口条目：包名、根相对快照路径、整份文本摘要、本包源码摘要与依赖接口摘要；
; 依赖为空表示不依赖别的包；源码摘要为空表示旧记录，调用方当未命中处理。
(InterfaceEntry)
name: String = ""
path: String = ""
hash: String = ""
source: String = ""
deps: Array<InterfaceDep> = []

; 接口记录：profile 与按包名排好的条目。
(InterfaceLedger)
profile: String = "debug"
entries: Array<InterfaceEntry> = []

; 记录版本：格式改了就升，旧记录读回按版本不符处理。
interfaceLedgerVersion|func() -> (I32,):
    return 2

; 记录路径：`<根>/.build/<profile>/interfaces.toml`。
interfacesFilePath|func(root: String, profile: String,) -> (String,):
    return root + "/.build/" + profile + "/interfaces.toml"

; 快照路径：`<根>/.build/<profile>/packages/<包>/interface.api.txt`，由 interfaces 子命令写。
interfaceArtifactPath|func(root: String, profile: String, name: String,) -> (String,):
    return root + "/.build/" + profile + "/packages/" + name + "/interface.api.txt"

; 依赖串：`名:摘要` 逗号分隔，顺序即依赖声明顺序；空表答空串。
depsText|func(deps: Array<InterfaceDep>,) -> (String,):
    var text = ""
    var i = 0
    while i < len(deps):
        if i > 0:
            text = text + ","
        text = text + deps[i].name + ":" + deps[i].hash
        i = i + 1
    return text

; 依赖串解析结果：解析出的依赖与不合法的项。
(DepParse)
deps: Array<InterfaceDep> = []
errors: Array<ManifestError> = []

; 依赖串解析：每项必须含一个冒号且两侧非空；坏项记一条错误并跳过，好项照收。
parseDeps|func(text: String, path: String, owner: String,) -> (DepParse,):
    var out = DepParse()
    if len(text) == 0:
        return out
    let parts = text.split(",")
    var i = 0
    while i < len(parts):
        let one = trimSpace(parts[i])
        let colon = one.indexOf(":")
        if colon <= 0 || colon + 1 >= len(one):
            out.errors = out.errors.append(manifestError(kind = .errorTomlShape, path = path, detail = "包 " + owner + " 的 deps 项不合法：" + one))
        else:
            var dep = InterfaceDep()
            dep.name = one.substring(0, colon)
            dep.hash = one.substring(colon + 1, len(one))
            out.deps = out.deps.append(dep)
        i = i + 1
    return out

; 排序：按包名字节序插入排序，输入顺序不影响输出。
sortEntries|func(entries: Array<InterfaceEntry>,) -> (Array<InterfaceEntry>,):
    var out = entries
    var i = 1
    while i < len(out):
        let value = out[i]
        var j = i - 1
        while j >= 0 && comparePlanText(a = out[j].name, b = value.name) > 0:
            out[j + 1] = out[j]
            j = j - 1
        out[j + 1] = value
        i = i + 1
    return out

; 渲染：头段一次、条目逐段；依赖串与路径都带引号，行序固定。
ledgerText|func(_ledger: InterfaceLedger,) -> (String,):
    var text = "[interfaces]\nversion = \(interfaceLedgerVersion())\nprofile = \"" + _ledger.profile + "\"\n"
    let entries = sortEntries(entries = _ledger.entries)
    var i = 0
    while i < len(entries):
        let one = entries[i]
        text = text + "\n[[interface]]\n"
        text = text + "package = \"" + one.name + "\"\n"
        text = text + "path = \"" + one.path + "\"\n"
        text = text + "hash = \"" + one.hash + "\"\n"
        text = text + "source = \"" + one.source + "\"\n"
        text = text + "deps = \"" + depsText(deps = one.deps) + "\"\n"
        i = i + 1
    return text

; 记录读取结果：profile、条目与不合法原因；errors 非空时条目表不可用。
(LedgerRead)
profile: String = "debug"
entries: Array<InterfaceEntry> = []
errors: Array<ManifestError> = []

; 按包名查条目：未命中答 -1。
findEntryName|func(entries: Array<InterfaceEntry>, name: String,) -> (I32,):
    var i = 0
    while i < len(entries):
        if entries[i].name == name:
            return i
        i = i + 1
    return -1

; 解析记录：版本不符或形状非法答不合法原因；重复包名与缺 package 各记一条。
parseLedger|func(text: String, path: String,) -> (LedgerRead,):
    var out = LedgerRead()
    let doc = parseToml(text = text, path = path)
    if len(doc.errors) > 0:
        out.errors = doc.errors
        return out
    out.profile = tomlValue(doc = doc, table = "interfaces", key = "profile")
    if tomlValue(doc = doc, table = "interfaces", key = "version") != "\(interfaceLedgerVersion())":
        out.errors = out.errors.append(manifestError(kind = .errorTomlShape, path = path, detail = "接口记录版本与当前不符"))
        return out
    var r = 0
    while r < tomlRowCount(doc = doc, table = "interface"):
        var one = InterfaceEntry()
        one.name = tomlRowValue(doc = doc, table = "interface", row = r, key = "package")
        one.path = tomlRowValue(doc = doc, table = "interface", row = r, key = "path")
        one.hash = tomlRowValue(doc = doc, table = "interface", row = r, key = "hash")
        one.source = tomlRowValue(doc = doc, table = "interface", row = r, key = "source")
        if len(one.name) == 0:
            out.errors = out.errors.append(manifestError(kind = .errorMissingKey, path = path, detail = "interface 条目缺 package"))
        elif findEntryName(entries = out.entries, name = one.name) >= 0:
            out.errors = out.errors.append(manifestError(kind = .errorDuplicateKey, path = path, detail = "接口记录里包名重复：" + one.name))
        else:
            let parsed = parseDeps(text = tomlRowValue(doc = doc, table = "interface", row = r, key = "deps"), path = path, owner = one.name)
            one.deps = parsed.deps
            out.errors = appendErrors(errors = out.errors, extra = parsed.errors)
            out.entries = out.entries.append(one)
        r = r + 1
    return out
