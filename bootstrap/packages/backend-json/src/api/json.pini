[json|import]
_semantics = "../../../semantics"
_ir = "../../../ir"
_backend_kit = "../../../backend-kit"

; 结构转储的 JSON 编码：字段名与出现次序照宿主 json 后端，语句体按先序平铺。
; 只读模块，不产目标码。与文本转储分工：那条给人读，这条给脚本读。
; 类型拼写走规范化文本，不照抄宿主侧的反射描述；detail 是自由文本，比对只认 kind 与 depth。

; 转义：只处理 JSON 必需的四个字节，其余原样；与宿主同一张表。
jsonEscape|func(text: String,) -> (String,):
    var out = ""
    var i = 0
    while i < len(text):
        let one = text[i]
        if ord(one) == 34:
            out = out + "\\\""
        elif ord(one) == 92:
            out = out + "\\\\"
        elif ord(one) == 10:
            out = out + "\\n"
        elif ord(one) == 9:
            out = out + "\\t"
        else:
            out = out + one
        i = i + 1
    return out

; 字符串值：加引号并转义。
jsonText|func(text: String,) -> (String,):
    return "\"" + jsonEscape(text = text) + "\""

; 布尔值：只出现小写的 true 与 false。
jsonFlag|func(value: Bool,) -> (String,):
    if value:
        return "true"
    return "false"

; 数组：按给入序拼，逗号分隔，不加空白。
jsonList|func(items: Array<String>,) -> (String,):
    var out = "["
    var i = 0
    while i < len(items):
        if i > 0:
            out = out + ","
        out = out + items[i]
        i = i + 1
    return out + "]"

; 类型拼写：缺类型答短横，其余走规范化文本；与转储、诊断共用一份拼写。
jsonTypeSpell|func(module: IrModule, id: I32,) -> (String,):
    if id < 0:
        return "-"
    let out = irTypeText(pool = module.types, id = id)
    return out

; 布局事实：头槽数与标签槽取槽表，结果与可选槽数取契约常量。
; 标签紧随头之后，故与头槽数同值；这一条与契约第 6 节同一算式。
jsonLayout|func(module: IrModule,) -> (String,):
    var out = "{\"headerSlots\":" + countText(module.slots.headSlots)
    out = out + ",\"resultSlots\":" + countText(irResultSlots())
    out = out + ",\"optionalSlots\":" + countText(irOptionalSlots())
    out = out + ",\"enumTagSlot\":" + countText(module.slots.headSlots)
    return out + "}"

; 名字列表：按声明类别过滤，保持声明表序；名义类型与枚举分两列，与宿主同形。
jsonDeclNames|func(module: IrModule, wantEnum: Bool,) -> (String,):
    var items: Array<String> = []
    var i = 0
    while i < declCount(table = module.decls):
        let row = module.decls.entries[i]
        let isEnum = irDeclKindCode(row.kind) == 3
        if isEnum == wantEnum:
            items = items.append(jsonText(text = row.name))
        i = i + 1
    let out = jsonList(items = items)
    return out

; 语句摘要：键序固定，空类型印短横；文本池取原文，未登记答空串。
; detail 只供人读，不进判据；份额动作与槽位照节点字段印，便于对读发射侧的归还点。
jsonDetail|func(module: IrModule, node: IrNode,) -> (String,):
    var out = "type=" + jsonTypeSpell(module = module, id = node.typeId)
    out = out + " op=" + countText(node.op)
    out = out + " text=" + textAt(module = module, id = node.text)
    if irHasVarSlot(kind = node.kind):
        out = out + " slot=" + countText(node.intValue as I32)
    out = out + " kids=" + countText(len(node.kids))
    out = out + " adopt=" + irAdoptName(code = node.adopt)
    out = out + " releaseOld=" + jsonFlag(value = node.releaseOld)
    return out

; 语句体：先序平铺，只收语句节点；表达式留在所在语句的摘要里，不再下潜。
; 深度按语句嵌套递增，故它是结构读数而非缩进选择。
jsonRows|func(module: IrModule, names: Array<String>, nodeIds: Array<I32>, depth: I32,) -> (Array<String>,):
    var rows: Array<String> = []
    var i = 0
    while i < len(nodeIds):
        let id = nodeIds[i]
        if id >= 0 && id < irNodeCount(module.nodes):
            let node = irNodeAt(pool = module.nodes, id = id)
            if irIsStmtTag(node.kind):
                var name = ""
                if node.kind >= 0 && node.kind < len(names):
                    name = names[node.kind]
                var row = "{\"kind\":" + jsonText(text = name)
                row = row + ",\"depth\":" + countText(depth)
                row = row + ",\"detail\":" + jsonText(text = jsonDetail(module = module, node = node))
                rows = rows.append(row + "}")
                let sub = jsonRows(module = module, names = names, nodeIds = node.kids, depth = depth + 1)
                var k = 0
                while k < len(sub):
                    rows = rows.append(sub[k])
                    k = k + 1
        i = i + 1
    return rows

; 函数条目：名字、形参、返回、两个标记与语句体；返回缺类型印 null，不印空串。
jsonFunction|func(module: IrModule, names: Array<String>, fn: IrFunction,) -> (String,):
    var params: Array<String> = []
    var p = 0
    while p < len(fn.params):
        let one = fn.params[p]
        var item = "{\"name\":" + jsonText(text = one.name)
        item = item + ",\"type\":" + jsonText(text = jsonTypeSpell(module = module, id = one.typeId))
        params = params.append(item + "}")
        p = p + 1
    var out = "{\"name\":" + jsonText(text = fn.name)
    out = out + ",\"params\":" + jsonList(items = params)
    if fn.returnType < 0:
        out = out + ",\"returnType\":null"
    else:
        out = out + ",\"returnType\":" + jsonText(text = jsonTypeSpell(module = module, id = fn.returnType))
    out = out + ",\"async\":" + jsonFlag(value = fn.isAsync)
    out = out + ",\"test\":" + jsonFlag(value = fn.isTest)
    out = out + ",\"body\":" + jsonList(items = jsonRows(module = module, names = names, nodeIds = fn.body, depth = 0))
    return out + "}"

; 入口：按固定字段序组装单行文本，末尾一个换行；两次调用得到同一串。
; 记录与目标由调用方给：档次不是转储即拒发，目标行不参与本文本形状。
jsonModule|func(entry: BackendEntry, target: TargetProfile, module: IrModule,) -> (EmitResult,):
    if backendOutputCode(entry.output) != backendOutputDumpCode():
        return failedEmit(detail = "JSON 后端不接受档次 " + backendOutputName(entry.output))
    let names = irTagNames()
    var functions: Array<String> = []
    var i = 0
    while i < len(module.functions):
        functions = functions.append(jsonFunction(module = module, names = names, fn = module.functions[i]))
        i = i + 1
    var out = "{\"backend\":\"json\",\"output\":\"structuralDump\""
    out = out + ",\"layout\":" + jsonLayout(module = module)
    out = out + ",\"types\":" + jsonDeclNames(module = module, wantEnum = false)
    out = out + ",\"enums\":" + jsonDeclNames(module = module, wantEnum = true)
    out = out + ",\"functions\":" + jsonList(items = functions)
    out = out + "}"
    var result = EmitResult()
    result.text = out + "\n"
    result.lines = 1
    result.detail = "json"
    return result
