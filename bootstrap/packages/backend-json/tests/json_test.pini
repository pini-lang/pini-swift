[json_test|import]
_ir = "../../ir"
_backend_kit = "../../backend-kit"

; JSON 转储判据：手搭模块只喂编码器，不经过装配链；真实模块由 lower 与 validate 另行验证。
; 三条各钉一类：字段形状与次序、语句体只下潜语句、两跑逐字节相同。

; 转储记录：档次为转储、全族声明，入口码取一。
json造记录|func() -> (BackendEntry,):
    return makeBackendOf(name = "json", outputCode = backendOutputDumpCode(), families = backendFamilyCodes(), entry = 4)

; 类型池：只放一个标量，够形参与返回拼写。
json造类型池|func() -> (IrTypePool,):
    var pool = IrTypePool()
    let intType = irScalarTypeOfCode(pool = pool, code = 1, name = "i32")
    return intType.pool

; 声明表：一个结构一个枚举，用来分开 types 与 enums 两列。
json造声明表|func() -> (IrDeclTable,):
    var table = IrDeclTable()
    var point = IrDecl()
    point.typeId = 0
    point.name = "点"
    point.kind = irDeclKindOf(shapeCode = 1)
    table.entries = table.entries.append(point)
    var flag = IrDecl()
    flag.typeId = 1
    flag.name = "旗"
    flag.kind = irDeclKindOf(shapeCode = 3)
    table.entries = table.entries.append(flag)
    return table

; 槽表：只给头槽数与载荷基址，布局四值由头槽数与两条契约常量决定。
json造槽表|func() -> (IrSlotTable,):
    var table = IrSlotTable()
    table.headSlots = 4
    table.payloadBase = 5
    return table

; 节点池：一条变量声明与一条返回语句，文本池里放一个带引号的名字。
json造节点池|func() -> (IrNodePool,):
    var nodes = IrNodePool()
    var alloc = irMakeNode(kind = tagOfName(name = "allocVar"), typeId = 0)
    alloc.text = 0
    alloc.adopt = 3
    alloc.releaseOld = true
    let placed = irAppendNode(pool = nodes, node = alloc)
    nodes = placed.pool
    let back = irMakeNode(kind = tagOfName(name = "returnStmt"), typeId = -1)
    let placedBack = irAppendNode(pool = nodes, node = back)
    return placedBack.pool

; 模块：类型、声明、槽、文本与一个两语句的函数。
json造模块|func() -> (IrModule,):
    var module = IrModule()
    module.types = json造类型池()
    module.decls = json造声明表()
    module.slots = json造槽表()
    module.texts = module.texts.append("列\"甲")
    module.nodes = json造节点池()
    var fn = IrFunction()
    fn.name = "f"
    fn.returnType = -1
    var body: Array<I32> = []
    body = body.append(0)
    body = body.append(1)
    fn.body = body
    module.functions = module.functions.append(fn)
    return module

; 含子串：成员被调走参数接收者，避开字段读后直接成员被调的定型盲区。
json含子串|func(text: String, needle: String,) -> (Bool,):
    return text.indexOf(needle) >= 0

; 字段形状：顶层四列按固定次序出现，布局四值与契约常量一致。
json字段形状|test() -> ():
    let result = jsonModule(entry = json造记录(), target = defaultTarget(), module = json造模块())
    assert(!result.failed, "JSON 转储不应失败")
    assert(json含子串(text = result.text, needle = "{\"backend\":\"json\",\"output\":\"structuralDump\""), "首两键应与宿主同形")
    assert(json含子串(text = result.text, needle = "\"layout\":{\"headerSlots\":4,\"resultSlots\":3,\"optionalSlots\":2,\"enumTagSlot\":4}"), "布局四值应按契约常量印")
    assert(json含子串(text = result.text, needle = "\"types\":[\"点\"]"), "名义类型单列一列")
    assert(json含子串(text = result.text, needle = "\"enums\":[\"旗\"]"), "枚举单列一列")
    assert(json含子串(text = result.text, needle = "\"name\":\"f\""), "函数应带名字")
    assert(json含子串(text = result.text, needle = "\"returnType\":null"), "缺返回应印 null")
    return

; 语句体：只收语句节点，深度按语句嵌套递增；表达式不下潜成行。
json语句体|test() -> ():
    var module = json造模块()
    var nodes = IrNodePool()
    let cond = irMakeNode(kind = tagOfName(name = "intConst"), typeId = 0)
    let placedCond = irAppendNode(pool = nodes, node = cond)
    nodes = placedCond.pool
    let back = irMakeNode(kind = tagOfName(name = "returnStmt"), typeId = -1)
    let placedBack = irAppendNode(pool = nodes, node = back)
    nodes = placedBack.pool
    var branch = irMakeNode(kind = tagOfName(name = "ifStmt"), typeId = -1)
    branch.kids = [0, 1]
    let placedBranch = irAppendNode(pool = nodes, node = branch)
    module.nodes = placedBranch.pool
    var fn = IrFunction()
    fn.name = "分支"
    fn.returnType = -1
    var body: Array<I32> = []
    body = body.append(2)
    fn.body = body
    module.functions = module.functions.append(fn)
    let result = jsonModule(entry = json造记录(), target = defaultTarget(), module = module)
    assert(json含子串(text = result.text, needle = "\"kind\":\"ifStmt\",\"depth\":0"), "条件语句应落在第零层")
    assert(json含子串(text = result.text, needle = "\"kind\":\"returnStmt\",\"depth\":1"), "块内语句应加深一层")
    let exprRow = "\"kind\":\"intConst\""
    assert(!json含子串(text = result.text, needle = exprRow), "表达式不该单独成行")
    return

; 转义与确定性：文本池里的引号按 JSON 规则转义，两跑逐字节相同且行读数为一。
json转义与确定性|test() -> ():
    let module = json造模块()
    let once = jsonModule(entry = json造记录(), target = defaultTarget(), module = module)
    let twice = jsonModule(entry = json造记录(), target = defaultTarget(), module = module)
    assert(once.text == twice.text, "两遍转储应逐字节相同")
    assert(once.lines == 1, "单行文本的行读数应为一")
    assert(json含子串(text = once.text, needle = "列\\\"甲"), "摘要里的引号应转义")
    return
