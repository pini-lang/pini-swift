[validate|import]
_semantics = "../../../semantics"

; 校验面：在后端读模块之前把「后端假定成立、降载从未自检」的事实逐条核出。
; 走查从函数体入口进：失败函数留下的孤儿节点不参与，与后端发射同一可达集。
; 表达式节点不记位置，报错时沿用所在语句的偏移；语句也没有位置时答 -1。

; 规则：节点类别、子节点下标、子节点段、体边界、类型下标、字段槽、用例标签、载荷序、变量类型、空体对照。
[IrRule]
irRuleNodeKind
irRuleKidIndex
irRuleKidSegment
irRuleTail
irRuleTypeIndex
irRuleFieldSlot
irRuleCaseTag
irRulePayloadIndex
irRuleVarType
irRuleEmptyBody
irRuleVarSlot

; 校验结果：违约表与走查节点数；节点数用于「校验确实走过整棵树」的判据。
(IrValidation)
errors: Array<LowerError> = []
visited: I32 = 0

; 规则名：细节串以它开头，判据按名匹配，不按位置。
irRuleName|func(_rule: IrRule,) -> (String,):
    match _rule:
        case irRuleNodeKind:
            return "节点类别"
        case irRuleKidIndex:
            return "子节点下标"
        case irRuleKidSegment:
            return "子节点段"
        case irRuleTail:
            return "体边界"
        case irRuleTypeIndex:
            return "类型下标"
        case irRuleFieldSlot:
            return "字段槽"
        case irRuleCaseTag:
            return "用例标签"
        case irRulePayloadIndex:
            return "载荷序号"
        case irRuleVarType:
            return "变量类型"
        case irRuleEmptyBody:
            return "空体对照"
        case irRuleVarSlot:
            return "变量槽位"
    return "规则"

; 报一条：结果只累加，不中断走查；同一节点可同时触发多条。
reportRule|func(result: IrValidation, rule: IrRule, file: String, offset: I32, detail: String,) -> (IrValidation,):
    var out = result
    let text = irRuleName(rule) + "：" + detail
    out.errors = appendLowerError(errors = out.errors, error = makeLowerError(kind = .lowerStructural, file = file, offset = offset, detail = text))
    return out

; 体的子节点序号：分支与循环的首位是条件或目标，其余是语句；defer 的整段都是语句。
stmtKidIsBody|func(kind: I32, index: I32,) -> (Bool,):
    if kind == irStmtTag(.irIfStmt):
        return index > 0
    if kind == irStmtTag(.irWhileStmt):
        return index > 0
    if kind == irStmtTag(.irForInStmt):
        return index > 0
    if kind == irStmtTag(.irTryStmt):
        return index > 0
    if kind == irStmtTag(.irDeferStmt):
        return true
    return false

; 载荷数：声明表里有枚举用例就按声明；可选与结果没有声明行，按契约的固定载荷数。
payloadSlots|func(module: IrModule, typeId: I32, caseName: String,) -> (I32,):
    let declared = payloadCountOf(table = module.decls, typeId = typeId, caseName = caseName)
    if declared >= 0:
        return declared
    if typeId < 0 || typeId >= irTypeCount(module.types):
        return -1
    let tag = irTypeTag(irTypeAt(pool = module.types, id = typeId).kind)
    if tag == irTypeTag(.irTypeOptional):
        if caseName == "none":
            return 0
        if caseName == "some":
            return 1
    if tag == irTypeTag(.irTypeResult):
        if caseName == "ok" || caseName == "err":
            return 1
    return -1

; 字段槽检查：槽位必须落在接收者类型的声明字段数内。
checkFieldSlot|func(module: IrModule, node: IrNode, result: IrValidation, file: String, offset: I32,) -> (IrValidation,):
    if len(node.kids) == 0:
        return reportRule(result = result, rule = .irRuleFieldSlot, file = file, offset = offset, detail = "字段读写没有接收者")
    let base = irNodeAt(pool = module.nodes, id = node.kids[0])
    let count = fieldCountOf(table = module.decls, typeId = base.typeId)
    if node.op < 0 || node.op >= count:
        return reportRule(result = result, rule = .irRuleFieldSlot, file = file, offset = offset, detail = "槽 " + countText(node.op) + " 越出 " + irTypeText(pool = module.types, id = base.typeId) + " 的 " + countText(count) + " 个字段")
    return result

; 用例标签检查：构造节点记的标签必须与声明表的用例序一致。
checkCaseTag|func(module: IrModule, node: IrNode, result: IrValidation, file: String, offset: I32,) -> (IrValidation,):
    let caseName = textAt(module = module, id = node.text)
    let expected = caseTagOf(table = module.decls, typeId = node.typeId, caseName = caseName)
    if expected < 0:
        return reportRule(result = result, rule = .irRuleCaseTag, file = file, offset = offset, detail = "用例 " + caseName + " 不在 " + irTypeText(pool = module.types, id = node.typeId) + " 的声明里")
    if node.op != expected:
        return reportRule(result = result, rule = .irRuleCaseTag, file = file, offset = offset, detail = "用例 " + caseName + " 的标签应为 " + countText(expected) + "，实为 " + countText(node.op))
    return result

; 载荷读检查：序号必须落在该用例的载荷个数内，用例名要能认出来。
checkPayloadIndex|func(module: IrModule, node: IrNode, result: IrValidation, file: String, offset: I32,) -> (IrValidation,):
    if len(node.kids) == 0:
        return reportRule(result = result, rule = .irRulePayloadIndex, file = file, offset = offset, detail = "载荷读没有操作数")
    let base = irNodeAt(pool = module.nodes, id = node.kids[0])
    let caseName = textAt(module = module, id = node.text)
    let count = payloadSlots(module = module, typeId = base.typeId, caseName = caseName)
    if count < 0:
        return reportRule(result = result, rule = .irRulePayloadIndex, file = file, offset = offset, detail = "用例 " + caseName + " 不在 " + irTypeText(pool = module.types, id = base.typeId) + " 的声明里")
    if node.op < 0 || node.op >= count:
        return reportRule(result = result, rule = .irRulePayloadIndex, file = file, offset = offset, detail = "载荷序号 " + countText(node.op) + " 越出用例 " + caseName + " 的 " + countText(count) + " 个载荷")
    return result

; 单节点：先核通用形状，再按类别核专属规则，最后递归子节点。
; `outer` 是外层语句的偏移，本节点自己没有位置时沿用它。
validateNode|func(module: IrModule, nodeId: I32, file: String, positions: Array<IrPosition>, outer: I32, result: IrValidation,) -> (IrValidation,):
    var out = result
    out.visited = out.visited + 1
    let node = irNodeAt(pool = module.nodes, id = nodeId)
    var offset = outer
    let here = positionOf(positions = positions, node = nodeId)
    if here >= 0:
        offset = here
    let isExpr = irIsExprTag(node.kind)
    let isStmt = irIsStmtTag(node.kind)
    if !isExpr && !isStmt:
        return reportRule(result = out, rule = .irRuleNodeKind, file = file, offset = offset, detail = "节点 " + countText(nodeId) + " 的类别码 " + countText(node.kind))
    if node.typeId < -1 || node.typeId >= irTypeCount(module.types):
        out = reportRule(result = out, rule = .irRuleTypeIndex, file = file, offset = offset, detail = "节点 " + countText(nodeId) + " 的类型下标 " + countText(node.typeId))
    if node.tail < -1 || node.tail > len(node.kids):
        out = reportRule(result = out, rule = .irRuleTail, file = file, offset = offset, detail = "节点 " + countText(nodeId) + " 的 tail " + countText(node.tail) + " 越出 " + countText(len(node.kids)) + " 个子节点")
    var k = 0
    while k < len(node.kids):
        let kid = node.kids[k]
        if kid < 0 || kid >= irNodeCount(module.nodes):
            out = reportRule(result = out, rule = .irRuleKidIndex, file = file, offset = offset, detail = "节点 " + countText(nodeId) + " 的子节点下标 " + countText(kid))
        else:
            let kidNode = irNodeAt(pool = module.nodes, id = kid)
            var wantStmt = false
            if isStmt && stmtKidIsBody(kind = node.kind, index = k):
                wantStmt = true
            ; 闭包体挂在节点上：`kids` 全是语句，不是表达式。
            if isExpr && node.kind == irExprTag(.irClosureLiteral):
                wantStmt = true
            if wantStmt && !irIsStmtTag(kidNode.kind):
                out = reportRule(result = out, rule = .irRuleKidSegment, file = file, offset = offset, detail = "节点 " + countText(nodeId) + " 的第 " + countText(k) + " 个子节点应为语句")
            if !wantStmt && !irIsExprTag(kidNode.kind):
                out = reportRule(result = out, rule = .irRuleKidSegment, file = file, offset = offset, detail = "节点 " + countText(nodeId) + " 的第 " + countText(k) + " 个子节点应为表达式")
        k = k + 1
    if node.kind == irExprTag(.irFieldGet) || node.kind == irStmtTag(.irFieldStore):
        out = checkFieldSlot(module = module, node = node, result = out, file = file, offset = offset)
    if node.kind == irExprTag(.irEnumConstruct):
        out = checkCaseTag(module = module, node = node, result = out, file = file, offset = offset)
    if node.kind == irExprTag(.irEnumPayloadGet):
        out = checkPayloadIndex(module = module, node = node, result = out, file = file, offset = offset)
    if node.kind == irStmtTag(.irAllocVar) && node.typeId < 0:
        out = reportRule(result = out, rule = .irRuleVarType, file = file, offset = offset, detail = "变量声明没有类型")
    if node.kind == irStmtTag(.irAllocVar) || node.kind == irStmtTag(.irStoreVar) || node.kind == irStmtTag(.irReleaseVar) || node.kind == irExprTag(.irLoad):
        let slot = node.intValue as I32
        if slot < 0:
            out = reportRule(result = out, rule = .irRuleVarSlot, file = file, offset = offset, detail = "节点 " + countText(nodeId) + " 没有槽位")
    if node.kind == irStmtTag(.irReleaseVar) && node.typeId < 0:
        out = reportRule(result = out, rule = .irRuleVarType, file = file, offset = offset, detail = "归还语句没有类型")
    k = 0
    while k < len(node.kids):
        let kid = node.kids[k]
        if kid >= 0 && kid < irNodeCount(module.nodes):
            out = validateNode(module = module, nodeId = kid, file = file, positions = positions, outer = offset, result = out)
        k = k + 1
    return out

; 函数：从体入口逐条走，位置表随函数走。
validateFunction|func(module: IrModule, fn: IrFunction, result: IrValidation,) -> (IrValidation,):
    var out = result
    var i = 0
    while i < len(fn.body):
        out = validateNode(module = module, nodeId = fn.body[i], file = fn.sourceFile, positions = fn.positions, outer = -1, result = out)
        i = i + 1
    return out

; 空体对照：每条缺口的细节都以「函数名：」开头，空体数不得超过缺口数。
checkEmptyBodies|func(module: IrModule, result: IrValidation,) -> (IrValidation,):
    var out = result
    var i = 0
    while i < len(module.errors):
        let detail = module.errors[i].detail
        let at = detail.indexOf("：")
        var name = detail
        if at >= 0:
            name = detail.substring(0, at)
        if findFunction(module = module, name = name) < 0:
            out = reportRule(result = out, rule = .irRuleEmptyBody, file = module.errors[i].file, offset = module.errors[i].offset, detail = "缺口前缀 " + name + " 对不上任何函数")
        i = i + 1
    let empty = emptyBodyCount(module = module)
    if empty > len(module.errors):
        out = reportRule(result = out, rule = .irRuleEmptyBody, file = "", offset = -1, detail = "空体 " + countText(empty) + " 个，缺口只有 " + countText(len(module.errors)) + " 条")
    return out

; 入口：逐个函数走体，再核模块级对照；返回值只含违约，不含缺口本身。
validateModule|func(module: IrModule,) -> (IrValidation,):
    var out = IrValidation()
    var i = 0
    while i < len(module.functions):
        out = validateFunction(module = module, fn = module.functions[i], result = out)
        i = i + 1
    out = checkEmptyBodies(module = module, result = out)
    return out
