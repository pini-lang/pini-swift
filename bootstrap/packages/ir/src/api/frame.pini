; 局部帧：降载期的名字与槽位，起点接函数帧播种后的水位。
; 槽位只增不减：块退出只收回名字，不回收槽位，故槽位号等于声明序。
; 跨块复用槽位会让两处不同声明的节点指向同一槽，漏声明时看不出来。

; 局部：名字、槽位、IR 类型与可变位。
(IrLocal)
name: String = ""
slot: I32 = -1
typeId: I32 = -1
mutable: Bool = false

; 帧：局部表、下一个可用槽位、类型声明表与降载上下文。
; 世界与声明表随帧走：方法调用按名查符号，字段槽位按声明序算，逐层传参会把同一份表抄进十几条签名。
(LowerFrame)
locals: Array<IrLocal> = []
nextSlot: I32 = 0
world: MemberWorld = MemberWorld()
decls: IrDeclTable = IrDeclTable()
externData: Array<IrExternData> = []
; 闭包帧专用：创建点可见的外层局部快照、已结算的捕获表与待入模块的闭包函数。
; 外层快照按值复制，嵌套闭包因此能沿已结算的捕获继续向外追。
outerLocals: Array<IrLocal> = []
captures: Array<IrCaptureSlot> = []
closures: Array<IrFunction> = []

; 声明局部：槽位取当前水位，随后水位加一。
declareIrLocal|func(frame: LowerFrame, name: String, typeId: I32, mutable: Bool,) -> (LowerFrame,):
    var out = frame
    var row = IrLocal()
    row.name = name
    row.slot = out.nextSlot
    row.typeId = typeId
    row.mutable = mutable
    out.locals = out.locals.append(row)
    out.nextSlot = out.nextSlot + 1
    return out

; 查局部：由后向前，后声明遮蔽先声明；未命中答 -1。
findIrLocal|func(frame: LowerFrame, name: String,) -> (I32,):
    var i = len(frame.locals) - 1
    while i >= 0:
        if frame.locals[i].name == name:
            return i
        i = i - 1
    return -1

; 外层命中：只在创建点快照里找，不登记捕获；未命中答 -1。
findOuterLocal|func(frame: LowerFrame, name: String,) -> (I32,):
    var i = len(frame.outerLocals) - 1
    while i >= 0:
        if frame.outerLocals[i].name == name:
            return i
        i = i - 1
    return -1

; 结算局部：本地已有即原样返回；只有外层可见才登记捕获，槽位取当前水位。
; 捕获按体内首次使用序入表，节点与环境都照这张表排；深一层的外层名字不猜，留给缺口。
ensureIrLocal|func(frame: LowerFrame, name: String,) -> (LowerFrame,):
    if findIrLocal(frame = frame, name = name) >= 0:
        return frame
    let at = findOuterLocal(frame = frame, name = name)
    if at < 0:
        return frame
    let outer = frame.outerLocals[at]
    var out = declareIrLocal(frame = frame, name = name, typeId = outer.typeId, mutable = outer.mutable)
    var row = IrCaptureSlot()
    row.slot = outer.slot
    row.localSlot = out.locals[len(out.locals) - 1].slot
    row.typeId = outer.typeId
    out.captures = out.captures.append(row)
    return out

; 块边界：块内声明从这一位开始，退出时截断到它。
frameMark|func(frame: LowerFrame,) -> (I32,):
    return len(frame.locals)

; 退块：只收回名字，槽位水位保持；mark 越界按长度夹紧。
closeBlock|func(frame: LowerFrame, mark: I32,) -> (LowerFrame,):
    var out = frame
    var kept: Array<IrLocal> = []
    var i = 0
    while i < mark && i < len(out.locals):
        kept = kept.append(out.locals[i])
        i = i + 1
    out.locals = kept
    return out

; 局部数：在册名字的条数，退块后变小。
frameLocalCount|func(frame: LowerFrame,) -> (I32,):
    return len(frame.locals)

; 槽位水位：函数内已分配的下一个槽位，函数结束时即帧大小。
frameSlotCount|func(frame: LowerFrame,) -> (I32,):
    return frame.nextSlot

; 播种帧：参数与自身由语义层播种，这里照抄一遍，槽位与类型一并带过来。
; 不抄的话赋值目标与局部类型查找都认不出参数，形参赋值会被报成非局部目标。
seedLowerFrame|func(scope: ScopeStack, map: TypeMap, world: MemberWorld, decls: IrDeclTable,) -> (LowerFrame,):
    var out = LowerFrame()
    out.nextSlot = scope.nextSlot
    out.world = world
    out.decls = decls
    var i = 0
    while i < len(scope.locals):
        let local = scope.locals[i]
        var row = IrLocal()
        row.name = local.spelling
        row.slot = local.slot
        row.typeId = irIdOf(map = map, semanticId = local.typeId)
        row.mutable = local.mutable
        out.locals = out.locals.append(row)
        i = i + 1
    return out
