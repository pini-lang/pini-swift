[stmt|import]
_syntax = "../../../syntax"
_semantics = "../../../semantics"
_module_loader = "../../../module-loader"

; 语句降载：块、变量、赋值、表达式、分支、循环、匹配与返回；体是语句序列，控制流节点的
; `kids` 用 `tail` 切成两段，前段是体、后段是 else。任一语句降不了即整函数失败：
; 半截体在发射期能跑却少了语句。存储点在这里填 `adopt` 与 `releaseOld`，后端只翻译不另判。

; 语句降载结果：池、文本池、帧、语句产出、逐语句源位置与失败原因。
(LowerStmt)
pool: IrNodePool = IrNodePool()
texts: IrTextPool = IrTextPool()
frame: LowerFrame = LowerFrame()
ids: Array<I32> = []
positions: Array<IrPosition> = []
failed: Bool = false
detail: String = ""
offset: I32 = 0

; 缺能力：语句类别尚未降载，带类别与位置。
missStmt|func(out: LowerStmt, unit: CompilationUnit, stmtId: I32, what: String,) -> (LowerStmt,):
    var done = out
    done.failed = true
    done.detail = what
    if stmtId >= 0 && stmtId < unit.ast.stmtCount():
        done.offset = unit.ast.stmtAt(stmtId).start
    return done

; 失败转发：表达式侧失败时把原因原样上抛。
takeStmtFailure|func(out: LowerStmt, detail: String, offset: I32,) -> (LowerStmt,):
    var done = out
    done.failed = true
    done.detail = detail
    done.offset = offset
    return done

; 变量声明：有标注按标注定型，无标注取初值类型；无初值的声明必须有标注。
; 标注类型由语义层写在模式节点上，降载只做映射；初值与标注不同宽时包一层转换。
lowerVariableStmt|func(out: LowerStmt, unit: CompilationUnit, bytes: Array<U8>, map: TypeMap, types: ExprTypes, unitIndex: I32, stmtId: I32,) -> (LowerStmt,):
    let stmt = unit.ast.stmtAt(stmtId)
    let pattern: I32 = unit.ast.stmtChild(id = stmtId, index = 0)
    let init: I32 = unit.ast.stmtChild(id = stmtId, index = 1)
    if pattern < 0 || !unit.ast.isIdentifierExpr(pattern):
        return missStmt(out = out, unit = unit, stmtId = stmtId, what = "非标识符的声明模式")
    var done = out
    var typeId = -1
    if stmt.typeId >= 0:
        typeId = exprIrType(map = map, types = types, unit = unit, unitIndex = unitIndex, frame = done.frame, bytes = bytes, id = pattern)
        if typeId < 0:
            return missStmt(out = done, unit = unit, stmtId = stmtId, what = "标注类型不可映射")
    var valueId = -1
    if init >= 0:
        if typeId >= 0 && unit.ast.isArrayExpr(init) && len(unit.ast.exprAt(init).kids) == 0:
            let empty = addIrNode(pool = done.pool, kind = irExprTag(.irArrayLiteral), typeId = typeId, op = 0, kids = [])
            done.pool = empty.pool
            valueId = empty.id
        else:
            let one = lowerExpr(pool = done.pool, texts = done.texts, map = map, types = types, unit = unit, unitIndex = unitIndex, bytes = bytes, frame = done.frame, id = init)
            done.pool = one.pool
            done.texts = one.texts
            done.frame = one.frame
            if one.failed:
                return takeStmtFailure(out = done, detail = one.detail, offset = one.offset)
            valueId = one.id
    if valueId >= 0:
        let valueType = irNodeAt(pool = done.pool, id = valueId).typeId
        if typeId < 0:
            typeId = valueType
        elif valueType >= 0 && valueType != typeId:
            let cast = addIrNode(pool = done.pool, kind = irExprTag(.irUnary), typeId = typeId, op = irUnaryTag(.irCast), kids = [valueId])
            done.pool = cast.pool
            valueId = cast.id
    if typeId < 0:
        return missStmt(out = done, unit = unit, stmtId = stmtId, what = "声明类型未定")
    let expr = unit.ast.exprAt(pattern)
    let name = decodeSpelling(bytes = bytes, start = expr.nameStart, end = expr.nameEnd)
    let placed = internText(texts = done.texts, value = name)
    var mutable = false
    if unit.ast.isMutableVariableStmt(stmtId):
        mutable = true
    var kids: Array<I32> = []
    if valueId >= 0:
        kids = kids.append(valueId)
    var node = irMakeNode(kind = irStmtTag(.irAllocVar), typeId = typeId)
    node.text = placed.id
    node.intValue = done.frame.nextSlot as I64
    if mutable:
        node.op = 1
    node.kids = kids
    node = fillStore(node = node, pool = map.pool, nodes = done.pool, targetTypeId = typeId, valueId = valueId, sharingStructs = false, covers = false)
    done.texts = placed.texts
    done = appendStmtNode(out = done, node = node, offset = stmt.start)
    done.frame = declareIrLocal(frame = done.frame, name = name, typeId = typeId, mutable = mutable)
    return done

; 右值结果：池、文本池、帧、节点下标与失败原因；六条写路共用一次右值降载。
(RhsResult)
pool: IrNodePool = IrNodePool()
texts: IrTextPool = IrTextPool()
frame: LowerFrame = LowerFrame()
id: I32 = -1
failed: Bool = false
detail: String = ""
offset: I32 = 0

; 右值：赋值语句的第二子节点；失败原因与位置一并带回，由调用方转成缺口。
lowerAssignRhs|func(out: LowerStmt, unit: CompilationUnit, bytes: Array<U8>, map: TypeMap, types: ExprTypes, unitIndex: I32, stmtId: I32,) -> (RhsResult,):
    let stmt = unit.ast.stmtAt(stmtId)
    var done = RhsResult()
    done.pool = out.pool
    done.texts = out.texts
    done.frame = out.frame
    let one = lowerExpr(pool = out.pool, texts = out.texts, map = map, types = types, unit = unit, unitIndex = unitIndex, bytes = bytes, frame = out.frame, id = stmt.kids[1])
    done.pool = one.pool
    done.texts = one.texts
    done.frame = one.frame
    if one.failed:
        done.failed = true
        done.detail = one.detail
        done.offset = one.offset
        return done
    done.id = one.id
    return done

; 记语句：节点并进池、下标写成本条语句自己的序列，并记一条源位置；源序即节点序。
;  行不通  追加到入口的 ids：调用方按条累积，上一段（then）的语句会跟着进下一段（else）。
appendStmtNode|func(out: LowerStmt, node: IrNode, offset: I32,) -> (LowerStmt,):
    var done = out
    let inserted = irAppendNode(pool = done.pool, node = node)
    done.pool = inserted.pool
    var fresh: Array<I32> = [inserted.id]
    done.ids = fresh
    done.positions = recordPosition(positions = done.positions, node = inserted.id, offset = offset)
    return done

; 字段槽：按接收者的 IR 类型与字段拼写查声明序，未命中答 -1。
; 槽位口径只有这一处：字段名是诊断用的拼写，节点里存的是槽。
fieldSlotInFrame|func(frame: LowerFrame, receiverTypeId: I32, name: String,) -> (I32,):
    return fieldSlotOf(table = frame.decls, typeId = receiverTypeId, name = name)

; 字段读：槽位按声明序取，接收者一个子节点；方法值不走这条。
makeFieldGet|func(pool: IrNodePool, texts: IrTextPool, slot: I32, typeId: I32, base: I32,) -> (IrLoadNode,):
    var node = irMakeNode(kind = irExprTag(.irFieldGet), typeId = typeId)
    node.op = slot
    node.kids = [base]
    let inserted = irAppendNode(pool = pool, node = node)
    var out = IrLoadNode()
    out.pool = inserted.pool
    out.texts = texts
    out.id = inserted.id
    return out

; 下标读：容器与下标给定，越界由运行时陷阱承担。
makeSubscriptGet|func(pool: IrNodePool, typeId: I32, container: I32, index: I32,) -> (IrNodeInsert,):
    return addIrNode(pool = pool, kind = irExprTag(.irSubscriptGet), typeId = typeId, op = 0, kids = [container, index])

; 存储点动作：按目标类型与值的求值效果填接收动作；`covers` 说这条语句覆盖的是既有槽。
; 声明新槽不还旧值，赋值、字段写与下标写要还；容器元素按箱共享，故另给一个开关。
fillStore|func(node: IrNode, pool: IrTypePool, nodes: IrNodePool, targetTypeId: I32, valueId: I32, sharingStructs: Bool, covers: Bool,) -> (IrNode,):
    var out = node
    if valueId >= 0:
        let effect = irShareEffectOf(pool = pool, nodes = nodes, nodeId = valueId)
        out.adopt = irAdoptOf(pool = pool, targetTypeId = targetTypeId, effect = effect, sharingStructs = sharingStructs)
    if covers:
        out.releaseOld = irHoldsShare(pool = pool, typeId = targetTypeId)
    return out

; 赋值：复合运算按「读—算—写」接成三节，普通赋值只写一次。
lowerAssignStmt|func(out: LowerStmt, unit: CompilationUnit, bytes: Array<U8>, map: TypeMap, types: ExprTypes, unitIndex: I32, stmtId: I32,) -> (LowerStmt,):
    let stmt = unit.ast.stmtAt(stmtId)
    if len(stmt.kids) < 2:
        return missStmt(out = out, unit = unit, stmtId = stmtId, what = "缺值或目标的赋值")
    let compound = compoundBinaryTag(stmt.op)
    if compound == 0:
        return lowerStoreStmt(out = out, unit = unit, bytes = bytes, map = map, types = types, unitIndex = unitIndex, stmtId = stmtId)
    let base = binaryTagOf(spelling = opSymbol(compound))
    if base == 0:
        return missStmt(out = out, unit = unit, stmtId = stmtId, what = "复合赋值 " + opSymbol(stmt.op))
    return lowerCompoundStmt(out = out, unit = unit, bytes = bytes, map = map, types = types, unitIndex = unitIndex, stmtId = stmtId, base = base)

; 普通赋值：标识符写局部槽，成员写字段，下标写元素；其余目标报缺口。
lowerStoreStmt|func(out: LowerStmt, unit: CompilationUnit, bytes: Array<U8>, map: TypeMap, types: ExprTypes, unitIndex: I32, stmtId: I32,) -> (LowerStmt,):
    let stmt = unit.ast.stmtAt(stmtId)
    let target: I32 = stmt.kids[0]
    var done = out
    if unit.ast.isIdentifierExpr(target):
        let expr = unit.ast.exprAt(target)
        let name = decodeSpelling(bytes = bytes, start = expr.nameStart, end = expr.nameEnd)
        done.frame = ensureIrLocal(frame = done.frame, name = name)
        let at = findIrLocal(frame = done.frame, name = name)
        if at < 0:
            return missStmt(out = done, unit = unit, stmtId = stmtId, what = "非局部变量的赋值目标")
        let typeId = done.frame.locals[at].typeId
        let rhs = lowerAssignRhs(out = done, unit = unit, bytes = bytes, map = map, types = types, unitIndex = unitIndex, stmtId = stmtId)
        done.pool = rhs.pool
        done.texts = rhs.texts
        done.frame = rhs.frame
        if rhs.failed:
            return takeStmtFailure(out = done, detail = rhs.detail, offset = rhs.offset)
        let placed = internText(texts = done.texts, value = name)
        var node = irMakeNode(kind = irStmtTag(.irStoreVar), typeId = typeId)
        node.text = placed.id
        node.intValue = done.frame.locals[at].slot as I64
        node.kids = [rhs.id]
        node = fillStore(node = node, pool = map.pool, nodes = done.pool, targetTypeId = typeId, valueId = rhs.id, sharingStructs = false, covers = true)
        done.texts = placed.texts
        return appendStmtNode(out = done, node = node, offset = stmt.start)
    if unit.ast.isMemberExpr(target):
        return writeField(out = out, unit = unit, bytes = bytes, map = map, types = types, unitIndex = unitIndex, stmtId = stmtId, target = target)
    if unit.ast.isSubscriptExpr(target):
        return writeSubscript(out = out, unit = unit, bytes = bytes, map = map, types = types, unitIndex = unitIndex, stmtId = stmtId, target = target)
    return missStmt(out = done, unit = unit, stmtId = stmtId, what = "该赋值目标尚未降载")

; 字段写：接收者先降，字段名驻留，值排在其后；字段类型取自推导表。
writeField|func(out: LowerStmt, unit: CompilationUnit, bytes: Array<U8>, map: TypeMap, types: ExprTypes, unitIndex: I32, stmtId: I32, target: I32,) -> (LowerStmt,):
    let member = unit.ast.exprAt(target)
    if len(member.kids) < 1:
        return missStmt(out = out, unit = unit, stmtId = stmtId, what = "无接收者的字段写")
    var done = out
    let recvOne = lowerExpr(pool = done.pool, texts = done.texts, map = map, types = types, unit = unit, unitIndex = unitIndex, bytes = bytes, frame = done.frame, id = member.kids[0])
    done.pool = recvOne.pool
    done.texts = recvOne.texts
    done.frame = recvOne.frame
    if recvOne.failed:
        return takeStmtFailure(out = done, detail = recvOne.detail, offset = recvOne.offset)
    let typeId = exprIrType(map = map, types = types, unit = unit, unitIndex = unitIndex, frame = done.frame, bytes = bytes, id = target)
    if typeId < 0:
        return missStmt(out = done, unit = unit, stmtId = stmtId, what = "字段类型未定")
    let rhs = lowerAssignRhs(out = done, unit = unit, bytes = bytes, map = map, types = types, unitIndex = unitIndex, stmtId = stmtId)
    done.pool = rhs.pool
    done.texts = rhs.texts
    done.frame = rhs.frame
    if rhs.failed:
        return takeStmtFailure(out = done, detail = rhs.detail, offset = rhs.offset)
    let fieldName = decodeSpelling(bytes = bytes, start = member.nameStart, end = member.nameEnd)
    ; 无主引用透传：接收者先解引用，字段按元素类型找；unsafe 门禁在检查面判过。
    var receiverId = recvOne.id
    var receiverType = irNodeAt(pool = done.pool, id = receiverId).typeId
    let unownedReceiver = irUnownedRefElement(pool = map.pool, id = receiverType)
    if unownedReceiver >= 0:
        let unwrapped = addIrNode(pool = done.pool, kind = irExprTag(.irUnownedRefValue), typeId = unownedReceiver, op = 0, kids = [receiverId])
        done.pool = unwrapped.pool
        receiverId = unwrapped.id
        receiverType = unownedReceiver
    let slot = fieldSlotInFrame(frame = done.frame, receiverTypeId = receiverType, name = fieldName)
    if slot < 0:
        return missStmt(out = done, unit = unit, stmtId = stmtId, what = "字段 " + fieldName + " 不在声明里")
    var node = irMakeNode(kind = irStmtTag(.irFieldStore), typeId = typeId)
    node.op = slot
    node.kids = [receiverId, rhs.id]
    node = fillStore(node = node, pool = map.pool, nodes = done.pool, targetTypeId = typeId, valueId = rhs.id, sharingStructs = false, covers = true)
    return appendStmtNode(out = done, node = node, offset = unit.ast.stmtAt(stmtId).start)

; 下标写：容器、下标与值三个子节点，元素类型取自推导表；越界写由运行时报错。
writeSubscript|func(out: LowerStmt, unit: CompilationUnit, bytes: Array<U8>, map: TypeMap, types: ExprTypes, unitIndex: I32, stmtId: I32, target: I32,) -> (LowerStmt,):
    let expr = unit.ast.exprAt(target)
    if len(expr.kids) < 2:
        return missStmt(out = out, unit = unit, stmtId = stmtId, what = "缺下标的下标写")
    var done = out
    var kids: Array<I32> = []
    var i = 0
    while i < 2:
        let one = lowerExpr(pool = done.pool, texts = done.texts, map = map, types = types, unit = unit, unitIndex = unitIndex, bytes = bytes, frame = done.frame, id = expr.kids[i])
        done.pool = one.pool
        done.texts = one.texts
        done.frame = one.frame
        if one.failed:
            return takeStmtFailure(out = done, detail = one.detail, offset = one.offset)
        kids = kids.append(one.id)
        i = i + 1
    let typeId = exprIrType(map = map, types = types, unit = unit, unitIndex = unitIndex, frame = done.frame, bytes = bytes, id = target)
    if typeId < 0:
        return missStmt(out = done, unit = unit, stmtId = stmtId, what = "元素类型未定")
    let rhs = lowerAssignRhs(out = done, unit = unit, bytes = bytes, map = map, types = types, unitIndex = unitIndex, stmtId = stmtId)
    done.pool = rhs.pool
    done.texts = rhs.texts
    done.frame = rhs.frame
    if rhs.failed:
        return takeStmtFailure(out = done, detail = rhs.detail, offset = rhs.offset)
    var node = irMakeNode(kind = irStmtTag(.irSubscriptStore), typeId = typeId)
    node.kids = [kids[0], kids[1], rhs.id]
    node = fillStore(node = node, pool = map.pool, nodes = done.pool, targetTypeId = typeId, valueId = rhs.id, sharingStructs = true, covers = true)
    return appendStmtNode(out = done, node = node, offset = unit.ast.stmtAt(stmtId).start)

; 复合赋值：读—算—写分三节，接收者只收标识符，其余形态会被求值两次。
lowerCompoundStmt|func(out: LowerStmt, unit: CompilationUnit, bytes: Array<U8>, map: TypeMap, types: ExprTypes, unitIndex: I32, stmtId: I32, base: I32,) -> (LowerStmt,):
    let stmt = unit.ast.stmtAt(stmtId)
    let target: I32 = stmt.kids[0]
    var done = out
    if unit.ast.isIdentifierExpr(target):
        let expr = unit.ast.exprAt(target)
        let name = decodeSpelling(bytes = bytes, start = expr.nameStart, end = expr.nameEnd)
        done.frame = ensureIrLocal(frame = done.frame, name = name)
        let at = findIrLocal(frame = done.frame, name = name)
        if at < 0:
            return missStmt(out = done, unit = unit, stmtId = stmtId, what = "非局部变量的赋值目标")
        let typeId = done.frame.locals[at].typeId
        let load = makeLoadNode(pool = done.pool, texts = done.texts, name = name, typeId = typeId, slot = done.frame.locals[at].slot)
        done.pool = load.pool
        done.texts = load.texts
        let rhs = lowerAssignRhs(out = done, unit = unit, bytes = bytes, map = map, types = types, unitIndex = unitIndex, stmtId = stmtId)
        done.pool = rhs.pool
        done.texts = rhs.texts
        done.frame = rhs.frame
        if rhs.failed:
            return takeStmtFailure(out = done, detail = rhs.detail, offset = rhs.offset)
        let sum = addIrNode(pool = done.pool, kind = irExprTag(.irBinary), typeId = typeId, op = base, kids = [load.id, rhs.id])
        done.pool = sum.pool
        let placed = internText(texts = done.texts, value = name)
        var node = irMakeNode(kind = irStmtTag(.irStoreVar), typeId = typeId)
        node.text = placed.id
        node.intValue = done.frame.locals[at].slot as I64
        node.kids = [sum.id]
        node = fillStore(node = node, pool = map.pool, nodes = done.pool, targetTypeId = typeId, valueId = sum.id, sharingStructs = false, covers = true)
        done.texts = placed.texts
        return appendStmtNode(out = done, node = node, offset = stmt.start)
    if unit.ast.isMemberExpr(target):
        return compoundField(out = done, unit = unit, bytes = bytes, map = map, types = types, unitIndex = unitIndex, stmtId = stmtId, target = target, base = base)
    if unit.ast.isSubscriptExpr(target):
        return compoundSubscript(out = done, unit = unit, bytes = bytes, map = map, types = types, unitIndex = unitIndex, stmtId = stmtId, target = target, base = base)
    return missStmt(out = done, unit = unit, stmtId = stmtId, what = "该赋值目标尚未降载")

; 字段复合赋值：先读字段，再算，再写回同一个接收者。
compoundField|func(out: LowerStmt, unit: CompilationUnit, bytes: Array<U8>, map: TypeMap, types: ExprTypes, unitIndex: I32, stmtId: I32, target: I32, base: I32,) -> (LowerStmt,):
    let member = unit.ast.exprAt(target)
    if len(member.kids) < 1:
        return missStmt(out = out, unit = unit, stmtId = stmtId, what = "无接收者的字段写")
    if !unit.ast.isIdentifierExpr(member.kids[0]):
        return missStmt(out = out, unit = unit, stmtId = stmtId, what = "复合赋值的接收者求值两次")
    var done = out
    let recvOne = lowerExpr(pool = done.pool, texts = done.texts, map = map, types = types, unit = unit, unitIndex = unitIndex, bytes = bytes, frame = done.frame, id = member.kids[0])
    done.pool = recvOne.pool
    done.texts = recvOne.texts
    done.frame = recvOne.frame
    if recvOne.failed:
        return takeStmtFailure(out = done, detail = recvOne.detail, offset = recvOne.offset)
    let typeId = exprIrType(map = map, types = types, unit = unit, unitIndex = unitIndex, frame = done.frame, bytes = bytes, id = target)
    if typeId < 0:
        return missStmt(out = done, unit = unit, stmtId = stmtId, what = "字段类型未定")
    let fieldName = decodeSpelling(bytes = bytes, start = member.nameStart, end = member.nameEnd)
    let slot = fieldSlotInFrame(frame = done.frame, receiverTypeId = irNodeAt(pool = done.pool, id = recvOne.id).typeId, name = fieldName)
    if slot < 0:
        return missStmt(out = done, unit = unit, stmtId = stmtId, what = "字段 " + fieldName + " 不在声明里")
    let get = makeFieldGet(pool = done.pool, texts = done.texts, slot = slot, typeId = typeId, base = recvOne.id)
    done.pool = get.pool
    done.texts = get.texts
    let rhs = lowerAssignRhs(out = done, unit = unit, bytes = bytes, map = map, types = types, unitIndex = unitIndex, stmtId = stmtId)
    done.pool = rhs.pool
    done.texts = rhs.texts
    done.frame = rhs.frame
    if rhs.failed:
        return takeStmtFailure(out = done, detail = rhs.detail, offset = rhs.offset)
    let sum = addIrNode(pool = done.pool, kind = irExprTag(.irBinary), typeId = typeId, op = base, kids = [get.id, rhs.id])
    done.pool = sum.pool
    var node = irMakeNode(kind = irStmtTag(.irFieldStore), typeId = typeId)
    node.op = slot
    node.kids = [recvOne.id, sum.id]
    node = fillStore(node = node, pool = map.pool, nodes = done.pool, targetTypeId = typeId, valueId = sum.id, sharingStructs = false, covers = true)
    return appendStmtNode(out = done, node = node, offset = unit.ast.stmtAt(stmtId).start)

; 下标复合赋值：容器只收标识符，读—算—写落在同一个容器与下标上。
compoundSubscript|func(out: LowerStmt, unit: CompilationUnit, bytes: Array<U8>, map: TypeMap, types: ExprTypes, unitIndex: I32, stmtId: I32, target: I32, base: I32,) -> (LowerStmt,):
    let expr = unit.ast.exprAt(target)
    if len(expr.kids) < 2:
        return missStmt(out = out, unit = unit, stmtId = stmtId, what = "缺下标的下标写")
    if !unit.ast.isIdentifierExpr(expr.kids[0]):
        return missStmt(out = out, unit = unit, stmtId = stmtId, what = "复合赋值的容器求值两次")
    var done = out
    let container = lowerExpr(pool = done.pool, texts = done.texts, map = map, types = types, unit = unit, unitIndex = unitIndex, bytes = bytes, frame = done.frame, id = expr.kids[0])
    done.pool = container.pool
    done.texts = container.texts
    done.frame = container.frame
    if container.failed:
        return takeStmtFailure(out = done, detail = container.detail, offset = container.offset)
    let indexOne = lowerExpr(pool = done.pool, texts = done.texts, map = map, types = types, unit = unit, unitIndex = unitIndex, bytes = bytes, frame = done.frame, id = expr.kids[1])
    done.pool = indexOne.pool
    done.texts = indexOne.texts
    done.frame = indexOne.frame
    if indexOne.failed:
        return takeStmtFailure(out = done, detail = indexOne.detail, offset = indexOne.offset)
    let typeId = exprIrType(map = map, types = types, unit = unit, unitIndex = unitIndex, frame = done.frame, bytes = bytes, id = target)
    if typeId < 0:
        return missStmt(out = done, unit = unit, stmtId = stmtId, what = "元素类型未定")
    let get = makeSubscriptGet(pool = done.pool, typeId = typeId, container = container.id, index = indexOne.id)
    done.pool = get.pool
    let rhs = lowerAssignRhs(out = done, unit = unit, bytes = bytes, map = map, types = types, unitIndex = unitIndex, stmtId = stmtId)
    done.pool = rhs.pool
    done.texts = rhs.texts
    done.frame = rhs.frame
    if rhs.failed:
        return takeStmtFailure(out = done, detail = rhs.detail, offset = rhs.offset)
    let sum = addIrNode(pool = done.pool, kind = irExprTag(.irBinary), typeId = typeId, op = base, kids = [get.id, rhs.id])
    done.pool = sum.pool
    var node = irMakeNode(kind = irStmtTag(.irSubscriptStore), typeId = typeId)
    node.kids = [container.id, indexOne.id, sum.id]
    node = fillStore(node = node, pool = map.pool, nodes = done.pool, targetTypeId = typeId, valueId = sum.id, sharingStructs = true, covers = true)
    return appendStmtNode(out = done, node = node, offset = unit.ast.stmtAt(stmtId).start)

; 表达式语句：求值并丢弃结果。
lowerExprStmt|func(out: LowerStmt, unit: CompilationUnit, bytes: Array<U8>, map: TypeMap, types: ExprTypes, unitIndex: I32, stmtId: I32,) -> (LowerStmt,):
    let stmt = unit.ast.stmtAt(stmtId)
    if len(stmt.kids) < 1:
        return missStmt(out = out, unit = unit, stmtId = stmtId, what = "空表达式语句")
    var done = out
    let one = lowerExpr(pool = done.pool, texts = done.texts, map = map, types = types, unit = unit, unitIndex = unitIndex, bytes = bytes, frame = done.frame, id = stmt.kids[0])
    done.pool = one.pool
    done.texts = one.texts
    done.frame = one.frame
    if one.failed:
        return takeStmtFailure(out = done, detail = one.detail, offset = one.offset)
    var node = irMakeNode(kind = irStmtTag(.irExprStmt), typeId = -1)
    node.kids = [one.id]
    return appendStmtNode(out = done, node = node, offset = stmt.start)

; 分离：操作数一个任务句柄，产一条剪枝语句；表达式结果本就不产出值。
lowerDetachStmt|func(out: LowerStmt, unit: CompilationUnit, bytes: Array<U8>, map: TypeMap, types: ExprTypes, unitIndex: I32, stmtId: I32,) -> (LowerStmt,):
    let stmt = unit.ast.stmtAt(stmtId)
    if len(stmt.kids) < 1:
        return missStmt(out = out, unit = unit, stmtId = stmtId, what = "分离缺操作数")
    var done = out
    let one = lowerExpr(pool = done.pool, texts = done.texts, map = map, types = types, unit = unit, unitIndex = unitIndex, bytes = bytes, frame = done.frame, id = stmt.kids[0])
    done.pool = one.pool
    done.texts = one.texts
    done.frame = one.frame
    if one.failed:
        return takeStmtFailure(out = done, detail = one.detail, offset = one.offset)
    let handleType = irNodeAt(pool = done.pool, id = one.id).typeId
    if irTypeTag(irTypeAt(pool = map.pool, id = handleType).kind) != irTypeTag(.irTypeFuture):
        return missStmt(out = done, unit = unit, stmtId = stmtId, what = "分离目标不是任务句柄")
    var node = irMakeNode(kind = irStmtTag(.irDetachStmt), typeId = -1)
    node.kids = [one.id]
    return appendStmtNode(out = done, node = node, offset = stmt.start)

; 返回：有值降值，无值留空子表。
lowerReturnStmt|func(out: LowerStmt, unit: CompilationUnit, bytes: Array<U8>, map: TypeMap, types: ExprTypes, unitIndex: I32, stmtId: I32,) -> (LowerStmt,):
    let stmt = unit.ast.stmtAt(stmtId)
    var done = out
    var kids: Array<I32> = []
    if len(stmt.kids) > 0 && stmt.kids[0] >= 0:
        let one = lowerExpr(pool = done.pool, texts = done.texts, map = map, types = types, unit = unit, unitIndex = unitIndex, bytes = bytes, frame = done.frame, id = stmt.kids[0])
        done.pool = one.pool
        done.texts = one.texts
        done.frame = one.frame
        if one.failed:
            return takeStmtFailure(out = done, detail = one.detail, offset = one.offset)
        kids = kids.append(one.id)
    var node = irMakeNode(kind = irStmtTag(.irReturnStmt), typeId = -1)
    node.kids = kids
    if len(kids) > 0:
        node = fillStore(node = node, pool = map.pool, nodes = done.pool, targetTypeId = irNodeAt(pool = done.pool, id = kids[0]).typeId, valueId = kids[0], sharingStructs = false, covers = false)
    return appendStmtNode(out = done, node = node, offset = stmt.start)

; 分支：kids 交替是「条件、块」，末尾可能有孤立 else 块；elif 链按嵌套 if 收成一条语句。
; 先按源序降条件与块，再从末段往前搭节点 —— 节点序不参与发射次序，块序保持不变。
lowerIfStmt|func(out: LowerStmt, unit: CompilationUnit, bytes: Array<U8>, map: TypeMap, types: ExprTypes, unitIndex: I32, stmtId: I32,) -> (LowerStmt,):
    let kids = unit.ast.stmtAt(stmtId).kids
    if len(kids) < 2:
        return missStmt(out = out, unit = unit, stmtId = stmtId, what = "缺体的分支")
    var done = out
    var conds: Array<I32> = []
    var blockIds: Array<I32> = []
    var blockStart: Array<I32> = []
    var blockLen: Array<I32> = []
    var elseIds: Array<I32> = []
    var i = 0
    while i + 1 < len(kids):
        let cond = lowerExpr(pool = done.pool, texts = done.texts, map = map, types = types, unit = unit, unitIndex = unitIndex, bytes = bytes, frame = done.frame, id = kids[i])
        done.pool = cond.pool
        done.texts = cond.texts
        done.frame = cond.frame
        if cond.failed:
            return takeStmtFailure(out = done, detail = cond.detail, offset = cond.offset)
        conds = conds.append(cond.id)
        let part = lowerBlockOf(out = done, unit = unit, bytes = bytes, map = map, types = types, unitIndex = unitIndex, blockId = kids[i + 1])
        done = part
        if done.failed:
            return done
        blockStart = blockStart.append(len(blockIds))
        blockLen = blockLen.append(len(part.ids))
        var b = 0
        while b < len(part.ids):
            blockIds = blockIds.append(part.ids[b])
            b = b + 1
        i = i + 2
    if i < len(kids):
        let part = lowerBlockOf(out = done, unit = unit, bytes = bytes, map = map, types = types, unitIndex = unitIndex, blockId = kids[i])
        done = part
        if done.failed:
            return done
        elseIds = part.ids
    var ids = elseIds
    var k = len(conds) - 1
    while k >= 0:
        var nodes: Array<I32> = [conds[k]]
        var b = 0
        while b < blockLen[k]:
            nodes = nodes.append(blockIds[blockStart[k] + b])
            b = b + 1
        let tail = len(nodes)
        var e = 0
        while e < len(ids):
            nodes = nodes.append(ids[e])
            e = e + 1
        var node = irMakeNode(kind = irStmtTag(.irIfStmt), typeId = -1)
        node.kids = nodes
        node.tail = tail
        let inserted = irAppendNode(pool = done.pool, node = node)
        done.pool = inserted.pool
        done.positions = recordPosition(positions = done.positions, node = inserted.id, offset = unit.ast.stmtAt(stmtId).start)
        ids = [inserted.id]
        k = k - 1
    done.ids = ids
    return done

; 循环：只接条件与体；`step` 块的轮末语义另批处理，出现即报缺口。
lowerWhileStmt|func(out: LowerStmt, unit: CompilationUnit, bytes: Array<U8>, map: TypeMap, types: ExprTypes, unitIndex: I32, stmtId: I32,) -> (LowerStmt,):
    let kids = unit.ast.stmtAt(stmtId).kids
    if len(kids) < 2:
        return missStmt(out = out, unit = unit, stmtId = stmtId, what = "缺体的循环")
    if len(kids) > 2 && kids[2] >= 0:
        return missStmt(out = out, unit = unit, stmtId = stmtId, what = "带 step 的循环")
    var done = out
    let cond = lowerExpr(pool = done.pool, texts = done.texts, map = map, types = types, unit = unit, unitIndex = unitIndex, bytes = bytes, frame = done.frame, id = kids[0])
    done.pool = cond.pool
    done.texts = cond.texts
    done.frame = cond.frame
    if cond.failed:
        return takeStmtFailure(out = done, detail = cond.detail, offset = cond.offset)
    let bodyPart = lowerBlockOf(out = done, unit = unit, bytes = bytes, map = map, types = types, unitIndex = unitIndex, blockId = kids[1])
    done = bodyPart
    if done.failed:
        return done
    var nodes: Array<I32> = [cond.id]
    var i = 0
    while i < len(bodyPart.ids):
        nodes = nodes.append(bodyPart.ids[i])
        i = i + 1
    var node = irMakeNode(kind = irStmtTag(.irWhileStmt), typeId = -1)
    node.kids = nodes
    node.tail = len(nodes)
    let inserted = irAppendNode(pool = done.pool, node = node)
    done.pool = inserted.pool
    done.ids = [inserted.id]
    done.positions = recordPosition(positions = done.positions, node = inserted.id, offset = unit.ast.stmtAt(stmtId).start)
    return done

; 块：进块记边界，逐条降载，退块只收回名字。
lowerBlockOf|func(out: LowerStmt, unit: CompilationUnit, bytes: Array<U8>, map: TypeMap, types: ExprTypes, unitIndex: I32, blockId: I32,) -> (LowerStmt,):
    var done = out
    if blockId < 0 || blockId >= unit.ast.stmtCount():
        return missStmt(out = done, unit = unit, stmtId = blockId, what = "块下标越界")
    let kids = unit.ast.stmtAt(blockId).kids
    let mark = frameMark(frame = done.frame)
    var ids: Array<I32> = []
    var i = 0
    while i < len(kids):
        let one = lowerStmt(out = done, unit = unit, bytes = bytes, map = map, types = types, unitIndex = unitIndex, stmtId = kids[i])
        done.pool = one.pool
        done.texts = one.texts
        done.frame = one.frame
        done.positions = one.positions
        if one.failed:
            done.failed = true
            done.detail = one.detail
            done.offset = one.offset
            done.ids = ids
            return done
        var k = 0
        while k < len(one.ids):
            ids = ids.append(one.ids[k])
            k = k + 1
        i = i + 1
    done.ids = ids
    done.frame = closeBlock(frame = done.frame, mark = mark)
    return done

; 匹配族：按主体类型分派读法；0 为裸值，1 枚举，2 可选，3 结果。
matchFamilyOf|func(map: TypeMap, typeId: I32,) -> (I32,):
    if typeId < 0 || typeId >= irTypeCount(map.pool):
        return 0
    let entry = irTypeAt(pool = map.pool, id = typeId)
    let tag = irTypeTag(entry.kind)
    if tag == irTypeTag(.irTypeEnumeration):
        return 1
    if tag == irTypeTag(.irTypeOptional):
        return 2
    if tag == irTypeTag(.irTypeResult):
        return 3
    return 0

; 固定标签：可选的 some / none 与结果的 ok / err 由语义定死；枚举按声明序另算，其余答 -1。
matchCaseTagOf|func(family: I32, caseName: String,) -> (I32,):
    if family == 2:
        if caseName == "some":
            return 0
        if caseName == "none":
            return 1
        return -1
    if family == 3:
        if caseName == "ok":
            return 0
        if caseName == "err":
            return 1
        return -1
    return -1

; 枚举载荷的 IR 下标：按用例声明序找第 index 个载荷的标注，再经映射表取像。
enumPayloadIrType|func(frame: LowerFrame, map: TypeMap, owner: String, caseName: String, index: I32,) -> (I32,):
    let symbol = lookupTopByName(index = frame.world.symbols, name = owner)
    let ref = symbolDecl(world = frame.world, symbol = symbol)
    if ref.unit < 0:
        return -1
    let unit = frame.world.units[ref.unit]
    let decl = unit.ast.decls[ref.decl]
    let bytes = unitBytes(unit)
    var i = 0
    while i < len(decl.kids):
        let child = unit.ast.decls[decl.kids[i]]
        if isVariantDeclCode(child.kind):
            let name = decodeSpelling(bytes = bytes, start = child.nameStart, end = child.nameEnd)
            if name == caseName:
                if index < 0 || index >= len(child.kids):
                    return -1
                let param = unit.ast.decls[child.kids[index]]
                let resolved = annotationType(world = frame.world, unit = unit, node = param.typeId, pool = frame.world.types.pool)
                return irIdOf(map = map, semanticId = resolved.id)
        i = i + 1
    return -1

; 绑定类型：枚举查声明，可选取包装分量，结果按用例取 ok 载荷或类型擦除后的错误字。
matchBindingIrType|func(frame: LowerFrame, map: TypeMap, family: I32, subjectType: I32, owner: String, caseName: String, index: I32,) -> (I32,):
    let kids = irTypeKids(pool = map.pool, id = subjectType)
    if family == 1:
        return enumPayloadIrType(frame = frame, map = map, owner = owner, caseName = caseName, index = index)
    if family == 2:
        if index == 0 && len(kids) > 0:
            return kids[0]
        return -1
    if family == 3:
        if caseName == "ok":
            if index == 0 && len(kids) > 0:
                return kids[0]
            return -1
        if caseName == "err" && index == 0:
            return map.i64Id
        return -1
    return -1

; 匹配：主体只求值一次并存进临时局部，各分支链成 if / else。
; 带标签值按标签比较，裸值按字面量比较；未命中时枚举 / 可选 / 结果补陷阱，裸值静默落到之后。
lowerMatchStmt|func(out: LowerStmt, unit: CompilationUnit, bytes: Array<U8>, map: TypeMap, types: ExprTypes, unitIndex: I32, stmtId: I32,) -> (LowerStmt,):
    let kids = unit.ast.stmtAt(stmtId).kids
    if len(kids) < 3:
        return missStmt(out = out, unit = unit, stmtId = stmtId, what = "缺分支的匹配")
    var done = out
    let subject = lowerExpr(pool = done.pool, texts = done.texts, map = map, types = types, unit = unit, unitIndex = unitIndex, bytes = bytes, frame = done.frame, id = kids[0])
    done.pool = subject.pool
    done.texts = subject.texts
    done.frame = subject.frame
    if subject.failed:
        return takeStmtFailure(out = done, detail = subject.detail, offset = subject.offset)
    let subjectType = irNodeAt(pool = done.pool, id = subject.id).typeId
    if subjectType < 0:
        return missStmt(out = done, unit = unit, stmtId = stmtId, what = "匹配主体类型未定")
    let family = matchFamilyOf(map = map, typeId = subjectType)
    var owner = ""
    if subjectType < irTypeCount(map.pool):
        owner = irTypeAt(pool = map.pool, id = subjectType).name
    let intType = map.i32Id
    let tempName = "$match" + countText(stmtId)
    let placedTemp = internText(texts = done.texts, value = tempName)
    let subjectSlot = done.frame.nextSlot
    var anchor = irMakeNode(kind = irStmtTag(.irAllocVar), typeId = subjectType)
    anchor.text = placedTemp.id
    anchor.intValue = done.frame.nextSlot as I64
    anchor.kids = [subject.id]
    ; 主语先落槽再逐支复读：接收动作照存储点同一套填，别名才不会与槽共用一份。
    anchor = fillStore(node = anchor, pool = map.pool, nodes = done.pool, targetTypeId = subjectType, valueId = subject.id, sharingStructs = false, covers = false)
    let insertedAnchor = irAppendNode(pool = done.pool, node = anchor)
    done.texts = placedTemp.texts
    done.pool = insertedAnchor.pool
    done.positions = recordPosition(positions = done.positions, node = insertedAnchor.id, offset = unit.ast.stmtAt(stmtId).start)
    done.frame = declareIrLocal(frame = done.frame, name = tempName, typeId = subjectType, mutable = false)
    let reload = makeLoadNode(pool = done.pool, texts = done.texts, name = tempName, typeId = subjectType, slot = done.frame.nextSlot - 1)
    done.pool = reload.pool
    done.texts = reload.texts
    var conds: Array<I32> = []
    var blockIds: Array<I32> = []
    var blockStart: Array<I32> = []
    var blockLen: Array<I32> = []
    var elseIds: Array<I32> = []
    var i = 1
    while i + 1 < len(kids):
        let info = classifyPattern(unit = unit, node = kids[i])
        var caseName = info.name
        if caseName == "nil":
            caseName = "none"
        var condId = -1
        if caseName != "_":
            if family == 0:
                let one = lowerExpr(pool = done.pool, texts = done.texts, map = map, types = types, unit = unit, unitIndex = unitIndex, bytes = bytes, frame = done.frame, id = kids[i])
                done.pool = one.pool
                done.texts = one.texts
                done.frame = one.frame
                if one.failed:
                    return takeStmtFailure(out = done, detail = one.detail, offset = one.offset)
                let cmp = addIrNode(pool = done.pool, kind = irExprTag(.irBinary), typeId = map.booleanId, op = irBinaryTag(.irEqual), kids = [reload.id, one.id])
                done.pool = cmp.pool
                condId = cmp.id
            else:
                var tag = matchCaseTagOf(family = family, caseName = caseName)
                if family == 1:
                    tag = enumCaseTag(frame = done.frame, owner = owner, caseName = caseName)
                if tag < 0:
                    return missStmt(out = done, unit = unit, stmtId = stmtId, what = "用例 " + caseName + " 不在 " + owner + " 的声明序里")
                let read = addIrNode(pool = done.pool, kind = irExprTag(.irEnumTagGet), typeId = intType, op = 0, kids = [reload.id])
                done.pool = read.pool
                var literal = irMakeNode(kind = irExprTag(.irIntConst), typeId = intType)
                literal.intValue = tag as I64
                let insertedLiteral = irAppendNode(pool = done.pool, node = literal)
                done.pool = insertedLiteral.pool
                let cmp = addIrNode(pool = done.pool, kind = irExprTag(.irBinary), typeId = map.booleanId, op = irBinaryTag(.irEqual), kids = [read.id, insertedLiteral.id])
                done.pool = cmp.pool
                condId = cmp.id
        let mark = frameMark(frame = done.frame)
        var armIds: Array<I32> = []
        if family != 0:
            var b = 0
            while b < len(info.bindings):
                let name = info.bindings[b]
                if name != "_":
                    let typeId = matchBindingIrType(frame = done.frame, map = map, family = family, subjectType = subjectType, owner = owner, caseName = caseName, index = b)
                    if typeId < 0:
                        return missStmt(out = done, unit = unit, stmtId = stmtId, what = "绑定 " + name + " 的载荷类型未定")
                    let placedCase = internText(texts = done.texts, value = caseName)
                    var read = irMakeNode(kind = irExprTag(.irEnumPayloadGet), typeId = typeId)
                    read.op = b
                    read.text = placedCase.id
                    read.kids = [reload.id]
                    let insertedRead = irAppendNode(pool = done.pool, node = read)
                    done.pool = insertedRead.pool
                    done.texts = placedCase.texts
                    let placedName = internText(texts = done.texts, value = name)
                    var local = irMakeNode(kind = irStmtTag(.irAllocVar), typeId = typeId)
                    local.text = placedName.id
                    local.intValue = done.frame.nextSlot as I64
                    local.kids = [insertedRead.id]
                    let insertedLocal = irAppendNode(pool = done.pool, node = local)
                    done.pool = insertedLocal.pool
                    done.positions = recordPosition(positions = done.positions, node = insertedLocal.id, offset = unit.ast.stmtAt(stmtId).start)
                    var bound = irNodeAt(pool = done.pool, id = insertedLocal.id)
                    bound = fillStore(node = bound, pool = map.pool, nodes = done.pool, targetTypeId = typeId, valueId = insertedRead.id, sharingStructs = false, covers = false)
                    var boundPool = done.pool
                    boundPool.nodes[insertedLocal.id] = bound
                    done.pool = boundPool
                    done.frame = declareIrLocal(frame = done.frame, name = name, typeId = typeId, mutable = false)
                    armIds = armIds.append(insertedLocal.id)
                b = b + 1
        elif len(info.bindings) > 0:
            return missStmt(out = done, unit = unit, stmtId = stmtId, what = "裸值匹配的绑定")
        let body = lowerBlockOf(out = done, unit = unit, bytes = bytes, map = map, types = types, unitIndex = unitIndex, blockId = kids[i + 1])
        done.pool = body.pool
        done.texts = body.texts
        done.frame = body.frame
        done.positions = body.positions
        if body.failed:
            return takeStmtFailure(out = done, detail = body.detail, offset = body.offset)
        var k = 0
        while k < len(body.ids):
            armIds = armIds.append(body.ids[k])
            k = k + 1
        done.frame = closeBlock(frame = done.frame, mark = mark)
        if condId < 0:
            elseIds = armIds
        else:
            conds = conds.append(condId)
            blockStart = blockStart.append(len(blockIds))
            blockLen = blockLen.append(len(armIds))
            k = 0
            while k < len(armIds):
                blockIds = blockIds.append(armIds[k])
                k = k + 1
        i = i + 2
    if family != 0 && len(elseIds) == 0:
        let placedMsg = internText(texts = done.texts, value = "Pini runtime error: match value matched no case")
        var trap = irMakeNode(kind = irStmtTag(.irPanicStmt), typeId = -1)
        trap.text = placedMsg.id
        let insertedTrap = irAppendNode(pool = done.pool, node = trap)
        done.texts = placedMsg.texts
        done.pool = insertedTrap.pool
        done.positions = recordPosition(positions = done.positions, node = insertedTrap.id, offset = unit.ast.stmtAt(stmtId).start)
        elseIds = [insertedTrap.id]
    var ids = elseIds
    var n = len(conds) - 1
    while n >= 0:
        var nodes: Array<I32> = [conds[n]]
        var e = 0
        while e < blockLen[n]:
            nodes = nodes.append(blockIds[blockStart[n] + e])
            e = e + 1
        let tail = len(nodes)
        var f = 0
        while f < len(ids):
            nodes = nodes.append(ids[f])
            f = f + 1
        var node = irMakeNode(kind = irStmtTag(.irIfStmt), typeId = -1)
        node.kids = nodes
        node.tail = tail
        let inserted = irAppendNode(pool = done.pool, node = node)
        done.pool = inserted.pool
        done.positions = recordPosition(positions = done.positions, node = inserted.id, offset = unit.ast.stmtAt(stmtId).start)
        ids = [inserted.id]
        n = n - 1
    var allIds: Array<I32> = [insertedAnchor.id]
    var m = 0
    while m < len(ids):
        allIds = allIds.append(ids[m])
        m = m + 1
    ; 主语槽用完即弃：否则可选 / 结果里的计数载荷会拖到函数出口，弱引用读到已该销毁的对象。
    var drop = irMakeNode(kind = irStmtTag(.irReleaseVar), typeId = subjectType)
    drop.intValue = subjectSlot as I64
    let insertedDrop = irAppendNode(pool = done.pool, node = drop)
    done.pool = insertedDrop.pool
    done.positions = recordPosition(positions = done.positions, node = insertedDrop.id, offset = unit.ast.stmtAt(stmtId).start)
    allIds = allIds.append(insertedDrop.id)
    done.ids = allIds
    return done

; 跳出与继续：只接无标签形态，深度一；带标签的控制流等标签面接线。
lowerJumpStmt|func(out: LowerStmt, unit: CompilationUnit, stmtId: I32, kind: IrStmtKind,) -> (LowerStmt,):
    let stmt = unit.ast.stmtAt(stmtId)
    if len(stmt.kids) > 0 && stmt.kids[0] >= 0:
        return missStmt(out = out, unit = unit, stmtId = stmtId, what = "带标签的跳出")
    var node = irMakeNode(kind = irStmtTag(kind), typeId = -1)
    node.op = 1
    return appendStmtNode(out = out, node = node, offset = stmt.start)

; 单条语句：按类别分派；`pass` 不产节点，其余未知类别报缺口。
lowerStmt|func(out: LowerStmt, unit: CompilationUnit, bytes: Array<U8>, map: TypeMap, types: ExprTypes, unitIndex: I32, stmtId: I32,) -> (LowerStmt,):
    if stmtId < 0 || stmtId >= unit.ast.stmtCount():
        var bad = out
        bad.failed = true
        bad.detail = "语句下标越界"
        return bad
    if unit.ast.isBlockStmt(stmtId):
        return lowerBlockOf(out = out, unit = unit, bytes = bytes, map = map, types = types, unitIndex = unitIndex, blockId = stmtId)
    if unit.ast.isVariableStmt(stmtId):
        return lowerVariableStmt(out = out, unit = unit, bytes = bytes, map = map, types = types, unitIndex = unitIndex, stmtId = stmtId)
    if unit.ast.isAssignStmt(stmtId):
        return lowerAssignStmt(out = out, unit = unit, bytes = bytes, map = map, types = types, unitIndex = unitIndex, stmtId = stmtId)
    if unit.ast.isExpressionStmt(stmtId):
        return lowerExprStmt(out = out, unit = unit, bytes = bytes, map = map, types = types, unitIndex = unitIndex, stmtId = stmtId)
    if unit.ast.isReturnStmt(stmtId):
        return lowerReturnStmt(out = out, unit = unit, bytes = bytes, map = map, types = types, unitIndex = unitIndex, stmtId = stmtId)
    if unit.ast.isIfStmt(stmtId):
        return lowerIfStmt(out = out, unit = unit, bytes = bytes, map = map, types = types, unitIndex = unitIndex, stmtId = stmtId)
    if unit.ast.isWhileStmt(stmtId):
        return lowerWhileStmt(out = out, unit = unit, bytes = bytes, map = map, types = types, unitIndex = unitIndex, stmtId = stmtId)
    if unit.ast.isMatchStmt(stmtId):
        return lowerMatchStmt(out = out, unit = unit, bytes = bytes, map = map, types = types, unitIndex = unitIndex, stmtId = stmtId)
    if unit.ast.isBreakStmt(stmtId):
        return lowerJumpStmt(out = out, unit = unit, stmtId = stmtId, kind = .irBreakStmt)
    if unit.ast.isContinueStmt(stmtId):
        return lowerJumpStmt(out = out, unit = unit, stmtId = stmtId, kind = .irContinueStmt)
    if unit.ast.isDetachStmt(stmtId):
        return lowerDetachStmt(out = out, unit = unit, bytes = bytes, map = map, types = types, unitIndex = unitIndex, stmtId = stmtId)
    if unit.ast.isPassStmt(stmtId):
        return out
    ; 捕获声明只在语义层生效：降载按首次使用登记捕获，声明行不产节点。
    if unit.ast.isCaptureStmt(stmtId):
        return out
    return missStmt(out = out, unit = unit, stmtId = stmtId, what = "该语句类别尚未降载")
