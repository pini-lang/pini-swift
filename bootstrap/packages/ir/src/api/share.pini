[share|import]
_semantics = "../../../semantics"

; 归还面：按 IR 类型给份额类别，按求值节点给求值效果，两者合成存储点的接收动作。
; 判据只用 IR 自身：类别看类型池条目，效果看节点类别与操作数类型，后端不按拼写反推。
; 判错的后果不对称：把新份额判成借用是漏一份，反过来是悬垂；拿不准时按借用。

; 份额类别：不参与、整块、值语义、计数四类，码序即判据序。
[IrShareClass]
irShareInert
irShareAggregate
irShareValueBox
irShareRetained

; 计数细分：字符串、字符、数组、字典、集合、对象、枚举、惰性引用。
[IrShareKind]
irShareString
irShareChar
irShareArray
irShareDict
irShareSet
irShareObject
irShareEnumeration
irShareLazyRef

; 求值效果：新份额、借用、不参与。
[IrShareEffect]
irEffectFresh
irEffectBorrowed
irEffectInert

; 接收动作：不接、移交、拷贝、保留。
[IrAdoptAction]
irAdoptNone
irAdoptTake
irAdoptCopyStruct
irAdoptRetain

; 类别码：与枚举项序一致，从 1 起；转储与诊断共用这一份拼写。
irShareClassTag|func(_kind: IrShareClass,) -> (I32,):
    match _kind:
        case irShareInert:
            return 1
        case irShareAggregate:
            return 2
        case irShareValueBox:
            return 3
        case irShareRetained:
            return 4
    return 0

; 细分码：从 1 起；非计数族答 0。
irShareKindTag|func(_kind: IrShareKind,) -> (I32,):
    match _kind:
        case irShareString:
            return 1
        case irShareChar:
            return 2
        case irShareArray:
            return 3
        case irShareDict:
            return 4
        case irShareSet:
            return 5
        case irShareObject:
            return 6
        case irShareEnumeration:
            return 7
        case irShareLazyRef:
            return 8
    return 0

; 效果码：与枚举项序一致，从 1 起。
irShareEffectTag|func(_kind: IrShareEffect,) -> (I32,):
    match _kind:
        case irEffectFresh:
            return 1
        case irEffectBorrowed:
            return 2
        case irEffectInert:
            return 3
    return 0

; 动作码：与枚举项序一致，从 0 起；0 就是「不接份额」。
irAdoptTag|func(_kind: IrAdoptAction,) -> (I32,):
    match _kind:
        case irAdoptNone:
            return 0
        case irAdoptTake:
            return 1
        case irAdoptCopyStruct:
            return 2
        case irAdoptRetain:
            return 3
    return 0

; 动作名：转储按码印名，未登记答问号加码。
irAdoptName|func(code: I32,) -> (String,):
    if code == 0:
        return "none"
    if code == 1:
        return "take"
    if code == 2:
        return "copyStruct"
    if code == 3:
        return "retain"
    return "?" + countText(code)

; 类别判定：按类型池条目逐类表态，不留兜底；新增类型必须在这里选一族。
; 不参与含标量、外部指针、任务句柄与 C 串句柄；整块含结果、可选、元组与函数值。
irShareClassOf|func(pool: IrTypePool, typeId: I32,) -> (I32,): ; 四族唯一判据：1 不参与 2 整块 3 值语义 4 计数
    if typeId < 0 || typeId >= irTypeCount(pool):
        return 1
    let entry = irTypeAt(pool = pool, id = typeId)
    let tag = irTypeTag(entry.kind)
    if tag == irTypeTag(.irTypeString) || tag == irTypeTag(.irTypeChar):
        return 4
    if tag == irTypeTag(.irTypeArray) || tag == irTypeTag(.irTypeDict) || tag == irTypeTag(.irTypeSet):
        return 4
    if tag == irTypeTag(.irTypeLazyRef) || tag == irTypeTag(.irTypeEnumeration):
        return 4
    if tag == irTypeTag(.irTypeNominal):
        if entry.flags % 2 == 1:
            return 4
        return 3
    if tag == irTypeTag(.irTypeResult) || tag == irTypeTag(.irTypeOptional):
        return 2
    if tag == irTypeTag(.irTypeTuple) || tag == irTypeTag(.irTypeFunction):
        return 2
    return 1

; 细分判定：只有计数族有细分，其余答 0；下划线名字不出包，跨包只认族码与类别。
_irShareKindOf|func(pool: IrTypePool, typeId: I32,) -> (I32,): ; 只对计数族有值，其余族答 0；拿它判握份额会整族漏份额
    if irShareClassOf(pool = pool, typeId = typeId) != 4:
        return 0 ; 非计数族到这里一律答 0，调用点据此静默不动作，份额就漏了
    let entry = irTypeAt(pool = pool, id = typeId)
    let tag = irTypeTag(entry.kind)
    if tag == irTypeTag(.irTypeString):
        return 1
    if tag == irTypeTag(.irTypeChar):
        return 2
    if tag == irTypeTag(.irTypeArray):
        return 3
    if tag == irTypeTag(.irTypeDict):
        return 4
    if tag == irTypeTag(.irTypeSet):
        return 5
    if tag == irTypeTag(.irTypeEnumeration):
        return 7
    if tag == irTypeTag(.irTypeLazyRef):
        return 8
    return 6

; 留份族码：后端选留份与归还入口的唯一依据，细分码不出包。
; 0 不动作 · 1 串 · 2 容器句柄 · 3 名义箱（值语义箱按名义族记账）。
;  注意  值语义箱的细分码是 0，按细分码算会把它判成不动作；本函数先看类别再看细分。
irRetainFamilyOf|func(pool: IrTypePool, typeId: I32,) -> (I32,):
    let classTag = irShareClassOf(pool = pool, typeId = typeId)
    if classTag == 3:
        return 3
    if classTag != 4:
        return 0
    let kind = _irShareKindOf(pool = pool, typeId = typeId)
    if kind == 1:
        return 1
    if kind == 2:
        return 0
    if kind == 6 || kind == 7:
        return 3
    if kind == 3 || kind == 4 || kind == 5 || kind == 8:
        return 2
    return 0

; 整块是否握份额：可选、结果取包装分量，元组看有没有计数成员，函数值恒无。
irAggregateHoldsShare|func(pool: IrTypePool, typeId: I32,) -> (Bool,):
    let entry = irTypeAt(pool = pool, id = typeId)
    let tag = irTypeTag(entry.kind)
    if tag == irTypeTag(.irTypeOptional) || tag == irTypeTag(.irTypeResult):
        if len(entry.kids) == 0:
            return false
        return irHoldsShare(pool = pool, typeId = entry.kids[0])
    if tag == irTypeTag(.irTypeTuple):
        var i = 0
        while i < len(entry.kids):
            if irHoldsShare(pool = pool, typeId = entry.kids[i]):
                return true
            i = i + 1
    return false

; 槽是否握份额：覆盖它之前要先还旧值；不参与与空名单整块答否。
irHoldsShare|func(pool: IrTypePool, typeId: I32,) -> (Bool,): ; 值语义箱也握份额，判它一律走这里；按细分码判会整族漏份额
    let classTag = irShareClassOf(pool = pool, typeId = typeId)
    if classTag == 3 || classTag == 4:
        return true
    if classTag == 2:
        return irAggregateHoldsShare(pool = pool, typeId = typeId)
    return false

; 求值效果：先按节点类别分档，构造类与下标读再看类型，连接看操作数是不是任务句柄。
; 读别名位置（变量、字段、载荷、下标）答借用；本次求值造出来的值答新份额。
irShareEffectOf|func(pool: IrTypePool, nodes: IrNodePool, nodeId: I32,) -> (I32,):
    if nodeId < 0 || nodeId >= irNodeCount(nodes):
        return 3
    let node = irNodeAt(pool = nodes, id = nodeId)
    let kind = node.kind
    if kind == irExprTag(.irIntConst) || kind == irExprTag(.irFloatConst):
        return 3
    if kind == irExprTag(.irBoolConst) || kind == irExprTag(.irShortCircuit):
        return 3
    ; 字符串面二元即拼接，求值当场造新串；比较与算术的结果不握份额。
    if kind == irExprTag(.irBinary):
        if irHoldsShare(pool = pool, typeId = node.typeId):
            return 1
        return 3
    if kind == irExprTag(.irUnary) || kind == irExprTag(.irLenCall) || kind == irExprTag(.irIsAsciiDigit):
        return 3
    if kind == irExprTag(.irStringContains) || kind == irExprTag(.irStringIndexOf):
        return 3
    if kind == irExprTag(.irPointerLoad) || kind == irExprTag(.irPointerStore):
        return 3
    if kind == irExprTag(.irAddressOfVar) || kind == irExprTag(.irForeignDataAddress):
        return 3
    if kind == irExprTag(.irEnumTagGet) || kind == irExprTag(.irPrintCall) || kind == irExprTag(.irPrintMulti):
        return 3
    if kind == irExprTag(.irAssertCall) || kind == irExprTag(.irFileWrite) || kind == irExprTag(.irFileAppend):
        return 3
    if kind == irExprTag(.irFileTryWrite) || kind == irExprTag(.irFileTryAppend):
        return 3
    if kind == irExprTag(.irStringConst) || kind == irExprTag(.irLoad):
        return 2
    if kind == irExprTag(.irFieldGet) || kind == irExprTag(.irEnumPayloadGet):
        return 2
    if kind == irExprTag(.irLazyRefValue) || kind == irExprTag(.irFunctionValue):
        return 2
    if kind == irExprTag(.irCFunctionAddress) || kind == irExprTag(.irGivenInstance):
        return 2
    if kind == irExprTag(.irReadLine):
        return 2
    if kind == irExprTag(.irResultConstruct) || kind == irExprTag(.irOptionalConstruct):
        if irHoldsShare(pool = pool, typeId = node.typeId):
            return 1
        return 3
    if kind == irExprTag(.irTupleConstruct):
        if irHoldsShare(pool = pool, typeId = node.typeId):
            return 1
        return 3
    if kind == irExprTag(.irSubscriptGet):
        return subscriptEffect(pool = pool, nodes = nodes, node = node)
    if kind == irExprTag(.irJoin):
        return joinEffect(pool = pool, nodes = nodes, node = node)
    return 1

; 下标读的效果：数组元素是借用；字符串下标当场造一个字符，那是新份额。
subscriptEffect|func(pool: IrTypePool, nodes: IrNodePool, node: IrNode,) -> (I32,):
    if node.typeId < 0 || node.typeId >= irTypeCount(pool):
        return 2
    if irTypeTag(irTypeAt(pool = pool, id = node.typeId).kind) != irTypeTag(.irTypeChar): ; 判类型身份（字符）；按握份额判会让每次字符读都多留一份
        return 2
    if len(node.kids) == 0:
        return 2
    let container = irNodeAt(pool = nodes, id = node.kids[0])
    let tag = irTypeTag(irTypeAt(pool = pool, id = container.typeId).kind)
    if tag == irTypeTag(.irTypeString):
        return 1
    return 2

; 连接的效果：作用在任务句柄上是新份额，作用在已结算的结果上原样透传。
joinEffect|func(pool: IrTypePool, nodes: IrNodePool, node: IrNode,) -> (I32,):
    if len(node.kids) == 0:
        return 2
    let subject = irNodeAt(pool = nodes, id = node.kids[0])
    let tag = irTypeTag(irTypeAt(pool = pool, id = subject.typeId).kind)
    if tag != irTypeTag(.irTypeFuture):
        return 2
    if irHoldsShare(pool = pool, typeId = node.typeId):
        return 1
    return 3

; 接收动作：目标类型不握份额即不接；来源是新份额即移交，否则按类别拷贝或保留。
; `sharingStructs` 给容器元素用：元素按箱共享，变量、字段与返回才拷出独立的箱。
irAdoptOf|func(pool: IrTypePool, targetTypeId: I32, effect: I32, sharingStructs: Bool,) -> (I32,):
    let classTag = irShareClassOf(pool = pool, typeId = targetTypeId)
    if classTag == 1:
        return 0
    if classTag == 2:
        if !irAggregateHoldsShare(pool = pool, typeId = targetTypeId):
            return 0
        if effect == 1:
            return 1
        return 3
    if effect == 1:
        return 1
    if classTag == 3:
        if sharingStructs:
            return 3
        return 2
    return 3
