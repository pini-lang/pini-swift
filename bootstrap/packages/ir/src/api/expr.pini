[expr|import]
_syntax = "../../../syntax"
_semantics = "../../../semantics"
_module_loader = "../../../module-loader"

; 函数字面量：体挂在本节点的 `kids`，另建同体函数条目供发射期出定义。
; 帧换成闭包帧：形参占低位槽，外层可见名字按首次使用登记为捕获；
; 捕获槽记的是创建点外层帧的槽位，env 由发射期按同序填槽地址。
lowerClosure|func(out: LowerExpr, unit: CompilationUnit, bytes: Array<U8>, map: TypeMap, types: ExprTypes, unitIndex: I32, id: I32,) -> (LowerExpr,):
    let expr = unit.ast.exprAt(id)
    var done = out
    let typeId = exprIrType(map = map, types = types, unit = unit, unitIndex = unitIndex, frame = done.frame, bytes = bytes, id = id)
    if typeId < 0:
        return missType(out = done, unit = unit, id = id, bytes = bytes)
    var closure = LowerFrame()
    closure.world = done.frame.world
    closure.decls = done.frame.decls
    closure.externData = done.frame.externData
    closure.externs = done.frame.externs
    closure.outerLocals = done.frame.locals
    var params: Array<IrParam> = []
    var body = -1
    var i = 0
    while i < len(expr.kids):
        let kid = expr.kids[i]
        if i == len(expr.kids) - 1 && unit.ast.isBlockStmt(kid):
            body = kid
        else:
            let decl = unit.ast.decls[kid]
            let name = decodeSpelling(bytes = bytes, start = decl.nameStart, end = decl.nameEnd)
            var param = IrParam()
            param.name = name
            ; 形参类型取声明标注：匿名函数的形参不经过顶层声明面，类型表里查不到。
            if decl.typeId >= 0:
                let resolved = annotationType(world = closure.world, unit = unit, node = decl.typeId, pool = closure.world.types.pool)
                param.typeId = irIdOf(map = map, semanticId = resolved.id)
            param.slot = closure.nextSlot
            params = params.append(param)
            closure = declareIrLocal(frame = closure, name = name, typeId = param.typeId, mutable = true)
        i = i + 1
    var ret = -1
    if expr.op >= 0:
        let resolved = annotationType(world = closure.world, unit = unit, node = expr.op, pool = closure.world.types.pool)
        if isEmptyTupleType(pool = resolved.pool, id = resolved.id):
            ret = -1
        else:
            ret = irIdOf(map = map, semanticId = resolved.id)
    if body < 0:
        return missExpr(out = done, unit = unit, id = id, what = "函数字面量缺体块")
    var start = LowerStmt()
    start.pool = done.pool
    start.texts = done.texts
    start.frame = closure
    let lowered = lowerBlockOf(out = start, unit = unit, bytes = bytes, map = map, types = types, unitIndex = unitIndex, blockId = body)
    if lowered.failed:
        done.failed = true
        done.detail = lowered.detail
        done.offset = lowered.offset
        return done
    var fn = IrFunction()
    fn.name = "__closure_" + countText(id)
    fn.params = params
    fn.returnType = ret
    fn.body = lowered.ids
    fn.positions = lowered.positions
    fn.isClosure = true
    fn.closureId = id
    fn.captures = lowered.frame.captures
    var c = 0
    while c < len(lowered.frame.closures):
        done.frame.closures = done.frame.closures.append(lowered.frame.closures[c])
        c = c + 1
    done.frame.closures = done.frame.closures.append(fn)
    done.frame.externs = mergeExternFunction(table = done.frame.externs, more = lowered.frame.externs)
    let placed = internText(texts = lowered.texts, value = fn.name)
    var node = irMakeNode(kind = irExprTag(.irClosureLiteral), typeId = typeId)
    node.text = placed.id
    node.intValue = id as I64
    node.kids = lowered.ids
    var slots: Array<I32> = []
    var s = 0
    while s < len(lowered.frame.captures):
        slots = slots.append(lowered.frame.captures[s].slot)
        s = s + 1
    node.captureSlots = slots
    let inserted = irAppendNode(pool = lowered.pool, node = node)
    done.pool = inserted.pool
    done.texts = placed.texts
    done.id = inserted.id
    return done

; 表达式降载：AST 节点 + 推导表 + 局部帧 → IR 节点。
; 运算符按符号映射，不看记号码；类型一律取自推导表经映射后的下标。
; 推不出类型或类别未支持即整函数留空并报缺口，不产占位节点。

; 二元运算：项序与宿主 IRBinaryOp 一致，码从 1 起。
[IrBinaryOp]
irAdd
irSubtract
irMultiply
irDivide
irModulo
irEqual
irNotEqual
irLessThan
irLessThanOrEqual
irGreaterThan
irGreaterThanOrEqual
irBitwiseAnd
irBitwiseOr
irBitwiseXor
irLeftShift
irRightShift
irMinOf
irMaxOf

; 一元运算：项序与宿主 IRUnaryOp 一致。
[IrUnaryOp]
irNegate
irLogicalNot
irBitwiseNot
irAbs
irCast

; 逻辑运算：短路求值，与按值二元运算分开。
[IrLogicalOp]
irLogicalAnd
irLogicalOr

; 文本驻留结果：池与下标。
(TextInsert)
texts: IrTextPool = IrTextPool()
id: I32 = -1

; 表达式降载结果：节点池、文本池、帧、节点下标与失败原因。
(LowerExpr)
pool: IrNodePool = IrNodePool()
texts: IrTextPool = IrTextPool()
frame: LowerFrame = LowerFrame()
id: I32 = -1
failed: Bool = false
detail: String = ""
offset: I32 = 0

; 二元码：与枚举项序一致，从 1 起。
irBinaryTag|func(_op: IrBinaryOp,) -> (I32,):
    match _op:
        case irAdd:
            return 1
        case irSubtract:
            return 2
        case irMultiply:
            return 3
        case irDivide:
            return 4
        case irModulo:
            return 5
        case irEqual:
            return 6
        case irNotEqual:
            return 7
        case irLessThan:
            return 8
        case irLessThanOrEqual:
            return 9
        case irGreaterThan:
            return 10
        case irGreaterThanOrEqual:
            return 11
        case irBitwiseAnd:
            return 12
        case irBitwiseOr:
            return 13
        case irBitwiseXor:
            return 14
        case irLeftShift:
            return 15
        case irRightShift:
            return 16
        case irMinOf:
            return 17
        case irMaxOf:
            return 18
    return 0

; 一元码：与枚举项序一致，从 1 起。
irUnaryTag|func(_op: IrUnaryOp,) -> (I32,):
    match _op:
        case irNegate:
            return 1
        case irLogicalNot:
            return 2
        case irBitwiseNot:
            return 3
        case irAbs:
            return 4
        case irCast:
            return 5
    return 0

; 逻辑码：与枚举项序一致，从 1 起。
irLogicalTag|func(_op: IrLogicalOp,) -> (I32,):
    match _op:
        case irLogicalAnd:
            return 1
        case irLogicalOr:
            return 2
    return 0

; 二元码按符号：符号未登记答 0，调用方据此报缺口。
binaryTagOf|func(spelling: String,) -> (I32,):
    if spelling == "+":
        return irBinaryTag(.irAdd)
    if spelling == "-":
        return irBinaryTag(.irSubtract)
    if spelling == "*":
        return irBinaryTag(.irMultiply)
    if spelling == "/":
        return irBinaryTag(.irDivide)
    if spelling == "%":
        return irBinaryTag(.irModulo)
    if spelling == "==":
        return irBinaryTag(.irEqual)
    if spelling == "!=":
        return irBinaryTag(.irNotEqual)
    if spelling == "<":
        return irBinaryTag(.irLessThan)
    if spelling == "<=":
        return irBinaryTag(.irLessThanOrEqual)
    if spelling == ">":
        return irBinaryTag(.irGreaterThan)
    if spelling == ">=":
        return irBinaryTag(.irGreaterThanOrEqual)
    if spelling == "&":
        return irBinaryTag(.irBitwiseAnd)
    if spelling == "|":
        return irBinaryTag(.irBitwiseOr)
    if spelling == "^":
        return irBinaryTag(.irBitwiseXor)
    if spelling == "<<":
        return irBinaryTag(.irLeftShift)
    if spelling == ">>":
        return irBinaryTag(.irRightShift)
    return 0

; 一元码按符号：取负、逻辑非、按位取反；其余答 0。
unaryTagOf|func(spelling: String,) -> (I32,):
    if spelling == "-":
        return irUnaryTag(.irNegate)
    if spelling == "!":
        return irUnaryTag(.irLogicalNot)
    if spelling == "~":
        return irUnaryTag(.irBitwiseNot)
    return 0

; 整数拼写转值：认十进制与 0x / 0b / 0o 前缀，下划线跳过，非法字符按 0 进值。
; 只处理非负写法：源里的负数是取负一元节点，不在拼写里。
intSpellingValue|func(text: String,) -> (I64,):
    let pieces = chars(text)
    var base: I64 = 10
    var start = 0
    if len(pieces) > 2 && ord(pieces[0]) == 48:
        let mark = ord(pieces[1])
        if mark == 120 || mark == 88:
            base = 16
            start = 2
        elif mark == 98 || mark == 66:
            base = 2
            start = 2
        elif mark == 111 || mark == 79:
            base = 8
            start = 2
    var value: I64 = 0
    var i = start
    while i < len(pieces):
        let code = ord(pieces[i])
        var digit: I64 = 0
        if code >= 48 && code <= 57:
            digit = (code - 48) as I64
        elif code >= 97 && code <= 102:
            digit = (code - 87) as I64
        elif code >= 65 && code <= 70:
            digit = (code - 55) as I64
        if code != 95:
            value = value * base + digit
        i = i + 1
    return value

; 造节点并入池：类别、类型、算符与子节点一次写齐。
addIrNode|func(pool: IrNodePool, kind: I32, typeId: I32, op: I32, kids: Array<I32>,) -> (IrNodeInsert,):
    var node = irMakeNode(kind = kind, typeId = typeId)
    node.op = op
    node.kids = kids
    return irAppendNode(pool = pool, node = node)

; 类型后备：推导表不覆盖非字面量初始化的局部，其下游的下标读与字段读同样落空，这里按形状补判。
; 比较与逻辑答布尔，一元答操作数类型，成员查字段声明，下标按容器分量取；待推导表补面后删除。
fallbackIrType|func(map: TypeMap, types: ExprTypes, unit: CompilationUnit, unitIndex: I32, frame: LowerFrame, bytes: Array<U8>, id: I32,) -> (I32,):
    if id < 0 || id >= unit.ast.exprCount():
        return -1
    let expr = unit.ast.exprAt(id)
    if unit.ast.isBinaryExpr(id):
        let spelling = opSymbol(expr.op)
        if spelling == "==" || spelling == "!=":
            return map.booleanId
        if spelling == "<" || spelling == "<=":
            return map.booleanId
        if spelling == ">" || spelling == ">=":
            return map.booleanId
        if spelling == "&&" || spelling == "||":
            return map.booleanId
        if len(expr.kids) > 0:
            return exprIrType(map = map, types = types, unit = unit, unitIndex = unitIndex, frame = frame, bytes = bytes, id = expr.kids[0])
        return -1
    if unit.ast.isUnaryExpr(id):
        if opSymbol(expr.op) == "!":
            return map.booleanId
        if len(expr.kids) > 0:
            return exprIrType(map = map, types = types, unit = unit, unitIndex = unitIndex, frame = frame, bytes = bytes, id = expr.kids[0])
        return -1
    if unit.ast.isMemberExpr(id):
        if len(expr.kids) < 1:
            return -1
        let recv: I32 = expr.kids[0]
        let owner = receiverOwner(map = map, typeId = exprIrType(map = map, types = types, unit = unit, unitIndex = unitIndex, frame = frame, bytes = bytes, id = recv))
        if len(owner) == 0:
            return -1
        let fieldName = decodeSpelling(bytes = bytes, start = expr.nameStart, end = expr.nameEnd)
        return irIdOf(map = map, semanticId = fieldTypeOf(frame = frame, owner = owner, fieldName = fieldName))
    if unit.ast.isSubscriptExpr(id):
        if len(expr.kids) < 1:
            return -1
        let containerType = exprIrType(map = map, types = types, unit = unit, unitIndex = unitIndex, frame = frame, bytes = bytes, id = expr.kids[0])
        if containerType < 0 || containerType >= irTypeCount(map.pool):
            return -1
        let entry = irTypeAt(pool = map.pool, id = containerType)
        let tag = irTypeTag(entry.kind)
        if tag == irTypeTag(.irTypeArray):
            if len(entry.kids) > 0:
                return entry.kids[0]
            return -1
        if tag == irTypeTag(.irTypeDict):
            if len(entry.kids) > 1:
                return entry.kids[1]
            return -1
        if tag == irTypeTag(.irTypeString):
            return map.charId
        return -1
    return -1

; 表达式类型：先读推导表，标识符回查帧，最后按运算符形状取后备；都没有答 -1。
exprIrType|func(map: TypeMap, types: ExprTypes, unit: CompilationUnit, unitIndex: I32, frame: LowerFrame, bytes: Array<U8>, id: I32,) -> (I32,):
    let known = exprTypeAt(table = types, unit = unitIndex, node = id)
    if known >= 0:
        return irIdOf(map = map, semanticId = known)
    if id < 0 || id >= unit.ast.exprCount():
        return -1
    if unit.ast.isIdentifierExpr(id):
        let expr = unit.ast.exprAt(id)
        let name = decodeSpelling(bytes = bytes, start = expr.nameStart, end = expr.nameEnd)
        let at = findIrLocal(frame = frame, name = name)
        if at >= 0:
            return frame.locals[at].typeId
        let outerAt = findOuterLocal(frame = frame, name = name)
        if outerAt >= 0:
            return frame.outerLocals[outerAt].typeId
    return fallbackIrType(map = map, types = types, unit = unit, unitIndex = unitIndex, frame = frame, bytes = bytes, id = id)

; 报写法需改：与 missExpr 分开，因为这句话不是能力缺口，而是调用点该换写法。
missNeed|func(out: LowerExpr, unit: CompilationUnit, id: I32, what: String,) -> (LowerExpr,):
    var done = out
    done.failed = true
    done.detail = what
    if id >= 0 && id < unit.ast.exprCount():
        done.offset = unit.ast.exprAt(id).start
    return done

; 缺类型：类型未定或不可映射；偏移记在结果上，由调用方写进错误表。
; 细节带类别名，标识符另带拼写：同一句「类型未定」的修法按类别与名字分，分不出就分不出批。
missType|func(out: LowerExpr, unit: CompilationUnit, id: I32, bytes: Array<U8>,) -> (LowerExpr,):
    var done = out
    done.failed = true
    done.detail = "表达式类型未定"
    if id >= 0 && id < unit.ast.exprCount():
        done.offset = unit.ast.exprAt(id).start
        done.detail = done.detail + " " + exprKindName(unit.ast.exprAt(id).kind)
        if unit.ast.isIdentifierExpr(id):
            let node = unit.ast.exprAt(id)
            done.detail = done.detail + " " + decodeSpelling(bytes = bytes, start = node.nameStart, end = node.nameEnd)
    return done

; 缺能力：类别尚未降载，带类别与位置，不产占位节点。
missExpr|func(out: LowerExpr, unit: CompilationUnit, id: I32, what: String,) -> (LowerExpr,):
    var done = out
    done.failed = true
    done.detail = what + " 尚未降载"
    if id >= 0 && id < unit.ast.exprCount():
        done.offset = unit.ast.exprAt(id).start
    return done

; 失败转发：子节点已失败时把原因原样上抛，不覆盖位置与细节。
takeFailure|func(out: LowerExpr, one: LowerExpr,) -> (LowerExpr,):
    var done = out
    done.pool = one.pool
    done.texts = one.texts
    done.frame = one.frame
    done.failed = true
    done.detail = one.detail
    done.offset = one.offset
    return done

; 标识符：局部与顶层符号同形，都降成按名读；槽位由帧给出。
; 裸标识符：名字表命中即按变量读；未命中但命中用例表，说明写成了裸名用例。
; 裸名用例不成立：用例是枚举的成员，必须写成前导点或限定形式，故报缺口推动改写。
lowerIdentifier|func(out: LowerExpr, unit: CompilationUnit, bytes: Array<U8>, map: TypeMap, types: ExprTypes, unitIndex: I32, id: I32,) -> (LowerExpr,):
    let typeId = exprIrType(map = map, types = types, unit = unit, unitIndex = unitIndex, frame = out.frame, bytes = bytes, id = id)
    if typeId < 0:
        let expr = unit.ast.exprAt(id)
        let name = decodeSpelling(bytes = bytes, start = expr.nameStart, end = expr.nameEnd)
        let candidates = caseCandidateCount(index = out.frame.world.symbols, name = name)
        if candidates > 0:
            return missNeed(out = out, unit = unit, id = id, what = "裸名用例 " + name + " 须写成 ." + name + "（候选枚举 " + countText(candidates) + " 个）")
        return missType(out = out, unit = unit, id = id, bytes = bytes)
    let expr = unit.ast.exprAt(id)
    let name = decodeSpelling(bytes = bytes, start = expr.nameStart, end = expr.nameEnd)
    let placed = internText(texts = out.texts, value = name)
    var current = out
    current.frame = ensureIrLocal(frame = current.frame, name = name)
    let at = findIrLocal(frame = current.frame, name = name)
    if at < 0:
        ; 外部数据符号：值位读的是符号存储的当前值，故取址后立即 pointerLoad。
        let dataType = foreignDataType(frame = current.frame, map = map, name = name)
        if dataType >= 0:
            var address = irMakeNode(kind = irExprTag(.irForeignDataAddress), typeId = dataType)
            address.text = placed.id
            let placedAddress = irAppendNode(pool = out.pool, node = address)
            var loaded = irMakeNode(kind = irExprTag(.irPointerLoad), typeId = typeId)
            loaded.kids = [placedAddress.id]
            let inserted = irAppendNode(pool = placedAddress.pool, node = loaded)
            var done = out
            done.texts = placed.texts
            done.pool = inserted.pool
            done.frame.externData = noteExternData(table = done.frame.externData, name = name, typeId = dataType)
            done.id = inserted.id
            return done
    var node = irMakeNode(kind = irExprTag(.irLoad), typeId = typeId)
    node.text = placed.id
    if at >= 0:
        node.intValue = current.frame.locals[at].slot as I64
    let inserted = irAppendNode(pool = out.pool, node = node)
    var done = out
    done.frame = current.frame
    done.texts = placed.texts
    done.pool = inserted.pool
    done.id = inserted.id
    return done

; 二元：短路逻辑单独成节点，其余按值二元；带标签实参的 `=` 不是运算，报缺口。
lowerBinary|func(out: LowerExpr, unit: CompilationUnit, bytes: Array<U8>, map: TypeMap, types: ExprTypes, unitIndex: I32, id: I32,) -> (LowerExpr,):
    if unit.ast.isLabeledArgument(id):
        return missExpr(out = out, unit = unit, id = id, what = "带标签实参")
    let expr = unit.ast.exprAt(id)
    var done = out
    var kids: Array<I32> = []
    var i = 0
    while i < len(expr.kids):
        let one = lowerExpr(pool = done.pool, texts = done.texts, map = map, types = types, unit = unit, unitIndex = unitIndex, bytes = bytes, frame = done.frame, id = expr.kids[i])
        done.pool = one.pool
        done.texts = one.texts
        done.frame = one.frame
        if one.failed:
            return takeFailure(out = done, one = one)
        kids = kids.append(one.id)
        i = i + 1
    let typeId = exprIrType(map = map, types = types, unit = unit, unitIndex = unitIndex, frame = done.frame, bytes = bytes, id = id)
    if typeId < 0:
        return missType(out = done, unit = unit, id = id, bytes = bytes)
    let spelling = opSymbol(expr.op)
    if spelling == "&&":
        let inserted = addIrNode(pool = done.pool, kind = irExprTag(.irShortCircuit), typeId = typeId, op = irLogicalTag(.irLogicalAnd), kids = kids)
        done.pool = inserted.pool
        done.id = inserted.id
        return done
    if spelling == "||":
        let inserted = addIrNode(pool = done.pool, kind = irExprTag(.irShortCircuit), typeId = typeId, op = irLogicalTag(.irLogicalOr), kids = kids)
        done.pool = inserted.pool
        done.id = inserted.id
        return done
    let op = binaryTagOf(spelling = spelling)
    if op == 0:
        return missExpr(out = done, unit = unit, id = id, what = "运算符 " + spelling)
    let inserted = addIrNode(pool = done.pool, kind = irExprTag(.irBinary), typeId = typeId, op = op, kids = kids)
    done.pool = inserted.pool
    done.id = inserted.id
    return done

; 一元：操作数是唯一子节点；符号未登记报缺口。取址先于值读，目标不是值。
lowerUnary|func(out: LowerExpr, unit: CompilationUnit, bytes: Array<U8>, map: TypeMap, types: ExprTypes, unitIndex: I32, id: I32,) -> (LowerExpr,):
    let expr = unit.ast.exprAt(id)
    var done = out
    let spelling = opSymbol(expr.op)
    if spelling == "&" && len(expr.kids) == 1:
        return lowerAddressOf(out = out, unit = unit, bytes = bytes, map = map, types = types, unitIndex = unitIndex, id = id, target = expr.kids[0])
    var kids: Array<I32> = []
    var i = 0
    while i < len(expr.kids):
        let one = lowerExpr(pool = done.pool, texts = done.texts, map = map, types = types, unit = unit, unitIndex = unitIndex, bytes = bytes, frame = done.frame, id = expr.kids[i])
        done.pool = one.pool
        done.texts = one.texts
        done.frame = one.frame
        if one.failed:
            return takeFailure(out = done, one = one)
        kids = kids.append(one.id)
        i = i + 1
    let op = unaryTagOf(spelling = spelling)
    if op == 0:
        return missExpr(out = done, unit = unit, id = id, what = "一元运算符 " + spelling)
    let typeId = exprIrType(map = map, types = types, unit = unit, unitIndex = unitIndex, frame = done.frame, bytes = bytes, id = id)
    if typeId < 0:
        return missType(out = done, unit = unit, id = id, bytes = bytes)
    let inserted = addIrNode(pool = done.pool, kind = irExprTag(.irUnary), typeId = typeId, op = op, kids = kids)
    done.pool = inserted.pool
    done.id = inserted.id
    return done

; 取址：局部取槽地址，外部数据符号取符号地址；两条路都不先读值。
; 节点类型取指针类型：它是「地址」这个值的类型，读写面据此取元素。
lowerAddressOf|func(out: LowerExpr, unit: CompilationUnit, bytes: Array<U8>, map: TypeMap, types: ExprTypes, unitIndex: I32, id: I32, target: I32,) -> (LowerExpr,):
    if !unit.ast.isIdentifierExpr(target):
        return missExpr(out = out, unit = unit, id = id, what = "取址目标不是变量")
    let pointerType = exprIrType(map = map, types = types, unit = unit, unitIndex = unitIndex, frame = out.frame, bytes = bytes, id = id)
    if pointerType < 0:
        return missType(out = out, unit = unit, id = id, bytes = bytes)
    let expr = unit.ast.exprAt(target)
    let name = decodeSpelling(bytes = bytes, start = expr.nameStart, end = expr.nameEnd)
    var done = out
    let placed = internText(texts = done.texts, value = name)
    done.texts = placed.texts
    done.frame = ensureIrLocal(frame = done.frame, name = name)
    let at = findIrLocal(frame = done.frame, name = name)
    if at < 0:
        let dataType = foreignDataType(frame = done.frame, map = map, name = name)
        if dataType < 0:
            return missExpr(out = out, unit = unit, id = id, what = "取址目标 " + name)
        var address = irMakeNode(kind = irExprTag(.irForeignDataAddress), typeId = pointerType)
        address.text = placed.id
        let inserted = irAppendNode(pool = done.pool, node = address)
        done.pool = inserted.pool
        done.frame.externData = noteExternData(table = done.frame.externData, name = name, typeId = dataType)
        done.id = inserted.id
        return done
    var node = irMakeNode(kind = irExprTag(.irAddressOfVar), typeId = pointerType)
    node.text = placed.id
    node.intValue = done.frame.locals[at].slot as I64
    let inserted = irAppendNode(pool = done.pool, node = node)
    done.pool = inserted.pool
    done.id = inserted.id
    return done

; 外部数据符号的 IR 类型：只认外部块里非函数类型的条目，其余答 -1。
foreignDataType|func(frame: LowerFrame, map: TypeMap, name: String,) -> (I32,):
    let symbol = lookupTopByName(index = frame.world.symbols, name = name)
    if symbol < 0:
        return -1
    let ref = symbolDecl(world = frame.world, symbol = symbol)
    if ref.unit < 0:
        return -1
    let unit = frame.world.units[ref.unit]
    let decl = unit.ast.decls[ref.decl]
    if !isForeignSymbolCode(decl.kind):
        return -1
    if decl.typeId < 0 || decl.typeId >= len(unit.ast.types):
        return -1
    if isFunctionTypeCode(unit.ast.types[decl.typeId].kind):
        return -1
    let semanticId = frame.world.types.typeOf(unit = ref.unit, decl = ref.decl)
    if semanticId < 0:
        return -1
    return irIdOf(map = map, semanticId = semanticId)

; 外部数据登记：同名只留一条，类型取首次登记；顺序即首次使用序。
noteExternData|func(table: Array<IrExternData>, name: String, typeId: I32,) -> (Array<IrExternData>,):
    var i = 0
    while i < len(table):
        if table[i].name == name:
            return table
        i = i + 1
    var row = IrExternData()
    row.name = name
    row.typeId = typeId
    return table.append(row)

; 实参：标签与降好的节点下标；标签为空即位置实参。
(IrActual)
label: String = ""
id: I32 = -1

; 归位结果：按形参声明序排好的节点下标；缺位时带原因。
(IrOrder)
ids: Array<I32> = []
usingSlots: Array<I32> = []
failed: Bool = false
detail: String = ""

; 被调方：IR 名、形参序、声明返回类型、是否按形参归位与是否带接收者首参。
(IrCallee)
found: Bool = false
name: String = ""
params: Array<CallParam> = []
ret: I32 = -1
ordered: Bool = false
takesReceiver: Bool = false
; 外部符号：symbol 供登记声明取标志，sigId 是语义函数类型，ret 取签名尾。
isForeign: Bool = false
symbol: I32 = -1
sigId: I32 = -1

; 读节点结果：池、文本池与节点下标；读改写先把目标读一次。
(IrLoadNode)
pool: IrNodePool = IrNodePool()
texts: IrTextPool = IrTextPool()
id: I32 = -1

; 字段类型：所有者名加字段名查符号，命中的字段声明给出语义类型下标。
; 名义类型的字段都带标注，故这里不需要再回溯推导表。
fieldTypeOf|func(frame: LowerFrame, owner: String, fieldName: String,) -> (I32,):
    let symbol = lookupMemberByName(index = frame.world.symbols, owner = owner, name = fieldName)
    let ref = symbolDecl(world = frame.world, symbol = symbol)
    if ref.unit < 0:
        return -1
    let decl = frame.world.units[ref.unit].ast.decls[ref.decl]
    if !isFieldDeclCode(decl.kind):
        return -1
    return frame.world.types.typeOf(unit = ref.unit, decl = ref.decl)

; 接收者所有者：名义与枚举答名字，其余答空串；空串说明按名找不到方法符号。
receiverOwner|func(map: TypeMap, typeId: I32,) -> (String,):
    if typeId < 0 || typeId >= irTypeCount(map.pool):
        return ""
    let entry = irTypeAt(pool = map.pool, id = typeId)
    let tag = irTypeTag(entry.kind)
    if tag == irTypeTag(.irTypeNominal):
        return entry.name
    if tag == irTypeTag(.irTypeEnumeration):
        return entry.name
    return ""

; 读节点：名字、槽位与类型给定，造一个按槽位读并把名字驻留进文本池。
; 名字只为诊断留底，后端按 `intValue` 的槽位取变量，不再解析名字。
makeLoadNode|func(pool: IrNodePool, texts: IrTextPool, name: String, typeId: I32, slot: I32,) -> (IrLoadNode,):
    let placed = internText(texts = texts, value = name)
    var node = irMakeNode(kind = irExprTag(.irLoad), typeId = typeId)
    node.text = placed.id
    node.intValue = slot as I64
    let inserted = irAppendNode(pool = pool, node = node)
    var out = IrLoadNode()
    out.pool = inserted.pool
    out.texts = placed.texts
    out.id = inserted.id
    return out

; 实参归位：标签按名对位，位置实参填剩余的不收标签位，结果按形参声明序。
; 缺位即失败并给原因：默认值与取用位不在降载期补，补出来是伪实现。
orderActuals|func(actuals: Array<IrActual>, params: Array<CallParam>,) -> (IrOrder,):
    var out = IrOrder()
    var slots: Array<I32> = []
    var i = 0
    while i < len(params):
        slots = slots.append(-1)
        i = i + 1
    var next = 0
    var e = 0
    while e < len(actuals):
        let actual = actuals[e]
        if len(actual.label) > 0:
            let at = paramIndexOf(params = params, name = actual.label)
            if at < 0:
                out.failed = true
                out.detail = "未知实参标签 " + actual.label
                return out
            if slots[at] >= 0:
                out.failed = true
                out.detail = "实参标签重复 " + actual.label
                return out
            slots[at] = actual.id
        else:
            while next < len(params) && slots[next] >= 0:
                next = next + 1
            if next >= len(params):
                out.failed = true
                out.detail = "实参个数超出形参表"
                return out
            if params[next].takesLabel:
                out.failed = true
                out.detail = "形参 " + params[next].name + " 需要标签"
                return out
            slots[next] = actual.id
            next = next + 1
        e = e + 1
    i = 0
    while i < len(slots):
        if slots[i] < 0:
            if params[i].isUsing:
                ; 取用位留给调用方补取用点：这里只记槽位，不算失败。
                out.usingSlots = out.usingSlots.append(i)
                i = i + 1
                continue
            out.failed = true
            if params[i].hasDefault:
                out.detail = "省略默认值实参"
            else:
                out.detail = "缺实参 " + params[i].name
            return out
        i = i + 1
    out.ids = slots
    return out

; 源序实参：不按形参归位时用源内次序，内建与被调方未知时走这条。
actualIds|func(actuals: Array<IrActual>,) -> (Array<I32>,):
    var out: Array<I32> = []
    var i = 0
    while i < len(actuals):
        out = out.append(actuals[i].id)
        i = i + 1
    return out

; 调用结果类型：空元组答 -1（IR 用 -1 表达空返回），判不出答 -2。
; 推导表没覆盖调用结果时退回声明返回类型，两者都缺才按缺口报。
callResultType|func(map: TypeMap, types: ExprTypes, unit: CompilationUnit, unitIndex: I32, frame: LowerFrame, bytes: Array<U8>, id: I32, ret: I32,) -> (I32,):
    let known = exprTypeAt(table = types, unit = unitIndex, node = id)
    var hint = known
    if hint < 0:
        hint = ret
    if hint >= 0:
        if isVoidReturn(pool = frame.world.types.pool, id = hint):
            return -1
        let mapped = irIdOf(map = map, semanticId = hint)
        if mapped >= 0:
            return mapped
    return -2

; 内建函数：包级符号表里没有的裸名在此查，形参一律位置传递，返回类型按形状入池。
; 有专属节点的内建不在此列：`print`、`assert`、`len`、指针读写与整份读写各自走专路。
calleeOfBuiltin|func(frame: LowerFrame, map: TypeMap, name: String,) -> (IrCallee,):
    var out = IrCallee()
    if name == "print" || name == "assert" || name == "len":
        return out
    if name == "load" || name == "store":
        return out
    if name == "writeFile" || name == "appendFile" || name == "readFile" || name == "readLine":
        return out
    if name == "tryReadFile" || name == "tryWriteFile" || name == "tryAppendFile":
        return out
    var i = 0
    while i < len(frame.world.functions):
        let fn = frame.world.functions[i]
        if fn.name == name:
            let typed = builtinParams(pool = frame.world.types.pool, params = fn.params)
            let retType = builtinShapeType(pool = typed.pool, shape = fn.ret, kids = [])
            out.found = true
            out.name = name
            out.params = typed.params
            out.ret = irIdOf(map = map, semanticId = retType.id)
            out.ordered = true
            return out
        i = i + 1
    return out

; 具名函数：裸名先查包级符号表，再查内建表；命中的函数声明给出形参序。
calleeOfFunction|func(frame: LowerFrame, map: TypeMap, name: String,) -> (IrCallee,):
    var out = IrCallee()
    let symbol = lookupTopByName(index = frame.world.symbols, name = name)
    if symbol < 0:
        return calleeOfBuiltin(frame = frame, map = map, name = name)
    let ref = symbolDecl(world = frame.world, symbol = symbol)
    if ref.unit < 0:
        return calleeOfBuiltin(frame = frame, map = map, name = name)
    let decl = frame.world.units[ref.unit].ast.decls[ref.decl]
    let entry = frame.world.table.symbolAt(symbol)
    if entry.isForeign:
        ; 外部条目不是函数声明类别，签名从符号绑定的类型取；变参标志随符号走。
        out.found = true
        out.isForeign = true
        out.symbol = symbol
        out.name = name
        out.sigId = frame.world.types.typeOf(unit = ref.unit, decl = ref.decl)
        if out.sigId >= 0 && out.sigId < len(frame.world.types.pool.entries):
            out.ret = frame.world.types.pool.entries[out.sigId].ret
        return out
    if !isFunctionDeclCode(decl.kind):
        return calleeOfBuiltin(frame = frame, map = map, name = name)
    out.found = true
    out.name = name
    out.params = declParams(world = frame.world, ref = ref)
    out.ret = frame.world.types.typeOf(unit = ref.unit, decl = ref.decl)
    out.ordered = true
    return out

; 实例方法：接收者类型名加方法名查符号，IR 名按「方法__类型」出，接收者作首参。
calleeOfMethod|func(frame: LowerFrame, map: TypeMap, pool: IrNodePool, receiver: I32, memberName: String,) -> (IrCallee,):
    var out = IrCallee()
    let owner = receiverOwner(map = map, typeId = irNodeAt(pool = pool, id = receiver).typeId)
    if len(owner) == 0:
        return out
    let symbol = lookupMemberByName(index = frame.world.symbols, owner = owner, name = memberName)
    let ref = symbolDecl(world = frame.world, symbol = symbol)
    if ref.unit < 0:
        return out
    let decl = frame.world.units[ref.unit].ast.decls[ref.decl]
    if !isFunctionDeclCode(decl.kind):
        return out
    out.found = true
    out.params = declParams(world = frame.world, ref = ref)
    out.ret = frame.world.types.typeOf(unit = ref.unit, decl = ref.decl)
    out.ordered = true
    if decl.isOwn:
        out.name = ownMethodName(method = memberName, owner = owner)
        out.takesReceiver = false
    else:
        out.name = instanceMethodName(method = memberName, owner = owner)
        out.takesReceiver = true
    return out

; 本型方法：接收者是类型名而非值，调用点不带接收者实参。
calleeOfOwnType|func(frame: LowerFrame, unit: CompilationUnit, bytes: Array<U8>, recvNode: I32, memberName: String,) -> (IrCallee,):
    var out = IrCallee()
    if !unit.ast.isIdentifierExpr(recvNode):
        return out
    let node = unit.ast.exprAt(recvNode)
    let recvName = decodeSpelling(bytes = bytes, start = node.nameStart, end = node.nameEnd)
    if findIrLocal(frame = frame, name = recvName) >= 0:
        return out
    let symbol = lookupMemberByName(index = frame.world.symbols, owner = recvName, name = memberName)
    let ref = symbolDecl(world = frame.world, symbol = symbol)
    if ref.unit < 0:
        return out
    let decl = frame.world.units[ref.unit].ast.decls[ref.decl]
    if !isFunctionDeclCode(decl.kind) || !decl.isOwn:
        return out
    out.found = true
    out.name = ownMethodName(method = memberName, owner = recvName)
    out.params = declParams(world = frame.world, ref = ref)
    out.ret = frame.world.types.typeOf(unit = ref.unit, decl = ref.decl)
    out.ordered = true
    return out

; 导入别名：`别名.函数` 是具名调用，别名只是限定符，不进实参。
calleeOfAlias|func(frame: LowerFrame, map: TypeMap, unit: CompilationUnit, bytes: Array<U8>, recvNode: I32, memberName: String,) -> (IrCallee,):
    var out = IrCallee()
    if !unit.ast.isIdentifierExpr(recvNode):
        return out
    let node = unit.ast.exprAt(recvNode)
    let recvName = decodeSpelling(bytes = bytes, start = node.nameStart, end = node.nameEnd)
    if findIrLocal(frame = frame, name = recvName) >= 0:
        return out
    if lookupImportByName(index = frame.world.symbols, file = unit.path, name = recvName) < 0:
        return out
    return calleeOfFunction(frame = frame, map = map, name = memberName)

; 零参构造类型：按名字与对象位查类型池里的名义条目；池里没有答 -1。
; 降载期不新增池条目：新条目传不回模块池，节点会指向不存在的类型。
zeroConstructType|func(map: TypeMap, name: String, isObject: Bool,) -> (I32,):
    var flags = 0
    if isObject:
        flags = 1
    return irFindType(pool = map.pool, kind = .irTypeNominal, name = name, kids = [], ret = -1, uses = [], flags = flags)

; 零参构造：字段初值按声明序展开成「字段号 + 表达式」对，随节点带走。
; 无初值或初值定不了型的字段不发对子，后端按字段类型清零；初值在声明所在单元取表达式。
lowerConstructDefaults|func(out: LowerExpr, map: TypeMap, types: ExprTypes, ref: DeclRef, typeId: I32,) -> (LowerExpr,):
    var done = out
    let declUnit = done.frame.world.units[ref.unit]
    let decl = declUnit.ast.decls[ref.decl]
    let declBytes = unitBytes(declUnit)
    var kids: Array<I32> = []
    var index = 0
    var i = 0
    while i < len(decl.kids):
        let child = declUnit.ast.decls[decl.kids[i]]
        if isFieldDeclCode(child.kind):
            if len(child.kids) > 0:
                let before = done
                let one = lowerExpr(pool = done.pool, texts = done.texts, map = map, types = types, unit = declUnit, unitIndex = ref.unit, bytes = declBytes, frame = done.frame, id = child.kids[0])
                if !one.failed:
                    var mark = irMakeNode(kind = irExprTag(.irIntConst), typeId = map.i32Id)
                    mark.intValue = index as I64
                    let placed = irAppendNode(pool = one.pool, node = mark)
                    done.pool = placed.pool
                    done.texts = one.texts
                    done.frame = one.frame
                    kids = kids.append(placed.id)
                    kids = kids.append(one.id)
                else:
                    done = before
            index = index + 1
        i = i + 1
    let inserted = addIrNode(pool = done.pool, kind = irExprTag(.irConstruct), typeId = typeId, op = 0, kids = kids)
    done.pool = inserted.pool
    done.id = inserted.id
    return done

; 给定类型名：形参类型落到名义条目、且该名字的声明是给定块才答名字，其余答空串。
givenTypeName|func(frame: LowerFrame, map: TypeMap, semanticTypeId: I32,) -> (String,):
    let irId = irIdOf(map = map, semanticId = semanticTypeId)
    if irId < 0:
        return ""
    let entry = irTypeAt(pool = map.pool, id = irId)
    if irTypeTag(entry.kind) != irTypeTag(.irTypeNominal):
        return ""
    let symbol = lookupTopByName(index = frame.world.symbols, name = entry.name)
    if symbol < 0:
        return ""
    let ref = symbolDecl(world = frame.world, symbol = symbol)
    if ref.unit < 0:
        return ""
    if isGivenDeclCode(frame.world.units[ref.unit].ast.decls[ref.decl].kind):
        return entry.name
    return ""

; 外部声明登记：名字、返回、形参与变参标志；同名只留一条。
; 类型映射不到时记 -1，发射期按 void 出；白名单外的类型在语义层已拒。
noteExternFunction|func(frame: LowerFrame, map: TypeMap, symbol: I32, sigId: I32, name: String,) -> (LowerFrame,):
    var out = frame
    if sigId < 0 || sigId >= len(out.world.types.pool.entries):
        return out
    let sig = out.world.types.pool.entries[sigId]
    let entry = out.world.table.symbolAt(symbol)
    var row = IrExternFunction()
    row.name = name
    row.returnType = irIdOf(map = map, semanticId = sig.ret)
    var i = 0
    while i < len(sig.kids):
        row.params = row.params.append(irIdOf(map = map, semanticId = sig.kids[i]))
        i = i + 1
    row.isVarargs = containsFlagText(items = entry.foreignFlags, name = "varargs")
    out.externs = mergeExternFunction(table = out.externs, more = [row])
    return out

; 外部调用：按源序传参、名字用 C 拼写；不接标签，也不进内建特判。
lowerForeignCall|func(out: LowerExpr, unit: CompilationUnit, bytes: Array<U8>, map: TypeMap, types: ExprTypes, unitIndex: I32, id: I32, name: String, actuals: Array<IrActual>, leading: I32, ret: I32,) -> (LowerExpr,):
    var done = out
    let typeId = callResultType(map = map, types = types, unit = unit, unitIndex = unitIndex, frame = done.frame, bytes = bytes, id = id, ret = ret)
    if typeId == -2:
        return missType(out = done, unit = unit, id = id, bytes = bytes)
    var kids: Array<I32> = []
    if leading >= 0:
        kids = kids.append(leading)
    var i = 0
    while i < len(actuals):
        kids = kids.append(actuals[i].id)
        i = i + 1
    let placed = internText(texts = done.texts, value = name)
    var node = irMakeNode(kind = irExprTag(.irCall), typeId = typeId)
    node.text = placed.id
    node.kids = kids
    let inserted = irAppendNode(pool = done.pool, node = node)
    done.texts = placed.texts
    done.pool = inserted.pool
    done.id = inserted.id
    return done

; 具名调用：实参按形参序归位，接收者（若有）排在最前；归位失败即报缺口。
lowerNamedCall|func(out: LowerExpr, unit: CompilationUnit, bytes: Array<U8>, map: TypeMap, types: ExprTypes, unitIndex: I32, id: I32, name: String, actuals: Array<IrActual>, params: Array<CallParam>, leading: I32, ret: I32,) -> (LowerExpr,):
    var done = out
    let order = orderActuals(actuals = actuals, params = params)
    if order.failed:
        return missExpr(out = done, unit = unit, id = id, what = order.detail)
    let typeId = callResultType(map = map, types = types, unit = unit, unitIndex = unitIndex, frame = done.frame, bytes = bytes, id = id, ret = ret)
    if typeId == -2:
        return missType(out = done, unit = unit, id = id, bytes = bytes)
    var kids: Array<I32> = []
    if leading >= 0:
        kids = kids.append(leading)
    var i = 0
    while i < len(order.ids):
        if order.ids[i] >= 0:
            kids = kids.append(order.ids[i])
            i = i + 1
            continue
        ; 省略的取用实参：该形参类型是给定块才补取用点，否则按缺口报。
        let givenName = givenTypeName(frame = done.frame, map = map, semanticTypeId = params[i].typeId)
        if len(givenName) == 0:
            return missExpr(out = done, unit = unit, id = id, what = "省略的取用实参没有默认实例")
        let givenType = irFindType(pool = map.pool, kind = .irTypeNominal, name = givenName, kids = [], ret = -1, uses = [], flags = 0)
        if givenType < 0:
            return missType(out = done, unit = unit, id = id, bytes = bytes)
        let point = addIrNode(pool = done.pool, kind = irExprTag(.irGivenInstance), typeId = givenType, op = 0, kids = [])
        done.pool = point.pool
        kids = kids.append(point.id)
        i = i + 1
    let placed = internText(texts = done.texts, value = name)
    var node = irMakeNode(kind = irExprTag(.irCall), typeId = typeId)
    node.text = placed.id
    node.kids = kids
    let inserted = irAppendNode(pool = done.pool, node = node)
    done.texts = placed.texts
    done.pool = inserted.pool
    done.id = inserted.id
    return done

; 按名调用：被调方未知或内建时按源序传参，名字就用源码里的拼写。
lowerPlainCall|func(out: LowerExpr, unit: CompilationUnit, bytes: Array<U8>, map: TypeMap, types: ExprTypes, unitIndex: I32, id: I32, name: String, actuals: Array<IrActual>, leading: I32,) -> (LowerExpr,):
    var done = out
    if name == "print" && len(actuals) == 1 && leading < 0:
        let inserted = addIrNode(pool = done.pool, kind = irExprTag(.irPrintCall), typeId = -1, op = 0, kids = [actuals[0].id])
        done.pool = inserted.pool
        done.id = inserted.id
        return done
    if name == "print" && len(actuals) > 1 && leading < 0:
        var printed: Array<I32> = []
        var p = 0
        while p < len(actuals):
            printed = printed.append(actuals[p].id)
            p = p + 1
        let inserted = addIrNode(pool = done.pool, kind = irExprTag(.irPrintMulti), typeId = -1, op = 0, kids = printed)
        done.pool = inserted.pool
        done.id = inserted.id
        return done
    if name == "assert" && len(actuals) > 0 && leading < 0:
        var checked: Array<I32> = []
        var p = 0
        while p < len(actuals):
            checked = checked.append(actuals[p].id)
            p = p + 1
        let inserted = addIrNode(pool = done.pool, kind = irExprTag(.irAssertCall), typeId = -1, op = 0, kids = checked)
        done.pool = inserted.pool
        done.id = inserted.id
        return done
    if name == "len" && len(actuals) == 1 && leading < 0:
        ; 长度是容器分派：结果恒为 I32，具体符号由后端按实参类型查表。
        if map.i32Id < 0:
            return missType(out = done, unit = unit, id = id, bytes = bytes)
        let inserted = addIrNode(pool = done.pool, kind = irExprTag(.irLenCall), typeId = map.i32Id, op = 0, kids = [actuals[0].id])
        done.pool = inserted.pool
        done.id = inserted.id
        return done
    if name == "load" && len(actuals) == 1 && leading < 0:
        let typeId = callResultType(map = map, types = types, unit = unit, unitIndex = unitIndex, frame = done.frame, bytes = bytes, id = id, ret = -1)
        if typeId == -2:
            return missType(out = done, unit = unit, id = id, bytes = bytes)
        let inserted = addIrNode(pool = done.pool, kind = irExprTag(.irPointerLoad), typeId = typeId, op = 0, kids = [actuals[0].id])
        done.pool = inserted.pool
        done.id = inserted.id
        return done
    if name == "store" && len(actuals) == 2 && leading < 0:
        ; 写无值：节点类型记 -1，槽里的旧值不归本节点归还。
        let inserted = addIrNode(pool = done.pool, kind = irExprTag(.irPointerStore), typeId = -1, op = 0, kids = [actuals[0].id, actuals[1].id])
        done.pool = inserted.pool
        done.id = inserted.id
        return done
    if name == "writeFile" && len(actuals) == 2 && leading < 0:
        let inserted = addIrNode(pool = done.pool, kind = irExprTag(.irFileWrite), typeId = -1, op = 0, kids = [actuals[0].id, actuals[1].id])
        done.pool = inserted.pool
        done.id = inserted.id
        return done
    if name == "appendFile" && len(actuals) == 2 && leading < 0:
        let inserted = addIrNode(pool = done.pool, kind = irExprTag(.irFileAppend), typeId = -1, op = 0, kids = [actuals[0].id, actuals[1].id])
        done.pool = inserted.pool
        done.id = inserted.id
        return done
    if name == "readFile" && len(actuals) == 1 && leading < 0:
        let typeId = callResultType(map = map, types = types, unit = unit, unitIndex = unitIndex, frame = done.frame, bytes = bytes, id = id, ret = -1)
        if typeId == -2:
            return missType(out = done, unit = unit, id = id, bytes = bytes)
        let inserted = addIrNode(pool = done.pool, kind = irExprTag(.irFileRead), typeId = typeId, op = 0, kids = [actuals[0].id])
        done.pool = inserted.pool
        done.id = inserted.id
        return done
    if name == "readLine" && len(actuals) == 0 && leading < 0:
        let typeId = callResultType(map = map, types = types, unit = unit, unitIndex = unitIndex, frame = done.frame, bytes = bytes, id = id, ret = -1)
        if typeId == -2:
            return missType(out = done, unit = unit, id = id, bytes = bytes)
        let inserted = addIrNode(pool = done.pool, kind = irExprTag(.irReadLine), typeId = typeId, op = 0, kids = [])
        done.pool = inserted.pool
        done.id = inserted.id
        return done
    if name == "tryReadFile" && len(actuals) == 1 && leading < 0:
        let typeId = callResultType(map = map, types = types, unit = unit, unitIndex = unitIndex, frame = done.frame, bytes = bytes, id = id, ret = -1)
        if typeId == -2:
            return missType(out = done, unit = unit, id = id, bytes = bytes)
        let inserted = addIrNode(pool = done.pool, kind = irExprTag(.irFileTryRead), typeId = typeId, op = 0, kids = [actuals[0].id])
        done.pool = inserted.pool
        done.id = inserted.id
        return done
    if name == "tryWriteFile" && len(actuals) == 2 && leading < 0:
        let typeId = callResultType(map = map, types = types, unit = unit, unitIndex = unitIndex, frame = done.frame, bytes = bytes, id = id, ret = -1)
        if typeId == -2:
            return missType(out = done, unit = unit, id = id, bytes = bytes)
        let inserted = addIrNode(pool = done.pool, kind = irExprTag(.irFileTryWrite), typeId = typeId, op = 0, kids = [actuals[0].id, actuals[1].id])
        done.pool = inserted.pool
        done.id = inserted.id
        return done
    if name == "tryAppendFile" && len(actuals) == 2 && leading < 0:
        let typeId = callResultType(map = map, types = types, unit = unit, unitIndex = unitIndex, frame = done.frame, bytes = bytes, id = id, ret = -1)
        if typeId == -2:
            return missType(out = done, unit = unit, id = id, bytes = bytes)
        let inserted = addIrNode(pool = done.pool, kind = irExprTag(.irFileTryAppend), typeId = typeId, op = 0, kids = [actuals[0].id, actuals[1].id])
        done.pool = inserted.pool
        done.id = inserted.id
        return done
    let typeId = callResultType(map = map, types = types, unit = unit, unitIndex = unitIndex, frame = done.frame, bytes = bytes, id = id, ret = -1)
    if typeId == -2:
        return missType(out = done, unit = unit, id = id, bytes = bytes)
    var kids: Array<I32> = []
    if leading >= 0:
        kids = kids.append(leading)
    let rest = actualIds(actuals = actuals)
    var i = 0
    while i < len(rest):
        kids = kids.append(rest[i])
        i = i + 1
    let placed = internText(texts = done.texts, value = name)
    var node = irMakeNode(kind = irExprTag(.irCall), typeId = typeId)
    node.text = placed.id
    node.kids = kids
    let inserted = irAppendNode(pool = done.pool, node = node)
    done.texts = placed.texts
    done.pool = inserted.pool
    done.id = inserted.id
    return done

; 惰性引用构造：`LazyRef<T>(closure)` 只认一个初值闭包，返回 `T` 的句柄。
; 元素类型取自类型实参，初值闭包的返回须与它同型；不同型即缺口，不做隐式转换。
lowerLazyRefConstruct|func(out: LowerExpr, unit: CompilationUnit, bytes: Array<U8>, map: TypeMap, types: ExprTypes, unitIndex: I32, id: I32, callee: I32,) -> (LowerExpr,):
    var done = out
    let typeId = exprIrType(map = map, types = types, unit = unit, unitIndex = unitIndex, frame = done.frame, bytes = bytes, id = id)
    if typeId < 0:
        return missType(out = done, unit = unit, id = id, bytes = bytes)
    let expr = unit.ast.exprAt(id)
    var argument = expr.kids[0]
    if callee != id:
        if len(expr.kids) != 2:
            return missNeed(out = done, unit = unit, id = id, what = "LazyRef 需要恰好一个初值闭包")
        argument = expr.kids[1]
    elif len(expr.kids) != 1:
        return missNeed(out = done, unit = unit, id = id, what = "LazyRef 需要恰好一个初值闭包")
    let one = lowerExpr(pool = done.pool, texts = done.texts, map = map, types = types, unit = unit, unitIndex = unitIndex, bytes = bytes, frame = done.frame, id = argument)
    done.pool = one.pool
    done.texts = one.texts
    done.frame = one.frame
    if one.failed:
        return takeFailure(out = done, one = one)
    let lazyType = irTypeAt(pool = map.pool, id = typeId)
    if irTypeTag(lazyType.kind) != irTypeTag(.irTypeLazyRef) || len(lazyType.kids) != 1:
        return missType(out = done, unit = unit, id = id, bytes = bytes)
    let closure = irNodeAt(pool = done.pool, id = one.id)
    if irTypeTag(irTypeAt(pool = map.pool, id = closure.typeId).kind) != irTypeTag(.irTypeFunction):
        return missNeed(out = done, unit = unit, id = id, what = "LazyRef 的实参不是闭包")
    if irTypeAt(pool = map.pool, id = closure.typeId).ret != lazyType.kids[0]:
        return missNeed(out = done, unit = unit, id = id, what = "初值闭包的返回与 LazyRef 元素类型不符")
    let inserted = addIrNode(pool = done.pool, kind = irExprTag(.irLazyRefConstruct), typeId = typeId, op = 0, kids = [one.id])
    done.pool = inserted.pool
    done.id = inserted.id
    return done

; 等待：操作数一个子节点，形式记在 `op`（0 = await，1 = wait）；站点类型是结算后的 Result。
; 上下文按帧的异步位硬判：`await` 只在异步体，`wait` 只在同步体，闭包帧不继承外层。
lowerJoin|func(out: LowerExpr, unit: CompilationUnit, bytes: Array<U8>, map: TypeMap, types: ExprTypes, unitIndex: I32, id: I32,) -> (LowerExpr,):
    var done = out
    let expr = unit.ast.exprAt(id)
    if len(expr.kids) != 1:
        return missExpr(out = done, unit = unit, id = id, what = "等待缺操作数")
    let awaits = unit.ast.isAwaitJoin(id)
    if awaits && !done.frame.isAsync:
        return missNeed(out = done, unit = unit, id = id, what = "`await` 只许出现在异步体内")
    if !awaits && done.frame.isAsync:
        return missNeed(out = done, unit = unit, id = id, what = "`wait` 只许出现在同步体内")
    let typeId = exprIrType(map = map, types = types, unit = unit, unitIndex = unitIndex, frame = done.frame, bytes = bytes, id = id)
    if typeId < 0:
        return missType(out = done, unit = unit, id = id, bytes = bytes)
    let one = lowerExpr(pool = done.pool, texts = done.texts, map = map, types = types, unit = unit, unitIndex = unitIndex, bytes = bytes, frame = done.frame, id = expr.kids[0])
    done.pool = one.pool
    done.texts = one.texts
    done.frame = one.frame
    if one.failed:
        return takeFailure(out = done, one = one)
    let handleType = irNodeAt(pool = done.pool, id = one.id).typeId
    if irTypeTag(irTypeAt(pool = map.pool, id = handleType).kind) != irTypeTag(.irTypeFuture):
        return missNeed(out = done, unit = unit, id = id, what = "等待目标不是任务句柄")
    var form = 1
    if awaits:
        form = 0
    let inserted = addIrNode(pool = done.pool, kind = irExprTag(.irJoin), typeId = typeId, op = form, kids = [one.id])
    done.pool = inserted.pool
    done.id = inserted.id
    return done

; 结果构造：载荷一个子节点，`op` 记标签（0 = ok，1 = err）；错误槽在发射期擦成一个机器字。
lowerResultConstruct|func(out: LowerExpr, unit: CompilationUnit, bytes: Array<U8>, map: TypeMap, types: ExprTypes, unitIndex: I32, id: I32, isOk: Bool,) -> (LowerExpr,):
    var done = out
    let expr = unit.ast.exprAt(id)
    if len(expr.kids) != 2:
        return missNeed(out = done, unit = unit, id = id, what = "结果构造需要恰好一个载荷")
    let typeId = exprIrType(map = map, types = types, unit = unit, unitIndex = unitIndex, frame = done.frame, bytes = bytes, id = id)
    if typeId < 0:
        return missType(out = done, unit = unit, id = id, bytes = bytes)
    let one = lowerExpr(pool = done.pool, texts = done.texts, map = map, types = types, unit = unit, unitIndex = unitIndex, bytes = bytes, frame = done.frame, id = expr.kids[1])
    done.pool = one.pool
    done.texts = one.texts
    done.frame = one.frame
    if one.failed:
        return takeFailure(out = done, one = one)
    var tag = 1
    if isOk:
        tag = 0
    let inserted = addIrNode(pool = done.pool, kind = irExprTag(.irResultConstruct), typeId = typeId, op = tag, kids = [one.id])
    done.pool = inserted.pool
    done.id = inserted.id
    return done

; 间接调用：被调是函数值，首个子节点是值的读取；形参类型取自函数类型，返回取签名尾。
; 实参个数与签名不符即缺口 —— 后端按签名定型，少一个多一个都会错位。
lowerIndirectCall|func(out: LowerExpr, unit: CompilationUnit, bytes: Array<U8>, map: TypeMap, types: ExprTypes, unitIndex: I32, callId: I32, calleeId: I32, fnType: I32,) -> (LowerExpr,):
    var done = out
    let calleeOne = lowerExpr(pool = done.pool, texts = done.texts, map = map, types = types, unit = unit, unitIndex = unitIndex, bytes = bytes, frame = done.frame, id = calleeId)
    done.pool = calleeOne.pool
    done.texts = calleeOne.texts
    done.frame = calleeOne.frame
    if calleeOne.failed:
        return takeFailure(out = done, one = calleeOne)
    let signature = irTypeAt(pool = map.pool, id = fnType)
    let expr = unit.ast.exprAt(callId)
    if len(expr.kids) - 1 != len(signature.kids):
        return missNeed(out = done, unit = unit, id = callId, what = "函数值调用的实参个数与签名不符")
    var kids: Array<I32> = [calleeOne.id]
    var i = 1
    while i < len(expr.kids):
        let one = lowerExpr(pool = done.pool, texts = done.texts, map = map, types = types, unit = unit, unitIndex = unitIndex, bytes = bytes, frame = done.frame, id = expr.kids[i])
        done.pool = one.pool
        done.texts = one.texts
        done.frame = one.frame
        if one.failed:
            return takeFailure(out = done, one = one)
        kids = kids.append(one.id)
        i = i + 1
    let inserted = addIrNode(pool = done.pool, kind = irExprTag(.irIndirectCall), typeId = signature.ret, op = 0, kids = kids)
    done.pool = inserted.pool
    done.id = inserted.id
    return done

; 调用：被调先解析成 IR 名与形参序，再按源序降实参，最后按形参序归位。
; 方法名按「方法__类型」出符号；标签实参在这里解包，标签本身不进节点。
lowerCall|func(out: LowerExpr, unit: CompilationUnit, bytes: Array<U8>, map: TypeMap, types: ExprTypes, unitIndex: I32, id: I32,) -> (LowerExpr,):
    let expr = unit.ast.exprAt(id)
    if len(expr.kids) < 1:
        return missExpr(out = out, unit = unit, id = id, what = "空调用")
    let callee: I32 = expr.kids[0]
    var done = out
    var resolved = IrCallee()
    var receiver = -1
    var builtinMember = ""
    var builtinType = -1
    var maybeCase = ""
    if unit.ast.isGenericExpr(callee):
        return lowerLazyRefConstruct(out = done, unit = unit, bytes = bytes, map = map, types = types, unitIndex = unitIndex, id = id, callee = callee)
    if unit.ast.isMemberExpr(callee):
        let member = unit.ast.exprAt(callee)
        if len(member.kids) < 1:
            return missExpr(out = done, unit = unit, id = id, what = "无接收者的成员被调")
        let memberName = decodeSpelling(bytes = bytes, start = member.nameStart, end = member.nameEnd)
        let recvNode: I32 = member.kids[0]
        resolved = calleeOfOwnType(frame = done.frame, unit = unit, bytes = bytes, recvNode = recvNode, memberName = memberName)
        if !resolved.found:
            resolved = calleeOfAlias(frame = done.frame, map = map, unit = unit, bytes = bytes, recvNode = recvNode, memberName = memberName)
        if resolved.found:
            receiver = -1
        else:
            let recvOne = lowerExpr(pool = done.pool, texts = done.texts, map = map, types = types, unit = unit, unitIndex = unitIndex, bytes = bytes, frame = done.frame, id = recvNode)
            done.pool = recvOne.pool
            done.texts = recvOne.texts
            done.frame = recvOne.frame
            if recvOne.failed:
                return takeFailure(out = done, one = recvOne)
            receiver = recvOne.id
            resolved = calleeOfMethod(frame = done.frame, map = map, pool = done.pool, receiver = receiver, memberName = memberName)
            if !resolved.found:
                let recvType = exprIrType(map = map, types = types, unit = unit, unitIndex = unitIndex, frame = done.frame, bytes = bytes, id = recvNode)
                let lazyElement = irLazyRefElement(pool = map.pool, id = recvType)
                if memberName == "value" && lazyElement >= 0 && len(expr.kids) == 1:
                    let inserted = addIrNode(pool = done.pool, kind = irExprTag(.irLazyRefValue), typeId = lazyElement, op = 0, kids = [receiver])
                    done.pool = inserted.pool
                    done.id = inserted.id
                    return done
                if isArrayMember(memberName = memberName, receiverType = recvType, map = map):
                    builtinMember = memberName
                    builtinType = recvType
                elif isStringMember(memberName = memberName, receiverType = recvType, map = map):
                    builtinMember = memberName
                    builtinType = recvType
                else:
                    return missExpr(out = done, unit = unit, id = id, what = "成员被调 " + memberName)
            if resolved.found && !resolved.takesReceiver:
                receiver = -1
    elif unit.ast.isIdentifierExpr(callee):
        let calleeExpr = unit.ast.exprAt(callee)
        let name = decodeSpelling(bytes = bytes, start = calleeExpr.nameStart, end = calleeExpr.nameEnd)
        if name == "ok" || name == "err":
            return lowerResultConstruct(out = done, unit = unit, bytes = bytes, map = map, types = types, unitIndex = unitIndex, id = id, isOk = name == "ok")
        ; 省略类型实参的构造：元素类型取自初值闭包的返回。
        if name == "LazyRef" && len(expr.kids) == 2:
            return lowerLazyRefConstruct(out = done, unit = unit, bytes = bytes, map = map, types = types, unitIndex = unitIndex, id = id, callee = -1)
        ; 局部函数值：名字在帧里且类型是函数，即间接调用。
        let localType = exprIrType(map = map, types = types, unit = unit, unitIndex = unitIndex, frame = done.frame, bytes = bytes, id = callee)
        if (findIrLocal(frame = done.frame, name = name) >= 0 || findOuterLocal(frame = done.frame, name = name) >= 0) && localType >= 0 && localType < irTypeCount(map.pool):
            if irTypeTag(irTypeAt(pool = map.pool, id = localType).kind) == irTypeTag(.irTypeFunction):
                return lowerIndirectCall(out = done, unit = unit, bytes = bytes, map = map, types = types, unitIndex = unitIndex, callId = id, calleeId = callee, fnType = localType)
        resolved = calleeOfFunction(frame = done.frame, map = map, name = name)
        if !resolved.found && len(expr.kids) == 1:
            let symbol = lookupTopByName(index = done.frame.world.symbols, name = name)
            let ref = symbolDecl(world = done.frame.world, symbol = symbol)
            if ref.unit >= 0:
                let decl = done.frame.world.units[ref.unit].ast.decls[ref.decl]
                var isObject = false
                if isObjectDeclCode(decl.kind):
                    isObject = true
                if isStructDeclCode(decl.kind) || isObjectDeclCode(decl.kind) || isGivenDeclCode(decl.kind):
                    let typeId = zeroConstructType(map = map, name = name, isObject = isObject)
                    if typeId >= 0:
                        let shaped = lowerConstructDefaults(out = done, map = map, types = types, ref = ref, typeId = typeId)
                        done.pool = shaped.pool
                        done.texts = shaped.texts
                        done.frame = shaped.frame
                        done.id = shaped.id
                        return done
        if !resolved.found:
            resolved.name = name
            maybeCase = name
    else:
        return missExpr(out = done, unit = unit, id = id, what = "被调表达式")
    var actuals: Array<IrActual> = []
    var i = 1
    while i < len(expr.kids):
        let kid: I32 = expr.kids[i]
        var valueId = kid
        var label = ""
        if unit.ast.isLabeledArgument(kid):
            let labelNode = unit.ast.exprAt(kid)
            label = decodeSpelling(bytes = bytes, start = labelNode.nameStart, end = labelNode.nameEnd)
            valueId = unit.ast.childOf(id = kid, index = 0)
        let one = lowerExpr(pool = done.pool, texts = done.texts, map = map, types = types, unit = unit, unitIndex = unitIndex, bytes = bytes, frame = done.frame, id = valueId)
        done.pool = one.pool
        done.texts = one.texts
        done.frame = one.frame
        if one.failed:
            return takeFailure(out = done, one = one)
        var actual = IrActual()
        actual.label = label
        actual.id = one.id
        actuals = actuals.append(actual)
        i = i + 1
    if len(maybeCase) > 0:
        let constructed = lowerCaseConstruct(out = done, unit = unit, bytes = bytes, map = map, types = types, unitIndex = unitIndex, id = id, name = maybeCase, actuals = actuals)
        if constructed.id >= 0:
            return constructed
    if resolved.found && resolved.isForeign:
        done.frame = noteExternFunction(frame = done.frame, map = map, symbol = resolved.symbol, sigId = resolved.sigId, name = resolved.name)
        return lowerForeignCall(out = done, unit = unit, bytes = bytes, map = map, types = types, unitIndex = unitIndex, id = id, name = resolved.name, actuals = actuals, leading = receiver, ret = resolved.ret)
    if len(builtinMember) > 0:
        if builtinType >= 0 && builtinType < irTypeCount(map.pool) && irTypeTag(irTypeAt(pool = map.pool, id = builtinType).kind) == irTypeTag(.irTypeString):
            return lowerStringMember(out = done, unit = unit, bytes = bytes, map = map, types = types, unitIndex = unitIndex, id = id, member = builtinMember, receiver = receiver, actuals = actuals)
        return lowerArrayMember(out = done, unit = unit, bytes = bytes, map = map, types = types, unitIndex = unitIndex, id = id, member = builtinMember, receiver = receiver, receiverType = builtinType, actuals = actuals)
    if resolved.found && resolved.ordered:
        return lowerNamedCall(out = done, unit = unit, bytes = bytes, map = map, types = types, unitIndex = unitIndex, id = id, name = resolved.name, actuals = actuals, params = resolved.params, leading = receiver, ret = resolved.ret)
    return lowerPlainCall(out = done, unit = unit, bytes = bytes, map = map, types = types, unitIndex = unitIndex, id = id, name = resolved.name, actuals = actuals, leading = receiver)

; 数组成员判定：名字在两类之内且接收者类型是数组 —— 字串的同名成员归字串批。
isArrayMember|func(memberName: String, receiverType: I32, map: TypeMap,) -> (Bool,):
    if memberName != "append" && memberName != "slice" && memberName != "join":
        return false
    if receiverType < 0 || receiverType >= irTypeCount(map.pool):
        return false
    return irTypeTag(irTypeAt(pool = map.pool, id = receiverType).kind) == irTypeTag(.irTypeArray)

; 数组成员：append 发「Array.append」命名调用（与宿主同形），slice 发切片节点。
; 结果类型取接收者；数目不符或名字不认识时照旧报「成员被调」，不猜。
lowerArrayMember|func(out: LowerExpr, unit: CompilationUnit, bytes: Array<U8>, map: TypeMap, types: ExprTypes, unitIndex: I32, id: I32, member: String, receiver: I32, receiverType: I32, actuals: Array<IrActual>,) -> (LowerExpr,):
    var done = out
    if member == "append" && len(actuals) == 1:
        let placed = internText(texts = done.texts, value = "Array.append")
        var node = irMakeNode(kind = irExprTag(.irCall), typeId = receiverType)
        node.text = placed.id
        node.kids = [receiver, actuals[0].id]
        let inserted = irAppendNode(pool = done.pool, node = node)
        done.texts = placed.texts
        done.pool = inserted.pool
        done.id = inserted.id
        return done
    if member == "join" && len(actuals) == 1:
        let typeId = exprIrType(map = map, types = types, unit = unit, unitIndex = unitIndex, frame = done.frame, bytes = bytes, id = id)
        if typeId < 0:
            return missType(out = done, unit = unit, id = id, bytes = bytes)
        let inserted = addIrNode(pool = done.pool, kind = irExprTag(.irArrayJoin), typeId = typeId, op = 0, kids = [receiver, actuals[0].id])
        done.pool = inserted.pool
        done.id = inserted.id
        return done
    if member == "slice" && len(actuals) == 2:
        let inserted = addIrNode(pool = done.pool, kind = irExprTag(.irSliceCall), typeId = receiverType, op = 0, kids = [receiver, actuals[0].id, actuals[1].id])
        done.pool = inserted.pool
        done.id = inserted.id
        return done
    return missExpr(out = done, unit = unit, id = id, what = "成员被调 " + member)

; 字符串成员判定：名字在五类之内且接收者类型是字符串。
isStringMember|func(memberName: String, receiverType: I32, map: TypeMap,) -> (Bool,):
    if memberName != "contains" && memberName != "split" && memberName != "substring" && memberName != "indexOf" && memberName != "slice":
        return false
    if receiverType < 0 || receiverType >= irTypeCount(map.pool):
        return false
    return irTypeTag(irTypeAt(pool = map.pool, id = receiverType).kind) == irTypeTag(.irTypeString)

; 字符串成员：contains / split / substring / indexOf 各发专属节点，slice 发切片节点。
; 结果类型取推导表；数目不符或名字不认识时报「成员被调」，不猜。
lowerStringMember|func(out: LowerExpr, unit: CompilationUnit, bytes: Array<U8>, map: TypeMap, types: ExprTypes, unitIndex: I32, id: I32, member: String, receiver: I32, actuals: Array<IrActual>,) -> (LowerExpr,):
    var done = out
    let typeId = exprIrType(map = map, types = types, unit = unit, unitIndex = unitIndex, frame = done.frame, bytes = bytes, id = id)
    if typeId < 0:
        if member == "contains":
            return lowerStringNode(out = done, unit = unit, id = id, kind = .irStringContains, typeId = map.booleanId, receiver = receiver, actuals = actuals)
        return missType(out = done, unit = unit, id = id, bytes = bytes)
    if member == "contains" && len(actuals) == 1:
        return lowerStringNode(out = done, unit = unit, id = id, kind = .irStringContains, typeId = typeId, receiver = receiver, actuals = actuals)
    if member == "split" && len(actuals) == 1:
        return lowerStringNode(out = done, unit = unit, id = id, kind = .irStringSplit, typeId = typeId, receiver = receiver, actuals = actuals)
    if member == "indexOf" && len(actuals) == 1:
        return lowerStringNode(out = done, unit = unit, id = id, kind = .irStringIndexOf, typeId = typeId, receiver = receiver, actuals = actuals)
    if member == "substring" && len(actuals) == 2:
        return lowerStringNode(out = done, unit = unit, id = id, kind = .irStringSubstring, typeId = typeId, receiver = receiver, actuals = actuals)
    if member == "slice" && len(actuals) == 2:
        return lowerStringNode(out = done, unit = unit, id = id, kind = .irSliceCall, typeId = typeId, receiver = receiver, actuals = actuals)
    return missExpr(out = done, unit = unit, id = id, what = "成员被调 " + member)

; 字符串成员节点：接收者在前，实参按源序排在其后。
lowerStringNode|func(out: LowerExpr, unit: CompilationUnit, id: I32, kind: IrExprKind, typeId: I32, receiver: I32, actuals: Array<IrActual>,) -> (LowerExpr,):
    var kids: Array<I32> = [receiver]
    var i = 0
    while i < len(actuals):
        kids = kids.append(actuals[i].id)
        i = i + 1
    let inserted = addIrNode(pool = out.pool, kind = irExprTag(kind), typeId = typeId, op = 0, kids = kids)
    var done = out
    done.pool = inserted.pool
    done.id = inserted.id
    return done

; 惰性引用元素：非 LazyRef 或实参缺席答 -1。
irLazyRefElement|func(pool: IrTypePool, id: I32,) -> (I32,):
    if id < 0 || id >= irTypeCount(pool):
        return -1
    let entry = irTypeAt(pool = pool, id = id)
    if irTypeTag(entry.kind) != irTypeTag(.irTypeLazyRef):
        return -1
    if len(entry.kids) != 1:
        return -1
    return entry.kids[0]

; 成员读：接收者一个子节点，字段名驻留进文本池；方法值不走这条。
lowerMember|func(out: LowerExpr, unit: CompilationUnit, bytes: Array<U8>, map: TypeMap, types: ExprTypes, unitIndex: I32, id: I32,) -> (LowerExpr,):
    let expr = unit.ast.exprAt(id)
    if len(expr.kids) < 1:
        return missExpr(out = out, unit = unit, id = id, what = "无接收者的成员读")
    let one = lowerExpr(pool = out.pool, texts = out.texts, map = map, types = types, unit = unit, unitIndex = unitIndex, bytes = bytes, frame = out.frame, id = expr.kids[0])
    var done = out
    done.pool = one.pool
    done.texts = one.texts
    done.frame = one.frame
    if one.failed:
        return takeFailure(out = done, one = one)
    let typeId = exprIrType(map = map, types = types, unit = unit, unitIndex = unitIndex, frame = done.frame, bytes = bytes, id = id)
    if typeId < 0:
        return missType(out = done, unit = unit, id = id, bytes = bytes)
    let fieldName = decodeSpelling(bytes = bytes, start = expr.nameStart, end = expr.nameEnd)
    let receiverType = irNodeAt(pool = done.pool, id = one.id).typeId
    let element = irLazyRefElement(pool = map.pool, id = receiverType)
    if fieldName == "value" && element >= 0:
        let inserted = addIrNode(pool = done.pool, kind = irExprTag(.irLazyRefValue), typeId = element, op = 0, kids = [one.id])
        done.pool = inserted.pool
        done.id = inserted.id
        return done
    let slot = fieldSlotOf(table = done.frame.decls, typeId = receiverType, name = fieldName)
    if slot < 0:
        return missExpr(out = done, unit = unit, id = id, what = "字段 " + fieldName + " 不在声明里")
    var node = irMakeNode(kind = irExprTag(.irFieldGet), typeId = typeId)
    node.op = slot
    node.kids = [one.id]
    let inserted = irAppendNode(pool = done.pool, node = node)
    done.pool = inserted.pool
    done.id = inserted.id
    return done

; 下标读：容器与下标两个子节点，安全断言读，越界由运行时陷阱承担。
lowerSubscript|func(out: LowerExpr, unit: CompilationUnit, bytes: Array<U8>, map: TypeMap, types: ExprTypes, unitIndex: I32, id: I32,) -> (LowerExpr,):
    let expr = unit.ast.exprAt(id)
    if len(expr.kids) < 2:
        return missExpr(out = out, unit = unit, id = id, what = "缺下标的读取")
    var done = out
    var kids: Array<I32> = []
    var i = 0
    while i < 2:
        let one = lowerExpr(pool = done.pool, texts = done.texts, map = map, types = types, unit = unit, unitIndex = unitIndex, bytes = bytes, frame = done.frame, id = expr.kids[i])
        done.pool = one.pool
        done.texts = one.texts
        done.frame = one.frame
        if one.failed:
            return takeFailure(out = done, one = one)
        kids = kids.append(one.id)
        i = i + 1
    let typeId = exprIrType(map = map, types = types, unit = unit, unitIndex = unitIndex, frame = done.frame, bytes = bytes, id = id)
    if typeId < 0:
        return missType(out = done, unit = unit, id = id, bytes = bytes)
    let inserted = addIrNode(pool = done.pool, kind = irExprTag(.irSubscriptGet), typeId = typeId, op = 0, kids = kids)
    done.pool = inserted.pool
    done.id = inserted.id
    return done

; 用例声明序：枚举体里按声明顺序数，从 0 起，与宿主 tag 同一口径。
; 不按符号表下标数：符号登记还含方法，下标与声明序不等。
enumCaseTag|func(frame: LowerFrame, owner: String, caseName: String,) -> (I32,):
    let symbol = lookupTopByName(index = frame.world.symbols, name = owner)
    let ref = symbolDecl(world = frame.world, symbol = symbol)
    if ref.unit < 0:
        return -1
    let unit = frame.world.units[ref.unit]
    let decl = unit.ast.decls[ref.decl]
    let bytes = unitBytes(unit)
    var tag = 0
    var i = 0
    while i < len(decl.kids):
        let child = unit.ast.decls[decl.kids[i]]
        if isVariantDeclCode(child.kind):
            let name = decodeSpelling(bytes = bytes, start = child.nameStart, end = child.nameEnd)
            if name == caseName:
                return tag
            tag = tag + 1
        i = i + 1
    return -1

; 前导点用例：期望类型是枚举就先按它定所有者；无类型信息才退回唯一候选。
; 用例是枚举的成员，知道所属枚举才知道类型 —— 前导点只是把枚举名写成糖。
lowerCaseValue|func(out: LowerExpr, unit: CompilationUnit, bytes: Array<U8>, map: TypeMap, types: ExprTypes, unitIndex: I32, id: I32,) -> (LowerExpr,):
    let expr = unit.ast.exprAt(id)
    let name = decodeSpelling(bytes = bytes, start = expr.nameStart, end = expr.nameEnd)
    let typeId = exprIrType(map = map, types = types, unit = unit, unitIndex = unitIndex, frame = out.frame, bytes = bytes, id = id)
    var owner = ""
    if typeId >= 0 && typeId < irTypeCount(map.pool):
        let entry = irTypeAt(pool = map.pool, id = typeId)
        if irTypeTag(entry.kind) == irTypeTag(.irTypeEnumeration):
            owner = entry.name
    if len(owner) == 0:
        let candidates = caseCandidateCount(index = out.frame.world.symbols, name = name)
        if candidates != 1:
            return missNeed(out = out, unit = unit, id = id, what = "用例 ." + name + " 缺类型信息：候选枚举 " + countText(candidates) + " 个")
        owner = caseCandidateOwner(index = out.frame.world.symbols, name = name, nth = 0)
    let tag = enumCaseTag(frame = out.frame, owner = owner, caseName = name)
    if tag < 0:
        return missNeed(out = out, unit = unit, id = id, what = "用例 ." + name + " 不在枚举 " + owner + " 的声明序里")
    if typeId < 0:
        return missType(out = out, unit = unit, id = id, bytes = bytes)
    let placed = internText(texts = out.texts, value = name)
    var node = irMakeNode(kind = irExprTag(.irEnumConstruct), typeId = typeId)
    node.op = tag
    node.text = placed.id
    let inserted = irAppendNode(pool = out.pool, node = node)
    var done = out
    done.texts = placed.texts
    done.pool = inserted.pool
    done.id = inserted.id
    return done

; 带载荷的用例构造：与 `.圆` 同一节点类别，载荷按声明序作子节点。
; 名字不是该枚举的用例时答 id = -1，交回调用路径当普通调用（可能是外部函数）。
lowerCaseConstruct|func(out: LowerExpr, unit: CompilationUnit, bytes: Array<U8>, map: TypeMap, types: ExprTypes, unitIndex: I32, id: I32, name: String, actuals: Array<IrActual>,) -> (LowerExpr,):
    var miss = out
    miss.id = -1
    let typeId = exprIrType(map = map, types = types, unit = unit, unitIndex = unitIndex, frame = out.frame, bytes = bytes, id = id)
    if typeId < 0 || typeId >= irTypeCount(map.pool):
        return miss
    let entry = irTypeAt(pool = map.pool, id = typeId)
    if irTypeTag(entry.kind) != irTypeTag(.irTypeEnumeration):
        return miss
    let tag = enumCaseTag(frame = out.frame, owner = entry.name, caseName = name)
    if tag < 0:
        return miss
    var kids: Array<I32> = []
    var i = 0
    while i < len(actuals):
        kids = kids.append(actuals[i].id)
        i = i + 1
    let placed = internText(texts = out.texts, value = name)
    var node = irMakeNode(kind = irExprTag(.irEnumConstruct), typeId = typeId)
    node.op = tag
    node.text = placed.id
    node.kids = kids
    let inserted = irAppendNode(pool = out.pool, node = node)
    var done = out
    done.texts = placed.texts
    done.pool = inserted.pool
    done.id = inserted.id
    return done

; 字符串字面量取值：去首尾引号并按转义表还原；`\0` 之后的内容全部丢弃。
; 字节先拼再整体解码：逐段解码会把转义切开的序列变成替换字符。
stringLiteralText|func(bytes: Array<U8>, start: I32, end: I32,) -> (String,):
    let quote: U8 = 34
    let backslash: U8 = 92
    var pieces: Array<U8> = []
    var i = start
    var stop = end
    if i < stop && bytes[i] == quote:
        i = i + 1
    if stop > i && bytes[stop - 1] == quote:
        stop = stop - 1
    var closed = false
    while i < stop && !closed:
        let code = bytes[i]
        if code == backslash && i + 1 < stop:
            let next = bytes[i + 1]
            if next == 110 as U8:
                pieces = pieces.append(10 as U8)
            elif next == 116 as U8:
                pieces = pieces.append(9 as U8)
            elif next == 114 as U8:
                pieces = pieces.append(13 as U8)
            elif next == 48 as U8:
                closed = true
            elif next == backslash:
                pieces = pieces.append(backslash)
            elif next == quote:
                pieces = pieces.append(quote)
            elif next == 40 as U8:
                pieces = pieces.append(40 as U8)
            else:
                pieces = pieces.append(code)
                pieces = pieces.append(next)
            i = i + 2
        else:
            pieces = pieces.append(code)
            i = i + 1
    return decodeSpelling(bytes = pieces, start = 0, end = len(pieces))

; 字符串字面量：值驻留进文本池，类型取推导表给出的 string。
lowerStringLiteral|func(out: LowerExpr, unit: CompilationUnit, bytes: Array<U8>, map: TypeMap, types: ExprTypes, unitIndex: I32, id: I32,) -> (LowerExpr,):
    let typeId = exprIrType(map = map, types = types, unit = unit, unitIndex = unitIndex, frame = out.frame, bytes = bytes, id = id)
    if typeId < 0:
        return missType(out = out, unit = unit, id = id, bytes = bytes)
    let expr = unit.ast.exprAt(id)
    let value = stringLiteralText(bytes = bytes, start = expr.start, end = expr.end)
    let placed = internText(texts = out.texts, value = value)
    var node = irMakeNode(kind = irExprTag(.irStringConst), typeId = typeId)
    node.text = placed.id
    let inserted = irAppendNode(pool = out.pool, node = node)
    var done = out
    done.texts = placed.texts
    done.pool = inserted.pool
    done.id = inserted.id
    return done

; 数组字面量：元素保序，类型取推导表；空字面量的元素类型由标注定型后同样落在表里。
lowerArrayLiteral|func(out: LowerExpr, unit: CompilationUnit, bytes: Array<U8>, map: TypeMap, types: ExprTypes, unitIndex: I32, id: I32,) -> (LowerExpr,):
    let expr = unit.ast.exprAt(id)
    var done = out
    var kids: Array<I32> = []
    var i = 0
    while i < len(expr.kids):
        let one = lowerExpr(pool = done.pool, texts = done.texts, map = map, types = types, unit = unit, unitIndex = unitIndex, bytes = bytes, frame = done.frame, id = expr.kids[i])
        done.pool = one.pool
        done.texts = one.texts
        done.frame = one.frame
        if one.failed:
            return takeFailure(out = done, one = one)
        kids = kids.append(one.id)
        i = i + 1
    let typeId = exprIrType(map = map, types = types, unit = unit, unitIndex = unitIndex, frame = done.frame, bytes = bytes, id = id)
    if typeId < 0:
        return missType(out = done, unit = unit, id = id, bytes = bytes)
    let inserted = addIrNode(pool = done.pool, kind = irExprTag(.irArrayLiteral), typeId = typeId, op = 0, kids = kids)
    done.pool = inserted.pool
    done.id = inserted.id
    return done

; 显式转换：操作数一个子节点，目标类型取推导表；合法性由语义层挡。
lowerCast|func(out: LowerExpr, unit: CompilationUnit, bytes: Array<U8>, map: TypeMap, types: ExprTypes, unitIndex: I32, id: I32,) -> (LowerExpr,):
    let expr = unit.ast.exprAt(id)
    if len(expr.kids) < 1:
        return missExpr(out = out, unit = unit, id = id, what = "转换缺操作数")
    var done = out
    let one = lowerExpr(pool = done.pool, texts = done.texts, map = map, types = types, unit = unit, unitIndex = unitIndex, bytes = bytes, frame = done.frame, id = expr.kids[0])
    done.pool = one.pool
    done.texts = one.texts
    done.frame = one.frame
    if one.failed:
        return takeFailure(out = done, one = one)
    let typeId = exprIrType(map = map, types = types, unit = unit, unitIndex = unitIndex, frame = done.frame, bytes = bytes, id = id)
    if typeId < 0:
        return missType(out = done, unit = unit, id = id, bytes = bytes)
    let inserted = addIrNode(pool = done.pool, kind = irExprTag(.irUnary), typeId = typeId, op = irUnaryTag(.irCast), kids = [one.id])
    done.pool = inserted.pool
    done.id = inserted.id
    return done

; 空值：只接可选类型；类型来自标注或期望，推不出即缺口。
lowerNil|func(out: LowerExpr, unit: CompilationUnit, bytes: Array<U8>, map: TypeMap, types: ExprTypes, unitIndex: I32, id: I32,) -> (LowerExpr,):
    let typeId = exprIrType(map = map, types = types, unit = unit, unitIndex = unitIndex, frame = out.frame, bytes = bytes, id = id)
    if typeId < 0 || typeId >= irTypeCount(map.pool):
        return missType(out = out, unit = unit, id = id, bytes = bytes)
    let entry = irTypeAt(pool = map.pool, id = typeId)
    if irTypeTag(entry.kind) != irTypeTag(.irTypeOptional):
        return missExpr(out = out, unit = unit, id = id, what = "nil 只接可选类型")
    var node = irMakeNode(kind = irExprTag(.irOptionalConstruct), typeId = typeId)
    node.op = 0
    let inserted = irAppendNode(pool = out.pool, node = node)
    var done = out
    done.pool = inserted.pool
    done.id = inserted.id
    return done

; 插值串：段表按源序交替字面与代码；字面段造字符串常量，代码段取对应子节点。
; 段表由语法层随单元带出；子表达式个数与代码段不符即缺口，不拼半截串。
lowerInterp|func(out: LowerExpr, unit: CompilationUnit, bytes: Array<U8>, map: TypeMap, types: ExprTypes, unitIndex: I32, id: I32,) -> (LowerExpr,):
    let expr = unit.ast.exprAt(id)
    if expr.body <= 0 || expr.op < 0 || expr.op + expr.body > len(unit.segments):
        return missExpr(out = out, unit = unit, id = id, what = "插值串缺段表")
    var done = out
    var parts: Array<I32> = []
    var segIndex = 0
    var kidIndex = 0
    while segIndex < expr.body:
        let segment = unit.segments[expr.op + segIndex]
        if segment.code == 0:
            let text = stringLiteralText(bytes = bytes, start = segment.start, end = segment.end)
            if len(text) > 0:
                let placed = internText(texts = done.texts, value = text)
                var node = irMakeNode(kind = irExprTag(.irStringConst), typeId = map.stringId)
                node.text = placed.id
                let inserted = irAppendNode(pool = done.pool, node = node)
                done.texts = placed.texts
                done.pool = inserted.pool
                parts = parts.append(inserted.id)
        else:
            if kidIndex >= len(expr.kids):
                return missExpr(out = done, unit = unit, id = id, what = "插值段与子表达式不符")
            let one = lowerExpr(pool = done.pool, texts = done.texts, map = map, types = types, unit = unit, unitIndex = unitIndex, bytes = bytes, frame = done.frame, id = expr.kids[kidIndex])
            done.pool = one.pool
            done.texts = one.texts
            done.frame = one.frame
            if one.failed:
                return takeFailure(out = done, one = one)
            parts = parts.append(one.id)
            kidIndex = kidIndex + 1
        segIndex = segIndex + 1
    if kidIndex != len(expr.kids):
        return missExpr(out = done, unit = unit, id = id, what = "插值段与子表达式不符")
    var typeId = exprIrType(map = map, types = types, unit = unit, unitIndex = unitIndex, frame = done.frame, bytes = bytes, id = id)
    if typeId < 0:
        typeId = map.stringId
    if typeId < 0:
        return missType(out = done, unit = unit, id = id, bytes = bytes)
    var node = irMakeNode(kind = irExprTag(.irInterpString), typeId = typeId)
    node.kids = parts
    let inserted = irAppendNode(pool = done.pool, node = node)
    done.pool = inserted.pool
    done.id = inserted.id
    return done

; 表达式入口：按类别分派；未知类别报缺口。
lowerExpr|func(pool: IrNodePool, texts: IrTextPool, map: TypeMap, types: ExprTypes, unit: CompilationUnit, unitIndex: I32, bytes: Array<U8>, frame: LowerFrame, id: I32,) -> (LowerExpr,):
    var out = LowerExpr()
    out.pool = pool
    out.texts = texts
    out.frame = frame
    if id < 0 || id >= unit.ast.exprCount():
        out.failed = true
        out.detail = "表达式下标越界"
        return out
    ; 不安全前缀是静态标记，没有 IR 节点：直接把操作数降下去。
    if unit.ast.isUnsafeExpr(id):
        let unsafeExpr = unit.ast.exprAt(id)
        if len(unsafeExpr.kids) == 0:
            return missExpr(out = out, unit = unit, id = id, what = "不安全前缀缺操作数")
        return lowerExpr(pool = out.pool, texts = out.texts, map = map, types = types, unit = unit, unitIndex = unitIndex, bytes = bytes, frame = out.frame, id = unsafeExpr.kids[0])
    if unit.ast.isIntegerExpr(id):
        let typeId = exprIrType(map = map, types = types, unit = unit, unitIndex = unitIndex, frame = frame, bytes = bytes, id = id)
        if typeId < 0:
            return missType(out = out, unit = unit, id = id, bytes = bytes)
        let expr = unit.ast.exprAt(id)
        let spelling = decodeSpelling(bytes = bytes, start = expr.start, end = expr.end)
        var node = irMakeNode(kind = irExprTag(.irIntConst), typeId = typeId)
        node.intValue = intSpellingValue(text = spelling)
        let inserted = irAppendNode(pool = out.pool, node = node)
        out.pool = inserted.pool
        out.id = inserted.id
        return out
    if unit.ast.isFloatExpr(id):
        let typeId = exprIrType(map = map, types = types, unit = unit, unitIndex = unitIndex, frame = frame, bytes = bytes, id = id)
        if typeId < 0:
            return missType(out = out, unit = unit, id = id, bytes = bytes)
        let expr = unit.ast.exprAt(id)
        let spelling = decodeSpelling(bytes = bytes, start = expr.start, end = expr.end)
        let value = unsafe bk_parse_double(spelling)
        var node = irMakeNode(kind = irExprTag(.irIntConst), typeId = typeId)
        if irTypeTag(irTypeAt(pool = map.pool, id = typeId).kind) == irTypeTag(.irTypeF64):
            node = irMakeNode(kind = irExprTag(.irFloatConst), typeId = typeId)
            node.floatValue = value
        else:
            node.intValue = value as I64
        let inserted = irAppendNode(pool = out.pool, node = node)
        out.pool = inserted.pool
        out.id = inserted.id
        return out
    if unit.ast.isBoolExpr(id):
        let typeId = exprIrType(map = map, types = types, unit = unit, unitIndex = unitIndex, frame = frame, bytes = bytes, id = id)
        if typeId < 0:
            return missType(out = out, unit = unit, id = id, bytes = bytes)
        var node = irMakeNode(kind = irExprTag(.irBoolConst), typeId = typeId)
        if unit.ast.isTrueExpr(id):
            node.intValue = 1
        let inserted = irAppendNode(pool = out.pool, node = node)
        out.pool = inserted.pool
        out.id = inserted.id
        return out
    if unit.ast.isStringExpr(id):
        return lowerStringLiteral(out = out, unit = unit, bytes = bytes, map = map, types = types, unitIndex = unitIndex, id = id)
    if unit.ast.isInterpolatedExpr(id):
        return lowerInterp(out = out, unit = unit, bytes = bytes, map = map, types = types, unitIndex = unitIndex, id = id)
    if unit.ast.isCastExpr(id):
        return lowerCast(out = out, unit = unit, bytes = bytes, map = map, types = types, unitIndex = unitIndex, id = id)
    if unit.ast.isFunctionExpr(id):
        return lowerClosure(out = out, unit = unit, bytes = bytes, map = map, types = types, unitIndex = unitIndex, id = id)
    if unit.ast.isGenericExpr(id):
        return lowerLazyRefConstruct(out = out, unit = unit, bytes = bytes, map = map, types = types, unitIndex = unitIndex, id = id, callee = id)
    if unit.ast.isNilExpr(id):
        return lowerNil(out = out, unit = unit, bytes = bytes, map = map, types = types, unitIndex = unitIndex, id = id)
    if unit.ast.isArrayExpr(id):
        return lowerArrayLiteral(out = out, unit = unit, bytes = bytes, map = map, types = types, unitIndex = unitIndex, id = id)
    if unit.ast.isCaseExpr(id):
        return lowerCaseValue(out = out, unit = unit, bytes = bytes, map = map, types = types, unitIndex = unitIndex, id = id)
    if unit.ast.isIdentifierExpr(id):
        return lowerIdentifier(out = out, unit = unit, bytes = bytes, map = map, types = types, unitIndex = unitIndex, id = id)
    if unit.ast.isBinaryExpr(id):
        return lowerBinary(out = out, unit = unit, bytes = bytes, map = map, types = types, unitIndex = unitIndex, id = id)
    if unit.ast.isUnaryExpr(id):
        return lowerUnary(out = out, unit = unit, bytes = bytes, map = map, types = types, unitIndex = unitIndex, id = id)
    if unit.ast.isJoinExpr(id):
        return lowerJoin(out = out, unit = unit, bytes = bytes, map = map, types = types, unitIndex = unitIndex, id = id)
    if unit.ast.isCallExpr(id):
        return lowerCall(out = out, unit = unit, bytes = bytes, map = map, types = types, unitIndex = unitIndex, id = id)
    if unit.ast.isMemberExpr(id):
        return lowerMember(out = out, unit = unit, bytes = bytes, map = map, types = types, unitIndex = unitIndex, id = id)
    if unit.ast.isSubscriptExpr(id):
        return lowerSubscript(out = out, unit = unit, bytes = bytes, map = map, types = types, unitIndex = unitIndex, id = id)
    let node = unit.ast.exprAt(id)
    return missExpr(out = out, unit = unit, id = id, what = exprKindName(node.kind))
