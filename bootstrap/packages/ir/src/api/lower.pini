[lower|import]
_syntax = "../../../syntax"
_semantics = "../../../semantics"
_module_loader = "../../../module-loader"

; 降载入口：吃工作区世界与各张表，出一份 IR 模块。
; 函数表与语句体一并产出；语句或表达式降不了时整函数留空并逐函数报缺口。
; 空体在发射期会变成能跑却错的码，故缺口必须可见。

; 降载入参：世界、表达式类型表、泛型实例表、解析表、形态表与槽布局；形态与槽本切片只带不改。
(LowerWorld)
world: MemberWorld = MemberWorld()
types: ExprTypes = ExprTypes()
generics: GenericFill = GenericFill()
resolve: ResolveTable = ResolveTable()
shapes: ShapeTable = ShapeTable()
layouts: LayoutTable = LayoutTable()

; 函数形参：名字、IR 类型下标、函数内槽位与取用位。
(IrParam)
name: String = ""
typeId: I32 = -1
slot: I32 = -1
isUsing: Bool = false

; 捕获槽：外层帧的槽位、闭包体内自己的槽位与元素类型。
; 前者用于创建点往 env 里存地址，后者用于体内读写的槽名。
(IrCaptureSlot)
slot: I32 = -1
localSlot: I32 = -1
typeId: I32 = -1

; 函数：名字、形参、返回类型、语句节点下标与逐语句源位置；返回 -1 表示空返回。
; 闭包另记自身编号与捕获表：编号全工作区递增，用于 `@__closure_<编号>` 与 env 类型名，两者同源。
(IrFunction)
name: String = ""
params: Array<IrParam> = []
returnType: I32 = -1
body: Array<I32> = []
positions: Array<IrPosition> = []
isTest: Bool = false
isUnsafe: Bool = false
isAsync: Bool = false
sourceFile: String = ""
isClosure: Bool = false
closureId: I32 = -1
captures: Array<IrCaptureSlot> = []

; 外部数据符号：名字与 IR 类型；发射期按它出 `external global` 声明。
(IrExternData)
name: String = ""
typeId: I32 = -1

; 外部函数声明：名字、返回类型、形参类型与变参标志；发射期按它出 `declare`。
; 名字保留 C 拼写，不走内部函数的编码；形参只收标量、指针与串，聚合在语义层已拒。
(IrExternFunction)
name: String = ""
returnType: I32 = -1
params: Array<I32> = []
isVarargs: Bool = false

; 模块：类型池、节点池、字符串池、函数表、声明面、槽位面与两张错误表。
; `errors` 只放函数级降载失败，`typeErrors` 放类型映射失败：前者与空体一一对应，后者没有函数。
; 后端只读这张模块：声明、槽位、位置与份额都在里面，不再回查语义层。
(IrModule)
types: IrTypePool = IrTypePool()
nodes: IrNodePool = IrNodePool()
texts: Array<String> = []
functions: Array<IrFunction> = []
decls: IrDeclTable = IrDeclTable()
slots: IrSlotTable = IrSlotTable()
externData: Array<IrExternData> = []
externs: Array<IrExternFunction> = []
; C 面：`|c` 条目的落地形态；没有导出面时块名为空。
cSurface: IrExportBlock = IrExportBlock()
errors: Array<LowerError> = []
typeErrors: Array<LowerError> = []

; 降载状态：模块各表加当前单元视图；函数之间只共享类型池、节点池、声明表、槽表与错误表。
(LowerState)
map: TypeMap = TypeMap()
nodes: IrNodePool = IrNodePool()
texts: IrTextPool = IrTextPool()
functions: Array<IrFunction> = []
errors: Array<LowerError> = []
world: MemberWorld = MemberWorld()
types: ExprTypes = ExprTypes()
decls: IrDeclTable = IrDeclTable()
slots: IrSlotTable = IrSlotTable()
externData: Array<IrExternData> = []
externs: Array<IrExternFunction> = []
unitIndex: I32 = 0
bytes: Array<U8> = []
; 泛型实例表：逐实例换世界与类型表后降载模板体，调用点按它查实例名。
generics: GenericFill = GenericFill()
; 闭包编号水位：跨单元、跨实例共用一格，逐闭包递增。
closureSerial: I32 = 0

; 声明名：从源内区间解码，保留原始拼写。
declName|func(unit: CompilationUnit, bytes: Array<U8>, decl: DeclNode,) -> (String,):
    return decodeSpelling(bytes = bytes, start = decl.nameStart, end = decl.nameEnd)

; 参数槽位：在函数帧里按拼写找参数局部，缺席答 -1。
paramSlotOf|func(scope: ScopeStack, name: String,) -> (I32,):
    var i = 0
    while i < len(scope.locals):
        let local = scope.locals[i]
        if isParamLocal(local.kind) && local.spelling == name:
            return local.slot
        i = i + 1
    return -1

; 自身位：实例方法的 self 由语义层播种，局部表里至多一条。
selfLocalIndex|func(scope: ScopeStack,) -> (I32,):
    var i = 0
    while i < len(scope.locals):
        if isSelfLocal(scope.locals[i].kind):
            return i
        i = i + 1
    return -1

; 函数名：顶层函数用声明名，方法用「方法__类型」；本型方法另加 own 前缀。
irFunctionName|func(unit: CompilationUnit, bytes: Array<U8>, decl: DeclNode, owner: String,) -> (String,):
    let name = declName(unit = unit, bytes = bytes, decl = decl)
    if len(owner) == 0:
        return name
    if decl.isOwn:
        return ownMethodName(method = name, owner = owner)
    return instanceMethodName(method = name, owner = owner)

; 形参表：实例方法先放自身，再按声明序放参数；名字、类型、槽位与取用位一并落地。
lowerParams|func(state: LowerState, unit: CompilationUnit, decl: DeclNode, scope: ScopeStack,) -> (Array<IrParam>,):
    var out: Array<IrParam> = []
    let selfAt = selfLocalIndex(scope = scope)
    if selfAt >= 0:
        let local = scope.locals[selfAt]
        var selfParam = IrParam()
        selfParam.name = "self"
        selfParam.typeId = irIdOf(map = state.map, semanticId = local.typeId)
        selfParam.slot = local.slot
        out = out.append(selfParam)
    var i = 0
    while i < len(decl.kids):
        let kid: DeclNode = unit.ast.decls[decl.kids[i]]
        if isParamDeclCode(kid.kind):
            var param = IrParam()
            param.name = declName(unit = unit, bytes = state.bytes, decl = kid)
            let semanticId: I32 = state.world.types.typeOf(unit = state.unitIndex, decl = decl.kids[i])
            param.typeId = irIdOf(map = state.map, semanticId = semanticId)
            param.slot = paramSlotOf(scope = scope, name = param.name)
            param.isUsing = kid.isUsing
            out = out.append(param)
        i = i + 1
    return out

; 单函数：播种函数帧取参数与返回类型，再降语句体；owner 非空即方法。
; overrideName 非空时覆盖声明名，泛型实例的符号因此与实例表同名。
; 体降不了就整函数留空并记一条缺口：半截体在发射期能跑却少了语句。
lowerFunction|func(state: LowerState, unit: CompilationUnit, declId: I32, owner: String, overrideName: String,) -> (LowerState,):
    var out = state
    let decl: DeclNode = unit.ast.decls[declId]
    let seed = seedFunctionScope(world = out.world, unitIndex = out.unitIndex, declId = declId, bytes = out.bytes)
    if !seed.valid:
        let name = irFunctionName(unit = unit, bytes = out.bytes, decl = decl, owner = owner)
        out.errors = appendLowerError(errors = out.errors, error = makeLowerError(kind = .lowerMissingCapability, file = unit.path, offset = decl.start, detail = name + "：函数帧播种失败"))
        var blank = IrFunction()
        blank.name = name
        blank.sourceFile = unit.path
        out.functions = out.functions.append(blank)
        return out
    var fn = IrFunction()
    fn.name = irFunctionName(unit = unit, bytes = out.bytes, decl = decl, owner = owner)
    if len(overrideName) > 0:
        fn.name = overrideName
    fn.isTest = decl.isTest
    fn.isUnsafe = decl.isUnsafe
    fn.isAsync = decl.isAsync
    fn.sourceFile = unit.path
    if !isVoidReturn(pool = out.world.types.pool, id = seed.returnType):
        fn.returnType = irIdOf(map = out.map, semanticId = seed.returnType)
    if decl.isAsync && fn.returnType < 0:
        ; 无载荷的异步体在自举侧没有结算值可交，交缺口而不是发一个签名对不上的任务体。
        out.errors = appendLowerError(errors = out.errors, error = makeLowerError(kind = .lowerMissingCapability, file = unit.path, offset = decl.start, detail = fn.name + "：异步函数需带载荷返回"))
        out.functions = out.functions.append(fn)
        return out
    fn.params = lowerParams(state = out, unit = unit, decl = decl, scope = seed.scope)
    if decl.body >= 0:
        var start = LowerStmt()
        start.pool = out.nodes
        start.texts = out.texts
        start.frame = seedLowerFrame(scope = seed.scope, map = out.map, world = out.world, decls = out.decls, generics = out.generics)
        start.frame.isAsync = decl.isAsync
        start.frame.closureSerial = out.closureSerial
        let body = lowerBlockOf(out = start, unit = unit, bytes = out.bytes, map = out.map, types = out.types, unitIndex = out.unitIndex, blockId = decl.body)
        out.nodes = body.pool
        out.texts = body.texts
        if body.failed:
            out.errors = appendLowerError(errors = out.errors, error = makeLowerError(kind = .lowerMissingCapability, file = unit.path, offset = body.offset, detail = fn.name + "：" + body.detail))
            out.functions = out.functions.append(fn)
            return out
        fn.body = body.ids
        fn.positions = body.positions
        out.externData = mergeExternData(table = out.externData, more = body.frame.externData)
        out.externs = mergeExternFunction(table = out.externs, more = body.frame.externs)
        var c = 0
        while c < len(body.frame.closures):
            out.functions = out.functions.append(body.frame.closures[c])
            c = c + 1
        out.closureSerial = body.frame.closureSerial
    out.functions = out.functions.append(fn)
    return out

; 给定块的初始化函数：零参、返回该类型，体是「字段初值展开」的构造。
; 取用点按约定名引用它，故名字进模块时不动；字段缺初值即缺口，不按零值编造实例。
lowerGivenMaker|func(state: LowerState, unit: CompilationUnit, declId: I32,) -> (LowerState,):
    var out = state
    let decl: DeclNode = unit.ast.decls[declId]
    let name = declName(unit = unit, bytes = out.bytes, decl = decl)
    var missing = 0
    var d = 0
    while d < len(decl.kids):
        let child = unit.ast.decls[decl.kids[d]]
        if isFieldDeclCode(child.kind) && len(child.kids) == 0:
            missing = missing + 1
        d = d + 1
    if missing > 0:
        out.errors = appendLowerError(errors = out.errors, error = makeLowerError(kind = .lowerMissingCapability, file = unit.path, offset = decl.start, detail = name + "：给定块有字段缺初值"))
        return out
    let typeId = zeroConstructType(map = out.map, name = name, isObject = false)
    if typeId < 0:
        out.errors = appendLowerError(errors = out.errors, error = makeLowerError(kind = .lowerMissingCapability, file = unit.path, offset = decl.start, detail = name + "：给定块类型未进池"))
        return out
    var ref = DeclRef()
    ref.unit = out.unitIndex
    ref.decl = declId
    var one = LowerExpr()
    one.pool = out.nodes
    one.texts = out.texts
    one.frame = seedLowerFrame(scope = ScopeStack(), map = out.map, world = out.world, decls = out.decls, generics = out.generics)
    one.frame.closureSerial = out.closureSerial
    let built = lowerConstructDefaults(out = one, map = out.map, types = out.types, ref = ref, typeId = typeId)
    var fn = IrFunction()
    fn.name = "__given_make_" + name
    fn.returnType = typeId
    fn.sourceFile = unit.path
    var back = irMakeNode(kind = irStmtTag(.irReturnStmt), typeId = -1)
    back.kids = [built.id]
    let placed = irAppendNode(pool = built.pool, node = back)
    fn.body = [placed.id]
    out.nodes = placed.pool
    out.texts = built.texts
    out.closureSerial = built.frame.closureSerial
    out.functions = out.functions.append(fn)
    return out

; 单声明：函数直接降；类型与扩展块下钻到成员函数，owner 取块名，顺序即声明序。
; 带类型形参的函数是模板，实例由实例表另降，这里不进函数表。
lowerDeclBody|func(state: LowerState, unit: CompilationUnit, declId: I32,) -> (LowerState,):
    var out = state
    let decl: DeclNode = unit.ast.decls[declId]
    if isFunctionDeclCode(decl.kind):
        if len(decl.generic) > 0:
            return out
        return lowerFunction(state = out, unit = unit, declId = declId, owner = "", overrideName = "")
    if isGivenDeclCode(decl.kind):
        return lowerGivenMaker(state = out, unit = unit, declId = declId)
    if isTypeDecl(decl) || isExtensionDeclCode(decl.kind):
        let owner = declName(unit = unit, bytes = out.bytes, decl = decl)
        var i = 0
        while i < len(decl.kids):
            let child: DeclNode = unit.ast.decls[decl.kids[i]]
            if isFunctionDeclCode(child.kind) && len(child.generic) == 0:
                out = lowerFunction(state = out, unit = unit, declId = decl.kids[i], owner = owner, overrideName = "")
            i = i + 1
    return out

; 单单元：按顶层声明序走；单元序由调用方给，降载不再排序。
lowerUnit|func(state: LowerState, unit: CompilationUnit,) -> (LowerState,):
    var out = state
    var i = 0
    while i < len(unit.ast.items):
        out = lowerDeclBody(state = out, unit = unit, declId = unit.ast.items[i])
        i = i + 1
    return out

; 入口：先建类型映射与声明面、槽位面，再逐单元降函数表。
; 映射错误与函数级失败分表存放：前者没有对应函数，不能参与「每个空体一条」的对照。
; 声明面与槽位面在建类型池之后折，故它们的类型下标与节点同域。
lowerWorkspace|func(input: LowerWorld,) -> (IrModule,):
    var state = LowerState()
    state.world = input.world
    state.types = input.types
    state.generics = input.generics
    state.map = buildTypeMap(world = input.world)
    state.decls = makeDeclTable(shapes = input.shapes, map = state.map)
    state.slots = makeSlotTable(layouts = input.layouts, map = state.map)
    var u = 0
    while u < len(input.world.units):
        state.unitIndex = u
        state.bytes = unitBytes(input.world.units[u])
        state = lowerUnit(state = state, unit = input.world.units[u])
        u = u + 1
    ; 实例体在模板单元上降；世界与类型表逐实例换，函数名取实例符号。
    var g = 0
    while g < len(input.generics.instances):
        let inst = input.generics.instances[g]
        let savedWorld = state.world
        let savedTypes = state.types
        state.world = inst.world
        state.types = inst.types
        state.unitIndex = inst.unit
        state.bytes = unitBytes(inst.world.units[inst.unit])
        state = lowerFunction(state = state, unit = inst.world.units[inst.unit], declId = inst.decl, owner = "", overrideName = inst.name)
        state.world = savedWorld
        state.types = savedTypes
        g = g + 1
    var out = IrModule()
    out.types = state.map.pool
    out.nodes = state.nodes
    out.texts = state.texts.items
    out.functions = state.functions
    out.decls = state.decls
    out.slots = state.slots
    out.externData = state.externData
    out.externs = state.externs
    out.cSurface = makeExportBlock(world = input.world, functions = state.functions, decls = state.decls)
    out.errors = state.errors
    out.typeErrors = state.map.errors
    return out

; 外部数据符号合并：同名只留一条，类型取先登记的那条；顺序即首次使用序。
mergeExternData|func(table: Array<IrExternData>, more: Array<IrExternData>,) -> (Array<IrExternData>,):
    var out = table
    var i = 0
    while i < len(more):
        var found = false
        var j = 0
        while j < len(out):
            if out[j].name == more[i].name:
                found = true
            j = j + 1
        if !found:
            out = out.append(more[i])
        i = i + 1
    return out

; 外部函数合并：同名只留一条，签名取先登记的；顺序即首次使用序。
; 同名异型本该在语义层的声明裁决里报错，这里只防降载路径绕过裁决。
mergeExternFunction|func(table: Array<IrExternFunction>, more: Array<IrExternFunction>,) -> (Array<IrExternFunction>,):
    var out = table
    var i = 0
    while i < len(more):
        var found = false
        var j = 0
        while j < len(out):
            if out[j].name == more[i].name:
                found = true
            j = j + 1
        if !found:
            out = out.append(more[i])
        i = i + 1
    return out

; 外部函数按名字查：未命中答 -1；发射期用它判调用点是否走模块声明。
findExternFunction|func(module: IrModule, name: String,) -> (I32,):
    var i = 0
    while i < len(module.externs):
        if module.externs[i].name == name:
            return i
        i = i + 1
    return -1

; 函数表按名字查：未命中答 -1；同名不应出现，出现即说明降载重复。
findFunction|func(module: IrModule, name: String,) -> (I32,):
    var i = 0
    while i < len(module.functions):
        if module.functions[i].name == name:
            return i
        i = i + 1
    return -1

; 函数名表：按降载次序，供判据逐项对照。
functionNames|func(module: IrModule,) -> (Array<String>,):
    var out: Array<String> = []
    var i = 0
    while i < len(module.functions):
        out = out.append(module.functions[i].name)
        i = i + 1
    return out

; 空体函数数：它与 `errors` 条数应当相等；`typeErrors` 没有对应函数，不进这条对照。
; 远小于即有函数没报缺口就吞了体，远大于即有函数报了缺口却留下了体。
emptyBodyCount|func(module: IrModule,) -> (I32,):
    var total = 0
    var i = 0
    while i < len(module.functions):
        if len(module.functions[i].body) == 0:
            total = total + 1
        i = i + 1
    return total

; 按类别码数节点：判据用，统计整池；类别码由 irExprTag 与 irStmtTag 给。
countNodes|func(module: IrModule, kind: I32,) -> (I32,):
    var total = 0
    var i = 0
    while i < len(module.nodes.nodes):
        if module.nodes.nodes[i].kind == kind:
            total = total + 1
        i = i + 1
    return total

; 文本读：文本池下标越界答空串，调用方不必先判边界。
textAt|func(module: IrModule, id: I32,) -> (String,):
    if id < 0 || id >= len(module.texts):
        return ""
    return module.texts[id]

; 按名取码：枚举项不能跨包引用，判据与发射层都经契约清单查码；未登记答 0。
tagOfName|func(name: String,) -> (I32,):
    let table = contractTable()
    var i = 0
    while i < len(table.entries):
        if table.entries[i].name == name:
            return table.entries[i].tag
        i = i + 1
    return 0

; 码到名：转储与诊断按码印名；未登记答问号加码，不猜一个相近的名字。
irTagName|func(tag: I32,) -> (String,):
    let table = contractTable()
    var i = 0
    while i < len(table.entries):
        if table.entries[i].tag == tag:
            return table.entries[i].name
        i = i + 1
    return "?" + countText(tag)

; 整张码到名表：下标即类别码，未登记为空串；转储一次取走，逐节点查表。
; 逐节点调 irTagName 会每次重建契约清单，全工作区转储的代价随节点数乘表长。
irTagNames|func() -> (Array<String>,):
    var out: Array<String> = []
    var i = 0
    while i < 201:
        out = out.append("")
        i = i + 1
    let table = contractTable()
    var k = 0
    while k < len(table.entries):
        out[table.entries[k].tag] = table.entries[k].name
        k = k + 1
    return out
