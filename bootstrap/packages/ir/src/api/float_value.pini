; 浮点字面量：编译期取值与常量文本。取值走 C strtod 口径，与宿主 Double(text) 同为正确舍入。
[float|foreign]
bk_parse_double: (String,) -> (F64,)
bk_double_bits: (F64,) -> (I64,)

; 位模式的十六进制拼法：`0x` 加十六位大写、零填充，与宿主的 %016llX 同形。
bitsHex|func(_bits: I64,) -> (String,):
    var value = _bits as U64
    var text = ""
    var i = 0
    while i < 16:
        let digit = (value & 15 as U64) as I32
        text = hexDigitName(digit) + text
        value = value >> 4 as U64
        i = i + 1
    return "0x" + text

; 常量文本：零与指数写法退位模式十六进制，其余用最短往返十进制，末位无小数点则补 .0。
; 这条口径与宿主 IREmitter.doubleLiteral 一致，故两代发射文本同形。
floatConstantText|func(_value: F64,) -> (String,):
    if _value == 0.0:
        return bitsHex(unsafe bk_double_bits(_value))
    let text = "\(_value)"
    if text.contains("e") || text.contains("E"):
        return bitsHex(unsafe bk_double_bits(_value))
    if text.contains("."):
        return text
    return text + ".0"
