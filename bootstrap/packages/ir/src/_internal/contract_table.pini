; 由 bootstrap/tools/gen-ir-contract-table.py 生成，勿手改。
; 源自 IR 节点契约的节点表；族映射与能力普查工具同源。
; 类别码：表达式段自 1 起，语句段自 101 起，与契约条目号一一对应。

; 契约条目：类别码、节点名、族码与契约小节。
(IrContractEntry)
tag: I32 = 0
name: String = ""
family: I32 = 0
section: String = ""

; 契约清单：条目按类别码升序；两段计数供双向检查用。
(IrContractTable)
entries: Array<IrContractEntry> = []

; 族名表：下标即族码，与 backend-kit 的能力族同序。
contractFamilyNames|func() -> (Array<String>,):
    var out: Array<String> = []
    out = out.append("controlFlow")
    out = out.append("scalars")
    out = out.append("variablesAndOperators")
    out = out.append("calls")
    out = out.append("resultAndOptional")
    out = out.append("collections")
    out = out.append("nominals")
    out = out.append("pointers")
    out = out.append("fileIO")
    out = out.append("catchableIO")
    out = out.append("strings")
    out = out.append("lazyRef")
    out = out.append("concurrency")
    out = out.append("givenInstances")
    return out

; 族码：名字未登记答 -1。
contractFamilyId|func(name: String,) -> (I32,):
    let names = contractFamilyNames()
    var i = 0
    while i < len(names):
        if names[i] == name:
            return i
        i = i + 1
    return -1

; 造一条：字段直填，不做校验。
makeContractEntry|func(tag: I32, name: String, family: I32, section: String,) -> (IrContractEntry,):
    var out = IrContractEntry()
    out.tag = tag
    out.name = name
    out.family = family
    out.section = section
    return out

; 清单：逐条按类别码升序；两次调用得到同一串条目。
contractTable|func() -> (IrContractTable,):
    var out = IrContractTable()
    out.entries = out.entries.append(makeContractEntry(tag = 1, name = "intConst", family = 1, section = "2.1"))
