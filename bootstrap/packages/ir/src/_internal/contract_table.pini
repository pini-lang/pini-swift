; 条目数：下标合法区间是 0 到 count - 1。
contractCount|func(table: IrContractTable,) -> (I32,):
    return len(table.entries)

; 表达式条目数。
contractExprCount|func(table: IrContractTable,) -> (I32,):
    var total = 0
    var i = 0
    while i < len(table.entries):
        if table.entries[i].tag < 100:
            total = total + 1
        i = i + 1
    return total

; 语句条目数。
contractStmtCount|func(table: IrContractTable,) -> (I32,):
    return len(table.entries) - contractExprCount(table = table)

; 按类别码取条目：未命中答空条目。
contractAt|func(table: IrContractTable, tag: I32,) -> (IrContractEntry,):
    var i = 0
    while i < len(table.entries):
        if table.entries[i].tag == tag:
            return table.entries[i]
        i = i + 1
    return IrContractEntry()

; 按名字取类别码：未命中答 -1；名字是 ASCII，逐字节比即可。
contractTagOf|func(table: IrContractTable, name: String,) -> (I32,):
    var i = 0
    while i < len(table.entries):
        if table.entries[i].name == name:
            return table.entries[i].tag
        i = i + 1
    return -1

; 表达式段条数（常量，供节点枚举对照）。
contractExprTotal|func() -> (I32,):
    return 56

; 语句段条数。
contractStmtTotal|func() -> (I32,):
    return 17
