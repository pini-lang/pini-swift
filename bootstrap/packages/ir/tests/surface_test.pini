; 接缝面判据：声明、槽位、位置、份额与校验各钉一条形状或读数。
; 校验两面都要：正例由完整装配链产出，违约夹具手搭模块；只有正例时，规则全删也是绿的。

; 手搭模块：逐节点入池，附一个只带体入口的函数，用于造违约。
造模块|func(nodes: Array<IrNode>, types: IrTypePool, body: Array<I32>,) -> (IrModule,):
    var out = IrModule()
    out.types = types
    var pool = IrNodePool()
    var i = 0
    while i < len(nodes):
        let inserted = irAppendNode(pool = pool, node = nodes[i])
        pool = inserted.pool
        i = i + 1
    out.nodes = pool
    var fn = IrFunction()
    fn.name = "f"
    fn.sourceFile = "样例"
    fn.body = body
    out.functions = out.functions.append(fn)
    return out

; 类型下标：按拼写查 IR 池，未命中答 -1。
类型下标|func(module: IrModule, name: String,) -> (I32,):
    var i = 0
    while i < irTypeCount(module.types):
        if module.types.entries[i].name == name:
            return i
        i = i + 1
    return -1

; 按类别查类型：容器与可选的拼写为空，只能按类别找。
类型下标按类|func(module: IrModule, kind: IrTypeClass,) -> (I32,):
    var i = 0
    while i < irTypeCount(module.types):
        if irTypeTag(module.types.entries[i].kind) == irTypeTag(kind):
            return i
        i = i + 1
    return -1

; 违约判定：细节串以规则名开头，按名匹配。
有违约|func(errors: Array<LowerError>, name: String,) -> (Bool,):
    var i = 0
    while i < len(errors):
        if errors[i].detail.indexOf(name) == 0:
            return true
        i = i + 1
    return false

; 声明面：结构字段按声明序成槽，枚举用例按声明序成标签。
声明面|test() -> ():
    let src = "(点)\nx: I32 = 0\ny: I64 = 0\n\n[旗]\n甲\n乙\n\nf|func() -> ():\n    return\n"
    let 样例 = 造样例(src)
    assert(len(样例.module.errors) == 0, "样例应降载成功")
    let 点 = 类型下标(module = 样例.module, name = "点")
    assert(点 >= 0, "结构应进类型池")
    assert(fieldCountOf(table = 样例.module.decls, typeId = 点) == 2, "结构应有两个字段")
    assert(fieldSlotOf(table = 样例.module.decls, typeId = 点, name = "y") == 1, "第二个字段的槽应为 1")
    let 旗 = 类型下标(module = 样例.module, name = "旗")
    assert(caseTagOf(table = 样例.module.decls, typeId = 旗, caseName = "乙") == 1, "第二个用例的标签应为 1")
    return

; 槽位面：结构四格头加字段，枚举再加标签槽与最宽载荷窗口。
槽位面|test() -> ():
    let src = "(点)\nx: I32 = 0\n\n[旗]\n甲\n乙(I32,)\n\nf|func() -> ():\n    return\n"
    let 样例 = 造样例(src)
    assert(样例.module.slots.headSlots == 4, "头槽应为四格")
    assert(样例.module.slots.payloadBase == 5, "载荷基址应为五")
    let 点 = 类型下标(module = 样例.module, name = "点")
    assert(slotCountOf(table = 样例.module.slots, typeId = 点) == 5, "结构应为四格头加一字段")
    let 旗 = 类型下标(module = 样例.module, name = "旗")
    assert(slotCountOf(table = 样例.module.slots, typeId = 旗) == 6, "枚举应为四格头加标签加一位载荷")
    return

; 位置面：每条顶层语句一条位置，偏移非负且按源序递增。
位置面|test() -> ():
    let src = "f|func() -> (I32,):\n    let a = 1\n    let b = 2\n    return a + b\n"
    let 样例 = 造样例(src)
    let at = 取函数(样例 = 样例, name = "f")
    assert(at >= 0, "函数应在表里")
    let fn = 样例.module.functions[at]
    assert(len(fn.positions) == 3, "三条语句应各有一条位置")
    assert(fn.positions[0].offset >= 0, "位置偏移应非负")
    assert(fn.positions[0].offset < fn.positions[1].offset, "位置应按源序递增")
    assert(positionOf(positions = fn.positions, node = fn.body[0]) == fn.positions[0].offset, "按节点能查回偏移")
    return

; 归还面：字符串字面量是全局常量，落槽按借用保留；覆盖字符串槽要还旧值。
归还面|test() -> ():
    let src = "f|func() -> ():\n    var s = \"甲\"\n    s = \"乙\"\n    return\n"
    let 样例 = 造样例(src)
    let at = 取函数(样例 = 样例, name = "f")
    let body = 样例.module.functions[at].body
    let 声明 = irNodeAt(pool = 样例.module.nodes, id = body[0])
    assert(声明.adopt == irAdoptTag(.irAdoptRetain), "字符串字面量是借用，落槽要保留")
    let 赋值 = irNodeAt(pool = 样例.module.nodes, id = body[1])
    assert(赋值.adopt == irAdoptTag(.irAdoptRetain), "字面量赋值同样按借用保留")
    assert(赋值.releaseOld, "覆盖字符串槽应还旧值")
    return

; 校验正例：完整链降出的模块零违约，且确实走过节点。
校验正例|test() -> ():
    let src = "(点)\nx: I32 = 0\n\nf|func() -> ():\n    var 甲 = 点()\n    甲.x = 1\n    return\n"
    let 样例 = 造样例(src)
    let 检 = validateModule(module = 样例.module)
    assert(len(检.errors) == 0, "正例不应有违约")
    assert(检.visited > 0, "正例应走过节点")
    return

; 校验违约：槽位越界、子节点越界、类别码不属两段、空体无缺口，各响一次。
校验违约|test() -> ():
    var types = IrTypePool()
    let placed = irScalarType(pool = types, kind = .irTypeI32, name = "i32")
    types = placed.pool
    var base = irMakeNode(kind = irExprTag(.irIntConst), typeId = placed.id)
    base.intValue = 1
    var get = irMakeNode(kind = irExprTag(.irFieldGet), typeId = placed.id)
    get.op = 7
    get.kids = [0]
    var stmt = irMakeNode(kind = irStmtTag(.irExprStmt), typeId = -1)
    stmt.kids = [1]
    let 坏槽 = 造模块(nodes = [base, get, stmt], types = types, body = [2])
    assert(有违约(errors = validateModule(module = 坏槽).errors, name = "字段槽"), "槽位越界应报")
    var 悬空 = irMakeNode(kind = irStmtTag(.irExprStmt), typeId = -1)
    悬空.kids = [99]
    var 悬空表: Array<IrNode> = []
    悬空表 = 悬空表.append(悬空)
    let 坏下标 = 造模块(nodes = 悬空表, types = types, body = [0])
    assert(有违约(errors = validateModule(module = 坏下标).errors, name = "子节点下标"), "子节点越界应报")
    var 野类 = irMakeNode(kind = 999, typeId = -1)
    var 野类表: Array<IrNode> = []
    野类表 = 野类表.append(野类)
    let 坏类别 = 造模块(nodes = 野类表, types = types, body = [0])
    assert(有违约(errors = validateModule(module = 坏类别).errors, name = "节点类别"), "类别码越段应报")
    let 空体 = 造模块(nodes = [], types = types, body = [])
    assert(有违约(errors = validateModule(module = 空体).errors, name = "空体对照"), "空体无缺口应报")
    return
