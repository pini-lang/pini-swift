[lower_test|import]
_syntax = "../../syntax"
_module_loader = "../../module-loader"
_semantics = "../../semantics"

; 降载判据：方法调用、标签实参归位与三类赋值目标，逐项钉住节点形状与符号名。
; 判据只读函数表与节点池，不看发射产物；节点文本一律经文本池还原。

; 降载样例：一个单元走完整装配链后的模块。
(降载样例)
module: IrModule = IrModule()

; 造样例：装载、注册、类型、世界、填表、降载六步，顺序不能反。
造样例|func(_src: String,) -> (降载样例,):
    let loaded = loadUnit(path = "packages/p/src/api/a.pini", text = _src)
    assert(!loaded.failed, "样例应可加载")
    assert(len(loaded.unit.diagnostics) == 0, "样例应无语法诊断")
    let units = [loaded.unit]
    let table = registerPackage(units)
    let types = resolvePackage(units = units, table = table)
    var world = makeMemberWorld(units = units, table = table, types = types)
    let 填 = fillExprTypes(world = world, units = units)
    var 类型面 = world.types
    类型面.pool = 填.pool
    world.types = 类型面
    var input = LowerWorld()
    input.world = world
    input.types = 填.types
    var out = 降载样例()
    out.module = lowerWorkspace(input = input)
    return out

; 取函数：按名字查函数表，找不到答 -1。
取函数|func(样例: 降载样例, name: String,) -> (I32,):
    return findFunction(module = 样例.module, name = name)

; 取节点：按类别码与文本查节点池，命中答下标，未命中答 -1。
取节点|func(样例: 降载样例, kind: I32, text: String,) -> (I32,):
    var i = 0
    while i < irNodeCount(样例.module.nodes):
        let node = irNodeAt(pool = 样例.module.nodes, id = i)
        if node.kind == kind:
            if node.text >= 0 && textAt(module = 样例.module, id = node.text) == text:
                return i
        i = i + 1
    return -1

; 取首个指定类别的节点：切片这类节点不带文本，按文本查不到。
取节点按类别|func(样例: 降载样例, kind: I32,) -> (I32,):
    var i = 0
    while i < irNodeCount(样例.module.nodes):
        if irNodeAt(pool = 样例.module.nodes, id = i).kind == kind:
            return i
        i = i + 1
    return -1

; 名字编码：非 ASCII 标量按 `_u` 加四位大写十六进制，与宿主同一规则。
方法名编码|test() -> ():
    assert(mangleName(name = "plus") == "plus", "ASCII 名应原样返回")
    assert(mangleName(name = "距离") == "_u8DDD_u79BB", "中文名应逐标量编码")
    assert(instanceMethodName(method = "plus", owner = "Point") == "plus__Point", "实例方法名应带类型后缀")
    assert(ownMethodName(method = "make", owner = "Point") == "own__make__Point", "本型方法名应加 own 前缀")
    return

; 方法调用：符号名按「方法__类型」出，自身排在形参表首位，接收者作首实参。
方法调用|test() -> ():
    let src = "(Point)\nx: I32 = 0\n\n((Point))\nplus|self(_other: Point,) -> (I32,):\n    return self.x + _other.x\n\nuse|func(_p: Point, _q: Point,) -> (I32,):\n    return _p.plus(_q)\n"
    let 样例 = 造样例(src)
    let at = 取函数(样例 = 样例, name = "plus__Point")
    assert(at >= 0, "方法应以「方法__类型」进函数表")
    let 方法 = 样例.module.functions[at]
    assert(len(方法.params) == 2, "自身加一个形参")
    assert(方法.params[0].name == "self", "首位应是自身")
    assert(方法.params[1].name == "_other", "次位应是声明里的形参")
    let 调用 = 取节点(样例 = 样例, kind = irExprTag(.irCall), text = "plus__Point")
    assert(调用 >= 0, "调用点应指向方法符号")
    let 节点 = irNodeAt(pool = 样例.module.nodes, id = 调用)
    assert(len(节点.kids) == 2, "实参应是接收者加一个形参")
    assert(irNodeAt(pool = 样例.module.nodes, id = 节点.kids[0]).kind == irExprTag(.irLoad), "首实参应是接收者的读")
    return

; 标签实参：源序乱写时按形参声明序归位，节点里的实参顺序随之落定。
标签归位|test() -> ():
    let src = "add|func(a: I32, b: I32,) -> (I32,):\n    return a + b\n\nrun|func() -> (I32,):\n    return add(b = 2, a = 1)\n"
    let 样例 = 造样例(src)
    let 调用 = 取节点(样例 = 样例, kind = irExprTag(.irCall), text = "add")
    assert(调用 >= 0, "调用点应在节点池里")
    let 节点 = irNodeAt(pool = 样例.module.nodes, id = 调用)
    assert(len(节点.kids) == 2, "两个实参都应落位")
    let 首: I32 = 节点.kids[0]
    let 次: I32 = 节点.kids[1]
    assert(irNodeAt(pool = 样例.module.nodes, id = 首).intValue == 1 as I64, "首个实参应是 a 的值")
    assert(irNodeAt(pool = 样例.module.nodes, id = 次).intValue == 2 as I64, "次个实参应是 b 的值")
    return

; 复合赋值：标识符读改写落在同一个局部，二元节点夹在读与写之间。
变量复合赋值|test() -> ():
    let src = "bump|func(_n: I32,) -> (I32,):\n    var i = 0\n    i += _n\n    return i\n"
    let 样例 = 造样例(src)
    let store = 取节点(样例 = 样例, kind = irStmtTag(.irStoreVar), text = "i")
    assert(store >= 0, "复合赋值应落成一次写入")
    let 写 = irNodeAt(pool = 样例.module.nodes, id = store)
    let 值: I32 = 写.kids[0]
    let 二元 = irNodeAt(pool = 样例.module.nodes, id = 值)
    assert(二元.kind == irExprTag(.irBinary), "写入的值应是二元节点")
    assert(二元.op == irBinaryTag(.irAdd), "加法赋值应映射成加法")
    let 左: I32 = 二元.kids[0]
    assert(irNodeAt(pool = 样例.module.nodes, id = 左).kind == irExprTag(.irLoad), "左操作数应是目标读")
    return

; 字段与下标：复合赋值先读后写，两个节点指向同一个接收者或容器。
字段与下标复合赋值|test() -> ():
    let src = "(Box)\nn: I32 = 0\n\n((Box))\nbump|self(_step: I32,) -> (I32,):\n    self.n += _step\n    return self.n\n\nshift|func(_arr: [I32,],) -> (I32,):\n    _arr[0] += 2\n    return _arr[0]\n"
    let 样例 = 造样例(src)
    assert(countNodes(module = 样例.module, kind = irStmtTag(.irFieldStore)) == 1, "字段赋值应有一个写节点")
    assert(countNodes(module = 样例.module, kind = irStmtTag(.irSubscriptStore)) == 1, "下标赋值应有一个写节点")
    assert(countNodes(module = 样例.module, kind = irExprTag(.irFieldGet)) == 2, "字段读两处：复合赋值的读与返回值的读")
    return

; 普通赋值：字段与下标各写一次，目标不是标识符也不再报缺口。
字段与下标写|test() -> ():
    let src = "(Box)\nn: I32 = 0\n\n((Box))\nreset|self(_value: I32,) -> (I32,):\n    self.n = _value\n    return self.n\n\nput|func(_arr: [I32,], _value: I32,) -> (I32,):\n    _arr[0] = _value\n    return _arr[0]\n"
    let 样例 = 造样例(src)
    assert(len(样例.module.errors) == 0, "两个函数都应降载成功")
    assert(emptyBodyCount(module = 样例.module) == 0, "不应留空体")
    assert(countNodes(module = 样例.module, kind = irStmtTag(.irFieldStore)) == 1, "字段写应有一个节点")
    assert(countNodes(module = 样例.module, kind = irStmtTag(.irSubscriptStore)) == 1, "下标写应有一个节点")
    return

; 字符串取值：去引号、按转义表还原，`\0` 之后的内容丢弃。
字符串取值|test() -> ():
    assert(stringLiteralText(bytes = tempUtf8Bytes("\"ab\""), start = 0, end = 4) == "ab", "应去掉首尾引号")
    assert(stringLiteralText(bytes = tempUtf8Bytes("\"a\\nb\""), start = 0, end = 6) == "a\nb", "换行转义应还原")
    assert(stringLiteralText(bytes = tempUtf8Bytes("\"a\\0b\""), start = 0, end = 6) == "a", "内容终止符之后应丢弃")
    return

; 带标注的声明：分配按标注定型，字面量初值也按标注定型，不再多包一层转换。
带标注声明|test() -> ():
    let src = "f|func() -> (I64,):\n    let n: I64 = 1\n    return n\n"
    let 样例 = 造样例(src)
    assert(len(样例.module.errors) == 0, "带标注的声明应降载成功")
    let at = 取函数(样例 = 样例, name = "f")
    assert(at >= 0, "函数应在表里")
    let 分配 = irNodeAt(pool = 样例.module.nodes, id = 样例.module.functions[at].body[0])
    assert(irTypeText(pool = 样例.module.types, id = 分配.typeId) == "i64", "分配类型应取标注")
    assert(len(分配.kids) == 1, "初值应有一个子节点")
    let 初值 = irNodeAt(pool = 样例.module.nodes, id = 分配.kids[0])
    assert(初值.kind == irExprTag(.irIntConst), "字面量初值应直接按标注定型")
    assert(irTypeText(pool = 样例.module.types, id = 初值.typeId) == "i64", "初值类型应与标注一致")
    return

; 字符串与数组字面量：值驻留文本池，数组元素保序，空数组按标注定型。
字面量降载|test() -> ():
    let src = "f|func() -> (I32,):\n    let s = \"ab\"\n    let xs = [1, 2]\n    var out: Array<I32> = []\n    return len(xs)\n"
    let 样例 = 造样例(src)
    assert(len(样例.module.errors) == 0, "字面量应全部降载")
    assert(countNodes(module = 样例.module, kind = irExprTag(.irStringConst)) == 1, "字符串应有一个常量节点")
    assert(countNodes(module = 样例.module, kind = irExprTag(.irArrayLiteral)) == 2, "两个数组字面量各一个节点")
    var 空数组 = -1
    var 有元素 = -1
    var i = 0
    while i < irNodeCount(样例.module.nodes):
        let 节点 = irNodeAt(pool = 样例.module.nodes, id = i)
        if 节点.kind == irExprTag(.irArrayLiteral):
            if len(节点.kids) == 0:
                空数组 = i
            else:
                有元素 = i
        i = i + 1
    assert(空数组 >= 0 && 有元素 >= 0, "两种数组字面量都应出现")
    assert(irTypeText(pool = 样例.module.types, id = irNodeAt(pool = 样例.module.nodes, id = 空数组).typeId) == "array<i32>", "空数组的类型应来自标注")
    assert(len(irNodeAt(pool = 样例.module.nodes, id = 有元素).kids) == 2, "数组元素应保序保全")
    return

; 零参构造：类型名作被调时产构造节点，类型取池里的同名名义条目。
零参构造|test() -> ():
    let src = "(Label)\nstart: I32 = 0\n\nf|func() -> (Label,):\n    let one = Label()\n    return one\n"
    let 样例 = 造样例(src)
    assert(len(样例.module.errors) == 0, "零参构造应降载成功")
    assert(countNodes(module = 样例.module, kind = irExprTag(.irConstruct)) == 1, "应有一个构造节点")
    var at = -1
    var i = 0
    while i < irNodeCount(样例.module.nodes):
        if irNodeAt(pool = 样例.module.nodes, id = i).kind == irExprTag(.irConstruct):
            at = i
        i = i + 1
    assert(at >= 0, "构造节点应在池里")
    assert(irTypeText(pool = 样例.module.types, id = irNodeAt(pool = 样例.module.nodes, id = at).typeId) == "Label", "构造类型应是名义类型")
    return

; 内建调用：包级符号表里没有的名字回落到内建表，返回类型按形状映射。
内建调用|test() -> ():
    let src = "f|func() -> (I32,):\n    let bytes = tempUtf8Bytes(\"ab\")\n    return len(bytes)\n"
    let 样例 = 造样例(src)
    assert(len(样例.module.errors) == 0, "内建调用应降载成功")
    let at = 取节点(样例 = 样例, kind = irExprTag(.irCall), text = "tempUtf8Bytes")
    assert(at >= 0, "调用节点应指向内建名")
    assert(irTypeText(pool = 样例.module.types, id = irNodeAt(pool = 样例.module.nodes, id = at).typeId) == "array<u8>", "返回类型应按形状定为 array<u8>")
    return

; 前导点用例：候选枚举唯一即定型，构造节点带声明序 tag（0 起），文本是用例名。
前导点用例|test() -> ():
    let src = "[Flags]\n甲\n乙\n\nf|func() -> (Flags,):\n    return .乙\n"
    let 样例 = 造样例(src)
    assert(len(样例.module.errors) == 0, "前导点用例应降载成功")
    let at = 取节点(样例 = 样例, kind = irExprTag(.irEnumConstruct), text = "乙")
    assert(at >= 0, "应有一个枚举构造节点")
    let 节点 = irNodeAt(pool = 样例.module.nodes, id = at)
    assert(节点.op == 1, "tag 应取声明序，乙是第二个")
    assert(irTypeText(pool = 样例.module.types, id = 节点.typeId) == "Flags", "构造类型应是枚举名")
    return

; 裸名用例：报缺口并给出应写的写法 —— 用例是枚举的成员，值位必须带点或限定。
裸名用例|test() -> ():
    let src = "[Flags]\n甲\n\nf|func() -> (Flags,):\n    return 甲\n"
    let 样例 = 造样例(src)
    assert(len(样例.module.errors) == 1, "裸名用例应报一条缺口")
    assert(样例.module.errors[0].detail.indexOf("须写成 .甲") >= 0, "缺口应给出应写写法")
    return

; 同名用例：期望类型是甲，前导点按期望定型，不再靠唯一候选。
同名用例|test() -> ():
    let src = "[甲]\nx\n\n[乙]\nx\n\nf|func() -> (甲,):\n    return .x\n"
    let 样例 = 造样例(src)
    assert(len(样例.module.errors) == 0, "期望类型应消解同名歧义")
    let at = 取节点(样例 = 样例, kind = irExprTag(.irEnumConstruct), text = "x")
    assert(at >= 0, "应有一个枚举构造节点")
    assert(irTypeText(pool = 样例.module.types, id = irNodeAt(pool = 样例.module.nodes, id = at).typeId) == "甲", "构造类型应取期望的枚举")
    return

; 数组成员：append 走「Array.append」命名调用（与宿主同形，不加节点类别），结果类型取接收者。
数组追加|test() -> ():
    let src = "f|func(_items: Array<I32>,) -> (Array<I32>,):\n    let grown = _items.append(2)\n    return grown\n"
    let 样例 = 造样例(src)
    assert(len(样例.module.errors) == 0, "数组成员调用应降载成功")
    let at = 取节点(样例 = 样例, kind = irExprTag(.irCall), text = "Array.append")
    assert(at >= 0, "append 应降成命名调用")
    let 节点 = irNodeAt(pool = 样例.module.nodes, id = at)
    assert(len(节点.kids) == 2, "接收者加一个实参")
    assert(irTypeText(pool = 样例.module.types, id = 节点.typeId) == "array<i32>", "结果类型应与接收者同形")
    return

; 数组成员：slice 发切片节点，两个边界按位落成三子节点，结果类型取接收者。
数组切片|test() -> ():
    let src = "f|func(_items: Array<I32>,) -> (Array<I32>,):\n    let part = _items.slice(0, 1)\n    return part\n"
    let 样例 = 造样例(src)
    assert(len(样例.module.errors) == 0, "slice 应降载成功")
    let at = 取节点按类别(样例 = 样例, kind = irExprTag(.irSliceCall))
    assert(at >= 0, "slice 应发切片节点")
    let 节点 = irNodeAt(pool = 样例.module.nodes, id = at)
    assert(len(节点.kids) == 3, "接收者加两个边界")
    assert(irTypeText(pool = 样例.module.types, id = 节点.typeId) == "array<i32>", "结果类型应与接收者同形")
    return

; 文本池：同内容复用下标，新内容追加到末尾，池只增不复制。
文本驻留|test() -> ():
    var pool = IrTextPool()
    let first = internText(texts = pool, value = "alpha")
    let again = internText(texts = pool, value = "alpha")
    let second = internText(texts = pool, value = "beta")
    assert(first.id == 0, "首条应为 0")
    assert(again.id == 0, "同内容应复用下标")
    assert(second.id == 1, "新内容应追加")
    assert(len(pool.items) == 2, "池里应只有两条")
    return
