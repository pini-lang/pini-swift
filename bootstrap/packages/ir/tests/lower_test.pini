[lower_test|import]
_syntax = "../../syntax"
_module_loader = "../../module-loader"
_semantics = "../../semantics"

; 降载判据：方法调用、标签实参归位与三类赋值目标，逐项钉住节点形状与符号名。
; 判据只读函数表与节点池，不看发射产物；节点文本一律经文本池还原。

; 降载样例：一个单元走完整装配链后的模块。
(降载样例)
module: IrModule = IrModule()

; 造样例：装载、注册、类型、世界、填表、泛型实例、降载七步，顺序不能反。
造样例|func(_src: String,) -> (降载样例,):
    let loaded = loadUnit(path = "packages/p/src/api/a.pini", text = _src)
    assert(!loaded.failed, "样例应可加载")
    assert(len(loaded.unit.diagnostics) == 0, "样例应无语法诊断")
    let units = [loaded.unit]
    let table = registerPackage(units)
    let types = resolvePackage(units = units, table = table)
    var world = makeMemberWorld(units = units, table = table, types = types)
    let 填 = fillExprTypes(world = world, units = units)
    let 泛 = instantiateGenerics(world = world, units = units, fill = 填)
    var 类型面 = world.types
    类型面.pool = 泛.pool
    world.types = 类型面
    var input = LowerWorld()
    input.world = world
    input.types = 泛.types
    input.generics = 泛
    let shapes = makeShapeTable(world)
    input.shapes = shapes
    input.layouts = layoutAll(shapes = shapes, pool = world.types.pool)
    var out = 降载样例()
    out.module = lowerWorkspace(input = input)
    return out

; 取函数：按名字查函数表，找不到答 -1。
取函数|func(样例: 降载样例, name: String,) -> (I32,):
    return findFunction(module = 样例.module, name = name)

; 取节点：按类别码与文本查节点池，命中答下标，未命中答 -1。
取节点|func(样例: 降载样例, kind: I32, text: String,) -> (I32,):
    var i = 0
    while i < irNodeCount(样例.module.nodes):
        let node = irNodeAt(pool = 样例.module.nodes, id = i)
        if node.kind == kind:
            if node.text >= 0 && textAt(module = 样例.module, id = node.text) == text:
                return i
        i = i + 1
    return -1

; 取首个指定类别的节点：切片这类节点不带文本，按文本查不到。
取节点按类别|func(样例: 降载样例, kind: I32,) -> (I32,):
    var i = 0
    while i < irNodeCount(样例.module.nodes):
        if irNodeAt(pool = 样例.module.nodes, id = i).kind == kind:
            return i
        i = i + 1
    return -1

; 取指定类别与操作的节点：同一类别可能发多次，按 op 区分，找不到答 -1。
取节点按操作|func(样例: 降载样例, kind: I32, op: I32,) -> (I32,):
    var i = 0
    while i < irNodeCount(样例.module.nodes):
        let 节点 = irNodeAt(pool = 样例.module.nodes, id = i)
        if 节点.kind == kind && 节点.op == op:
            return i
        i = i + 1
    return -1

; 名字编码：非 ASCII 标量按 `_u` 加四位大写十六进制，与宿主同一规则。
方法名编码|test() -> ():
    assert(mangleName(name = "plus") == "plus", "ASCII 名应原样返回")
    assert(mangleName(name = "距离") == "_u8DDD_u79BB", "中文名应逐标量编码")
    assert(instanceMethodName(method = "plus", owner = "Point") == "plus__Point", "实例方法名应带类型后缀")
    assert(ownMethodName(method = "make", owner = "Point") == "own__make__Point", "本型方法名应加 own 前缀")
    return

; 方法调用：符号名按「方法__类型」出，自身排在形参表首位，接收者作首实参。
方法调用|test() -> ():
    let src = "(Point)\nx: I32 = 0\n\n((Point))\nplus|self(_other: Point,) -> (I32,):\n    return self.x + _other.x\n\nuse|func(_p: Point, _q: Point,) -> (I32,):\n    return _p.plus(_q)\n"
    let 样例 = 造样例(src)
    let at = 取函数(样例 = 样例, name = "plus__Point")
    assert(at >= 0, "方法应以「方法__类型」进函数表")
    let 方法 = 样例.module.functions[at]
    assert(len(方法.params) == 2, "自身加一个形参")
    assert(方法.params[0].name == "self", "首位应是自身")
    assert(方法.params[1].name == "_other", "次位应是声明里的形参")
    let 调用 = 取节点(样例 = 样例, kind = irExprTag(.irCall), text = "plus__Point")
    assert(调用 >= 0, "调用点应指向方法符号")
    let 节点 = irNodeAt(pool = 样例.module.nodes, id = 调用)
    assert(len(节点.kids) == 2, "实参应是接收者加一个形参")
    assert(irNodeAt(pool = 样例.module.nodes, id = 节点.kids[0]).kind == irExprTag(.irLoad), "首实参应是接收者的读")
    return

; 标签实参：源序乱写时按形参声明序归位，节点里的实参顺序随之落定。
标签归位|test() -> ():
    let src = "add|func(a: I32, b: I32,) -> (I32,):\n    return a + b\n\nrun|func() -> (I32,):\n    return add(b = 2, a = 1)\n"
    let 样例 = 造样例(src)
    let 调用 = 取节点(样例 = 样例, kind = irExprTag(.irCall), text = "add")
    assert(调用 >= 0, "调用点应在节点池里")
    let 节点 = irNodeAt(pool = 样例.module.nodes, id = 调用)
    assert(len(节点.kids) == 2, "两个实参都应落位")
    let 首: I32 = 节点.kids[0]
    let 次: I32 = 节点.kids[1]
    assert(irNodeAt(pool = 样例.module.nodes, id = 首).intValue == 1 as I64, "首个实参应是 a 的值")
    assert(irNodeAt(pool = 样例.module.nodes, id = 次).intValue == 2 as I64, "次个实参应是 b 的值")
    return

; 复合赋值：标识符读改写落在同一个局部，二元节点夹在读与写之间。
变量复合赋值|test() -> ():
    let src = "bump|func(_n: I32,) -> (I32,):\n    var i = 0\n    i += _n\n    return i\n"
    let 样例 = 造样例(src)
    let store = 取节点(样例 = 样例, kind = irStmtTag(.irStoreVar), text = "i")
    assert(store >= 0, "复合赋值应落成一次写入")
    let 写 = irNodeAt(pool = 样例.module.nodes, id = store)
    let 值: I32 = 写.kids[0]
    let 二元 = irNodeAt(pool = 样例.module.nodes, id = 值)
    assert(二元.kind == irExprTag(.irBinary), "写入的值应是二元节点")
    assert(二元.op == irBinaryTag(.irAdd), "加法赋值应映射成加法")
    let 左: I32 = 二元.kids[0]
    assert(irNodeAt(pool = 样例.module.nodes, id = 左).kind == irExprTag(.irLoad), "左操作数应是目标读")
    return

; 字段与下标：复合赋值先读后写，两个节点指向同一个接收者或容器。
字段与下标复合赋值|test() -> ():
    let src = "(Box)\nn: I32 = 0\n\n((Box))\nbump|self(_step: I32,) -> (I32,):\n    self.n += _step\n    return self.n\n\nshift|func(_arr: [I32,],) -> (I32,):\n    _arr[0] += 2\n    return _arr[0]\n"
    let 样例 = 造样例(src)
    assert(countNodes(module = 样例.module, kind = irStmtTag(.irFieldStore)) == 1, "字段赋值应有一个写节点")
    assert(countNodes(module = 样例.module, kind = irStmtTag(.irSubscriptStore)) == 1, "下标赋值应有一个写节点")
    assert(countNodes(module = 样例.module, kind = irExprTag(.irFieldGet)) == 2, "字段读两处：复合赋值的读与返回值的读")
    return

; 普通赋值：字段与下标各写一次，目标不是标识符也不再报缺口。
字段与下标写|test() -> ():
    let src = "(Box)\nn: I32 = 0\n\n((Box))\nreset|self(_value: I32,) -> (I32,):\n    self.n = _value\n    return self.n\n\nput|func(_arr: [I32,], _value: I32,) -> (I32,):\n    _arr[0] = _value\n    return _arr[0]\n"
    let 样例 = 造样例(src)
    assert(len(样例.module.errors) == 0, "两个函数都应降载成功")
    assert(emptyBodyCount(module = 样例.module) == 0, "不应留空体")
    assert(countNodes(module = 样例.module, kind = irStmtTag(.irFieldStore)) == 1, "字段写应有一个节点")
    assert(countNodes(module = 样例.module, kind = irStmtTag(.irSubscriptStore)) == 1, "下标写应有一个节点")
    return

; 字符串取值：去引号、按转义表还原，`\0` 之后的内容丢弃。
字符串取值|test() -> ():
    assert(stringLiteralText(bytes = tempUtf8Bytes("\"ab\""), start = 0, end = 4) == "ab", "应去掉首尾引号")
    assert(stringLiteralText(bytes = tempUtf8Bytes("\"a\\nb\""), start = 0, end = 6) == "a\nb", "换行转义应还原")
    assert(stringLiteralText(bytes = tempUtf8Bytes("\"a\\0b\""), start = 0, end = 6) == "a", "内容终止符之后应丢弃")
    return

; 带标注的声明：分配按标注定型，字面量初值也按标注定型，不再多包一层转换。
带标注声明|test() -> ():
    let src = "f|func() -> (I64,):\n    let n: I64 = 1\n    return n\n"
    let 样例 = 造样例(src)
    assert(len(样例.module.errors) == 0, "带标注的声明应降载成功")
    let at = 取函数(样例 = 样例, name = "f")
    assert(at >= 0, "函数应在表里")
    let 分配 = irNodeAt(pool = 样例.module.nodes, id = 样例.module.functions[at].body[0])
    assert(irTypeText(pool = 样例.module.types, id = 分配.typeId) == "i64", "分配类型应取标注")
    assert(len(分配.kids) == 1, "初值应有一个子节点")
    let 初值 = irNodeAt(pool = 样例.module.nodes, id = 分配.kids[0])
    assert(初值.kind == irExprTag(.irIntConst), "字面量初值应直接按标注定型")
    assert(irTypeText(pool = 样例.module.types, id = 初值.typeId) == "i64", "初值类型应与标注一致")
    return

; 字符串与数组字面量：值驻留文本池，数组元素保序，空数组按标注定型。
字面量降载|test() -> ():
    let src = "f|func() -> (I32,):\n    let s = \"ab\"\n    let xs = [1, 2]\n    var out: Array<I32> = []\n    return len(xs)\n"
    let 样例 = 造样例(src)
    assert(len(样例.module.errors) == 0, "字面量应全部降载")
    assert(countNodes(module = 样例.module, kind = irExprTag(.irStringConst)) == 1, "字符串应有一个常量节点")
    assert(countNodes(module = 样例.module, kind = irExprTag(.irArrayLiteral)) == 2, "两个数组字面量各一个节点")
    var 空数组 = -1
    var 有元素 = -1
    var i = 0
    while i < irNodeCount(样例.module.nodes):
        let 节点 = irNodeAt(pool = 样例.module.nodes, id = i)
        if 节点.kind == irExprTag(.irArrayLiteral):
            if len(节点.kids) == 0:
                空数组 = i
            else:
                有元素 = i
        i = i + 1
    assert(空数组 >= 0 && 有元素 >= 0, "两种数组字面量都应出现")
    assert(irTypeText(pool = 样例.module.types, id = irNodeAt(pool = 样例.module.nodes, id = 空数组).typeId) == "array<i32>", "空数组的类型应来自标注")
    assert(len(irNodeAt(pool = 样例.module.nodes, id = 有元素).kids) == 2, "数组元素应保序保全")
    return

; 零参构造：类型名作被调时产构造节点，类型取池里的同名名义条目。
零参构造|test() -> ():
    let src = "(Label)\nstart: I32 = 0\n\nf|func() -> (Label,):\n    let one = Label()\n    return one\n"
    let 样例 = 造样例(src)
    assert(len(样例.module.errors) == 0, "零参构造应降载成功")
    assert(countNodes(module = 样例.module, kind = irExprTag(.irConstruct)) == 1, "应有一个构造节点")
    var at = -1
    var i = 0
    while i < irNodeCount(样例.module.nodes):
        if irNodeAt(pool = 样例.module.nodes, id = i).kind == irExprTag(.irConstruct):
            at = i
        i = i + 1
    assert(at >= 0, "构造节点应在池里")
    assert(irTypeText(pool = 样例.module.types, id = irNodeAt(pool = 样例.module.nodes, id = at).typeId) == "Label", "构造类型应是名义类型")
    return

; 内建调用：包级符号表里没有的名字回落到内建表，返回类型按形状映射。
内建调用|test() -> ():
    let src = "f|func() -> (I32,):\n    let bytes = tempUtf8Bytes(\"ab\")\n    return len(bytes)\n"
    let 样例 = 造样例(src)
    assert(len(样例.module.errors) == 0, "内建调用应降载成功")
    let at = 取节点(样例 = 样例, kind = irExprTag(.irCall), text = "tempUtf8Bytes")
    assert(at >= 0, "调用节点应指向内建名")
    assert(irTypeText(pool = 样例.module.types, id = irNodeAt(pool = 样例.module.nodes, id = at).typeId) == "array<u8>", "返回类型应按形状定为 array<u8>")
    return

; 前导点用例：候选枚举唯一即定型，构造节点带声明序 tag（0 起），文本是用例名。
前导点用例|test() -> ():
    let src = "[Flags]\n甲\n乙\n\nf|func() -> (Flags,):\n    return .乙\n"
    let 样例 = 造样例(src)
    assert(len(样例.module.errors) == 0, "前导点用例应降载成功")
    let at = 取节点(样例 = 样例, kind = irExprTag(.irEnumConstruct), text = "乙")
    assert(at >= 0, "应有一个枚举构造节点")
    let 节点 = irNodeAt(pool = 样例.module.nodes, id = at)
    assert(节点.op == 1, "tag 应取声明序，乙是第二个")
    assert(irTypeText(pool = 样例.module.types, id = 节点.typeId) == "Flags", "构造类型应是枚举名")
    return

; 裸名用例：报缺口并给出应写的写法 —— 用例是枚举的成员，值位必须带点或限定。
裸名用例|test() -> ():
    let src = "[Flags]\n甲\n\nf|func() -> (Flags,):\n    return 甲\n"
    let 样例 = 造样例(src)
    assert(len(样例.module.errors) == 1, "裸名用例应报一条缺口")
    assert(样例.module.errors[0].detail.indexOf("须写成 .甲") >= 0, "缺口应给出应写写法")
    return

; 同名用例：期望类型是甲，前导点按期望定型，不再靠唯一候选。
同名用例|test() -> ():
    let src = "[甲]\nx\n\n[乙]\nx\n\nf|func() -> (甲,):\n    return .x\n"
    let 样例 = 造样例(src)
    assert(len(样例.module.errors) == 0, "期望类型应消解同名歧义")
    let at = 取节点(样例 = 样例, kind = irExprTag(.irEnumConstruct), text = "x")
    assert(at >= 0, "应有一个枚举构造节点")
    assert(irTypeText(pool = 样例.module.types, id = irNodeAt(pool = 样例.module.nodes, id = at).typeId) == "甲", "构造类型应取期望的枚举")
    return

; 数组成员：append 走「Array.append」命名调用（与宿主同形，不加节点类别），结果类型取接收者。
数组追加|test() -> ():
    let src = "f|func(_items: Array<I32>,) -> (Array<I32>,):\n    let grown = _items.append(2)\n    return grown\n"
    let 样例 = 造样例(src)
    assert(len(样例.module.errors) == 0, "数组成员调用应降载成功")
    let at = 取节点(样例 = 样例, kind = irExprTag(.irCall), text = "Array.append")
    assert(at >= 0, "append 应降成命名调用")
    let 节点 = irNodeAt(pool = 样例.module.nodes, id = at)
    assert(len(节点.kids) == 2, "接收者加一个实参")
    assert(irTypeText(pool = 样例.module.types, id = 节点.typeId) == "array<i32>", "结果类型应与接收者同形")
    return

; 数组成员：slice 发切片节点，两个边界按位落成三子节点，结果类型取接收者。
数组切片|test() -> ():
    let src = "f|func(_items: Array<I32>,) -> (Array<I32>,):\n    let part = _items.slice(0, 1)\n    return part\n"
    let 样例 = 造样例(src)
    assert(len(样例.module.errors) == 0, "slice 应降载成功")
    let at = 取节点按类别(样例 = 样例, kind = irExprTag(.irSliceCall))
    assert(at >= 0, "slice 应发切片节点")
    let 节点 = irNodeAt(pool = 样例.module.nodes, id = at)
    assert(len(节点.kids) == 3, "接收者加两个边界")
    assert(irTypeText(pool = 样例.module.types, id = 节点.typeId) == "array<i32>", "结果类型应与接收者同形")
    return

; 字符串一元成员：upper/lower 共用大小写节点按 op 分上下，修剪各发专属节点。
字符串一元成员|test() -> ():
    let src = "f|func(_s: String,) -> (String,):\n    let a = _s.upper()\n    let b = _s.lower()\n    let c = _s.trimLeft()\n    let d = _s.trimRight()\n    return a\n"
    let 样例 = 造样例(src)
    assert(len(样例.module.errors) == 0, "字符串一元成员应降载成功")
    assert(取节点按操作(样例 = 样例, kind = irExprTag(.irStringCase), op = 1) >= 0, "upper 应发 op 为 1 的大小写节点")
    assert(取节点按操作(样例 = 样例, kind = irExprTag(.irStringCase), op = 0) >= 0, "lower 应发 op 为 0 的大小写节点")
    assert(取节点按类别(样例 = 样例, kind = irExprTag(.irStringTrimLeft)) >= 0, "trimLeft 应发修剪左节点")
    assert(取节点按类别(样例 = 样例, kind = irExprTag(.irStringTrimRight)) >= 0, "trimRight 应发修剪右节点")
    return

; 字符串链式成员：内层调用结果类型未定时，只属字串的一元名仍应认出接收者。
字符串链式成员|test() -> ():
    let src = "f|func(_s: String,) -> (String,):\n    let a = _s.trimLeft().trimRight()\n    let b = _s.substring(0, 1).upper()\n    return a\n"
    let 样例 = 造样例(src)
    assert(len(样例.module.errors) == 0, "链式字符串成员应降载成功")
    assert(取节点按类别(样例 = 样例, kind = irExprTag(.irStringTrimRight)) >= 0, "链式 trimRight 应发修剪右节点")
    assert(取节点按操作(样例 = 样例, kind = irExprTag(.irStringCase), op = 1) >= 0, "链式 upper 应发大小写节点")
    return

; 文本池：同内容复用下标，新内容追加到末尾，池只增不复制。
文本驻留|test() -> ():
    var pool = IrTextPool()
    let first = internText(texts = pool, value = "alpha")
    let again = internText(texts = pool, value = "alpha")
    let second = internText(texts = pool, value = "beta")
    assert(first.id == 0, "首条应为 0")
    assert(again.id == 0, "同内容应复用下标")
    assert(second.id == 1, "新内容应追加")
    assert(len(pool.items) == 2, "池里应只有两条")
    return

; 字面量匹配：主体落进临时局部，分支链成 if；裸值未命中静默落到之后，不补陷阱。
字面量匹配|test() -> ():
    let src = "f|func(_n: I32,) -> (I32,):\n    match _n:\n        case 1:\n            return 1\n        case _:\n            return 0\n"
    let 样例 = 造样例(src)
    assert(len(样例.module.errors) == 0, "字面量匹配应降载成功")
    let at = 取函数(样例 = 样例, name = "f")
    assert(at >= 0, "函数应在表里")
    let body = 样例.module.functions[at].body
    assert(len(body) == 3, "主体临时局部、分支链与用完即弃各一条")
    assert(irNodeAt(pool = 样例.module.nodes, id = body[0]).kind == irStmtTag(.irAllocVar), "首条应是主体临时局部")
    let chain = irNodeAt(pool = 样例.module.nodes, id = body[1])
    assert(chain.kind == irStmtTag(.irIfStmt), "次条应是分支链")
    assert(chain.tail == 2, "条件加一条 then 语句")
    assert(irNodeAt(pool = 样例.module.nodes, id = body[2]).kind == irStmtTag(.irReleaseVar), "末条应是主语槽归还")
    assert(取节点按类别(样例 = 样例, kind = irStmtTag(.irPanicStmt)) < 0, "裸值匹配不补陷阱")
    assert(取节点按类别(样例 = 样例, kind = irExprTag(.irBinary)) >= 0, "条件应是比较")
    return

; 枚举匹配：标签读加整数字面量比较；没有通配臂就补陷阱，与宿主 matchStmt 同一收尾。
枚举匹配|test() -> ():
    let src = "[Flag]\n甲\n乙\n\nf|func(_v: Flag,) -> (I32,):\n    match _v:\n        case 甲:\n            return 1\n        case 乙:\n            return 0\n"
    let 样例 = 造样例(src)
    assert(len(样例.module.errors) == 0, "枚举匹配应降载成功")
    let tagAt = 取节点按类别(样例 = 样例, kind = irExprTag(.irEnumTagGet))
    assert(tagAt >= 0, "应有一个标签读节点")
    let tagNode = irNodeAt(pool = 样例.module.nodes, id = tagAt)
    assert(irTypeText(pool = 样例.module.types, id = tagNode.typeId) == "i32", "标签读答 i32")
    assert(len(tagNode.kids) == 1, "标签读只有一个操作数")
    assert(取节点按类别(样例 = 样例, kind = irStmtTag(.irPanicStmt)) >= 0, "枚举未命中应补陷阱")
    return

; 结果匹配：带绑定臂先读载荷再落局部；ok 取结果实参，err 取擦除后的错误字。
结果绑定|test() -> ():
    let src = "f|func(_r: ^I32,) -> (I32,):\n    match _r:\n        case ok(v,):\n            return v\n        case err(_e,):\n            return 0\n"
    let 样例 = 造样例(src)
    assert(len(样例.module.errors) == 0, "结果匹配应降载成功")
    let okAt = 取节点(样例 = 样例, kind = irExprTag(.irEnumPayloadGet), text = "ok")
    assert(okAt >= 0, "ok 臂应读载荷")
    let okNode = irNodeAt(pool = 样例.module.nodes, id = okAt)
    assert(okNode.op == 0, "ok 载荷序号为 0")
    assert(irTypeText(pool = 样例.module.types, id = okNode.typeId) == "i32", "ok 载荷类型取结果实参")
    let errAt = 取节点(样例 = 样例, kind = irExprTag(.irEnumPayloadGet), text = "err")
    assert(errAt >= 0, "err 臂应读载荷")
    assert(irTypeText(pool = 样例.module.types, id = irNodeAt(pool = 样例.module.nodes, id = errAt).typeId) == "i64", "错误字按 i64")
    assert(取节点(样例 = 样例, kind = irStmtTag(.irAllocVar), text = "v") >= 0, "绑定 v 应落局部")
    return

; 并发：异步体返回结算值，调用站点是任务句柄，等待站点回到结算值。
异步降载|test() -> ():
    let src = "子|func() => (I32,):\n    return ok(7)\n\nf|func() -> ():\n    let t = 子()\n    let r = wait t\n"
    let 样例 = 造样例(src)
    assert(len(样例.module.errors) == 0, "异步程序应降载成功")
    let 子 = 取函数(样例 = 样例, name = "子")
    assert(子 >= 0, "应有函数 子")
    assert(irTypeText(pool = 样例.module.types, id = 样例.module.functions[子].returnType) == "result<i32>", "异步体返回结算值")
    let 调用 = 取节点按类别(样例 = 样例, kind = irExprTag(.irCall))
    assert(调用 >= 0, "应有调用节点")
    assert(irTypeText(pool = 样例.module.types, id = irNodeAt(pool = 样例.module.nodes, id = 调用).typeId) == "future<i32>", "调用站点是任务句柄")
    let 等待 = 取节点按类别(样例 = 样例, kind = irExprTag(.irJoin))
    assert(等待 >= 0, "应有等待节点")
    let 节点 = irNodeAt(pool = 样例.module.nodes, id = 等待)
    assert(节点.op == 1, "wait 记 1")
    assert(irTypeText(pool = 样例.module.types, id = 节点.typeId) == "result<i32>", "等待站点是结算值")
    return

; 等待的上下文：await 只许异步体，越界即缺口而不是静默按阻塞处理。
等待越界|test() -> ():
    let src = "子|func() => (I32,):\n    return ok(7)\n\nf|func() -> (I32,):\n    let t = 子()\n    let r = await t\n    return 0\n"
    let 样例 = 造样例(src)
    assert(len(样例.module.errors) == 1, "同步体里的 await 应报缺口，实得 " + countText(len(样例.module.errors)))
    return

; 分离：detach 产一条剪枝语句，操作数是任务句柄。
分离降载|test() -> ():
    let src = "子|func() => (I32,):\n    return ok(7)\n\nf|func() -> ():\n    let t = 子()\n    detach t\n"
    let 样例 = 造样例(src)
    assert(len(样例.module.errors) == 0, "分离应降载成功")
    assert(取节点按类别(样例 = 样例, kind = irStmtTag(.irDetachStmt)) >= 0, "应有一条分离语句")
    return

; 默认实例：给定块降成名义类型，初始化函数随模块出，取用点补在省略的取用位。
取用点降载|test() -> ():
    let src = "[配置|given]\n    名称: String = \"默认\"\n\n取名|func(using 配: 配置,) -> (String,):\n    return 配.名称\n\nf|func() -> ():\n    print(取名())\n"
    let 样例 = 造样例(src)
    assert(len(样例.module.errors) == 0, "默认实例程序应降载成功")
    assert(取函数(样例 = 样例, name = "__given_make_配置") >= 0, "应出初始化函数")
    let 取用 = 取节点按类别(样例 = 样例, kind = irExprTag(.irGivenInstance))
    assert(取用 >= 0, "应补一个取用点")
    assert(irTypeText(pool = 样例.module.types, id = irNodeAt(pool = 样例.module.nodes, id = 取用).typeId) == "配置", "取用点类型是给定块")
    return

; 缺初值：给定块有字段没有初值即缺口，不按零值编造实例。
给定缺初值|test() -> ():
    let src = "[配置|given]\n    名称: String\n"
    let 样例 = 造样例(src)
    assert(len(样例.module.errors) == 1, "缺初值应报缺口，实得 " + countText(len(样例.module.errors)))
    return

; 显式实例：给了实参就不补取用点，物化交给调用点自己那份。
显式不插点|test() -> ():
    let src = "[配置|given]\n    名称: String = \"默认\"\n\n取名|func(using 配: 配置,) -> (String,):\n    return 配.名称\n\nf|func() -> ():\n    print(取名(配 = 配置()))\n"
    let 样例 = 造样例(src)
    assert(len(样例.module.errors) == 0, "显式实例应降载成功")
    assert(取节点按类别(样例 = 样例, kind = irExprTag(.irGivenInstance)) < 0, "显式实例不应补取用点")
    return

; 泛型实例：模板不进函数表，实例按类型实参取名，调用点文本指向实例。
泛型实例发射|test() -> ():
    let 样例 = 造样例("id|func<T>(value: T,) -> (T,):\n    return value\n\nuse|func() -> (I32,):\n    return id<I32>(value = 1)\n")
    assert(len(样例.module.errors) == 0, "泛型实例应降载成功")
    assert(取函数(样例 = 样例, name = "id__I32") >= 0, "I32 实例应进函数表")
    assert(取函数(样例 = 样例, name = "id") < 0, "模板不应进函数表")
    assert(取节点(样例 = 样例, kind = irExprTag(.irCall), text = "id__I32") >= 0, "调用点应指向实例符号")
    return

; 跨单元样例：两个单元各走同一装配链，用于钉跨单元的符号与编号。
造两单元样例|func(_源一: String, _源二: String,) -> (降载样例,):
    let 载一 = loadUnit(path = "packages/p/src/api/a.pini", text = _源一)
    let 载二 = loadUnit(path = "packages/p/src/api/b.pini", text = _源二)
    assert(!载一.failed, "首单元应可加载")
    assert(!载二.failed, "次单元应可加载")
    assert(len(载一.unit.diagnostics) == 0, "首单元应无语法诊断")
    assert(len(载二.unit.diagnostics) == 0, "次单元应无语法诊断")
    let units = [载一.unit, 载二.unit]
    let table = registerPackage(units)
    let types = resolvePackage(units = units, table = table)
    var world = makeMemberWorld(units = units, table = table, types = types)
    let 填 = fillExprTypes(world = world, units = units)
    let 泛 = instantiateGenerics(world = world, units = units, fill = 填)
    var 类型面 = world.types
    类型面.pool = 泛.pool
    world.types = 类型面
    var input = LowerWorld()
    input.world = world
    input.types = 泛.types
    input.generics = 泛
    let shapes = makeShapeTable(world)
    input.shapes = shapes
    input.layouts = layoutAll(shapes = shapes, pool = world.types.pool)
    var out = 降载样例()
    out.module = lowerWorkspace(input = input)
    return out

; 跨单元闭包编号：两个单元各自第一个闭包都取全局水位，函数名与 env 类型名不撞。
闭包编号跨单元唯一|test() -> ():
    let 样例 = 造两单元样例("主一|func() -> ():\n    let f = func (x: I32,) -> (I32,): return x + 1\n    print(f(1))\n", "主二|func() -> ():\n    let g = func (x: I32,) -> (I32,): return x + 2\n    print(g(1))\n")
    assert(len(样例.module.errors) == 0, "跨单元闭包应降载成功")
    let 首 = 取函数(样例 = 样例, name = "__closure_0")
    let 次 = 取函数(样例 = 样例, name = "__closure_1")
    assert(首 >= 0, "首单元闭包应取编号 0")
    assert(次 >= 0, "次单元闭包应取编号 1")
    assert(样例.module.functions[首].closureId == 0, "条目编号与名字同源")
    assert(样例.module.functions[次].closureId == 1, "条目编号与名字同源")
    assert(取节点(样例 = 样例, kind = irExprTag(.irClosureLiteral), text = "__closure_0") >= 0, "首个闭包字面量指向 0")
    assert(取节点(样例 = 样例, kind = irExprTag(.irClosureLiteral), text = "__closure_1") >= 0, "次个闭包字面量指向 1")
    return

; 弱引用：`weak 对象` 发 59、`.value` 发 60；结果类型分别是 weakRef 与 optional。
弱引用降载|test() -> ():
    let 样例 = 造样例("{节点}\n值: I32 = 0\n\nf|func() -> ():\n    let n = 节点()\n    let r = weak n\n    print(r.value)\n    return\n")
    assert(len(样例.module.errors) == 0, "弱引用应降载成功")
    let 造 = 取节点按类别(样例 = 样例, kind = irExprTag(.irWeakRefConstruct))
    assert(造 >= 0, "应发弱引用构造节点")
    let 造节点 = irNodeAt(pool = 样例.module.nodes, id = 造)
    assert(irTypeTag(irTypeAt(pool = 样例.module.types, id = 造节点.typeId).kind) == irTypeTag(.irTypeWeakRef), "构造结果应是 WeakRef")
    let 读 = 取节点按类别(样例 = 样例, kind = irExprTag(.irWeakRefValue))
    assert(读 >= 0, "应发弱引用取值节点")
    let 读节点 = irNodeAt(pool = 样例.module.nodes, id = 读)
    assert(irTypeTag(irTypeAt(pool = 样例.module.types, id = 读节点.typeId).kind) == irTypeTag(.irTypeOptional), "取值结果应是 Optional")
    return

; 无主引用：`unsafe UnownedRef(对象)` 发 61、成员访问前插的解引用发 62；结果类型分别是
; unownedRef 与元素的名义类型（不再是句柄）。
无主引用降载|test() -> ():
    let 样例 = 造样例("{节点}\n值: I32 = 0\n\n{{节点}}\n加|self(_量: I32,) -> (I32,):\n    return self.值 + _量\n\nf|func() -> ():\n    let n = 节点()\n    let u = unsafe UnownedRef(n)\n    print(unsafe u.值)\n    print(unsafe u.加(1))\n    return\n")
    assert(len(样例.module.errors) == 0, "无主引用应降载成功")
    let 造 = 取节点按类别(样例 = 样例, kind = irExprTag(.irUnownedRefConstruct))
    assert(造 >= 0, "应发无主引用构造节点")
    let 造节点 = irNodeAt(pool = 样例.module.nodes, id = 造)
    assert(irTypeTag(irTypeAt(pool = 样例.module.types, id = 造节点.typeId).kind) == irTypeTag(.irTypeUnownedRef), "构造结果应是 UnownedRef")
    let 解 = 取节点按类别(样例 = 样例, kind = irExprTag(.irUnownedRefValue))
    assert(解 >= 0, "成员访问前应插解引用节点")
    let 解节点 = irNodeAt(pool = 样例.module.nodes, id = 解)
    assert(irTypeTag(irTypeAt(pool = 样例.module.types, id = 解节点.typeId).kind) == irTypeTag(.irTypeNominal), "解引用结果应是名义类型")
    return

; 可选构造：`.some(值)` 与 `.none` 都发可选构造节点，标签 some 0 / none 1；
; 限定写法 `Optional.some` / `Optional.none` 与 nil 字面量同路。
可选构造降载|test() -> ():
    let 样例 = 造样例("f|func() -> ():\n    let 甲: ?I32 = .some(42)\n    let 乙: ?I32 = nil\n    let 丙: ?I32 = Optional.none\n    let 丁 = Optional.some(7)\n    print(甲)\n    return\n")
    assert(len(样例.module.errors) == 0, "可选构造应降载成功")
    assert(取节点按操作(样例 = 样例, kind = irExprTag(.irOptionalConstruct), op = 0) >= 0, "应发 some 标签 0 的构造")
    assert(取节点按操作(样例 = 样例, kind = irExprTag(.irOptionalConstruct), op = 1) >= 0, "应发 none 标签 1 的构造")
    let 一 = 取节点按操作(样例 = 样例, kind = irExprTag(.irOptionalConstruct), op = 0)
    let 一节点 = irNodeAt(pool = 样例.module.nodes, id = 一)
    assert(len(一节点.kids) == 1, "some 构造带一个载荷子节点")
    let 二 = 取节点按操作(样例 = 样例, kind = irExprTag(.irOptionalConstruct), op = 1)
    let 二节点 = irNodeAt(pool = 样例.module.nodes, id = 二)
    assert(len(二节点.kids) == 0, "none 构造不带子节点")
    return

; 限定用例：`枚举.用例` 与 `枚举.用例(载荷)` 都按声明序取标签，接收者不降成值。
限定用例降载|test() -> ():
    let 样例 = 造样例("[记号]\n加\n数(I32,)\n\nf|func() -> ():\n    let 甲: 记号 = 记号.加\n    let 乙: 记号 = 记号.数(3)\n    print(甲)\n    return\n")
    assert(len(样例.module.errors) == 0, "限定用例应降载成功")
    assert(取节点(样例 = 样例, kind = irExprTag(.irEnumConstruct), text = "加") >= 0, "应发用例 加 的构造")
    let 数 = 取节点(样例 = 样例, kind = irExprTag(.irEnumConstruct), text = "数")
    assert(数 >= 0, "应发用例 数 的构造")
    assert(irNodeAt(pool = 样例.module.nodes, id = 数).op == 1, "标签按声明序")
    return

; 泛型实例调用：标签实参按模板形参归位，符号取实例名，实参不留源序。
泛型实例带标签降载|test() -> ():
    let 样例 = 造样例("身份|func<T>(x: T,) -> (T,):\n    return x\n\nf|func() -> ():\n    print(身份<I32>(x = 100))\n    return\n")
    assert(len(样例.module.errors) == 0, "泛型实例调用应降载成功")
    let 调 = 取节点(样例 = 样例, kind = irExprTag(.irCall), text = "身份__I32")
    assert(调 >= 0, "调用符号应取实例名")
    assert(len(irNodeAt(pool = 样例.module.nodes, id = 调).kids) == 1, "实参按形参归位后只留一个")
    return

; 裸函数名作值：发函数值节点并连带一条转发适配器，符号取适配器名。
; 适配器记目标函数并按闭包协议收环境位，体由发射期拼。
函数值降载|test() -> ():
    let 样例 = 造样例("加倍|func(_n: I32,) -> (I32,):\n    return _n * 2\n\n应用|func(f: (I32,) -> (I32,), x: I32,) -> (I32,):\n    return f(x)\n\nf|func() -> ():\n    print(应用(f = 加倍, x = 5))\n    return\n")
    assert(len(样例.module.errors) == 0, "函数值应降载成功")
    let 值 = 取节点按类别(样例 = 样例, kind = irExprTag(.irFunctionValue))
    assert(值 >= 0, "应发函数值节点")
    let 符号 = textAt(module = 样例.module, id = irNodeAt(pool = 样例.module.nodes, id = 值).text)
    assert(符号 == "__adapter_加倍", "函数值应指向适配器，实得 " + 符号)
    let 适配 = 取函数(样例 = 样例, name = 符号)
    assert(适配 >= 0, "适配器应进函数表")
    assert(样例.module.functions[适配].adapterTarget == "加倍", "适配器应记目标函数")
    assert(样例.module.functions[适配].isClosure, "适配器按闭包协议收环境位")
    return

; 同一函数在多处作值只建一条适配器；重复条目会让同图两处定义撞名。
函数值适配器去重|test() -> ():
    let 样例 = 造样例("加倍|func(_n: I32,) -> (I32,):\n    return _n * 2\n\n应用|func(f: (I32,) -> (I32,), x: I32,) -> (I32,):\n    return f(x)\n\nf|func() -> ():\n    print(应用(f = 加倍, x = 1))\n    print(应用(f = 加倍, x = 2))\n    return\n")
    assert(len(样例.module.errors) == 0, "两次作值应降载成功")
    var 数 = 0
    var i = 0
    while i < len(样例.module.functions):
        if 样例.module.functions[i].adapterTarget == "加倍":
            数 = 数 + 1
        i = i + 1
    assert(数 == 1, "适配器应只建一条，实得 " + countText(数))
    return

; 实参位字面量的形参取期望类型：声明缺标注时按函数类型补分量，不落空类型。
上下文形参补型|test() -> ():
    let 样例 = 造样例("应用|func(f: (I32,) -> (I32,), x: I32,) -> (I32,):\n    return f(x)\n\nmain|func() -> ():\n    print(应用(f = func (n,) -> (I32,): return n + 1, x = 2))\n    return\n")
    assert(len(样例.module.errors) == 0, "实参位字面量应降载成功")
    let 闭包 = 取函数(样例 = 样例, name = "__closure_0")
    assert(闭包 >= 0, "应生成闭包条目")
    let 形参 = 样例.module.functions[闭包].params
    assert(len(形参) == 1, "闭包应有一个形参，实得 " + countText(len(形参)))
    assert(irTypeTag(irTypeAt(pool = 样例.module.types, id = 形参[0].typeId).kind) == irTypeTag(.irTypeI32), "形参应取期望的 I32")
    return

; 元组标签读：标签按类型条目的标签串定位，节点落成按序号的元组读。
元组标签读|test() -> ():
    let src = "取|func() -> (I32,):\n    let t = (a = 1, b = 2,)\n    return t.b\n"
    let 样例 = 造样例(src)
    let 读 = 取节点按类别(样例 = 样例, kind = irExprTag(.irTupleIndexGet))
    assert(读 >= 0, "标签读应落成元组读节点")
    assert(irNodeAt(pool = 样例.module.nodes, id = 读).op == 1, "标签 b 的序号应是 1")
    return
