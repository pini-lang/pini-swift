; 注册表：装配表加一行；同名重复登记按先到先得拒掉，返回原表。
; 注册只记记录，不记实现：发射由具体后端包按入口码分派。
{BackendRegistry}
entries: Array<BackendEntry> = []

; 空表：装配的起点。
emptyRegistry|func() -> (BackendRegistry,):
    return BackendRegistry()

; 登记：名字没出现过才追加；重复登记不改表，调用方按计数判断是否生效。
registerBackend|func(registry: BackendRegistry, entry: BackendEntry,) -> (BackendRegistry,):
    var out = registry
    if findBackend(registry = out, name = entry.name) >= 0:
        return out
    out.entries = out.entries.append(entry)
    return out

; 按名查：未登记答 -1，名字比较区分大小写。
findBackend|func(registry: BackendRegistry, name: String,) -> (I32,):
    var i = 0
    while i < len(registry.entries):
        if registry.entries[i].name == name:
            return i
        i = i + 1
    return -1

; 按下标取：越界答空记录，调用方先用计数判边界。
backendAt|func(registry: BackendRegistry, index: I32,) -> (BackendEntry,):
    if index < 0 || index >= len(registry.entries):
        return BackendEntry()
    return registry.entries[index]

; 条目数：下标合法区间是 0 到 count - 1。
registryCount|func(registry: BackendRegistry,) -> (I32,):
    return len(registry.entries)

; 名单：按登记序，用于回执与诊断；不走字典序。
registryNames|func(registry: BackendRegistry,) -> (Array<String>,):
    var out: Array<String> = []
    var i = 0
    while i < len(registry.entries):
        out = out.append(registry.entries[i].name)
        i = i + 1
    return out
