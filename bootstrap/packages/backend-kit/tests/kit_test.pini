[kit_test|import]
_ir = "../../ir"

; 后端记录判据：族表与契约同序、输出档次码可跨包、注册先到先得、字节口径只此一处。
; 目标描述只答标量与指针；聚合宽度由槽表乘，这里答 -1 才算守住了分工。

; 族表：十四项，次序与契约族表一致；未登记答 -1。
族表|test() -> ():
    assert(backendFamilyCount() == 14, "族数应为十四")
    assert(backendFamilyName(code = 0) == "controlFlow", "首族应为控制流")
    assert(backendFamilyName(code = 2) == "variablesAndOperators", "第三族应为变量与运算符")
    assert(backendFamilyName(code = 13) == "givenInstances", "末族应为给定实例")
    assert(backendFamilyOf(name = "strings") == 10, "字符串族码应为十")
    assert(backendFamilyOf(name = "没有这个族") < 0, "未登记族应答 -1")
    assert(len(backendFamilyCodes()) == 14, "全族码应为十四项")
    return

; 档次：三档码序固定，转储码可跨包取；码回档次后仍是同一档。
档次|test() -> ():
    assert(backendOutputCode(.backendOutputNative) == 1, "本机码应为 1")
    assert(backendOutputCode(.backendOutputBytecode) == 2, "字节码应为 2")
    assert(backendOutputCode(.backendOutputDump) == 3, "转储码应为 3")
    assert(backendOutputDumpCode() == 3, "转储码常量应为 3")
    assert(backendOutputName(backendOutputOf(code = 3)) == "dump", "码回档次应仍是转储")
    return

; 注册：同名重复登记被拒；族声明按码查，表里没有即假。
注册|test() -> ():
    var table = emptyRegistry()
    let dump = makeBackend(name = "dump", output = .backendOutputDump, families = backendFamilyCodes(), entry = 1)
    table = registerBackend(registry = table, entry = dump)
    table = registerBackend(registry = table, entry = dump)
    assert(registryCount(registry = table) == 1, "同名重复登记应被拒")
    assert(findBackend(registry = table, name = "dump") == 0, "应能按名查到")
    assert(findBackend(registry = table, name = "llvm") < 0, "未登记应答 -1")
    assert(supportsFamily(entry = dump, family = 10), "应声明字符串族")
    assert(!supportsFamily(entry = dump, family = 99), "未声明族应判假")
    assert(registryNames(registry = table)[0] == "dump", "名单按登记序")
    return

; 字节口径：i32 四字节、布尔一字节、字符串按指针宽、数组聚合答 -1 交给槽表。
字节口径|test() -> ():
    let target = defaultTarget()
    assert(target.pointerWidth == 8, "默认目标指针应八字节")
    var pool = IrTypePool()
    let intType = irScalarTypeOfCode(pool = pool, code = 1, name = "i32")
    pool = intType.pool
    assert(byteWidthOf(target = target, pool = pool, typeId = intType.id) == 4, "i32 应四字节")
    assert(alignOf(target = target, pool = pool, typeId = intType.id) == 4, "i32 应对齐四")
    let flagType = irScalarTypeOfCode(pool = pool, code = 7, name = "boolean")
    pool = flagType.pool
    assert(byteWidthOf(target = target, pool = pool, typeId = flagType.id) == 1, "布尔应一字节")
    let textType = irScalarTypeOfCode(pool = pool, code = 8, name = "string")
    pool = textType.pool
    assert(byteWidthOf(target = target, pool = pool, typeId = textType.id) == 8, "字符串应按指针宽")
    let listType = irWrapTypeOfCode(pool = pool, code = 12, name = "", inner = intType.id)
    pool = listType.pool
    assert(byteWidthOf(target = target, pool = pool, typeId = listType.id) < 0, "聚合宽度应留给槽表")
    assert(alignOf(target = target, pool = pool, typeId = listType.id) == 8, "聚合按槽对齐")
    assert(slotBytesOf(target = target, slots = 5) == 40, "五槽应四十字节")
    assert(byteWidthOf(target = target, pool = pool, typeId = 999) < 0, "越界下标应答 -1")
    return
