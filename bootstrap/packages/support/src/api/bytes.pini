; 字节切片：缓冲里的一段 [start, end)。与缓冲共享同一份数组存储，复制切片不复制字节。
(ByteSlice)
bytes: Array<U8> = []
start: I32 = 0
end: I32 = 0

((ByteSlice))
; 字节数；区间空时为零。
byteLength|self() -> (I32,):
    return self.end - self.start
; 按切片内下标读字节；越界落到数组下标的运行时陷阱。
byteAt|self(index: I32,) -> (U8,):
    return self.bytes[self.start + index]
; 子切片相对本切片取界，夹紧到 [0, 本长]；仍共享存储。
slice|self(start: I32, end: I32,) -> (ByteSlice,):
    var lo = start
    var hi = end
    let count = self.byteLength()
    if lo < 0:
        lo = 0
    if hi < 0:
        hi = 0
    if lo > count:
        lo = count
    if hi > count:
        hi = count
    if hi < lo:
        hi = lo
    var out = ByteSlice()
    out.bytes = self.bytes
    out.start = self.start + lo
    out.end = self.start + hi
    return out
; 逐字节相等；长度不同直接假。
equal|self(other: ByteSlice,) -> (Bool,):
    if self.byteLength() != other.byteLength():
        return false
    var i = 0
    while i < self.byteLength():
        if self.byteAt(i) != other.byteAt(i):
            return false
        i = i + 1
    return true

; 字节缓冲：一段 UTF-8 字节的所有权持有者；切片与它共享数组存储。
(ByteBuffer)
bytes: Array<U8> = []

; 从文本取字节：一次 UTF-8 复制，之后扫描不再按字素切分。
makeByteBuffer|func(text: String,) -> (ByteBuffer,):
    var out = ByteBuffer()
    out.bytes = tempUtf8Bytes(text)
    return out

((ByteBuffer))
byteLength|self() -> (I32,):
    return len(self.bytes)
byteAt|self(index: I32,) -> (U8,):
    return self.bytes[index]
; 切片共享存储：只记录区间，不复制字节；两界夹紧，空区间合法。
slice|self(start: I32, end: I32,) -> (ByteSlice,):
    var lo = start
    var hi = end
    let count = len(self.bytes)
    if lo < 0:
        lo = 0
    if hi < 0:
        hi = 0
    if lo > count:
        lo = count
    if hi > count:
        hi = count
    if hi < lo:
        hi = lo
    var out = ByteSlice()
    out.bytes = self.bytes
    out.start = lo
    out.end = hi
    return out
; 追加一个字节，返回新缓冲；原缓冲不动，写时分裂由数组承担。
append|self(value: U8,) -> (ByteBuffer,):
    var out = ByteBuffer()
    out.bytes = self.bytes.append(value)
    return out
; 追加一段切片，按字节逐个写入；返回值须替换原缓冲。
appendSlice|self(part: ByteSlice,) -> (ByteBuffer,):
    var out = self
    var i = 0
    while i < part.byteLength():
        out = out.append(part.byteAt(i))
        i = i + 1
    return out

; 字节构建器：按标量或 ASCII 追加，最后交出只读缓冲。
(ByteBuilder)
bytes: Array<U8> = []

((ByteBuilder))
byteLength|self() -> (I32,):
    return len(self.bytes)
appendByte|self(value: U8,) -> (ByteBuilder,):
    var out = ByteBuilder()
    out.bytes = self.bytes.append(value)
    return out
; 只接 ASCII：非 ASCII 走 appendScalar，避免把多标量字素压成一个字节。
appendAscii|self(text: String,) -> (ByteBuilder,):
    var out = self
    let pieces = chars(text)
    var i = 0
    while i < len(pieces):
        let code = ord(pieces[i])
        assert(code < 128, "appendAscii 只接受 ASCII")
        out = out.appendByte(tempIntToByte(code))
        i = i + 1
    return out
; 按 Unicode 标量写 UTF-8；负值、超出 U+10FFFF 与代理区直接拒绝。
appendScalar|self(code: I32,) -> (ByteBuilder,):
    assert(code >= 0, "码点不得为负")
    assert(code <= 1114111, "码点超出 U+10FFFF")
    assert(code < 55296 || code > 57343, "代理区不得编码")
    var out = self
    if code < 128:
        out = out.appendByte(tempIntToByte(code))
    else:
        if code < 2048:
            out = out.appendByte(tempIntToByte(192 + (code >> 6)))
            out = out.appendByte(tempIntToByte(128 + (code & 63)))
        else:
            if code < 65536:
                out = out.appendByte(tempIntToByte(224 + (code >> 12)))
                out = out.appendByte(tempIntToByte(128 + (code >> 6 & 63)))
                out = out.appendByte(tempIntToByte(128 + (code & 63)))
            else:
                out = out.appendByte(tempIntToByte(240 + (code >> 18)))
                out = out.appendByte(tempIntToByte(128 + (code >> 12 & 63)))
                out = out.appendByte(tempIntToByte(128 + (code >> 6 & 63)))
                out = out.appendByte(tempIntToByte(128 + (code & 63)))
    return out
; 交出缓冲；与构建器共享存储，后续追加仍会分裂。
takeBuffer|self() -> (ByteBuffer,):
    var out = ByteBuffer()
    out.bytes = self.bytes
    return out
