; JSON 读取器：结构、转义、代理对与畸形输入四组判据。
; 解析失败的判据落在「ok 为零且 offset 指向出错字节」，值树此时不作数。
对象与数组|test() -> ():
    let doc = parseJson("{\"名\": \"甲\", \"数\": 42, \"块\": [true, false, null]}")
    assert(doc.ok, "合法对象应解析成功")
    assert(jsonKindTagOf(doc, 0) == 5, "根是对象")
    assert(jsonMemberCount(doc, 0) == 3, "三个成员")
    let name = jsonMemberValueOf(doc, 0, "名")
    assert(name >= 0, "成员名应命中")
    assert(jsonTextOf(doc, name) == "甲", "字符串值按原文解出")
    let number = jsonMemberValueOf(doc, 0, "数")
    assert(jsonNumberTextOf(doc, number) == "42", "数字保留原文")
    let block = jsonMemberValueOf(doc, 0, "块")
    assert(jsonKindTagOf(doc, block) == 4, "数组种类")
    assert(jsonChildCount(doc, block) == 3, "三个元素")
    assert(jsonBoolOf(doc, jsonChildAt(doc, block, 0)), "首元素 true")
    assert(!jsonBoolOf(doc, jsonChildAt(doc, block, 1)), "次元素 false")
    assert(jsonKindTagOf(doc, jsonChildAt(doc, block, 2)) == 0, "末元素 null")
    assert(jsonMemberValueOf(doc, 0, "缺") == -1, "缺席成员答 -1")
    return

; 转义：换行、制表、反斜杠、斜杠与四位码点各一条。
字符串转义|test() -> ():
    let doc = parseJson("{\"s\":\"a\\nb\\tc\\\\d\\/e\\u4e2d\"}")
    assert(doc.ok, "带转义的串应解析成功")
    let at = jsonMemberValueOf(doc, 0, "s")
    assert(jsonTextOf(doc, at) == "a\nb\tc\\d/e中", "五类转义逐一对上")
    return

; 代理对：两段 \\u 合成一个增补平面码点。
代理对|test() -> ():
    let doc = parseJson("{\"e\":\"\\uD83D\\uDE00\"}")
    assert(doc.ok, "成对代理应解析成功")
    let at = jsonMemberValueOf(doc, 0, "e")
    let text = jsonTextOf(doc, at)
    assert(len(text) == 1, "合成一个字符")
    assert(ord(text[0]) == 128512, "码点为 U+1F600")
    return

嵌套与空容器|test() -> ():
    let doc = parseJson("{\"a\":{\"b\":[]},\"c\":{}}")
    assert(doc.ok, "空容器合法")
    let a = jsonMemberValueOf(doc, 0, "a")
    let b = jsonMemberValueOf(doc, a, "b")
    assert(jsonKindTagOf(doc, b) == 4 && jsonChildCount(doc, b) == 0, "空数组")
    let c = jsonMemberValueOf(doc, 0, "c")
    assert(jsonKindTagOf(doc, c) == 5 && jsonMemberCount(doc, c) == 0, "空对象")
    return

; 畸形输入：三种各自给出失败位，且 offset 落在可指认的字节上。
畸形输入|test() -> ():
    let closed = parseJson("{\"a\":}")
    assert(!closed.ok, "缺值应失败")
    assert(closed.offset == 5, "失败位指向右花括号")
    let unterminated = parseJson("\"abc")
    assert(!unterminated.ok, "未闭合字符串应失败")
    let trailing = parseJson("{} []")
    assert(!trailing.ok, "尾随内容应失败")
    let badEscape = parseJson("\"a\\qb\"")
    assert(!badEscape.ok, "不认识的转义应失败")
    return
