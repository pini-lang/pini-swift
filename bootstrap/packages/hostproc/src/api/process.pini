; 进程与工具链：编译命令调外部工具的唯一点，符号面按运行时 ABI 契约的进程族。
; 外部块只登记「起、等、收、还」，抓取模式与直通模式由 mode 位分，不在符号面分两套。
[process|foreign]
pini_process_release: (*U8,) -> ()
pini_process_spawn: (String, I32,) -> (*U8,)
pini_process_stderr: (*U8,) -> (*U8,)
pini_process_stdout: (*U8,) -> (*U8,)
pini_process_wait: (*U8,) -> (I32,)

; 进程结局：退出码与两路输出。句柄在 runProcess 内归还，这里的串是从句柄视图复制出来的副本。
(ProcessOutcome)
code: I32 = -1
stdoutText: String = ""
stderrText: String = ""

; 起子进程并等它结束。keepOutput 为零时子进程直通调用方的 stdout / stderr，输出不进结局。
; 句柄在返回前一律归还：调用方只关心结局，留着手柄只会漏。
runProcess|func(argv: Array<String>, keepOutput: Bool,) -> (ProcessOutcome,):
    var done = ProcessOutcome()
    var 模式 = 0
    if keepOutput:
        模式 = 1
    var 文本 = ""
    var i = 0
    while i < len(argv):
        if i > 0:
            文本 = 文本 + "\n"
        文本 = 文本 + argv[i]
        i = i + 1
    let handle = unsafe pini_process_spawn(文本, 模式)
    done.code = unsafe pini_process_wait(handle)
    if keepOutput:
        done.stdoutText = fromCString(unsafe pini_process_stdout(handle))
        done.stderrText = fromCString(unsafe pini_process_stderr(handle))
    unsafe pini_process_release(handle)
    return done

; 末个分隔符位置：找不到答 -1。字符串面没有 lastIndexOf，反向扫一次。
processLastSlash|func(text: String,) -> (I32,):
    var i = len(text) - 1
    while i >= 0:
        if ord(text[i]) == 47:
            return i
        i = i - 1
    return -1

; 剥尾换行：子进程的整行输出带 `\n`，取路径前要去掉；其余字节原样保留。
stripTrailingNewline|func(text: String,) -> (String,):
    var out = text
    while len(out) > 0:
        if ord(out[len(out) - 1]) == 10:
            out = out.slice(0, len(out) - 1)
        else:
            return out
    return out

; 工具路径：环境变量 PINI_LLVM_BIN 优先，其次三个常见前缀，都没有则答裸名交 PATH 解析。
; 只探存在不探可执行 —— 不可执行时起进程会报错，而那时的报错比这里猜更准确。
toolPath|func(tool: String,) -> (String,):
    let probe = runProcess(argv = ["/usr/bin/printenv", "PINI_LLVM_BIN"], keepOutput = true)
    let bin = stripTrailingNewline(text = probe.stdoutText)
    if len(bin) > 0:
        let joined = bin + "/" + tool
        if exists(joined):
            return joined
    var 前缀: Array<String> = ["/usr/bin/", "/opt/homebrew/opt/llvm/bin/", "/usr/local/opt/llvm/bin/"]
    var i = 0
    while i < len(前缀):
        let one = 前缀[i] + tool
        if exists(one):
            return one
        i = i + 1
    return tool

; 运行时库：环境变量优先，其次沿程序基准上溯找构建目录。两处都没有答空串，调用方据此省掉链接参数。
; 上溯六层是因为产物可能落在工作区根、包目录或示例目录下，层级不固定。
runtimeLibrary|func() -> (String,):
    let probe = runProcess(argv = ["/usr/bin/printenv", "PINI_RUNTIME_LIB"], keepOutput = true)
    let fromEnv = stripTrailingNewline(text = probe.stdoutText)
    if len(fromEnv) > 0:
        return fromEnv
    var dir = moduleRoot()
    var up = 0
    while up < 6:
        let dylib = dir + "/.build/release/libPiniRuntime.dylib"
        if exists(dylib):
            return dylib
        let so = dir + "/.build/release/libPiniRuntime.so"
        if exists(so):
            return so
        let cut = processLastSlash(text = dir)
        if cut <= 0:
            return ""
        dir = dir.slice(0, cut)
        up = up + 1
    return ""

; 临时路径：没有随机源，靠「存在即换号」避让既有文件；号段用完退到固定名，由写入方覆盖。
tempPath|func(tag: String, suffix: String,) -> (String,):
    var n = 0
    while n < 10000:
        let cand = "/tmp/pini_" + tag + "_" + "\(n)" + suffix
        if !exists(cand):
            return cand
        n = n + 1
    return "/tmp/pini_" + tag + suffix

; 删文件：没有删除原语，用 rm -f 代劳。失败不报 —— 临时文件残留不该盖住编译结论。
removeFile|func(path: String,) -> ():
    runProcess(argv = ["/bin/rm", "-f", path], keepOutput = false)
    return
