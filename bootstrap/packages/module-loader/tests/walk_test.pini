; 条目分类：点前缀跳过、`_` 前缀照常、只认 .pini 后缀。
条目分类|test() -> ():
    assert(isEntryKind(kind = classifyEntry(name = ".git", isDirectory = true), expected = entrySkip), "点前缀目录跳过")
    assert(isEntryKind(kind = classifyEntry(name = ".hidden.pini", isDirectory = false), expected = entrySkip), "点前缀文件跳过")
    assert(isEntryKind(kind = classifyEntry(name = "_internal", isDirectory = true), expected = entryDirectory), "下划线目录不跳过")
    assert(isEntryKind(kind = classifyEntry(name = "api", isDirectory = true), expected = entryDirectory), "普通目录")
    assert(isEntryKind(kind = classifyEntry(name = "lexer.pini", isDirectory = false), expected = entrySource), "源文件")
    assert(isEntryKind(kind = classifyEntry(name = "pini.toml", isDirectory = false), expected = entrySkip), "清单不是源文件")
    assert(isEntryKind(kind = classifyEntry(name = "a.pini.bak", isDirectory = false), expected = entrySkip), "中间含后缀不算")
    assert(isEntryKind(kind = classifyEntry(name = "pini", isDirectory = false), expected = entrySkip), "长度不足不算")
    return

; 排除项：等于声明项或以「声明项 + 斜杠」开头即为排除。
排除项判定|test() -> ():
    let items: Array<String> = ["tests/fixtures", "src/gen.pini"]
    assert(isExcluded(packagePath = "tests/fixtures", excludes = items), "整项相等")
    assert(isExcluded(packagePath = "tests/fixtures/a.pini", excludes = items), "项下文件")
    assert(isExcluded(packagePath = "src/gen.pini", excludes = items), "单文件项")
    assert(!isExcluded(packagePath = "tests/fixtures2/a.pini", excludes = items), "前缀相近但不是同一项")
    assert(!isExcluded(packagePath = "src/a.pini", excludes = items), "无关路径")
    assert(!isExcluded(packagePath = "src/a.pini", excludes = []), "无排除项")
    return

; 排序：字节序，短前缀在先；斜杠大于点，故 `a.pini` 在 `a/b` 之前。
路径排序|test() -> ():
    let sorted = sortPaths(["b.pini", "a/b.pini", "a.pini", "api/b.pini"])
    assert(sorted[0] == "a.pini", "点小于斜杠")
    assert(sorted[1] == "a/b.pini", "短前缀")
    assert(sorted[2] == "api/b.pini", "同前缀按后续字节")
    assert(sorted[3] == "b.pini", "末位")
    return

; 排序稳定：同一批以不同顺序给出，结果逐字相同。
排序与输入顺序无关|test() -> ():
    let first = sortPaths(["x/2.pini", "x/1.pini", "y.pini"])
    let second = sortPaths(["y.pini", "x/1.pini", "x/2.pini"])
    assert(len(first) == 3, "条目数不变")
    var i = 0
    while i < len(first):
        assert(first[i] == second[i], "同批不同入序应得同序")
        i = i + 1
    return
