; 测试助手：把 I32 字面量列表转成字节数组，便于手写非法序列。
sourceBytesOf|func(_values: Array<I32>,) -> (Array<U8>,):
    var out: Array<U8> = []
    var i = 0
    while i < len(_values):
        out = out.append(tempIntToByte(_values[i]))
        i = i + 1
    return out

; 源文本检查：BOM、NUL、非法 UTF-8 各有专用类别，偏移指向首个问题字节。
类别专用|test() -> ():
    let bom = checkSourceBytes(sourceBytesOf([239, 187, 191, 65]))
    assert(!bom.passed, "BOM 应被拒绝")
    assert(isLoadErrorKind(kind = bom.kind, expected = .errorSourceBom), "BOM 应报专用类别")
    assert(bom.offset == 0, "BOM 偏移应在起点")
    let nul = checkSourceBytes(sourceBytesOf([65, 0, 66]))
    assert(!nul.passed, "NUL 应被拒绝")
    assert(isLoadErrorKind(kind = nul.kind, expected = .errorSourceNul), "NUL 应报专用类别")
    assert(nul.offset == 1, "NUL 偏移应指向该字节")
    let broken = checkSourceBytes(sourceBytesOf([65, 255, 66]))
    assert(!broken.passed, "非法 UTF-8 应被拒绝")
    assert(isLoadErrorKind(kind = broken.kind, expected = .errorSourceNotUtf8), "非法 UTF-8 应报专用类别")
    assert(broken.offset == 1, "偏移应指向坏字节")
    return

; 干净字节通过：ASCII 与多字节序列都不触发任何一类。
合法字节通过|test() -> ():
    let ascii = checkSourceBytes(sourceBytesOf([109, 97, 105, 110]))
    assert(ascii.passed, "ASCII 应通过")
    let chinese = checkSourceBytes(tempUtf8Bytes("标识符"))
    assert(chinese.passed, "合法多字节应通过")
    let empty = checkSourceBytes(sourceBytesOf([]))
    assert(empty.passed, "空源应通过")
    return

; 中途出现的 EF BB BF 不是 BOM：只认起点。
中途序列不算BOM|test() -> ():
    let inside = checkSourceBytes(sourceBytesOf([65, 239, 187, 191]))
    assert(inside.passed, "非起始的 BOM 序列不拒绝")
    return

; 换行归一：CRLF 折成 LF，孤立 CR 原样保留。
换行归一|test() -> ():
    assert(normalizeNewlines("a\r\nb\r\nc") == "a\nb\nc", "CRLF 应折成 LF")
    assert(normalizeNewlines("a\rb") == "a\rb", "孤立 CR 不是换行")
    assert(normalizeNewlines("a\nb") == "a\nb", "LF 原样")
    assert(normalizeNewlines("") == "", "空串原样")
    return

; 单元构造：干净源产出树，坏源不解析且带错误。
单元构造|test() -> ():
    let good = loadUnit(path = "a.pini", text = "main|func() -> ():\n    return\n")
    assert(!good.failed, "干净源应成单元，实际 " + loadErrorName(good.error.kind))
    assert(good.unit.ast.itemCount() > 0, "应产出顶层声明")
    assert(len(good.unit.text) > 0, "单元应携带源文本")
    let bad = loadUnit(path = "b.pini", text = "main|func() -> ():\n    return" + chr(0) + "\n")
    assert(bad.failed, "含 NUL 的源不成单元")
    assert(isLoadErrorKind(kind = bad.error.kind, expected = .errorSourceNul), "应报 NUL 类别")
    assert(bad.error.path == "b.pini", "错误应带单元路径")
    return
