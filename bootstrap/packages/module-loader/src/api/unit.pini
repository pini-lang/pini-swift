[unit|import]
_syntax = "../../../syntax"
_diagnostics = "../../../diagnostics"

; 编译单元：归一后的源文本、工作区相对路径、语法树与语法诊断、词法问题分列。
; 字节视图在装载时填一次：语义各层按单元取用，不再各自转换整份文本。
(CompilationUnit)
path: String = ""
text: String = ""
bytes: Array<U8> = []
segments: Array<Segment> = []
ast: Ast = Ast()
diagnostics: Array<Diagnostic> = []
issues: Array<LexIssue> = []

; 字节视图：装载时已填则直接取；测试等手工构造的单元现转一次，与旧口径一致。
unitBytes|func(_unit: CompilationUnit,) -> (Array<U8>,):
    if len(_unit.bytes) > 0:
        return _unit.bytes
    return tempUtf8Bytes(_unit.text)

; 单元装载结果：失败时 unit 无效，成功时 error 无效；调用方只看 failed 分流。
(UnitLoad)
unit: CompilationUnit = CompilationUnit()
error: LoadError = LoadError()
failed: Bool = false

; 装载结果：按路径升序的单元与装载期错误；错误非空时单元集不完整。
(LoadResult)
units: Array<CompilationUnit> = []
errors: Array<LoadError> = []

((LoadResult))
; 可用：没有任何装载期错误。
isOK|self() -> (Bool,):
    return len(self.errors) == 0
unitCount|self() -> (I32,):
    return len(self.units)
errorCount|self() -> (I32,):
    return len(self.errors)
unitAt|self(_index: I32,) -> (CompilationUnit,):
    return self.units[_index]
errorAt|self(_index: I32,) -> (LoadError,):
    return self.errors[_index]
; 诊断总数：语法诊断与词法问题合并计数，「零诊断」判据读它。
diagnosticCount|self() -> (I32,):
    var total = 0
    var i = 0
    while i < len(self.units):
        total = total + len(self.units[i].diagnostics) + len(self.units[i].issues)
        i = i + 1
    return total

; 从文本建单元：文本检查、换行归一、解析、展开四步；检查不过不解析，错误带偏移。
; 展开的诊断并入单元诊断：码与位置同宿主，行列由渲染期按标量计。
loadUnit|func(path: String, text: String,) -> (UnitLoad,):
    var out = UnitLoad()
    let check = checkSourceText(text)
    if !check.passed:
        out.failed = true
        out.error = makeSourceError(kind = check.kind, path = path, offset = check.offset)
        return out
    let normalized = normalizeNewlines(text)
    let bytes = tempUtf8Bytes(normalized)
    let parsed = parseFile(text = normalized, file = path)
    let expanded = expandUnrolls(ast = parsed.ast, bytes = bytes)
    var unit = CompilationUnit()
    unit.path = path
    unit.text = normalized
    unit.bytes = bytes
    unit.segments = parsed.segments
    unit.ast = expanded.ast
    unit.diagnostics = parsed.diagnostics
    unit.issues = parsed.issues
    var e = 0
    while e < len(expanded.errors):
        var one = Diagnostic()
        one.file = path
        one.category = semanticCategory()
        one.severity = errorSeverity()
        one.code = expanded.errors[e].code
        one.message = expanded.errors[e].message
        var label = Label()
        label.start = expanded.errors[e].start
        label.end = expanded.errors[e].end
        label.primary = true
        var labels: Array<Label> = []
        labels = labels.append(label)
        one.labels = labels
        unit.diagnostics = unit.diagnostics.append(one)
        e = e + 1
    out.unit = unit
    return out
