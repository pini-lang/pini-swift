[load|import]
package = "../../../package"

; 待读单元：绝对路径用于读取，工作区相对路径用于排序与诊断。
(PendingUnit)
absPath: String = ""
unitPath: String = ""

; 源集：一个 target 收集到的待读单元与收集期错误；单元已按路径升序。
(SourceSet)
files: Array<PendingUnit> = []
errors: Array<LoadError> = []

((SourceSet))
; 可用：收集期没有任何错误。
isOK|self() -> (Bool,):
    return len(self.errors) == 0
errorCount|self() -> (I32,):
    return len(self.errors)
fileCount|self() -> (I32,):
    return len(self.files)
fileAt|self(_index: I32,) -> (PendingUnit,):
    return self.files[_index]
paths|self() -> (Array<String>,):
    var out: Array<String> = []
    var i = 0
    while i < len(self.files):
        out = out.append(self.files[i].unitPath)
        i = i + 1
    return out

; 按路径插入：保持升序；同路径已在集内时原样返回，同一文件不因多个 target 收两遍。
insertPending|func(items: Array<PendingUnit>, value: PendingUnit,) -> (Array<PendingUnit>,):
    var out: Array<PendingUnit> = []
    var placed = false
    var i = 0
    while i < len(items):
        if !placed:
            let order = comparePaths(first = value.unitPath, second = items[i].unitPath)
            if order == 0:
                return items
            if order < 0:
                out = out.append(value)
                placed = true
        out = out.append(items[i])
        i = i + 1
    if !placed:
        out = out.append(value)
    return out

; 按路径插入单元：保持升序；同路径已在集内时原样返回，生成模块与源码同处一条序列。
insertGeneratedUnit|func(items: Array<CompilationUnit>, value: CompilationUnit,) -> (Array<CompilationUnit>,):
    var out: Array<CompilationUnit> = []
    var placed = false
    var i = 0
    while i < len(items):
        if !placed:
            let order = comparePaths(first = value.path, second = items[i].path)
            if order == 0:
                return items
            if order < 0:
                out = out.append(value)
                placed = true
        out = out.append(items[i])
        i = i + 1
    if !placed:
        out = out.append(value)
    return out

; 目标源码根：测试目标由公共生产源码与入口目录组成，其余只取计划给的源码根。
targetRoots|func(_target: TargetPlan,) -> (Array<String>,):
    var out: Array<String> = []
    if package.isTestTarget(_target):
        out = out.append("src")
        if _target.sourceRoot != "src":
            out = out.append(_target.sourceRoot)
        return out
    out = out.append(_target.sourceRoot)
    return out

; 收集源码集：按源码根扫描、去重排序；只碰文件系统，不解析。
collectTarget|func(packageAbs: String, packageRel: String, target: TargetPlan, excludes: Array<String>,) -> (SourceSet,):
    var out = SourceSet()
    let roots = targetRoots(target)
    var i = 0
    while i < len(roots):
        let rootRel = roots[i]
        let rootAbs = packageAbs + "/" + rootRel
        if !isDir(rootAbs):
            out.errors = out.errors.append(makeLoadError(kind = .errorRootMissing, path = joinRel(parent = packageRel, child = rootRel), detail = ""))
        else:
            let state = scan(absDir = rootAbs, rootRel = rootRel, relDir = "", excludes = excludes, state = ScanState())
            var e = 0
            while e < len(state.errors):
                out.errors = out.errors.append(state.errors[e])
                e = e + 1
            var j = 0
            while j < len(state.files):
                var item = PendingUnit()
                item.absPath = rootAbs + "/" + state.files[j]
                item.unitPath = joinRel(parent = packageRel, child = joinRel(parent = rootRel, child = state.files[j]))
                out.files = insertPending(items = out.files, value = item)
                j = j + 1
        i = i + 1
    return out

; 读单个源文件：不存在与读不出分开判，读出的文本交给单元构造。
loadUnitFile|func(absPath: String, unitPath: String,) -> (UnitLoad,):
    var out = UnitLoad()
    if !exists(absPath):
        out.failed = true
        out.error = makeLoadError(kind = .errorFileMissing, path = unitPath, detail = "")
        return out
    let read = tryReadFile(absPath)
    match read:
        case ok(text,):
            return loadUnit(path = unitPath, text = text)
        case err(reason,):
            out.failed = true
            out.error = makeLoadError(kind = .errorFileUnreadable, path = unitPath, detail = "读取内建拒绝该文件")
            return out

; 装载单个 target：先收集再逐个建单元；单个文件失败不中断其余。
loadTarget|func(packageAbs: String, packageRel: String, target: TargetPlan, excludes: Array<String>,) -> (LoadResult,):
    var out = LoadResult()
    let set = collectTarget(packageAbs = packageAbs, packageRel = packageRel, target = target, excludes = excludes)
    out.errors = set.errors
    var i = 0
    while i < len(set.files):
        let loaded = loadUnitFile(absPath = set.files[i].absPath, unitPath = set.files[i].unitPath)
        if loaded.failed:
            out.errors = out.errors.append(loaded.error)
        else:
            out.units = out.units.append(loaded.unit)
        i = i + 1
    return out

; 收集一个包的全部 target：文件按路径升序合并，重复路径只留一份。
collectPackage|func(packageAbs: String, plan: PackagePlan,) -> (SourceSet,):
    var out = SourceSet()
    var i = 0
    while i < len(plan.targets):
        let set = collectTarget(packageAbs = packageAbs, packageRel = plan.rootPath, target = plan.targets[i], excludes = plan.excludes)
        var e = 0
        while e < len(set.errors):
            out.errors = out.errors.append(set.errors[e])
            e = e + 1
        var j = 0
        while j < len(set.files):
            out.files = insertPending(items = out.files, value = set.files[j])
            j = j + 1
        i = i + 1
    return out

; 装载一个包：先按全部 target 收集去重，再逐个解析；同一文件不因多 target 解析两遍。
loadPackage|func(packageAbs: String, plan: PackagePlan,) -> (LoadResult,):
    var out = LoadResult()
    let set = collectPackage(packageAbs = packageAbs, plan = plan)
    out.errors = set.errors
    var i = 0
    while i < len(set.files):
        let loaded = loadUnitFile(absPath = set.files[i].absPath, unitPath = set.files[i].unitPath)
        if loaded.failed:
            out.errors = out.errors.append(loaded.error)
        else:
            out.units = out.units.append(loaded.unit)
        i = i + 1
    return out

; 收集整个工作区：按计划的拓扑序逐包收集，不解析；装载规则的全量判据读这里。
collectWorkspace|func(_plan: BuildPlan,) -> (SourceSet,):
    var out = SourceSet()
    if !_plan.isOK():
        return out
    var i = 0
    while i < len(_plan.packages):
        let set = collectPackage(packageAbs = _plan.rootPath + "/" + _plan.packages[i].rootPath, plan = _plan.packages[i])
        var e = 0
        while e < len(set.errors):
            out.errors = out.errors.append(set.errors[e])
            e = e + 1
        var j = 0
        while j < len(set.files):
            out.files = insertPending(items = out.files, value = set.files[j])
            j = j + 1
        i = i + 1
    return out

; 装载整个工作区：按计划的拓扑序逐包装载。
loadWorkspace|func(_plan: BuildPlan,) -> (LoadResult,):
    var out = LoadResult()
    if !_plan.isOK():
        return out
    var i = 0
    while i < len(_plan.packages):
        let loaded = loadPackage(packageAbs = _plan.rootPath + "/" + _plan.packages[i].rootPath, plan = _plan.packages[i])
        var u = 0
        while u < len(loaded.units):
            out.units = out.units.append(loaded.units[u])
            u = u + 1
        var e = 0
        while e < len(loaded.errors):
            out.errors = out.errors.append(loaded.errors[e])
            e = e + 1
        i = i + 1
    return out

; 路径字节序比较：装载层与注册层共用一份次序定义，避免两处各写一套。
compareSourcePaths|func(first: String, second: String,) -> (I32,):
    return comparePaths(first = first, second = second)

; 包单元：包名、包根、声明依赖、测试根与它装载出的单元；包边界由此确定，不靠路径前缀猜。
(PackageUnits)
name: String = ""
rootPath: String = ""
requires: Array<String> = []
testRoots: Array<String> = []
units: Array<CompilationUnit> = []

; 工作区单元：按计划拓扑序分组，装载错误单列；判据读这里，不再回头猜路径。
(WorkspaceUnits)
packages: Array<PackageUnits> = []
errors: Array<LoadError> = []

; 装载整个工作区并保留包分组：单元归属与声明依赖随分组一起交出去。
; 计划文件读一次，逐包按脚本步骤并入生成模块；未声明构建面的包不受影响。
; 装载完成后按选项装配标准库：整个工作区只装一份，装不上记一条装载错误。
loadWorkspaceGrouped|func(_plan: BuildPlan, stdlib: StdlibOption,) -> (WorkspaceUnits,):
    var out = WorkspaceUnits()
    if !_plan.isOK():
        return out
    let planRead: PlanRead = package.readPlanFile(root = _plan.rootPath, profile = _plan.profile)
    var i = 0
    while i < len(_plan.packages):
        let planned: PackagePlan = _plan.packages[i]
        let loaded = loadPackage(packageAbs = _plan.rootPath + "/" + planned.rootPath, plan = planned)
        var group = PackageUnits()
        group.name = planned.name
        group.rootPath = planned.rootPath
        group.requires = planned.requires
        var t = 0
        while t < len(planned.targets):
            if package.isTestTarget(planned.targets[t]):
                group.testRoots = group.testRoots.append(planned.targets[t].sourceRoot)
            t = t + 1
        group.units = loaded.units
        var e = 0
        while e < len(loaded.errors):
            out.errors = out.errors.append(loaded.errors[e])
            e = e + 1
        let declared: GeneratedPackage = declaredPackage(planned)
        let attached = attachGenerated(root = _plan.rootPath, profile = _plan.profile, plan = planRead, pkg = declared)
        e = 0
        while e < len(attached.errors):
            out.errors = out.errors.append(attached.errors[e])
            e = e + 1
        var a = 0
        while a < len(attached.units):
            group.units = insertGeneratedUnit(items = group.units, value = attached.units[a])
            a = a + 1
        out.packages = out.packages.append(group)
        i = i + 1
    if stdlib.enabled:
        let sourcePath = stdlibSourcePath(option = stdlib, workspaceRoot = _plan.rootPath)
        out = assembleStdlib(ws = out, sourcePath = sourcePath)
    return out

((WorkspaceUnits))
; 包数：下标合法区间是 0 到 count() - 1。
count|self() -> (I32,):
    return len(self.packages)
; 包读：下标越界是运行时陷阱，调用方先经 packageOf 定位。
packageAt|self(_index: I32,) -> (PackageUnits,):
    return self.packages[_index]
; 单元归属：先按装载分组的单元路径精确命中，未命中再按路径分段前缀；都未命中答空串。
; 生成模块落在 `.build` 下，路径前缀不属于任何包，只能靠分组归属。
packageOf|self(_unitPath: String,) -> (String,):
    var i = 0
    while i < len(self.packages):
        var u = 0
        while u < len(self.packages[i].units):
            if self.packages[i].units[u].path == _unitPath:
                return self.packages[i].name
            u = u + 1
        i = i + 1
    let parts = _unitPath.split("/")
    i = 0
    while i < len(self.packages):
        if partsStartWith(parts = parts, prefix = self.packages[i].rootPath.split("/")):
            return self.packages[i].name
        i = i + 1
    return ""
; 根路径归属：导入路径归一后按包根精确匹配，未命中答空串。
nameAtRoot|self(_rootPath: String,) -> (String,):
    var i = 0
    while i < len(self.packages):
        if self.packages[i].rootPath == _rootPath:
            return self.packages[i].name
        i = i + 1
    return ""

; 分段前缀：逐段比，前缀比目标长即为假。
partsStartWith|func(parts: Array<String>, prefix: Array<String>,) -> (Bool,):
    if len(prefix) > len(parts):
        return false
    var i = 0
    while i < len(prefix):
        if parts[i] != prefix[i]:
            return false
        i = i + 1
    return true
