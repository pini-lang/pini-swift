; 条目分类：点前缀整棵跳过；目录照名字交出；其余只认 .pini 后缀。
[EntryKind]
entrySkip
entryDirectory
entrySource

; 分类名：枚举相等比较不可用，按名称比。
entryKindName|func(kind: EntryKind,) -> (String,):
    match kind:
        case entrySkip:
            return "skip"
        case entryDirectory:
            return "directory"
        case entrySource:
            return "source"
    return "skip"

; 同一类别判定：装载规则只认名字，不依赖枚举值的内部次序。
isEntryKind|func(kind: EntryKind, expected: EntryKind,) -> (Bool,):
    return entryKindName(kind) == entryKindName(expected)

; 条目分类：点前缀目录与点前缀文件一律跳过，`_` 前缀不在跳过之列。
classifyEntry|func(name: String, isDirectory: Bool,) -> (EntryKind,):
    if len(name) == 0:
        return entrySkip
    if name.indexOf(".") == 0:
        return entrySkip
    if isDirectory:
        return entryDirectory
    if isPiniSource(name):
        return entrySource
    return entrySkip

; 源文件后缀：只认 .pini 结尾；长度不足或后缀不符都答否。
isPiniSource|func(name: String,) -> (Bool,):
    let count = len(name)
    if count < 5:
        return false
    return name.substring(count - 5, count) == ".pini"

; 排除项判定：等于声明项，或以「声明项 + 斜杠」开头；声明项相对包根。
isExcluded|func(packagePath: String, excludes: Array<String>,) -> (Bool,):
    var i = 0
    while i < len(excludes):
        let item = excludes[i]
        if packagePath == item:
            return true
        if packagePath.indexOf(item + "/") == 0:
            return true
        i = i + 1
    return false

; 嵌套清单：子目录自带 pini.toml 即属另一个包，父包不收它的源码。
hasNestedManifest|func(absDir: String,) -> (Bool,):
    return exists(absDir + "/pini.toml")

; 扫描累积：收集到的相对路径与目录枚举中的错误。
(ScanState)
files: Array<String> = []
errors: Array<LoadError> = []

; 递归扫描：先分类再决定是否下降；条目名升序与深度优先共同决定结果次序。
scan|func(absDir: String, rootRel: String, relDir: String, excludes: Array<String>, state: ScanState,) -> (ScanState,):
    var out = state
    if !isDir(absDir):
        return out
    let names = listDir(absDir)
    var i = 0
    while i < len(names):
        let name = names[i]
        let absPath = absDir + "/" + name
        let relPath = joinRel(relDir, name)
        let packagePath = joinRel(rootRel, relPath)
        let directory = isDir(absPath)
        let kind = classifyEntry(name, directory)
        if isEntryKind(kind, entryDirectory):
            if !isExcluded(packagePath, excludes) && !hasNestedManifest(absPath):
                out = scan(absPath, rootRel, relPath, excludes, out)
        else:
            if isEntryKind(kind, entrySource) && !isExcluded(packagePath, excludes):
                out.files = out.files.append(relPath)
        i = i + 1
    return out
