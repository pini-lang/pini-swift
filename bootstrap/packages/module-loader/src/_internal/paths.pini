; 相对路径拼接：父为空时直接取子，不产生前导斜杠；子为空时保留父。
joinRel|func(parent: String, child: String,) -> (String,):
    if len(parent) == 0:
        return child
    if len(child) == 0:
        return parent
    return parent + "/" + child

; 文件名：最后一个斜杠之后的部分；无斜杠取整串，扩展名不在此处剥。
baseNameOf|func(_path: String,) -> (String,):
    var at = -1
    var i = 0
    while i < len(_path):
        if _path[i] == "/":
            at = i
        i = i + 1
    if at < 0:
        return _path
    return _path.substring(at + 1, len(_path))

; 去源后缀：名以 `.pini` 结尾时剥掉；单文件入口拿它当包名，包名不许带点。
sourceNameOf|func(_name: String,) -> (String,):
    if len(_name) <= 5:
        return _name
    if _name.substring(len(_name) - 5, len(_name)) == ".pini":
        return _name.substring(0, len(_name) - 5)
    return _name
