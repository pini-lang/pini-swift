; 字节序比较：先比公共前缀的字节，再比长度；UTF-8 字节序与码点序一致。
comparePaths|func(first: String, second: String,) -> (I32,):
    let a = tempUtf8Bytes(first)
    let b = tempUtf8Bytes(second)
    var i = 0
    while i < len(a) && i < len(b):
        let left = tempByteToInt(a[i])
        let right = tempByteToInt(b[i])
        if left < right:
            return -1
        if left > right:
            return 1
        i = i + 1
    if len(a) < len(b):
        return -1
    if len(a) > len(b):
        return 1
    return 0

; 按字节序插入一个名字：保持升序，相等时排在已有项之后。
insertPath|func(items: Array<String>, value: String,) -> (Array<String>,):
    var out: Array<String> = []
    var placed = false
    var i = 0
    while i < len(items):
        if !placed && comparePaths(first = value, second = items[i]) < 0:
            out = out.append(value)
            placed = true
        out = out.append(items[i])
        i = i + 1
    if !placed:
        out = out.append(value)
    return out

; 排序：同一批只有几十个名字，插入排序的稳定与可读优先于复杂度。
sortPaths|func(_items: Array<String>,) -> (Array<String>,):
    var out: Array<String> = []
    var i = 0
    while i < len(_items):
        out = insertPath(items = out, value = _items[i])
        i = i + 1
    return out
