; 计数文本：本包不依赖语义层，自带一份最小的整数转文本，只服务条数与目标数。
; 名字带包前缀，避免与语义层的同名函数在整图发射时撞全局符号。
kitCountText|func(value: I32,) -> (String,):
    if value == 0:
        return "0"
    let table = "0123456789"
    var rest = value
    var negative = false
    if rest < 0:
        negative = true
        rest = 0 - rest
    var digits = ""
    while rest > 0:
        let digit = rest % 10
        digits = table.slice(digit, digit + 1) + digits
        rest = rest / 10
    if negative:
        return "-" + digits
    return digits
