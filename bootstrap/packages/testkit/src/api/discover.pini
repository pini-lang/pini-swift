[discover|import]
_ir = "../../../ir"

; 测试清单：从模块函数表取测试标记为真的函数，按模块序保序。
; 归属由目标前缀决定；不在任何测试目标里的测试不猜归属，交给调用方报错。
; 发现只看标记不看文件名：测试目标之外写了 |test 也会进清单。
(TestRef)
name: String = ""
sourceFile: String = ""
target: I32 = -1

; 发现：逐函数扫一遍，测试标记为真才收；目标下标按最长前缀算，未命中答 -1。
discoverTests|func(module: IrModule, targets: Array<TestTarget>,) -> (Array<TestRef>,):
    var out: Array<TestRef> = []
    var i = 0
    while i < len(module.functions):
        let fn = module.functions[i]
        if fn.isTest:
            var row = TestRef()
            row.name = fn.name
            row.sourceFile = fn.sourceFile
            row.target = testTargetOf(path = fn.sourceFile, targets = targets)
            out = out.append(row)
        i = i + 1
    return out

; 未归属条数：清单里目标下标为 -1 的条数；非零即说明测试目标声明缺了一块。
unattributedCount|func(refs: Array<TestRef>,) -> (I32,):
    var n = 0
    var i = 0
    while i < len(refs):
        if refs[i].target < 0:
            n = n + 1
        i = i + 1
    return n

; 首个未归属文件：报错只说一处，够定位即可；全清单不往错误文本里塞。
firstUnattributedFile|func(refs: Array<TestRef>,) -> (String,):
    var i = 0
    while i < len(refs):
        if refs[i].target < 0:
            return refs[i].sourceFile
        i = i + 1
    return ""
