[select|import]
_support = "../../../support"

; 选择面：筛选、跳过与逐目标分组；判据与宿主工作区测试同一口径。
; 先筛后跳，跳过规则必须命中至少一条；零命中、空目标、全跳过都落成专用错，不静默空跑。

; 执行组：一个测试目标一段；首条下标指向选中清单，报告按段取胜负。
(TestGroup)
label: String = ""
basePath: String = ""
firstTest: I32 = 0
count: I32 = 0
collected: I32 = 0
skipped: Bool = false

; 选择结果：有序选中清单、分组与失败原因；失败时清单与分组都不使用。
(TestSelection)
refs: Array<TestRef> = []
groups: Array<TestGroup> = []
failed: Bool = false
errorText: String = ""

; 失败结果：只带一句可打印的原因，调用方据此非零退出。
testError|func(text: String,) -> (TestSelection,):
    var out = TestSelection()
    out.failed = true
    out.errorText = text
    return out

; 跳过命中：任一收集名含该片段即算命中；拼错的名字会在这里显形。
skipHits|func(refs: Array<TestRef>, skip: String,) -> (Bool,):
    var i = 0
    while i < len(refs):
        if refs[i].name.indexOf(skip) >= 0:
            return true
        i = i + 1
    return false

; 选中判定：筛选是子串且先生效，跳过在其后；空筛选表示不筛。
selectsName|func(name: String, filter: String, skips: Array<String>,) -> (Bool,):
    if len(filter) > 0 && name.indexOf(filter) < 0:
        return false
    var i = 0
    while i < len(skips):
        if name.indexOf(skips[i]) >= 0:
            return false
        i = i + 1
    return true

; 跳过清单文本：错误消息里按给出的次序拼，念起来与命令行一致。
skipText|func(skips: Array<String>,) -> (String,):
    var out = ""
    var i = 0
    while i < len(skips):
        out = out + " --skip '" + skips[i] + "'"
        i = i + 1
    return out

; 选择：按目标次序分组，组内保模块序；所有错误都在发射之前判掉。
selectTests|func(refs: Array<TestRef>, targets: Array<TestTarget>, filter: String, skips: Array<String>,) -> (TestSelection,):
    if len(refs) == 0:
        return testError(text = "工作区未收集到任何 |test 测试函数")
    if unattributedCount(refs = refs) > 0:
        return testError(text = "有 " + kitCountText(value = unattributedCount(refs = refs)) + " 个 |test 不在任何测试目标里：" + firstUnattributedFile(refs = refs))
    var s = 0
    while s < len(skips):
        if !skipHits(refs = refs, skip = skips[s]):
            return testError(text = "没有测试名匹配 --skip '" + skips[s] + "'；跳过规则写了就必须命中至少一条")
        s = s + 1
    var out = TestSelection()
    var total = 0
    var filterHit = 0
    var t = 0
    while t < len(targets):
        var group = TestGroup()
        group.label = testTargetLabel(target = targets[t])
        group.basePath = targets[t].basePath
        group.firstTest = total
        var collected = 0
        var chosen = 0
        var r = 0
        while r < len(refs):
            if refs[r].target == t:
                collected = collected + 1
                if len(filter) == 0 || refs[r].name.indexOf(filter) >= 0:
                    filterHit = filterHit + 1
                if selectsName(name = refs[r].name, filter = filter, skips = skips):
                    out.refs = out.refs.append(refs[r])
                    chosen = chosen + 1
            r = r + 1
        if collected == 0:
            return testError(text = "包 '" + targets[t].packageName + "' 的测试 target '" + targets[t].targetName + "' 未收集到任何 |test 测试函数")
        group.collected = collected
        group.count = chosen
        group.skipped = chosen == 0
        total = total + chosen
        out.groups = out.groups.append(group)
        t = t + 1
    if len(filter) > 0 && filterHit == 0:
        return testError(text = "没有测试名匹配筛选条件 '" + filter + "'")
    if total == 0:
        return testError(text = "筛选与跳过之后没有测试可跑（--filter '" + filter + "'" + skipText(skips = skips) + "）")
    return out

; 汇总：通过数由总条数减失败数得来，调用方不必另存计数器。
selectionCount|func(selection: TestSelection,) -> (I32,):
    return len(selection.refs)
