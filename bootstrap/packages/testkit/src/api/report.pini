[report|import]
_support = "../../../support"

; 报告措辞：清单与运行报告共用这一份拼写，发射器只按调用方给的串拼装。
; 组头与汇总与宿主工作区报告同形，两侧读数才能并排看。

; 首行：输入种类不同，措辞同族；自举入口按工作区跑，故取工作区那一形。
testHeaderLine|func(rootLabel: String, targetCount: I32,) -> (String,):
    return "测试目标: 工作区 " + rootLabel + "（" + kitCountText(value = targetCount) + " 个测试 target）"

; 组头：通过只计数，失败逐条带消息；全跳过单独一行说明，空结果不冒充没有测试。
testGroupFormat|func() -> (String,):
    return "包 %s（%d 个测试，%d 通过）\n"

testGroupSkippedFormat|func() -> (String,):
    return "包 %s（%d 个测试，--skip 全数排除）\n"

; 失败行带用例所在文件：只有断言文案时，同一句在几十个测试文件里定位不到。
testFailFormat|func() -> (String,):
    return " ✗ %s（%s）: %s\n"

testResultFormat|func() -> (String,):
    return "结果: %d 通过, %d 失败\n"

; 清单行：一条测试一行，序号不进文本；组头带收集数与选中数。
testListGroupLine|func(group: TestGroup,) -> (String,):
    return "包 " + group.label + "（" + kitCountText(value = group.collected) + " 个测试，" + kitCountText(value = group.count) + " 选中）"

testListTestLine|func(name: String,) -> (String,):
    return " 测试 " + name

testListSummaryLine|func(selection: TestSelection,) -> (String,):
    return "清单: " + kitCountText(value = selectionCount(selection = selection)) + " 条"
