[target|import]
_support = "../../../support"

; 测试目标：包名、目标名、源码前缀与包根绝对路径；驱动按包计划填，本包只认值。
; 归属按最长前缀命中：同包多个测试目标时，短前缀不得吃掉长前缀的文件。
(TestTarget)
packageName: String = ""
targetName: String = ""
rootPath: String = ""
basePath: String = ""

; 目标标签：报告组头与清单共用一份拼写。
testTargetLabel|func(target: TestTarget,) -> (String,):
    return target.packageName + " / " + target.targetName

; 前缀命中：按目录边界比，`a/tests2/x` 不算落在 `a/tests` 里。
pathHasPrefix|func(path: String, prefix: String,) -> (Bool,):
    if len(prefix) == 0:
        return false
    if len(path) <= len(prefix):
        return false
    if path.slice(0, len(prefix)) != prefix:
        return false
    return path.slice(len(prefix), len(prefix) + 1) == "/"

; 归属：最长前缀命中；无命中答 -1，调用方据此报未归属。
testTargetOf|func(path: String, targets: Array<TestTarget>,) -> (I32,):
    var best = -1
    var bestLen = -1
    var i = 0
    while i < len(targets):
        let root = targets[i].rootPath
        if pathHasPrefix(path = path, prefix = root) && len(root) > bestLen:
            best = i
            bestLen = len(root)
        i = i + 1
    return best
