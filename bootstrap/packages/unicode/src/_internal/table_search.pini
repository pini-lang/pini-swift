; Unicode 表的通用查找：记录是定宽十六进制文本，按码点升序，直接按偏移读字段。
; 表以字符串形式随源码提交，调用方转成字节视图后复用；任一字段不合法都按未命中。

; 表描述：条数、单条字节数、值字段位数；码点字段恒为 6 位。
(HexTable)
limit: I32 = 0
recordWidth: I32 = 0
valueWidth: I32 = 0

; 码点字段位数：24 位足以覆盖 U+10FFFF。
codeWidth|func() -> (I32,):
    return 6

; 一位十六进制转数值；非十六进制字符答 -1，由查表按未命中处理。
hexDigit|func(_byte: I32,) -> (I32,):
    if _byte >= 48 && _byte <= 57:
        return _byte - 48
    if _byte >= 97 && _byte <= 102:
        return _byte - 87
    return -1

; 定宽字段转数值：从 start 起读 width 位；任一位非法即答 -1。
hexField|func(bytes: Array<U8>, start: I32, width: I32,) -> (I32,):
    var out = 0
    var i = 0
    while i < width:
        let digit = hexDigit(tempByteToInt(bytes[start + i]))
        if digit < 0:
            return -1
        out = out * 16 + digit
        i = i + 1
    return out

; 精确查表：命中答值字段，未命中答 -1。
lookupExact|func(bytes: Array<U8>, table: HexTable, code: I32,) -> (I32,):
    var lo = 0
    var hi = table.limit - 1
    while lo <= hi:
        let mid = (lo + hi) / 2
        let at = mid * table.recordWidth
        let key = hexField(bytes = bytes, start = at, width = codeWidth())
        if key == code:
            return hexField(bytes = bytes, start = at + codeWidth(), width = table.valueWidth)
        if key < code:
            lo = mid + 1
        else:
            hi = mid - 1
    return -1

; 区间查表：记录是区间起点，答最后一个起点不超过码点的值；码点小于首条时答 0。
lookupRange|func(bytes: Array<U8>, table: HexTable, code: I32,) -> (I32,):
    var lo = 0
    var hi = table.limit - 1
    var hit = -1
    while lo <= hi:
        let mid = (lo + hi) / 2
        let at = mid * table.recordWidth
        let key = hexField(bytes = bytes, start = at, width = codeWidth())
        if key <= code:
            hit = mid
            lo = mid + 1
        else:
            hi = mid - 1
    if hit < 0:
        return 0
    return hexField(bytes = bytes, start = hit * table.recordWidth + codeWidth(), width = table.valueWidth)

; 成对查表：记录是先、后两个码点加结果，三者都按 6 位存，未命中答 -1。
lookupPair|func(bytes: Array<U8>, table: HexTable, first: I32, second: I32,) -> (I32,):
    var lo = 0
    var hi = table.limit - 1
    while lo <= hi:
        let mid = (lo + hi) / 2
        let at = mid * table.recordWidth
        let head = hexField(bytes = bytes, start = at, width = codeWidth())
        if head == first:
            let tail = hexField(bytes = bytes, start = at + codeWidth(), width = codeWidth())
            if tail == second:
                return hexField(bytes = bytes, start = at + codeWidth() * 2, width = codeWidth())
            if tail < second:
                lo = mid + 1
            else:
                hi = mid - 1
        else:
            if head < first:
                lo = mid + 1
            else:
                hi = mid - 1
    return -1
