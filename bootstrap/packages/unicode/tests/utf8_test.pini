[utf8_test|import]
_support = "../../support"

; 测试助手：把文本按 UTF-8 编码后解码，避免每个用例重复取字节。
解码文本|func(_text: String,) -> (Utf8Text,):
    return decodeUtf8(tempUtf8Bytes(text))

; 测试助手：错误类别与起始字节偏移一起核对，两处都不得漂移。
断言错误|func(text: Utf8Text, expected: String, at: I32,) -> ():
    assert(text.errorName() == expected, "错误类别不符")
    assert(text.errorOffset() == at, "错误偏移不符")
    assert(!text.isValid(), "出错时 isValid 必须为假")
    return

; 解码覆盖 1..4 字节宽度，并逐项核对标量值与字节区间。
宽度与偏移|test() -> ():
    let bytes: Array<U8> = [65, 195, 169, 228, 184, 173, 240, 144, 141, 136]
    let text = decodeUtf8(bytes)
    assert(text.isValid(), "整段应合法")
    assert(text.scalarCount() == 4, "四个标量")
    assert(text.scalarAt(0).code == 65, "A")
    assert(text.scalarAt(1).code == 233, "é")
    assert(text.scalarAt(2).code == 20013, "中")
    assert(text.scalarAt(3).code == 66376, "U+10348")
    assert(text.scalarAt(0).start == 0, "A 起点")
    assert(text.scalarAt(0).length == 1, "A 宽度")
    assert(text.scalarAt(1).start == 1, "é 起点")
    assert(text.scalarAt(1).length == 2, "é 宽度")
    assert(text.scalarAt(2).start == 3, "中 起点")
    assert(text.scalarAt(2).length == 3, "中 宽度")
    assert(text.scalarAt(3).start == 6, "U+10348 起点")
    assert(text.scalarAt(3).length == 4, "U+10348 宽度")
    return

; 序列在输入末尾缺续字节时判截断，已解出的标量保留。
拒绝截断|test() -> ():
    let cut: Array<U8> = [65, 228, 184]
    let partial = decodeUtf8(cut)
    assert(partial.scalarCount() == 1, "截断前只有一个标量")
    断言错误(text = partial, expected = "截断", at = 1)
    let lone: Array<U8> = [228]
    let empty = decodeUtf8(lone)
    assert(empty.scalarCount() == 0, "孤立首字节不产标量")
    断言错误(text = empty, expected = "截断", at = 0)
    return

; 游离续字节与 F8..FF 都是首字节非法，后续字节不再消费。
拒绝游离续字节|test() -> ():
    let stray: Array<U8> = [65, 128]
    let text = decodeUtf8(stray)
    assert(text.scalarCount() == 1, "游离续字节前有一个标量")
    断言错误(text = text, expected = "首字节非法", at = 1)
    let badLead: Array<U8> = [255]
    let text2 = decodeUtf8(badLead)
    assert(text2.scalarCount() == 0, "FF 不产标量")
    断言错误(text = text2, expected = "首字节非法", at = 0)
    return

; 应到续字节的位置读到非续字节，按续字节非法报在序列起点。
拒绝续字节错位|test() -> ():
    let broken: Array<U8> = [228, 65]
    let text = decodeUtf8(broken)
    断言错误(text = text, expected = "续字节非法", at = 0)
    return

; 低于该宽度下界的编码是过长编码：C0/C1 与 E0/F0 开头的小值都要拒绝。
拒绝过长编码|test() -> ():
    let c0: Array<U8> = [192, 128]
    断言错误(text = decodeUtf8(c0), expected = "过长编码", at = 0)
    let e0: Array<U8> = [224, 128, 128]
    断言错误(text = decodeUtf8(e0), expected = "过长编码", at = 0)
    let f0: Array<U8> = [240, 128, 128, 128]
    断言错误(text = decodeUtf8(f0), expected = "过长编码", at = 0)
    return

; 代理区不得出现在合法 UTF-8 中。
拒绝代理区|test() -> ():
    let surrogate: Array<U8> = [237, 160, 128]
    断言错误(text = decodeUtf8(surrogate), expected = "代理区", at = 0)
    return

; 上界之外分两类：F4 的高位序列超出 U+10FFFF，F5..F7 直接判超出上限。
拒绝超出上限|test() -> ():
    let high: Array<U8> = [244, 144, 128, 128]
    断言错误(text = decodeUtf8(high), expected = "超出上限", at = 0)
    let lead: Array<U8> = [245, 128, 128, 128]
    断言错误(text = decodeUtf8(lead), expected = "超出上限", at = 0)
    return

; 错误不吞掉前缀：合法标量保留，错误后的字节不再解释。
错误前保留标量|test() -> ():
    let bytes: Array<U8> = [65, 255, 66]
    let text = decodeUtf8(bytes)
    assert(text.scalarCount() == 1, "只保留错误前的标量")
    assert(text.scalarAt(0).code == 65, "前缀是 A")
    断言错误(text = text, expected = "首字节非法", at = 1)
    return

; 编码往返：每个标量重新编码后与原始字节逐字节相同。
编码往返|test() -> ():
    let bytes: Array<U8> = [65, 195, 169, 228, 184, 173, 240, 144, 141, 136]
    let text = decodeUtf8(bytes)
    var builder = ByteBuilder()
    var i = 0
    while i < text.scalarCount():
        builder = builder.appendScalar(text.scalarAt(i).code)
        i = i + 1
    let rebuilt = builder.takeBuffer().bytes
    assert(len(rebuilt) == len(bytes), "往返长度")
    var j = 0
    while j < len(bytes):
        assert(rebuilt[j] == bytes[j], "往返字节不同")
        j = j + 1
    return

; 编码宽度在四个下界处切换：1/2/3/4 字节各两条。
编码宽度边界|test() -> ():
    assert(len(utf8Encode(0)) == 1, "U+0000 一字节")
    assert(len(utf8Encode(127)) == 1, "U+007F 一字节")
    assert(len(utf8Encode(128)) == 2, "U+0080 二字节")
    assert(len(utf8Encode(2047)) == 2, "U+07FF 二字节")
    assert(len(utf8Encode(2048)) == 3, "U+0800 三字节")
    assert(len(utf8Encode(65535)) == 3, "U+FFFF 三字节")
    assert(len(utf8Encode(65536)) == 4, "U+10000 四字节")
    assert(len(utf8Encode(1114111)) == 4, "U+10FFFF 四字节")
    return

; 分类只按通用类别：字母 L*、数字 N*；组合附加符号两者都不是。
分类字母数字|test() -> ():
    assert(isLetterScalar(65), "A 是字母")
    assert(isNumberScalar(48), "0 是数字")
    assert(!isLetterScalar(48), "0 不是字母")
    assert(isLetterScalar(20013), "中是字母")
    assert(isNumberScalar(1635), "U+0663 是数字")
    assert(isNumberScalar(8551), "U+2167 是数字")
    assert(isLetterScalar(65313), "全角 Ａ 是字母")
    assert(isLetterScalar(119808), "数学粗体 A 是字母")
    assert(!isLetterScalar(769), "U+0301 不是字母")
    assert(!isNumberScalar(769), "U+0301 不是数字")
    assert(isAsciiScalar(127), "U+007F 是 ASCII")
    assert(!isAsciiScalar(128), "U+0080 不是 ASCII")
    return

; 空白按 White_Space 属性：NBSP 与全角空格算，零宽空格与 BOM 不算。
分类空白|test() -> ():
    assert(isWhitespaceScalar(32), "空格")
    assert(isWhitespaceScalar(9), "制表符")
    assert(isWhitespaceScalar(10), "换行")
    assert(isWhitespaceScalar(13), "回车")
    assert(isWhitespaceScalar(160), "NBSP")
    assert(isWhitespaceScalar(12288), "全角空格")
    assert(!isWhitespaceScalar(8203), "零宽空格不是空白")
    assert(!isWhitespaceScalar(65279), "BOM 不是空白")
    assert(!isLetterScalar(8203), "零宽空格不是字母")
    return

; 标识符判据：字母、数字、下划线与组合附加符号续写；组合附加符号不得起始。
标识符判据|test() -> ():
    assert(startsIdentifier(95), "下划线可起始")
    assert(continuesIdentifier(95), "下划线可续写")
    assert(!startsIdentifier(48), "数字不得起始")
    assert(continuesIdentifier(48), "数字可续写")
    assert(startsIdentifier(20013), "中文可起始")
    assert(continuesIdentifier(20013), "中文可续写")
    assert(continuesIdentifier(769), "组合附加符号可续写")
    assert(!startsIdentifier(769), "组合附加符号不得起始")
    assert(continuesIdentifier(8400), "组合附加符号区块二可续写")
    assert(continuesIdentifier(65056), "组合附加符号半宽区块可续写")
    assert(!continuesIdentifier(8203), "零宽空格不续写")
    return

; 单步解码只消费该标量自身的字节：长度即消费数，起点之后的内容一律不读。
单步解码消费字节数|test() -> ():
    let bytes: Array<U8> = [65, 195, 169, 228, 184, 173, 240, 144, 141, 136]
    let a = decodeScalarAt(bytes = bytes, offset = 0)
    assert(a.length == 1, "ASCII 消费一字节")
    assert(a.code == 65, "ASCII 码点")
    assert(utf8ErrorName(a.error) == "无", "ASCII 无错误")
    let e = decodeScalarAt(bytes = bytes, offset = 1)
    assert(e.length == 2, "é 消费两字节")
    assert(e.code == 233, "é 码点")
    let z = decodeScalarAt(bytes = bytes, offset = 3)
    assert(z.length == 3, "中 消费三字节")
    assert(z.code == 20013, "中 码点")
    let s = decodeScalarAt(bytes = bytes, offset = 6)
    assert(s.length == 4, "U+10348 消费四字节")
    assert(s.code == 66376, "U+10348 码点")
    return

; 单步失败答长度零，类别与整段解码一致；不改动输入也不越过出错序列起点。
单步解码失败类别|test() -> ():
    let cut: Array<U8> = [228, 184]
    let truncated = decodeScalarAt(bytes = cut, offset = 0)
    assert(truncated.length == 0, "截断不消费")
    assert(utf8ErrorName(truncated.error) == "截断", "截断类别")
    let stray: Array<U8> = [128]
    let lead = decodeScalarAt(bytes = stray, offset = 0)
    assert(lead.length == 0, "游离续字节不消费")
    assert(utf8ErrorName(lead.error) == "首字节非法", "游离续字节类别")
    let overlong: Array<U8> = [192, 128]
    assert(utf8ErrorName(decodeScalarAt(bytes = overlong, offset = 0).error) == "过长编码", "过长编码类别")
    let surrogate: Array<U8> = [237, 160, 128]
    assert(utf8ErrorName(decodeScalarAt(bytes = surrogate, offset = 0).error) == "代理区", "代理区类别")
    let high: Array<U8> = [244, 144, 128, 128]
    assert(utf8ErrorName(decodeScalarAt(bytes = high, offset = 0).error) == "超出上限", "超出上限类别")
    let broken: Array<U8> = [228, 65]
    assert(utf8ErrorName(decodeScalarAt(bytes = broken, offset = 0).error) == "续字节非法", "续字节错位类别")
    return

; 数据版本由生成表固定；BOM、NUL 与非法码点边界都按普通标量解码。
版本与特殊标量|test() -> ():
    assert(unicodeVersion() == "15.1.0", "数据版本")
    let bomBytes: Array<U8> = [239, 187, 191]
    let bom = decodeUtf8(bomBytes)
    assert(bom.isValid(), "BOM 字节序列本身合法")
    assert(bom.scalarAt(0).code == 65279, "BOM 标量")
    let nul: Array<U8> = [0]
    let zero = decodeUtf8(nul)
    assert(zero.isValid(), "NUL 合法")
    assert(zero.scalarAt(0).code == 0, "NUL 码点")
    let maxBytes: Array<U8> = [244, 143, 191, 191]
    let maxText = decodeUtf8(maxBytes)
    assert(maxText.isValid(), "U+10FFFF 合法")
    assert(maxText.scalarAt(0).code == 1114111, "U+10FFFF 码点")
    return
