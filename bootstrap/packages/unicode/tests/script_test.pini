; 脚本归属：拉丁字母答 1，中文答 0（其它），西里尔与希腊各答自身编号。
脚本归属|test() -> ():
    assert(scriptOf(65) == 1, "A 属拉丁")
    assert(scriptOf(122) == 1, "z 属拉丁")
    assert(scriptOf(20013) == 0, "中文不在高风险脚本内")
    assert(scriptOf(1044) == 2, "西里尔 Д 属区块二")
    assert(scriptOf(945) == 3, "希腊 α 属区块三")
    return

; 混写判定：两个不同高风险脚本相撞才算；与其它脚本同现不算。
混写判定|test() -> ():
    assert(scriptsConflict(first = 1, second = 2), "拉丁与西里尔算混写")
    assert(scriptsConflict(first = 1, second = 3), "拉丁与希腊算混写")
    assert(scriptsConflict(first = 2, second = 3), "西里尔与希腊算混写")
    assert(!scriptsConflict(first = 1, second = 0), "中文与拉丁不算混写")
    assert(!scriptsConflict(first = 1, second = 1), "同一脚本不算混写")
    return
