[dump_test|import]
_ir = "../../ir"
_backend_kit = "../../backend-kit"

; 转储判据：手搭模块只喂转储，不经过装配链；真实模块由 lower 与 validate 另行验证。
; 每条判据只钉一类行：声明、槽表、函数体与份额、错误表；手搭反而能精确到一条。

; 转储记录：档次为转储、全族声明，入口码取一；记录由调用方给，转储只读它。
转储造记录|func() -> (BackendEntry,):
    return makeBackendOf(name = "dump", outputCode = backendOutputDumpCode(), families = backendFamilyCodes(), entry = 1)

; 转储造类型池：i32 与 String 两个标量，外加一个数组。
转储造类型池|func() -> (IrTypePool,):
    var pool = IrTypePool()
    let intType = irScalarTypeOfCode(pool = pool, code = 1, name = "i32")
    pool = intType.pool
    let textType = irScalarTypeOfCode(pool = pool, code = 8, name = "String")
    pool = textType.pool
    let listType = irWrapTypeOfCode(pool = pool, code = 12, name = "", inner = intType.id)
    return listType.pool

; 转储造声明表：一个结构一个枚举，字段序与用例序都从零开始。
转储造声明表|func() -> (IrDeclTable,):
    var table = IrDeclTable()
    var point = IrDecl()
    point.typeId = 0
    point.name = "点"
    point.kind = irDeclKindOf(shapeCode = 1)
    var field = IrField()
    field.name = "x"
    field.typeId = 0
    point.fields = point.fields.append(field)
    table.entries = table.entries.append(point)
    var flag = IrDecl()
    flag.typeId = 1
    flag.name = "旗"
    flag.kind = irDeclKindOf(shapeCode = 3)
    var one = IrCase()
    one.name = "甲"
    one.tag = 0
    flag.cases = flag.cases.append(one)
    var two = IrCase()
    two.name = "乙"
    two.tag = 1
    two.payload = two.payload.append(0)
    flag.cases = flag.cases.append(two)
    table.entries = table.entries.append(flag)
    return table

; 转储造槽表：头四槽与载荷基址，一个结构行带一个字段槽。
转储造槽表|func() -> (IrSlotTable,):
    var table = IrSlotTable()
    table.headSlots = 4
    table.payloadBase = 5
    var row = IrSlotRow()
    row.typeId = 0
    row.shapeCode = 1
    row.slotCount = 5
    var slot = IrSlot()
    slot.index = 4
    slot.role = irSlotRoleOf(code = 5)
    slot.name = "x"
    slot.typeId = 0
    row.slots = row.slots.append(slot)
    table.entries = table.entries.append(row)
    return table

; 转储造节点池：变量声明与返回两条语句，装入序即下标序。
转储造节点池|func() -> (IrNodePool,):
    var nodes = IrNodePool()
    var alloc = irMakeNode(kind = tagOfName(name = "allocVar"), typeId = 0)
    alloc.text = 0
    alloc.adopt = 3
    alloc.releaseOld = true
    let placed = irAppendNode(pool = nodes, node = alloc)
    nodes = placed.pool
    var back = irMakeNode(kind = tagOfName(name = "returnStmt"), typeId = -1)
    let placedBack = irAppendNode(pool = nodes, node = back)
    return placedBack.pool

; 转储造语句体：按节点池的装入序给两条下标。
转储造语句体|func() -> (Array<I32>,):
    var body: Array<I32> = []
    body = body.append(0)
    body = body.append(1)
    return body

; 转储造位置表：两条语句各一条源偏移，表达式共用所在语句的偏移。
转储造位置表|func() -> (Array<IrPosition>,):
    var positions: Array<IrPosition> = []
    positions = recordPosition(positions = positions, node = 0, offset = 7)
    positions = recordPosition(positions = positions, node = 1, offset = 15)
    return positions

; 转储造模块：类型、声明、槽、文本、一个函数。
转储造模块|func() -> (IrModule,):
    var module = IrModule()
    module.types = 转储造类型池()
    module.decls = 转储造声明表()
    module.slots = 转储造槽表()
    module.texts = module.texts.append("x")
    module.nodes = 转储造节点池()
    var fn = IrFunction()
    fn.name = "f"
    fn.returnType = -1
    fn.body = 转储造语句体()
    fn.positions = 转储造位置表()
    fn.sourceFile = "样例.pini"
    module.functions = module.functions.append(fn)
    return module

; 行数：数文本里的换行，末尾恒有一个换行，故与行读数相等。
行数|func(text: String,) -> (I32,):
    var total = 0
    var i = 0
    while i < len(text):
        if text[i] == chr(10):
            total = total + 1
        i = i + 1
    return total

; 含子串：成员被调走参数接收者，避免「字段读后直接成员被调」的定型盲区。
含子串|func(text: String, needle: String,) -> (Bool,):
    return text.indexOf(needle) >= 0

; 结构转储：声明与字段各占一行，字段序即槽位；槽表头两个常量先出。
结构转储|test() -> ():
    let module = 转储造模块()
    let result = dumpModule(entry = 转储造记录(), target = defaultTarget(), module = module)
    assert(含子串(text = result.text, needle = "types\n"), "应有类型池一节")
    assert(含子串(text = result.text, needle = "decl 0 struct 点 fields=1 cases=0"), "结构声明应带字段数")
    assert(含子串(text = result.text, needle = "field 0 x type=i32"), "字段行应带序号与拼写")
    assert(含子串(text = result.text, needle = "decl 1 enum 旗 fields=0 cases=2"), "枚举声明应带用例数")
    assert(含子串(text = result.text, needle = "case 1 乙 tag=1 payload=(i32)"), "带载荷用例应印载荷类型")
    assert(含子串(text = result.text, needle = "slots headSlots=4 payloadBase=5"), "槽表应带头常量")
    assert(含子串(text = result.text, needle = "role=field name=x type=i32"), "字段槽应带角色与名字")
    return

; 函数体：语句行带位置、类别名与份额动作；类别名按码印，不印数字。
函数体|test() -> ():
    let module = 转储造模块()
    let result = dumpModule(entry = 转储造记录(), target = defaultTarget(), module = module)
    assert(含子串(text = result.text, needle = "func 0 f params=0"), "函数行应带形参数")
    assert(含子串(text = result.text, needle = "kind=allocVar"), "应有变量声明语句")
    assert(含子串(text = result.text, needle = "adopt=retain"), "存储点应带接收动作")
    assert(含子串(text = result.text, needle = "releaseOld=true"), "存储点应带旧份额标记")
    assert(含子串(text = result.text, needle = "@7"), "语句应带源位置")
    assert(含子串(text = result.text, needle = "kind=returnStmt"), "应有返回语句")
    return

; 确定性：同一模块两遍转储逐字节相同，行读数与文本换行数相等。
确定性|test() -> ():
    let module = 转储造模块()
    let once = dumpModule(entry = 转储造记录(), target = defaultTarget(), module = module)
    let twice = dumpModule(entry = 转储造记录(), target = defaultTarget(), module = module)
    assert(once.text == twice.text, "两遍转储应逐字节相同")
    assert(once.lines == 行数(text = once.text), "行读数应等于换行数")
    assert(!once.failed, "转储不应失败")
    return

; 空体与错误：空体函数标 empty；两张错误表各占一行，码与诊断同源。
空体与错误|test() -> ():
    var module = 转储造模块()
    var empty = IrFunction()
    empty.name = "空"
    module.functions = module.functions.append(empty)
    module.errors = appendLowerError(errors = module.errors, error = makeLowerErrorOfCode(code = 4, file = "样例.pini", offset = 7, detail = "空：缺能力"))
    module.typeErrors = appendLowerError(errors = module.typeErrors, error = makeLowerErrorOfCode(code = 1, file = "", offset = 0, detail = "未知类型"))
    let result = dumpModule(entry = 转储造记录(), target = defaultTarget(), module = module)
    assert(含子串(text = result.text, needle = "empty=true"), "空体函数应标 empty")
    assert(含子串(text = result.text, needle = "error E6-004 样例.pini:7 空：缺能力"), "函数缺口应带码与位置")
    assert(含子串(text = result.text, needle = "typeError E6-001 未知类型"), "类型缺口应单独成行")
    return

; 全体类别：每个类别码各装一个节点，转储必须逐类印名，不漏也不重。
; 行序即池序，故行数等于节点数加六节表头；名字来自契约清单，测试不另抄一份。
全体类别|test() -> ():
    var module = IrModule()
    var nodes = IrNodePool()
    var i = 1
    while i < 201:
        if irIsExprTag(i) || irIsStmtTag(i):
            let node = irMakeNode(kind = i, typeId = -1)
            let placed = irAppendNode(pool = nodes, node = node)
            nodes = placed.pool
        i = i + 1
    module.nodes = nodes
    var fn = IrFunction()
    fn.name = "全类"
    var body: Array<I32> = []
    var k = 0
    while k < irNodeCount(nodes):
        body = body.append(k)
        k = k + 1
    fn.body = body
    module.functions = module.functions.append(fn)
    let result = dumpModule(entry = 转储造记录(), target = defaultTarget(), module = module)
    assert(result.lines == len(body) + 9, "行数应为节点数加七节表头")
    let names = irTagNames()
    i = 1
    while i < 201:
        if irIsExprTag(i) || irIsStmtTag(i):
            assert(含子串(text = result.text, needle = "kind=" + names[i]), "类别码应逐个印名")
        i = i + 1
    return
