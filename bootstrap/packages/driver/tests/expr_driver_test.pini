[expr_driver_test|import]
_support = "../../support"
_syntax = "../../syntax"
_diagnostics = "../../diagnostics"
_module_loader = "../../module-loader"
_package = "../../package"
_semantics = "../../semantics"

; 表达式装配：单文件单元走注册、类型解析与建世界，再逐单元跑表达式检查。
; 只验装配与诊断转换，不跑全工作区：吞吐缺口已登记，判据在抽样单元上成立。

; 造单元：只走装载，不注册；路径决定可见性推导的输入。
造单元|func(path: String, src: String,) -> (CompilationUnit,):
    let loaded = loadUnit(path = path, text = src)
    assert(!loaded.failed, "样例应可加载：" + path)
    return loaded.unit

; 建世界：单元排序后一次注册，再解析类型与铺表达式类型表。
建世界|func(units: Array<CompilationUnit>,) -> (MemberWorld,):
    let ordered = sortedUnits(units)
    let table = registerPackage(ordered)
    let types = resolvePackage(units = ordered, table = table)
    return makeMemberWorld(units = ordered, table = table, types = types)

; 未定义调用：转成一条诊断，码、位置与渲染文本都在。
表达式诊断成文|test() -> ():
    let unit = 造单元(path = "packages/p/src/api/p.pini", src = "f|func() -> ():\n    没有这个()\n")
    var all: Array<CompilationUnit> = [unit]
    let units = sortedUnits(all)
    let 诊断 = exprPackageDiagnostics(world = 建世界(units = units), units = units)
    assert(len(诊断) == 1, "应有一条诊断，实得 " + "\(len(诊断))")
    assert(诊断[0].code == "E3-002", "实得 " + 诊断[0].code)
    var files: Array<String> = ["packages/p/src/api/p.pini"]
    var texts: Array<SourceText> = [makeSourceText(unit.text)]
    let text = renderAll(items = 诊断, files = files, texts = texts)
    assert(text.contains("E3-002"), "渲染应带码，实得：" + text)
    return

; 合法单元：顶层函数与内建各调一次，诊断为空；这是防恒真的反向判据。
表达式合法零诊断|test() -> ():
    let unit = 造单元(path = "packages/p/src/api/p.pini", src = "甲|func() -> ():\n    pass\n\nf|func() -> ():\n    甲()\n    len(\"x\")\n")
    var all: Array<CompilationUnit> = [unit]
    let units = sortedUnits(all)
    let 诊断 = exprPackageDiagnostics(world = 建世界(units = units), units = units)
    assert(len(诊断) == 0, "合法单元不该有诊断，实得 " + 诊断串(诊断))
    return

; 实参类型：推导填表后，标签实参的类型不符被调用面拦下。
驱动实参类型不匹配|test() -> ():
    let unit = 造单元(path = "packages/p/src/api/p.pini", src = "甲|func(a: I32,) -> ():\n    pass\n\nf|func() -> ():\n    甲(a = \"x\")\n")
    var all: Array<CompilationUnit> = [unit]
    let units = sortedUnits(all)
    let 诊断 = exprPackageDiagnostics(world = 建世界(units = units), units = units)
    assert(len(诊断) == 1, "应有一条诊断，实得 " + "\(len(诊断))")
    assert(诊断[0].code == "E4-001", "实得 " + 诊断[0].code)
    return

; 宏未求值：计划里没有值，读点报 E4-044；有值时零诊断。
宏诊断|test() -> ():
    let unit = 造单元(path = "packages/p/src/api/p.pini", src = "[m|foreign]\nM|macro: I32\n\nf|func() -> (I32,):\n    return M\n")
    var all: Array<CompilationUnit> = [unit]
    let units = sortedUnits(all)
    let world = 建世界(units = units)
    var 缺: Array<PlanMacro> = []
    var 空跳过: Array<PlanSkip> = []
    var 包名: Array<String> = ["p"]
    let 缺诊断 = macroDiagnostics(units = units, world = world, macros = 缺, skips = 空跳过, unitPackages = 包名)
    assert(len(缺诊断) == 1, "应报一条，实得 " + "\(len(缺诊断))")
    assert(缺诊断[0].code == "E4-044", "实得 " + 缺诊断[0].code)
    assert(缺诊断[0].message.contains("pini build"), "缺计划文案应指 build：" + 缺诊断[0].message)
    var 有值 = PlanMacro()
    有值.package = "p"
    有值.name = "M"
    有值.state = "value"
    有值.type = "I32"
    有值.value = "1"
    var 表: Array<PlanMacro> = [有值]
    let 有值诊断 = macroDiagnostics(units = units, world = world, macros = 表, skips = 空跳过, unitPackages = 包名)
    assert(len(有值诊断) == 0, "有值不该报，实得 " + 诊断串(有值诊断))
    var 别包: Array<String> = ["q"]
    let 别包诊断 = macroDiagnostics(units = units, world = world, macros = 表, skips = 空跳过, unitPackages = 别包)
    assert(len(别包诊断) == 1, "别包的计划条目不该算本包有值")
    assert(别包诊断[0].message.contains("pini build"), "别包应报缺计划")
    return

; 生成面跳过名：调用位报 E4-046，理由带 shim 配方；未登记仍归未定义名。
跳过名诊断|test() -> ():
    let unit = 造单元(path = "packages/p/src/api/p.pini", src = "f|func() -> (I32,):\n    return DOUBLE(1)\n")
    var all: Array<CompilationUnit> = [unit]
    let units = sortedUnits(all)
    let world = 建世界(units = units)
    var 空宏: Array<PlanMacro> = []
    var 跳过 = PlanSkip()
    跳过.package = "p"
    跳过.stepName = "s"
    跳过.name = "DOUBLE"
    跳过.reason = "函数式宏要实参才能展开"
    var 表: Array<PlanSkip> = [跳过]
    var 包名: Array<String> = ["p"]
    let 诊断 = macroDiagnostics(units = units, world = world, macros = 空宏, skips = 表, unitPackages = 包名)
    assert(len(诊断) == 1, "应报一条，实得 " + 诊断串(诊断))
    assert(诊断[0].code == "E4-046", "实得 " + 诊断[0].code)
    assert(诊断[0].message.contains("shim") || 诊断[0].message.contains("函数式宏"), "理由应来自跳过表：" + 诊断[0].message)
    return

; 跳过名不跨包：q 包没有这条跳过项，DOUBLE 照常按未定义函数报，不被别包的表豁免。
跳过名不跨包|test() -> ():
    let unit = 造单元(path = "packages/q/src/api/q.pini", src = "f|func() -> (I32,):\n    return DOUBLE(1)\n")
    var all: Array<CompilationUnit> = [unit]
    let units = sortedUnits(all)
    let world = 建世界(units = units)
    var 空宏: Array<PlanMacro> = []
    var 跳过 = PlanSkip()
    跳过.package = "p"
    跳过.stepName = "s"
    跳过.name = "DOUBLE"
    跳过.reason = "函数式宏要实参才能展开"
    var 表: Array<PlanSkip> = [跳过]
    var 包名: Array<String> = ["q"]
    let 宏诊断 = macroDiagnostics(units = units, world = world, macros = 空宏, skips = 表, unitPackages = 包名)
    assert(len(宏诊断) == 0, "别包的跳过项不该在 q 报 E4-046：" + 诊断串(宏诊断))
    let 表达式诊断 = exprPackageDiagnosticsSkipping(world = world, units = units, skips = 表, unitPackages = 包名)
    assert(len(表达式诊断) == 1, "应报一条未定义函数，实得 " + 诊断串(表达式诊断))
    assert(表达式诊断[0].code == "E3-002", "实得 " + 表达式诊断[0].code)
    return

; 诊断串：断言失败时给出码与消息。
诊断串|func(_items: Array<Diagnostic>,) -> (String,):
    var out = ""
    var i = 0
    while i < len(_items):
        out = out + _items[i].code + ":" + _items[i].message + " "
        i = i + 1
    return out
