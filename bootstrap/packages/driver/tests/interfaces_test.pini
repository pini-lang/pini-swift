[interfaces_test|import]
_package = "../../package"
_semantics = "../../semantics"

; 助手：一条接口记录；被测函数只用名字与文本，摘要现算。
接口造快照|func(name: String, text: String,) -> (InterfaceRecord,):
    var out = InterfaceRecord()
    out.name = name
    out.text = text
    return out

; 助手：一条依赖摘要。
接口造依赖|func(name: String, hash: String,) -> (InterfaceDep,):
    var out = InterfaceDep()
    out.name = name
    out.hash = hash
    return out

; 助手：一条记录条目。
接口造条目|func(name: String, hash: String, deps: Array<InterfaceDep>,) -> (InterfaceEntry,):
    var out = InterfaceEntry()
    out.name = name
    out.hash = hash
    out.deps = deps
    return out

; 助手：空依赖表；直接写 `[]` 会被推成 I32 元素。
接口空依赖|func() -> (Array<InterfaceDep>,):
    var out: Array<InterfaceDep> = []
    return out

; 助手：两包计划，app 依赖 support。
接口造计划|func() -> (BuildPlan,):
    var out = BuildPlan()
    var 支持 = PackagePlan()
    支持.name = "support"
    var 应用 = PackagePlan()
    应用.name = "app"
    应用.requires = ["support"]
    out.packages = [支持, 应用]
    return out

; 助手：一份记录；摘要按当前文本给，app 的依赖摘要单独给。
接口造记录|func(支持文本: String, 应用文本: String, 依赖摘要: String,) -> (InterfaceLedger,):
    var out = InterfaceLedger()
    out.profile = "debug"
    out.entries = [接口造条目(name = "support", hash = sha256Hex(支持文本), deps = 接口空依赖()), 接口造条目(name = "app", hash = sha256Hex(应用文本), deps = [接口造依赖(name = "support", hash = 依赖摘要)])]
    return out

; 三条判据：都不变答空、本包变命中 self、只有依赖变命中 dep。
接口漂移判定|test() -> ():
    let 支持 = 接口造快照(name = "support", text = "sig 公开(x: I32) -> I32")
    let 应用 = 接口造快照(name = "app", text = "sig 调用(x: I32) -> I32")
    let 空 = interfaceDriftReport(接口造记录(支持文本 = "sig 公开(x: I32) -> I32", 应用文本 = "sig 调用(x: I32) -> I32", 依赖摘要 = sha256Hex(支持.text)), records = [支持, 应用], plan = 接口造计划())
    assert(len(空) == 0, "未变不该命中")
    let 自变 = interfaceDriftReport(接口造记录(支持文本 = "sig 公开(x: I64) -> I64", 应用文本 = "sig 调用(x: I32) -> I32", 依赖摘要 = sha256Hex(支持.text)), records = [支持, 应用], plan = 接口造计划())
    assert(len(自变) == 1, "本包变命中一条")
    assert(自变[0].kind == "self" && 自变[0].name == "support", "命中 self")
    let 依赖变 = interfaceDriftReport(接口造记录(支持文本 = "sig 公开(x: I32) -> I32", 应用文本 = "sig 调用(x: I32) -> I32", 依赖摘要 = "脏"), records = [支持, 应用], plan = 接口造计划())
    assert(len(依赖变) == 1, "依赖变命中一条")
    assert(依赖变[0].kind == "dep" && 依赖变[0].dep == "support", "命中 dep")
    return
