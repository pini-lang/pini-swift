[digest_test|import]
_package = "../../../package"

; 助手：一条依赖摘要；指纹只认名字与摘要。
构建造依赖|func(name: String, hash: String,) -> (InterfaceDep,):
    var out = InterfaceDep()
    out.name = name
    out.hash = hash
    return out

; 助手：空依赖表；直接写空数组字面量会被推成 I32 元素。
构建空依赖|func() -> (Array<InterfaceDep>,):
    var out: Array<InterfaceDep> = []
    return out

; 指纹：同输入同值；源码或依赖任一变化都换指纹；发射身份非空。
构建指纹|test() -> ():
    assert(len(emitProfile()) > 0, "发射身份非空")
    let 空 = 构建空依赖()
    let 一 = packageInputDigest(source = "src-a", deps = 空)
    let 二 = packageInputDigest(source = "src-a", deps = 空)
    assert(一 == 二, "同输入同指纹")
    let 源码变 = packageInputDigest(source = "src-b", deps = 空)
    assert(一 != 源码变, "源码变则指纹变")
    let 依赖变 = packageInputDigest(source = "src-a", deps = [构建造依赖(name = "support", hash = "h1")])
    assert(一 != 依赖变, "依赖变则指纹变")
    return

; 排序：部件按字节序升序，重复项照收，输入顺序不影响结果。
构建排序|test() -> ():
    let 排 = sortDigestParts(parts = ["b", "a", "c", "a"])
    assert(len(排) == 4, "全部保留")
    assert(排[0] == "a" && 排[1] == "a" && 排[2] == "b" && 排[3] == "c", "升序")
    let 一件 = sortDigestParts(parts = ["only"])
    assert(len(一件) == 1 && 一件[0] == "only", "单件原样")
    return

; 产物复用：记录有指纹与摘要、指纹一致、产物文本未被改，三条都满足才复用。
构建产物复用|test() -> ():
    let 文本 = "define i32 @f() {\n}\n"
    let 摘要 = sha256Hex(文本)
    assert(artifactReusable(recordedInput = "in", recordedHash = 摘要, currentInput = "in", artifactText = 文本), "全同复用")
    assert(!artifactReusable(recordedInput = "in", recordedHash = 摘要, currentInput = "out", artifactText = 文本), "指纹变不复用")
    assert(!artifactReusable(recordedInput = "", recordedHash = 摘要, currentInput = "", artifactText = 文本), "旧记录无指纹不复用")
    assert(!artifactReusable(recordedInput = "in", recordedHash = 摘要, currentInput = "in", artifactText = 文本 + " "), "文本被改不复用")
    return

; 接口复用：源码摘要与依赖摘要都没变、快照摘要与记录一致，才跳过接口重算。
构建接口复用|test() -> ():
    let 文本 = "package=app\nname=public\n"
    let 摘要 = sha256Hex(文本)
    var 旧 = InterfaceEntry()
    旧.name = "app"
    旧.path = ".build/debug/packages/app/interface.api.txt"
    旧.hash = 摘要
    旧.source = "src-a"
    旧.deps = 构建空依赖()
    assert(interfaceReusable(recorded = 旧, source = "src-a", deps = 构建空依赖(), artifactText = 文本), "全同复用")
    assert(!interfaceReusable(recorded = 旧, source = "src-b", deps = 构建空依赖(), artifactText = 文本), "源码变不复用")
    assert(!interfaceReusable(recorded = 旧, source = "src-a", deps = [构建造依赖(name = "support", hash = "h1")], artifactText = 文本), "依赖变不复用")
    assert(!interfaceReusable(recorded = 旧, source = "src-a", deps = 构建空依赖(), artifactText = 文本 + " "), "文本被改不复用")
    return
