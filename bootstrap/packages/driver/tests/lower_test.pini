[lower_test|import]
_ir = "../../ir"
_module_loader = "../../module-loader"
_semantics = "../../semantics"

; 降载判据：单个源文件即可验证函数表、语句体与缺口纪律，不装配全工作区。
; 全工作区的端到端降载归吞吐批次；这里钉入口形状、节点计数与「不许静默吞体」。

; 单文件世界：装一个文件、注册一个包、解析类型；不依赖其他包。
单文件世界|func(relative: String,) -> (MemberWorld,):
    let abs = 工作区根() + "/" + relative
    let loaded: UnitLoad = loadUnitFile(absPath = abs, unitPath = relative)
    assert(!loaded.failed, "单文件应装载成功")
    var units: Array<CompilationUnit> = [loaded.unit]
    var pkg = PackageUnits()
    pkg.name = "support"
    pkg.rootPath = "packages/support"
    pkg.units = units
    var packages: Array<PackageUnits> = [pkg]
    let table: SymbolTable = registerPackages(packages)
    let types: TypeTable = resolvePackage(units = units, table = table)
    return makeMemberWorld(units = units, table = table, types = types)

; 样例源码：覆盖无标注声明、二元、分支、循环与返回；不含字符串与浮点。
样例源码|func() -> (String,):
    return "累积|func(a: I32, b: I32,) -> (I32,):\n    var total = a + b\n    if total > 0:\n        total = total - 1\n    while total > 0:\n        total = total - 1\n    return total\n"

; 样例模块：样例源码走同一条文本降载，判据只关心样例本身。
样例模块|func() -> (IrModule,):
    return 文本模块(样例源码())

; 文本模块：从文本建单元，单包注册解析，填表后降载。
文本模块|func(_src: String,) -> (IrModule,):
    let loaded: UnitLoad = loadUnit(path = "sample.pini", text = _src)
    assert(!loaded.failed, "样例应装载成功")
    assert(len(loaded.unit.diagnostics) == 0, "样例不应有语法诊断")
    var units: Array<CompilationUnit> = [loaded.unit]
    var pkg = PackageUnits()
    pkg.name = "sample"
    pkg.rootPath = "sample"
    pkg.units = units
    var packages: Array<PackageUnits> = [pkg]
    let table: SymbolTable = registerPackages(packages)
    let types: TypeTable = resolvePackage(units = units, table = table)
    let world = makeMemberWorld(units = units, table = table, types = types)
    let 填 = fillExprTypes(world = world, units = units)
    var 世界 = world
    var 类型面 = 世界.types
    类型面.pool = 填.pool
    世界.types = 类型面
    var input = LowerWorld()
    input.world = 世界
    input.types = 填.types
    return lowerWorkspace(input = input)

; 函数表：一个文件的顶层函数按声明序进表，名字保留原始拼写。
函数表按声明序|test() -> ():
    var input = LowerWorld()
    input.world = 单文件世界(relative = "packages/support/src/api/offsets.pini")
    let module = lowerWorkspace(input = input)
    assert(len(module.functions) == 2, "该文件应降出两个函数")
    assert(module.functions[0].name == "nonNegativeWidth", "首个函数应为 nonNegativeWidth")
    assert(module.functions[1].name == "advance", "次个函数应为 advance")
    return

; 参数与返回类型：类型下标指向 IR 池，槽位由函数帧播种给出。
参数与返回类型|test() -> ():
    var input = LowerWorld()
    input.world = 单文件世界(relative = "packages/support/src/api/offsets.pini")
    let module = lowerWorkspace(input = input)
    let fn: IrFunction = module.functions[1]
    assert(len(fn.params) == 2, "advance 应有两个参数")
    let first: IrParam = fn.params[0]
    assert(first.slot >= 0, "首个参数槽位应非负")
    assert(first.typeId >= 0, "首个参数类型应已映射")
    assert(irTypeText(pool = module.types, id = first.typeId) == "i32", "偏移参数应为 i32")
    assert(fn.returnType >= 0, "返回类型应为非空")
    return

; 语句体：样例整体降成，零缺口，四条顶层语句。
语句体可降|test() -> ():
    let module = 样例模块()
    assert(len(module.errors) == 0, "样例不应有缺口")
    assert(len(module.functions) == 1, "样例应有一个函数")
    assert(len(module.functions[0].body) == 4, "顶层应降出四条语句")
    return

; 节点计数：类别分布钉住体展开与次序，多一个少一个都会红。
节点计数|test() -> ():
    let module = 样例模块()
    assert(countNodes(module = module, kind = tagOfName(name = "allocVar")) == 1, "一次声明")
    assert(countNodes(module = module, kind = tagOfName(name = "storeVar")) == 2, "两处赋值")
    assert(countNodes(module = module, kind = tagOfName(name = "ifStmt")) == 1, "一条分支")
    assert(countNodes(module = module, kind = tagOfName(name = "whileStmt")) == 1, "一条循环")
    assert(countNodes(module = module, kind = tagOfName(name = "returnStmt")) == 1, "一条返回")
    assert(countNodes(module = module, kind = tagOfName(name = "load")) == 7, "七处读取")
    assert(countNodes(module = module, kind = tagOfName(name = "binary")) == 5, "五处二元")
    assert(countNodes(module = module, kind = tagOfName(name = "intConst")) == 4, "四个字面量")
    assert(len(module.nodes.nodes) == 22, "总节点数应为 22")
    return

; 名字与体边界：声明的名字进文本池，分支与循环的体边界落在 tail 上。
体边界|test() -> ():
    let module = 样例模块()
    let body = module.functions[0].body
    let 首: IrNode = module.nodes.nodes[body[0]]
    assert(textAt(module = module, id = 首.text) == "total", "首个节点应是声明 total")
    assert(首.op == 1, "var 声明记为可变")
    let 分支: IrNode = module.nodes.nodes[body[1]]
    assert(分支.tail == 2, "分支体只含一条语句，边界应为 2")
    let 循环: IrNode = module.nodes.nodes[body[2]]
    assert(循环.tail == 2, "循环体只含一条语句，边界应为 2")
    return

; 缺口纪律：降不了的构造逐函数各报一条缺口且体留空；少一条即静默吞体。
缺口逐函数|test() -> ():
    let 源 = "带文本|func() -> (I32,):\n    let s = \"文本\"\n    return 0\n\n正常|func() -> (I32,):\n    return 1\n"
    let module = 文本模块(源)
    assert(len(module.functions) == 2, "两个函数都应在表里")
    assert(len(module.errors) == 1, "只有用到未降载构造的那个应报缺口")
    assert(emptyBodyCount(module = module) == 1, "报缺口的函数体应留空")
    assert(len(module.errors[0].detail) > 0, "缺口应写清原因")
    return
