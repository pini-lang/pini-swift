[mod_test|import]
_package = "../../package"

; 模块工具组的纯判据：替换形态、清单改写与锁文件往返。
; 求解、抓取与摘要比对的落盘面由门禁的端到端段承担。

; 替换形态：三种前缀各归一类，fork 的 @ 后为版本销。
替换形态|test() -> ():
    let 本地 = parseReplacement(造替换声明(name = "a", spec = "file:../fork"))
    assert(isReplaceKind(本地.kind, .replaceLocal), "本地目录")
    assert(本地.text == "../fork", "本地路径")
    let 销 = parseReplacement(造替换声明(name = "b", spec = "github:acme/fork@v2.0"))
    assert(isReplaceKind(销.kind, .replaceFork), "fork")
    assert(销.text == "github:acme/fork", "fork 源")
    assert(销.pin == "2.0", "销剥 v 前缀")
    let 覆盖 = parseReplacement(造替换声明(name = "c", spec = "v1.5"))
    assert(isReplaceKind(覆盖.kind, .replaceVersion), "版本覆盖")
    assert(覆盖.text == "1.5", "版本剥 v 前缀")
    let 无销 = parseReplacement(造替换声明(name = "d", spec = "git:https://host/r.git"))
    assert(isReplaceKind(无销.kind, .replaceFork) && len(无销.pin) == 0, "URL 里的冒号不当版本分隔")

; 造一条替换声明：用例只关心名字与原文。
造替换声明|func(name: String, spec: String,) -> (ReplaceDecl,):
    var out = ReplaceDecl()
    out.name = name
    out.spec = spec
    return out

; 清单改写：require 段在文末按名字重排，其余段落与空行原样保留。
清单改写|test() -> ():
    let 原文 = "[package]\nname = \"app\"\n\n[require]\nalpha = \"^1.0\"\n\n[lib]\nname = \"app\"\nentry = \"src/api/app.pini\"\n"
    var 甲 = TidyEntry()
    甲.name = "alpha"
    甲.constraint = "^1.0"
    var 乙 = TidyEntry()
    乙.name = "beta"
    var 条目: Array<TidyEntry> = [甲, 乙]
    let 改写 = tidyManifestText(原文, 条目)
    let 期望 = "[package]\nname = \"app\"\n\n[lib]\nname = \"app\"\nentry = \"src/api/app.pini\"\n\n[require]\nalpha = \"^1.0\"\nbeta = \"*\"\n"
    assert(改写 == 期望, "改写结果：" + 改写)

; 具名 tap 子表：按 tap 名分组排在平表之后，组内按名字排序。
分表改写|test() -> ():
    let 原文 = "[package]\nname = \"app\"\n\n[require.web]\nzeta = \"1.0\"\n"
    var 甲 = TidyEntry()
    甲.name = "gamma"
    甲.tap = "web"
    var 乙 = TidyEntry()
    乙.name = "alpha"
    var 条目: Array<TidyEntry> = [甲, 乙]
    let 改写 = tidyManifestText(原文, 条目)
    let 期望 = "[package]\nname = \"app\"\n\n[require]\nalpha = \"*\"\n\n[require.web]\ngamma = \"*\"\n"
    assert(改写 == 期望, "改写结果：" + 改写)

; 锁文件：渲染与解析对成，字段逐个回得来。
锁文件往返|test() -> ():
    var 模块 = ResolvedModule()
    模块.name = "alpha"
    模块.version = "1.2.0"
    模块.tapName = "default"
    模块.source = "file:vendor"
    模块.commit = "-"
    模块.manifestSum = "sha256:aa"
    模块.sum = "sha256:bb"
    模块.path = "deps/alpha"
    模块.importedBy = ["<root>"]
    var 结果 = Resolution()
    结果.modules = 结果.modules.append(模块)
    结果.graphOrder = ["alpha"]
    let 文本 = renderSummary(resolution = 结果, toolchain = "pini 0.56.0 (spec 0.1)", generated = "2026-01-01T00:00:00Z")
    let 读回 = parseSummaryText(文本)
    assert(len(读回.modules) == 1, "一行模块")
    assert(读回.modules[0].name == "alpha", "名字")
    assert(读回.modules[0].importedBy[0] == "<root>", "引入者")
    assert(读回.graphOrder[0] == "alpha", "拓扑序")
    assert(读回.toolchain == "pini 0.56.0 (spec 0.1)", "工具链串")
    assert(读回.modules[0].commit == "-", "未抓取的 commit")
