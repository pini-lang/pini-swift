[digest|import]
_package = "../../../package"
_module_loader = "../../../module-loader"

; 构建身份：源码摘要、输入指纹与复用判定；缓存只认内容摘要，不看文件时间戳。
; 发射身份写进指纹：后端、目标或分区形态变了就升 emitProfile，旧产物随之判失效。

; 发射身份：分区发射的形态名；改后端、目标或分区规则时同步升它。
emitProfile|func() -> (String,):
    return "llvm-native-partition/1"

; 排序：字节序插入排序，输入顺序不影响结果。
sortDigestParts|func(parts: Array<String>,) -> (Array<String>,):
    var out = parts
    var i = 1
    while i < len(out):
        let value = out[i]
        var j = i - 1
        while j >= 0 && comparePlanText(a = out[j], b = value) > 0:
            out[j + 1] = out[j]
            j = j - 1
        out[j + 1] = value
        i = i + 1
    return out

; 源码摘要：逐单元读源码，拼「路径=文件摘要」一行，按路径排序后整串再取摘要。
; 外部通道（`<stdlib>`）与读不到的文件不进摘要：它们不是包源码。
packageSourceDigestOf|func(units: Array<CompilationUnit>, root: String,) -> (String,):
    var parts: Array<String> = []
    var i = 0
    while i < len(units):
        let path = units[i].path
        if path != stdlibUnitPath():
            let abs = root + "/" + path
            if exists(abs):
                parts = parts.append(path + "=" + sha256Hex(readFile(abs)))
        i = i + 1
    let sorted = sortDigestParts(parts = parts)
    var text = ""
    i = 0
    while i < len(sorted):
        text = text + sorted[i] + "\n"
        i = i + 1
    return sha256Hex(text)

; 输入指纹：本包源码摘要、发射身份与依赖接口摘要三者合一；任一变化都换指纹。
packageInputDigest|func(source: String, deps: Array<InterfaceDep>,) -> (String,):
    return sha256Hex("source=" + source + "\nprofile=" + emitProfile() + "\ndeps=" + depsText(deps = deps))

; 产物复用：记录里有指纹与摘要、指纹与当前一致、产物文本没被改过，三条都满足才复用。
artifactReusable|func(recordedInput: String, recordedHash: String, currentInput: String, artifactText: String,) -> (Bool,):
    if len(recordedInput) == 0 || len(recordedHash) == 0:
        return false
    if recordedInput != currentInput:
        return false
    return sha256Hex(artifactText) == recordedHash

; 接口复用：记录里有源码摘要、源码与依赖摘要都没变、快照摘要与记录一致，才跳过接口重算。
interfaceReusable|func(recorded: InterfaceEntry, source: String, deps: Array<InterfaceDep>, artifactText: String,) -> (Bool,):
    if len(recorded.source) == 0 || len(recorded.hash) == 0:
        return false
    if recorded.source != source:
        return false
    if depsText(deps = recorded.deps) != depsText(deps = deps):
        return false
    return sha256Hex(artifactText) == recorded.hash

; 按包名取单元表：未命中答空表；包序与计划一致。
packageUnitsOf|func(_ws: WorkspaceUnits, name: String,) -> (Array<CompilationUnit>,):
    var out: Array<CompilationUnit> = []
    var i = 0
    while i < len(_ws.packages):
        if _ws.packages[i].name == name:
            var u = 0
            while u < len(_ws.packages[i].units):
                out = out.append(_ws.packages[i].units[u])
                u = u + 1
        i = i + 1
    return out
