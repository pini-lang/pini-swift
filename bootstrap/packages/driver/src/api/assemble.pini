[assemble|import]
_package = "../../../package"
_module_loader = "../../../module-loader"
_semantics = "../../../semantics"
_ir = "../../../ir"

; 装配链：规划、装载、世界、填表、形态与槽、降载、校验；检查、降载、转储、发射与测试共用。
; 单独成文件：测试目标不带可执行入口，链放在入口文件里会让测试读不到它。
; 规划失败时包数为零，调用方据此直接返回，不往下发半份产物。

; 降载产物：模块、结构校验、包数、已定型表达式数与装载单元；单元供产物缓存算源码摘要。
(降载产物)
module: IrModule = IrModule()
check: IrValidation = IrValidation()
packages: I32 = 0
typed: I32 = 0
units: WorkspaceUnits = WorkspaceUnits()

; 装配并降载：一条链走到底，诊断只打规划错误；结构违约由调用方读 check。
; 入口由 loadEntry 收口：目录走包图，单文件走单文件通道，二者共用这一次降载。
降载工作区|func(root: String, stdlib: StdlibOption,) -> (降载产物,):
    var out = 降载产物()
    let entry = loadEntry(root = root, stdlib = stdlib)
    if len(entry.plan.errors) > 0 || !entry.ok:
        print("workspace-plan-failed", len(entry.plan.errors) + len(entry.units.errors))
        return out
    out.units = entry.units
    out.packages = entry.packages
    let ws = entry.units
    let units = collectWorkspaceUnits(ws)
    let unitPackages = unitPackagesOf(ws = ws, units = units)
    let build = buildWorld(units = units, packages = ws.packages)
    let 填 = fillExprTypes(world = build.world, units = units)
    let 泛 = instantiateGenerics(world = build.world, units = units, fill = 填)
    var 世界 = build.world
    var 类型面 = 世界.types
    类型面.pool = 泛.pool
    世界.types = 类型面
    世界 = attachTypeInstances(world = 世界)
    var input = LowerWorld()
    input.world = 世界
    input.types = 泛.types
    input.generics = 泛
    input.macros = macroRows(items = ws.macros)
    input.unitPackages = unitPackages
    let shapes = makeShapeTable(世界)
    input.shapes = shapes
    input.layouts = layoutAll(shapes = shapes, pool = 世界.types.pool)
    out.module = lowerWorkspace(input = input)
    out.check = validateModule(module = out.module)
    out.typed = typedExprCount(table = 填.types)
    return out

; 分段降载：按 stage 逐段加深，只服务性能定位；读数进标准输出，产物不完整。
; 默认路径不走它：降载工作区 仍一次走完全链，两处共用同一批函数与同一次序。
降载工作区至|func(root: String, stage: I32, stdlib: StdlibOption,) -> (降载产物,):
    var out = 降载产物()
    let entry = loadEntry(root = root, stdlib = stdlib)
    if len(entry.plan.errors) > 0 || !entry.ok:
        print("workspace-plan-failed", len(entry.plan.errors) + len(entry.units.errors))
        return out
    out.packages = entry.packages
    let ws = entry.units
    out.units = ws
    let units = collectWorkspaceUnits(ws)
    let unitPackages = unitPackagesOf(ws = ws, units = units)
    print("stage-load", len(units))
    if stage <= 1:
        return out
    let table = registerPackages(ws.packages)
    print("stage-register", table.symbolCount())
    if stage <= 2:
        return out
    let 类型 = resolvePackage(units = units, table = table)
    print("stage-resolve", len(类型.pool.entries))
    if stage <= 3:
        return out
    let 世界 = makeMemberWorld(units = units, table = table, types = 类型)
    print("stage-world", len(世界.units))
    if stage <= 4:
        return out
    let 填 = fillExprTypes(world = 世界, units = units)
    print("stage-fill", typedExprCount(table = 填.types))
    if stage <= 5:
        return out
    let 泛 = instantiateGenerics(world = 世界, units = units, fill = 填)
    var 带池 = 世界
    var 类型面 = 带池.types
    类型面.pool = 泛.pool
    带池.types = 类型面
    带池 = attachTypeInstances(world = 带池)
    let shapes = makeShapeTable(带池)
    let layouts = layoutAll(shapes = shapes, pool = 带池.types.pool)
    print("stage-shapes", len(带池.types.pool.entries))
    if stage <= 6:
        return out
    var input = LowerWorld()
    input.world = 带池
    input.types = 泛.types
    input.generics = 泛
    input.macros = macroRows(items = ws.macros)
    input.unitPackages = unitPackages
    input.shapes = shapes
    input.layouts = layouts
    out.module = lowerWorkspace(input = input)
    print("stage-lower", len(out.module.functions))
    if stage <= 7:
        return out
    out.check = validateModule(module = out.module)
    out.typed = typedExprCount(table = 填.types)
    return out

; 定型读数：全工作区已定型的表达式槽数；分母是表达式池总长，两者相减即未定槽。
; 这条读数只用于比对推理面改动前后的覆盖面，不参与任何判定。
typedExprCount|func(table: ExprTypes,) -> (I32,):
    var total = 0
    var u = 0
    while u < len(table.units):
        total = total + validCount(table = table, unit = u)
        u = u + 1
    return total

; 计划宏转 IR 宏：值文本原样带过去，声明类型留在世界里，降载点按表达式类型出常量。
; 包名一并带过去：同名宏在降载与诊断两侧都按包归属取，不会跨包串值。
macroRows|func(items: Array<PlanMacro>,) -> (Array<IrMacro>,):
    var out: Array<IrMacro> = []
    var i = 0
    while i < len(items):
        var one = IrMacro()
        one.package = items[i].package
        one.name = items[i].name
        one.resolved = items[i].state == "value"
        one.value = items[i].value
        one.reason = items[i].reason
        one.detail = items[i].detail
        out = out.append(one)
        i = i + 1
    return out
