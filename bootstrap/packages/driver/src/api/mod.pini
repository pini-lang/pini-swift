    if head.code != 0:
        out.ok = false
        out.failure = "git rev-parse HEAD 失败（" + _dir + "）：" + stripTrailingNewline(text = head.stderrText)
        return out
    out.commit = stripTrailingNewline(text = head.stdoutText)
