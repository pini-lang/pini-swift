checkoutTag|func(_dir: String, _version: String,) -> (Materialize,):
    var out = Materialize()
    let withV = gitRun(["-C", _dir, "rev-parse", "--verify", "--quiet", "refs/tags/v" + _version])
    if withV.code == 0:
        let done = gitRun(["-C", _dir, "checkout", "--quiet", "refs/tags/v" + _version])
        if done.code != 0:
            out.ok = false
            out.failure = "git checkout v" + _version + " 失败：" + stripTrailingNewline(text = done.stderrText)
        return out
    let plain = gitRun(["-C", _dir, "rev-parse", "--verify", "--quiet", "refs/tags/" + _version])
    if plain.code == 0:
        let done = gitRun(["-C", _dir, "checkout", "--quiet", "refs/tags/" + _version])
        if done.code != 0:
            out.ok = false
            out.failure = "git checkout " + _version + " 失败：" + stripTrailingNewline(text = done.stderrText)
        return out
    out.ok = false
    out.failure = "源 '" + _dir + "' 上找不到版本 " + _version + " 对应的 tag"
    return out

; 首抓：只看当时已知的约束；已选过的不再抓，交给约束齐全后的复核。
ensureMaterialized|func(_name: String, _spec: String, _dir: String, _constraints: Array<String>, _session: FetchSession,) -> (FetchState,):
    var out = FetchState()
    out.session = _session
    if startsWith(text = _spec, prefix = "file:"):
        return out
    if sessionIndexOf(out.session, _name) >= 0:
        return out
    let list = availableVersionsFor(_name, _spec)
    if !list.ok:
        out.ok = false
        out.failure = list.failure
        return out
    var picked = ""
    if len(list.items) > 0:
        let pick = selectVersion(candidates = list.items, constraints = _constraints)
        if !pick.ok:
            out.ok = false
            out.failure = "依赖 '" + _name + "' 可用版本 " + joinWith(list.items, ", ") + " 不满足约束：" + joinWith(_constraints, "；")
            return out
        picked = pick.version
    let done = materializeTap(_name, _spec, picked, _dir)
    if !done.ok:
        out.ok = false
        out.failure = done.failure
        return out
    out.session = recordSession(out.session, _name, picked, done.commit, expandTap(_spec, _name).display)
    return out

; 复核：约束齐全后按完整约束集重选一次；选择未变即不动，变了才抓。
reconcileSelection|func(_name: String, _spec: String, _dir: String, _constraints: Array<String>, _session: FetchSession,) -> (FetchState,):
    var out = FetchState()
    out.session = _session
    if startsWith(text = _spec, prefix = "file:"):
        return out
    let list = availableVersionsFor(_name, _spec)
    if !list.ok:
        out.ok = false
        out.failure = list.failure
        return out
    if len(list.items) == 0:
        return out
    let pick = selectVersion(candidates = list.items, constraints = _constraints)
    if !pick.ok:
        out.ok = false
        out.failure = "依赖 '" + _name + "' 可用版本 " + joinWith(list.items, ", ") + " 不满足约束：" + joinWith(_constraints, "；")
        return out
    let at = sessionIndexOf(out.session, _name)
    if at >= 0 && out.session.versions[at] == pick.version:
        return out
    let done = materializeTap(_name, _spec, pick.version, _dir)
    if !done.ok:
        out.ok = false
        out.failure = done.failure
        return out
    out.session = recordSession(out.session, _name, pick.version, done.commit, expandTap(_spec, _name).display)
    return out

; 模块工具命令：tidy 对齐集合、refresh 写锁文件、verify 比校验和、graph 出依赖树。
; 求解与抓取在上一段；这一段只管读盘、改写与文本，退出码一律由断言落地。

; 单元装载结局：单元与失败原因。
(UnitLoadOutcome)
units: Array<CompilationUnit> = []
ok: Bool = true
failure: String = ""

; 装载整目录：不按 target 切，与宿主 `loadDirectory` 同范围；清单错误先拦下。
loadModuleUnits|func(_root: String,) -> (UnitLoadOutcome,):
    var out = UnitLoadOutcome()
    let path = _root + "/pini.toml"
    let parse = parsePackageManifest(text = readFile(path), rootPath = ".", path = path)
    let plan = planFromPackage(entry = _root, parse = parse)
    if !plan.isOK():
        out.ok = false
        out.failure = planText(plan)
        return out
    let set = collectDirectory(packageAbs = _root, packageRel = ".", excludes = plan.packages[0].excludes)
    var i = 0
    while i < len(set.files):
        let loaded = loadUnitFile(absPath = set.files[i].absPath, unitPath = set.files[i].unitPath)
        if loaded.failed:
            out.ok = false
            out.failure = loaded.error.path + "：" + loadErrorName(loaded.error.kind)
            return out
        out.units = out.units.append(loaded.unit)
        i = i + 1
    return out

; 一次 import 的事实：别名、目标模块名、目标目录与所在文件。
(ImportFact)
alias: String = ""
depName: String = ""
targetDir: String = ""
sourceFile: String = ""

; 导入扫描结局：事实表与失败原因。
(ImportScan)
facts: Array<ImportFact> = []
ok: Bool = true
failure: String = ""

; 收集导入：按文件位置折叠路径，读目标清单取模块名；同名依赖只留一条。
; 目标根没有 pini.toml 即报错——那类数据应写进 [resources]，不该被 import。
collectImportFacts|func(_units: Array<CompilationUnit>, _root: String,) -> (ImportScan,):
    var out = ImportScan()
    var i = 0
    while i < len(_units):
        let unit = _units[i]
        let refs = listUnitImports(unit)
        var k = 0
        while k < len(refs):
            let target = normalizeImport(unitPath = unit.path, target = refs[k].path)
            let dir = _root + "/" + target
            let path = dir + "/pini.toml"
            if !exists(path):
                out.ok = false
                out.failure = unit.path + "：import 目标 '" + refs[k].path + "' 的根缺 pini.toml——不是 Pini 模块，" + "不可 import（R7 双向强制）；若是语料/数据等资源，请改写到 [resources]"
                return out
            let parse = parseModuleManifest(text = readFile(path), path = path)
            if len(parse.errors) > 0:
                out.ok = false
                out.failure = manifestErrorText(parse.errors[0])
                return out
            if !hasFact(out.facts, parse.manifest.name):
                var fact = ImportFact()
                fact.alias = refs[k].alias
                fact.depName = parse.manifest.name
                fact.targetDir = dir
                fact.sourceFile = unit.path
                out.facts = out.facts.append(fact)
            k = k + 1
        i = i + 1
    return out

; 已收进来过的依赖名。
hasFact|func(_facts: Array<ImportFact>, _name: String,) -> (Bool,):
    var i = 0
    while i < len(_facts):
        if _facts[i].depName == _name:
            return true
        i = i + 1
    return false

; 依赖名去重升序：tidy 的新增表按它排。
factNames|func(_facts: Array<ImportFact>,) -> (Array<String>,):
    var out: Array<String> = []
    var i = 0
    while i < len(_facts):
        out = insertText(out, _facts[i].depName)
        i = i + 1
    return out

; 一条 require 条目：名字、约束与所属 tap（平表记空串）。
(TidyEntry)
name: String = ""
constraint: String = "*"
tap: String = ""

; tidy 结果：增删名单、保留条数与是否落盘。
(TidyOutcome)
ok: Bool = true
failure: String = ""
added: Array<String> = []
removed: Array<String> = []
kept: I32 = 0
wrote: Bool = false

; tidy：让 [require] 的集合与代码 import 一致；新增条目约束写 `*`，既有约束与 tap 位置原样保留。
tidyModule|func(_root: String,) -> (TidyOutcome,):
    var out = TidyOutcome()
    let path = _root + "/pini.toml"
    let parse = parseModuleManifest(text = readFile(path), path = path)
    if len(parse.errors) > 0:
        out.ok = false
        out.failure = manifestErrorText(parse.errors[0])
        return out
    let load = loadModuleUnits(_root)
    if !load.ok:
        out.ok = false
        out.failure = load.failure
        return out
    let scan = collectImportFacts(load.units, _root)
    if !scan.ok:
        out.ok = false
        out.failure = scan.failure
        return out
    let desired = factNames(scan.facts)
    let existing = tidyEntries(parse.manifest)
    var added: Array<String> = []
    var removed: Array<String> = []
    var i = 0
    while i < len(desired):
        if findTidyEntry(existing, desired[i]) < 0:
            added = added.append(desired[i])
        i = i + 1
    var k = 0
    while k < len(existing):
        if !modHasText(desired, existing[k].name):
            removed = removed.append(existing[k].name)
        k = k + 1
    out.added = added
    out.removed = removed
    out.kept = len(existing) - len(removed)
    if len(added) == 0 && len(removed) == 0:
        return out
    var next: Array<TidyEntry> = []
    var e = 0
    while e < len(existing):
        if !modHasText(removed, existing[e].name):
            next = next.append(existing[e])
        e = e + 1
    var a = 0
    while a < len(added):
        var entry = TidyEntry()
        entry.name = added[a]
        next = next.append(entry)
        a = a + 1
    let updated = tidyManifestText(readFile(path), next)
    writeFile(path, updated)
    out.wrote = true
    return out

; 既有条目：平表在前、具名子表按解析顺序在后。
tidyEntries|func(_manifest: PackageManifest,) -> (Array<TidyEntry>,):
    var out: Array<TidyEntry> = []
    var i = 0
    while i < len(_manifest.dependencies):
        var entry = TidyEntry()
        entry.name = _manifest.dependencies[i].name
        entry.constraint = _manifest.dependencies[i].constraint
        entry.tap = _manifest.dependencies[i].tap
        out = out.append(entry)
        i = i + 1
    return out

; 条目定位：线性查，require 只有几条。
findTidyEntry|func(_items: Array<TidyEntry>, _name: String,) -> (I32,):
    var i = 0
    while i < len(_items):
        if _items[i].name == _name:
            return i
        i = i + 1
    return -1

; 改写 require 区段：整个区段重写后按名字排在文末，其余区段的文本一字不动。
tidyManifestText|func(_text: String, _entries: Array<TidyEntry>,) -> (String,):
    let lines = splitKeepingEmpty(_text)
    var kept: Array<String> = []
    var i = 0
    while i < len(lines):
        let trimmed = trimSpace(lines[i])
        if trimmed == "[require]" || startsWith(text = trimmed, prefix = "[require."):
            i = i + 1
            while i < len(lines):
                if startsWith(text = trimSpace(lines[i]), prefix = "["):
                    break
                i = i + 1
        else:
            kept = kept.append(lines[i])
            i = i + 1
    var tail = kept
    if len(_entries) > 0 && len(tail) > 0 && len(tail[len(tail) - 1]) > 0:
        tail = tail.append("")
    var plain: Array<String> = []
    var p = 0
    while p < len(_entries):
        if len(_entries[p].tap) == 0:
            plain = insertText(plain, _entries[p].name + " = \"" + _entries[p].constraint + "\"")
        p = p + 1
    if len(plain) > 0:
        tail = tail.append("[require]")
        var q = 0
        while q < len(plain):
            tail = tail.append(plain[q])
            q = q + 1
        tail = tail.append("")
    let taps = entryTaps(_entries)
    var t = 0
    while t < len(taps):
        tail = tail.append("[require." + taps[t] + "]")
        var rows: Array<String> = []
        var r = 0
        while r < len(_entries):
            if _entries[r].tap == taps[t]:
                rows = insertText(rows, _entries[r].name + " = \"" + _entries[r].constraint + "\"")
            r = r + 1
        var m = 0
        while m < len(rows):
            tail = tail.append(rows[m])
            m = m + 1
        tail = tail.append("")
        t = t + 1
    while len(tail) > 1 && tail[len(tail) - 1] == "" && tail[len(tail) - 2] == "":
        tail = takeLines(tail, len(tail) - 1)
    return joinWith(tail, "\n")

; 按换行切且保留空段：清单里的空行是排版，丢了会把整段挤在一起。
; `split` 会略去空子串，改写清单不能用它。
splitKeepingEmpty|func(_text: String,) -> (Array<String>,):
    var out: Array<String> = []
    var start = 0
    var i = 0
    while i < len(_text):
        if ord(_text[i]) == 10:
            out = out.append(_text.substring(start, i))
            start = i + 1
        i = i + 1
    out = out.append(_text.substring(start, len(_text)))
    return out

; 具名 tap 名单：去重升序。
entryTaps|func(_entries: Array<TidyEntry>,) -> (Array<String>,):
    var out: Array<String> = []
    var i = 0
    while i < len(_entries):
        if len(_entries[i].tap) > 0:
            out = insertText(out, _entries[i].tap)
        i = i + 1
    return out

; 取前 n 行：数组没有删除原语，重建一段。
takeLines|func(_items: Array<String>, _count: I32,) -> (Array<String>,):
    var out: Array<String> = []
    var i = 0
    while i < _count && i < len(_items):
        out = out.append(_items[i])
        i = i + 1
    return out

; refresh：写锁文件；工具链串与时间戳由调用方给，抓取在这里发生。
runModRefresh|func(_root: String,) -> ():
    let stamp = runProcess(argv = ["/bin/date", "-u", "+%Y-%m-%dT%H:%M:%SZ"], keepOutput = true)
    let toolchain = "pini " + piniVersion() + " (spec 0.1)"
    let report = refreshSummary(root = _root, toolchain = toolchain, generated = stripTrailingNewline(text = stamp.stdoutText))
    if !report.ok:
        print("Error: " + report.failure)
        assert(false, "模块求解失败")
        return
    print("refresh：pini-summary.toml 已生成（\(report.lines) 行）。须提交进版本库（G52 R3）")
    return

; verify：只读比对；不符逐条列出，任一不符即非零退出。
runModVerify|func(_root: String,) -> ():
    let report = verifySummary(_root)
    if len(report.mismatches) == 0:
        print("verify：\(report.checked) 项校验和全部匹配")
        return
    print("verify：发现 \(len(report.mismatches)) 处不符：")
    var i = 0
    while i < len(report.mismatches):
        print(" - " + report.mismatches[i])
        i = i + 1
    assert(false, "校验和不符")
    return

; 依赖树的一支：先打本行，再按名字升序下降；connector 只在深度大于零时出现。
graphLines|func(_modules: Array<ResolvedModule>, _name: String, _prefix: String, _isLast: Bool, _depth: I32,) -> (Array<String>,):
    var out: Array<String> = []
    var connector = ""
    if _depth > 0:
        if _isLast:
            connector = "└─ "
        else:
            connector = "├─ "
    out = out.append(_prefix + connector + _name + moduleVersion(_modules, _name))
    let children = childrenOf(_modules, _name)
    var i = 0
    while i < len(children):
        var childPrefix = ""
        if _depth > 0:
            if _isLast:
                childPrefix = _prefix + "   "
            else:
                childPrefix = _prefix + "│  "
        let sub = graphLines(_modules, children[i], childPrefix, i == len(children) - 1, _depth + 1)
        var s = 0
        while s < len(sub):
            out = out.append(sub[s])
            s = s + 1
        i = i + 1
    return out

; 谁直接引入它：去重升序。
childrenOf|func(_modules: Array<ResolvedModule>, _name: String,) -> (Array<String>,):
    var out: Array<String> = []
    var i = 0
    while i < len(_modules):
        var k = 0
        while k < len(_modules[i].importedBy):
            if _modules[i].importedBy[k] == _name:
                out = insertText(out, _modules[i].name)
            k = k + 1
        i = i + 1
    return out

; 版本后缀：前缀留一个空格，未知版本不留。
moduleVersion|func(_modules: Array<ResolvedModule>, _name: String,) -> (String,):
    var i = 0
    while i < len(_modules):
        if _modules[i].name == _name:
            return " " + _modules[i].version
        i = i + 1
    return ""

; graph：默认出树与环形摘要；`--cycles` 只答环。环在求解期就被拦下，故成功解析即无环。
runModGraph|func(_root: String, _manifest: PackageManifest, _cycles: Bool,) -> ():
    let resolution = resolveModule(root = _root, fetching = false)
    if !resolution.ok:
        print("Error: " + resolution.failure)
        assert(false, "依赖解析失败")
        return
    if _cycles:
        print("无环（require 图为 DAG）")
        return
    var roots: Array<String> = []
    var i = 0
    while i < len(resolution.modules):
        var k = 0
        while k < len(resolution.modules[i].importedBy):
            if resolution.modules[i].importedBy[k] == "<root>":
                roots = insertText(roots, resolution.modules[i].name)
            k = k + 1
        i = i + 1
    if len(roots) == 0:
        print("（无依赖）")
    else:
        var r = 0
        while r < len(roots):
            let lines = graphLines(resolution.modules, roots[r], "", r == len(roots) - 1, 0)
            var l = 0
            while l < len(lines):
                print(lines[l])
                l = l + 1
            r = r + 1
    print("---")
    print("环：无")
    return

; 模块根定位：从进程目录向上找第一份清单，最多八层；找不到答空串。
locateModuleRoot|func() -> (String,):
    var prefix = "."
    var depth = 0
    while depth < 8:
        if exists(prefix + "/pini.toml"):
            return prefix
        prefix = prefix + "/.."
        depth = depth + 1
    return ""

; 入口：`mod` 后第一段是子命令，`--cycles` 只对 graph 有意义，其余位置参数当模块根。
runMod|func(_args: Array<String>,) -> ():
    if len(_args) < 2:
        print("用法: pini mod {tidy|refresh|verify|graph} [--cycles] [模块根]")
        assert(false, "缺子命令")
        return
    let sub = _args[1]
    var cycles = false
    var rootArg = ""
    var i = 2
    while i < len(_args):
        if _args[i] == "--cycles":
            cycles = true
        elif !startsWith(text = _args[i], prefix = "--"):
            rootArg = _args[i]
        i = i + 1
    var root = ""
    if len(rootArg) > 0:
        root = entryPathOf(raw = rootArg)
    else:
        root = locateModuleRoot()
        if len(root) == 0:
            print("Error: 不属于任何模块（向上未找到清单）；请在模块内运行或显式指定模块根")
            assert(false, "缺模块根")
            return
    let path = root + "/pini.toml"
    if !exists(path):
        print("Error: " + root + " 不含 pini.toml")
        assert(false, "模块根缺清单")
        return
    let parse = parseModuleManifest(text = readFile(path), path = path)
    if len(parse.errors) > 0:
        print("Error: " + manifestErrorText(parse.errors[0]))
        assert(false, "清单不可用")
        return
    if sub == "tidy":
        let report = tidyModule(root)
        if !report.ok:
            print("Error: " + report.failure)
            assert(false, "tidy 未完成")
            return
        if !report.wrote:
            print("tidy：[require] 已与 import 对齐（\(report.kept) 条），无改动")
            return
        if len(report.added) > 0:
            print("tidy：新增 " + joinWith(report.added, ", ") + "（约束 *，由 refresh 回填）")
        if len(report.removed) > 0:
            print("tidy：移除 " + joinWith(report.removed, ", ") + "（代码中已无 import）")
        print("tidy：保留 \(report.kept) 条既有约束。下一步：pini mod refresh")
        return
    if sub == "refresh":
        runModRefresh(root)
        return
    if sub == "verify":
        runModVerify(root)
        return
    if sub == "graph":
        runModGraph(root, parse.manifest, cycles)
        return
    print("用法: pini mod {tidy|refresh|verify|graph} [--cycles] [模块根]")
    assert(false, "未知子命令")
    return
