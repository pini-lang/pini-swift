        return out
    if source.scheme == "file":
        return out
    let run = gitRun(["-C", ".", "ls-remote", "--tags", source.url])
    if run.code != 0:
        out.ok = false
        out.failure = "git ls-remote --tags " + source.url + " 失败（退出码 \(run.code)）：" + stripTrailingNewline(text = run.stderrText)
        return out
