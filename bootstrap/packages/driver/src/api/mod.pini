        out.failure = source.failure
        return out
    if source.scheme == "file":
        out.ok = false
        out.failure = "file: 源 '" + source.url + "' 不由 refresh 落地：依赖用 git submodule 或手工拷贝，" + "本地替换用 [replace] 的 file: 形态"
