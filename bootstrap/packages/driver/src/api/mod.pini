[mod|import]
_package = "../../../package"
_module_loader = "../../../module-loader"
_semantics = "../../../semantics"
_hostproc = "../../../hostproc"

; 模块工具链：依赖求解、MVS 选择、内容摘要与锁文件读写；抓取只在 refresh 通道发生。
; 失败一律答 ok=false 与一句可直接打印的原因：不抛不吞，调用方决定退出码与文案。
; 摘要与宿主同口径：相对路径、分隔符 0x00、文件字节依次入 SHA-256，条目按路径升序。

; 已解析模块：锁文件的一行；路径相对模块根，sum 是唯一校验凭证。
(ResolvedModule)
name: String = ""
version: String = ""
tapName: String = ""
source: String = ""
commit: String = "-"
manifestSum: String = ""
sum: String = ""
path: String = ""
importedBy: Array<String> = []

; 已解析资源：同模块行，但没有 manifest_sum，也不参与 MVS。
(ResolvedResource)
name: String = ""
version: String = ""
tapName: String = ""
source: String = ""
commit: String = "-"
sum: String = ""
path: String = ""

; 求解结果：失败时三张表为空，failure 是那一句原因。
(Resolution)
modules: Array<ResolvedModule> = []
resources: Array<ResolvedResource> = []
graphOrder: Array<String> = []
ok: Bool = true
failure: String = ""

; 一次遍历的结果：解析结果与跨轮保留的抓取会话并列。
(ResolvePass)
resolution: Resolution = Resolution()
session: FetchSession = FetchSession()

; 抓取会话：已选版本、commit 与源；changed 是本轮是否发生过重新选择。
(FetchSession)
names: Array<String> = []
versions: Array<String> = []
commits: Array<String> = []
sources: Array<String> = []
changed: Bool = false

; 抓取一步的结局：会话、成败与说明。
(FetchState)
session: FetchSession = FetchSession()
ok: Bool = true
failure: String = ""

; 依赖状态：求解期的工作副本，名字与落点之外带着读回的清单。
(ModuleState)
name: String = ""
version: String = ""
dir: String = ""
manifest: PackageManifest = PackageManifest()

; 源的归属：名字、展开前的 spec、tap 与最先提出它的引入者。
(SourceChoice)
name: String = ""
spec: String = ""
tap: String = ""
requirer: String = ""

; 待处理边：依赖名、引入者、约束、展开前的源与所记的 tap。
(PendingEdge)
name: String = ""
from: String = ""
constraint: String = "*"
spec: String = ""
tap: String = ""

; 约束账本一条：依赖名、约束原文与提出者。
(ConstraintEntry)
name: String = ""
raw: String = "*"
requirer: String = ""

; 依赖图一条边：引入者 → 被引入者。
(GraphEdge)
from: String = ""
to: String = ""

; 替换形态：版本覆盖、本地目录、换 fork 源。
[ReplaceKind]
replaceVersion
replaceLocal
replaceFork

; 替换声明：形态、展开后的文本与 fork 的版本销。
(Replacement)
name: String = ""
kind: ReplaceKind = .replaceVersion
text: String = ""
pin: String = ""

; 摘要条目：相对路径与文件字节。
(SumEntry)
rel: String = ""
data: Array<U8> = []

; 锁文件模块行。
(SummaryModule)
name: String = ""
version: String = ""
sum: String = ""
manifestSum: String = ""
path: String = ""
importedBy: Array<String> = []
commit: String = "-"
tapName: String = ""
source: String = ""

; 锁文件资源行。
(SummaryResource)
name: String = ""
version: String = ""
sum: String = ""
path: String = ""
commit: String = "-"
tapName: String = ""
source: String = ""

; 锁文件：构建信息、模块行、资源行与拓扑序。
(SummaryDoc)
toolchain: String = ""
generated: String = ""
modules: Array<SummaryModule> = []
resources: Array<SummaryResource> = []
graphOrder: Array<String> = []

; 校验结果：比对项数与逐条不符说明。
(VerifyReport)
checked: I32 = 0
mismatches: Array<String> = []

; refresh 结果：成败、生成行数与说明。
(RefreshReport)
ok: Bool = true
failure: String = ""
lines: I32 = 0

; 入队结果：边表与失败原因；缺 tap 声明时整批不成立。
(EnqueueResult)
items: Array<PendingEdge> = []
ok: Bool = true
failure: String = ""

; 候选版本：升序由选择器自己排，这里只要求去重。
(VersionList)
items: Array<String> = []
ok: Bool = true
failure: String = ""

; tap 源：展开后的协议、URL 与写进锁文件的展示串。
(TapSource)
ok: Bool = false
scheme: String = ""
url: String = ""
display: String = ""
failure: String = ""

; 落地结局：检出后的 HEAD commit 只在成功时有意义。
(Materialize)
ok: Bool = true
failure: String = ""
commit: String = ""

; 拓扑序结果：失败时给一条环路径。
(TopoOrder)
order: Array<String> = []
ok: Bool = true
failure: String = ""

; 资源结局：已解析资源与失败原因。
(ResourceOutcome)
items: Array<ResolvedResource> = []
ok: Bool = true
failure: String = ""

; 校验：逐项比 sum 与 manifest_sum，不符的带来源说明。
verifySummary|func(_root: String,) -> (VerifyReport,):
    var out = VerifyReport()
    let path = _root + "/pini-summary.toml"
    if !exists(path):
        out.mismatches = out.mismatches.append("pini-summary.toml 不存在：请先运行 pini mod refresh")
        return out
    let doc = parseSummaryText(readFile(path))
    var i = 0
    while i < len(doc.modules):
        let one = doc.modules[i]
        let dir = absolutePath(_root, one.path)
        if sha256Tree(dir) != stripShaPrefix(one.sum):
            out.mismatches = out.mismatches.append("模块 '" + one.name + "' 内容与锁文件不符（" + one.path + "）——可能被篡改或过期" + originSuffix(one.source))
        if sha256OfFile(dir + "/pini.toml") != stripShaPrefix(one.manifestSum):
            out.mismatches = out.mismatches.append("模块 '" + one.name + "' 的 pini.toml 与锁文件不符（" + one.path + "）")
        i = i + 1
    var r = 0
    while r < len(doc.resources):
        let one = doc.resources[r]
        let dir = absolutePath(_root, one.path)
        if sha256Tree(dir) != stripShaPrefix(one.sum):
            out.mismatches = out.mismatches.append("资源 '" + one.name + "' 内容与锁文件不符（" + one.path + "）" + originSuffix(one.source))
        r = r + 1
    out.checked = len(doc.modules) + len(doc.resources)
    return out

; 报错里回显来源：篡改时要知道去哪里核对。
originSuffix|func(_source: String,) -> (String,):
    if len(_source) == 0:
        return ""
    return "；来源 " + _source

; refresh：先求解再拼文本落盘；fetching 通道会抓取远程 tap，失败答 ok=false。
refreshSummary|func(root: String, toolchain: String, generated: String,) -> (RefreshReport,):
    var out = RefreshReport()
    let resolution = resolveModule(root = root, fetching = true)
    if !resolution.ok:
        out.ok = false
        out.failure = resolution.failure
        return out
    let text = renderSummary(resolution = resolution, toolchain = toolchain, generated = generated)
    writeFile(root + "/pini-summary.toml", text)
    out.lines = countLines(text)
    return out

; 行数：按换行计数再加末行，与宿主按分隔符切分的读法一致。
countLines|func(_text: String,) -> (I32,):
    var lines = 1
    var i = 0
    while i < len(_text):
        if ord(_text[i]) == 10:
            lines = lines + 1
        i = i + 1
    return lines

; 求解：反复走一遍遍历，直到某轮不再发生重新选择；超过八轮即报不收敛。
resolveModule|func(root: String, fetching: Bool,) -> (Resolution,):
    var session = FetchSession()
    var attempt = 0
    while attempt < 8:
        session.changed = false
        let walk = resolveOnce(root = root, fetching = fetching, session = session)
        session = walk.session
        if !walk.resolution.ok:
            return walk.resolution
        if !session.changed:
            return walk.resolution
        attempt = attempt + 1
    var out = Resolution()
    out.ok = false
    out.failure = "版本求解在 8 轮迭代内未收敛：依赖的约束随其版本变化，可能构成互相抬升的约束环。请钉住其中一方的版本（[replace] 或精确约束）后重试"
    return out

; 一轮遍历：边入账、按需抓取、读依赖清单、约束复核、摘要与拓扑序。
; 已读过的依赖不再重读，但每条后到的边仍会入账——多引入者的约束与 imported-by 都靠这一步。
resolveOnce|func(root: String, fetching: Bool, session: FetchSession,) -> (ResolvePass,):
    var out = ResolvePass()
    out.session = session
    let rootPath = root + "/pini.toml"
    if !exists(rootPath):
        return failResolve(result = out, reason = "缺少清单 " + rootPath)
    let rootParse = parseModuleManifest(text = readFile(rootPath), path = rootPath)
    if len(rootParse.errors) > 0:
        return failResolve(result = out, reason = manifestErrorText(rootParse.errors[0]))
    var pending: Array<PendingEdge> = []
    let seeded = enqueueRequires(items = pending, manifest = rootParse.manifest, from = "<root>")
    if !seeded.ok:
        return failResolve(result = out, reason = seeded.failure)
    pending = seeded.items
    let replacements = collectReplacements(rootParse.manifest)
    var constraints = seedReplaceConstraints(replacements)
    var sources: Array<SourceChoice> = []
    var states: Array<ModuleState> = []
    var edges: Array<GraphEdge> = []
    var cursor = 0
    while cursor < len(pending):
        let edge = pending[cursor]
        cursor = cursor + 1
        constraints = constraints.append(makeConstraintEntry(edge.name, edge.constraint, edge.from))
        edges = edges.append(makeGraphEdge(edge.from, edge.name))
        var dir = root + "/deps/" + edge.name
        var spec = edge.spec
        var tap = edge.tap
        let repAt = replacementAt(replacements, edge.name)
        if repAt >= 0:
            let rep = replacements[repAt]
            if isReplaceKind(rep.kind, .replaceLocal):
                let localDir = absolutePath(root, rep.text)
                if !exists(localDir + "/pini.toml"):
                    return failResolve(result = out, reason = "[replace] '" + edge.name + "' 指向的本地路径不存在：" + localDir)
                dir = localDir
                spec = "file:" + localDir
                tap = "replace"
            elif isReplaceKind(rep.kind, .replaceFork):
                spec = rep.text
                tap = "replace"
        sources = recordSource(sources, edge.name, spec, tap, edge.from)
        if fetching && !startsWith(text = spec, prefix = "file:"):
            let fetched = ensureMaterialized(edge.name, spec, dir, constraintsOf(constraints, edge.name), out.session)
            out.session = fetched.session
            if !fetched.ok:
                return failResolve(result = out, reason = fetched.failure)
        if stateIndex(states, edge.name) >= 0:
            continue
        let depPath = dir + "/pini.toml"
        if !exists(depPath):
            return failResolve(result = out, reason = missingDependencyReason(edge, spec, tap, depPath))
        let depParse = parseModuleManifest(text = readFile(depPath), path = depPath)
        if len(depParse.errors) > 0:
            return failResolve(result = out, reason = manifestErrorText(depParse.errors[0]))
        var state = ModuleState()
        state.name = edge.name
        state.version = depParse.manifest.version
        if len(state.version) == 0:
            state.version = "0"
        state.dir = dir
        state.manifest = depParse.manifest
        states = states.append(state)
        let more = enqueueRequires(items = pending, manifest = depParse.manifest, from = edge.name)
        if !more.ok:
            return failResolve(result = out, reason = more.failure)
        pending = more.items
    if fetching:
        var r = 0
        while r < len(states):
            let name = states[r].name
            let at = sourceChoiceAt(sources, name)
            let spec = sources[at].spec
            if !startsWith(text = spec, prefix = "file:"):
                let rec = reconcileSelection(name, spec, states[r].dir, constraintsOf(constraints, name), out.session)
                out.session = rec.session
                if !rec.ok:
                    return failResolve(result = out, reason = rec.failure)
            r = r + 1
    let unsatisfied = unsatisfiedSelections(states, constraints, out.session.changed)
    if len(unsatisfied) > 0:
        return failResolve(result = out, reason = unsatisfied[0])
    let topo = topologicalOrder(edges)
    if !topo.ok:
        return failResolve(result = out, reason = topo.failure)
    var modules: Array<ResolvedModule> = []
    var i = 0
    while i < len(states):
        modules = modules.append(makeResolvedModule(root, states[i], sources, edges, out.session))
        i = i + 1
    let resources = resolveResources(root, rootParse.manifest, fetching)
    if !resources.ok:
        return failResolve(result = out, reason = resources.failure)
    out.resolution.modules = modules
    out.resolution.resources = resources.items
    out.resolution.graphOrder = topo.order
    return out

; 失败：解析结果置 ok=false，会话原样带回。
failResolve|func(result: ResolvePass, reason: String,) -> (ResolvePass,):
    var out = result
    out.resolution = Resolution()
    out.resolution.ok = false
    out.resolution.failure = reason
    return out

; 落地缺失的说明：远程源归因于抓取未发生，file: 源归因于手工缺失。
missingDependencyReason|func(_edge: PendingEdge, _spec: String, _tap: String, _depPath: String,) -> (String,):
    if !startsWith(text = _spec, prefix = "file:"):
        return "依赖 '" + _edge.name + "' 来自远程 _tap '" + _tap + "'，但 deps/" + _edge.name + "/ 尚未落地。抓取只发生在 `pini mod refresh`；其余命令（含 graph）只读已落地的依赖"
    return "依赖 '" + _edge.name + "'（由 " + _edge.from + " require）未落地：缺少 " + _depPath + "。file: 通道的依赖请用 git submodule 或手工拷贝落到 deps/" + _edge.name + "/"

; 依赖入队：tap 名缺省为 default，清单里没有该 tap 即整批失败。
enqueueRequires|func(items: Array<PendingEdge>, manifest: PackageManifest, from: String,) -> (EnqueueResult,):
    var out = EnqueueResult()
    out.items = items
    var i = 0
    while i < len(manifest.dependencies):
        let dep = manifest.dependencies[i]
        let tapName = depTapName(dep)
        let at = findTap(manifest.taps, tapName)
        if at < 0:
            out.ok = false
            out.failure = "依赖 '" + dep.name + "' 未指定 tap，且清单缺 [tap] " + tapName + "（G52 D11：org 须显式书写）"
            return out
        var edge = PendingEdge()
        edge.name = dep.name
        edge.from = from
        edge.constraint = dep.constraint
        edge.spec = manifest.taps[at].spec
        edge.tap = tapName
        out.items = out.items.append(edge)
        i = i + 1
    return out

; 依赖所属 tap：平表依赖归 default。
depTapName|func(_dep: Dependency,) -> (String,):
    if len(_dep.tap) == 0:
        return "default"
    return _dep.tap

; 替换收集：只认主模块的 [replace]；依赖清单里的替换不参与。
collectReplacements|func(_manifest: PackageManifest,) -> (Array<Replacement>,):
    var out: Array<Replacement> = []
    var i = 0
    while i < len(_manifest.replaces):
        out = out.append(parseReplacement(_manifest.replaces[i]))
        i = i + 1
    return out

; 替换原文分三形态：file: 换本地、github:/git: 换 fork、其余按版本覆盖。
parseReplacement|func(_decl: ReplaceDecl,) -> (Replacement,):
    var out = Replacement()
    out.name = _decl.name
    let text = trimSpace(_decl.spec)
    if startsWith(text = text, prefix = "file:"):
        out.kind = .replaceLocal
        out.text = expandNameToken(text.substring(5, len(text)), _decl.name)
        return out
    if startsWith(text = text, prefix = "github:") || startsWith(text = text, prefix = "git:"):
        out.kind = .replaceFork
        let at = lastIndexChar(text, 64)
        if at > 0:
            let pin = text.substring(at + 1, len(text))
            if len(pin) > 0 && pin.indexOf("/") < 0 && pin.indexOf(":") < 0:
                out.text = text.substring(0, at)
                out.pin = stripVersionPrefix(pin)
                return out
        out.text = text
        return out
    out.kind = .replaceVersion
    out.text = stripVersionPrefix(text)
    return out

; 替换定位：线性查够用。
replacementAt|func(_items: Array<Replacement>, _name: String,) -> (I32,):
    var i = 0
    while i < len(_items):
        if _items[i].name == _name:
            return i
        i = i + 1
    return -1

; 版本类替换预先入账：requirer 记为 `<replace>`，与普通约束同路合成。
seedReplaceConstraints|func(_items: Array<Replacement>,) -> (Array<ConstraintEntry>,):
    var out: Array<ConstraintEntry> = []
    var i = 0
    while i < len(_items):
        let rep = _items[i]
        if isReplaceKind(rep.kind, .replaceVersion):
            out = out.append(makeConstraintEntry(rep.name, rep.text, "<replace>"))
        elif isReplaceKind(rep.kind, .replaceFork) && len(rep.pin) > 0:
            out = out.append(makeConstraintEntry(rep.name, rep.pin, "<replace>"))
        i = i + 1
    return out

; 形态名：枚举相等比较不可用，按名称比。
replaceKindName|func(_kind: ReplaceKind,) -> (String,):
    match _kind:
        case replaceVersion:
            return "version"
        case replaceLocal:
            return "local"
        case replaceFork:
            return "fork"
    return "version"

; 同形态判定。
isReplaceKind|func(_kind: ReplaceKind, _expected: ReplaceKind,) -> (Bool,):
    return replaceKindName(_kind) == replaceKindName(_expected)

; 约束账本一条。
makeConstraintEntry|func(_name: String, _raw: String, _requirer: String,) -> (ConstraintEntry,):
    var out = ConstraintEntry()
    out.name = _name
    out.raw = _raw
    out.requirer = _requirer
    return out

; 图的一条边。
makeGraphEdge|func(_from: String, _to: String,) -> (GraphEdge,):
    var out = GraphEdge()
    out.from = _from
    out.to = _to
    return out

; 记录源：同一依赖多个引入者时，字典序最小者胜出——与遍历顺序无关，锁文件因此可复现。
recordSource|func(_items: Array<SourceChoice>, _name: String, _spec: String, _tap: String, _from: String,) -> (Array<SourceChoice>,):
    var out = _items
    var i = 0
    while i < len(out):
        if out[i].name == _name:
            if _from < out[i].requirer:
                out[i].requirer = _from
                out[i].spec = _spec
                out[i].tap = _tap
            return out
        i = i + 1
    var choice = SourceChoice()
    choice.name = _name
    choice.spec = _spec
    choice.tap = _tap
    choice.requirer = _from
    return out.append(choice)

; 源定位：线性查。
sourceChoiceAt|func(_items: Array<SourceChoice>, _name: String,) -> (I32,):
    var i = 0
    while i < len(_items):
        if _items[i].name == _name:
            return i
        i = i + 1
    return -1

; 状态定位：同一次遍历里每个依赖只读一次清单。
stateIndex|func(_items: Array<ModuleState>, _name: String,) -> (I32,):
    var i = 0
    while i < len(_items):
        if _items[i].name == _name:
            return i
        i = i + 1
    return -1

; 某依赖的全部约束原文。
constraintsOf|func(_entries: Array<ConstraintEntry>, _name: String,) -> (Array<String>,):
    var out: Array<String> = []
    var i = 0
    while i < len(_entries):
        if _entries[i].name == _name:
            out = out.append(_entries[i].raw)
        i = i + 1
    return out

; 相对模块根的绝对路径：以斜杠开头视为已是绝对路径。
absolutePath|func(_root: String, _path: String,) -> (String,):
    if startsWith(text = _path, prefix = "/"):
        return _path
    return _root + "/" + _path

; 落点写进锁文件时取相对形式；不在模块根下则原样保留。
relativePath|func(_root: String, _dir: String,) -> (String,):
    if !startsWith(text = _dir, prefix = _root + "/"):
        return _dir
    return _dir.substring(len(_root) + 1, len(_dir))

; 相对路径拼接：父为空取子。
joinRelText|func(_parent: String, _child: String,) -> (String,):
    if len(_parent) == 0:
        return _child
    return _parent + "/" + _child

; 未满足的约束：一轮里只要发生过重新选择就交给下一轮，不据此判不可满足。
unsatisfiedSelections|func(_states: Array<ModuleState>, _constraints: Array<ConstraintEntry>, _changed: Bool,) -> (Array<String>,):
    var out: Array<String> = []
    if _changed:
        return out
    var i = 0
    while i < len(_states):
        let name = _states[i].name
        let parts = versionParts(_states[i].version)
        var conflicts: Array<String> = []
        var c = 0
        while c < len(_constraints):
            if _constraints[c].name == name:
                let parsed = parseConstraint(_constraints[c].raw)
                if !parsed.ok || !constraintSatisfies(parsed, parts):
                    conflicts = conflicts.append(_constraints[c].requirer + " 要求 " + _constraints[c].raw)
            c = c + 1
        if len(conflicts) > 0:
            out = out.append("依赖 '" + name + "' 可用版本 " + _states[i].version + " 不满足约束：" + joinWith(conflicts, "；"))
        i = i + 1
    return out

; 文本连接：分隔符只加在条目之间。
joinWith|func(_items: Array<String>, _separator: String,) -> (String,):
    var out = ""
    var i = 0
    while i < len(_items):
        if i > 0:
            out = out + _separator
        out = out + _items[i]
        i = i + 1
    return out

; 拓扑序：反复摘掉没有出边的结点（依赖先出），剩下的边即成环。
topologicalOrder|func(_edges: Array<GraphEdge>,) -> (TopoOrder,):
    var out = TopoOrder()
    let nodes = graphNodes(_edges)
    var remaining = _edges
    var order: Array<String> = []
    var progress = true
    while progress && len(remaining) > 0:
        progress = false
        var i = 0
        while i < len(nodes):
            let node = nodes[i]
            if !modHasText(order, node) && !hasOutgoing(remaining, node):
                order = order.append(node)
                remaining = dropEdgesInto(remaining, node)
                progress = true
            i = i + 1
    if len(remaining) > 0:
        out.ok = false
