            return out
    else:
        let cloned = gitRun(["clone", "--quiet", source.url, _dir])
        if cloned.code != 0:
            out.ok = false
            out.failure = "git clone " + source.url + " 失败：" + stripTrailingNewline(text = cloned.stderrText)
            return out
    if len(_version) > 0:
        let tagged = checkoutTag(_dir, _version)
        if !tagged.ok:
            out.ok = false
            out.failure = tagged.failure
