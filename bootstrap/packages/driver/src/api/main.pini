[main|import]
_package = "../../../package"
_module_loader = "../../../module-loader"
_semantics = "../../../semantics"
_ir = "../../../ir"
_backend_kit = "../../../backend-kit"
_backend_dump = "../../../backend-dump"
_backend_llvm = "../../../backend-llvm"
_testkit = "../../../testkit"

; 驱动主程序：无参数只装配清单并打印产物行；各子命令的根取位置参数，缺省从模块根上溯。
; check 跑完整检查，build 落构建计划，plan 打印计划，lower 走降载，dump 出结构转储，emit 出 LLVM 文本。
; cases 只列裸名用例位置；降载前先填表达式类型表并把池换成填表后的池。
main|func() -> ():
    let args = argv()
    var root = workspaceRootOf(start = moduleRoot())
    var 全量 = false
    var 结构化 = false
    var 降载 = false
    var 分段 = 0
    var 转储 = false
    var 发射 = false
    if len(args) > 0 && args[0] == "check":
        全量 = true
        var c = 1
        while c < len(args):
            let a: String = args[c]
            if a == "--diagnostics-tsv":
                结构化 = true
            else:
                root = a
            c = c + 1
    if len(args) > 0 && args[0] == "lower":
        降载 = true
        if len(args) > 1:
            root = args[1]
        if len(args) > 2 && args[2].indexOf("--stage=") == 0:
            let 位数 = args[2].slice(8, len(args[2]))
            if len(位数) > 0:
                分段 = ord(位数[0]) - 48
    if len(args) > 0 && args[0] == "dump":
        转储 = true
        if len(args) > 1:
            root = args[1]
    if len(args) > 0 && args[0] == "emit":
        发射 = true
        if len(args) > 1:
            root = args[1]
    if len(args) > 0 && args[0] == "test":
        var testRoot = workspaceRootOf(start = moduleRoot())
        var testFilter = ""
        var testSkips: Array<String> = []
        var testListOnly = false
        var cursor = 1
        while cursor < len(args):
            let arg: String = args[cursor]
            if arg == "--filter" && cursor + 1 < len(args):
                testFilter = args[cursor + 1]
                cursor = cursor + 2
            elif arg.indexOf("--filter=") == 0:
                testFilter = arg.slice(9, len(arg))
                cursor = cursor + 1
            elif arg == "--skip" && cursor + 1 < len(args):
                testSkips = testSkips.append(args[cursor + 1])
                cursor = cursor + 2
            elif arg.indexOf("--skip=") == 0:
                testSkips = testSkips.append(arg.slice(7, len(arg)))
                cursor = cursor + 1
            elif arg == "--list":
                testListOnly = true
                cursor = cursor + 1
            else:
                testRoot = arg
                cursor = cursor + 1
        runTest(root = testRoot, filter = testFilter, skips = testSkips, listOnly = testListOnly)
        return
    if len(args) > 0 && args[0] == "cases":
        if len(args) > 1:
            root = args[1]
        let plan = planWorkspace(root)
        if !plan.isOK():
            print("workspace-plan-failed", plan.errorCount())
            return
        let ws = loadWorkspaceGrouped(plan)
        let units = collectWorkspaceUnits(ws)
        let build = buildWorld(units = units, packages = ws.packages)
        printBareCases(units = units, world = build.world)
        return
    if len(args) > 0 && args[0] == "build":
        if len(args) > 1:
            root = args[1]
        runBuild(root = root)
        return
    if len(args) > 0 && args[0] == "plan":
        if len(args) > 1:
            root = args[1]
        print(planText(planWorkspace(root)))
        return
    if 全量:
        let report = checkWorkspace(root = root)
        if 结构化:
            if len(report.tsv) > 0:
                print(report.tsv)
        elif len(report.text) > 0:
            print(report.text)
        if report.errorCount > 0 || report.exitCode != 0:
            print("workspace-check-failed", report.errorCount)
            assert(false, "工作区检查未通过")
            return
        print("workspace-ok", report.packages, true)
        return
    if 降载:
        var 产物 = 降载产物()
        if 分段 > 0:
            产物 = 降载工作区至(root = root, stage = 分段)
            ; 分段读数只出到所指阶段：未走完的链不给全量读数，免得被当成通过。
            if 分段 < 8:
                return
        else:
            产物 = 降载工作区(root = root)
        if 产物.packages == 0:
            return
        let module = 产物.module
        print("types-ok", 产物.typed)
        print("lower-ok", len(module.functions), len(module.errors), emptyBodyCount(module = module), len(module.typeErrors))
        print("surface-ok", declCount(table = module.decls), slotRowCount(table = module.slots))
        print("validate-ok", 产物.check.visited, len(产物.check.errors))
        var v = 0
        while v < len(产物.check.errors):
            let one = 产物.check.errors[v]
            print("结构违约", lowerErrorCode(one.kind), one.file, one.offset, one.detail)
            v = v + 1
        printGapSummary(module = module)
        printTypeErrors(module = module)
        return
    if 转储:
        let 产物 = 降载工作区(root = root)
        if 产物.packages == 0:
            return
        if len(产物.check.errors) > 0:
            print("dump-blocked", len(产物.check.errors))
            return
        let entry = makeBackendOf(name = "dump", outputCode = backendOutputDumpCode(), families = backendFamilyCodes(), entry = 1)
        let emitted = dumpModule(entry = entry, target = defaultTarget(), module = 产物.module)
        if emitted.failed:
            print("dump-failed", emitted.detail, emitGapCount(result = emitted))
            return
        print("dump-ok", 产物.packages, emitted.lines, len(emitted.text))
        print("dump-backend", entry.name, backendOutputName(entry.output), len(entry.families))
        print(emitted.text)
        return
    if 发射:
        let 产物 = 降载工作区(root = root)
        if 产物.packages == 0:
            return
        if len(产物.check.errors) > 0:
            print("emit-blocked", len(产物.check.errors))
            return
        let entry = makeBackendOf(name = "llvm", outputCode = backendOutputNativeCode(), families = llvmFamilies(), entry = 2)
        let emitted = emitModule(entry = entry, target = defaultTarget(), module = 产物.module)
        if emitted.failed:
            print("emit-gaps", emitGapCount(result = emitted), emitted.detail)
            var g = 0
            while g < len(emitted.gaps):
                print("缺口", emitted.gaps[g])
                g = g + 1
            return
        print("emit-ok", 产物.packages, emitted.lines, len(emitted.text))
        print("emit-backend", entry.name, backendOutputName(entry.output), len(entry.families))
        print(emitted.text)
        return
    let plan = planWorkspace(root)
    if plan.isOK():
        print("workspace-ok", plan.packageCount(), true)
        return
    print("workspace-plan-failed", plan.errorCount())
    var 故障 = 0
    while 故障 < len(plan.errors):
        print("计划错误", manifestErrorKindName(plan.errors[故障].kind), plan.errors[故障].path, plan.errors[故障].detail)
        故障 = 故障 + 1
    return

; 缺口归纳：按原因归并计数，函数名前缀不进归类；只打印前若干条，够看头号缺口。
; 次数降序，同数保持首次出现序 —— 不按字符串排序，两通道的串比较口径并不一致。
reasonIndex|func(reasons: Array<String>, text: String,) -> (I32,):
    var i = 0
    while i < len(reasons):
        if reasons[i] == text:
            return i
        i = i + 1
    return -1

; 类型缺口：建映射表时就判掉的类型，不绑函数，逐条打出，供能力表对照。
printTypeErrors|func(module: IrModule,) -> ():
    var i = 0
    while i < len(module.typeErrors):
        let one = module.typeErrors[i]
        print("类型缺口", lowerErrorName(one.kind), one.detail)
        i = i + 1

printGapSummary|func(module: IrModule,) -> ():
    var reasons: Array<String> = []
    var counts: Array<I32> = []
    var i = 0
    while i < len(module.errors):
        let detail = module.errors[i].detail
        var reason = detail
        let at = detail.indexOf("：")
        if at >= 0:
            reason = detail.slice(at + 1, len(detail))
        let found = reasonIndex(reasons = reasons, text = reason)
        if found >= 0:
            var grown = counts
            grown[found] = grown[found] + 1
            counts = grown
        else:
            reasons = reasons.append(reason)
            counts = counts.append(1)
        i = i + 1
    var order: Array<I32> = []
    i = 0
    while i < len(counts):
        order = order.append(i)
        i = i + 1
    var a = 0
    while a < len(order):
        var best = a
        var b = a + 1
        while b < len(order):
            if counts[order[b]] > counts[order[best]]:
                best = b
            b = b + 1
        if best != a:
            var swapped = order
            let keep: I32 = swapped[a]
            swapped[a] = swapped[best]
            swapped[best] = keep
            order = swapped
        a = a + 1
    var shown = 0
    i = 0
    while i < len(order) && shown < 15:
        var sample = ""
        var k = 0
        while k < len(module.errors):
            let one = module.errors[k]
            var reason = one.detail
            let at = one.detail.indexOf("：")
            if at >= 0:
                reason = one.detail.slice(at + 1, len(one.detail))
            if reason == reasons[order[i]] && len(sample) == 0:
                sample = one.file + ":" + countText(one.offset)
            k = k + 1
        print("缺口", counts[order[i]], reasons[order[i]], sample)
        shown = shown + 1
        i = i + 1
    return

; 裸名用例清单：逐单元扫表达式池，命中用例表又不在文件级可裸引用名面里的标识符即列出。
; 只扫不降载：降载缺口按函数首错报，一个函数里有多处裸名时拿不到完整清单。
printBareCases|func(units: Array<CompilationUnit>, world: MemberWorld,) -> ():
    var total = 0
    var files = 0
    var u = 0
    while u < len(units):
        let unit = units[u]
        let bytes = unitBytes(unit)
        let bare = unitBareNames(unit = unit)
        var hit = 0
        var i = 0
        while i < unit.ast.exprCount():
            if unit.ast.isIdentifierExpr(i):
                let node = unit.ast.exprAt(i)
                let name = decodeSpelling(bytes = bytes, start = node.nameStart, end = node.nameEnd)
                if caseCandidateCount(index = world.symbols, name = name) > 0 && !hasName(items = bare, value = name):
                    print("裸名用例", unit.path + ":" + countText(node.start) + ":" + name)
                    total = total + 1
                    hit = hit + 1
            i = i + 1
        if hit > 0:
            files = files + 1
        u = u + 1
    print("cases-ok", total, files)

; 执行期：补输入指纹、数缺头文件的步、落计划；自举侧不翻译，生成文本由宿主 bind 产出。
runBuild|func(root: String,) -> ():
    let plan = planWorkspace(root)
    if !plan.isOK():
        print("build-plan-failed", plan.errorCount())
        var i = 0
        while i < len(plan.errors):
            print("计划错误", manifestErrorKindName(plan.errors[i].kind), plan.errors[i].path, plan.errors[i].detail)
            i = i + 1
        assert(false, "构建计划未通过")
        return
    let filled = fillPlanHashes(plan = plan, root = root)
    var steps = 0
    var p = 0
    while p < len(filled.plan.packages):
        steps = steps + len(filled.plan.packages[p].steps)
        p = p + 1
    let path = planFilePath(root = root, profile = filled.plan.profile)
    let directory = root + "/.build/" + filled.plan.profile
    if !isDir(directory):
        print("build-failed", path, "缺构建目录", directory)
        assert(false, "构建计划未落盘")
        return
    writeFile(path, planFileText(filled.plan))
    print("build-ok", steps, filled.missing)
    return
