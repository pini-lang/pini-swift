[main|import]
_package = "../../../package"
_module_loader = "../../../module-loader"
_semantics = "../../../semantics"
_ir = "../../../ir"
_backend_kit = "../../../backend-kit"
_backend_dump = "../../../backend-dump"
_backend_llvm = "../../../backend-llvm"
_testkit = "../../../testkit"
_hostproc = "../../../hostproc"

; 驱动主程序：无参数只装配清单并打印产物行；子命令的根取位置参数，缺省从模块根上溯。
; check 跑完整检查，build 落构建计划，plan 打印计划，lower 走降载，dump 出结构转储，emit 出 LLVM 文本。
; cases 只列裸名用例位置；降载前先填表达式类型表并把池换成填表后的池；`--no-stdlib` 与 `--stdlib` 先摘出去。
main|func() -> ():
    var args: Array<String> = []
    var stdlib = StdlibOption()
    let raw = argv()
    var q = 0
    while q < len(raw):
        let one: String = raw[q]
        if one == "--no-stdlib":
            stdlib.enabled = false
            q = q + 1
        elif one == "--stdlib" && q + 1 < len(raw):
            stdlib.path = raw[q + 1]
            stdlib.enabled = true
            q = q + 2
        elif one.indexOf("--stdlib=") == 0:
            stdlib.path = one.slice(9, len(one))
            stdlib.enabled = true
            q = q + 1
        else:
            args = args.append(one)
            q = q + 1
    var root = workspaceRootOf(start = moduleRoot())
    var 全量 = false
    var 结构化 = false
    var 降载 = false
    var 分段 = 0
    var 转储 = false
    var 发射 = false
    var 分包 = false
    var 单包 = ""
    var 缓存目录 = ""
    var backendName = "llvm"
    var emitOutput = ""
    if len(args) > 0 && args[0] == "check":
        全量 = true
        var c = 1
        while c < len(args):
            let a: String = args[c]
            if a == "--diagnostics-tsv":
                结构化 = true
            else:
                root = entryPathOf(raw = a)
            c = c + 1
    if len(args) > 0 && args[0] == "lower":
        降载 = true
        if len(args) > 1:
            root = entryPathOf(raw = args[1])
        if len(args) > 2 && args[2].indexOf("--stage=") == 0:
            let 位数 = args[2].slice(8, len(args[2]))
            if len(位数) > 0:
                分段 = ord(位数[0]) - 48
    if len(args) > 0 && args[0] == "dump":
        转储 = true
        if len(args) > 1:
            root = entryPathOf(raw = args[1])
    if len(args) > 0 && args[0] == "emit":
        发射 = true
        var e = 1
        while e < len(args):
            let one: String = args[e]
            if one == "--packages":
                分包 = true
            elif len(one) > 10 && one.indexOf("--package=") == 0:
                单包 = one.slice(10, len(one))
            elif len(one) > 12 && one.indexOf("--cache-dir=") == 0:
                缓存目录 = one.slice(12, len(one))
            elif len(one) > 10 && one.indexOf("--backend=") == 0:
                backendName = one.slice(10, len(one))
            elif one == "--backend" && e + 1 < len(args):
                backendName = args[e + 1]
                e = e + 1
            elif one == "-o" && e + 1 < len(args):
                emitOutput = args[e + 1]
                e = e + 1
            else:
                root = entryPathOf(raw = one)
            e = e + 1
    if len(args) > 0 && args[0] == "test":
        let invocation = parseTestArgs(args = args, fallbackRoot = workspaceRootOf(start = moduleRoot()))
        runTest(root = invocation.root, filter = invocation.filter, skips = invocation.skips, listOnly = invocation.listOnly, stdlib = stdlib)
        return
    if len(args) > 0 && args[0] == "test-llvm":
        let invocation = parseTestArgs(args = args, fallbackRoot = workspaceRootOf(start = moduleRoot()))
        if invocation.listOnly:
            runTest(root = invocation.root, filter = invocation.filter, skips = invocation.skips, listOnly = true, stdlib = stdlib)
        else:
            runTestNative(root = invocation.root, filter = invocation.filter, skips = invocation.skips, stdlib = stdlib)
        return
    if len(args) > 0 && args[0] == "cases":
        if len(args) > 1:
            root = entryPathOf(raw = args[1])
        let plan = planEntry(root)
        if !plan.isOK():
            print("workspace-plan-failed", plan.errorCount())
            return
        let ws = loadWorkspaceGrouped(plan, stdlib = stdlib)
        let units = collectWorkspaceUnits(ws)
        let build = buildWorld(units = units, packages = ws.packages)
        printBareCases(units = units, world = build.world)
        return
    if len(args) > 0 && args[0] == "interfaces":
        var 读记录 = false
        var icursor = 1
        while icursor < len(args):
            let one: String = args[icursor]
            if one == "--read":
                读记录 = true
            else:
                root = entryPathOf(raw = one)
            icursor = icursor + 1
        if 读记录:
            printInterfaceLedger(root = root)
            return
        let done = writeInterfaces(root = root, stdlib = stdlib)
        if done.ok:
            print("interfaces-ok", done.packages, done.changed, done.reused)
        else:
            assert(false, "接口缓存未写入")
        return
    if len(args) > 0 && (args[0] == "version" || args[0] == "--version" || args[0] == "-v"):
        print("Pini " + piniVersion())
        return
    if len(args) > 0 && args[0] == "tokens":
        if len(args) < 2:
            print("Error: tokens command requires a file path")
            assert(false, "记号清单缺路径")
            return
        runTokens(path = entryPathOf(raw = args[1]))
        return
    if len(args) > 0 && args[0] == "fmt":
        var write = false
        var check = false
        var paths: Array<String> = []
        var c = 1
        while c < len(args):
            if args[c] == "-w" || args[c] == "--write":
                write = true
            elif args[c] == "--check":
                check = true
            else:
                paths = paths.append(entryPathOf(raw = args[c]))
            c = c + 1
        if len(paths) == 0:
            print("Error: fmt 需要至少一个路径")
            assert(false, "格式化缺路径")
            return
        runFmt(paths = paths, write = write, check = check)
        return
    if len(args) > 0 && args[0] == "expand":
        if len(args) != 2:
            print("Error: expand 要且只要一个 .pini 路径")
            assert(false, "展开参数不合规")
            return
        runExpand(path = entryPathOf(raw = args[1]))
        return
    if len(args) > 0 && args[0] == "parse":
        var target = ""
        var c = 1
        while c < len(args):
            if args[c] != "--sig":
                target = args[c]
            c = c + 1
        if len(target) == 0:
            print("Error: parse command requires a file path")
            assert(false, "结构签名缺路径")
            return
        runParse(path = entryPathOf(raw = target))
        return
    if len(args) > 0 && args[0] == "backends":
        var tsv = false
        var b = 1
        while b < len(args):
            if args[b] == "--tsv":
                tsv = true
            b = b + 1
        printBackendMatrix(tsv = tsv)
        return
    if len(args) > 0 && args[0] == "build":
        var showPlan = false
        var shared = false
        var outputPath = ""
        var structured = false
        var bc = 1
        while bc < len(args):
            let one: String = args[bc]
            if one == "--print-plan":
                showPlan = true
            elif one == "--shared":
                shared = true
            elif one == "--diagnostics-tsv":
                structured = true
            elif one == "-o" && bc + 1 < len(args):
                outputPath = args[bc + 1]
                bc = bc + 1
            else:
                root = entryPathOf(raw = one)
            bc = bc + 1
        if showPlan && shared:
            print("Error: --print-plan 只用于普通构建，不与 --shared 同用")
            assert(false, "开关互斥")
            return
        if shared:
            runBuildShared(path = root, outputPath = outputPath, stdlib = stdlib)
        elif showPlan:
            printBuildPlan(path = root)
        else:
            runBuild(root = root, stdlib = stdlib, structured = structured)
        return
    if len(args) > 0 && args[0] == "plan":
        var 分波 = false
        var pc = 1
        while pc < len(args):
            if args[pc] == "--waves":
                分波 = true
            else:
                root = entryPathOf(raw = args[pc])
            pc = pc + 1
        let planned = planEntry(root)
        if 分波:
            printPlanWaves(planned)
        else:
            print(planText(planned))
        return
    if 全量:
        let report = checkWorkspace(root = root, stdlib = stdlib)
        if 结构化:
            if len(report.tsv) > 0:
                print(report.tsv)
        elif len(report.text) > 0:
            print(report.text)
        if report.errorCount > 0 || report.exitCode != 0:
            print("workspace-check-failed", report.errorCount)
            assert(false, "工作区检查未通过")
            return
        print("workspace-ok", report.packages, true)
        return
    if 降载:
        var 产物 = 降载产物()
        if 分段 > 0:
            产物 = 降载工作区至(root = root, stage = 分段, stdlib = stdlib)
            ; 分段读数只出到所指阶段：未走完的链不给全量读数，免得被当成通过。
            if 分段 < 8:
                return
        else:
            产物 = 降载工作区(root = root, stdlib = stdlib)
        if 产物.packages == 0:
            return
        let module = 产物.module
        print("types-ok", 产物.typed)
        print("lower-ok", len(module.functions), len(module.errors), emptyBodyCount(module = module), len(module.typeErrors))
        print("surface-ok", declCount(table = module.decls), slotRowCount(table = module.slots))
        print("validate-ok", 产物.check.visited, len(产物.check.errors))
        var v = 0
        while v < len(产物.check.errors):
            let one = 产物.check.errors[v]
            print("结构违约", lowerErrorCode(one.kind), one.file, one.offset, one.detail)
            v = v + 1
        printGapSummary(module = module)
        printTypeErrors(module = module)
        return
    if 转储:
        let 产物 = 降载工作区(root = root, stdlib = stdlib)
        if 产物.packages == 0:
            return
        if len(产物.check.errors) > 0:
            print("dump-blocked", len(产物.check.errors))
            return
        let entry = makeBackendOf(name = "dump", outputCode = backendOutputDumpCode(), families = backendFamilyCodes(), entry = 1)
        let emitted = dumpModule(entry = entry, target = defaultTarget(), module = 产物.module)
        if emitted.failed:
            print("dump-failed", emitted.detail, emitGapCount(result = emitted))
            return
        print("dump-ok", 产物.packages, emitted.lines, len(emitted.text))
        print("dump-backend", entry.name, backendOutputName(entry.output), len(entry.families))
        print(emitted.text)
        return
    if 发射:
        if 分包:
            if len(emitOutput) > 0 || backendName != "llvm":
                print("Error: --packages 不与 -o / --backend 同用")
                assert(false, "开关互斥")
                return
            let written = writeArtifacts(root = root, stdlib = stdlib, onlyName = 单包, cacheDir = 缓存目录)
            if written.ok:
                print("emit-packages-ok", written.packages, written.emitted, written.reused, written.bytes)
            else:
                assert(false, "逐包产物未写成")
            return
        let 产物 = 降载工作区(root = root, stdlib = stdlib)
        if 产物.packages == 0:
            return
        if len(产物.check.errors) > 0:
            print("emit-blocked", len(产物.check.errors))
            return
        let entry = backendEntryFor(backendName)
        if len(entry.name) == 0:
            print("Error: unknown backend '" + backendName + "'. Available: llvm, dump")
            assert(false, "未知后端")
            return
        let emitted = emitByBackend(entry = entry, module = 产物.module)
        if emitted.failed:
            print("emit-gaps", emitGapCount(result = emitted), emitted.detail)
            var g = 0
            while g < len(emitted.gaps):
                print("缺口", emitted.gaps[g])
                g = g + 1
            return
        if len(emitOutput) > 0:
            writeFile(emitOutput, emitted.text)
            return
        print("emit-ok", 产物.packages, emitted.lines, len(emitted.text))
        print("emit-backend", entry.name, backendOutputName(entry.output), len(entry.families))
        print(emitted.text)
        return
    if len(args) > 0 && args[0] == "compile":
        var 编译路径 = ""
        var cc = 1
        while cc < len(args):
            编译路径 = args[cc]
            cc = cc + 1
        if len(编译路径) == 0:
            print("Error: compile command requires a file path")
            assert(false, "compile 缺路径")
            return
        runCompile(path = entryPathOf(raw = 编译路径), stdlib = stdlib)
        return
    if len(args) > 0 && args[0] == "run-llvm":
        var runPath = ""
        var rc = 1
        while rc < len(args):
            runPath = args[rc]
            rc = rc + 1
        if len(runPath) == 0:
            print("Error: run-llvm command requires a file path")
            assert(false, "run-llvm 缺路径")
            return
        runLLI(path = entryPathOf(raw = runPath), stdlib = stdlib)
        return
    if len(args) > 0 && args[0] == "mod":
        runMod(args)
        return
    if len(args) > 0 && !isKnownCommand(name = args[0]):
        print("Error: Unknown command '" + args[0] + "'")
        assert(false, "未知命令")
        return
    let plan = planEntry(root)
    if plan.isOK():
        print("workspace-ok", plan.packageCount(), true)
        return
    print("workspace-plan-failed", plan.errorCount())
    var 故障 = 0
    while 故障 < len(plan.errors):
        print("计划错误", manifestErrorKindName(plan.errors[故障].kind), plan.errors[故障].path, plan.errors[故障].detail)
        故障 = 故障 + 1
    return

; 缺口归纳：按原因归并计数，函数名前缀不进归类；只打印前若干条，够看头号缺口。
; 次数降序，同数保持首次出现序 —— 不按字符串排序，两通道的串比较口径并不一致。
reasonIndex|func(reasons: Array<String>, text: String,) -> (I32,):
    var i = 0
    while i < len(reasons):
        if reasons[i] == text:
            return i
        i = i + 1
    return -1

; 类型缺口：建映射表时就判掉的类型，不绑函数，逐条打出，供能力表对照。
printTypeErrors|func(module: IrModule,) -> ():
    var i = 0
    while i < len(module.typeErrors):
        let one = module.typeErrors[i]
        print("类型缺口", lowerErrorName(one.kind), one.detail)
        i = i + 1

printGapSummary|func(module: IrModule,) -> ():
    var reasons: Array<String> = []
    var counts: Array<I32> = []
    var i = 0
    while i < len(module.errors):
        let detail = module.errors[i].detail
        var reason = detail
        let at = detail.indexOf("：")
        if at >= 0:
            reason = detail.slice(at + 1, len(detail))
        let found = reasonIndex(reasons = reasons, text = reason)
        if found >= 0:
            var grown = counts
            grown[found] = grown[found] + 1
            counts = grown
        else:
            reasons = reasons.append(reason)
            counts = counts.append(1)
        i = i + 1
    var order: Array<I32> = []
    i = 0
    while i < len(counts):
        order = order.append(i)
        i = i + 1
    var a = 0
    while a < len(order):
        var best = a
        var b = a + 1
        while b < len(order):
            if counts[order[b]] > counts[order[best]]:
                best = b
            b = b + 1
        if best != a:
            var swapped = order
            let keep: I32 = swapped[a]
            swapped[a] = swapped[best]
            swapped[best] = keep
            order = swapped
        a = a + 1
    var shown = 0
    i = 0
    while i < len(order) && shown < 15:
        var sample = ""
        var k = 0
        while k < len(module.errors):
            let one = module.errors[k]
            var reason = one.detail
            let at = one.detail.indexOf("：")
            if at >= 0:
                reason = one.detail.slice(at + 1, len(one.detail))
            if reason == reasons[order[i]] && len(sample) == 0:
                sample = one.file + ":" + countText(one.offset)
            k = k + 1
        print("缺口", counts[order[i]], reasons[order[i]], sample)
        shown = shown + 1
        i = i + 1
    return

; 裸名用例清单：逐单元扫表达式池，命中用例表又不在文件级可裸引用名面里的标识符即列出。
; 只扫不降载：降载缺口按函数首错报，一个函数里有多处裸名时拿不到完整清单。
printBareCases|func(units: Array<CompilationUnit>, world: MemberWorld,) -> ():
    var total = 0
    var files = 0
    var u = 0
    while u < len(units):
        let unit = units[u]
        let bytes = unitBytes(unit)
        let bare = unitBareNames(unit = unit)
        var hit = 0
        var i = 0
        while i < unit.ast.exprCount():
            if unit.ast.isIdentifierExpr(i):
                let node = unit.ast.exprAt(i)
                let name = decodeSpelling(bytes = bytes, start = node.nameStart, end = node.nameEnd)
                if caseCandidateCount(index = world.symbols, name = name) > 0 && !hasName(items = bare, value = name):
                    print("裸名用例", unit.path + ":" + countText(node.start) + ":" + name)
                    total = total + 1
                    hit = hit + 1
            i = i + 1
        if hit > 0:
            files = files + 1
        u = u + 1
    print("cases-ok", total, files)

; 子命令白名单：未知首参不再落到默认装配，免得打错命令名时静默检查编译器自身模块根。
isKnownCommand|func(name: String,) -> (Bool,):
    if name == "check" || name == "lower" || name == "dump" || name == "emit":
        return true
    if name == "test" || name == "cases" || name == "interfaces" || name == "build":
        return true
    if name == "plan" || name == "version" || name == "--version" || name == "-v":
        return true
    if name == "tokens" || name == "backends" || name == "parse" || name == "fmt":
        return true
    if name == "expand":
        return true
    if name == "compile" || name == "run-llvm" || name == "test-llvm":
        return true
    if name == "mod":
        return true
    return false

; 执行期：补输入指纹、数缺头文件的步、落计划；自举侧不翻译，生成文本由宿主 bind 产出。
; 单文件入口与宿主同口径：只做检查、不落产物，输出与 `check` 那条腿一致。
; 结构化开关只改单文件那条腿的输出形态；计划面是纯数据，两种形态共用一份文本。
runBuild|func(root: String, stdlib: StdlibOption, structured: Bool,) -> ():
    if exists(root) && !isDir(root):
        let report = checkWorkspace(root = root, stdlib = stdlib)
        if structured:
            if len(report.tsv) > 0:
                print(report.tsv)
        elif len(report.text) > 0:
            print(report.text)
        if report.errorCount > 0 || report.exitCode != 0:
            print("workspace-check-failed", report.errorCount)
            assert(false, "工作区检查未通过")
            return
        print("workspace-ok", report.packages, true)
        return
    let plan = planEntry(root)
    if !plan.isOK():
        print("build-plan-failed", plan.errorCount())
        var i = 0
        while i < len(plan.errors):
            print("计划错误", manifestErrorKindName(plan.errors[i].kind), plan.errors[i].path, plan.errors[i].detail)
            i = i + 1
        assert(false, "构建计划未通过")
        return
    let filled = fillPlanHashes(plan = plan, root = root)
    var steps = 0
    var p = 0
    while p < len(filled.plan.packages):
        steps = steps + len(filled.plan.packages[p].steps)
        p = p + 1
    let path = planFilePath(root = root, profile = filled.plan.profile)
    let directory = root + "/.build/" + filled.plan.profile
    ; 构建目录由本步建出来：首次构建时它按定义不存在，报错等于要求用户先手工建树。
    ensureDir(directory)
    ; 宏段与跳过段归宿主求值：自举只做搬运，丢了它们等于让所有宏变成缺计划。
    var tail = ""
    if exists(path):
        tail = planTailSections(text = readFile(path))
    var text = planFileText(filled.plan)
    if len(tail) > 0:
        text = text + "\n" + tail
    writeFile(path, text)
    print("build-ok", steps, filled.missing)
    return

; 编译命令：单文件 → 发射 → clang 链成原生程序 → 运行。
; 宿主同名命令只收单文件，这里同口径；目录入口不在此列。
; 注意 退出码只对齐「零 / 非零」：自举侧没有逐值退出原语，非零一律落到断言的 1。
runCompile|func(path: String, stdlib: StdlibOption,) -> ():
    ; 检查先行：降载不跑语法与类型诊断，直接下去会把坏源码送进 clang，错因落成链接失败。
    let report = checkWorkspace(root = path, stdlib = stdlib)
    if report.errorCount > 0 || report.exitCode != 0:
        if len(report.text) > 0:
            print(report.text)
        print("compile-blocked", report.errorCount)
        assert(false, "检查未通过")
        return
    let 产物 = 降载工作区(root = path, stdlib = stdlib)
    if 产物.packages == 0:
        return
    if len(产物.check.errors) > 0:
        print("compile-blocked", len(产物.check.errors))
        assert(false, "结构校验未通过")
        return
    let outputCode = backendOutputNativeCode()
    let entry = makeBackendOf(name = "llvm", outputCode = outputCode, families = llvmFamilies(), entry = 2)
    let emitted = emitModule(entry = entry, target = defaultTarget(), module = 产物.module)
    if emitted.failed:
        print("compile-gaps", emitGapCount(result = emitted), emitted.detail)
        assert(false, "发射有缺口")
        return
    let irPath = tempPath(tag = "compile", suffix = ".ll")
    let binPath = tempPath(tag = "compile", suffix = "")
    writeFile(irPath, emitted.text)
    let 链 = runProcess(argv = linkArgs(irPath = irPath, binPath = binPath), keepOutput = true)
    removeFile(path = irPath)
    if 链.code != 0:
        print("compile-failed", 链.code)
        print(链.stderrText)
        assert(false, "clang 链接失败")
        return
    let 跑 = runProcess(argv = [binPath], keepOutput = false)
    removeFile(path = binPath)
    if 跑.code != 0:
        assert(false, "程序以非零码退出")
        return
    return
