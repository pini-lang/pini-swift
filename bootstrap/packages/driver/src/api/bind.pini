[bind|import]
_unicode = "../../../unicode"
_support = "../../../support"

; 头文件翻译的纯函数面：命令行解析、路径归一、C 类型拼写映射与块文本渲染。
; 起 clang 与扫 AST 的部分在同包的 bind_clang.pini；这一份不碰文件系统与进程，可直接单测。

; 翻译选项：与宿主同名开关一一对应；header 为空即缺位置参数。
(BindOptions)
header: String = ""
includePaths: Array<String> = []
defines: Array<String> = []
blockName: String = ""
outputPath: String = ""

; 声明种类：函数与数据符号共用一条声明序，按种类分流取值面。
[BindDeclKind]
bindDeclFunction
bindDeclVariable

; 一条待生成声明：函数用返回类型与形参表，数据符号用 typeText；其余字段只对函数有意义。
(BindDecl)
kind: BindDeclKind = .bindDeclFunction
name: String = ""
returnType: String = ""
params: Array<String> = []
isVariadic: Bool = false
isStatic: Bool = false
isDeleted: Bool = false
typeText: String = ""

; 跳过项：名字与理由；isMacro 只为与宿主同口径而留，报告里不区分。
(BindSkip)
name: String = ""
reason: String = ""
isMacro: Bool = false

; 目标平台宽度：取自 clang 预定义宏，不按类型名猜。
(BindTarget)
intWidth: I32 = 4
longWidth: I32 = 8
longLongWidth: I32 = 8
pointerWidth: I32 = 8

; 类型映射结果：ok 为零即超出 ABI 面，由调用方记一条跳过。
(BindType)
ok: Bool = false
text: String = ""

; 条目结果：ok 为零且 reason 为空是静默跳过（静态数据符号），有理由才进报告。
(BindEntry)
ok: Bool = false
text: String = ""
reason: String = ""

; 函数指针拆解：returnType 与形参原拼写；ok 为零表示不是函数指针。
(BindShape)
ok: Bool = false
returnType: String = ""
params: Array<String> = []

bindUsageLine|func() -> (String,):
    return "用法：pini bind <header.h> [-I <dir>]... [-D <name>]... [--block <name>] [-o <path>]"

; 跳过项构造：结构体带参构造不在 IR 支持面内，一律先建默认值再逐字段填。
bindMakeSkip|func(_name: String, _reason: String, _isMacro: Bool,) -> (BindSkip,):
    var out = BindSkip()
    out.name = _name
    out.reason = _reason
    out.isMacro = _isMacro
    return out

bindStartsWith|func(_text: String, _prefix: String,) -> (Bool,):
    if len(_prefix) > len(_text):
        return false
    return _text.slice(0, len(_prefix)) == _prefix

; 空白只按 ASCII 判：C 类型拼写里不会出现其他空白。
bindIsSpace|func(_code: I32,) -> (Bool,):
    return _code == 32 || _code == 9 || _code == 10 || _code == 13

bindTrim|func(_text: String,) -> (String,):
    var start = 0
    var end = len(_text)
    while start < end && bindIsSpace(ord(_text[start])):
        start = start + 1
    while end > start && bindIsSpace(ord(_text[end - 1])):
        end = end - 1
    return _text.slice(start, end)

; 绝对路径归一：相对写法先拼到当前目录上，再折掉 `.` 与 `..`；不解析符号链接。
bindAbsolutePath|func(_cwd: String, _path: String,) -> (String,):
    var text = _path
    if len(text) == 0:
        text = _cwd
    elif ord(text[0]) != 47:
        if _cwd == "/":
            text = _cwd + text
        else:
            text = _cwd + "/" + text
    let absolute = len(text) > 0 && ord(text[0]) == 47
    let parts = text.split("/")
    var stack: Array<String> = []
    var i = 0
    while i < len(parts):
        let one = parts[i]
        if one == ".":
            i = i + 1
        elif one == "..":
            if len(stack) > 0 && stack[len(stack) - 1] != "..":
                stack = bindDropLast(stack)
            elif !absolute:
                stack = stack.append("..")
            i = i + 1
        else:
            stack = stack.append(one)
            i = i + 1
    let joined = stack.join("/")
    if absolute:
        return "/" + joined
    if len(joined) == 0:
        return "."
    return joined

bindDropLast|func(_items: Array<String>,) -> (Array<String>,):
    var out: Array<String> = []
    var i = 0
    while i + 1 < len(_items):
        out = out.append(_items[i])
        i = i + 1
    return out

; 末段：最后一个斜杠之后的部分；无斜杠时整串即末段。
bindLastSegment|func(_path: String,) -> (String,):
    var i = len(_path) - 1
    while i >= 0:
        if ord(_path[i]) == 47:
            return _path.slice(i + 1, len(_path))
        i = i - 1
    return _path

; 去掉扩展名：末段里最后一个点之前的部分；点在首位时视为无扩展名。
bindStripExtension|func(_path: String,) -> (String,):
    let base = bindLastSegment(_path)
    var i = len(base) - 1
    while i > 0:
        if ord(base[i]) == 46:
            return base.slice(0, i)
        i = i - 1
    return base

; 块名默认值：去扩展名的头文件名，非字母数字换下划线，首字符是数字时补下划线。
bindDefaultBlockName|func(_header: String,) -> (String,):
    let base = bindStripExtension(_header)
    var name = ""
    var i = 0
    while i < len(base):
        let ch = base[i]
        if isLetterScalar(ord(ch)) || isNumberScalar(ord(ch)) || ord(ch) == 95:
            name = name + "\(ch)"
        else:
            name = name + "_"
        i = i + 1
    if len(name) == 0:
        return "c"
    if isNumberScalar(ord(name[0])):
        return "_" + name
    return name

; 去掉 `__attribute__((...))`：按括号配对吃到配对处，逐个剥到没有为止。
bindStripAttributes|func(_spelling: String,) -> (String,):
    var text = _spelling
    var going = true
    while going:
        let at = text.indexOf("__attribute__((")
        if at < 0:
            going = false
        else:
            var depth = 0
            var cursor = at
            var end = len(text)
            var done = false
            while cursor < len(text) && !done:
                let code = ord(text[cursor])
                if code == 40:
                    depth = depth + 1
                if code == 41:
                    depth = depth - 1
                    if depth == 0:
                        end = cursor + 1
                        done = true
                cursor = cursor + 1
            text = text.slice(0, at) + text.slice(end, len(text))
    return text

; 粗分词：括号、逗号与星号两侧各补一个空格，再按空格切；连续空格由切分本身吞掉。
bindRawTokens|func(_spelling: String,) -> (Array<String>,):
    var spaced = ""
    var i = 0
    while i < len(_spelling):
        let code = ord(_spelling[i])
        if code == 42 || code == 40 || code == 41 || code == 44:
            spaced = spaced + " " + "\(chr(code))" + " "
        else:
            spaced = spaced + "\(chr(code))"
        i = i + 1
    return spaced.split(" ")

bindIsQualifier|func(_word: String,) -> (Bool,):
    if _word == "const" || _word == "volatile" || _word == "restrict":
        return true
    if _word == "__restrict" || _word == "__restrict__":
        return true
    if _word == "_Nonnull" || _word == "_Nullable" || _word == "__nonnull" || _word == "__nullable":
        return true
    return _word == "_Atomic"

bindTokens|func(_spelling: String,) -> (Array<String>,):
    let raw = bindRawTokens(_spelling)
    var out: Array<String> = []
    var i = 0
    while i < len(raw):
        if !bindIsQualifier(raw[i]):
            out = out.append(raw[i])
        i = i + 1
    return out

bindContains|func(_words: Array<String>, _word: String,) -> (Bool,):
    var i = 0
    while i < len(_words):
        if _words[i] == _word:
            return true
        i = i + 1
    return false

bindPointerDepth|func(_spelling: String,) -> (I32,):
    let words = bindTokens(_spelling)
    var count = 0
    var i = 0
    while i < len(words):
        if words[i] == "*":
            count = count + 1
        i = i + 1
    return count

bindPointeeWords|func(_spelling: String,) -> (Array<String>,):
    var words = bindRawTokens(_spelling)
    while len(words) > 0 && words[len(words) - 1] == "*":
        words = bindDropLast(words)
    var out: Array<String> = []
    var i = 0
    while i < len(words):
        if !bindIsQualifier(words[i]) && words[i] != "*":
            out = out.append(words[i])
        i = i + 1
    return out

; 函数指针拆解：`R (*)(A, B)`；找不到 `(*)` 即不是函数指针。
bindFunctionShape|func(_spelling: String,) -> (BindShape,):
    var out = BindShape()
    let compact = bindTrim(_spelling)
    let at = compact.indexOf("(*)")
    if at < 0:
        return out
    out.returnType = bindTrim(compact.slice(0, at))
    var rest = bindTrim(compact.slice(at + 3, len(compact)))
    if len(rest) < 2 || ord(rest[0]) != 40 || ord(rest[len(rest) - 1]) != 41:
        return out
    let inner = rest.slice(1, len(rest) - 1)
    out.params = bindSplitParams(inner)
    out.ok = true
    return out

; 按顶层逗号切形参表：括号里的逗号（嵌套函数指针）不切。
bindSplitParams|func(_text: String,) -> (Array<String>,):
    var parts: Array<String> = []
    var depth = 0
    var current = ""
    var i = 0
    while i < len(_text):
        let ch = _text[i]
        let code = ord(ch)
        if code == 40:
            depth = depth + 1
        if code == 41:
            depth = depth - 1
        if code == 44 && depth == 0:
            parts = parts.append(bindTrim(current))
            current = ""
            i = i + 1
            continue
        current = current + "\(ch)"
        i = i + 1
    let tail = bindTrim(current)
    if len(tail) > 0:
        parts = parts.append(tail)
    var out: Array<String> = []
    i = 0
    while i < len(parts):
        if parts[i] != "void":
            out = out.append(parts[i])
        i = i + 1
    return out

bindTypedefSpelling|func(_names: Array<String>, _spellings: Array<String>, _name: String,) -> (String,):
    var i = 0
    while i < len(_names):
        if _names[i] == _name:
            return _spellings[i]
        i = i + 1
    return ""

; 标量白名单：char / float / short 与 unsigned int 一律不接，IR 里没有对应宽度。
bindPiniValue|func(_spelling: String, _depth: I32, _names: Array<String>, _spellings: Array<String>, _longWidth: I32,) -> (BindType,):
    var out = BindType()
    let trimmed = bindTrim(bindStripAttributes(_spelling))
    if bindFunctionShape(trimmed).ok || bindPointerDepth(trimmed) > 0:
        return out
    let words = bindTokens(trimmed)
    let key = words.join(" ")
    if key == "void":
        return out
    if key == "_Bool" || key == "bool":
        out.ok = true
        out.text = "Bool"
        return out
    if key == "double" || key == "long double":
        out.ok = true
        out.text = "F64"
        return out
    if key == "signed char":
        out.ok = true
        out.text = "I8"
        return out
    if key == "unsigned char":
        out.ok = true
        out.text = "U8"
        return out
    if key == "char" || key == "float" || key == "short" || key == "short int":
        return out
    if key == "signed short" || key == "unsigned short" || key == "unsigned short int":
        return out
    let isUnsigned = bindContains(words, "unsigned")
    var longCount = 0
    var i = 0
    while i < len(words):
        if words[i] == "long":
            longCount = longCount + 1
        i = i + 1
    if longCount >= 2:
        out.ok = true
        if isUnsigned:
            out.text = "U64"
        else:
            out.text = "I64"
        return out
    if longCount == 1:
        if _longWidth == 8:
            out.ok = true
            if isUnsigned:
                out.text = "U64"
            else:
                out.text = "I64"
        elif _longWidth == 4 && !isUnsigned:
            out.ok = true
            out.text = "I32"
        return out
    if bindContains(words, "int") || key == "signed" || key == "unsigned":
        if !isUnsigned:
            out.ok = true
            out.text = "I32"
        return out
    if len(words) == 1 && _depth < 4:
        let underlying = bindTypedefSpelling(_names, _spellings, words[0])
        if len(underlying) > 0:
            return bindPiniValue(underlying, _depth + 1, _names, _spellings, _longWidth)
    return out

; 长整宽度由目标描述给：LP64 是 8、LLP64 是 4；后者只接有符号。
bindPiniPointer|func(_spelling: String, _isParam: Bool,) -> (BindType,):
    var out = BindType()
    let trimmed = bindTrim(bindStripAttributes(_spelling))
    if bindPointerDepth(trimmed) <= 0:
        return out
    let base = bindPointeeWords(trimmed).join(" ")
    let raw = bindRawTokens(trimmed)
    let isConstPointee = bindContains(raw, "const")
    if _isParam && bindPointerDepth(trimmed) == 1 && base == "char" && isConstPointee:
        out.ok = true
        out.text = "String"
        return out
    out.ok = true
    out.text = "*U8"
    return out

bindCountText|func(_value: I32,) -> (String,):
    if _value == 0:
        return "0"
    var negative = false
    var n = _value
    if n < 0:
        negative = true
        n = 0 - n
    var digits = ""
    while n > 0:
        digits = "\(chr(48 + n % 10))" + digits
        n = n / 10
    if negative:
        return "-" + digits
    return digits

bindPiniParam|func(_spelling: String, _names: Array<String>, _spellings: Array<String>, _longWidth: I32,) -> (BindType,):
    let callback = bindPiniCallback(_spelling, true, _names, _spellings, _longWidth)
    if callback.ok:
        return callback
    let value = bindPiniValue(_spelling, 0, _names, _spellings, _longWidth)
    if value.ok:
        return value
    return bindPiniPointer(_spelling, true)

bindPiniReturn|func(_spelling: String, _names: Array<String>, _spellings: Array<String>, _longWidth: I32,) -> (BindType,):
    var out = BindType()
    let trimmed = bindTrim(bindStripAttributes(_spelling))
    if trimmed == "void":
        out.ok = true
        out.text = ""
        return out
    if bindFunctionShape(trimmed).ok:
        return out
    let value = bindPiniValue(trimmed, 0, _names, _spellings, _longWidth)
    if value.ok:
        return value
    return bindPiniPointer(trimmed, false)

; 回调位：形参位可承接成函数类型，返回位一律拒；回调里的 `const char *` 退成 `*U8`。
bindPiniCallback|func(_spelling: String, _isParam: Bool, _names: Array<String>, _spellings: Array<String>, _longWidth: I32,) -> (BindType,):
    var out = BindType()
    let shape = bindFunctionShape(_spelling)
    if !shape.ok || !_isParam:
        return out
    let result = bindPiniReturn(shape.returnType, _names, _spellings, _longWidth)
    if !result.ok:
        return out
    var params: Array<String> = []
    var i = 0
    while i < len(shape.params):
        let one = bindPiniValue(shape.params[i], 0, _names, _spellings, _longWidth)
        if one.ok:
            params = params.append(one.text)
        else:
            let pointer = bindPiniPointer(shape.params[i], false)
            if !pointer.ok:
                return out
            params = params.append(pointer.text)
        i = i + 1
    var paramsText = ""
    i = 0
    while i < len(params):
        if i > 0:
            paramsText = paramsText + " "
        paramsText = paramsText + params[i] + ","
        i = i + 1
    var resultText = "()"
    if len(result.text) > 0:
        resultText = "(" + result.text + ",)"
    out.ok = true
    out.text = "(" + paramsText + ") -> " + resultText
    return out

bindDeclTag|func(_kind: BindDeclKind,) -> (I32,):
    match _kind:
        case bindDeclFunction:
            return 0
        case bindDeclVariable:
            return 1
    return 0

; 函数条目：静态与 = delete 先拒，再逐形参映射；任一形参失败即整条不进生成物。
bindFunctionEntry|func(_decl: BindDecl, _names: Array<String>, _spellings: Array<String>, _longWidth: I32,) -> (BindEntry,):
    var out = BindEntry()
    if _decl.isStatic:
        out.reason = "静态函数没有外部符号，链接期找不到它"
        return out
    if _decl.isDeleted:
        out.reason = "声明为 = delete"
        return out
    var params: Array<String> = []
    var i = 0
    while i < len(_decl.params):
        let mapped = bindPiniParam(_decl.params[i], _names, _spellings, _longWidth)
        if !mapped.ok:
            out.reason = "第 " + bindCountText(i + 1) + " 个形参 `" + _decl.params[i] + "` 超出 Pini 的 ABI 面"
            return out
        params = params.append(mapped.text)
        i = i + 1
    let result = bindPiniReturn(_decl.returnType, _names, _spellings, _longWidth)
    if !result.ok:
        out.reason = "返回类型 `" + _decl.returnType + "` 超出 Pini 的 ABI 面"
        return out
    var flag = ""
    if _decl.isVariadic:
        flag = "|varargs"
    var paramsText = ""
    i = 0
    while i < len(params):
        if i > 0:
            paramsText = paramsText + " "
        paramsText = paramsText + params[i] + ","
        i = i + 1
    var resultText = "()"
    if len(result.text) > 0:
        resultText = "(" + result.text + ",)"
    out.ok = true
    out.text = _decl.name + flag + ": (" + paramsText + ") -> " + resultText
    return out

; 数据符号：只认顶层 `const` 作只读；`const char *` 是「指向不可写」，不算只读符号。
bindVariableEntry|func(_decl: BindDecl, _names: Array<String>, _spellings: Array<String>, _longWidth: I32,) -> (BindEntry,):
    var out = BindEntry()
    if _decl.isStatic:
        return out
    let spelling = bindTrim(bindStripAttributes(_decl.typeText))
    let words = spelling.split(" ")
    var firstWord = ""
    if len(words) > 0:
        firstWord = words[0]
    let isReadonly = firstWord == "const"
    var mapped = bindPiniValue(spelling, 0, _names, _spellings, _longWidth)
    if !mapped.ok:
        mapped = bindPiniPointer(spelling, false)
    if !mapped.ok:
        out.reason = "类型 `" + _decl.typeText + "` 超出 Pini 的 ABI 面"
        return out
    var flag = ""
    if isReadonly:
        flag = "|readonly"
    out.ok = true
    out.text = _decl.name + flag + ": " + mapped.text
    return out

bindEntryOfDecl|func(_decl: BindDecl, _names: Array<String>, _spellings: Array<String>, _longWidth: I32,) -> (BindEntry,):
    if bindDeclTag(_decl.kind) == 0:
        return bindFunctionEntry(_decl, _names, _spellings, _longWidth)
    return bindVariableEntry(_decl, _names, _spellings, _longWidth)

; 块文本：头注释只写事实（来源、工具、参数、不许手改），空行之后是块体。
; 条目顺序由 AST 与预处理的输出顺序决定，不在渲染期重排。
bindRenderText|func(_block: String, _entries: Array<String>, _skipped: Array<BindSkip>, _options: BindOptions, _headerAbs: String, _tool: String,) -> (String,):
    var lines: Array<String> = []
    lines = lines.append("; 由 C 头文件翻译生成，勿手改。")
    lines = lines.append("; 来源: " + _headerAbs)
    lines = lines.append("; 工具: " + _tool)
    var parameters = ""
    var i = 0
    while i < len(_options.includePaths):
        if len(parameters) > 0:
            parameters = parameters + " "
        parameters = parameters + "-I" + _options.includePaths[i]
        i = i + 1
    i = 0
    while i < len(_options.defines):
        if len(parameters) > 0:
            parameters = parameters + " "
        parameters = parameters + "-D" + _options.defines[i]
        i = i + 1
    if len(parameters) == 0:
        parameters = "（无）"
    lines = lines.append("; 参数: " + parameters)
    lines = lines.append("; 指针一律 `*U8`；类型区分交给手写的给定块，原拼写见来源头文件。")
    if bindHasMacroEntry(_entries):
        lines = lines.append("; 本块含 |macro 条目：用到它们时，[ffi].headers 要声明来源头文件。")
    lines = lines.append("; 跳过 " + bindCountText(len(_skipped)) + " 条（结构体 / 枚举 / 函数式宏 / 认不出的类型），理由见 bind 报告。")
    lines = lines.append("")
    lines = lines.append("[" + _block + "|foreign]")
    i = 0
    while i < len(_entries):
        lines = lines.append(_entries[i])
        i = i + 1
    return lines.join("\n") + "\n"

bindHasMacroEntry|func(_entries: Array<String>,) -> (Bool,):
    var i = 0
    while i < len(_entries):
        if _entries[i].indexOf("|macro:") >= 0:
            return true
        i = i + 1
    return false
