[member_test|import]
_syntax = "../../syntax"
_module_loader = "../../module-loader"

; 成员样例：一整套单元、符号、类型与索引；查询只带世界与访问点。
(成员样例)
world: MemberWorld = MemberWorld()
file: String = ""

; 造成员样例：装载、注册、解析类型、建世界四步，顺序不能反。
造成员样例|func(path: String, src: String,) -> (成员样例,):
    let loaded = loadUnit(path, src)
    assert(!loaded.failed, "样例应可加载：" + path)
    let units = [loaded.unit]
    let table = registerPackage(units)
    let types = resolvePackage(units, table)
    var out = 成员样例()
    out.world = makeMemberWorld(units, table, types)
    out.file = path
    return out

; 查成员：访问点按值位、空所有者与样例文件填。
查成员|func(world: MemberWorld, file: String, receiver: I32, name: String, isTypeName: Bool, owner: String,) -> (MemberResult,):
    return checkMember(world, memberAccess(receiver, name, isTypeName, owner, file, 0))

; 查样例：常用形态，文件与所有者取样例默认值。
查样例|func(sample: 成员样例, receiver: I32, name: String, isTypeName: Bool, owner: String,) -> (MemberResult,):
    return 查成员(sample.world, sample.file, receiver, name, isTypeName, owner)

; 元组样例：标量与元组驻留进世界池，返回更新后的世界与元组下标。
(元组样例)
world: MemberWorld = MemberWorld()
id: I32 = -1

造元组样例|func(world: MemberWorld,) -> (元组样例,):
    let first = intern(world.types.pool, typeClassScalar, "I32", [], -1)
    var grown = world
    grown.types.pool = first.pool
    let second = intern(grown.types.pool, typeClassScalar, "Bool", [], -1)
    grown.types.pool = second.pool
    var kids: Array<I32> = []
    kids = kids.append(first.id)
    kids = kids.append(second.id)
    let tuple = intern(grown.types.pool, typeClassTuple, "", kids, -1)
    grown.types.pool = tuple.pool
    var out = 元组样例()
    out.world = grown
    out.id = tuple.id
    return out

; 字段命中：结构字段按声明类型回表，容器字段逐层写出。
字段命中|test() -> ():
    let sample = 造成员样例("packages/p/src/api/a.pini", "(点)\nx: I32 = 0\nxs: Array<I32> = []\n")
    let point = nominalTypeId(sample.world, "点")
    assert(point >= 0, "结构类型应已驻留")
    let plain = 查样例(sample, point, "x", false, "")
    assert(!plain.failed, "字段应命中")
    assert(isMemberKind(plain.kind, memberField), "应判作字段")
    assert(typeText(plain.pool, plain.typeId) == "I32", "实得 " + typeText(plain.pool, plain.typeId))
    let listed = 查样例(sample, point, "xs", false, "")
    assert(!listed.failed, "容器字段应命中")
    assert(typeText(listed.pool, listed.typeId) == "Array<I32>", "实得 " + typeText(listed.pool, listed.typeId))
    return

; 方法签名：形参逐项转写，返回类型单列；值位访问判作方法。
方法签名|test() -> ():
    let src = "(点)\nx: I32 = 0\n\n((点))\n取|self(a: I32, b: Bool,) -> (I32,):\n    return a\n"
    let sample = 造成员样例("packages/p/src/api/a.pini", src)
    let point = nominalTypeId(sample.world, "点")
    let hit = 查样例(sample, point, "取", false, "")
    assert(!hit.failed, "方法应命中")
    assert(isMemberKind(hit.kind, memberMethod), "应判作方法")
    assert(typeText(hit.pool, hit.typeId) == "(I32, Bool,) -> I32", "实得 " + typeText(hit.pool, hit.typeId))
    return

; 本型方法：类型名访问命中并判作本型方法，值位访问同样命中。
本型方法|test() -> ():
    let src = "(点)\nx: I32 = 0\n\n((点))\n造|own() -> (I32,):\n    return 1\n"
    let sample = 造成员样例("packages/p/src/api/a.pini", src)
    let point = nominalTypeId(sample.world, "点")
    let byName = 查样例(sample, point, "造", true, "")
    assert(!byName.failed, "类型名访问本型方法应命中")
    assert(isMemberKind(byName.kind, memberOwnMethod), "应判作本型方法")
    assert(typeText(byName.pool, byName.typeId) == "() -> I32", "实得 " + typeText(byName.pool, byName.typeId))
    let byValue = 查样例(sample, point, "造", false, "")
    assert(!byValue.failed, "值位访问本型方法同样命中")
    return

; 实例方法经类型名：类型名作接收者时看不到自身方法，报未知成员。
实例方法经类型名|test() -> ():
    let src = "(点)\nx: I32 = 0\n\n((点))\n取|self() -> (I32,):\n    return 0\n"
    let sample = 造成员样例("packages/p/src/api/a.pini", src)
    let point = nominalTypeId(sample.world, "点")
    let hit = 查样例(sample, point, "取", true, "")
    assert(hit.failed, "类型名不应看到自身方法")
    assert(memberErrorCode(hit.error.kind) == "E4-009", "实得 " + memberErrorCode(hit.error.kind))
    return

; 枚举项：无载荷给枚举自身，带载荷给构造签名。
枚举项|test() -> ():
    let src = "[颜色]\n红\n绿(值: I32,)\n"
    let sample = 造成员样例("packages/p/src/api/a.pini", src)
    let color = nominalTypeId(sample.world, "颜色")
    let plain = 查样例(sample, color, "红", true, "")
    assert(!plain.failed, "无载荷用例应命中")
    assert(isMemberKind(plain.kind, memberEnumCase), "应判作枚举项")
    assert(typeText(plain.pool, plain.typeId) == "颜色", "实得 " + typeText(plain.pool, plain.typeId))
    let payload = 查样例(sample, color, "绿", true, "")
    assert(!payload.failed, "带载荷用例应命中")
    assert(typeText(payload.pool, payload.typeId) == "(I32,) -> 颜色", "实得 " + typeText(payload.pool, payload.typeId))
    return

; 元组序号：数字名字按位置取分量，越界报未知成员。
元组序号|test() -> ():
    let sample = 造成员样例("packages/p/src/api/a.pini", "(点)\nx: I32 = 0\n")
    let tuple = 造元组样例(sample.world)
    let first = 查成员(tuple.world, sample.file, tuple.id, "0", false, "")
    assert(!first.failed, "首个分量应命中")
    assert(isMemberKind(first.kind, memberTupleIndex), "应判作元组序号")
    assert(typeText(first.pool, first.typeId) == "I32", "实得 " + typeText(first.pool, first.typeId))
    let second = 查成员(tuple.world, sample.file, tuple.id, "1", false, "")
    assert(typeText(second.pool, second.typeId) == "Bool", "实得 " + typeText(second.pool, second.typeId))
    let beyond = 查成员(tuple.world, sample.file, tuple.id, "2", false, "")
    assert(beyond.failed, "越界序号应报错")
    assert(memberErrorCode(beyond.error.kind) == "E4-009", "实得 " + memberErrorCode(beyond.error.kind))
    let huge = 查成员(tuple.world, sample.file, tuple.id, "10000", false, "")
    assert(huge.failed, "超长序号应报错")
    return

; 元组标签：标签表按类型下标挂上后，名字与序号同样命中。
元组标签|test() -> ():
    let sample = 造成员样例("packages/p/src/api/a.pini", "(点)\nx: I32 = 0\n")
    let tuple = 造元组样例(sample.world)
    var labels: Array<String> = []
    labels = labels.append("a")
    labels = labels.append("b")
    let world = withTupleLabels(tuple.world, tuple.id, labels)
    let hit = 查成员(world, sample.file, tuple.id, "b", false, "")
    assert(!hit.failed, "标签应命中")
    assert(isMemberKind(hit.kind, memberTupleLabel), "应判作元组标签")
    assert(typeText(hit.pool, hit.typeId) == "Bool", "实得 " + typeText(hit.pool, hit.typeId))
    let missing = 查成员(world, sample.file, tuple.id, "c", false, "")
    assert(missing.failed, "未知标签应报错")
    return

; 私有字段：本类型方法内可读，空所有者按外人拒。
私有字段|test() -> ():
    let sample = 造成员样例("packages/p/src/api/a.pini", "(点)\n_秘密: I32 = 0\n")
    let point = nominalTypeId(sample.world, "点")
    let inside = 查样例(sample, point, "_秘密", false, "点")
    assert(!inside.failed, "本类型方法应可读私有字段")
    let outside = 查样例(sample, point, "_秘密", false, "")
    assert(outside.failed, "外人不得读私有字段")
    assert(memberErrorCode(outside.error.kind) == "E4-012", "实得 " + memberErrorCode(outside.error.kind))
    return

; 文件内字段跨文件：文件名的下划线把成员降为文件内可见。
文件内字段跨文件|test() -> ():
    let sample = 造成员样例("packages/p/src/api/_a.pini", "(点)\nx: I32 = 0\n")
    let point = nominalTypeId(sample.world, "点")
    let same = 查成员(sample.world, "packages/p/src/api/_a.pini", point, "x", false, "")
    assert(!same.failed, "同文件应可读")
    let other = 查成员(sample.world, "packages/p/src/api/b.pini", point, "x", false, "")
    assert(other.failed, "跨文件不得读文件内成员")
    assert(memberErrorCode(other.error.kind) == "E4-011", "实得 " + memberErrorCode(other.error.kind))
    return

; 未找到成员：诊断带类型名与成员名，类型表写错误标记。
未找到成员|test() -> ():
    let sample = 造成员样例("packages/p/src/api/a.pini", "(点)\nx: I32 = 0\n")
    let point = nominalTypeId(sample.world, "点")
    let hit = 查样例(sample, point, "无此成员", false, "")
    assert(hit.failed, "未知成员应报错")
    assert(memberErrorCode(hit.error.kind) == "E4-009", "实得 " + memberErrorCode(hit.error.kind))
    assert(hit.error.typeName == "点", "类型名实得 " + hit.error.typeName)
    assert(hit.error.memberName == "无此成员", "成员名实得 " + hit.error.memberName)
    assert(hit.typeId == errorTypeId(), "失败应写错误标记")
    return

; 接收者未定：不报错也不落错误标记，交给调用方补判。
接收者未定|test() -> ():
    let sample = 造成员样例("packages/p/src/api/a.pini", "(点)\nx: I32 = 0\n")
    let hit = 查样例(sample, unsetTypeId(), "x", false, "")
    assert(!hit.failed, "未定接收者不应报错")
    assert(hit.deferred, "应记为待定")
    assert(hit.typeId == unsetTypeId(), "待定不写错误标记")
    return

; 两次判定一致：同一输入两次查询得到同一类别与类型。
两次判定一致|test() -> ():
    let src = "(点)\nx: I32 = 0\n\n((点))\n取|self() -> (I32,):\n    return 0\n"
    let sample = 造成员样例("packages/p/src/api/a.pini", src)
    let point = nominalTypeId(sample.world, "点")
    let first = 查样例(sample, point, "取", false, "")
    let second = 查样例(sample, point, "取", false, "")
    assert(memberKindName(first.kind) == memberKindName(second.kind), "类别应相同")
    assert(first.typeId == second.typeId, "类型下标应相同")
    assert(typeText(first.pool, first.typeId) == typeText(second.pool, second.typeId), "文本应相同")
    return
