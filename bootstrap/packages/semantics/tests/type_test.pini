[type_test|import]
_module_loader = "../../module-loader"
package = "../../package"

; 采样结果：单元、解析表与首字段声明；查询一律从首字段起步。
(TypeSample)
unit: CompilationUnit = CompilationUnit()
table: TypeTable = TypeTable()
firstField: I32 = -1

; 造类型单元：从源码字符串建，解析失败即断言。
造类型单元|func(path: String, text: String,) -> (CompilationUnit,):
    let loaded = loadUnit(path, text)
    assert(!loaded.failed, "样例应可解析：" + path)
    return loaded.unit

; 采样：先注册顶层名字再解析类型，两者顺序不能反。
采样|func(path: String, src: String,) -> (TypeSample,):
    let unit = 造类型单元(path, src)
    let symbols = registerPackage([unit])
    let types = resolvePackage([unit], symbols)
    var out = TypeSample()
    out.unit = unit
    out.table = types
    if len(unit.ast.items) > 0:
        let decl = unit.ast.decls[unit.ast.items[0]]
        if len(decl.kids) > 0:
            out.firstField = decl.kids[0]
    return out

; 字段下标：取首个顶层结构的第几个字段。
字段下标|func(sample: TypeSample, index: I32,) -> (I32,):
    let decl = sample.unit.ast.decls[sample.unit.ast.items[0]]
    return decl.kids[index]

; 字段类型：解析失败答 -1。
字段类型|func(sample: TypeSample, index: I32,) -> (I32,):
    return sample.table.typeOf(0, 字段下标(sample, index))

; 首字段文本：规范化拼写的单一入口。
标注文本|func(sample: TypeSample,) -> (String,):
    return sample.table.textOf(0, sample.firstField)

; 标量：内建名原样输出，不改写大小写。
标量文本|test() -> ():
    let 样例 = 采样("packages/p/src/api/a.pini", "(P)\nx: I32 = 0\n")
    assert(样例.table.isOK(), "标量标注应无错")
    assert(标注文本(样例) == "I32", "实得 " + 标注文本(样例))
    return

; 容器文本：泛型实参逐层写出，容器名取内建拼写。
容器文本|test() -> ():
    let 样例 = 采样("packages/p/src/api/a.pini", "(P)\nx: Array<U8> = []\n")
    assert(样例.table.isOK(), "容器标注应无错")
    assert(标注文本(样例) == "Array<U8>", "实得 " + 标注文本(样例))
    return

; 容器正例：集、字典与可选各按容器类成形，可选统一写后缀问号。
容器正例|test() -> ():
    let 样例 = 采样("packages/p/src/api/a.pini", "(P)\na: Set<I32> = []\nb: Dictionary<String, I32>\nc: Optional<I32> = nil\n")
    assert(样例.table.isOK(), "容器正例应无错")
    assert(样例.table.textOf(0, 字段下标(样例, 0)) == "Set<I32>", "集实得 " + 样例.table.textOf(0, 字段下标(样例, 0)))
    assert(样例.table.textOf(0, 字段下标(样例, 1)) == "Dictionary<String, I32>", "字典实得 " + 样例.table.textOf(0, 字段下标(样例, 1)))
    assert(样例.table.textOf(0, 字段下标(样例, 2)) == "I32?", "可选实得 " + 样例.table.textOf(0, 字段下标(样例, 2)))
    return

; 可选与指针：后缀问号逐层包裹，星号前缀贴在操作数前。
可选指针文本|test() -> ():
    let 可选 = 采样("packages/p/src/api/a.pini", "(P)\nx: I32? = nil\n")
    assert(标注文本(可选) == "I32?", "可选实得 " + 标注文本(可选))
    let 指针 = 采样("packages/p/src/api/b.pini", "(P)\nx: *I32\n")
    assert(标注文本(指针) == "*I32", "指针实得 " + 标注文本(指针))
    return

; 元组与函数：元组带尾逗号，函数形参与返回各成一组。
元组函数文本|test() -> ():
    let 元组 = 采样("packages/p/src/api/a.pini", "(P)\nx: (I32, F64,)\n")
    assert(标注文本(元组) == "(I32, F64,)", "元组实得 " + 标注文本(元组))
    let 空 = 采样("packages/p/src/api/b.pini", "(P)\nx: ()\n")
    assert(标注文本(空) == "()", "空元组实得 " + 标注文本(空))
    let 函数 = 采样("packages/p/src/api/c.pini", "(P)\nx: (I32,) -> (String,)\n")
    assert(标注文本(函数) == "(I32,) -> String", "函数实得 " + 标注文本(函数))
    return

; 嵌套：容器实参里的可选与指针照常展开。
嵌套文本|test() -> ():
    let 样例 = 采样("packages/p/src/api/a.pini", "(P)\nx: Array<I32?>\n")
    assert(标注文本(样例) == "Array<I32?>", "实得 " + 标注文本(样例))
    return

; 等价正例：同形同实参即等价，两次独立解析也成立。
等价正例|test() -> ():
    let 样例 = 采样("packages/p/src/api/a.pini", "(P)\na: Array<I32> = []\nb: Array<I32> = []\n")
    let 左 = 字段类型(样例, 0)
    let 右 = 字段类型(样例, 1)
    assert(sameType(样例.table.pool, 左, 右), "同形应等价")
    return

; 等价反例：实参不同即不等价，反向判据必须为假。
等价反例|test() -> ():
    let 样例 = 采样("packages/p/src/api/a.pini", "(P)\na: Array<I32> = []\nb: Array<I64> = []\n")
    assert(!sameType(样例.table.pool, 字段类型(样例, 0), 字段类型(样例, 1)), "实参不同应不等价")
    return

; 可赋值正例：标量拓宽、字符到串、可选包装与容器同形。
可赋值正例|test() -> ():
    let 样例 = 采样("packages/p/src/api/a.pini", "(P)\na: I8 = 0\nb: I32 = 0\nc: F32 = 0.0\nd: F64 = 0.0\ne: Char = 0\nf: String = \"\"\ng: I32? = nil\nh: Result<I32>\ni: Array<I32> = []\nj: Array<I32> = []\n")
    assert(isAssignable(样例.table.pool, 字段类型(样例, 0), 字段类型(样例, 1)), "I8 应可赋给 I32")
    assert(isAssignable(样例.table.pool, 字段类型(样例, 2), 字段类型(样例, 3)), "F32 应可赋给 F64")
    assert(isAssignable(样例.table.pool, 字段类型(样例, 4), 字段类型(样例, 5)), "Char 应可赋给 String")
    assert(isAssignable(样例.table.pool, 字段类型(样例, 1), 字段类型(样例, 6)), "I32 应可包成可选")
    assert(isAssignable(样例.table.pool, 字段类型(样例, 1), 字段类型(样例, 7)), "I32 应可包成结果")
    assert(isAssignable(样例.table.pool, 字段类型(样例, 8), 字段类型(样例, 9)), "同形容器应可赋")
    return

; 可赋值反例：收窄、跨符号、反向包装与实参变宽都必须为假。
可赋值反例|test() -> ():
    let 样例 = 采样("packages/p/src/api/a.pini", "(P)\na: I32 = 0\nb: I8 = 0\nc: U32 = 0\nd: U8 = 0\ne: String = \"\"\nf: Char = 0\ng: I32? = nil\nh: Result<I32>\ni: Array<I32> = []\nj: Array<I64> = []\n")
    let 池 = 样例.table.pool
    assert(!isAssignable(池, 字段类型(样例, 0), 字段类型(样例, 1)), "I32 不应收窄到 I8")
    assert(!isAssignable(池, 字段类型(样例, 0), 字段类型(样例, 2)), "I32 不应跨到 U32")
    assert(!isAssignable(池, 字段类型(样例, 3), 字段类型(样例, 0)), "U8 不应跨到 I32")
    assert(!isAssignable(池, 字段类型(样例, 4), 字段类型(样例, 5)), "String 不应退回 Char")
    assert(!isAssignable(池, 字段类型(样例, 6), 字段类型(样例, 0)), "可选不应直接解包赋值")
    assert(!isAssignable(池, 字段类型(样例, 7), 字段类型(样例, 0)), "结果不应直接解包赋值")
    assert(!isAssignable(池, 字段类型(样例, 8), 字段类型(样例, 9)), "容器实参不应变宽")
    return

; 实参个数：容器少给或多给都报个数不符，全称容器缺实参同样报。
泛型个数|test() -> ():
    let 多给 = 采样("packages/p/src/api/a.pini", "(P)\nx: Array<I32, I32>\n")
    assert(!多给.table.isOK(), "多给实参应报错")
    assert(isTypeError(多给.table.errorAt(0), typeErrorArityMismatch), "类别应为个数不符")
    let 裸名 = 采样("packages/p/src/api/b.pini", "(P)\nx: Array\n")
    assert(!裸名.table.isOK(), "缺实参应报错")
    assert(isTypeError(裸名.table.errorAt(0), typeErrorArityMismatch), "类别应为个数不符")
    return

; 结果约束：错误实参只认内建 Error，省略错误实参按 Error 补齐。
结果约束|test() -> ():
    let 正例 = 采样("packages/p/src/api/a.pini", "(P)\nx: Result<I32>\n")
    assert(正例.table.isOK(), "单实参结果应通过")
    assert(标注文本(正例) == "^I32", "实得 " + 标注文本(正例))
    let 反例 = 采样("packages/p/src/api/b.pini", "(P)\nx: Result<I32, String>\n")
    assert(!反例.table.isOK(), "错误实参非 Error 应报错")
    assert(isTypeError(反例.table.errorAt(0), typeErrorConstraint), "类别应为约束不满足")
    return

; 未声明类型：具名类型查不到即报，位置取标注起点。
未声明类型|test() -> ():
    let 样例 = 采样("packages/p/src/api/a.pini", "(P)\nx: Foo\n")
    assert(!样例.table.isOK(), "未声明类型应报错")
    assert(isTypeError(样例.table.errorAt(0), typeErrorUnknownName), "类别应为未声明")
    assert(样例.table.errorAt(0).name == "Foo", "错误应带名字")
    return

; 名字不是类型：查到的声明是函数时单列类别，不与未声明混同。
名字非类型|test() -> ():
    let 样例 = 采样("packages/p/src/api/a.pini", "foo|func() -> ():\n    return\n\n(Q)\nx: foo\n")
    assert(!样例.table.isOK(), "函数名作类型应报错")
    assert(isTypeError(样例.table.errorAt(0), typeErrorNotTypeName), "类别应为名字不是类型")
    return

; 直接自引用：结构字段直接回到自身，值类型大小无法确定。
直接自引用|test() -> ():
    let 样例 = 采样("packages/p/src/api/a.pini", "(A)\nx: A\n")
    assert(!样例.table.isOK(), "直接自引用应报错")
    assert(isTypeError(样例.table.errorAt(0), typeErrorSelfReference), "类别应为自引用")
    return

; 间接成环：两个结构互相持有，环只在起点报一条。
间接成环|test() -> ():
    let 样例 = 采样("packages/p/src/api/a.pini", "(A)\nx: B\n\n(B)\ny: A\n")
    assert(!样例.table.isOK(), "间接环应报错")
    assert(isTypeError(样例.table.errorAt(0), typeErrorRecursiveCycle), "类别应为成环")
    assert(样例.table.errorCount() == 1, "同一环只报一条，实得 " + "\(样例.table.errorCount())")
    return

; 容器断开环：数组与指针是堆上或外部引用，自引用合法。
容器断开环|test() -> ():
    let 数组 = 采样("packages/p/src/api/a.pini", "(A)\nx: Array<A>\n")
    assert(数组.table.isOK(), "数组承载自身应合法")
    let 指针 = 采样("packages/p/src/api/b.pini", "(P)\nx: *P\n")
    assert(指针.table.isOK(), "指针承载自身应合法")
    return

; 顺序无关：两个单元正序与逆序解析，绑定数与文本逐字相同。
类型顺序无关|test() -> ():
    let 甲 = 造类型单元("packages/p/src/api/a.pini", "(A)\nx: I32 = 0\n")
    let 乙 = 造类型单元("packages/p/src/api/b.pini", "(B)\ny: Array<U8> = []\n")
    let 正 = resolvePackage([甲, 乙], registerPackage([甲, 乙]))
    let 逆 = resolvePackage([乙, 甲], registerPackage([乙, 甲]))
    assert(正.bindingCount() == 逆.bindingCount(), "绑定数应相同")
    let 甲字段 = 甲.ast.decls[甲.ast.items[0]].kids[0]
    let 乙字段 = 乙.ast.decls[乙.ast.items[0]].kids[0]
    assert(正.textOf(0, 甲字段) == 逆.textOf(0, 甲字段), "甲文本应相同")
    assert(正.textOf(1, 乙字段) == 逆.textOf(1, 乙字段), "乙文本应相同")
    return

; 计划里按包名定位：找不到答 -1。
类型包索引|func(plan: BuildPlan, name: String,) -> (I32,):
    var i = 0
    while i < len(plan.packages):
        if plan.packages[i].name == name:
            return i
        i = i + 1
    return -1

; 真实包：support 的全部标注解析零错误，绑定数不为零。
真实包类型|test() -> ():
    let root = moduleRoot() + "/../.."
    let plan: BuildPlan = package.planWorkspace(root)
    assert(plan.isOK(), "计划应可用")
    let at = 类型包索引(plan, "support")
    assert(at >= 0, "计划里应有 support")
    let pkg: PackagePlan = plan.packages[at]
    let loaded = loadPackage(root + "/" + pkg.rootPath, pkg)
    assert(loaded.isOK(), "support 装载应无错")
    let symbols = registerPackage(loaded.units)
    let types = resolvePackage(loaded.units, symbols)
    if !types.isOK():
        let 首 = types.errorAt(0)
        assert(false, "类型解析应零错误，实得 " + 首.file + " " + typeErrorName(首.kind) + " " + 首.name)
    assert(types.bindingCount() > 0, "应解析出绑定")
    return
