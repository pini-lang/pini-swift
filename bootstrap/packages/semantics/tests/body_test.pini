[body_test|import]
_syntax = "../../syntax"
_module_loader = "../../module-loader"

; 体样例：单元、世界与表达式类型表；函数体检查只读这三样。
(体样例)
world: MemberWorld = MemberWorld()
unit: CompilationUnit = CompilationUnit()
types: ExprTypes = ExprTypes()

; 造体样例：装载、注册、解析类型、建世界四步，顺序不能反。
造体样例|func(src: String,) -> (体样例,):
    let loaded = loadUnit("packages/p/src/api/a.pini", src)
    assert(!loaded.failed, "样例应可加载")
    let units = [loaded.unit]
    let table = registerPackage(units)
    let types = resolvePackage(units, table)
    var out = 体样例()
    out.world = makeMemberWorld(units, table, types)
    out.unit = loaded.unit
    out.types = makeExprTypes(units)
    return out

; 找函数：按名字找顶层函数声明，找不到答 -1。
找函数|func(sample: 体样例, name: String,) -> (I32,):
    let ast = sample.unit.ast
    let bytes = tempUtf8Bytes(sample.unit.text)
    var i = 0
    while i < len(ast.items):
        let id = ast.items[i]
        if isFunctionDeclCode(ast.decls[id].kind):
            if decodeRange(bytes, ast.decls[id].nameStart, ast.decls[id].nameEnd) == name:
                return id
        i = i + 1
    return -1

; 找方法：按扩展块目标名与方法名找声明，找不到答 -1。
找方法|func(sample: 体样例, owner: String, name: String,) -> (I32,):
    let ast = sample.unit.ast
    let bytes = tempUtf8Bytes(sample.unit.text)
    var i = 0
    while i < ast.declCount():
        let decl = ast.declAt(i)
        if isExtensionDeclCode(decl.kind):
            if decodeRange(bytes, decl.nameStart, decl.nameEnd) == owner:
                var k = 0
                while k < len(decl.kids):
                    let kid = decl.kids[k]
                    if isFunctionDeclCode(ast.decls[kid].kind):
                        if decodeRange(bytes, ast.decls[kid].nameStart, ast.decls[kid].nameEnd) == name:
                            return kid
                    k = k + 1
        i = i + 1
    return -1

; 查体：顶层函数按名字检查函数体。
查体|func(sample: 体样例, name: String,) -> (BodyCheck,):
    let id = 找函数(sample, name)
    assert(id >= 0, "应找到函数 " + name)
    return checkFunctionBody(sample.world, 0, id, sample.types)

; 查方法体：扩展块方法按目标名与方法名检查函数体。
查方法体|func(sample: 体样例, owner: String, name: String,) -> (BodyCheck,):
    let id = 找方法(sample, owner, name)
    assert(id >= 0, "应找到方法 " + name)
    return checkFunctionBody(sample.world, 0, id, sample.types)

; 首个返回：返回第一个 return 语句的下标，没有答 -1。
首个返回|func(ast: Ast,) -> (I32,):
    var i = 0
    while i < ast.stmtCount():
        if ast.isReturnStmt(i):
            return i
        i = i + 1
    return -1

; 定返回值：把首个 return 的值节点类型写进表，供返回类型比对。
定返回值|func(sample: 体样例, typeId: I32,) -> (体样例,):
    let ret = 首个返回(sample.unit.ast)
    assert(ret >= 0, "应有 return 语句")
    var out = sample
    out.types = writeExprType(out.types, 0, sample.unit.ast.stmtChild(ret, 0), typeId)
    return out

; 参数播种：参数逐个进函数帧，类型取标注，参数默认可变，槽位从零起。
参数播种|test() -> ():
    let sample = 造体样例("f|func(a: I32, b: String,) -> (I32,):\n    return a\n")
    let hit = 查体(sample, "f")
    assert(!hit.failed, "不应报错")
    assert(hit.scope.frameCount() == 1, "应有一层函数帧")
    assert(isScopeKind(hit.scope.frameAt(0).kind, scopeFunction), "应进函数帧")
    assert(hit.scope.localCount() == 2, "应有两个参数")
    let first = hit.scope.localAt(0)
    assert(first.spelling == "a", "实得 " + first.spelling)
    assert(isLocalKind(first.kind, localParam), "应判作参数")
    assert(first.mutable, "参数应可重新赋值")
    assert(first.slot == 0, "首参槽位应为零")
    assert(typeText(hit.pool, first.typeId) == "I32", "实得 " + typeText(hit.pool, first.typeId))
    assert(typeText(hit.pool, hit.scope.localAt(1).typeId) == "String", "次参应是 String")
    assert(hit.scope.localAt(1).slot == 1, "次参槽位应为一")
    assert(hit.returns == 1, "应检查一条 return")
    assert(hit.guarantees, "单条 return 的体应保证返回")
    return

; 自身播种：`|self` 方法把 self 记成不可变的自身局部，类型取扩展目标。
自身播种|test() -> ():
    let sample = 造体样例("(点)\nx: I32 = 0\n\n((点))\n取|self() -> (I32,):\n    return self.x\n")
    let hit = 查方法体(sample, "点", "取")
    assert(!hit.failed, "不应报错")
    assert(hit.scope.localCount() == 1, "只应有自身一个局部")
    let selfLocal = hit.scope.localAt(0)
    assert(selfLocal.spelling == "self", "实得 " + selfLocal.spelling)
    assert(isLocalKind(selfLocal.kind, localSelf), "应判作自身")
    assert(!selfLocal.mutable, "自身不可赋值")
    assert(typeText(hit.pool, selfLocal.typeId) == "点", "实得 " + typeText(hit.pool, selfLocal.typeId))
    return

; 本型无自身：`|own` 方法没有隐式 self，体内只有参数。
本型无自身|test() -> ():
    let sample = 造体样例("(点)\nx: I32 = 0\n\n((点))\n造|own() -> (点,):\n    return 点()\n")
    let hit = 查方法体(sample, "点", "造")
    assert(hit.scope.localCount() == 0, "本型方法不应播种自身")
    return

; 非方法无自身：顶层函数只有参数，没有自身。
非方法无自身|test() -> ():
    let sample = 造体样例("f|func(a: I32,) -> (I32,):\n    return a\n")
    let hit = 查体(sample, "f")
    assert(hit.scope.localCount() == 1, "只应有一个参数")
    assert(isLocalKind(hit.scope.localAt(0).kind, localParam), "应判作参数")
    return

; 参数重名：同一函数两个参数同名，报符号重复声明。
参数重名|test() -> ():
    let sample = 造体样例("f|func(a: I32, a: String,) -> (I32,):\n    return a\n")
    let hit = 查体(sample, "f")
    assert(hit.failed, "应判失败")
    assert(len(hit.errors) == 1, "应报一条重名")
    assert(bodyErrorCode(hit.errors[0].kind) == "E3-004", "实得 " + bodyErrorCode(hit.errors[0].kind))
    assert(hit.errors[0].name == "a", "实得 " + hit.errors[0].name)
    return

; 返回类型不符：return 值的类型不可赋给返回类型，报类型不匹配。
返回类型不符|test() -> ():
    var sample = 造体样例("f|func() -> (I32,):\n    return \"x\"\n")
    let 文本 = intern(sample.world.types.pool, typeClassScalar, "String", [], -1)
    sample.world.types.pool = 文本.pool
    sample = 定返回值(sample, 文本.id)
    let hit = 查体(sample, "f")
    assert(len(hit.errors) == 1, "应报一条类型不匹配")
    assert(bodyErrorCode(hit.errors[0].kind) == "E4-001", "实得 " + bodyErrorCode(hit.errors[0].kind))
    assert(hit.errors[0].expected == "I32", "实得 " + hit.errors[0].expected)
    assert(hit.errors[0].got == "String", "实得 " + hit.errors[0].got)
    return

; 返回缺值：非空返回类型的函数写裸 return，报缺值。
返回缺值|test() -> ():
    let sample = 造体样例("f|func() -> (I32,):\n    return\n")
    let hit = 查体(sample, "f")
    assert(len(hit.errors) == 1, "应报一条缺值")
    assert(bodyErrorCode(hit.errors[0].kind) == "E4-001", "实得 " + bodyErrorCode(hit.errors[0].kind))
    assert(hit.errors[0].expected == "I32", "实得 " + hit.errors[0].expected)
    assert(hit.guarantees, "裸 return 仍保证返回")
    return

; 值返回禁带：空返回类型的函数写 return 值，报不该带值。
值返回禁带|test() -> ():
    let sample = 造体样例("f|func() -> ():\n    return 1\n")
    let hit = 查体(sample, "f")
    assert(len(hit.errors) == 1, "应报一条多余返回")
    assert(bodyErrorCode(hit.errors[0].kind) == "E4-001", "实得 " + bodyErrorCode(hit.errors[0].kind))
    assert(hit.errors[0].expected == "()", "实得 " + hit.errors[0].expected)
    return

; 空体缺返回：非空返回类型的体没有任何 return，报缺失返回路径。
空体缺返回|test() -> ():
    let sample = 造体样例("f|func() -> (I32,):\n    pass\n")
    let hit = 查体(sample, "f")
    assert(len(hit.errors) == 1, "应报一条缺失返回")
    assert(bodyErrorCode(hit.errors[0].kind) == "E4-001", "实得 " + bodyErrorCode(hit.errors[0].kind))
    assert(hit.errors[0].name == "f", "实得 " + hit.errors[0].name)
    assert(!hit.guarantees, "空体不保证返回")
    return

; 空体通过：空返回类型的体不必有 return。
空体通过|test() -> ():
    let sample = 造体样例("f|func() -> ():\n    pass\n")
    let hit = 查体(sample, "f")
    assert(!hit.failed, "空返回类型的空体不应报错")
    assert(!hit.guarantees, "空体不保证返回")
    assert(hit.returns == 0, "没有 return 语句")
    assert(typeText(hit.pool, hit.returnType) == "()", "实得 " + typeText(hit.pool, hit.returnType))
    return

; 测试体返回空：`|test` 写 `-> ()` 与裸 return 都成立，无标注即空返回。
测试体返回空|test() -> ():
    let sample = 造体样例("好|test() -> ():\n    return\n")
    let hit = 查体(sample, "好")
    assert(!hit.failed, "测试体不应报错")
    assert(hit.guarantees, "裸 return 应保证返回")
    let plain = 造体样例("空|test():\n    pass\n")
    let loose = 查体(plain, "空")
    assert(!loose.failed, "无标注的测试体不应报错")
    assert(typeText(loose.pool, loose.returnType) == "()", "实得 " + typeText(loose.pool, loose.returnType))
    return

; 分支全返回：if 与 else 两支都返回，体保证返回。
分支全返回|test() -> ():
    let sample = 造体样例("f|func(x: I32,) -> (I32,):\n    if x > 0:\n        return 1\n    else:\n        return 2\n")
    let hit = 查体(sample, "f")
    assert(!hit.failed, "两支都返回不应报错")
    assert(hit.returns == 2, "应检查两条 return")
    assert(hit.guarantees, "两支都返回应保证返回")
    return

; 分支缺否则：只有 if 支返回，其余路径落空，报缺失返回。
分支缺否则|test() -> ():
    let sample = 造体样例("f|func(x: I32,) -> (I32,):\n    if x > 0:\n        return 1\n")
    let hit = 查体(sample, "f")
    assert(len(hit.errors) == 1, "应报一条缺失返回")
    assert(!hit.guarantees, "缺 else 不保证返回")
    return

; 匹配全返回：枚举每个变体都返回且无尾随 return，体仍保证返回。
匹配全返回|test() -> ():
    let sample = 造体样例("[形状]\n圆(半径: F64,)\n点\n\nf|func(x: 形状,) -> (F64,):\n    match x:\n        case 形状.圆(半径):\n            return 半径\n        case 形状.点:\n            return 0.0\n")
    let hit = 查体(sample, "f")
    assert(!hit.failed, "全覆盖且各臂都返回不应报错")
    assert(hit.guarantees, "枚举全覆盖应保证返回")
    return

; 匹配缺臂：只覆盖一个变体，缺的路径落空，报缺失返回。
匹配缺臂|test() -> ():
    let sample = 造体样例("[形状]\n圆(半径: F64,)\n点\n\nf|func(x: 形状,) -> (F64,):\n    match x:\n        case 形状.圆(半径):\n            return 半径\n")
    let hit = 查体(sample, "f")
    assert(len(hit.errors) == 1, "应报一条缺失返回")
    assert(!hit.guarantees, "缺变体不保证返回")
    return

; 匹配通配兜底：缺的变体由 `case _:` 补上，体保证返回。
匹配通配兜底|test() -> ():
    let sample = 造体样例("[形状]\n圆(半径: F64,)\n点\n\nf|func(x: 形状,) -> (F64,):\n    match x:\n        case 形状.圆(半径):\n            return 半径\n        case _:\n            return 0.0\n")
    let hit = 查体(sample, "f")
    assert(!hit.failed, "通配兜底不应报错")
    assert(hit.guarantees, "通配兜底应保证返回")
    return

; 循环不算返回：循环体里的 return 不保证函数返回。
循环不算返回|test() -> ():
    let sample = 造体样例("f|func(x: I32,) -> (I32,):\n    while x > 0:\n        return 1\n")
    let hit = 查体(sample, "f")
    assert(len(hit.errors) == 1, "应报一条缺失返回")
    assert(hit.returns == 1, "循环体里的 return 仍要检查")
    assert(!hit.guarantees, "循环不保证返回")
    return

; 延迟不算返回：defer 体的 return 只在退出时执行，不保证函数返回。
延迟不算返回|test() -> ():
    let sample = 造体样例("f|func() -> (I32,):\n    defer:\n        pass\n")
    let hit = 查体(sample, "f")
    assert(len(hit.errors) == 1, "应报一条缺失返回")
    assert(!hit.guarantees, "defer 不保证返回")
    return

; 嵌套块返回：内外两层 if 都补齐 else，体保证返回。
嵌套块返回|test() -> ():
    let sample = 造体样例("f|func(x: I32,) -> (I32,):\n    if x > 0:\n        if x > 1:\n            return 1\n        else:\n            return 2\n    else:\n        return 3\n")
    let hit = 查体(sample, "f")
    assert(!hit.failed, "嵌套两支都返回不应报错")
    assert(hit.returns == 3, "应检查三条 return")
    assert(hit.guarantees, "嵌套覆盖应保证返回")
    return

; 返回类型未知：标注在但解析失败时按待定放过，不报缺返回也不报值类型。
返回类型未知|test() -> ():
    let sample = 造体样例("f|func() -> (不存在,):\n    return 1\n")
    let hit = 查体(sample, "f")
    assert(hit.deferred, "类型未知应判作待定")
    assert(!hit.failed, "待定不应报错")
    return

; 体检查两次：同一输入两次得到同一组错误与返回读数。
体检查两次|test() -> ():
    let sample = 造体样例("f|func(x: I32,) -> (I32,):\n    if x > 0:\n        return 1\n")
    let first = 查体(sample, "f")
    let second = 查体(sample, "f")
    assert(len(first.errors) == len(second.errors), "错误数应相同")
    assert(first.guarantees == second.guarantees, "返回读数应相同")
    assert(first.errors[0].name == second.errors[0].name, "错误名字应相同")
    return
