[foreign_type_test|import]
_module_loader = "../../module-loader"

; 造判型单元：解析失败即断言，路径决定包归属。
造判型单元|func(path: String, text: String,) -> (CompilationUnit,):
    let loaded = loadUnit(path = path, text = text)
    assert(!loaded.failed, "样例应可解析：" + path)
    return loaded.unit

; 判型采样：类型表与判型结果一起带回，两次查询共用同一份池。
(ForeignTypeSample)
types: TypeTable = TypeTable()
check: ForeignTypeCheck = ForeignTypeCheck()

; 采样：先注册再解析类型，最后跑外部判型。
判型采样|func(units: Array<CompilationUnit>,) -> (ForeignTypeSample,):
    let symbols = registerPackage(units)
    let types = resolvePackage(units = units, table = symbols)
    var out = ForeignTypeSample()
    out.types = types
    out.check = checkForeignPackage(units = units, types = types)
    return out

; 错误摘要：前几条按类别与名字连接，断言失败时能看出是哪一类。
判型摘要|func(_check: ForeignTypeCheck,) -> (String,):
    var out = ""
    var i = 0
    while i < len(_check.errors) && i < 4:
        if i > 0:
            out = out + " / "
        out = out + foreignTypeErrorName(_check.errors[i].kind) + "(" + _check.errors[i].name + ")"
        i = i + 1
    return out

; 白名单正例：标量、指针、借出串、句柄、回调、变参数据与数据符号各一条；句柄进池且只在 C 面成立。
白名单正例|test() -> ():
    let 文本 = "[libc|foreign]\nmalloc: (I64,) -> (*I8,)\nmemcpy: (*I8, *I8, I64,) -> ()\nstrlen: (String,) -> (U64,)\nhandle: (String,) -> (StringHandle,)\nclose: (StringHandle,) -> ()\nflag: () -> (Bool,)\nqsort: (*U8, U64, U64, (*U8, *U8,) -> (I32,),) -> ()\nprintf|varargs: (String,) -> (I32,)\nerrno|readonly: I32\nLIMIT|macro: I32\n"
    let 单元 = 造判型单元(path = "packages/p/src/api/a.pini", text = 文本)
    let 采样 = 判型采样(units = [单元])
    assert(采样.types.isOK(), "类型池不应有错：" + 判型摘要(采样.check))
    assert(采样.check.isOK(), "白名单正例不应有错：" + 判型摘要(采样.check))
    assert(采样.types.bindingCount() == 10, "十条符号各留一条绑定")
    let 块 = 单元.ast.decls[单元.ast.items[0]]
    assert(采样.types.textOf(unit = 0, decl = 块.kids[0]) == "(I64,) -> *I8", "函数签名文本")
    let 句柄形 = 采样.types.typeOf(unit = 0, decl = 块.kids[3])
    let 句柄型 = 采样.types.pool.entries[句柄形].ret
    assert(isTypeClass(kind = 采样.types.pool.entries[句柄型].kind, expected = .typeClassOpaque), "句柄是不透明类别")
    assert(采样.types.textOf(unit = 0, decl = 块.kids[3]) == "(String,) -> StringHandle", "句柄签名文本")
    return

; 宽度四类：I16 / U16 / U32 / F32 各报宽度码，不落进「不可表示」。
宽度四类|test() -> ():
    let 文本 = "[libc|foreign]\na: I16\nb: U16\nc: U32\nd: F32\n"
    let 采样 = 判型采样(units = [造判型单元(path = "packages/p/src/api/a.pini", text = 文本)])
    assert(采样.check.errorCount() == 4, "四条宽度错误，实得 " + 判型摘要(采样.check))
    var i = 0
    while i < 4:
        assert(isForeignTypeError(error = 采样.check.errorAt(i), kind = .foreignTypeWidthNotInIR), "第 " + "\(i)" + " 条应是宽度码")
        i = i + 1
    return

; 非 C 标量：Char 与用户结构体都不可表示，结构体按值没有 C 布局。
非C标量|test() -> ():
    let 文本 = "(S)\nx: I32 = 0\n\n[libc|foreign]\nc: Char\nd: S\n"
    let 采样 = 判型采样(units = [造判型单元(path = "packages/p/src/api/a.pini", text = 文本)])
    assert(采样.check.errorCount() == 2, "两条不可表示，实得 " + 判型摘要(采样.check))
    assert(isForeignTypeError(error = 采样.check.errorAt(0), kind = .foreignTypeNotRepresentable), "Char 不可表示")
    assert(采样.check.errorAt(0).name == "c", "首个符号名")
    assert(采样.check.errorAt(1).detail.contains("按值结构体"), "结构体理由")
    return

; String 位置：形参借出成立；返回位与数据位各自报一条。
String位置|test() -> ():
    let 文本 = "[libc|foreign]\nparam: (String,) -> ()\nret: (I32,) -> (String,)\ndata: String\n"
    let 采样 = 判型采样(units = [造判型单元(path = "packages/p/src/api/a.pini", text = 文本)])
    assert(采样.check.errorCount() == 2, "两条 String 位置错误，实得 " + 判型摘要(采样.check))
    assert(isForeignTypeError(error = 采样.check.errorAt(0), kind = .foreignStringInReturn), "返回位单列")
    assert(采样.check.errorAt(0).name == "ret", "返回位符号名")
    assert(isForeignTypeError(error = 采样.check.errorAt(1), kind = .foreignTypeNotRepresentable), "数据位不可表示")
    return

; 句柄位置：形参与返回都成立；数据位与指针目标都不行。
句柄位置|test() -> ():
    let 文本 = "[libc|foreign]\nhandle: (String,) -> (StringHandle,)\ndata: StringHandle\nptr: *StringHandle\n"
    let 采样 = 判型采样(units = [造判型单元(path = "packages/p/src/api/a.pini", text = 文本)])
    assert(采样.types.isOK(), "句柄进池不应报未知类型")
    assert(采样.check.errorCount() == 2, "两条句柄位置错误，实得 " + 判型摘要(采样.check))
    assert(采样.check.errorAt(0).name == "data", "数据位符号名")
    assert(采样.check.errorAt(1).name == "ptr", "指针位符号名")
    assert(isForeignTypeError(error = 采样.check.errorAt(1), kind = .foreignTypeNotRepresentable), "句柄不能再套指针")
    return

; 指针目标：目标按同一张白名单判，String 与宽度例外各走各的码。
指针目标|test() -> ():
    let 文本 = "[libc|foreign]\ns: *String\nw: *U32\nnested: **I8\n"
    let 采样 = 判型采样(units = [造判型单元(path = "packages/p/src/api/a.pini", text = 文本)])
    assert(采样.check.errorCount() == 2, "两条指针目标错误，实得 " + 判型摘要(采样.check))
    assert(isForeignTypeError(error = 采样.check.errorAt(0), kind = .foreignTypeNotRepresentable), "String 不能作目标")
    assert(isForeignTypeError(error = 采样.check.errorAt(1), kind = .foreignTypeWidthNotInIR), "U32 目标是宽度码")
    return

; 回调边界：函数类型只作形参；回调形参与返回只收标量与指针，Bool 单列。
回调边界|test() -> ():
    let 文本 = "[libc|foreign]\nretfn: (I32,) -> ((I32,) -> (),)\nbad: (*U8, (*U8,) -> (Bool,),) -> ()\nstr: ((String,) -> (),) -> ()\n"
    let 采样 = 判型采样(units = [造判型单元(path = "packages/p/src/api/a.pini", text = 文本)])
    assert(采样.check.errorCount() == 3, "三条回调错误，实得 " + 判型摘要(采样.check))
    assert(isForeignTypeError(error = 采样.check.errorAt(0), kind = .foreignCallbackOutsideParameter), "返回位函数单列")
    assert(isForeignTypeError(error = 采样.check.errorAt(1), kind = .foreignCallbackBoolean), "回调 Bool 单列")
    assert(isForeignTypeError(error = 采样.check.errorAt(2), kind = .foreignTypeNotRepresentable), "回调 String 不可表示")
    return

; 元组边界：空元组只在返回位成立；其余元组与空元组数据位都不可表示。
元组边界|test() -> ():
    let 文本 = "[libc|foreign]\nok: (I32,) -> ()\nparam: ((I32, I64,),) -> ()\ndata: (I32, I64,)\nempty: ()\n"
    let 采样 = 判型采样(units = [造判型单元(path = "packages/p/src/api/a.pini", text = 文本)])
    assert(采样.check.errorCount() == 3, "三条元组错误，实得 " + 判型摘要(采样.check))
    assert(采样.check.errorAt(0).name == "param", "形参元组")
    assert(采样.check.errorAt(1).name == "data", "数据元组")
    assert(采样.check.errorAt(2).name == "empty", "空元组数据位")
    return

; 标志三分：未知、重复与放错位置各报一条；正确的变参函数不报。
标志三分|test() -> ():
    let 文本 = "[libc|foreign]\nunknown|inline: I32\ndup|readonly|readonly: I32\nfn|readonly: (I32,) -> ()\ndata|varargs: I32\nok|varargs: (String,) -> (I32,)\n"
    let 采样 = 判型采样(units = [造判型单元(path = "packages/p/src/api/a.pini", text = 文本)])
    assert(采样.check.errorCount() == 4, "四条标志错误，实得 " + 判型摘要(采样.check))
    assert(isForeignTypeError(error = 采样.check.errorAt(0), kind = .foreignFlagUnknown), "未知标志")
    assert(采样.check.errorAt(0).name == "inline", "未知标志原文")
    assert(isForeignTypeError(error = 采样.check.errorAt(1), kind = .foreignFlagDuplicated), "重复标志")
    assert(isForeignTypeError(error = 采样.check.errorAt(2), kind = .foreignFlagMisplaced), "只读落在函数上")
    assert(isForeignTypeError(error = 采样.check.errorAt(3), kind = .foreignVarargsOnNonFunction), "变参落在数据上")
    return

; 宏蕴含只读：`macro` 与 `macro|readonly` 合并成同一组，规范化后仍带两项。
宏蕴含只读|test() -> ():
    let 甲 = 造判型单元(path = "packages/p/src/api/a.pini", text = "[libc|foreign]\nLIMIT|macro: I32\n")
    let 乙 = 造判型单元(path = "packages/p/src/api/b.pini", text = "[libc|foreign]\nLIMIT|macro|readonly: I32\n")
    let 表 = registerPackage([甲, 乙])
    assert(表.isOK(), "同一组标志应合并")
    assert(表.symbolCount() == 1, "只留一份")
    assert(containsFlagText(items = 表.symbolAt(0).foreignFlags, name = "readonly"), "宏蕴含只读")
    return

; 句柄面外：结构字段写句柄即报「名字只在外部面成立」，类型池不静默放行。
句柄面外|test() -> ():
    let 单元 = 造判型单元(path = "packages/p/src/api/a.pini", text = "(P)\nh: StringHandle\n")
    let 表 = registerPackage([单元])
    let 类型 = resolvePackage(units = [单元], table = 表)
    assert(!类型.isOK(), "面外句柄应报错")
    assert(isTypeError(error = 类型.errorAt(0), kind = .typeErrorForeignOnlyName), "类别为仅外部面可用")
    assert(类型.errorAt(0).name == "StringHandle", "错误带名字")
    return

; 串取回：`fromCString` 是内建，接 `*U8` 返回 String；句柄不参与这条路径。
串取回内建|test() -> ():
    let 函数表 = builtinFunctionTable()
    let at = findBuiltinFunction(functions = 函数表, name = "fromCString")
    assert(at >= 0, "fromCString 应在内建表")
    assert(len(函数表[at].params) == 1, "一个形参")
    assert(isBuiltinShape(shape = 函数表[at].params[0].shape, expected = .builtinPointerU8), "形参是 *U8")
    assert(isBuiltinShape(shape = 函数表[at].ret, expected = .builtinString), "返回 String")
    return

; 次序无关：两个单元正序与逆序判型，错误条数与首条文件相同。
判型次序无关|test() -> ():
    let 甲 = 造判型单元(path = "packages/p/src/api/a.pini", text = "[libc|foreign]\na: I16\n")
    let 乙 = 造判型单元(path = "packages/p/src/api/b.pini", text = "[libc|foreign]\nb: U32\n")
    let 正 = 判型采样(units = [甲, 乙])
    let 逆 = 判型采样(units = [乙, 甲])
    assert(正.check.errorCount() == 2 && 逆.check.errorCount() == 2, "两序都应报两条")
    assert(正.check.errorAt(0).file == 逆.check.errorAt(0).file, "首条文件应相同")
    assert(正.check.errorAt(0).offset == 逆.check.errorAt(0).offset, "首条偏移应相同")
    return
