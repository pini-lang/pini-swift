; 标量结果：驻留后的池与下标一起带回；容器用例从它起步。
(标量结果)
pool: TypePool = TypePool()
id: I32 = -1

; 造标量：按名字驻留，池只增不改。
造标量|func(pool: TypePool, name: String,) -> (标量结果,):
    let inserted = intern(pool = pool, kind = .typeClassScalar, name = name, kids = [], ret = -1)
    var out = 标量结果()
    out.pool = inserted.pool
    out.id = inserted.id
    return out

; 表项齐全：三类所有者各有条目，未知名字一律未命中。
内建表齐全|test() -> ():
    let members = builtinMemberTable()
    assert(len(members) >= 20, "条目数应覆盖全部成员，实得 \(len(members))")
    assert(findBuiltin(members = members, owner = "String", name = "contains") >= 0, "String.contains 应在表内")
    assert(findBuiltin(members = members, owner = "String", name = "getUnchecked") >= 0, "String.getUnchecked 应在表内")
    assert(findBuiltin(members = members, owner = "Array", name = "append") >= 0, "Array.append 应在表内")
    assert(findBuiltin(members = members, owner = "Array", name = "pop") >= 0, "Array.pop 应在表内")
    assert(findBuiltin(members = members, owner = "Dictionary", name = "get") >= 0, "Dictionary.get 应在表内")
    assert(findBuiltin(members = members, owner = "Set", name = "get") < 0, "集没有成员面")
    assert(findBuiltin(members = members, owner = "Array", name = "shuffle") < 0, "未登记的名字不命中")
    return

; 字符串成员：返回类型固定，拆分得到字符串数组。
字符串成员类型|test() -> ():
    var pool = TypePool()
    let text = 造标量(pool = pool, name = "String")
    let members = builtinMemberTable()
    let contains = findBuiltin(members = members, owner = "String", name = "contains")
    let containsType = builtinShapeType(pool = text.pool, shape = members[contains].ret, kids = [])
    assert(typeText(pool = containsType.pool, id = containsType.id) == "Bool", "contains 应回 Bool")
    let split = findBuiltin(members = members, owner = "String", name = "split")
    let splitType = builtinShapeType(pool = text.pool, shape = members[split].ret, kids = [])
    assert(typeText(pool = splitType.pool, id = splitType.id) == "Array<String>", "split 应回 Array<String>")
    let get = findBuiltin(members = members, owner = "String", name = "get")
    let getType = builtinShapeType(pool = text.pool, shape = members[get].ret, kids = [])
    assert(typeText(pool = getType.pool, id = getType.id) == "Char?", "get 应回 Char?")
    return

; 数组成员：元素类型按接收者实参回填，弹出得到数组与元素组成的元组。
数组成员类型|test() -> ():
    var pool = TypePool()
    let elem = 造标量(pool = pool, name = "I32")
    let array = intern(pool = elem.pool, kind = .typeClassCollection, name = "Array", kids = [elem.id], ret = -1)
    let members = builtinMemberTable()
    let append = findBuiltin(members = members, owner = "Array", name = "append")
    let appended = builtinShapeType(pool = array.pool, shape = members[append].ret, kids = [elem.id])
    assert(typeText(pool = appended.pool, id = appended.id) == "Array<I32>", "append 应回 Array<I32>")
    let get = findBuiltin(members = members, owner = "Array", name = "get")
    let got = builtinShapeType(pool = appended.pool, shape = members[get].ret, kids = [elem.id])
    assert(typeText(pool = got.pool, id = got.id) == "I32?", "get 应回 I32?")
    let pop = findBuiltin(members = members, owner = "Array", name = "pop")
    let popped = builtinShapeType(pool = got.pool, shape = members[pop].ret, kids = [elem.id])
    assert(typeText(pool = popped.pool, id = popped.id) == "(Array<I32>, I32,)", "pop 应回元组")
    return

; 字典成员：值类型按第二个实参回填，取缺失键走可选。
字典成员类型|test() -> ():
    var pool = TypePool()
    let key = 造标量(pool = pool, name = "String")
    let value = 造标量(pool = key.pool, name = "I32")
    let dict = intern(pool = value.pool, kind = .typeClassCollection, name = "Dictionary", kids = [key.id, value.id], ret = -1)
    let members = builtinMemberTable()
    let get = findBuiltin(members = members, owner = "Dictionary", name = "get")
    let got = builtinShapeType(pool = dict.pool, shape = members[get].ret, kids = [key.id, value.id])
    assert(typeText(pool = got.pool, id = got.id) == "I32?", "字典 get 应回 I32?")
    let unchecked = findBuiltin(members = members, owner = "Dictionary", name = "getUnchecked")
    let raw = builtinShapeType(pool = got.pool, shape = members[unchecked].ret, kids = [key.id, value.id])
    assert(typeText(pool = raw.pool, id = raw.id) == "I32", "getUnchecked 应回 I32")
    return

; 形状名：诊断与回执共用一份拼写。
形状名|test() -> ():
    assert(builtinShapeName(.builtinPopTuple) == "数组弹出元组", "实得 " + builtinShapeName(.builtinPopTuple))
    assert(builtinShapeName(.builtinOptionalElem) == "元素可选", "实得 " + builtinShapeName(.builtinOptionalElem))
    return
