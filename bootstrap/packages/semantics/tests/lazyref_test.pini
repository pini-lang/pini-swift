[lazyref_test|import]
_syntax = "../../syntax"
_module_loader = "../../module-loader"

; 闭包与惰性引用：函数字面量定出函数类型，LazyRef 的元素取自类型实参或初值返回。
; 判据看类型文本：推导若把闭包判成标量或把元素判丢，文本会立刻不同。

; 样例：世界、单元与表达式类型表；装载到建世界五步与指针样例同序。
(惰性样例)
world: MemberWorld = MemberWorld()
unit: CompilationUnit = CompilationUnit()
types: ExprTypes = ExprTypes()

; 造惰性样例。
造惰性样例|func(_src: String,) -> (惰性样例,):
    let loaded = loadUnit(path = "packages/p/src/api/p.pini", text = _src)
    assert(!loaded.failed, "样例应可加载")
    let units = sortedUnits([loaded.unit])
    let table = registerPackage(units)
    let types = resolvePackage(units = units, table = table)
    var out = 惰性样例()
    out.world = makeMemberWorld(units = units, table = table, types = types)
    out.unit = units[0]
    out.types = makeExprTypes(units)
    return out

; 首个函数字面量：按表达式池序找第一处。
首个函数字面量|func(_unit: CompilationUnit,) -> (I32,):
    var i = 0
    while i < _unit.ast.exprCount():
        if _unit.ast.isFunctionExpr(i):
            return i
        i = i + 1
    return -1

; 首个惰性调用：按池序找第一处。
首个惰性调用|func(_unit: CompilationUnit,) -> (I32,):
    var i = 0
    while i < _unit.ast.exprCount():
        if _unit.ast.isCallExpr(i):
            return i
        i = i + 1
    return -1

; 首个成员读：按池序找第一处。
首个成员读|func(_unit: CompilationUnit,) -> (I32,):
    var i = 0
    while i < _unit.ast.exprCount():
        if _unit.ast.isMemberExpr(i):
            return i
        i = i + 1
    return -1

; 函数字面量：两个 I32 形参、I32 返回，类型文本按函数形状出。
闭包类型|test() -> ():
    let 样例 = 造惰性样例("f|func() -> ():\n    let g = func (a: I32, b: I32,) -> (I32,):\n        return a + b\n")
    let 推 = inferUnitExprs(world = 样例.world, unitIndex = 0, types = 样例.types)
    let 闭包 = 首个函数字面量(样例.unit)
    assert(闭包 >= 0, "样例应含函数字面量")
    let 文本 = typeText(pool = 推.pool, id = exprTypeAt(table = 推.types, unit = 0, node = 闭包))
    assert(文本 == "(I32, I32,) -> I32", "实得 " + 文本)
    return

; 省略类型实参：元素类型取初值闭包的返回。
推断构造|test() -> ():
    let 样例 = 造惰性样例("f|func() -> ():\n    let r = LazyRef(func () -> (I32,):\n        return 7\n    )\n")
    let 推 = inferUnitExprs(world = 样例.world, unitIndex = 0, types = 样例.types)
    let 构造 = 首个惰性调用(样例.unit)
    assert(构造 >= 0, "样例应含构造调用")
    let 文本 = typeText(pool = 推.pool, id = exprTypeAt(table = 推.types, unit = 0, node = 构造))
    assert(文本 == "LazyRef<I32>", "实得 " + 文本)
    return

; 值读：`r.value` 的元素类型是 I32，且不报成员缺失。
值读类型|test() -> ():
    let 样例 = 造惰性样例("f|func() -> ():\n    let r = LazyRef<I32>(func () -> (I32,):\n        return 7\n    )\n    print(r.value)\n")
    let 推 = inferUnitExprs(world = 样例.world, unitIndex = 0, types = 样例.types)
    let 读 = 首个成员读(样例.unit)
    assert(读 >= 0, "样例应含成员读")
    let 文本 = typeText(pool = 推.pool, id = exprTypeAt(table = 推.types, unit = 0, node = 读))
    assert(文本 == "I32", "实得 " + 文本)
    let check = checkUnitExprs(world = 样例.world, unitIndex = 0, types = 推.types)
    assert(len(check.errors) == 0, "值读不该报，实得 " + "\(len(check.errors))")
    return
