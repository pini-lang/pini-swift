[layout_test|import]
_syntax = "../../syntax"
_module_loader = "../../module-loader"

; 形态表与槽布局的检查：形态按声明读，布局只吃形态表与类型池。
; 期望值一律手写槽名与槽数，不拿实现自己算出来的数当判据。

; 布局样例：世界与单元；形态与布局都从这两样起。
(布局样例)
world: MemberWorld = MemberWorld()
unit: CompilationUnit = CompilationUnit()

; 造布局样例：装载、注册、解析类型、建世界四步，顺序不能反。
造布局样例|func(_src: String,) -> (布局样例,):
    let loaded = loadUnit(path = "packages/p/src/api/a.pini", text = src)
    assert(!loaded.failed, "样例应可加载")
    let units = [loaded.unit]
    let table = registerPackage(units)
    let types = resolvePackage(units = units, table = table)
    var out = 布局样例()
    out.world = makeMemberWorld(units = units, table = table, types = types)
    out.unit = loaded.unit
    return out

; 槽名串：逐槽名字以斜杠连接，用于整串比对。
布局槽名串|func(_entry: LayoutEntry,) -> (String,):
    var out = ""
    var i = 0
    while i < len(entry.slots):
        if i > 0:
            out = out + "/"
        out = out + entry.slots[i].name
        i = i + 1
    return out

; 槽位：按序号取一格，越界是运行时陷阱，调用方先看槽数。
布局槽|func(entry: LayoutEntry, index: I32,) -> (Slot,):
    return entry.slots[index]

; 取布局：按类型名先取形态，再折槽表。
取布局|func(sample: 布局样例, typeId: I32,) -> (LayoutEntry,):
    let shapes = makeShapeTable(sample.world)
    return layoutOf(shapes = shapes, pool = sample.world.types.pool, typeId = typeId)

; 空结构：只有头四格，字段槽一个也不加。
空结构|test() -> ():
    let sample = 造布局样例("(空)\n\nf|func() -> ():\n    pass\n")
    let 空 = nominalTypeId(world = sample.world, name = "空")
    assert(空 >= 0, "结构应已驻留")
    let entry = 取布局(sample = sample, typeId = 空)
    assert(entry.slotCount == 4, "实得 " + countText(entry.slotCount))
    assert(布局槽名串(entry) == "强计数/弱计数/类型标识/弱引用旁表", "实得 " + 布局槽名串(entry))
    return

; 单字段：字段落在第 4 槽，类型照抄声明标注。
单字段|test() -> ():
    let sample = 造布局样例("(点)\nx: I32 = 0\n\ny|func() -> ():\n    pass\n")
    let 点 = nominalTypeId(world = sample.world, name = "点")
    let entry = 取布局(sample = sample, typeId = 点)
    assert(entry.slotCount == 5, "实得 " + countText(entry.slotCount))
    let slot = 布局槽(entry = entry, index = 4)
    assert(slot.name == "x", "实得 " + slot.name)
    assert(isSlotRole(role = slot.role, expected = slotField), "实得 " + slotRoleName(slot.role))
    assert(typeText(pool = sample.world.types.pool, id = slot.typeId) == "I32", "实得 " + typeText(pool = sample.world.types.pool, id = slot.typeId))
    return

; 嵌套结构：字段占一格，值本身仍是聚合；内层按自己的声明序排。
嵌套结构|test() -> ():
    let sample = 造布局样例("(点)\nx: I32 = 0\ny: I32 = 0\n\n(线)\n起点: 点\n终点: 点\n\nf|func() -> ():\n    pass\n")
    let 点 = nominalTypeId(world = sample.world, name = "点")
    let 线 = nominalTypeId(world = sample.world, name = "线")
    let outer = 取布局(sample = sample, typeId = 线)
    assert(outer.slotCount == 6, "实得 " + countText(outer.slotCount))
    assert(typeText(pool = sample.world.types.pool, id = 布局槽(entry = outer, index = 4).typeId) == "点", "实得 " + typeText(pool = sample.world.types.pool, id = 布局槽(entry = outer, index = 4).typeId))
    assert(typeText(pool = sample.world.types.pool, id = 布局槽(entry = outer, index = 5).typeId) == "点", "实得 " + typeText(pool = sample.world.types.pool, id = 布局槽(entry = outer, index = 5).typeId))
    assert(取布局(sample = sample, typeId = 点).slotCount == 6, "内层仍按自己的字段数")
    return

; 两用例枚举：标签在第 4 槽，载荷窗口按最宽用例占位。
两用例枚举|test() -> ():
    let sample = 造布局样例("[形状]\n圆(半径: F64,)\n点\n\nf|func() -> ():\n    pass\n")
    let 形状 = nominalTypeId(world = sample.world, name = "形状")
    let entry = 取布局(sample = sample, typeId = 形状)
    assert(entry.slotCount == 6, "实得 " + countText(entry.slotCount))
    assert(isSlotRole(role = 布局槽(entry = entry, index = 4).role, expected = slotCaseTag), "第 4 槽应是用例标签")
    assert(isSlotRole(role = 布局槽(entry = entry, index = 5).role, expected = slotPayload), "第 5 槽应是载荷")
    assert(len(entry.cases) == 2, "实得 " + countText(len(entry.cases)))
    assert(entry.cases[0].name == "圆", "实得 " + entry.cases[0].name)
    assert(len(entry.cases[0].payload) == 1, "圆应有一格载荷")
    assert(typeText(pool = sample.world.types.pool, id = entry.cases[0].payload[0]) == "F64", "实得 " + typeText(pool = sample.world.types.pool, id = entry.cases[0].payload[0]))
    assert(len(entry.cases[1].payload) == 0, "点应无载荷")
    return

; 无载荷枚举：只有标签槽，载荷窗口为零。
无载荷枚举|test() -> ():
    let sample = 造布局样例("[开关]\n关\n开\n\nf|func() -> ():\n    pass\n")
    let 开关 = nominalTypeId(world = sample.world, name = "开关")
    let entry = 取布局(sample = sample, typeId = 开关)
    assert(entry.slotCount == 5, "实得 " + countText(entry.slotCount))
    assert(isSlotRole(role = 布局槽(entry = entry, index = 4).role, expected = slotCaseTag), "第 4 槽应是用例标签")
    return

; 头三族共用：结构、对象与枚举的前四格逐槽同名。
头三族共用|test() -> ():
    let sample = 造布局样例("(甲)\nx: I32 = 0\n\n{乙}\ny: I32 = 0\n\n[丙]\n红\n\nf|func() -> ():\n    pass\n")
    let 甲 = 取布局(sample = sample, typeId = nominalTypeId(world = sample.world, name = "甲"))
    let 乙 = 取布局(sample = sample, typeId = nominalTypeId(world = sample.world, name = "乙"))
    let 丙 = 取布局(sample = sample, typeId = nominalTypeId(world = sample.world, name = "丙"))
    var i = 0
    while i < 4:
        assert(布局槽(entry = 甲, index = i).name == 布局槽(entry = 乙, index = i).name, "结构对象第 " + countText(i) + " 槽的名不同")
        assert(布局槽(entry = 甲, index = i).name == 布局槽(entry = 丙, index = i).name, "结构枚举第 " + countText(i) + " 槽的名不同")
        i = i + 1
    return

; 可选：标签一格、载荷一格，载荷类型取实参。
可选两槽|test() -> ():
    let sample = 造布局样例("f|func() -> ():\n    pass\n")
    let 整数 = intern(pool = sample.world.types.pool, kind = typeClassScalar, name = "I32", kids = [], ret = -1)
    var world = sample.world
    world.types.pool = 整数.pool
    var args: Array<I32> = []
    args = args.append(整数.id)
    let 可选 = intern(pool = world.types.pool, kind = typeClassOptional, name = "", kids = args, ret = -1)
    world.types.pool = 可选.pool
    let entry = layoutOf(shapes = makeShapeTable(world), pool = world.types.pool, typeId = 可选.id)
    assert(entry.slotCount == 2, "实得 " + countText(entry.slotCount))
    assert(isSlotRole(role = 布局槽(entry = entry, index = 0).role, expected = slotOptionalTag), "首槽应是标签")
    assert(typeText(pool = world.types.pool, id = 布局槽(entry = entry, index = 1).typeId) == "I32", "实得 " + typeText(pool = world.types.pool, id = 布局槽(entry = entry, index = 1).typeId))
    return

; 结果：三槽，错误槽类型擦除。
结果三槽|test() -> ():
    let sample = 造布局样例("f|func() -> ():\n    pass\n")
    let 整数 = intern(pool = sample.world.types.pool, kind = typeClassScalar, name = "I32", kids = [], ret = -1)
    var world = sample.world
    world.types.pool = 整数.pool
    var args: Array<I32> = []
    args = args.append(整数.id)
    let 结果 = intern(pool = world.types.pool, kind = typeClassResult, name = "", kids = args, ret = -1)
    world.types.pool = 结果.pool
    let entry = layoutOf(shapes = makeShapeTable(world), pool = world.types.pool, typeId = 结果.id)
    assert(entry.slotCount == 3, "实得 " + countText(entry.slotCount))
    assert(typeText(pool = world.types.pool, id = 布局槽(entry = entry, index = 1).typeId) == "I32", "ok 载荷实得 " + typeText(pool = world.types.pool, id = 布局槽(entry = entry, index = 1).typeId))
    assert(布局槽(entry = entry, index = 2).typeId < 0, "错误字应擦除类型")
    return

; 字段顺序：声明次序互换必须改布局，不得被静默吞掉。
字段顺序|test() -> ():
    let first = 造布局样例("(对)\n甲: I32 = 0\n乙: I32 = 0\n\nf|func() -> ():\n    pass\n")
    let second = 造布局样例("(对)\n乙: I32 = 0\n甲: I32 = 0\n\nf|func() -> ():\n    pass\n")
    let one = 取布局(sample = first, typeId = nominalTypeId(world = first.world, name = "对"))
    let two = 取布局(sample = second, typeId = nominalTypeId(world = second.world, name = "对"))
    assert(one.slotCount == two.slotCount, "槽数应相同")
    assert(布局槽(entry = one, index = 4).name != 布局槽(entry = two, index = 4).name, "第 4 槽应按声明序换名")
    assert(布局槽名串(one) != 布局槽名串(two), "两串槽名应不同")
    return

; 只吃形态表：手工造的形态与池即可出布局，不需要语法树与源码。
只吃形态表|test() -> ():
    let pool = TypePool()
    let 整数 = intern(pool = pool, kind = typeClassScalar, name = "I32", kids = [], ret = -1)
    let 手工 = intern(pool = 整数.pool, kind = typeClassStruct, name = "手工", kids = [], ret = -1)
    var field = ShapeField()
    field.name = "格"
    field.typeId = 整数.id
    var shape = ShapeEntry()
    shape.typeId = 手工.id
    shape.kind = shapeStruct
    shape.fields = shape.fields.append(field)
    var shapes = ShapeTable()
    shapes.entries = shapes.entries.append(shape)
    let entry = layoutOf(shapes = shapes, pool = 手工.pool, typeId = 手工.id)
    assert(entry.slotCount == 5, "实得 " + countText(entry.slotCount))
    assert(布局槽(entry = entry, index = 4).name == "格", "实得 " + 布局槽(entry = entry, index = 4).name)
    return

; 未约定类别：标量不在契约的槽表里，答 -1 而不是自造一个数。
未约定类别|test() -> ():
    let sample = 造布局样例("f|func() -> ():\n    pass\n")
    let 整数 = intern(pool = sample.world.types.pool, kind = typeClassScalar, name = "I32", kids = [], ret = -1)
    let entry = layoutOf(shapes = makeShapeTable(sample.world), pool = 整数.pool, typeId = 整数.id)
    assert(entry.slotCount < 0, "实得 " + countText(entry.slotCount))
    return

; 两次一致：同一份世界建两次形态与布局，条目数与每串槽名都相同。
布局两次一致|test() -> ():
    let sample = 造布局样例("(点)\nx: I32 = 0\ny: I32 = 0\n\n[形状]\n圆(点,)\n点\n\nf|func() -> ():\n    pass\n")
    let first = layoutAll(shapes = makeShapeTable(sample.world), pool = sample.world.types.pool)
    let second = layoutAll(shapes = makeShapeTable(sample.world), pool = sample.world.types.pool)
    assert(first.count() == second.count(), "条目数应相同")
    var i = 0
    while i < first.count():
        assert(first.entryAt(i).slotCount == second.entryAt(i).slotCount, "第 " + countText(i) + " 条槽数不同")
        assert(布局槽名串(first.entryAt(i)) == 布局槽名串(second.entryAt(i)), "第 " + countText(i) + " 条槽名不同")
        i = i + 1
    return

; 既有包形状：照 support 与 syntax 的真实声明手写期望，逐槽对齐。
既有包形状|test() -> ():
    let sample = 造布局样例("(ByteSlice)\nbytes: Array<U8> = []\nstart: I32 = 0\nend: I32 = 0\n\n[SegmentKind]\nsegmentLiteral\nsegmentInterpolation\n\nf|func() -> ():\n    pass\n")
    let slice = 取布局(sample = sample, typeId = nominalTypeId(world = sample.world, name = "ByteSlice"))
    assert(slice.slotCount == 7, "实得 " + countText(slice.slotCount))
    assert(布局槽名串(slice) == "强计数/弱计数/类型标识/弱引用旁表/bytes/start/end", "实得 " + 布局槽名串(slice))
    let kind = 取布局(sample = sample, typeId = nominalTypeId(world = sample.world, name = "SegmentKind"))
    assert(kind.slotCount == 5, "实得 " + countText(kind.slotCount))
    assert(len(kind.cases) == 2, "实得 " + countText(len(kind.cases)))
    return
