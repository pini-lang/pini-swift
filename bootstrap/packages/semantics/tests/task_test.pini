[task_test|import]
_syntax = "../../syntax"
_module_loader = "../../module-loader"

; 并发：异步函数的调用方看到任务句柄，等待站点看到结算值，`ok` / `err` 造结果。
; 判据看类型文本与检查结果：句柄与结算值被混成一类时，文本会立刻不同。

; 样例：世界、单元与表达式类型表。
(任务样例)
world: MemberWorld = MemberWorld()
unit: CompilationUnit = CompilationUnit()
types: ExprTypes = ExprTypes()

; 造任务样例。
造任务样例|func(_src: String,) -> (任务样例,):
    let loaded = loadUnit(path = "packages/p/src/api/p.pini", text = _src)
    assert(!loaded.failed, "样例应可加载")
    let units = sortedUnits([loaded.unit])
    let table = registerPackage(units)
    let types = resolvePackage(units = units, table = table)
    var out = 任务样例()
    out.world = makeMemberWorld(units = units, table = table, types = types)
    out.unit = units[0]
    out.types = makeExprTypes(units)
    return out

; 首个任务调用：按表达式池序找第一处调用。
首个任务调用|func(_unit: CompilationUnit,) -> (I32,):
    var i = 0
    while i < _unit.ast.exprCount():
        if _unit.ast.isCallExpr(i):
            return i
        i = i + 1
    return -1

; 首个指名调用：被调是标识符且拼写等于给定名字；池序取第一处。
首个指名调用|func(_unit: CompilationUnit, _name: String,) -> (I32,):
    let bytes = unitBytes(_unit)
    var i = 0
    while i < _unit.ast.exprCount():
        if _unit.ast.isCallExpr(i):
            let callee = _unit.ast.childOf(id = i, index = 0)
            if callee >= 0 && _unit.ast.isIdentifierExpr(callee):
                let expr = _unit.ast.exprAt(callee)
                if decodeRange(bytes = bytes, start = expr.nameStart, end = expr.nameEnd) == _name:
                    return i
        i = i + 1
    return -1

; 首个等待：按表达式池序找第一处。
首个等待|func(_unit: CompilationUnit,) -> (I32,):
    var i = 0
    while i < _unit.ast.exprCount():
        if _unit.ast.isJoinExpr(i):
            return i
        i = i + 1
    return -1

; 异步签名：调用方拿到的是 `Future<I32>`，不是 `I32`。
异步调用类型|test() -> ():
    let 样例 = 造任务样例("子|func() => (I32,):\n    return ok(7)\n\nf|func() -> ():\n    let a = 子()\n")
    let 推 = inferUnitExprs(world = 样例.world, unitIndex = 0, types = 样例.types)
    let 调用 = 首个指名调用(样例.unit, "子")
    assert(调用 >= 0, "样例应含对 子 的调用")
    let 文本 = typeText(pool = 推.pool, id = exprTypeAt(table = 推.types, unit = 0, node = 调用))
    assert(文本 == "Future<I32>", "实得[" + 文本 + "]")
    return

; 等待站点：操作数是句柄，结果是结算值 `^I32`。
等待结果类型|test() -> ():
    let 样例 = 造任务样例("子|func() => (I32,):\n    return ok(7)\n\nf|func() -> ():\n    let a = 子()\n    let r = wait a\n")
    let 推 = inferUnitExprs(world = 样例.world, unitIndex = 0, types = 样例.types)
    let 等待 = 首个等待(样例.unit)
    assert(等待 >= 0, "样例应含等待")
    let 文本 = typeText(pool = 推.pool, id = exprTypeAt(table = 推.types, unit = 0, node = 等待))
    assert(文本 == "^I32", "实得[" + 文本 + "]")
    return

; 结果构造：`ok(7)` 与 `err("x")` 都定出 `^I32`，错误载荷不进 ok 侧。
结果构造类型|test() -> ():
    let 样例 = 造任务样例("f|func() -> ():\n    let a = ok(7)\n    let b = err(\"x\")\n")
    let 推 = inferUnitExprs(world = 样例.world, unitIndex = 0, types = 样例.types)
    let 调用 = 首个任务调用(样例.unit)
    assert(调用 >= 0, "样例应含调用")
    let 文本 = typeText(pool = 推.pool, id = exprTypeAt(table = 推.types, unit = 0, node = 调用))
    assert(文本 == "^I32", "实得[" + 文本 + "]")
    return

; 等待非句柄：操作数是整数时报一条，不静默放过。
等待非句柄|test() -> ():
    let 样例 = 造任务样例("f|func() -> ():\n    let a = wait 1\n")
    let 推 = inferUnitExprs(world = 样例.world, unitIndex = 0, types = 样例.types)
    let 检查 = checkUnitExprs(world = 样例.world, unitIndex = 0, types = 推.types)
    assert(len(检查.errors) == 1, "应报一条，实得 " + countText(len(检查.errors)))
    assert(isExprError(error = 检查.errors[0], kind = .exprCallFailed), "实得 " + exprErrorName(检查.errors[0].kind))
    return

; 结果构造缺载荷：`ok()` 报一条，不按空载荷编造结果。
结果构造缺载荷|test() -> ():
    let 样例 = 造任务样例("f|func() -> ():\n    let a = ok()\n")
    let 推 = inferUnitExprs(world = 样例.world, unitIndex = 0, types = 样例.types)
    let 检查 = checkUnitExprs(world = 样例.world, unitIndex = 0, types = 推.types)
    assert(len(检查.errors) == 1, "应报一条，实得 " + countText(len(检查.errors)))
    assert(isExprError(error = 检查.errors[0], kind = .exprCallFailed), "实得 " + exprErrorName(检查.errors[0].kind))
    return

; 类型形参：泛型声明的 T 在模板体内可解，不再报类型未声明。
类型形参可解|test() -> ():
    let 样例 = 造任务样例("(盒<T>)\n内容: T\n\n((盒<T>))\n取|self() -> (T,):\n    return self.内容\n")
    let 推 = inferUnitExprs(world = 样例.world, unitIndex = 0, types = 样例.types)
    let 检查 = checkUnitExprs(world = 样例.world, unitIndex = 0, types = 推.types)
    assert(len(检查.errors) == 0, "应零错误，实得 " + countText(len(检查.errors)))
    return
