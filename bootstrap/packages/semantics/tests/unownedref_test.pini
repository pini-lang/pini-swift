[unownedref_test|import]
_syntax = "../../syntax"
_module_loader = "../../module-loader"

; 无主引用：`unsafe UnownedRef(对象)` 的结果类型是 `UnownedRef<T>`；成员访问同样要 unsafe。
; 判据看构造点的类型文本与检查面的诊断码，不看实现细节。
(无主引用样例)
world: MemberWorld = MemberWorld()
unit: CompilationUnit = CompilationUnit()
types: ExprTypes = ExprTypes()

; 造样例：装载、排序、注册、解析类型、建世界。
造无主引用样例|func(_src: String,) -> (无主引用样例,):
    let loaded = loadUnit(path = "packages/p/src/api/p.pini", text = _src)
    assert(!loaded.failed, "样例应可加载")
    let units = sortedUnits([loaded.unit])
    let table = registerPackage(units)
    let types = resolvePackage(units = units, table = table)
    var out = 无主引用样例()
    out.world = makeMemberWorld(units = units, table = table, types = types)
    out.unit = units[0]
    out.types = makeExprTypes(units)
    return out

; 检查用的世界：把推导期新驻留的类型池接进去 —— 泛型实例的类型下标在推导时才产生，
; 拿原世界去查会因池太短而查不到接收者类型。
接推导池|func(world: MemberWorld, pool: TypePool,) -> (MemberWorld,):
    var out = world
    var table = out.types
    table.pool = pool
    out.types = table
    return out

; 构造点：按池序找第一处类型文本为 `UnownedRef<元素>` 的调用。
有无主引用构造|func(unit: CompilationUnit, pool: TypePool, types: ExprTypes,) -> (Bool,):
    var i = 0
    while i < unit.ast.exprCount():
        if unit.ast.isCallExpr(i):
            let 型 = exprTypeAt(table = types, unit = 0, node = i)
            if 型 >= 0:
                let 文本 = typeText(pool = pool, id = 型)
                if 文本 == "UnownedRef<节点>":
                    return true
        i = i + 1
    return false

; 构造与成员访问的类型：构造点答 UnownedRef<节点>，合法程序零诊断。
无主引用类型|test() -> ():
    let 样例 = 造无主引用样例("{节点}\n值: I32 = 0\n\n写|unsafe(_目标: UnownedRef<节点>, _新值: I32,) -> ():\n    _目标.值 = _新值\n    return\n\nf|func() -> ():\n    let n = 节点()\n    let u = unsafe UnownedRef(n)\n    print(unsafe u.值)\n    写(u, 1)\n    return\n")
    let 推 = inferUnitExprs(world = 样例.world, unitIndex = 0, types = 样例.types)
    assert(有无主引用构造(unit = 样例.unit, pool = 推.pool, types = 推.types), "构造点应推得 UnownedRef<节点>")
    let check = checkUnitExprs(world = 接推导池(world = 样例.world, pool = 推.pool), unitIndex = 0, types = 推.types)
    assert(len(check.errors) == 0, "合法无主引用不该报，实得 " + "\(len(check.errors))")
    return

; 非对象取无主引用：结构没有可借的对象箱，检查面报 E4-043。
无主引用只收对象|test() -> ():
    let 样例 = 造无主引用样例("(点)\nx: I32 = 0\n\nf|func() -> ():\n    let p = 点()\n    let u = unsafe UnownedRef(p)\n    return\n")
    let 推 = inferUnitExprs(world = 样例.world, unitIndex = 0, types = 样例.types)
    let check = checkUnitExprs(world = 接推导池(world = 样例.world, pool = 推.pool), unitIndex = 0, types = 推.types)
    assert(len(check.errors) == 1, "应报一条，实得 " + "\(len(check.errors))")
    assert(check.errors[0].code == "E4-043", "实得 " + check.errors[0].code)
    return

; 成员访问缺 unsafe：解引用不在不安全区间内，检查面报 E4-001。
无主引用要unsafe|test() -> ():
    let 样例 = 造无主引用样例("{节点}\n值: I32 = 0\n\nf|func() -> ():\n    let n = 节点()\n    let u: UnownedRef<节点> = unsafe UnownedRef(n)\n    print(u.值)\n    return\n")
    let 推 = inferUnitExprs(world = 样例.world, unitIndex = 0, types = 样例.types)
    let check = checkUnitExprs(world = 接推导池(world = 样例.world, pool = 推.pool), unitIndex = 0, types = 推.types)
    assert(len(check.errors) == 1, "应报一条，实得 " + "\(len(check.errors))")
    assert(check.errors[0].code == "E4-001", "实得 " + check.errors[0].code)
    return
