[container_test|import]
_syntax = "../../syntax"
_module_loader = "../../module-loader"

; 容器样例：单元、类型池与表达式类型表；判定只带节点下标与期望。
(容器样例)
unit: CompilationUnit = CompilationUnit()
types: ExprTypes = ExprTypes()
pool: TypePool = TypePool()

; 造容器样例：只装载不注册，容器判定不需要符号表。
造容器样例|func(src: String,) -> (容器样例,):
    let loaded = loadUnit("packages/p/src/api/a.pini", src)
    assert(!loaded.failed, "样例应可加载")
    var out = 容器样例()
    out.unit = loaded.unit
    out.types = makeExprTypes([loaded.unit])
    out.pool = TypePool()
    return out

; 首值：首个语句的右值节点；样例统一写成 `let x = …`。
首值|func(unit: CompilationUnit,) -> (I32,):
    return unit.ast.stmtChild(0, 1)

; 类型号：样例连同新下标一起带回。
(容器号)
sample: 容器样例 = 容器样例()
id: I32 = -1

; 容器标量：按名字驻留标量，池只增不改。
容器标量|func(sample: 容器样例, name: String,) -> (容器号,):
    let inserted = intern(sample.pool, typeClassScalar, name, [], -1)
    var out = 容器号()
    out.sample = sample
    out.sample.pool = inserted.pool
    out.id = inserted.id
    return out

; 容器类型：按名字与实参驻留集合类类型。
容器类型|func(sample: 容器样例, name: String, kids: Array<I32>,) -> (容器号,):
    let inserted = intern(sample.pool, typeClassCollection, name, kids, -1)
    var out = 容器号()
    out.sample = sample
    out.sample.pool = inserted.pool
    out.id = inserted.id
    return out

; 数组字面量：元素逐个补判为 I32，结果驻留 Array<I32>。
数组字面量|test() -> ():
    let sample = 造容器样例("main|func() -> ():\n    let x = [1, 2, 3,]\n    return\n")
    let node = 首值(sample.unit)
    let hit = checkArrayLiteral(sample.unit, 0, node, noExpectation(), sample.pool, sample.types)
    assert(!hit.failed, "数组字面量应通过")
    assert(typeText(hit.pool, hit.typeId) == "Array<I32>", "实得 " + typeText(hit.pool, hit.typeId))
    let children = sample.unit.ast.exprAt(node).kids
    assert(exprTypeAt(hit.types, 0, children[0]) >= 0, "首元素应已定型")
    assert(typeText(hit.pool, exprTypeAt(hit.types, 0, children[1])) == "I32", "次元素应为 I32")
    return

; 元素不一致：整数与字符串不能合并，报类型不匹配。
元素不一致|test() -> ():
    let sample = 造容器样例("main|func() -> ():\n    let x = [1, \"a\",]\n    return\n")
    let node = 首值(sample.unit)
    let hit = checkArrayLiteral(sample.unit, 0, node, noExpectation(), sample.pool, sample.types)
    assert(hit.failed, "元素不一致应报错")
    assert(containerErrorCode(hit.error.kind) == "E4-001", "实得 " + containerErrorCode(hit.error.kind))
    return

; 跨族数值：整型与浮点之间不隐式提升，同样报类型不匹配。
跨族数值|test() -> ():
    let sample = 造容器样例("main|func() -> ():\n    let x = [1, 2.5,]\n    return\n")
    let node = 首值(sample.unit)
    let hit = checkArrayLiteral(sample.unit, 0, node, noExpectation(), sample.pool, sample.types)
    assert(hit.failed, "跨族数值应报错")
    assert(containerErrorCode(hit.error.kind) == "E4-001", "实得 " + containerErrorCode(hit.error.kind))
    return

; 同族提升：I32 与 I64 合并成 I64，元素类型由表里的既有判定提供。
同族提升|test() -> ():
    var sample = 造容器样例("main|func() -> ():\n    let x = [a, b,]\n    return\n")
    let 窄 = 容器标量(sample, "I32")
    sample = 窄.sample
    let 宽 = 容器标量(sample, "I64")
    sample = 宽.sample
    let node = 首值(sample.unit)
    let children = sample.unit.ast.exprAt(node).kids
    sample.types = writeExprType(sample.types, 0, children[0], 窄.id)
    sample.types = writeExprType(sample.types, 0, children[1], 宽.id)
    let hit = checkArrayLiteral(sample.unit, 0, node, noExpectation(), sample.pool, sample.types)
    assert(!hit.failed, "同族数值应合并")
    assert(typeText(hit.pool, hit.typeId) == "Array<I64>", "实得 " + typeText(hit.pool, hit.typeId))
    return

; 空数组无期望：元素与期望都没有，报无法推断。
空数组无期望|test() -> ():
    let sample = 造容器样例("main|func() -> ():\n    let x = []\n    return\n")
    let node = 首值(sample.unit)
    let hit = checkArrayLiteral(sample.unit, 0, node, noExpectation(), sample.pool, sample.types)
    assert(hit.failed, "空数组无期望应报错")
    assert(containerErrorCode(hit.error.kind) == "E4-003", "实得 " + containerErrorCode(hit.error.kind))
    return

; 空数组有期望：直接取期望类型，不驻留新条目之外的东西。
空数组有期望|test() -> ():
    let sample = 造容器样例("main|func() -> ():\n    let x: Array<I32> = []\n    return\n")
    let 整数 = 容器标量(sample, "I32")
    let 数组 = 容器类型(整数.sample, "Array", [整数.id])
    let node = 首值(数组.sample.unit)
    let hit = checkArrayLiteral(数组.sample.unit, 0, node, expectType(数组.id), 数组.sample.pool, 数组.sample.types)
    assert(!hit.failed, "空数组有期望应通过")
    assert(hit.typeId == 数组.id, "结果应取期望类型")
    return

; 期望下传：元素按期望的浮点类型补判，整数元素不再停在自己的缺省类型上。
期望下传|test() -> ():
    let sample = 造容器样例("main|func() -> ():\n    let x: Array<F64> = [1, 2.5,]\n    return\n")
    let 浮点 = 容器标量(sample, "F64")
    let 数组 = 容器类型(浮点.sample, "Array", [浮点.id])
    let node = 首值(数组.sample.unit)
    let hit = checkArrayLiteral(数组.sample.unit, 0, node, expectType(数组.id), 数组.sample.pool, 数组.sample.types)
    assert(!hit.failed, "期望下传应通过")
    assert(hit.typeId == 数组.id, "结果应取期望类型")
    assert(exprTypeAt(hit.types, 0, 数组.sample.unit.ast.exprAt(node).kids[0]) == 浮点.id, "首元素应按期望定成 F64")
    return

; 字典字面量：键与值各自统一，结果驻留 Dictionary<String, I32>。
字典字面量|test() -> ():
    let sample = 造容器样例("main|func() -> ():\n    let x = {\"k\" = 1, \"j\" = 2,}\n    return\n")
    let node = 首值(sample.unit)
    let hit = checkDictionaryLiteral(sample.unit, 0, node, noExpectation(), sample.pool, sample.types)
    assert(!hit.failed, "字典字面量应通过")
    assert(typeText(hit.pool, hit.typeId) == "Dictionary<String, I32>", "实得 " + typeText(hit.pool, hit.typeId))
    return

; 字典键不一致：字符串键与整数键不能合并。
字典键不一致|test() -> ():
    let sample = 造容器样例("main|func() -> ():\n    let x = {\"k\" = 1, 2 = 2,}\n    return\n")
    let node = 首值(sample.unit)
    let hit = checkDictionaryLiteral(sample.unit, 0, node, noExpectation(), sample.pool, sample.types)
    assert(hit.failed, "键不一致应报错")
    assert(containerErrorCode(hit.error.kind) == "E4-001", "实得 " + containerErrorCode(hit.error.kind))
    return

; 集合字面量：非空按元素统一，空集合取期望；两者都缺时报无法推断。
集合字面量|test() -> ():
    let sample = 造容器样例("main|func() -> ():\n    let x = {1, 2,}\n    return\n")
    let node = 首值(sample.unit)
    let hit = checkSetLiteral(sample.unit, 0, node, noExpectation(), sample.pool, sample.types)
    assert(!hit.failed, "集合字面量应通过")
    assert(typeText(hit.pool, hit.typeId) == "Set<I32>", "实得 " + typeText(hit.pool, hit.typeId))
    let empty = 造容器样例("main|func() -> ():\n    let x: Set<I32> = {}\n    return\n")
    let 整数 = 容器标量(empty, "I32")
    let 集合 = 容器类型(整数.sample, "Set", [整数.id])
    let emptyNode = 首值(集合.sample.unit)
    let bound = checkSetLiteral(集合.sample.unit, 0, emptyNode, expectType(集合.id), 集合.sample.pool, 集合.sample.types)
    assert(!bound.failed, "空集合有期望应通过")
    assert(bound.typeId == 集合.id, "结果应取期望类型")
    let free = 造容器样例("main|func() -> ():\n    let x = {}\n    return\n")
    let bare = checkSetLiteral(free.unit, 0, 首值(free.unit), noExpectation(), free.pool, free.types)
    assert(bare.failed, "空集合无期望应报错")
    assert(containerErrorCode(bare.error.kind) == "E4-003", "实得 " + containerErrorCode(bare.error.kind))
    return

; 下标数组：接收者与下标各自定型，结果取元素类型。
下标数组|test() -> ():
    var sample = 造容器样例("main|func() -> ():\n    let x = a[0]\n    return\n")
    let 整数 = 容器标量(sample, "I32")
    sample = 整数.sample
    let 数组 = 容器类型(sample, "Array", [整数.id])
    sample = 数组.sample
    let node = 首值(sample.unit)
    sample.types = writeExprType(sample.types, 0, sample.unit.ast.exprAt(node).kids[0], 数组.id)
    let hit = checkSubscript(sample.unit, 0, node, sample.pool, sample.types)
    assert(!hit.failed, "数组下标应通过")
    assert(typeText(hit.pool, hit.typeId) == "I32", "实得 " + typeText(hit.pool, hit.typeId))
    assert(exprTypeAt(hit.types, 0, sample.unit.ast.exprAt(node).kids[1]) == 整数.id, "下标应按 I32 补判")
    return

; 下标字符串：字符串按字节取字符，结果是 Char。
下标字符串|test() -> ():
    var sample = 造容器样例("main|func() -> ():\n    let x = s[0]\n    return\n")
    let 文本 = 容器标量(sample, "String")
    sample = 文本.sample
    let node = 首值(sample.unit)
    sample.types = writeExprType(sample.types, 0, sample.unit.ast.exprAt(node).kids[0], 文本.id)
    let hit = checkSubscript(sample.unit, 0, node, sample.pool, sample.types)
    assert(!hit.failed, "字符串下标应通过")
    assert(typeText(hit.pool, hit.typeId) == "Char", "实得 " + typeText(hit.pool, hit.typeId))
    return

; 下标字典：键按字典的键类型补判，结果取值类型。
下标字典|test() -> ():
    var sample = 造容器样例("main|func() -> ():\n    let x = d[\"k\"]\n    return\n")
    let 键 = 容器标量(sample, "String")
    sample = 键.sample
    let 值 = 容器标量(sample, "I32")
    sample = 值.sample
    let 字典 = 容器类型(sample, "Dictionary", [键.id, 值.id])
    sample = 字典.sample
    let node = 首值(sample.unit)
    sample.types = writeExprType(sample.types, 0, sample.unit.ast.exprAt(node).kids[0], 字典.id)
    let hit = checkSubscript(sample.unit, 0, node, sample.pool, sample.types)
    assert(!hit.failed, "字典下标应通过")
    assert(typeText(hit.pool, hit.typeId) == "I32", "实得 " + typeText(hit.pool, hit.typeId))
    return

; 字典键不符：整数键不能传给字符串键的字典。
字典键不符|test() -> ():
    var sample = 造容器样例("main|func() -> ():\n    let x = d[2]\n    return\n")
    let 键 = 容器标量(sample, "String")
    sample = 键.sample
    let 值 = 容器标量(sample, "I32")
    sample = 值.sample
    let 字典 = 容器类型(sample, "Dictionary", [键.id, 值.id])
    sample = 字典.sample
    let node = 首值(sample.unit)
    sample.types = writeExprType(sample.types, 0, sample.unit.ast.exprAt(node).kids[0], 字典.id)
    let hit = checkSubscript(sample.unit, 0, node, sample.pool, sample.types)
    assert(hit.failed, "键类型不符应报错")
    assert(containerErrorCode(hit.error.kind) == "E4-001", "实得 " + containerErrorCode(hit.error.kind))
    return

; 下标非容器：标量没有下标通道，按运算无效报。
下标非容器|test() -> ():
    var sample = 造容器样例("main|func() -> ():\n    let x = n[0]\n    return\n")
    let 整数 = 容器标量(sample, "I32")
    sample = 整数.sample
    let node = 首值(sample.unit)
    sample.types = writeExprType(sample.types, 0, sample.unit.ast.exprAt(node).kids[0], 整数.id)
    let hit = checkSubscript(sample.unit, 0, node, sample.pool, sample.types)
    assert(hit.failed, "标量下标应报错")
    assert(containerErrorCode(hit.error.kind) == "E4-004", "实得 " + containerErrorCode(hit.error.kind))
    return

; 下标浮点：下标必须是整型，浮点字面量在期望位直接报类型不匹配。
下标浮点|test() -> ():
    var sample = 造容器样例("main|func() -> ():\n    let x = a[1.5]\n    return\n")
    let 整数 = 容器标量(sample, "I32")
    sample = 整数.sample
    let 数组 = 容器类型(sample, "Array", [整数.id])
    sample = 数组.sample
    let node = 首值(sample.unit)
    sample.types = writeExprType(sample.types, 0, sample.unit.ast.exprAt(node).kids[0], 数组.id)
    let hit = checkSubscript(sample.unit, 0, node, sample.pool, sample.types)
    assert(hit.failed, "浮点下标应报错")
    assert(containerErrorCode(hit.error.kind) == "E4-001", "实得 " + containerErrorCode(hit.error.kind))
    return

; 切片：数组切出同类数组，字符串切出字符串，开放边界不要求下标节点。
切片|test() -> ():
    var sample = 造容器样例("main|func() -> ():\n    let x = a[0:2]\n    return\n")
    let 整数 = 容器标量(sample, "I32")
    sample = 整数.sample
    let 数组 = 容器类型(sample, "Array", [整数.id])
    sample = 数组.sample
    let node = 首值(sample.unit)
    sample.types = writeExprType(sample.types, 0, sample.unit.ast.exprAt(node).kids[0], 数组.id)
    let hit = checkSlice(sample.unit, 0, node, sample.pool, sample.types)
    assert(!hit.failed, "数组切片应通过")
    assert(hit.typeId == 数组.id, "数组切片应回同一数组类型")
    var open = 造容器样例("main|func() -> ():\n    let x = a[:]\n    return\n")
    let 开整数 = 容器标量(open, "I32")
    open = 开整数.sample
    let 开数组 = 容器类型(open, "Array", [开整数.id])
    open = 开数组.sample
    let openNode = 首值(open.unit)
    open.types = writeExprType(open.types, 0, open.unit.ast.exprAt(openNode).kids[0], 开数组.id)
    let full = checkSlice(open.unit, 0, openNode, open.pool, open.types)
    assert(!full.failed, "全程切片应通过")
    assert(full.typeId == 开数组.id, "全程切片应回同一数组类型")
    var text = 造容器样例("main|func() -> ():\n    let x = s[0:2]\n    return\n")
    let 文本 = 容器标量(text, "String")
    text = 文本.sample
    let textNode = 首值(text.unit)
    text.types = writeExprType(text.types, 0, text.unit.ast.exprAt(textNode).kids[0], 文本.id)
    let cut = checkSlice(text.unit, 0, textNode, text.pool, text.types)
    assert(!cut.failed, "字符串切片应通过")
    assert(typeText(cut.pool, cut.typeId) == "String", "实得 " + typeText(cut.pool, cut.typeId))
    return

; 切片非容器：集合没有切片通道，按运算无效报。
切片非容器|test() -> ():
    var sample = 造容器样例("main|func() -> ():\n    let x = s[0:2]\n    return\n")
    let 整数 = 容器标量(sample, "I32")
    sample = 整数.sample
    let 集合 = 容器类型(sample, "Set", [整数.id])
    sample = 集合.sample
    let node = 首值(sample.unit)
    sample.types = writeExprType(sample.types, 0, sample.unit.ast.exprAt(node).kids[0], 集合.id)
    let hit = checkSlice(sample.unit, 0, node, sample.pool, sample.types)
    assert(hit.failed, "集合切片应报错")
    assert(containerErrorCode(hit.error.kind) == "E4-004", "实得 " + containerErrorCode(hit.error.kind))
    return

; 世界：单元、符号表与类型表装好，内建函数表随世界建好。
(容器世界)
world: MemberWorld = MemberWorld()
file: String = "packages/p/src/api/a.pini"

; 造世界：装载、注册与解析三步，顺序不能反。
造容器世界|func(src: String,) -> (容器世界,):
    let loaded = loadUnit("packages/p/src/api/a.pini", src)
    assert(!loaded.failed, "样例应可加载")
    let units = [loaded.unit]
    let table = registerPackage(units)
    let types = resolvePackage(units, table)
    var out = 容器世界()
    out.world = makeMemberWorld(units, table, types)
    return out

; 世界号：池增长后的世界与下标一起带回。
(世界号)
world: 容器世界 = 容器世界()
id: I32 = -1

; 世界标量：按名字驻留标量。
世界标量|func(world: 容器世界, name: String,) -> (世界号,):
    let inserted = intern(world.world.types.pool, typeClassScalar, name, [], -1)
    var out = 世界号()
    out.world = world
    out.world.world.types.pool = inserted.pool
    out.id = inserted.id
    return out

; 世界容器：按名字与实参驻留集合类类型。
世界容器|func(world: 容器世界, name: String, kids: Array<I32>,) -> (世界号,):
    let inserted = intern(world.world.types.pool, typeClassCollection, name, kids, -1)
    var out = 世界号()
    out.world = world
    out.world.world.types.pool = inserted.pool
    out.id = inserted.id
    return out

; 容器实参：标签为空即位置实参。
容器实参|func(label: String, typeId: I32,) -> (CallArg,):
    var out = CallArg()
    out.label = label
    out.typeId = typeId
    return out

; len 参数：数组与集合都能取长，标量在实参位报类型不匹配。
len参数|test() -> ():
    var 世界 = 造容器世界("main|func() -> ():\n    return\n")
    let 整数 = 世界标量(世界, "I32")
    世界 = 整数.world
    let 数组 = 世界容器(世界, "Array", [整数.id])
    世界 = 数组.world
    let 集合 = 世界容器(世界, "Set", [整数.id])
    世界 = 集合.world
    let 下标 = findBuiltinFunction(世界.world.functions, "len")
    assert(下标 >= 0, "len 应在函数表内")
    var hit = CallSite()
    hit.builtin = 下标
    hit.name = "len"
    hit.file = 世界.file
    var 好参: Array<CallArg> = []
    好参 = 好参.append(容器实参("", 数组.id))
    hit.args = 好参
    let 通过 = checkCall(世界.world, hit)
    assert(!通过.failed, "len 数组应通过")
    assert(typeText(通过.pool, 通过.typeId) == "I32", "实得 " + typeText(通过.pool, 通过.typeId))
    var 组参: Array<CallArg> = []
    组参 = 组参.append(容器实参("", 集合.id))
    hit.args = 组参
    let 集合过 = checkCall(世界.world, hit)
    assert(!集合过.failed, "len 集合应通过")
    var 坏参: Array<CallArg> = []
    坏参 = 坏参.append(容器实参("", 整数.id))
    hit.args = 坏参
    let 失败 = checkCall(世界.world, hit)
    assert(失败.failed, "len 标量应报错")
    assert(callErrorCode(失败.error.kind) == "E4-001", "实得 " + callErrorCode(失败.error.kind))
    return

; 成员调用：内建成员按函数类型取值，实参逐位比对，返回取成员形状。
成员调用|test() -> ():
    var 世界 = 造容器世界("main|func() -> ():\n    return\n")
    let 整数 = 世界标量(世界, "I32")
    世界 = 整数.world
    let 文本 = 世界标量(世界, "String")
    世界 = 文本.world
    let 数组 = 世界容器(世界, "Array", [整数.id])
    世界 = 数组.world
    let 取 = checkMember(世界.world, memberAccess(数组.id, "get", false, "", 世界.file, 0))
    assert(!取.failed, "Array.get 应命中")
    assert(typeText(取.pool, 取.typeId) == "(I32,) -> I32?", "实得 " + typeText(取.pool, 取.typeId))
    var grown = 世界.world
    grown.types.pool = 取.pool
    var hit = CallSite()
    hit.calleeType = 取.typeId
    hit.name = "get"
    hit.file = 世界.file
    var 好参: Array<CallArg> = []
    好参 = 好参.append(容器实参("", 整数.id))
    hit.args = 好参
    let 通过 = checkCall(grown, hit)
    assert(!通过.failed, "get 整数下标应通过")
    assert(typeText(通过.pool, 通过.typeId) == "I32?", "实得 " + typeText(通过.pool, 通过.typeId))
    var 坏参: Array<CallArg> = []
    坏参 = 坏参.append(容器实参("", 文本.id))
    hit.args = 坏参
    let 失败 = checkCall(grown, hit)
    assert(失败.failed, "get 字符串下标应报错")
    assert(callErrorCode(失败.error.kind) == "E4-001", "实得 " + callErrorCode(失败.error.kind))
    return

; 两次判定：同一输入两次得到同一类型与错误类别。
两次判定|test() -> ():
    let sample = 造容器样例("main|func() -> ():\n    let x = [1, 2, 3,]\n    return\n")
    let node = 首值(sample.unit)
    let first = checkArrayLiteral(sample.unit, 0, node, noExpectation(), sample.pool, sample.types)
    let second = checkArrayLiteral(sample.unit, 0, node, noExpectation(), first.pool, first.types)
    assert(typeText(first.pool, first.typeId) == typeText(second.pool, second.typeId), "两次类型应相同")
    assert(first.error.offset == second.error.offset, "两次错误位置应相同")
    return
