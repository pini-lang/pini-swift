; 默认值省略：带默认值的形参可不给实参，其余必填仍需对上。
默认值省略|test() -> ():
    var 样例 = 造调用样例(path = "packages/p/src/api/a.pini", src = "f|func(_a: I32, b: I32 = 0,) -> (I32,):\n    return a\n")
    let 数 = 加标量(sample = 样例, name = "I32")
    样例 = 数.sample
    var args: Array<CallArg> = []
    args = args.append(实参(label = "", typeId = 数.id))
    let hit = checkCall(world = 样例.world, site = 调用点(sample = 样例, name = "f", args = args))
    assert(!hit.failed, "省略默认值应通过")
    return

; 实参类型不匹配：类型不可赋值即报 E4-001。
语义实参类型不匹配|test() -> ():
    var 样例 = 造调用样例(path = "packages/p/src/api/a.pini", src = "g|func(_a: I32, _b: I32,) -> (I32,):\n    return a\n")
    let 数 = 加标量(sample = 样例, name = "I32")
    样例 = 数.sample
    let 串 = 加标量(sample = 样例, name = "String")
    样例 = 串.sample
    var args: Array<CallArg> = []
    args = args.append(实参(label = "", typeId = 串.id))
    args = args.append(实参(label = "", typeId = 数.id))
    let hit = checkCall(world = 样例.world, site = 调用点(sample = 样例, name = "g", args = args))
    assert(hit.failed, "类型不匹配应报错")
    assert(callErrorCode(hit.error.kind) == "E4-001", "实得 " + callErrorCode(hit.error.kind))
    return

; 函数值调用：只有函数类型可调用，实参个数按类型逐位对。
函数值调用|test() -> ():
    var 样例 = 造调用样例(path = "packages/p/src/api/a.pini", src = "(点)\nx: I32 = 0\n")
    let 数 = 加标量(sample = 样例, name = "I32")
    样例 = 数.sample
    let 旗 = 加标量(sample = 样例, name = "Bool")
    样例 = 旗.sample
    var kids: Array<I32> = []
    kids = kids.append(数.id)
    let fn = 组函数(sample = 样例, params = kids, ret = 旗.id)
    样例 = fn.sample
    var args: Array<CallArg> = []
    args = args.append(实参(label = "", typeId = 数.id))
    var site = CallSite()
    site.calleeType = fn.id
    site.name = "值"
    site.file = 样例.file
    site.args = args
    let hit = checkCall(world = 样例.world, site = site)
    assert(!hit.failed, "函数值调用应通过")
    assert(typeText(pool = hit.pool, id = hit.typeId) == "Bool", "实得 " + typeText(pool = hit.pool, id = hit.typeId))
    var missing = CallSite()
    missing.calleeType = fn.id
    missing.name = "值"
    missing.file = 样例.file
    let short = checkCall(world = 样例.world, site = missing)
    assert(short.failed, "少给实参应报错")
    assert(callErrorCode(short.error.kind) == "E4-005", "实得 " + callErrorCode(short.error.kind))
    return

; 不可调用：非函数类型的值没有调用点，报 E4-004。
不可调用|test() -> ():
    var 样例 = 造调用样例(path = "packages/p/src/api/a.pini", src = "(点)\nx: I32 = 0\n")
    let 数 = 加标量(sample = 样例, name = "I32")
    样例 = 数.sample
    var site = CallSite()
    site.calleeType = 数.id
    site.name = "数"
    site.file = 样例.file
    let hit = checkCall(world = 样例.world, site = site)
    assert(hit.failed, "整数不可调用")
    assert(callErrorCode(hit.error.kind) == "E4-004", "实得 " + callErrorCode(hit.error.kind))
    return

; 内建函数：长度取任意实参回 I32，断言按变参放过缺省消息，类型仍要查。
内建函数|test() -> ():
    var 样例 = 造调用样例(path = "packages/p/src/api/a.pini", src = "(点)\nx: I32 = 0\n")
    let 串 = 加标量(sample = 样例, name = "String")
    样例 = 串.sample
    let 数 = 加标量(sample = 样例, name = "I32")
    样例 = 数.sample
    let 旗 = 加标量(sample = 样例, name = "Bool")
    样例 = 旗.sample
    var 长度 = CallSite()
    长度.builtin = findBuiltinFunction(functions = 样例.world.functions, name = "len")
    长度.name = "len"
    长度.file = 样例.file
    var one: Array<CallArg> = []
    one = one.append(实参(label = "", typeId = 串.id))
    长度.args = one
    let measured = checkCall(world = 样例.world, site = 长度)
    assert(!measured.failed, "len 应通过")
    assert(typeText(pool = measured.pool, id = measured.typeId) == "I32", "实得 " + typeText(pool = measured.pool, id = measured.typeId))
    var 断言 = CallSite()
    断言.builtin = findBuiltinFunction(functions = 样例.world.functions, name = "assert")
    断言.name = "assert"
    断言.file = 样例.file
    var onlyCondition: Array<CallArg> = []
    onlyCondition = onlyCondition.append(实参(label = "", typeId = 旗.id))
    断言.args = onlyCondition
    let short = checkCall(world = 样例.world, site = 断言)
    assert(!short.failed, "变参应放过缺少的消息")
    assert(typeText(pool = short.pool, id = short.typeId) == "()", "实得 " + typeText(pool = short.pool, id = short.typeId))
    var wrongType: Array<CallArg> = []
    wrongType = wrongType.append(实参(label = "", typeId = 数.id))
    断言.args = wrongType
    let bad = checkCall(world = 样例.world, site = 断言)
    assert(bad.failed, "条件位收整数应报错")
    assert(callErrorCode(bad.error.kind) == "E4-001", "实得 " + callErrorCode(bad.error.kind))
    return

; 内建成员调用：数组追加按函数值形态对上元素位，返回数组。
内建成员调用|test() -> ():
    var 样例 = 造调用样例(path = "packages/p/src/api/a.pini", src = "(点)\nx: I32 = 0\n")
    let 数 = 加标量(sample = 样例, name = "I32")
    样例 = 数.sample
    let 数组 = 加数组(sample = 样例, elem = "I32")
    样例 = 数组.sample
    var kids: Array<I32> = []
    kids = kids.append(数.id)
    let fn = 组函数(sample = 样例, params = kids, ret = 数组.id)
    样例 = fn.sample
    var site = CallSite()
    site.calleeType = fn.id
    site.name = "append"
    site.file = 样例.file
    var args: Array<CallArg> = []
    args = args.append(实参(label = "", typeId = 数.id))
    site.args = args
    let hit = checkCall(world = 样例.world, site = site)
    assert(!hit.failed, "内建成员调用应通过")
    assert(typeText(pool = hit.pool, id = hit.typeId) == "Array<I32>", "实得 " + typeText(pool = hit.pool, id = hit.typeId))
    return

; 实参提取：标签实参按父节点识别，值节点取类型；位置实参保持空标签。
实参提取|test() -> ():
    let 样例 = 造调用样例(path = "packages/p/src/api/a.pini", src = "g|func(a: I32, b: I32,) -> (I32,):\n    return a\n\nm|func() -> ():\n    let x = g(a = 1, 2)\n    return\n")
    var node = -1
    var i = 0
    while i < 样例.unit.ast.exprCount():
        if 样例.unit.ast.isCallExpr(i) && node < 0:
            node = i
        i = i + 1
    assert(node >= 0, "应有一个调用节点")
    let callee = calleeNode(unit = 样例.unit, node = node)
    assert(样例.unit.ast.isIdentifierExpr(callee), "被调方应是标识符")
    let args = callArguments(unit = 样例.unit, unitIndex = 0, node = node, types = makeExprTypes([样例.unit]))
    assert(len(args) == 2, "两个实参")
    assert(args[0].label == "a", "首个应带标签 a")
    assert(args[1].label == "", "次个应是位置实参")
    return

; 待定：被调方尚未定型时不报错，交给调用方补判。
待定调用|test() -> ():
    let 样例 = 造调用样例(path = "packages/p/src/api/a.pini", src = "(点)\nx: I32 = 0\n")
    var site = CallSite()
    site.name = "未知"
    site.file = 样例.file
    let hit = checkCall(world = 样例.world, site = site)
    assert(!hit.failed, "待定不应报错")
    assert(hit.deferred, "应记为待定")
    return

; 两次判定一致：同一调用点两次检查得到同一类型与错误类别。
调用两次一致|test() -> ():
    var 样例 = 造调用样例(path = "packages/p/src/api/a.pini", src = "g|func(a: I32, b: I32,) -> (I32,):\n    return a\n")
    let 数 = 加标量(sample = 样例, name = "I32")
    样例 = 数.sample
    var args: Array<CallArg> = []
    args = args.append(实参(label = "", typeId = 数.id))
    let site = 调用点(sample = 样例, name = "g", args = args)
    let first = checkCall(world = 样例.world, site = site)
    let second = checkCall(world = 样例.world, site = site)
    assert(callErrorName(first.error.kind) == callErrorName(second.error.kind), "错误类别应相同")
    assert(first.typeId == second.typeId, "类型下标应相同")
    return
