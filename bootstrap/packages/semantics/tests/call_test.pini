    let 数 = 加标量(sample = 样例, name = "I32")
    样例 = 数.sample
    var args: Array<CallArg> = []
    args = args.append(实参(label = "", typeId = 数.id))
    args = args.append(实参(label = "", typeId = 数.id))
    args = args.append(实参(label = "", typeId = 数.id))
    let hit = checkCall(world = 样例.world, site = 调用点(sample = 样例, name = "g", args = args))
