[call_test|import]
_syntax = "../../syntax"
_module_loader = "../../module-loader"

; 调用样例：单元、世界与文件路径；实参类型由调用方另行驻留。
(调用样例)
world: MemberWorld = MemberWorld()
unit: CompilationUnit = CompilationUnit()
file: String = ""

; 造调用样例：装载、注册、解析类型、建世界四步，顺序不能反。
造调用样例|func(path: String, src: String,) -> (调用样例,):
    let loaded = loadUnit(path = path, text = src)
    assert(!loaded.failed, "样例应可加载：" + path)
    let units = [loaded.unit]
    let table = registerPackage(units)
    let types = resolvePackage(units = units, table = table)
    var out = 调用样例()
    out.world = makeMemberWorld(units = units, table = table, types = types)
    out.unit = loaded.unit
    out.file = path
    return out

; 类型号：驻留结果连同更新后的样例一起带回。
(类型号)
sample: 调用样例 = 调用样例()
id: I32 = -1

; 加标量：按名字驻留标量类型。
加标量|func(sample: 调用样例, name: String,) -> (类型号,):
    let inserted = intern(pool = sample.world.types.pool, kind = .typeClassScalar, name = name, kids = [], ret = -1)
    var out = 类型号()
    out.sample = sample
    out.sample.world.types.pool = inserted.pool
    out.id = inserted.id
    return out

; 加数组：按元素标量名驻留数组类型。
加数组|func(sample: 调用样例, elem: String,) -> (类型号,):
    let scalar = intern(pool = sample.world.types.pool, kind = .typeClassScalar, name = elem, kids = [], ret = -1)
    var grown = sample
    grown.world.types.pool = scalar.pool
    var kids: Array<I32> = []
    kids = kids.append(scalar.id)
    let array = intern(pool = grown.world.types.pool, kind = .typeClassCollection, name = "Array", kids = kids, ret = -1)
    var out = 类型号()
    out.sample = grown
    out.sample.world.types.pool = array.pool
    out.id = array.id
    return out

; 组函数：按形参与返回的类型下标驻留函数类型。
组函数|func(sample: 调用样例, params: Array<I32>, ret: I32,) -> (类型号,):
    let inserted = intern(pool = sample.world.types.pool, kind = .typeClassFunction, name = "", kids = params, ret = ret)
    var out = 类型号()
    out.sample = sample
    out.sample.world.types.pool = inserted.pool
    out.id = inserted.id
    return out

; 实参：标签为空即位置实参。
实参|func(label: String, typeId: I32,) -> (CallArg,):
    var out = CallArg()
    out.label = label
    out.typeId = typeId
    return out

; 调用点：按名字取顶层函数符号，实参与文件按样例填。
调用点|func(sample: 调用样例, name: String, args: Array<CallArg>,) -> (CallSite,):
    var out = CallSite()
    out.symbol = sample.world.table.topIndex(keyOfText(name))
    out.name = name
    out.file = sample.file
    out.args = args
    return out

; 位置调用：退出标签面的形参按位置对位，返回类型取声明。
位置调用|test() -> ():
    var 样例 = 造调用样例(path = "packages/p/src/api/a.pini", src = "g|func(_a: I32, _b: I32,) -> (I32,):\n    return a\n")
    let 数 = 加标量(sample = 样例, name = "I32")
    样例 = 数.sample
    var args: Array<CallArg> = []
    args = args.append(实参(label = "", typeId = 数.id))
    args = args.append(实参(label = "", typeId = 数.id))
    let hit = checkCall(world = 样例.world, site = 调用点(sample = 样例, name = "g", args = args))
    assert(!hit.failed, "位置调用应通过")
    assert(typeText(pool = hit.pool, id = hit.typeId) == "I32", "实得 " + typeText(pool = hit.pool, id = hit.typeId))
    return

; 标签调用：标签按名字对齐，顺序颠倒也命中。
标签调用|test() -> ():
    var 样例 = 造调用样例(path = "packages/p/src/api/a.pini", src = "g|func(a: I32, b: I32,) -> (I32,):\n    return a\n")
    let 数 = 加标量(sample = 样例, name = "I32")
    样例 = 数.sample
    var args: Array<CallArg> = []
    args = args.append(实参(label = "b", typeId = 数.id))
    args = args.append(实参(label = "a", typeId = 数.id))
    let hit = checkCall(world = 样例.world, site = 调用点(sample = 样例, name = "g", args = args))
    assert(!hit.failed, "标签调用应通过")
    return

; 混合调用：位置实参填首个未占位的退面形参，标签实参按名字填其余。
混合调用|test() -> ():
    var 样例 = 造调用样例(path = "packages/p/src/api/a.pini", src = "g|func(_a: I32, b: Bool,) -> (I32,):\n    return a\n")
    let 数 = 加标量(sample = 样例, name = "I32")
    样例 = 数.sample
    let 旗 = 加标量(sample = 样例, name = "Bool")
    样例 = 旗.sample
    var args: Array<CallArg> = []
    args = args.append(实参(label = "", typeId = 数.id))
    args = args.append(实参(label = "b", typeId = 旗.id))
    let hit = checkCall(world = 样例.world, site = 调用点(sample = 样例, name = "g", args = args))
    assert(!hit.failed, "混合调用应通过")
    return

; 未知标签：标签对不上形参名即报错，码取 E4-009。
未知标签|test() -> ():
    var 样例 = 造调用样例(path = "packages/p/src/api/a.pini", src = "g|func(a: I32, b: I32,) -> (I32,):\n    return a\n")
    let 数 = 加标量(sample = 样例, name = "I32")
    样例 = 数.sample
    var args: Array<CallArg> = []
    args = args.append(实参(label = "x", typeId = 数.id))
    args = args.append(实参(label = "b", typeId = 数.id))
    let hit = checkCall(world = 样例.world, site = 调用点(sample = 样例, name = "g", args = args))
    assert(hit.failed, "未知标签应报错")
    assert(callErrorCode(hit.error.kind) == "E4-009", "实得 " + callErrorCode(hit.error.kind))
    return

; 缺标签：形参没写 _ 时，位置实参报 E4-036。
缺标签|test() -> ():
    var 样例 = 造调用样例(path = "packages/p/src/api/a.pini", src = "g|func(a: I32, b: I32,) -> (I32,):\n    return a\n")
    let 数 = 加标量(sample = 样例, name = "I32")
    样例 = 数.sample
    var args: Array<CallArg> = []
    args = args.append(实参(label = "", typeId = 数.id))
    args = args.append(实参(label = "", typeId = 数.id))
    let hit = checkCall(world = 样例.world, site = 调用点(sample = 样例, name = "g", args = args))
    assert(hit.failed, "位置实参应报缺标签")
    assert(callErrorCode(hit.error.kind) == "E4-036", "实得 " + callErrorCode(hit.error.kind))
    return

; 退面收标签：声明写 _ 的形参收到同名标签报 E4-037。
退面收标签|test() -> ():
    var 样例 = 造调用样例(path = "packages/p/src/api/a.pini", src = "g|func(_a: I32,) -> (I32,):\n    return _a\n")
    let 数 = 加标量(sample = 样例, name = "I32")
    样例 = 数.sample
    var args: Array<CallArg> = []
    args = args.append(实参(label = "_a", typeId = 数.id))
    let hit = checkCall(world = 样例.world, site = 调用点(sample = 样例, name = "g", args = args))
    assert(hit.failed, "退面形参收标签应报错")
    assert(callErrorCode(hit.error.kind) == "E4-037", "实得 " + callErrorCode(hit.error.kind))
    return

; 重复标签：同一形参收到两个标签实参报 E4-038。
重复标签|test() -> ():
    var 样例 = 造调用样例(path = "packages/p/src/api/a.pini", src = "g|func(a: I32, b: I32,) -> (I32,):\n    return a\n")
    let 数 = 加标量(sample = 样例, name = "I32")
    样例 = 数.sample
    var args: Array<CallArg> = []
    args = args.append(实参(label = "a", typeId = 数.id))
    args = args.append(实参(label = "a", typeId = 数.id))
    let hit = checkCall(world = 样例.world, site = 调用点(sample = 样例, name = "g", args = args))
    assert(hit.failed, "重复标签应报错")
    assert(callErrorCode(hit.error.kind) == "E4-038", "实得 " + callErrorCode(hit.error.kind))
    return

