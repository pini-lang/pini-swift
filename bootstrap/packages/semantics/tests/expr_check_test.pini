[expr_check_test|import]
_syntax = "../../syntax"
_module_loader = "../../module-loader"

; 表达式检查：逐单元跑名字、成员与调用三类判据，不读文件系统。
; 样例只走装载、注册、解析类型与建世界四步，与接口样例同一套顺序。

; 表达式样例：世界与表达式类型表；类型表全未写，实参类型一律待定。
(表达式样例)
world: MemberWorld = MemberWorld()
types: ExprTypes = ExprTypes()

; 造表达式样例：装载、排序、注册、解析类型、建世界、铺类型表。
造表达式样例|func(files: Array<String>, texts: Array<String>,) -> (表达式样例,):
    var loaded: Array<CompilationUnit> = []
    var i = 0
    while i < len(files):
        let one = loadUnit(path = files[i], text = texts[i])
        assert(!one.failed, "样例应可加载：" + files[i])
        loaded = loaded.append(one.unit)
        i = i + 1
    let units = sortedUnits(loaded)
    let table = registerPackage(units)
    let types = resolvePackage(units = units, table = table)
    var out = 表达式样例()
    out.world = makeMemberWorld(units = units, table = table, types = types)
    out.types = makeExprTypes(units)
    return out

; 未定义调用：文件里没有这个名字，调用点报一条未定义。
未定义调用|test() -> ():
    let 样例 = 造表达式样例(files = ["packages/p/src/api/p.pini"], texts = ["f|func() -> ():\n    没有这个()\n"])
    let check = checkUnitExprs(world = 样例.world, unitIndex = 0, types = 样例.types)
    assert(len(check.errors) == 1, "应报一条，实得 " + "\(len(check.errors))")
    assert(isExprError(error = check.errors[0], kind = .exprUndefined), "实得 " + exprErrorName(check.errors[0].kind))
    assert(check.errors[0].name == "没有这个", "实得 " + check.errors[0].name)
    assert(check.errors[0].code == "E3-002", "实得 " + check.errors[0].code)
    return

; 已知名字放行：顶层函数、内建、局部与参数都不报。
已知名字放行|test() -> ():
    let 样例 = 造表达式样例(files = ["packages/p/src/api/p.pini"], texts = ["甲|func() -> ():\n    pass\n\nf|func(参数: I32,) -> ():\n    let 局部 = 甲\n    局部()\n    参数\n    len(\"x\")\n"])
    let check = checkUnitExprs(world = 样例.world, unitIndex = 0, types = 样例.types)
    assert(len(check.errors) == 0, "合法名字不该报，实得 " + exprError串(check))
    return

; 成员缺失：接收者是顶层类型名时按名义成员判，类型名位不暴露字段。
成员缺失|test() -> ():
    let 样例 = 造表达式样例(files = ["packages/p/src/api/p.pini"], texts = ["(点)\nx: I32 = 0\n\nf|func() -> ():\n    点.缺失\n"])
    let check = checkUnitExprs(world = 样例.world, unitIndex = 0, types = 样例.types)
    assert(len(check.errors) == 1, "应报一条，实得 " + exprError串(check))
    assert(isExprError(error = check.errors[0], kind = .exprMemberFailed), "实得 " + exprErrorName(check.errors[0].kind))
    assert(check.errors[0].name == "缺失", "实得 " + check.errors[0].name)
    return

; 调用个数：被调是顶层函数而实参少一个，按调用形状报。
调用个数不匹配|test() -> ():
    let 样例 = 造表达式样例(files = ["packages/p/src/api/p.pini"], texts = ["甲|func(a: I32,) -> ():\n    pass\n\nf|func() -> ():\n    甲()\n"])
    let check = checkUnitExprs(world = 样例.world, unitIndex = 0, types = 样例.types)
    assert(len(check.errors) == 1, "应报一条，实得 " + exprError串(check))
    assert(isExprError(error = check.errors[0], kind = .exprCallFailed), "实得 " + exprErrorName(check.errors[0].kind))
    return

; 跳出标签：标签记在语句名位，不进表达式池，表达式检查不按名字判它。
跳出标签不进池|test() -> ():
    let 样例 = 造表达式样例(files = ["packages/p/src/api/p.pini"], texts = ["f|func() -> ():\n    outer|while true:\n        break outer\n"])
    let check = checkUnitExprs(world = 样例.world, unitIndex = 0, types = 样例.types)
    assert(len(check.errors) == 0, "标签不该按名字判，实得 " + exprError串(check))
    return

; 错误与并发内建名：五个内建名在值位可解析，不再按未定义名字或未定义函数报。
错误与并发内建名|test() -> ():
    let 样例 = 造表达式样例(files = ["packages/p/src/api/p.pini"], texts = ["f|func() -> ():\n    var e = Error(\"x\")\n    var c = CancelError(\"y\")\n    var k = isCancel(e)\n    var a = joinAll([e])\n    var b = joinWithin(a, 10)\n"])
    let check = checkUnitExprs(world = 样例.world, unitIndex = 0, types = 样例.types)
    assert(len(check.errors) == 0, "内建名不该报，实得 " + exprError串(check))
    return

; 可选限定名：`Optional` 是内建类型名，限定构造不按未定义名字报。
可选限定名|test() -> ():
    let 样例 = 造表达式样例(files = ["packages/p/src/api/p.pini"], texts = ["f|func() -> ():\n    var a = Optional.some(1)\n    var b = Optional.none\n"])
    let check = checkUnitExprs(world = 样例.world, unitIndex = 0, types = 样例.types)
    assert(len(check.errors) == 0, "Optional 限定构造不该报，实得 " + exprError串(check))
    return

; 内建名按签名判个数：返回未定也先对实参个数，签名表不能空转。
内建名按签名判个数|test() -> ():
    let 样例 = 造表达式样例(files = ["packages/p/src/api/p.pini"], texts = ["f|func() -> ():\n    var e = Error()\n    var b = joinWithin(1)\n"])
    let check = checkUnitExprs(world = 样例.world, unitIndex = 0, types = 样例.types)
    assert(len(check.errors) == 2, "应报两条，实得 " + exprError串(check))
    assert(check.errors[0].code == "E4-005", "实得 " + check.errors[0].code)
    assert(check.errors[1].code == "E4-005", "实得 " + check.errors[1].code)
    return

; 给定块名字进值位：裸写报错；显式构造 `名()` 与成员接收者不在此判。
给定块名不进值位|test() -> ():
    let 源 = "[配置|given]\n名称: String = \"默认\"\n\n取|func(配: 配置,) -> (String,):\n    return 配.名称\n\nf|func() -> ():\n    取(配 = 配置,)\n"
    let 样例 = 造表达式样例(files = ["packages/p/src/api/p.pini"], texts = [源])
    let check = checkUnitExprs(world = 样例.world, unitIndex = 0, types = 样例.types)
    assert(len(check.errors) == 1, "应报一条，实得 " + exprError串(check))
    assert(check.errors[0].code == "E4-015", "实得 " + check.errors[0].code)
    assert(check.errors[0].name == "配置", "实得 " + check.errors[0].name)
    return

; 显式构造放行：`配置()` 是合法值，类型名本身不进值位。
给定块显式构造放行|test() -> ():
    let 源 = "[配置|given]\n名称: String = \"默认\"\n\n取|func(配: 配置,) -> (String,):\n    return 配.名称\n\nf|func() -> ():\n    取(配 = 配置(),)\n"
    let 样例 = 造表达式样例(files = ["packages/p/src/api/p.pini"], texts = [源])
    let check = checkUnitExprs(world = 样例.world, unitIndex = 0, types = 样例.types)
    assert(len(check.errors) == 0, "显式构造不该报，实得 " + exprError串(check))
    return

; 成员接收者放行：own 方法挂在类型名上，`配置.取数()` 不是把类型名当值。
给定块作接收者放行|test() -> ():
    let 源 = "[配置|given]\n名称: String = \"默认\"\n\n((配置))\n取数|own() -> (I32,):\n    return 3\n\nf|func() -> ():\n    配置.取数()\n"
    let 样例 = 造表达式样例(files = ["packages/p/src/api/p.pini"], texts = [源])
    let check = checkUnitExprs(world = 样例.world, unitIndex = 0, types = 样例.types)
    assert(len(check.errors) == 0, "接收者位不该报，实得 " + exprError串(check))
    return

; 取用位缺默认实例：省略实参时形参类型不是给定块，省略式调用只能拒。
取用位缺默认实例|test() -> ():
    let 源 = "取值|func(using 配: I32,) -> (I32,):\n    return 配\n\nf|func() -> ():\n    取值()\n"
    let 样例 = 造表达式样例(files = ["packages/p/src/api/p.pini"], texts = [源])
    let check = checkUnitExprs(world = 样例.world, unitIndex = 0, types = 样例.types)
    assert(len(check.errors) == 1, "应报一条，实得 " + exprError串(check))
    assert(check.errors[0].code == "E6-007", "实得 " + check.errors[0].code)
    return

; 给定块字段缺初值：默认实例不完整，按字段报一条；带初值的字段不报。
给定块字段缺初值|test() -> ():
    let 一 = loadUnit(path = "packages/p/src/api/p.pini", text = "[配置|given]\n名称: String\n次数: I32 = 0\n")
    assert(!一.failed, "样例应可加载")
    let check = checkGivenShapes(units = [一.unit])
    assert(len(check.errors) == 1, "应报一条，实得 " + "\(len(check.errors))")
    assert(check.errors[0].owner == "配置", "实得 " + check.errors[0].owner)
    assert(check.errors[0].field == "名称", "实得 " + check.errors[0].field)
    return

; 泛型实参个数：非泛型函数按 0 个算，写了类型实参就报 E4-006。
泛型实参落到非泛型函数|test() -> ():
    let 源 = "加一|func(x: I32,) -> (I32,):\n    return x\n\nf|func() -> (I32,):\n    return 加一<I32>(1)\n"
    let 样例 = 造表达式样例(files = ["packages/p/src/api/p.pini"], texts = [源])
    let check = checkUnitExprs(world = 样例.world, unitIndex = 0, types = 样例.types)
    assert(len(check.errors) == 1, "应报一条，实得 " + exprError串(check))
    assert(check.errors[0].code == "E4-006", "实得 " + check.errors[0].code)
    assert(check.errors[0].name == "加一", "实得 " + check.errors[0].name)
    return

; 泛型实参相符放行：个数与声明一致时不报，类型能否解析归标注面。
泛型实参相符放行|test() -> ():
    let 源 = "配对|func<T, U>(a: T, b: U,) -> (T,):\n    return a\n\nf|func() -> (I32,):\n    return 配对<I32, String>(a = 1, b = \"x\")\n"
    let 样例 = 造表达式样例(files = ["packages/p/src/api/p.pini"], texts = [源])
    let check = checkUnitExprs(world = 样例.world, unitIndex = 0, types = 样例.types)
    assert(len(check.errors) == 0, "合法泛型调用不该报，实得 " + exprError串(check))
    return

; 收齐错误串：测试断言失败时给出可读内容。
exprError串|func(_check: ExprCheck,) -> (String,):
    var out = ""
    var i = 0
    while i < len(_check.errors):
        out = out + exprErrorName(_check.errors[i].kind) + ":" + _check.errors[i].name + " "
        i = i + 1
    return out
