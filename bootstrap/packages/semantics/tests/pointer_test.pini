[pointer_test|import]
_syntax = "../../syntax"
_module_loader = "../../module-loader"

; 指针读写：`load` 与 `store` 不在签名表里，判定与推导都走专属路径。
; 结果类型由实参的指针元素决定，故判别式必须是「非指针拒绝 / 元素类型放行」。

; 指针样例：世界与表达式类型表；单文件装载到建世界五步与调用样例同序。
(读写样例)
world: MemberWorld = MemberWorld()
unit: CompilationUnit = CompilationUnit()
types: ExprTypes = ExprTypes()

; 造读写样例。
造读写样例|func(_src: String,) -> (读写样例,):
    let loaded = loadUnit(path = "packages/p/src/api/p.pini", text = _src)
    assert(!loaded.failed, "样例应可加载")
    let units = sortedUnits([loaded.unit])
    let table = registerPackage(units)
    let types = resolvePackage(units = units, table = table)
    var out = 读写样例()
    out.world = makeMemberWorld(units = units, table = table, types = types)
    out.unit = units[0]
    out.types = makeExprTypes(units)
    return out

; 首个调用节点：按池序找第一处。
首个读写调用|func(_unit: CompilationUnit,) -> (I32,):
    var i = 0
    while i < _unit.ast.exprCount():
        if _unit.ast.isCallExpr(i):
            return i
        i = i + 1
    return -1

; 读指针：`load(p)` 取元素类型，检查零诊断。
读指针放行|test() -> ():
    let 样例 = 造读写样例("f|func(p: *I32,) -> (I32,):\n    return load(p)\n")
    let check = checkUnitExprs(world = 样例.world, unitIndex = 0, types = 样例.types)
    assert(len(check.errors) == 0, "读指针不该报，实得 " + "\(len(check.errors))")
    return

; 读非指针：实参是整数，按实参类型报一条。类型判定要实参类型，先推后查。
读非指针拒绝|test() -> ():
    let 样例 = 造读写样例("f|func() -> (I32,):\n    return load(1)\n")
    let 推 = inferUnitExprs(world = 样例.world, unitIndex = 0, types = 样例.types)
    let check = checkUnitExprs(world = 样例.world, unitIndex = 0, types = 推.types)
    assert(len(check.errors) == 1, "应报一条，实得 " + "\(len(check.errors))")
    assert(isExprError(error = check.errors[0], kind = .exprCallFailed), "实得 " + exprErrorName(check.errors[0].kind))
    return

; 写类型不符：`*I32` 的元素是 I32，写字符串被拒。
写类型不符|test() -> ():
    let 样例 = 造读写样例("f|func(p: *I32,) -> ():\n    store(p, \"x\")\n")
    let 推 = inferUnitExprs(world = 样例.world, unitIndex = 0, types = 样例.types)
    let check = checkUnitExprs(world = 样例.world, unitIndex = 0, types = 推.types)
    assert(len(check.errors) == 1, "应报一条，实得 " + "\(len(check.errors))")
    assert(isExprError(error = check.errors[0], kind = .exprCallFailed), "实得 " + exprErrorName(check.errors[0].kind))
    return

; 取址与读回：`&x` 得 `*I32`，`load` 取回 I32；推导把两处都写进类型表。
取址与读回|test() -> ():
    let 样例 = 造读写样例("f|func() -> (I32,):\n    var x: I32 = 7\n    let p = &x\n    return load(p)\n")
    let check = checkUnitExprs(world = 样例.world, unitIndex = 0, types = 样例.types)
    assert(len(check.errors) == 0, "取址与读回不该报，实得 " + "\(len(check.errors))")
    let 推 = inferUnitExprs(world = 样例.world, unitIndex = 0, types = 样例.types)
    let 调用 = 首个读写调用(样例.unit)
    assert(调用 >= 0, "样例应含调用节点")
    assert(typeText(pool = 推.pool, id = exprTypeAt(table = 推.types, unit = 0, node = 调用)) == "I32", "读回应为 I32")
    return
