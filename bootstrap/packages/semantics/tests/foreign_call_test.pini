[foreign_call_test|import]
_syntax = "../../syntax"
_module_loader = "../../module-loader"

; 外部调用点：回调实参的来历与签名、变参尾的类型、只读数据符号的写入。
; 样例把调用写进函数体，调用点由测试手工构造，实参类型按需驻留。
(外调样例)
world: MemberWorld = MemberWorld()
unit: CompilationUnit = CompilationUnit()
types: ExprTypes = ExprTypes()

; 造外调样例：装载、注册、解析类型、建世界四步，顺序不能反。
造外调样例|func(_src: String,) -> (外调样例,):
    let loaded = loadUnit(path = "packages/p/src/api/f.pini", text = _src)
    assert(!loaded.failed, "样例应可加载")
    let units = [loaded.unit]
    let table = registerPackage(units)
    let types = resolvePackage(units = units, table = table)
    var out = 外调样例()
    out.world = makeMemberWorld(units = units, table = table, types = types)
    out.unit = loaded.unit
    out.types = makeExprTypes(units)
    return out

; 找外调函数：按名字找顶层函数声明，找不到答 -1。
找外调函数|func(sample: 外调样例, name: String,) -> (I32,):
    let ast = sample.unit.ast
    let bytes = tempUtf8Bytes(sample.unit.text)
    var i = 0
    while i < len(ast.items):
        let id = ast.items[i]
        if isFunctionDeclCode(ast.decls[id].kind):
            if decodeRange(bytes = bytes, start = ast.decls[id].nameStart, end = ast.decls[id].nameEnd) == name:
                return id
        i = i + 1
    return -1

; 找标识符节点：按名字在表达式池里找第一个标识符，找不到答 -1。
找标识符|func(sample: 外调样例, name: String,) -> (I32,):
    let ast = sample.unit.ast
    let bytes = tempUtf8Bytes(sample.unit.text)
    var i = 0
    while i < ast.exprCount():
        if ast.isIdentifierExpr(i):
            let expr = ast.exprAt(i)
            if decodeRange(bytes = bytes, start = expr.nameStart, end = expr.nameEnd) == name:
                return i
        i = i + 1
    return -1

; 找整数节点：取第一个整数字面量，供「回调不是名字」的负例用。
找整数|func(_sample: 外调样例,) -> (I32,):
    let ast = _sample.unit.ast
    var i = 0
    while i < ast.exprCount():
        if ast.isIntegerExpr(i):
            return i
        i = i + 1
    return -1

; 驻留结果：池与新下标。
(驻留号)
pool: TypePool = TypePool()
id: I32 = -1

; 驻留标量：按名字驻留，重复驻留命中同一下标。
驻留标量|func(pool: TypePool, name: String,) -> (驻留号,):
    let inserted = intern(pool = pool, kind = typeClassScalar, name = name, kids = [], ret = -1)
    var out = 驻留号()
    out.pool = inserted.pool
    out.id = inserted.id
    return out

; 驻留指针：目标类型作唯一子节点。
驻留指针|func(pool: TypePool, target: I32,) -> (驻留号,):
    let inserted = intern(pool = pool, kind = typeClassPointer, name = "", kids = [target], ret = -1)
    var out = 驻留号()
    out.pool = inserted.pool
    out.id = inserted.id
    return out

; 驻留结构：空字段的结构类型，作「变参尾不收聚集」的负例。
驻留结构|func(pool: TypePool, name: String,) -> (驻留号,):
    let inserted = intern(pool = pool, kind = typeClassStruct, name = name, kids = [], ret = -1)
    var out = 驻留号()
    out.pool = inserted.pool
    out.id = inserted.id
    return out

; 实参：标签为空即位置实参；值节点按需填。
外调实参|func(typeId: I32, node: I32,) -> (CallArg,):
    var out = CallArg()
    out.typeId = typeId
    out.node = node
    return out

; 调用点：按符号名取顶层符号，单元下标固定为 0（样例只有一份单元）。
外调点|func(sample: 外调样例, name: String, args: Array<CallArg>,) -> (CallSite,):
    var out = CallSite()
    out.symbol = sample.world.table.topIndex(keyOfText(name))
    out.name = name
    out.file = sample.unit.path
    out.unit = 0
    out.args = args
    return out

; 样例源码：一个外部块加两个回调候选与两段体；errno 只读，外部计数可写。
样例源|func() -> (String,):
    return "[libc|foreign]\nqsort: (*U8, I64, I64, (*U8, *U8,) -> (I32,),) -> ()\nprintf|varargs: (String,) -> (I32,)\nerrno|readonly: I32\n外部计数: I32\n\n比较|func(_a: *U8, _b: *U8,) -> (I32,):\n    return 0\n\n别样比较|func(_a: *U8,) -> (I32,):\n    return 1\n\n测回调|func(_p: *U8,) -> ():\n    unsafe qsort(_p, 4, 1, 比较)\n\n取别样|func() -> ():\n    别样比较\n\n写只读|func() -> ():\n    errno = 1\n"

; 回调放行：实参是顶层自由函数且签名逐位相同。
回调放行|test() -> ():
    let 样例 = 造外调样例(样例源())
    let 比较 = 找标识符(sample = 样例, name = "比较")
    assert(比较 >= 0, "样例里应有 比较")
    var args: Array<CallArg> = []
    args = args.append(外调实参(typeId = -1, node = -1))
    args = args.append(外调实参(typeId = -1, node = -1))
    args = args.append(外调实参(typeId = -1, node = -1))
    args = args.append(外调实参(typeId = -1, node = 比较))
    let hit = checkCall(world = 样例.world, site = 外调点(sample = 样例, name = "qsort", args = args))
    assert(!hit.failed, "回调合格应放行，实得 " + callErrorName(hit.error.kind))
    return

; 回调非名字：实参是字面量时报回调来历。
回调非名字|test() -> ():
    let 样例 = 造外调样例(样例源())
    var args: Array<CallArg> = []
    args = args.append(外调实参(typeId = -1, node = -1))
    args = args.append(外调实参(typeId = -1, node = -1))
    args = args.append(外调实参(typeId = -1, node = -1))
    args = args.append(外调实参(typeId = -1, node = 找整数(样例)))
    let hit = checkCall(world = 样例.world, site = 外调点(sample = 样例, name = "qsort", args = args))
    assert(hit.failed, "字面量不能作回调")
    assert(isCallError(error = hit.error, kind = callCallback), "实得 " + callErrorName(hit.error.kind))
    assert(callErrorCode(callCallback) == "E4-031", "回调用 E4-031")
    return

; 回调签名不符：形参个数不同即报。
回调签名不符|test() -> ():
    let 样例 = 造外调样例(样例源())
    let 别样 = 找标识符(sample = 样例, name = "别样比较")
    assert(别样 >= 0, "样例里应有 别样比较")
    var args: Array<CallArg> = []
    args = args.append(外调实参(typeId = -1, node = -1))
    args = args.append(外调实参(typeId = -1, node = -1))
    args = args.append(外调实参(typeId = -1, node = -1))
    args = args.append(外调实参(typeId = -1, node = 别样))
    let hit = checkCall(world = 样例.world, site = 外调点(sample = 样例, name = "qsort", args = args))
    assert(hit.failed, "签名不同应报")
    assert(isCallError(error = hit.error, kind = callCallback), "实得 " + callErrorName(hit.error.kind))
    assert(hit.error.got.contains("形参个数"), "实得 " + hit.error.got)
    return

; 变参尾合格：固定前缀之后补两个标量放行。
变参尾合格|test() -> ():
    var 样例 = 造外调样例(样例源())
    let 串 = 驻留标量(pool = 样例.world.types.pool, name = "String")
    样例.world.types.pool = 串.pool
    let 数 = 驻留标量(pool = 样例.world.types.pool, name = "I32")
    样例.world.types.pool = 数.pool
    var args: Array<CallArg> = []
    args = args.append(外调实参(typeId = 串.id, node = -1))
    args = args.append(外调实参(typeId = 数.id, node = -1))
    args = args.append(外调实参(typeId = 数.id, node = -1))
    let hit = checkCall(world = 样例.world, site = 外调点(sample = 样例, name = "printf", args = args))
    assert(!hit.failed, "标量尾应放行，实得 " + callErrorName(hit.error.kind))
    return

; 变参尾不合格：结构值进尾报专用码。
变参尾聚集|test() -> ():
    var 样例 = 造外调样例(样例源())
    let 串 = 驻留标量(pool = 样例.world.types.pool, name = "String")
    样例.world.types.pool = 串.pool
    let 结构 = 驻留结构(pool = 样例.world.types.pool, name = "点")
    样例.world.types.pool = 结构.pool
    var args: Array<CallArg> = []
    args = args.append(外调实参(typeId = 串.id, node = -1))
    args = args.append(外调实参(typeId = 结构.id, node = -1))
    let hit = checkCall(world = 样例.world, site = 外调点(sample = 样例, name = "printf", args = args))
    assert(hit.failed, "聚集值不能进变参尾")
    assert(isCallError(error = hit.error, kind = callVarargsTail), "实得 " + callErrorName(hit.error.kind))
    assert(callErrorCode(callVarargsTail) == "E4-034", "变参尾用 E4-034")
    return

; 变参固定前缀：少给固定前缀报个数。
变参缺前缀|test() -> ():
    let 样例 = 造外调样例(样例源())
    var args: Array<CallArg> = []
    let hit = checkCall(world = 样例.world, site = 外调点(sample = 样例, name = "printf", args = args))
    assert(hit.failed, "缺固定前缀应报")
    assert(isCallError(error = hit.error, kind = callArity), "实得 " + callErrorName(hit.error.kind))
    return

; 只读拒写：只读数据符号答原因，可写数据符号答空串。
只读拒写|test() -> ():
    let 样例 = 造外调样例(样例源())
    assert(len(readonlyWriteReason(world = 样例.world, name = "errno")) > 0, "errno 应拒写")
    assert(len(readonlyWriteReason(world = 样例.world, name = "外部计数")) == 0, "可写符号不该拒")
    assert(len(readonlyWriteReason(world = 样例.world, name = "比较")) == 0, "函数不是数据符号")
    return

; 赋值接线：赋值面走一遍体，只读写入落在语句错误里。
只读赋值接线|test() -> ():
    let 样例 = 造外调样例(样例源())
    let id = 找外调函数(sample = 样例, name = "写只读")
    assert(id >= 0, "应有 写只读")
    let check = checkFunctionStores(world = 样例.world, unitIndex = 0, declId = id, types = 样例.types)
    assert(len(check.errors) == 1, "应报一条，实得 " + "\(len(check.errors))")
    assert(isStoreError(error = check.errors[0], kind = storeForeignReadonly), "实得 " + storeErrorName(check.errors[0].kind))
    assert(storeErrorCode(storeForeignReadonly) == "E4-039", "只读用 E4-039")
    return
