[runtime_api_test|import]
package = "../../package"
_module_loader = "../../module-loader"

; 包索引：按名字查工作区计划，未命中答 -1。
运行时段包索引|func(plan: BuildPlan, name: String,) -> (I32,):
    var i = 0
    while i < len(plan.packages):
        if plan.packages[i].name == name:
            return i
        i = i + 1
    return -1

; 端到端：runtime-api 在工作区里装载、注册、解析类型与判型全零诊断。
; 声明面 122 条；`bk_capabilities` 与 `bk_ptr_load_f32` 宽度不在 IR，走内建不进这里。
运行时段包零诊断|test() -> ():
    let root = moduleRoot() + "/../.."
    let plan: BuildPlan = package.planWorkspace(root)
    assert(plan.isOK(), "工作区计划应可用：" + package.planText(plan))
    let at = 运行时段包索引(plan = plan, name = "runtime_api")
    assert(at >= 0, "计划里应有 runtime_api")
    let pkg: PackagePlan = plan.packages[at]
    let loaded = loadPackage(packageAbs = root + "/" + pkg.rootPath, plan = pkg)
    assert(loaded.isOK(), "装载应零错")
    let symbols = registerPackage(loaded.units)
    if !symbols.isOK():
        let 首 = symbols.errorAt(0)
        assert(false, "注册应零错，实得 " + 首.file + " " + symbolErrorName(首.kind) + " " + 首.name)
    assert(symbols.symbolCount() == 122, "应登记 122 条，实得 " + "\(symbols.symbolCount())")
    let types = resolvePackage(units = loaded.units, table = symbols)
    if !types.isOK():
        let 首 = types.errorAt(0)
        assert(false, "类型应零错，实得 " + 首.file + " " + typeErrorName(首.kind) + " " + 首.name)
    let check = checkForeignPackage(units = loaded.units, types = types)
    if !check.isOK():
        let 首 = check.errorAt(0)
        assert(false, "判型应零错，实得 " + 首.file + " " + foreignTypeErrorName(首.kind) + " " + 首.name + " " + 首.detail)
    assert(types.bindingCount() == 122, "应留 122 条类型绑定，实得 " + "\(types.bindingCount())")
    assert(symbols.topIndex(keyOfText("bk_str_handle_new")) >= 0, "句柄入口应声明")
    assert(symbols.topIndex(keyOfText("bk_capabilities")) < 0, "能力位宽度不在 IR，不声明")
    assert(symbols.topIndex(keyOfText("bk_ptr_load_f32")) < 0, "F32 读取不声明")
    var 映像: Array<String> = []
    var i = 0
    while i < symbols.symbolCount():
        映像 = 映像.append(symbols.symbolAt(i).spelling)
        i = i + 1
    var 环境 = ForeignEnvironment()
    环境.imageSymbols = 映像
    let 解析 = resolveForeignPackage(units = loaded.units, types = types, env = 环境)
    assert(解析.isOK(), "运行时段符号应全部落到进程映像")
    assert(解析.countBy(.foreignSourceImage) == 122, "122 条都应命中映像")
    return
