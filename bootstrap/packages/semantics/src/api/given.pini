[given|import]
_syntax = "../../../syntax"
_module_loader = "../../../module-loader"

; 给定块形状：默认实例就是各字段初值的合体，缺一个初值就没有完整的默认实例。
; 判据按块逐字段报，不看它是否被取用 —— 惰性物化只决定求值时机，不改变完整性。
; 取用处的「无默认实例」是另一条路，落在调用面的取用位判定里。

; 给定块错误：类别、文件、位置、块名与字段名；位置指向缺初值的字段。
[GivenErrorKind]
givenFieldWithoutInit

(GivenError)
kind: GivenErrorKind = .givenFieldWithoutInit
file: String = ""
offset: I32 = 0
owner: String = ""
field: String = ""

; 给定块检查结果：错误表与失败标记；错误按单元与声明序，天然有序。
(GivenCheck)
errors: Array<GivenError> = []
failed: Bool = false

; 类别名：诊断、测试与回执共用一份拼写。
givenErrorName|func(_kind: GivenErrorKind,) -> (String,):
    match _kind:
        case givenFieldWithoutInit:
            return "给定块字段缺初值"
    return "给定块错误"

; 一个给定块：字段有初值即算有了，缺的逐条记下；字段名与块名一起进诊断。
checkGivenDecl|func(out: GivenCheck, unit: CompilationUnit, bytes: Array<U8>, decl: DeclNode,) -> (GivenCheck,):
    var done = out
    if !isGivenDeclCode(decl.kind):
        return done
    let owner = decodeSpelling(bytes = bytes, start = decl.nameStart, end = decl.nameEnd)
    var i = 0
    while i < len(decl.kids):
        let field = unit.ast.decls[decl.kids[i]]
        if isFieldDeclCode(field.kind) && len(field.kids) == 0:
            var one = GivenError()
            one.file = unit.path
            one.offset = field.start
            one.owner = owner
            one.field = decodeSpelling(bytes = bytes, start = field.nameStart, end = field.nameEnd)
            done.errors = done.errors.append(one)
        i = i + 1
    return done

; 入口：逐单元逐顶层声明过一遍；扩展块不带字段初值，不在此面。
checkGivenShapes|func(units: Array<CompilationUnit>,) -> (GivenCheck,):
    var out = GivenCheck()
    var u = 0
    while u < len(units):
        let unit = units[u]
        let bytes = unitBytes(unit)
        var i = 0
        while i < len(unit.ast.items):
            out = checkGivenDecl(out = out, unit = unit, bytes = bytes, decl = unit.ast.decls[unit.ast.items[i]])
            i = i + 1
        u = u + 1
    out.failed = len(out.errors) > 0
    return out
