[expr_check|import]
_syntax = "../../../syntax"
_module_loader = "../../../module-loader"

; 表达式检查：按表达式池逐节点判名字、成员与调用形状，不重跑类型推导。
; 名字面是文件级：跨函数误用会漏报，但不会把合法名字判成未定义。
; 实参类型未知时 checkArg 放过，本层只落实个数与标签两类调用判据。

; 表达式错误：未定义名、成员缺失与调用形状三类，各带自己的诊断码。
[ExprErrorKind]
exprUndefined
exprMemberFailed
exprCallFailed

; 表达式错误：类别、文件、位置、名字、细节与诊断码；码在造错时定死。
(ExprError)
kind: ExprErrorKind = .exprUndefined
file: String = ""
offset: I32 = 0
name: String = ""
detail: String = ""
code: String = "E3-001"

; 表达式检查结果：错误表与失败标记；错误按表达式池次序，天然有序。
(ExprCheck)
errors: Array<ExprError> = []
failed: Bool = false

; 类别名：诊断、测试与回执共用一份拼写。
exprErrorName|func(_kind: ExprErrorKind,) -> (String,):
    match _kind:
        case exprUndefined:
            return "未定义名字"
        case exprMemberFailed:
            return "成员不存在"
        case exprCallFailed:
            return "调用不成立"
    return "表达式错误"

; 同一类别判定：枚举相等比较不可用，按名称比。
isExprError|func(error: ExprError, kind: ExprErrorKind,) -> (Bool,):
    return exprErrorName(error.kind) == exprErrorName(kind)

; 造错误：码由调用方按来源面给，避免本层再抄一张码表。
makeExprError|func(kind: ExprErrorKind, file: String, offset: I32, name: String, detail: String, code: String,) -> (ExprError,):
    var out = ExprError()
    out.kind = kind
    out.file = file
    out.offset = offset
    out.name = name
    out.detail = detail
    out.code = code
    return out

; 追加错误：其余字段原样保留，一个节点出错不中断后续节点。
appendExprError|func(out: ExprCheck, unit: CompilationUnit, offset: I32, kind: ExprErrorKind, name: String, detail: String, code: String,) -> (ExprCheck,):
    var done = out
    done.errors = done.errors.append(makeExprError(kind = kind, file = unit.path, offset = offset, name = name, detail = detail, code = code))
    return done

; 名字命中：整串相等即命中；名字表是文件级绑定名。
hasName|func(items: Array<String>, value: String,) -> (Bool,):
    var i = 0
    while i < len(items):
        if items[i] == value:
            return true
        i = i + 1
    return false

; 已知名字：自身与占位符、文件绑定名、顶层符号、导入别名、内建函数五处。
knownName|func(world: MemberWorld, unit: CompilationUnit, locals: Array<String>, name: String,) -> (Bool,):
    if len(name) == 0 || name == "_" || name == "self":
        return true
    if hasName(items = locals, value = name):
        return true
    if lookupTopByName(index = world.symbols, name = name) >= 0:
        return true
    if world.table.importIndex(file = unit.path, key = keyOfText(name)) >= 0:
        return true
    return findBuiltinFunction(functions = world.functions, name = name) >= 0

; 局部绑定名：参数、变量、遍历与匹配绑定；不含顶层声明名，供排除遮蔽用。
localOnlyNames|func(unit: CompilationUnit,) -> (Array<String>,):
    let bytes = unitBytes(unit)
    var out: Array<String> = []
    var d = 0
    while d < unit.ast.declCount():
        let decl = unit.ast.decls[d]
        if isParamDeclCode(decl.kind):
            let name = decodeRange(bytes = bytes, start = decl.nameStart, end = decl.nameEnd)
            if len(name) > 0 && name != "_":
                out = out.append(name)
        d = d + 1
    var s = 0
    while s < unit.ast.stmtCount():
        let stmt = unit.ast.stmtAt(s)
        if unit.ast.isVariableStmt(s) || unit.ast.isForStmt(s):
            out = mergeNames(items = out, add = patternNames(unit = unit, bytes = bytes, node = unit.ast.stmtChild(id = s, index = 0)))
        if unit.ast.isMatchStmt(s):
            var m = 1
            while m < len(stmt.kids):
                out = mergeNames(items = out, add = patternNames(unit = unit, bytes = bytes, node = stmt.kids[m]))
                m = m + 2
        s = s + 1
    return out

; 并表：追加不查重，重复名字只会让查找多一次比较。
mergeNames|func(items: Array<String>, add: Array<String>,) -> (Array<String>,):
    var out = items
    var i = 0
    while i < len(add):
        out = out.append(add[i])
        i = i + 1
    return out

; 未定义名：文件级名字面都不含这个名字时报；位置取标识符起点。
checkIdentifierNode|func(world: MemberWorld, unit: CompilationUnit, bytes: Array<U8>, locals: Array<String>, node: I32, out: ExprCheck,) -> (ExprCheck,):
    let expr = unit.ast.exprAt(node)
    let name = decodeRange(bytes = bytes, start = expr.nameStart, end = expr.nameEnd)
    if knownName(world = world, unit = unit, locals = locals, name = name):
        return out
    return appendExprError(out = out, unit = unit, offset = expr.start, kind = .exprUndefined, name = name, detail = "文件内没有这个名字", code = "E3-001")

; 成员缺失：接收者是顶层类型名且不是局部遮蔽时，按名义成员判一次。
; 类型名位不暴露字段，这与成员面的语义一致；接收者是变量时留给类型推导。
checkMemberNode|func(world: MemberWorld, unit: CompilationUnit, bytes: Array<U8>, shadow: Array<String>, node: I32, out: ExprCheck,) -> (ExprCheck,):
    let member = unit.ast.exprAt(node)
    let receiver = unit.ast.childOf(id = node, index = 0)
    if receiver < 0 || !unit.ast.isIdentifierExpr(receiver):
        return out
    let recv = unit.ast.exprAt(receiver)
    let recvName = decodeRange(bytes = bytes, start = recv.nameStart, end = recv.nameEnd)
    if hasName(items = shadow, value = recvName):
        return out
    let typeId = nominalTypeId(world = world, name = recvName)
    if typeId < 0:
        return out
    let memberName = decodeRange(bytes = bytes, start = member.nameStart, end = member.nameEnd)
    let access = memberAccess(receiver = typeId, name = memberName, isTypeName = true, owner = recvName, file = unit.path, offset = member.start)
    let result = checkMember(world = world, access = access)
    if !result.failed:
        return out
    return appendExprError(out = out, unit = unit, offset = member.start, kind = .exprMemberFailed, name = memberName, detail = recvName + " 上没有该成员", code = memberErrorCode(result.error.kind))

; 成员被调：接收者定型后按成员面判方法、内建与函数值；私有成员在无归属时放过。
; 成员不存在与调用形状仍按专用码报；类型错的比对归调用面。
checkMemberCall|func(world: MemberWorld, unit: CompilationUnit, unitIndex: I32, bytes: Array<U8>, shadow: Array<String>, types: ExprTypes, node: I32, out: ExprCheck,) -> (ExprCheck,):
    let callee = calleeNode(unit = unit, node = node)
    if callee < 0:
        return out
    let member = unit.ast.exprAt(callee)
    if len(member.kids) < 1:
        return out
    let recvNode: I32 = member.kids[0]
    var receiverType = -1
    var isTypeName = false
    if unit.ast.isIdentifierExpr(recvNode):
        let recvExpr = unit.ast.exprAt(recvNode)
        let recvName = decodeRange(bytes = bytes, start = recvExpr.nameStart, end = recvExpr.nameEnd)
        if !hasName(items = shadow, value = recvName):
            let nominal = nominalTypeId(world = world, name = recvName)
            if nominal >= 0:
                receiverType = nominal
                isTypeName = true
    if receiverType < 0:
        receiverType = exprTypeAt(table = types, unit = unitIndex, node = recvNode)
    if receiverType < 0:
        return out
    let memberName = decodeRange(bytes = bytes, start = member.nameStart, end = member.nameEnd)
    let access = memberAccess(receiver = receiverType, name = memberName, isTypeName = isTypeName, owner = "", file = unit.path, offset = member.start)
    let result = checkMember(world = world, access = access)
    if result.failed:
        if isMemberError(error = result.error, kind = .memberPrivate) || isMemberError(error = result.error, kind = .memberInaccessible):
            return out
        return appendExprError(out = out, unit = unit, offset = member.start, kind = .exprMemberFailed, name = memberName, detail = "接收者上没有该成员", code = memberErrorCode(result.error.kind))
    if result.deferred:
        return out
    var site = CallSite()
    site.name = memberName
    site.file = unit.path
    site.offset = unit.ast.exprAt(node).start
    site.unit = unitIndex
    site.args = callArguments(unit = unit, unitIndex = unitIndex, node = node, types = types)
    if isMemberKind(kind = result.kind, expected = .memberMethod) || isMemberKind(kind = result.kind, expected = .memberOwnMethod):
        site.symbol = result.symbol
    else:
        site.calleeType = result.typeId
    let checked = checkCall(world = probeWorld(world = world, pool = result.pool), site = site)
    if !checked.failed:
        return out
    return appendExprError(out = out, unit = unit, offset = site.offset, kind = .exprCallFailed, name = memberName, detail = callErrorName(checked.error.kind), code = callErrorCode(checked.error.kind))

; 调用形状：被调是顶层函数或内建时按签名对实参标签与个数；外部符号只判 unsafe 上下文。
; 变参尾与回调判据要实参类型，本层拿不到；未定义函数由本节点报 E3-002。
checkCallNode|func(world: MemberWorld, unit: CompilationUnit, unitIndex: I32, bytes: Array<U8>, shadow: Array<String>, types: ExprTypes, ranges: UnsafeRanges, node: I32, out: ExprCheck,) -> (ExprCheck,):
    let callee = calleeNode(unit = unit, node = node)
    if callee < 0:
        return out
    if unit.ast.isMemberExpr(callee):
        return checkMemberCall(world = world, unit = unit, unitIndex = unitIndex, bytes = bytes, shadow = shadow, types = types, node = node, out = out)
    if !unit.ast.isIdentifierExpr(callee):
        return out
    let calleeExpr = unit.ast.exprAt(callee)
    let name = decodeRange(bytes = bytes, start = calleeExpr.nameStart, end = calleeExpr.nameEnd)
    if hasName(items = shadow, value = name):
        return out
    if name == "load" || name == "store":
        var pointerSite = CallSite()
        pointerSite.name = name
        pointerSite.file = unit.path
        pointerSite.offset = unit.ast.exprAt(node).start
        pointerSite.unit = unitIndex
        pointerSite.args = callArguments(unit = unit, unitIndex = unitIndex, node = node, types = types)
        var base = CallResult()
        base.pool = world.types.pool
        let checked = checkPointerCall(out = base, site = pointerSite, name = name)
        if !checked.failed:
            return out
        return appendExprError(out = out, unit = unit, offset = pointerSite.offset, kind = .exprCallFailed, name = name, detail = callErrorName(checked.error.kind), code = callErrorCode(checked.error.kind))
    var site = CallSite()
    site.name = name
    site.file = unit.path
    site.offset = unit.ast.exprAt(node).start
    site.unit = unitIndex
    site.symbol = lookupTopByName(index = world.symbols, name = name)
    if site.symbol < 0:
        site.builtin = findBuiltinFunction(functions = world.functions, name = name)
    if site.symbol < 0 && site.builtin < 0:
        ; 枚举项构造不是顶层符号，也不是未定义函数。
        let owner = uniqueCaseOwner(index = world.symbols, name = name)
        if len(owner) > 0:
            return out
        return appendExprError(out = out, unit = unit, offset = calleeExpr.start, kind = .exprUndefined, name = name, detail = "文件内没有这个函数", code = "E3-002")
    if site.symbol >= 0:
        let ref = symbolDecl(world = world, symbol = site.symbol)
        if ref.unit >= 0 && isForeignSymbolCode(world.units[ref.unit].ast.decls[ref.decl].kind):
            if !inUnsafeRange(ranges = ranges, offset = calleeExpr.start):
                return appendExprError(out = out, unit = unit, offset = calleeExpr.start, kind = .exprCallFailed, name = name, detail = "外部调用需要 unsafe 上下文", code = "E4-001")
            return out
    site.args = callArguments(unit = unit, unitIndex = unitIndex, node = node, types = types)
    let result = checkCall(world = world, site = site)
    if !result.failed:
        return out
    return appendExprError(out = out, unit = unit, offset = site.offset, kind = .exprCallFailed, name = name, detail = callErrorName(result.error.kind), code = callErrorCode(result.error.kind))

; 不安全上下文区间：`|unsafe` 函数体与 `unsafe (...)` 表达式覆盖的偏移范围。
; 判据按区间归属，闭包体不继承外层这一点在本层无对应节点，故不涉及。
(UnsafeRanges)
starts: Array<I32> = []
ends: Array<I32> = []

; 取区间：函数看声明体，表达式看 unsafe 节点自身。
unsafeRangesOf|func(unit: CompilationUnit,) -> (UnsafeRanges,):
    var out = UnsafeRanges()
    var d = 0
    while d < len(unit.ast.decls):
        let decl = unit.ast.decls[d]
        if decl.isUnsafe && decl.body >= 0:
            out.starts = out.starts.append(decl.start)
            out.ends = out.ends.append(decl.end)
        d = d + 1
    var i = 0
    while i < unit.ast.exprCount():
        if unit.ast.isUnsafeExpr(i):
            let expr = unit.ast.exprAt(i)
            out.starts = out.starts.append(expr.start)
            out.ends = out.ends.append(expr.end)
        i = i + 1
    return out

; 区间归属：起点含、终点含；偏移落在任一段内即不安全上下文。
inUnsafeRange|func(ranges: UnsafeRanges, offset: I32,) -> (Bool,):
    var i = 0
    while i < len(ranges.starts):
        if offset >= ranges.starts[i] && offset <= ranges.ends[i]:
            return true
        i = i + 1
    return false

; 被调名字节点：调用节点的首个子节点且是标识符；未定义函数归调用节点报。
calleeNodeIds|func(unit: CompilationUnit,) -> (Array<I32>,):
    var out: Array<I32> = []
    var i = 0
    while i < unit.ast.exprCount():
        if unit.ast.isCallExpr(i):
            let callee = calleeNode(unit = unit, node = i)
            if callee >= 0 && unit.ast.isIdentifierExpr(callee):
                out = out.append(callee)
        i = i + 1
    return out

; 整数表包含：表小，线性扫够用。
containsId|func(items: Array<I32>, value: I32,) -> (Bool,):
    var i = 0
    while i < len(items):
        if items[i] == value:
            return true
        i = i + 1
    return false

; 单元检查：逐个表达式节点分派；同一节点只走一条分支。
; 被调名字由调用节点报（未定义函数是 E3-002），标识符扫描跳过它，免得同一名字报两条。
checkUnitExprs|func(world: MemberWorld, unitIndex: I32, types: ExprTypes,) -> (ExprCheck,):
    var out = ExprCheck()
    if unitIndex < 0 || unitIndex >= len(world.units):
        return out
    let unit = world.units[unitIndex]
    let bytes = unitBytes(unit)
    let known = unitBareNames(unit = unit)
    let shadow = localOnlyNames(unit = unit)
    let callees = calleeNodeIds(unit = unit)
    let ranges = unsafeRangesOf(unit = unit)
    var i = 0
    while i < unit.ast.exprCount():
        if unit.ast.isIdentifierExpr(i):
            if !containsId(items = callees, value = i):
                out = checkIdentifierNode(world = world, unit = unit, bytes = bytes, locals = known, node = i, out = out)
        elif unit.ast.isMemberExpr(i):
            out = checkMemberNode(world = world, unit = unit, bytes = bytes, shadow = shadow, node = i, out = out)
        elif unit.ast.isCallExpr(i):
            out = checkCallNode(world = world, unit = unit, unitIndex = unitIndex, bytes = bytes, shadow = shadow, types = types, ranges = ranges, node = i, out = out)
        i = i + 1
    out.failed = len(out.errors) > 0
    return out
