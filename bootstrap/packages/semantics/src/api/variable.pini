[variable|import]
_syntax = "../../../syntax"
_module_loader = "../../../module-loader"

; 变量与赋值：声明按标注与初值定型并入作用域，赋值按目标与值判左值、可变性与类型。
; 标注是期望的起点：字面量初值按标注定型（`let x: F64 = 1` 取 F64），再判可赋值。
; 未在作用域登记的名字不在此层报错，名字解析归解析表；成员与下标目标的类型由调用方写入类型表。

; 语句错误：声明、赋值与分支循环共用一条通道，按类别给码。
; 前八类是声明与赋值，后五类是条件、遍历与跳出；位置一律指向语句或表达式起点。
[StoreErrorKind]
storeValueMismatch
storeValueUnknown
storeLetImmutable
storeBadTarget
storeDestructureArity
storeBadPattern
storeCompoundOperand
storeDuplicateName
storeConditionNotBool
storeLoopControlOutside
storeNotIterable
storeIterableArity
storeBadLoopPattern

; 存储错误：类别、文件、源内偏移、相关名字、运算符与期望/实得文本。
(StoreError)
kind: StoreErrorKind = .storeValueMismatch
file: String = ""
offset: I32 = 0
name: String = ""
op: String = ""
expected: String = ""
got: String = ""

; 语句检查结果：池、表达式类型表、走到末尾的作用域、错误、声明清单与循环深度。
; 循环深度只数外层 while 与 for：进循环体加一，出循环还原；break 与 continue 靠它判位置。
; 匹配诊断留在匹配面自己的表里；延迟语句按源序记录，供 IR 排清理栈。
(StoreCheck)
pool: TypePool = TypePool()
types: ExprTypes = ExprTypes()
scope: ScopeStack = ScopeStack()
errors: Array<StoreError> = []
declared: Array<LocalSymbol> = []
loopDepth: I32 = 0
matchCheck: MatchResult = MatchResult()
defers: Array<I32> = []
failed: Bool = false

; 初值定型结果：检查状态与类型下标；-2 表示已判错。
(TypedValue)
check: StoreCheck = StoreCheck()
typeId: I32 = -1

; 错误类别名：诊断、测试与回执共用一份拼写。
storeErrorName|func(_kind: StoreErrorKind,) -> (String,):
    match _kind:
        case storeValueMismatch:
            return "值类型不符"
        case storeValueUnknown:
            return "初值无法定型"
        case storeLetImmutable:
            return "不可变变量被赋值"
        case storeBadTarget:
            return "赋值目标不是左值"
        case storeDestructureArity:
            return "解构个数不匹配"
        case storeBadPattern:
            return "解构模式不合法"
        case storeCompoundOperand:
            return "复合赋值操作数不合"
        case storeDuplicateName:
            return "同块名字重复"
        case storeConditionNotBool:
            return "条件不是布尔"
        case storeLoopControlOutside:
            return "跳出或继续不在循环内"
        case storeNotIterable:
            return "遍历目标不是集合"
        case storeIterableArity:
            return "遍历元素个数不符"
        case storeBadLoopPattern:
            return "遍历模式不合法"
    return "语句错误"

; 同一类别判定：枚举相等比较不可用，按名称比。
isStoreError|func(error: StoreError, kind: StoreErrorKind,) -> (Bool,):
    return storeErrorName(error.kind) == storeErrorName(kind)

; 诊断码：复用宿主已登记的码，不新增码表条目。
storeErrorCode|func(_kind: StoreErrorKind,) -> (String,):
    match _kind:
        case storeValueMismatch:
            return "E4-001"
        case storeValueUnknown:
            return "E4-003"
        case storeLetImmutable:
            return "E4-010"
        case storeBadTarget:
            return "E4-004"
        case storeDestructureArity:
            return "E4-005"
        case storeBadPattern:
            return "E4-001"
        case storeCompoundOperand:
            return "E4-004"
        case storeDuplicateName:
            return "E3-004"
        case storeConditionNotBool:
            return "E4-001"
        case storeLoopControlOutside:
            return "E4-004"
        case storeNotIterable:
            return "E4-004"
        case storeIterableArity:
            return "E4-005"
        case storeBadLoopPattern:
            return "E4-001"
    return "E4-001"

; 造错误：位置取语句或初值起点，运算符只对赋值类错误填。
makeStoreError|func(kind: StoreErrorKind, file: String, offset: I32, name: String, op: String, expected: String, got: String,) -> (StoreError,):
    var out = StoreError()
    out.kind = kind
    out.file = file
    out.offset = offset
    out.name = name
    out.op = op
    out.expected = expected
    out.got = got
    return out

; 追加错误：结果其余字段原样保留，错误不中断后续语句。
appendStoreError|func(out: StoreCheck, unit: CompilationUnit, offset: I32, kind: StoreErrorKind, name: String, op: String, expected: String, got: String,) -> (StoreCheck,):
    var done = out
    done.errors = done.errors.append(makeStoreError(kind = kind, file = unit.path, offset = offset, name = name, op = op, expected = expected, got = got))
    return done

; 类型文本：下标越界答占位，诊断不因未定而空着。
storeTypeText|func(pool: TypePool, id: I32,) -> (String,):
    if id < 0 || id >= len(pool.entries):
        return "<未定>"
    return typeText(pool = pool, id = id)

; 标注解析：语句上的类型标注不在类型池的绑定表里，就地解析并按新池带回。
resolveAnnotation|func(world: MemberWorld, unit: CompilationUnit, node: I32, out: StoreCheck,) -> (TypeInsert,):
    var result = hitType(pool = out.pool, id = -1)
    if node < 0:
        return result
    var cursor = TypeCursor()
    var types = TypeWorld()
    types.units = world.units
    types.table = world.table
    cursor.world = types
    cursor.file = unit.path
    cursor.ast = unit.ast
    cursor.bytes = tempUtf8Bytes(unit.text)
    let resolved = resolveNode(cursor = cursor, pool = out.pool, typeId = node)
    return hitType(pool = resolved.pool, id = resolved.root)

; 初值定型：先读类型表；未写且是基本字面量时按期望补判，失败按无解或类型不符记账。
checkInitializer|func(unit: CompilationUnit, unitIndex: I32, node: I32, expected: I32, name: String, out: StoreCheck,) -> (TypedValue,):
    var working = out
    var typeId = typeOfExprNode(unit = unit, unitIndex = unitIndex, node = node, scope = working.scope, types = working.types, pool = working.pool)
    if typeId < 0 && node >= 0 && node < unit.ast.exprCount() && unit.ast.isLiteralExpr(node):
        var expectation = noExpectation()
        if expected >= 0:
            expectation = expectType(expected)
        let typed = checkLiteral(unit = unit, unitIndex = unitIndex, node = node, expectation = expectation, pool = working.pool, types = working.types)
        working.pool = typed.pool
        working.types = typed.types
        if typed.failed:
            if isLiteralError(error = typed.error, kind = literalNeedsExpectation):
                working = appendStoreError(out = working, unit = unit, offset = typed.error.offset, kind = storeValueUnknown, name = name, op = "", expected = "", got = "")
            else:
                working = appendStoreError(out = working, unit = unit, offset = typed.error.offset, kind = storeValueMismatch, name = name, op = "", expected = typed.error.expected, got = typed.error.got)
            typeId = errorTypeId()
        else:
            typeId = typed.typeId
    var done = TypedValue()
    done.check = working
    done.typeId = typeId
    return done

; 声明一个局部：同块重名照原样报错，成功则记入声明清单。
declareStore|func(out: StoreCheck, unit: CompilationUnit, name: String, typeId: I32, mutable: Bool, offset: I32,) -> (StoreCheck,):
    return declareStoreAs(out = out, unit = unit, kind = localVariable, name = name, typeId = typeId, mutable = mutable, offset = offset)

; 按种类声明一个局部：循环变量与普通局部共用一条，只有种类与初始可变性不同。
declareStoreAs|func(out: StoreCheck, unit: CompilationUnit, kind: LocalKind, name: String, typeId: I32, mutable: Bool, offset: I32,) -> (StoreCheck,):
    let declared = declareLocal(stack = out.scope, kind = kind, spelling = name, typeId = typeId, mutable = mutable, file = unit.path, offset = offset, decl = -1)
    if declared.failed:
        return appendStoreError(out = out, unit = unit, offset = declared.error.offset, kind = storeDuplicateName, name = name, op = "", expected = "", got = "")
    var done = out
    done.scope = declared.stack
    done.declared = done.declared.append(declared.stack.localAt(declared.index))
    return done

; 元组解构：按初值元组的分量逐位声明；个数不符报一条，非名字位各报一条。
checkDestructure|func(world: MemberWorld, unit: CompilationUnit, unitIndex: I32, pattern: I32, init: I32, mutable: Bool, offset: I32, out: StoreCheck,) -> (StoreCheck,):
    let kids = unit.ast.exprAt(pattern).kids
    let bytes = tempUtf8Bytes(unit.text)
    var working = out
    var components: Array<I32> = []
    var knownTuple = false
    if init >= 0:
        let typed = checkInitializer(unit = unit, unitIndex = unitIndex, node = init, expected = -1, name = "", out = working)
        working = typed.check
        if typed.typeId >= 0 && typed.typeId < len(working.pool.entries):
            let entry = working.pool.entries[typed.typeId]
            if isTypeClass(kind = entry.kind, expected = typeClassTuple):
                knownTuple = true
                components = entry.kids
            else:
                let got = typeText(pool = working.pool, id = typed.typeId)
                working = appendStoreError(out = working, unit = unit, offset = offset, kind = storeDestructureArity, name = "", op = "", expected = "元组", got = got)
    if knownTuple && len(components) != len(kids):
        let expected = countText(len(components))
        let got = countText(len(kids))
        working = appendStoreError(out = working, unit = unit, offset = offset, kind = storeDestructureArity, name = "", op = "", expected = expected, got = got)
    var i = 0
    while i < len(kids):
        let kid = kids[i]
        if unit.ast.isIdentifierExpr(kid):
            let expr = unit.ast.exprAt(kid)
            let name = decodeRange(bytes = bytes, start = expr.nameStart, end = expr.nameEnd)
            if name != "_":
                var typeId = -1
                if knownTuple && i < len(components):
                    typeId = components[i]
                working = declareStore(out = working, unit = unit, name = name, typeId = typeId, mutable = mutable, offset = expr.start)
        else:
            working = appendStoreError(out = working, unit = unit, offset = unit.ast.exprAt(kid).start, kind = storeBadPattern, name = "", op = "", expected = "名字", got = "其他形态")
        i = i + 1
    return working

; 变量声明：单名或元组解构，标注与初值先判一致再入作用域。
checkVariableDecl|func(world: MemberWorld, unit: CompilationUnit, unitIndex: I32, stmtId: I32, out: StoreCheck,) -> (StoreCheck,):
    let stmt = unit.ast.stmtAt(stmtId)
    let mutable = unit.ast.isMutableVariableStmt(stmtId)
    let pattern = unit.ast.stmtChild(id = stmtId, index = 0)
    let init = unit.ast.stmtChild(id = stmtId, index = 1)
    var working = out
    var annotation = -1
    if stmt.typeId >= 0:
        let resolved = resolveAnnotation(world = world, unit = unit, node = stmt.typeId, out = working)
        working.pool = resolved.pool
        annotation = resolved.id
    if pattern < 0:
        return working
    if unit.ast.isTupleExpr(pattern):
        return checkDestructure(world = world, unit = unit, unitIndex = unitIndex, pattern = pattern, init = init, mutable = mutable, offset = stmt.start, out = working)
    if !unit.ast.isIdentifierExpr(pattern):
        return appendStoreError(out = working, unit = unit, offset = stmt.start, kind = storeBadPattern, name = "", op = "", expected = "名字或元组", got = "其他形态")
    let expr = unit.ast.exprAt(pattern)
    let name = decodeRange(bytes = tempUtf8Bytes(unit.text), start = expr.nameStart, end = expr.nameEnd)
    var initType = -1
    if init >= 0:
        let typed = checkInitializer(unit = unit, unitIndex = unitIndex, node = init, expected = annotation, name = name, out = working)
        working = typed.check
        initType = typed.typeId
        if annotation >= 0 && initType >= 0 && !isAssignable(pool = working.pool, from = initType, to = annotation):
            let expected = storeTypeText(pool = working.pool, id = annotation)
            let got = storeTypeText(pool = working.pool, id = initType)
            working = appendStoreError(out = working, unit = unit, offset = unit.ast.exprAt(init).start, kind = storeValueMismatch, name = name, op = "", expected = expected, got = got)
    if name == "_":
        return working
    var declaredType = annotation
    if declaredType < 0 && initType >= 0:
        declaredType = initType
    return declareStore(out = working, unit = unit, name = name, typeId = declaredType, mutable = mutable, offset = stmt.start)

; 赋值目标：名字查作用域并判可变性，成员与下标只认类型表；其余形态不是左值。
checkAssignStmt|func(world: MemberWorld, unit: CompilationUnit, unitIndex: I32, stmtId: I32, out: StoreCheck,) -> (StoreCheck,):
    let stmt = unit.ast.stmtAt(stmtId)
    let target = unit.ast.stmtChild(id = stmtId, index = 0)
    let value = unit.ast.stmtChild(id = stmtId, index = 1)
    if target < 0 || value < 0:
        return out
    let offset = unit.ast.exprAt(target).start
    var working = out
    var targetType = -1
    var name = ""
    if unit.ast.isIdentifierExpr(target):
        let expr = unit.ast.exprAt(target)
        name = decodeRange(bytes = tempUtf8Bytes(unit.text), start = expr.nameStart, end = expr.nameEnd)
        let at = lookupName(stack = working.scope, spelling = name)
        if at >= 0:
            let local = working.scope.localAt(at)
            targetType = local.typeId
            if !local.mutable:
                return appendStoreError(out = working, unit = unit, offset = offset, kind = storeLetImmutable, name = name, op = "=", expected = "", got = "")
    elif unit.ast.isMemberExpr(target) || unit.ast.isSubscriptExpr(target):
        targetType = exprTypeAt(table = working.types, unit = unitIndex, node = target)
    else:
        let got = storeTypeText(pool = working.pool, id = typeOfExprNode(unit = unit, unitIndex = unitIndex, node = target, scope = working.scope, types = working.types, pool = working.pool))
        return appendStoreError(out = working, unit = unit, offset = offset, kind = storeBadTarget, name = "", op = "=", expected = "", got = got)
    let compound = compoundBinaryTag(stmt.op)
    if compound == 0:
        let typed = checkInitializer(unit = unit, unitIndex = unitIndex, node = value, expected = targetType, name = name, out = working)
        working = typed.check
        if targetType >= 0 && typed.typeId >= 0 && !isAssignable(pool = working.pool, from = typed.typeId, to = targetType):
            let expected = storeTypeText(pool = working.pool, id = targetType)
            let got = storeTypeText(pool = working.pool, id = typed.typeId)
            working = appendStoreError(out = working, unit = unit, offset = unit.ast.exprAt(value).start, kind = storeValueMismatch, name = name, op = "=", expected = expected, got = got)
        return working
    let typed = checkInitializer(unit = unit, unitIndex = unitIndex, node = value, expected = targetType, name = name, out = working)
    working = typed.check
    if targetType < 0 || typed.typeId < 0:
        return working
    let symbol = opSymbol(compound)
    let result = checkBinary(pool = working.pool, op = symbol, left = targetType, right = typed.typeId, file = unit.path, offset = offset)
    working.pool = result.pool
    if result.failed:
        return appendStoreError(out = working, unit = unit, offset = offset, kind = storeCompoundOperand, name = name, op = symbol, expected = result.error.expected, got = result.error.got)
    if !isAssignable(pool = working.pool, from = result.typeId, to = targetType):
        let expected = storeTypeText(pool = working.pool, id = targetType)
        let got = storeTypeText(pool = working.pool, id = result.typeId)
        return appendStoreError(out = working, unit = unit, offset = offset, kind = storeValueMismatch, name = name, op = symbol, expected = expected, got = got)
    return working

; 走一块：进块帧后按源序逐条，退出时截断局部，槽位留给同一函数的后续块。
walkStoreBlock|func(world: MemberWorld, unit: CompilationUnit, unitIndex: I32, blockId: I32, out: StoreCheck,) -> (StoreCheck,):
    if blockId < 0 || blockId >= unit.ast.stmtCount():
        return out
    var inner = out
    inner.scope = enterScope(stack = out.scope, kind = scopeBlock, file = unit.path, offset = unit.ast.stmtAt(blockId).start)
    let kids = unit.ast.stmtAt(blockId).kids
    var i = 0
    while i < len(kids):
        inner = walkStoreStmt(world = world, unit = unit, unitIndex = unitIndex, stmtId = kids[i], out = inner)
        i = i + 1
    inner.scope = leaveScope(inner.scope)
    return inner

; 走一条语句：声明与赋值就地判，控制流逐个下钻到块，其余语句不归本层。
walkStoreStmt|func(world: MemberWorld, unit: CompilationUnit, unitIndex: I32, stmtId: I32, out: StoreCheck,) -> (StoreCheck,):
    if stmtId < 0 || stmtId >= unit.ast.stmtCount():
        return out
    let ast = unit.ast
    if ast.isVariableStmt(stmtId):
        return checkVariableDecl(world = world, unit = unit, unitIndex = unitIndex, stmtId = stmtId, out = out)
    if ast.isAssignStmt(stmtId):
        return checkAssignStmt(world = world, unit = unit, unitIndex = unitIndex, stmtId = stmtId, out = out)
    if ast.isBlockStmt(stmtId):
        return walkStoreBlock(world = world, unit = unit, unitIndex = unitIndex, blockId = stmtId, out = out)
    if ast.isIfStmt(stmtId):
        return walkIfStmt(world = world, unit = unit, unitIndex = unitIndex, stmtId = stmtId, out = out)
    if ast.isWhileStmt(stmtId):
        return walkWhileStmt(world = world, unit = unit, unitIndex = unitIndex, stmtId = stmtId, out = out)
    if ast.isForStmt(stmtId):
        return walkForStmt(world = world, unit = unit, unitIndex = unitIndex, stmtId = stmtId, out = out)
    if ast.isBreakStmt(stmtId):
        return checkLoopControl(unit = unit, stmtId = stmtId, keyword = "break", out = out)
    if ast.isContinueStmt(stmtId):
        return checkLoopControl(unit = unit, stmtId = stmtId, keyword = "continue", out = out)
    if ast.isMatchStmt(stmtId):
        return walkMatchStmt(world = world, unit = unit, unitIndex = unitIndex, stmtId = stmtId, out = out)
    if ast.isDeferStmt(stmtId):
        return walkDeferStmt(world = world, unit = unit, unitIndex = unitIndex, stmtId = stmtId, out = out)
    return out

; 检查入口：播种函数帧后走一遍体；块帧退出，作用域回到参数层，声明清单留全量记录。
checkFunctionStores|func(world: MemberWorld, unitIndex: I32, declId: I32, types: ExprTypes,) -> (StoreCheck,):
    let seed = seedFunctionScope(world = world, unitIndex = unitIndex, declId = declId)
    var out = StoreCheck()
    out.pool = seed.pool
    out.types = types
    if !seed.valid:
        return out
    out.scope = seed.scope
    let unit = world.units[unitIndex]
    let decl = unit.ast.decls[declId]
    if decl.body < 0:
        return out
    out = walkStoreBlock(world = world, unit = unit, unitIndex = unitIndex, blockId = decl.body, out = out)
    out.failed = len(out.errors) + len(out.matchCheck.errors) > 0
    return out
