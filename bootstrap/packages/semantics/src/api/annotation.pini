[annotation|import]
_syntax = "../../../syntax"
_module_loader = "../../../module-loader"

; 类型形参绑定：实例化后把形参名对到具体类型的池下标，模板解析期为空。
(GenericBinding)
name: String = ""
typeId: I32 = -1

; 类型世界：全部编译单元与符号表；具名类型查声明、字段环查成员体都从这里取。
; `genericBindings` 非空时解析器先认类型形参名。
(TypeWorld)
units: Array<CompilationUnit> = []
table: SymbolTable = SymbolTable()
genericBindings: Array<GenericBinding> = []

; 类型绑定：单元下标与声明下标对上类型池下标，供后续检查与降载消费。
(TypeBinding)
unit: I32 = -1
decl: I32 = -1
typeId: I32 = -1

; 类型成员：名义类型的字段或载荷类型，连同声明位置；环检测沿这张表走值语义链。
(TypeMember)
owner: String = ""
ownerKey: Array<U8> = []
form: I32 = 0
file: String = ""
offset: I32 = 0
types: Array<I32> = []

; 解析上下文：源文本、语法树与文件路径在一次单元解析内固定；外部面额外放开句柄类型。
(TypeCursor)
world: TypeWorld = TypeWorld()
file: String = ""
ast: Ast = Ast()
bytes: Array<U8> = []
foreignFace: Bool = false

; 单次解析结果：池与根下标；根为 -1 表示这次解析失败。
(TypeResolution)
pool: TypePool = TypePool()
root: I32 = -1

; 解析过程：池、绑定与成员表随遍历累积；last 是本轮最后一个根下标。
(TypePass)
pool: TypePool = TypePool()
bindings: Array<TypeBinding> = []
members: Array<TypeMember> = []
last: I32 = -1

; 环遍历状态：state 按池下标记 0 白、1 灰、2 黑。
(TypeWalk)
state: Array<I32> = []
cycle: Bool = false

; 类型表：池、按路径与声明序排好的绑定、聚合成员与每单元的绑定起点；错误统一挂在池上。
; `overrides` 是实例表，优先于全局绑定回答模板形参与返回类型。
(TypeTable)
pool: TypePool = TypePool()
bindings: Array<TypeBinding> = []
members: Array<TypeMember> = []
unitStart: Array<I32> = []
overrides: Array<TypeBinding> = []

; 每单元的绑定起点：绑定按单元升序连续追加，扫一遍即得各单元首条下标。
unitStarts|func(bindings: Array<TypeBinding>, unitCount: I32,) -> (Array<I32>,):
    var out: Array<I32> = []
    var at = 0
    var u = 0
    while u < unitCount:
        while at < len(bindings) && bindings[at].unit < u:
            at = at + 1
        out = out.append(at)
        u = u + 1
    return out

((TypeTable))
; 可用：池没有类型错误。
isOK|self() -> (Bool,):
    return self.pool.isOK()
errorCount|self() -> (I32,):
    return self.pool.errorCount()
errorAt|self(_index: I32,) -> (TypeError,):
    return self.pool.errorAt(_index)
bindingCount|self() -> (I32,):
    return len(self.bindings)
; 声明查类型：绑定按单元升序连续追加，先跳到该单元的首条再顺序扫，越过单元即止。
; 同一单元内同一声明只留一条绑定；找不到答 -1。
typeOf|self(unit: I32, decl: I32,) -> (I32,):
    var o = 0
    while o < len(self.overrides):
        if self.overrides[o].unit == unit && self.overrides[o].decl == decl:
            return self.overrides[o].typeId
        o = o + 1
    var i = 0
    if unit >= 0 && unit < len(self.unitStart):
        i = self.unitStart[unit]
    while i < len(self.bindings):
        if self.bindings[i].unit > unit:
            return -1
        if self.bindings[i].unit == unit && self.bindings[i].decl == decl:
            return self.bindings[i].typeId
        i = i + 1
    return -1
; 声明查文本：先查绑定再出规范化文本，诊断与接口产物共用这一条路径。
textOf|self(unit: I32, decl: I32,) -> (String,):
    let at = self.typeOf(unit = unit, decl = decl)
    if at < 0:
        return "<无效>"
    return typeText(pool = self.pool, id = at)

; 内建值类型：数值、布尔、字符、字符串与内建错误类型；具名解析先查这张表。
isBuiltinType|func(_name: String,) -> (Bool,):
    if _name == "I8" || _name == "I16":
        return true
    if _name == "I32" || _name == "I64":
        return true
    if _name == "U8" || _name == "U16":
        return true
    if _name == "U32" || _name == "U64":
        return true
    if _name == "F32" || _name == "F64":
        return true
    if _name == "Bool" || _name == "Char" || _name == "String":
        return true
    if _name == "Error" || _name == "CancelError":
        return true
    return false

; 容器实参个数：可接受的最小个数，非容器答 -1。
containerMinArity|func(_name: String,) -> (I32,):
    if _name == "Array" || _name == "Set" || _name == "Optional":
        return 1
    if _name == "Dictionary":
        return 2
    if _name == "Result" || _name == "LazyRef" || _name == "Future" || _name == "WeakRef":
        return 1
    return -1

; 容器实参判定：结果类型允许省略错误实参，其余只认一个数。
containerAccepts|func(name: String, count: I32,) -> (Bool,):
    if name == "Array" || name == "Set" || name == "Optional" || name == "LazyRef" || name == "Future" || name == "WeakRef":
        return count == 1
    if name == "Dictionary":
        return count == 2
    if name == "Result":
        return count == 1 || count == 2
    return false

; 容器类别：数组、字典与集合同归集合类，其余各自成类。
containerClass|func(_name: String,) -> (TypeClass,):
    if _name == "Array" || _name == "Set" || _name == "Dictionary":
        return .typeClassCollection
    if _name == "Optional":
        return .typeClassOptional
    if _name == "LazyRef" || _name == "Future" || _name == "WeakRef":
        return .typeClassGeneric
    return .typeClassResult

; 声明查类别码：按文件与源内偏移在单元里找顶层声明；找不到答 -1。
declKindOf|func(world: TypeWorld, file: String, offset: I32,) -> (I32,):
    var i = 0
    while i < len(world.units):
        if world.units[i].path == file:
            let ast = world.units[i].ast
            var j = 0
            while j < len(ast.items):
                let decl = ast.decls[ast.items[j]]
                if decl.start == offset:
                    return decl.kind
                j = j + 1
        i = i + 1
    return -1

; 解析一个类型节点：失败时根为 -1，错误已记在池上。
resolveNode|func(cursor: TypeCursor, pool: TypePool, typeId: I32,) -> (TypeResolution,):
    var out = TypeResolution()
    out.pool = pool
    if typeId < 0 || typeId >= len(cursor.ast.types):
        return out
    let node = cursor.ast.typeAt(typeId)
    if isArrayTypeCode(node.kind):
        return resolveContainerType(cursor = cursor, pool = pool, node = node, name = "Array")
    if isSetTypeCode(node.kind):
        return resolveContainerType(cursor = cursor, pool = pool, node = node, name = "Set")
    if isDictionaryTypeCode(node.kind):
        return resolveContainerType(cursor = cursor, pool = pool, node = node, name = "Dictionary")
    if isResultTypeCode(node.kind):
        return resolveContainerType(cursor = cursor, pool = pool, node = node, name = "Result")
    if isOptionalTypeCode(node.kind):
        return wrapResolved(cursor = cursor, pool = pool, kind = .typeClassOptional, name = "", child = cursor.ast.typeChild(id = typeId, index = 0))
    if isPointerTypeCode(node.kind):
        return wrapResolved(cursor = cursor, pool = pool, kind = .typeClassPointer, name = "", child = cursor.ast.typeChild(id = typeId, index = 0))
    if isTupleTypeCode(node.kind):
        return resolveTuple(cursor = cursor, pool = pool, node = node)
    if isFunctionTypeCode(node.kind):
        return resolveFunction(cursor = cursor, pool = pool, node = node)
    let name = decodeRange(bytes = cursor.bytes, start = node.nameStart, end = node.nameEnd)
    if isGenericTypeCode(node.kind):
        return resolveGeneric(cursor = cursor, pool = pool, node = node, name = name)
    if isNamedTypeCode(node.kind):
        return resolveNamed(cursor = cursor, pool = pool, node = node, name = name)
    return out

; 单层包装：可选与指针共用一条路径，子类型失败则整条失败。
wrapResolved|func(cursor: TypeCursor, pool: TypePool, kind: TypeClass, name: String, child: I32,) -> (TypeResolution,):
    var out = TypeResolution()
    let inner = resolveNode(cursor = cursor, pool = pool, typeId = child)
    if inner.root < 0:
        out.pool = inner.pool
        return out
    var kids: Array<I32> = []
    kids = kids.append(inner.root)
    let inserted = intern(pool = inner.pool, kind = kind, name = name, kids = kids, ret = -1)
    out.pool = inserted.pool
    out.root = inserted.id
    return out

; 容器写法糖：`[T,]`、`{T,}`、`{K: V,}`、`^T` 四类各自的组件逐个解析，
; 再按容器名驻留；结果类的错误实参在驻留时补内建 `Error`。
resolveContainerType|func(cursor: TypeCursor, pool: TypePool, node: TypeNode, name: String,) -> (TypeResolution,):
    var out = TypeResolution()
    var ids: Array<I32> = []
    var failed = false
    var working = pool
    var i = 0
    while i < len(node.kids):
        let item = resolveNode(cursor = cursor, pool = working, typeId = node.kids[i])
        working = item.pool
        if item.root < 0:
            failed = true
        else:
            ids = ids.append(item.root)
        i = i + 1
    out.pool = working
    if failed:
        return out
    if name == "Result" && len(ids) == 1:
        let error = intern(pool = working, kind = .typeClassScalar, name = "Error", kids = [], ret = -1)
        working = error.pool
        ids = ids.append(error.id)
    let inserted = intern(pool = working, kind = containerClass(name), name = name, kids = ids, ret = -1)
    out.pool = inserted.pool
    out.root = inserted.id
    return out

; 元组：逐个解析分量，空表即 `()`。
resolveTuple|func(cursor: TypeCursor, pool: TypePool, node: TypeNode,) -> (TypeResolution,):
    var out = TypeResolution()
    var ids: Array<I32> = []
    var failed = false
    var working = pool
    var i = 0
    while i < len(node.kids):
        let item = resolveNode(cursor = cursor, pool = working, typeId = node.kids[i])
        working = item.pool
        if item.root < 0:
            failed = true
        else:
            ids = ids.append(item.root)
        i = i + 1
    out.pool = working
    if failed:
        return out
    let inserted = intern(pool = working, kind = .typeClassTuple, name = "", kids = ids, ret = -1)
    out.pool = inserted.pool
    out.root = inserted.id
    return out

; 函数类型：形参逐个解析，返回类型单独解析；返回缺失按失败收尾。
resolveFunction|func(cursor: TypeCursor, pool: TypePool, node: TypeNode,) -> (TypeResolution,):
    var out = TypeResolution()
    var ids: Array<I32> = []
    var failed = false
    var working = pool
    var i = 0
    while i < len(node.kids):
        let item = resolveNode(cursor = cursor, pool = working, typeId = node.kids[i])
        working = item.pool
        if item.root < 0:
            failed = true
        else:
            ids = ids.append(item.root)
        i = i + 1
    let ret = resolveNode(cursor = cursor, pool = working, typeId = node.ret)
    working = ret.pool
    if ret.root < 0:
        failed = true
    out.pool = working
    if failed:
        return out
    let inserted = intern(pool = working, kind = .typeClassFunction, name = "", kids = ids, ret = ret.root)
    out.pool = inserted.pool
    out.root = inserted.id
    return out

; 具名类型：内建表、容器名、符号表依次判；容器不带实参即报个数不符。
; `StringHandle` 只在不透明句柄面上成立：外部符号走这一路，`|c` 条目待导出面接入同一个开关。
; 普通声明走到这里即报「名字只在外部面成立」，不静默放行。
resolveNamed|func(cursor: TypeCursor, pool: TypePool, node: TypeNode, name: String,) -> (TypeResolution,):
    var out = TypeResolution()
    out.pool = pool
    var g = 0
    while g < len(cursor.world.genericBindings):
        if cursor.world.genericBindings[g].name == name:
            out.root = cursor.world.genericBindings[g].typeId
            return out
        g = g + 1
    if name == "StringHandle":
        if !cursor.foreignFace:
            out.pool = addTypeError(pool = pool, error = makeTypeError(kind = .typeErrorForeignOnlyName, file = cursor.file, offset = node.start, name = name))
            return out
        return internNamed(pool = pool, kind = .typeClassOpaque, name = name)
    if isBuiltinType(name):
        let inserted = intern(pool = pool, kind = .typeClassScalar, name = name, kids = [], ret = -1)
        out.pool = inserted.pool
        out.root = inserted.id
        return out
    if containerMinArity(name) >= 0:
        out.pool = addTypeError(pool = pool, error = makeTypeError(kind = .typeErrorArityMismatch, file = cursor.file, offset = node.start, name = name))
        return out
    let at = cursor.world.table.topIndex(keyOfText(name))
    if at < 0:
        out.pool = addTypeError(pool = pool, error = makeTypeError(kind = .typeErrorUnknownName, file = cursor.file, offset = node.start, name = name))
        return out
    let symbol = cursor.world.table.symbolAt(at)
    let code = declKindOf(world = cursor.world, file = symbol.file, offset = symbol.offset)
    if isStructDeclCode(code) || isGivenDeclCode(code):
        return internNamed(pool = pool, kind = .typeClassStruct, name = name)
    if isObjectDeclCode(code):
        return internNamed(pool = pool, kind = .typeClassObject, name = name)
    if isEnumDeclCode(code):
        return internNamed(pool = pool, kind = .typeClassEnum, name = name)
    out.pool = addTypeError(pool = pool, error = makeTypeError(kind = .typeErrorNotTypeName, file = cursor.file, offset = node.start, name = name))
    return out

; 具名条目驻留：结构、对象、枚举与不透明句柄共用一条。
internNamed|func(pool: TypePool, kind: TypeClass, name: String,) -> (TypeResolution,):
    var out = TypeResolution()
    let inserted = intern(pool = pool, kind = kind, name = name, kids = [], ret = -1)
    out.pool = inserted.pool
    out.root = inserted.id
    return out

; 泛型实例：容器按实参个数与约束判定，内建与用户类型在本批都不带实参。
resolveGeneric|func(cursor: TypeCursor, pool: TypePool, node: TypeNode, name: String,) -> (TypeResolution,):
    var out = TypeResolution()
    var ids: Array<I32> = []
    var failed = false
    var working = pool
    var i = 0
    while i < len(node.kids):
        let item = resolveNode(cursor = cursor, pool = working, typeId = node.kids[i])
        working = item.pool
        if item.root < 0:
            failed = true
        else:
            ids = ids.append(item.root)
        i = i + 1
    out.pool = working
    if failed:
        return out
    if containerMinArity(name) < 0:
        if isBuiltinType(name) || cursor.world.table.topIndex(keyOfText(name)) >= 0:
            out.pool = addTypeError(pool = working, error = makeTypeError(kind = .typeErrorArityMismatch, file = cursor.file, offset = node.start, name = name))
            return out
        out.pool = addTypeError(pool = working, error = makeTypeError(kind = .typeErrorUnknownName, file = cursor.file, offset = node.start, name = name))
        return out
    if !containerAccepts(name = name, count = len(ids)):
        out.pool = addTypeError(pool = working, error = makeTypeError(kind = .typeErrorArityMismatch, file = cursor.file, offset = node.start, name = name))
        return out
    if name == "Result" && len(ids) == 2 && !isBuiltinError(id = ids[1], pool = working):
        out.pool = addTypeError(pool = working, error = makeTypeError(kind = .typeErrorConstraint, file = cursor.file, offset = node.start, name = name))
        return out
    let inserted = intern(pool = working, kind = containerClass(name), name = name, kids = ids, ret = -1)
    out.pool = inserted.pool
    out.root = inserted.id
    return out

; 结果类型的错误实参：只认内建 Error；其余在约束处报错。
isBuiltinError|func(id: I32, pool: TypePool,) -> (Bool,):
    if id < 0 || id >= len(pool.entries):
        return false
    let entry = pool.entries[id]
    return isTypeClass(kind = entry.kind, expected = .typeClassScalar) && entry.name == "Error"

; 解析一个单元：按顶层序走，声明上的全部标注各留一条绑定。
; 标注解析（带游标）：调用方复用同一游标时不必为每条声明重建类型世界。
; 游标里的源与单元由调用方按单元切换；池只读，增长由返回值带回。
resolveAnnotationIn|func(cursor: TypeCursor, pool: TypePool, node: I32,) -> (TypeInsert,):
    if node < 0:
        return hitType(pool = pool, id = -1)
    let resolved = resolveNode(cursor = cursor, pool = pool, typeId = node)
    return hitType(pool = resolved.pool, id = resolved.root)

resolveUnit|func(stage: TypePass, world: TypeWorld, unitIndex: I32,) -> (TypePass,):
    let unit = world.units[unitIndex]
    var cursor = TypeCursor()
    cursor.world = world
    cursor.file = unit.path
    cursor.ast = unit.ast
    cursor.bytes = unitBytes(unit)
    var out = stage
    var i = 0
    while i < len(unit.ast.items):
        out = resolveDecl(stage = out, cursor = cursor, unitIndex = unitIndex, declId = unit.ast.items[i])
        i = i + 1
    return out

; 顶层声明分派：类型连带成员，函数连带签名，外部块与扩展块各走一面。
resolveDecl|func(stage: TypePass, cursor: TypeCursor, unitIndex: I32, declId: I32,) -> (TypePass,):
    let decl = cursor.ast.decls[declId]
    var out = stage
    if isTypeDecl(decl):
        let owner = decodeRange(bytes = cursor.bytes, start = decl.nameStart, end = decl.nameEnd)
        out = openMember(stage = out, owner = owner, form = decl.kind, file = cursor.file, offset = decl.start)
        return resolveNominalMembers(stage = out, cursor = cursor, unitIndex = unitIndex, decl = decl, owner = owner)
    if isFunctionDeclCode(decl.kind):
        if len(decl.generic) > 0:
            return out
        out = resolveOne(stage = out, cursor = cursor, unitIndex = unitIndex, declId = declId, typeId = decl.typeId)
        return resolveSignature(stage = out, cursor = cursor, unitIndex = unitIndex, decl = decl)
    if isForeignDeclCode(decl.kind):
        return resolveForeignBlock(stage = out, cursor = cursor, unitIndex = unitIndex, decl = decl)
    if isExtensionDeclCode(decl.kind):
        var i = 0
        while i < len(decl.kids):
            let member = cursor.ast.decls[decl.kids[i]]
            if isFunctionDeclCode(member.kind):
                out = resolveOne(stage = out, cursor = cursor, unitIndex = unitIndex, declId = decl.kids[i], typeId = member.typeId)
                out = resolveSignature(stage = out, cursor = cursor, unitIndex = unitIndex, decl = member)
            i = i + 1
        return out
    return out

; 外部块：逐条解析符号类型；这一路放开句柄类型，条目按声明序留绑定。
resolveForeignBlock|func(stage: TypePass, cursor: TypeCursor, unitIndex: I32, decl: DeclNode,) -> (TypePass,):
    var out = stage
    var inner = cursor
    inner.foreignFace = true
    var i = 0
    while i < len(decl.kids):
        let symbol = cursor.ast.decls[decl.kids[i]]
        if isForeignSymbolCode(symbol.kind):
            out = resolveOne(stage = out, cursor = inner, unitIndex = unitIndex, declId = decl.kids[i], typeId = symbol.typeId)
        i = i + 1
    return out

; 开一条成员记录：类型声明每出现一次建一条，字段与载荷随后往里追加。
openMember|func(stage: TypePass, owner: String, form: I32, file: String, offset: I32,) -> (TypePass,):
    var out = stage
    var member = TypeMember()
    member.owner = owner
    member.ownerKey = keyOfText(owner)
    member.form = form
    member.file = file
    member.offset = offset
    out.members = out.members.append(member)
    return out

; 名义类型的成员：字段与枚举载荷进成员表，方法只走签名。
resolveNominalMembers|func(stage: TypePass, cursor: TypeCursor, unitIndex: I32, decl: DeclNode, owner: String,) -> (TypePass,):
    var out = stage
    var i = 0
    while i < len(decl.kids):
        let member = cursor.ast.decls[decl.kids[i]]
        if isFieldDeclCode(member.kind):
            out = resolveOne(stage = out, cursor = cursor, unitIndex = unitIndex, declId = decl.kids[i], typeId = member.typeId)
            out = appendMemberType(stage = out, owner = owner, typeId = out.last)
        if isVariantDeclCode(member.kind):
            out = resolveVariantTypes(stage = out, cursor = cursor, unitIndex = unitIndex, variant = member, owner = owner)
        if isFunctionDeclCode(member.kind):
            out = resolveOne(stage = out, cursor = cursor, unitIndex = unitIndex, declId = decl.kids[i], typeId = member.typeId)
            out = resolveSignature(stage = out, cursor = cursor, unitIndex = unitIndex, decl = member)
        i = i + 1
    return out

; 枚举载荷：每个参数的类型都算存储成员，参与环检测。
resolveVariantTypes|func(stage: TypePass, cursor: TypeCursor, unitIndex: I32, variant: DeclNode, owner: String,) -> (TypePass,):
    var out = stage
    var i = 0
    while i < len(variant.kids):
        let param = cursor.ast.decls[variant.kids[i]]
        if isParamDeclCode(param.kind):
            out = resolveOne(stage = out, cursor = cursor, unitIndex = unitIndex, declId = variant.kids[i], typeId = param.typeId)
            out = appendMemberType(stage = out, owner = owner, typeId = out.last)
        i = i + 1
    return out

; 函数签名：返回类型与各参数类型各留一条绑定。
resolveSignature|func(stage: TypePass, cursor: TypeCursor, unitIndex: I32, decl: DeclNode,) -> (TypePass,):
    var out = stage
    var i = 0
    while i < len(decl.kids):
        let param = cursor.ast.decls[decl.kids[i]]
        if isParamDeclCode(param.kind):
            out = resolveOne(stage = out, cursor = cursor, unitIndex = unitIndex, declId = decl.kids[i], typeId = param.typeId)
        i = i + 1
    return out

; 追加成员类型：根无效时跳过，成员表只收成功解析的下标。
appendMemberType|func(stage: TypePass, owner: String, typeId: I32,) -> (TypePass,):
    if typeId < 0:
        return stage
    let key = keyOfText(owner)
    var out = stage
    var i = 0
    while i < len(out.members):
        if sameKey(first = out.members[i].ownerKey, second = key):
            out.members[i].types = out.members[i].types.append(typeId)
            return out
        i = i + 1
    return out

; 解析一条声明上的标注：成功则登记绑定，失败只留下池里的错误。
resolveOne|func(stage: TypePass, cursor: TypeCursor, unitIndex: I32, declId: I32, typeId: I32,) -> (TypePass,):
    var out = stage
    out.last = -1
    if typeId < 0:
        return out
    let resolved = resolveNode(cursor = cursor, pool = out.pool, typeId = typeId)
    out.pool = resolved.pool
    if resolved.root < 0:
        return out
    var binding = TypeBinding()
    binding.unit = unitIndex
    binding.decl = declId
    binding.typeId = resolved.root
    out.bindings = out.bindings.append(binding)
    out.last = resolved.root
    return out

; 解析一个包：单元按路径排序后逐条解析，最后判字段环。
resolvePackage|func(units: Array<CompilationUnit>, table: SymbolTable,) -> (TypeTable,):
    var world = TypeWorld()
    world.units = sortedUnits(units)
    world.table = table
    var stage = TypePass()
    var i = 0
    while i < len(world.units):
        stage = resolveUnit(stage = stage, world = world, unitIndex = i)
        i = i + 1
    stage = checkTypeCycles(stage)
    var out = TypeTable()
    out.pool = stage.pool
    out.bindings = stage.bindings
    out.members = stage.members
    out.unitStart = unitStarts(bindings = stage.bindings, unitCount = len(world.units))
    return out

; 字段环：先判直接自引用，再沿值语义链走一遍间接环；对象与堆容器到此为止。
checkTypeCycles|func(_stage: TypePass,) -> (TypePass,):
    var out = _stage
    var i = 0
    while i < len(out.members):
        let member = out.members[i]
        if isStructDeclCode(member.form) || isEnumDeclCode(member.form):
            out = checkDirectCycle(stage = out, member = member)
        i = i + 1
    if !out.pool.isOK():
        return out
    var state: Array<I32> = []
    var n = 0
    while n < out.pool.count():
        state = state.append(0)
        n = n + 1
    var j = 0
    while j < len(out.members):
        let member = out.members[j]
        if isStructDeclCode(member.form) || isEnumDeclCode(member.form):
            var k = 0
            while k < len(member.types):
                let walked = walkAggregate(pool = out.pool, members = out.members, id = member.types[k], state = state)
                state = walked.state
                if walked.cycle:
                    out.pool = addTypeError(pool = out.pool, error = makeTypeError(kind = .typeErrorRecursiveCycle, file = member.file, offset = member.offset, name = member.owner))
                    k = len(member.types)
                k = k + 1
        j = j + 1
    return out

; 直接自引用：成员类型经元组、可选与结果展开后立即回到所有者。
checkDirectCycle|func(stage: TypePass, member: TypeMember,) -> (TypePass,):
    var out = stage
    var i = 0
    while i < len(member.types):
        if unfoldsToOrigin(pool = out.pool, id = member.types[i], originKey = member.ownerKey):
            out.pool = addTypeError(pool = out.pool, error = makeTypeError(kind = .typeErrorSelfReference, file = member.file, offset = member.offset, name = member.owner))
            return out
        i = i + 1
    return out

; 值语义展开：只有元组、可选与结果把大小传给分量；集合、指针与对象在此终止。
unfoldsToOrigin|func(pool: TypePool, id: I32, originKey: Array<U8>,) -> (Bool,):
    if id < 0 || id >= len(pool.entries):
        return false
    let entry = pool.entries[id]
    if isTypeClass(kind = entry.kind, expected = .typeClassStruct) || isTypeClass(kind = entry.kind, expected = .typeClassEnum):
        return sameKey(first = entry.key, second = originKey)
    if isTypeClass(kind = entry.kind, expected = .typeClassTuple) || isTypeClass(kind = entry.kind, expected = .typeClassOptional) || isTypeClass(kind = entry.kind, expected = .typeClassResult):
        var i = 0
        while i < len(entry.kids):
            if unfoldsToOrigin(pool = pool, id = entry.kids[i], originKey = originKey):
                return true
            i = i + 1
    return false

; 环遍历：灰节点被再次走到即成环；集合、指针、对象与函数不传大小，直接标黑。
walkAggregate|func(pool: TypePool, members: Array<TypeMember>, id: I32, state: Array<I32>,) -> (TypeWalk,):
    var out = TypeWalk()
    out.state = state
    if id < 0 || id >= len(pool.entries) || id >= len(state):
        return out
    if state[id] == 1:
        out.cycle = true
        return out
    if state[id] == 2:
        return out
    let entry = pool.entries[id]
    if isTypeClass(kind = entry.kind, expected = .typeClassScalar) || isTypeClass(kind = entry.kind, expected = .typeClassPointer):
        out.state[id] = 2
        return out
    if isTypeClass(kind = entry.kind, expected = .typeClassOpaque):
        out.state[id] = 2
        return out
    if isTypeClass(kind = entry.kind, expected = .typeClassObject) || isTypeClass(kind = entry.kind, expected = .typeClassCollection):
        out.state[id] = 2
        return out
    if isTypeClass(kind = entry.kind, expected = .typeClassFunction) || isTypeClass(kind = entry.kind, expected = .typeClassGeneric):
        out.state[id] = 2
        return out
    out.state[id] = 1
    if isTypeClass(kind = entry.kind, expected = .typeClassStruct) || isTypeClass(kind = entry.kind, expected = .typeClassEnum):
        let at = memberIndexOf(members = members, key = entry.key)
        if at >= 0:
            var i = 0
            while i < len(members[at].types):
                let walked = walkAggregate(pool = pool, members = members, id = members[at].types[i], state = out.state)
                out.state = walked.state
                if walked.cycle:
                    out.cycle = true
                i = i + 1
    else:
        var i = 0
        while i < len(entry.kids):
            let walked = walkAggregate(pool = pool, members = members, id = entry.kids[i], state = out.state)
            out.state = walked.state
            if walked.cycle:
                out.cycle = true
            i = i + 1
    out.state[id] = 2
    return out

; 成员表按所有者键找：找不到答 -1，说明该名义类型没有记录在案的存储成员。
memberIndexOf|func(members: Array<TypeMember>, key: Array<U8>,) -> (I32,):
    var i = 0
    while i < len(members):
        if sameKey(first = members[i].ownerKey, second = key):
            return i
        i = i + 1
    return -1
