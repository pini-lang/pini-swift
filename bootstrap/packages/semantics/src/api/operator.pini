; 运算判定：一元与二元按符号分派，给出结果类型或错误；类型错误报 E4-004。
; 数值只在同族内提升，跨族（整型与浮点、有符号与无符号）一律拒绝，要换类型只能显式转换。
; 逻辑两侧必须是布尔，规范明定这类错报 E4-001；加法兼做文本拼接，其余算术只认数值。

; 运算错误：操作数类型不合与逻辑操作数非布尔两类。
[OpErrorKind]
opOperandType
opLogicalOperand

; 运算错误：类别、位置、运算符与期望/实得文本。
(OpError)
kind: OpErrorKind = .opOperandType
file: String = ""
offset: I32 = 0
op: String = ""
expected: String = ""
got: String = ""

; 运算结果：池、结果类型、错误与待定标记。
(OpResult)
pool: TypePool = TypePool()
typeId: I32 = -1
error: OpError = OpError()
failed: Bool = false
deferred: Bool = false

; 错误类别名：测试、诊断与回执共用一份拼写。
opErrorName|func(_kind: OpErrorKind,) -> (String,):
    match kind:
        case opOperandType:
            return "操作数类型不合"
        case opLogicalOperand:
            return "逻辑操作数不是布尔"
    return "运算错误"

; 同一错误类别判定：枚举相等比较不可用，按名称比。
isOpError|func(error: OpError, kind: OpErrorKind,) -> (Bool,):
    return opErrorName(error.kind) == opErrorName(kind)

; 诊断码：操作数类型不合取 E4-004，逻辑操作数非布尔取 E4-001。
opErrorCode|func(_kind: OpErrorKind,) -> (String,):
    match kind:
        case opOperandType:
            return "E4-004"
        case opLogicalOperand:
            return "E4-001"
    return "E4-004"

; 造错误：位置与运算符由调用方给，期望与实得是类型文本。
makeOpError|func(kind: OpErrorKind, file: String, offset: I32, op: String, expected: String, got: String,) -> (OpError,):
    var out = OpError()
    out.kind = kind
    out.file = file
    out.offset = offset
    out.op = op
    out.expected = expected
    out.got = got
    return out

; 失败收尾：写错误标记与错误记录。
failOp|func(out: OpResult, file: String, offset: I32, op: String, kind: OpErrorKind, expected: String, got: String,) -> (OpResult,):
    var done = out
    done.failed = true
    done.typeId = errorTypeId()
    done.error = makeOpError(kind = kind, file = file, offset = offset, op = op, expected = expected, got = got)
    return done

; 待定收尾：操作数尚未定型，不报错也不写错误标记。
deferOp|func(_out: OpResult,) -> (OpResult,):
    var done = out
    done.deferred = true
    done.typeId = unsetTypeId()
    return done

; 布尔类型：比较与逻辑的结果统一从这里取。
boolType|func(_pool: TypePool,) -> (TypeInsert,):
    return intern(pool = pool, kind = typeClassScalar, name = "Bool", kids = [], ret = -1)

; 判据包装：结果直接写成功类型，调用方只关心失败分支。
acceptType|func(out: OpResult, typeId: I32,) -> (OpResult,):
    var done = out
    done.typeId = typeId
    return done

; 一元分派：数值、布尔、整数、取址与结果解包各一条。
checkUnary|func(pool: TypePool, op: String, operand: I32, file: String, offset: I32,) -> (OpResult,):
    var out = OpResult()
    out.pool = pool
    if operand < 0 || operand >= len(out.pool.entries):
        return deferOp(out)
    if op == "-" || op == "+" || op == "++" || op == "--":
        if isNumericType(pool = out.pool, id = operand):
            return acceptType(out = out, typeId = operand)
        return failOp(out = out, file = file, offset = offset, op = op, kind = opOperandType, expected = "数值", got = typeText(pool = out.pool, id = operand))
    if op == "!":
        if isBoolType(pool = out.pool, id = operand):
            return acceptType(out = out, typeId = operand)
        return failOp(out = out, file = file, offset = offset, op = op, kind = opOperandType, expected = "布尔", got = typeText(pool = out.pool, id = operand))
    if op == "~":
        if isIntegerType(pool = out.pool, id = operand):
            return acceptType(out = out, typeId = operand)
        return failOp(out = out, file = file, offset = offset, op = op, kind = opOperandType, expected = "整数", got = typeText(pool = out.pool, id = operand))
    if op == "&":
        var kids: Array<I32> = []
        kids = kids.append(operand)
        let pointer = intern(pool = out.pool, kind = typeClassPointer, name = "", kids = kids, ret = -1)
        var done = out
        done.pool = pointer.pool
        done.typeId = pointer.id
        return done
    if op == "^":
        let entry = out.pool.entries[operand]
        if isTypeClass(kind = entry.kind, expected = typeClassResult) && len(entry.kids) > 0:
            return acceptType(out = out, typeId = entry.kids[0])
        return failOp(out = out, file = file, offset = offset, op = op, kind = opOperandType, expected = "结果", got = typeText(pool = out.pool, id = operand))
    return deferOp(out)

; 二元分派：先按符号归类，再交给各自的判据。
checkBinary|func(pool: TypePool, op: String, left: I32, right: I32, file: String, offset: I32,) -> (OpResult,):
    var out = OpResult()
    out.pool = pool
    if left < 0 || left >= len(out.pool.entries):
        return deferOp(out)
    if right < 0 || right >= len(out.pool.entries):
        return deferOp(out)
    if op == "&&" || op == "||":
        return checkLogical(out = out, op = op, left = left, right = right, file = file, offset = offset)
    if op == "+":
        return checkPlus(out = out, op = op, left = left, right = right, file = file, offset = offset)
    if op == "-" || op == "*" || op == "/" || op == "%":
        return checkArithmetic(out = out, op = op, left = left, right = right, file = file, offset = offset)
    if op == "==" || op == "!=":
        return checkEquality(out = out, op = op, left = left, right = right, file = file, offset = offset)
    if op == "<" || op == "<=" || op == ">" || op == ">=":
        return checkOrdering(out = out, op = op, left = left, right = right, file = file, offset = offset)
    if op == "&" || op == "|" || op == "^":
        return checkBitwise(out = out, op = op, left = left, right = right, file = file, offset = offset)
    if op == "<<" || op == ">>":
        return checkShift(out = out, op = op, left = left, right = right, file = file, offset = offset)
    return deferOp(out)

; 逻辑：两侧都必须是布尔，结果布尔。
checkLogical|func(out: OpResult, op: String, left: I32, right: I32, file: String, offset: I32,) -> (OpResult,):
    if !isBoolType(pool = out.pool, id = left):
        return failOp(out = out, file = file, offset = offset, op = op, kind = opLogicalOperand, expected = "Bool", got = typeText(pool = out.pool, id = left))
    if !isBoolType(pool = out.pool, id = right):
        return failOp(out = out, file = file, offset = offset, op = op, kind = opLogicalOperand, expected = "Bool", got = typeText(pool = out.pool, id = right))
    let made = boolType(out.pool)
    var done = out
    done.pool = made.pool
    done.typeId = made.id
    return done

; 加法：数值按同族提升，文本按字符到串加宽，两类都不成立才报错。
checkPlus|func(out: OpResult, op: String, left: I32, right: I32, file: String, offset: I32,) -> (OpResult,):
    if isNumericType(pool = out.pool, id = left) && isNumericType(pool = out.pool, id = right):
        let promoted = promoteNumeric(pool = out.pool, left = left, right = right)
        if promoted >= 0:
            return acceptType(out = out, typeId = promoted)
        return failOp(out = out, file = file, offset = offset, op = op, kind = opOperandType, expected = "同族数值", got = typeText(pool = out.pool, id = left) + " 与 " + typeText(pool = out.pool, id = right))
    if isTextType(pool = out.pool, id = left) && isTextType(pool = out.pool, id = right):
        let text = intern(pool = out.pool, kind = typeClassScalar, name = "String", kids = [], ret = -1)
        var done = out
        done.pool = text.pool
        done.typeId = text.id
        return done
    return failOp(out = out, file = file, offset = offset, op = op, kind = opOperandType, expected = "数值或文本", got = typeText(pool = out.pool, id = left) + " 与 " + typeText(pool = out.pool, id = right))

; 算术：减乘除余只认数值，同族才提升。
checkArithmetic|func(out: OpResult, op: String, left: I32, right: I32, file: String, offset: I32,) -> (OpResult,):
    if !isNumericType(pool = out.pool, id = left) || !isNumericType(pool = out.pool, id = right):
        return failOp(out = out, file = file, offset = offset, op = op, kind = opOperandType, expected = "数值", got = typeText(pool = out.pool, id = left) + " 与 " + typeText(pool = out.pool, id = right))
    let promoted = promoteNumeric(pool = out.pool, left = left, right = right)
    if promoted < 0:
        return failOp(out = out, file = file, offset = offset, op = op, kind = opOperandType, expected = "同族数值", got = typeText(pool = out.pool, id = left) + " 与 " + typeText(pool = out.pool, id = right))
    return acceptType(out = out, typeId = promoted)

; 相等：同类型、同族数值与文本三路可比，其余拒绝。
checkEquality|func(out: OpResult, op: String, left: I32, right: I32, file: String, offset: I32,) -> (OpResult,):
    var ok = sameType(pool = out.pool, first = left, second = right)
    if !ok && isNumericType(pool = out.pool, id = left) && isNumericType(pool = out.pool, id = right):
        ok = promoteNumeric(pool = out.pool, left = left, right = right) >= 0
    if !ok && isTextType(pool = out.pool, id = left) && isTextType(pool = out.pool, id = right):
        ok = true
    if !ok:
        return failOp(out = out, file = file, offset = offset, op = op, kind = opOperandType, expected = "同类型或同族数值", got = typeText(pool = out.pool, id = left) + " 与 " + typeText(pool = out.pool, id = right))
    let made = boolType(out.pool)
    var done = out
    done.pool = made.pool
    done.typeId = made.id
    return done

; 大小比较：同族数值、两串与两字符可比，结果布尔。
checkOrdering|func(out: OpResult, op: String, left: I32, right: I32, file: String, offset: I32,) -> (OpResult,):
    var ok = false
    if isNumericType(pool = out.pool, id = left) && isNumericType(pool = out.pool, id = right):
        ok = promoteNumeric(pool = out.pool, left = left, right = right) >= 0
    if !ok && isStringType(pool = out.pool, id = left) && isStringType(pool = out.pool, id = right):
        ok = true
    if !ok && isCharType(pool = out.pool, id = left) && isCharType(pool = out.pool, id = right):
        ok = true
    if !ok:
        return failOp(out = out, file = file, offset = offset, op = op, kind = opOperandType, expected = "同族数值、两串或两字符", got = typeText(pool = out.pool, id = left) + " 与 " + typeText(pool = out.pool, id = right))
    let made = boolType(out.pool)
    var done = out
    done.pool = made.pool
    done.typeId = made.id
    return done

; 位运算：两侧同族整数才成立，结果取提升后的整型。
checkBitwise|func(out: OpResult, op: String, left: I32, right: I32, file: String, offset: I32,) -> (OpResult,):
    if !isIntegerType(pool = out.pool, id = left) || !isIntegerType(pool = out.pool, id = right):
        return failOp(out = out, file = file, offset = offset, op = op, kind = opOperandType, expected = "整数", got = typeText(pool = out.pool, id = left) + " 与 " + typeText(pool = out.pool, id = right))
    let promoted = promoteNumeric(pool = out.pool, left = left, right = right)
    if promoted < 0:
        return failOp(out = out, file = file, offset = offset, op = op, kind = opOperandType, expected = "同族整数", got = typeText(pool = out.pool, id = left) + " 与 " + typeText(pool = out.pool, id = right))
    return acceptType(out = out, typeId = promoted)

; 移位：左操作数定结果类型，计数只需是整数，族别不要求一致。
checkShift|func(out: OpResult, op: String, left: I32, right: I32, file: String, offset: I32,) -> (OpResult,):
    if !isIntegerType(pool = out.pool, id = left):
        return failOp(out = out, file = file, offset = offset, op = op, kind = opOperandType, expected = "整数", got = typeText(pool = out.pool, id = left))
    if !isIntegerType(pool = out.pool, id = right):
        return failOp(out = out, file = file, offset = offset, op = op, kind = opOperandType, expected = "整数", got = typeText(pool = out.pool, id = right))
    return acceptType(out = out, typeId = left)
