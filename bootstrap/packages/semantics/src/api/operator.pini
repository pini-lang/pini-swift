; 运算判定：一元与二元按符号分派，给出结果类型或错误；类型错误报 E4-004。
; 数值只在同族内提升，跨族（整型与浮点、有符号与无符号）一律拒绝，要换类型只能显式转换。
; 逻辑两侧必须是布尔，规范明定这类错报 E4-001；加法兼做文本拼接，其余算术只认数值。

; 运算错误：操作数类型不合与逻辑操作数非布尔两类。
[OpErrorKind]
opOperandType
opLogicalOperand

; 运算错误：类别、位置、运算符与期望/实得文本。
(OpError)
kind: OpErrorKind = .opOperandType
file: String = ""
offset: I32 = 0
op: String = ""
expected: String = ""
got: String = ""

; 运算结果：池、结果类型、错误与待定标记。
(OpResult)
pool: TypePool = TypePool()
typeId: I32 = -1
error: OpError = OpError()
failed: Bool = false
deferred: Bool = false

; 错误类别名：测试、诊断与回执共用一份拼写。
opErrorName|func(kind: OpErrorKind,) -> (String,):
    match kind:
        case opOperandType:
            return "操作数类型不合"
        case opLogicalOperand:
            return "逻辑操作数不是布尔"
    return "运算错误"

; 同一错误类别判定：枚举相等比较不可用，按名称比。
isOpError|func(error: OpError, kind: OpErrorKind,) -> (Bool,):
    return opErrorName(error.kind) == opErrorName(kind)

; 诊断码：操作数类型不合取 E4-004，逻辑操作数非布尔取 E4-001。
opErrorCode|func(kind: OpErrorKind,) -> (String,):
    match kind:
        case opOperandType:
            return "E4-004"
        case opLogicalOperand:
            return "E4-001"
    return "E4-004"

; 造错误：位置与运算符由调用方给，期望与实得是类型文本。
makeOpError|func(kind: OpErrorKind, file: String, offset: I32, op: String, expected: String, got: String,) -> (OpError,):
    var out = OpError()
    out.kind = kind
    out.file = file
    out.offset = offset
    out.op = op
    out.expected = expected
    out.got = got
    return out

; 失败收尾：写错误标记与错误记录。
failOp|func(out: OpResult, file: String, offset: I32, op: String, kind: OpErrorKind, expected: String, got: String,) -> (OpResult,):
    var done = out
    done.failed = true
    done.typeId = errorTypeId()
    done.error = makeOpError(kind, file, offset, op, expected, got)
    return done

; 待定收尾：操作数尚未定型，不报错也不写错误标记。
deferOp|func(out: OpResult,) -> (OpResult,):
    var done = out
    done.deferred = true
    done.typeId = unsetTypeId()
    return done

; 布尔类型：比较与逻辑的结果统一从这里取。
boolType|func(pool: TypePool,) -> (TypeInsert,):
    return intern(pool, typeClassScalar, "Bool", [], -1)

; 判据包装：结果直接写成功类型，调用方只关心失败分支。
acceptType|func(out: OpResult, typeId: I32,) -> (OpResult,):
    var done = out
    done.typeId = typeId
    return done

; 一元分派：数值、布尔、整数、取址与结果解包各一条。
checkUnary|func(pool: TypePool, op: String, operand: I32, file: String, offset: I32,) -> (OpResult,):
    var out = OpResult()
    out.pool = pool
    if operand < 0 || operand >= len(out.pool.entries):
        return deferOp(out)
    if op == "-" || op == "+" || op == "++" || op == "--":
        if isNumericType(out.pool, operand):
            return acceptType(out, operand)
        return failOp(out, file, offset, op, opOperandType, "数值", typeText(out.pool, operand))
    if op == "!":
        if isBoolType(out.pool, operand):
            return acceptType(out, operand)
        return failOp(out, file, offset, op, opOperandType, "布尔", typeText(out.pool, operand))
    if op == "~":
        if isIntegerType(out.pool, operand):
            return acceptType(out, operand)
        return failOp(out, file, offset, op, opOperandType, "整数", typeText(out.pool, operand))
    if op == "&":
        var kids: Array<I32> = []
        kids = kids.append(operand)
        let pointer = intern(out.pool, typeClassPointer, "", kids, -1)
        var done = out
        done.pool = pointer.pool
        done.typeId = pointer.id
        return done
    if op == "^":
        let entry = out.pool.entries[operand]
        if isTypeClass(entry.kind, typeClassResult) && len(entry.kids) > 0:
            return acceptType(out, entry.kids[0])
        return failOp(out, file, offset, op, opOperandType, "结果", typeText(out.pool, operand))
    return deferOp(out)

; 二元分派：先按符号归类，再交给各自的判据。
checkBinary|func(pool: TypePool, op: String, left: I32, right: I32, file: String, offset: I32,) -> (OpResult,):
    var out = OpResult()
    out.pool = pool
    if left < 0 || left >= len(out.pool.entries):
        return deferOp(out)
    if right < 0 || right >= len(out.pool.entries):
        return deferOp(out)
    if op == "&&" || op == "||":
        return checkLogical(out, op, left, right, file, offset)
    if op == "+":
        return checkPlus(out, op, left, right, file, offset)
    if op == "-" || op == "*" || op == "/" || op == "%":
        return checkArithmetic(out, op, left, right, file, offset)
    if op == "==" || op == "!=":
        return checkEquality(out, op, left, right, file, offset)
    if op == "<" || op == "<=" || op == ">" || op == ">=":
        return checkOrdering(out, op, left, right, file, offset)
    if op == "&" || op == "|" || op == "^":
        return checkBitwise(out, op, left, right, file, offset)
    if op == "<<" || op == ">>":
        return checkShift(out, op, left, right, file, offset)
    return deferOp(out)

; 逻辑：两侧都必须是布尔，结果布尔。
checkLogical|func(out: OpResult, op: String, left: I32, right: I32, file: String, offset: I32,) -> (OpResult,):
    if !isBoolType(out.pool, left):
        return failOp(out, file, offset, op, opLogicalOperand, "Bool", typeText(out.pool, left))
    if !isBoolType(out.pool, right):
        return failOp(out, file, offset, op, opLogicalOperand, "Bool", typeText(out.pool, right))
    let made = boolType(out.pool)
    var done = out
    done.pool = made.pool
    done.typeId = made.id
    return done

; 加法：数值按同族提升，文本按字符到串加宽，两类都不成立才报错。
checkPlus|func(out: OpResult, op: String, left: I32, right: I32, file: String, offset: I32,) -> (OpResult,):
    if isNumericType(out.pool, left) && isNumericType(out.pool, right):
        let promoted = promoteNumeric(out.pool, left, right)
        if promoted >= 0:
            return acceptType(out, promoted)
        return failOp(out, file, offset, op, opOperandType, "同族数值", typeText(out.pool, left) + " 与 " + typeText(out.pool, right))
    if isTextType(out.pool, left) && isTextType(out.pool, right):
        let text = intern(out.pool, typeClassScalar, "String", [], -1)
        var done = out
        done.pool = text.pool
        done.typeId = text.id
        return done
    return failOp(out, file, offset, op, opOperandType, "数值或文本", typeText(out.pool, left) + " 与 " + typeText(out.pool, right))

; 算术：减乘除余只认数值，同族才提升。
checkArithmetic|func(out: OpResult, op: String, left: I32, right: I32, file: String, offset: I32,) -> (OpResult,):
    if !isNumericType(out.pool, left) || !isNumericType(out.pool, right):
        return failOp(out, file, offset, op, opOperandType, "数值", typeText(out.pool, left) + " 与 " + typeText(out.pool, right))
    let promoted = promoteNumeric(out.pool, left, right)
    if promoted < 0:
        return failOp(out, file, offset, op, opOperandType, "同族数值", typeText(out.pool, left) + " 与 " + typeText(out.pool, right))
    return acceptType(out, promoted)

; 相等：同类型、同族数值与文本三路可比，其余拒绝。
checkEquality|func(out: OpResult, op: String, left: I32, right: I32, file: String, offset: I32,) -> (OpResult,):
    var ok = sameType(out.pool, left, right)
    if !ok && isNumericType(out.pool, left) && isNumericType(out.pool, right):
        ok = promoteNumeric(out.pool, left, right) >= 0
    if !ok && isTextType(out.pool, left) && isTextType(out.pool, right):
        ok = true
    if !ok:
        return failOp(out, file, offset, op, opOperandType, "同类型或同族数值", typeText(out.pool, left) + " 与 " + typeText(out.pool, right))
    let made = boolType(out.pool)
    var done = out
    done.pool = made.pool
    done.typeId = made.id
    return done

; 大小比较：同族数值、两串与两字符可比，结果布尔。
checkOrdering|func(out: OpResult, op: String, left: I32, right: I32, file: String, offset: I32,) -> (OpResult,):
    var ok = false
    if isNumericType(out.pool, left) && isNumericType(out.pool, right):
        ok = promoteNumeric(out.pool, left, right) >= 0
    if !ok && isStringType(out.pool, left) && isStringType(out.pool, right):
        ok = true
    if !ok && isCharType(out.pool, left) && isCharType(out.pool, right):
        ok = true
    if !ok:
        return failOp(out, file, offset, op, opOperandType, "同族数值、两串或两字符", typeText(out.pool, left) + " 与 " + typeText(out.pool, right))
    let made = boolType(out.pool)
    var done = out
    done.pool = made.pool
    done.typeId = made.id
    return done

; 位运算：两侧同族整数才成立，结果取提升后的整型。
checkBitwise|func(out: OpResult, op: String, left: I32, right: I32, file: String, offset: I32,) -> (OpResult,):
    if !isIntegerType(out.pool, left) || !isIntegerType(out.pool, right):
        return failOp(out, file, offset, op, opOperandType, "整数", typeText(out.pool, left) + " 与 " + typeText(out.pool, right))
    let promoted = promoteNumeric(out.pool, left, right)
    if promoted < 0:
        return failOp(out, file, offset, op, opOperandType, "同族整数", typeText(out.pool, left) + " 与 " + typeText(out.pool, right))
    return acceptType(out, promoted)

; 移位：左操作数定结果类型，计数只需是整数，族别不要求一致。
checkShift|func(out: OpResult, op: String, left: I32, right: I32, file: String, offset: I32,) -> (OpResult,):
    if !isIntegerType(out.pool, left):
        return failOp(out, file, offset, op, opOperandType, "整数", typeText(out.pool, left))
    if !isIntegerType(out.pool, right):
        return failOp(out, file, offset, op, opOperandType, "整数", typeText(out.pool, right))
    return acceptType(out, left)
