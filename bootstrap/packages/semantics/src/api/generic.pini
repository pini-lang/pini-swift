[generic|import]
_syntax = "../../../syntax"
_module_loader = "../../../module-loader"

; 泛型实例：模板声明加一组具体类型实参，带实例符号、实例世界与实例体类型表。
; 实例世界由模板世界换掉类型表与形参绑定得到；IR 降载实例体时读同一份。
(GenericInstance)
name: String = ""
key: String = ""
unit: I32 = -1
decl: I32 = -1
argTexts: Array<String> = []
returnType: I32 = -1
paramTypes: Array<I32> = []
overrides: Array<TypeBinding> = []
world: MemberWorld = MemberWorld()
types: ExprTypes = ExprTypes()

; 调用点：源单元与调用表达式节点对上实例下标；IR 按这条表发射实例调用。
(GenericCall)
unit: I32 = -1
node: I32 = -1
instance: I32 = -1

; 实例化结果：实例表、调用点表、增长后的池与写回调用点类型的表。
(GenericFill)
instances: Array<GenericInstance> = []
calls: Array<GenericCall> = []
pool: TypePool = TypePool()
types: ExprTypes = ExprTypes()

; 去重键查实例：同模板同实参只建一个；未命中答 -1。
findInstanceIndex|func(instances: Array<GenericInstance>, key: String,) -> (I32,):
    var i = 0
    while i < len(instances):
        if instances[i].key == key:
            return i
        i = i + 1
    return -1

; 调用点查实例：未命中答 -1；IR 逐调用点走这张表，命中即发实例调用。
findGenericCall|func(calls: Array<GenericCall>, unit: I32, node: I32,) -> (I32,):
    var i = 0
    while i < len(calls):
        if calls[i].unit == unit && calls[i].node == node:
            return calls[i].instance
        i = i + 1
    return -1

; 实参文本拼键：竖线分隔，顺序即形参序。
joinArgTexts|func(parts: Array<String>,) -> (String,):
    var out = ""
    var i = 0
    while i < len(parts):
        if i > 0:
            out = out + "|"
        out = out + parts[i]
        i = i + 1
    return out

; 符号安全拼写：只留 ASCII 字母数字，其余换成下划线；类型文本因此能进函数名。
safeSpelling|func(_text: String,) -> (String,):
    let bytes = tempUtf8Bytes(_text)
    var out: Array<U8> = []
    var i = 0
    while i < len(bytes):
        let value = tempByteToInt(bytes[i])
        let alpha = value >= 65 && value <= 90 || value >= 97 && value <= 122
        let digit = value >= 48 && value <= 57
        if alpha || digit:
            out = out.append(bytes[i])
        else:
            out = out.append(tempIntToByte(95))
        i = i + 1
    return decodeRange(bytes = out, start = 0, end = len(out))

; 实例名占用：同名实例已存在时答真，调用方据此补下划线。
nameTaken|func(instances: Array<GenericInstance>, name: String,) -> (Bool,):
    var i = 0
    while i < len(instances):
        if instances[i].name == name:
            return true
        i = i + 1
    return false

; 实例符号：函数名加实参文本的安全拼写；同名已被占用时补下划线直到唯一。
instanceSymbol|func(instances: Array<GenericInstance>, functionName: String, argTexts: Array<String>,) -> (String,):
    var base = functionName + "__"
    var i = 0
    while i < len(argTexts):
        if i > 0:
            base = base + "_"
        base = base + safeSpelling(argTexts[i])
        i = i + 1
    var name = base
    while nameTaken(instances = instances, name = name):
        name = name + "_"
    return name

; 类型世界：实例化只换形参绑定，单元与符号表沿用工作区。
typeWorldOf|func(world: MemberWorld,) -> (TypeWorld,):
    var out = TypeWorld()
    out.units = world.units
    out.table = world.table
    return out

; 实例类型表：只给目标单元铺槽，其余单元留空；读别的单元一律未写。
; 模板体只在本单元，实例表因此不必复制整份工作区表。
makeInstanceExprTypes|func(units: Array<CompilationUnit>, only: I32,) -> (ExprTypes,):
    var out = ExprTypes()
    var u = 0
    while u < len(units):
        var table = UnitExprTypes()
        if u == only:
            var i = 0
            let count = units[u].ast.exprCount()
            while i < count:
                table.types = table.types.append(unsetTypeId())
                i = i + 1
        out.units = out.units.append(table)
        u = u + 1
    return out

; 实例世界：逐字段另立一份，类型表也换新对象；不依赖结构体复制的层层隔离。
instanceWorld|func(world: MemberWorld, table: TypeTable, binds: Array<GenericBinding>,) -> (MemberWorld,):
    var out = MemberWorld()
    out.units = world.units
    out.table = world.table
    out.types = table
    out.symbols = world.symbols
    out.decls = world.decls
    out.builtins = world.builtins
    out.functions = world.functions
    out.genericBindings = binds
    return out

; 建实例：解析模板签名得实例绑定，世界换成实例表，再推模板体类型。
; 签名解析绕过解析期的模板跳过；返回类型与参数类型都进 overrides 供播种与降载读。
buildInstance|func(world: MemberWorld, name: String, ref: DeclRef, decl: DeclNode, argIds: Array<I32>, argTexts: Array<String>, key: String, work: GenericFill,) -> (GenericFill,):
    var out = work
    let template = world.units[ref.unit]
    let templateBytes = unitBytes(template)
    var binds: Array<GenericBinding> = []
    var g = 0
    while g < len(decl.generic):
        let param = template.ast.decls[decl.generic[g]]
        var bind = GenericBinding()
        bind.name = decodeRange(bytes = templateBytes, start = param.nameStart, end = param.nameEnd)
        bind.typeId = argIds[g]
        binds = binds.append(bind)
        g = g + 1
    var cursor = TypeCursor()
    var typeWorld = typeWorldOf(world = world)
    typeWorld.genericBindings = binds
    cursor.world = typeWorld
    cursor.file = template.path
    cursor.ast = template.ast
    cursor.bytes = templateBytes
    var stage = TypePass()
    stage.pool = out.pool
    if decl.typeId >= 0:
        stage = resolveOne(stage = stage, cursor = cursor, unitIndex = ref.unit, declId = ref.decl, typeId = decl.typeId)
    stage = resolveSignature(stage = stage, cursor = cursor, unitIndex = ref.unit, decl = decl)
    out.pool = stage.pool
    var table = TypeTable()
    table.pool = stage.pool
    table.bindings = world.types.bindings
    table.members = world.types.members
    table.unitStart = world.types.unitStart
    table.overrides = stage.bindings
    var iw = instanceWorld(world = world, table = table, binds = binds)
    let instTypes = makeInstanceExprTypes(units = world.units, only = ref.unit)
    let inferred = inferUnitExprs(world = iw, unitIndex = ref.unit, types = instTypes)
    out.pool = inferred.pool
    var settled = TypeTable()
    settled.pool = inferred.pool
    settled.bindings = world.types.bindings
    settled.members = world.types.members
    settled.unitStart = world.types.unitStart
    settled.overrides = stage.bindings
    iw = instanceWorld(world = world, table = settled, binds = binds)
    var inst = GenericInstance()
    inst.name = instanceSymbol(instances = out.instances, functionName = name, argTexts = argTexts)
    inst.key = key
    inst.unit = ref.unit
    inst.decl = ref.decl
    inst.argTexts = argTexts
    inst.overrides = stage.bindings
    inst.world = iw
    inst.types = inferred.types
    inst.returnType = iw.types.typeOf(unit = ref.unit, decl = ref.decl)
    var k = 0
    while k < len(decl.kids):
        let kid = template.ast.decls[decl.kids[k]]
        if isParamDeclCode(kid.kind):
            inst.paramTypes = inst.paramTypes.append(iw.types.typeOf(unit = ref.unit, decl = decl.kids[k]))
        k = k + 1
    out.instances = out.instances.append(inst)
    return out

; 调用点绑定：泛型应用节点按名找到泛型函数，解析显式类型实参、建或复用实例，写回结果类型。
; 名字解析不到泛型函数时原样返回，`LazyRef<T>` 构造等形状仍走原路。
bindGenericCall|func(world: MemberWorld, unit: CompilationUnit, unitIndex: I32, callId: I32, work: GenericFill,) -> (GenericFill,):
    var out = work
    let generic = unit.ast.exprAt(callId)
    if generic.typeId < 0 || generic.typeId >= unit.ast.typeCount():
        return out
    let node = unit.ast.typeAt(generic.typeId)
    if !isGenericTypeCode(node.kind):
        return out
    let bytes = unitBytes(unit)
    let name = decodeRange(bytes = bytes, start = node.nameStart, end = node.nameEnd)
    let symbol = lookupTopByName(index = world.symbols, name = name)
    if symbol < 0:
        return out
    let ref = symbolDecl(world = world, symbol = symbol)
    if ref.unit < 0:
        return out
    let decl = world.units[ref.unit].ast.decls[ref.decl]
    if !isFunctionDeclCode(decl.kind) || len(decl.generic) == 0:
        return out
    if len(node.kids) != len(decl.generic):
        return out
    var cursor = TypeCursor()
    cursor.world = typeWorldOf(world = world)
    cursor.file = unit.path
    cursor.ast = unit.ast
    cursor.bytes = bytes
    var argIds: Array<I32> = []
    var argTexts: Array<String> = []
    var k = 0
    while k < len(node.kids):
        let resolved = resolveAnnotationIn(cursor = cursor, pool = out.pool, node = node.kids[k])
        out.pool = resolved.pool
        if resolved.id < 0:
            return out
        argIds = argIds.append(resolved.id)
        argTexts = argTexts.append(typeText(pool = out.pool, id = resolved.id))
        k = k + 1
    let key = unit.path + "#" + name + "#" + joinArgTexts(parts = argTexts)
    var at = findInstanceIndex(instances = out.instances, key = key)
    if at < 0:
        out = buildInstance(world = world, name = name, ref = ref, decl = decl, argIds = argIds, argTexts = argTexts, key = key, work = out)
        at = len(out.instances) - 1
    let inst = out.instances[at]
    var row = GenericCall()
    row.unit = unitIndex
    row.node = callId
    row.instance = at
    out.calls = out.calls.append(row)
    out.types = writeExprType(table = out.types, unit = unitIndex, node = callId, typeId = inst.returnType)
    return out

; 单单元扫描：泛型应用节点逐个尝试绑实例；非泛型段与类型构造由名字判定挡回。
scanGenericCalls|func(world: MemberWorld, unit: CompilationUnit, unitIndex: I32, work: GenericFill,) -> (GenericFill,):
    var out = work
    var i = 0
    while i < unit.ast.exprCount():
        if unit.ast.isGenericExpr(i):
            out = bindGenericCall(world = world, unit = unit, unitIndex = unitIndex, callId = i, work = out)
        i = i + 1
    return out

; 实例化后重推：调用点由实例补型，同单元下游（如对结果的取下标）此时才拿得到类型。
; 只补未定的节点，已定的不覆盖，故可整单元跑一遍。
repinGenerics|func(world: MemberWorld, work: GenericFill,) -> (GenericFill,):
    var out = work
    var u = 0
    while u < len(world.units):
        let one = inferUnitExprs(world = probeWorld(world = world, pool = out.pool), unitIndex = u, types = out.types)
        out.pool = one.pool
        out.types = one.types
        u = u + 1
    return out

; 实例化入口：扫全工作区调用点，建实例并推实例体类型。
; 实例体内再调用泛型函数不在本批范围内，故不排二次扫描。
instantiateGenerics|func(world: MemberWorld, units: Array<CompilationUnit>, fill: ExprFill,) -> (GenericFill,):
    var out = GenericFill()
    out.types = fill.types
    out.pool = fill.pool
    var u = 0
    while u < len(units):
        out = scanGenericCalls(world = world, unit = units[u], unitIndex = u, work = out)
        u = u + 1
    out = repinGenerics(world = world, work = out)
    return out
