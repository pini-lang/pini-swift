[member|import]
_syntax = "../../../syntax"
_module_loader = "../../../module-loader"

; 成员判定：先算接收者类型，再按类型类别分流到字段、方法、枚举项、元组与内建成员。
; 世界把单元、符号表、类型表与两张索引装在一起，建一次可查多次；池在建世界时补齐名义类型。

; 成员类别：字段、自身方法、本型方法、枚举项、元组序号、元组标签与内建成员各一类。
[MemberKind]
memberField
memberMethod
memberOwnMethod
memberEnumCase
memberTupleIndex
memberTupleLabel
memberBuiltin

; 成员错误：未知成员、私有字段与文件内成员跨文件三类。
[MemberErrorKind]
memberUnknown
memberPrivate
memberInaccessible

; 成员访问：接收者类型下标、成员键与原文、是否类型名位、访问点所在类型与文件。
(MemberAccess)
receiver: I32 = -1
key: Array<U8> = []
spelling: String = ""
isTypeName: Bool = false
owner: String = ""
file: String = ""
offset: I32 = 0

; 成员错误：类别、位置、类型名与成员名；诊断渲染只需这四项。
(MemberError)
kind: MemberErrorKind = .memberUnknown
file: String = ""
offset: I32 = 0
typeName: String = ""
memberName: String = ""

; 成员结果：池、成员类型、符号下标、类别与错误；待定表示接收者尚未定型。
(MemberResult)
pool: TypePool = TypePool()
typeId: I32 = -1
symbol: I32 = -1
kind: MemberKind = .memberField
error: MemberError = MemberError()
failed: Bool = false
deferred: Bool = false

; 组合表：结构体名与其嵌入父类型名；没有嵌入的结构不入表，判定只查这张表。
(TypeComposition)
name: String = ""
parents: Array<String> = []

; 成员世界：单元、符号表、类型表、两张索引、内建与函数表、组合表；池内含全部名义类型。
(MemberWorld)
units: Array<CompilationUnit> = []
table: SymbolTable = SymbolTable()
types: TypeTable = TypeTable()
symbols: SymbolIndex = SymbolIndex()
decls: DeclIndex = DeclIndex()
builtins: Array<BuiltinMember> = []
functions: Array<BuiltinFunction> = []
genericBindings: Array<GenericBinding> = []
compositions: Array<TypeComposition> = []

; 成员类别名：诊断、测试与回执共用一份拼写。
memberKindName|func(_kind: MemberKind,) -> (String,):
    match _kind:
        case memberField:
            return "字段"
        case memberMethod:
            return "方法"
        case memberOwnMethod:
            return "本型方法"
        case memberEnumCase:
            return "枚举项"
        case memberTupleIndex:
            return "元组序号"
        case memberTupleLabel:
            return "元组标签"
        case memberBuiltin:
            return "内建成员"
    return "成员"

; 同一类别判定：枚举相等比较不可用，按名称比。
isMemberKind|func(kind: MemberKind, expected: MemberKind,) -> (Bool,):
    return memberKindName(kind) == memberKindName(expected)

; 错误类别名：与诊断码一一对应。
memberErrorName|func(_kind: MemberErrorKind,) -> (String,):
    match _kind:
        case memberUnknown:
            return "未知成员"
        case memberPrivate:
            return "私有字段"
        case memberInaccessible:
            return "成员不可见"
    return "成员错误"

; 同一错误类别判定：与 isMemberKind 同规。
isMemberError|func(error: MemberError, kind: MemberErrorKind,) -> (Bool,):
    return memberErrorName(error.kind) == memberErrorName(kind)

; 诊断码：复用宿主已登记的码，不新增码表条目。
memberErrorCode|func(_kind: MemberErrorKind,) -> (String,):
    match _kind:
        case memberUnknown:
            return "E4-009"
        case memberPrivate:
            return "E4-012"
        case memberInaccessible:
            return "E4-011"
    return "E4-009"

; 造错误：位置取访问点起点，类型名与成员名由调用方给。
makeMemberError|func(kind: MemberErrorKind, file: String, offset: I32, typeName: String, memberName: String,) -> (MemberError,):
    var out = MemberError()
    out.kind = kind
    out.file = file
    out.offset = offset
    out.typeName = typeName
    out.memberName = memberName
    return out

; 造访问：成员名同时留键与原拼写，键只服务查找。
memberAccess|func(receiver: I32, name: String, isTypeName: Bool, owner: String, file: String, offset: I32,) -> (MemberAccess,):
    var out = MemberAccess()
    out.receiver = receiver
    out.key = keyOfText(name)
    out.spelling = name
    out.isTypeName = isTypeName
    out.owner = owner
    out.file = file
    out.offset = offset
    return out

; 名义类别：结构、对象与枚举三类，其余答无效。
nominalClassOf|func(_code: I32,) -> (TypeClass,):
    if isStructDeclCode(_code) || isGivenDeclCode(_code):
        return .typeClassStruct
    if isObjectDeclCode(_code):
        return .typeClassObject
    if isEnumDeclCode(_code):
        return .typeClassEnum
    return .typeClassInvalid

; 名义判定：三类共用一条，指针、可选与函数都不算。
isNominalClass|func(_kind: TypeClass,) -> (Bool,):
    if isTypeClass(kind = _kind, expected = .typeClassStruct):
        return true
    if isTypeClass(kind = _kind, expected = .typeClassObject):
        return true
    return isTypeClass(kind = _kind, expected = .typeClassEnum)

; 名义类型驻留：顶层类型声明逐个进池，未被引用的类型也有下标可查。
internNominalTypes|func(units: Array<CompilationUnit>, pool: TypePool,) -> (TypePool,):
    var working = pool
    var u = 0
    while u < len(units):
        let unit = units[u]
        let bytes = unitBytes(unit)
        var i = 0
        while i < len(unit.ast.items):
            let decl = unit.ast.decls[unit.ast.items[i]]
            let kind = nominalClassOf(decl.kind)
            if !isTypeClass(kind = kind, expected = .typeClassInvalid):
                let name = decodeRange(bytes = bytes, start = decl.nameStart, end = decl.nameEnd)
                working = intern(pool = working, kind = kind, name = name, kids = [], ret = -1).pool
            i = i + 1
        u = u + 1
    return working

; 建世界：索引与内建表建一次，池补齐全部名义类型；调用方先 sortedUnits，与其他表共用同一序。
makeMemberWorld|func(units: Array<CompilationUnit>, table: SymbolTable, types: TypeTable,) -> (MemberWorld,):
    var out = MemberWorld()
    out.units = units
    out.table = table
    out.types = types
    out.symbols = makeSymbolIndex(table)
    out.decls = makeDeclIndex(units)
    out.builtins = builtinMemberTable()
    out.functions = builtinFunctionTable()
    out.types.pool = internNominalTypes(units = units, pool = types.pool)
    out.compositions = collectCompositions(units = units)
    out = attachTypeParams(world = out)
    return out

; 类型形参绑定：泛型声明的每个形参名驻留成不透明类型，模板体因此有型可解。
; 与签名解析共用同一张收集表：同名形参解析到同一条条目，签名与体不会各认一型。
attachTypeParams|func(world: MemberWorld,) -> (MemberWorld,):
    var out = world
    let params = collectTypeParams(units = out.units, pool = out.types.pool)
    out.types.pool = params.pool
    out.genericBindings = params.bindings
    return out

; 名义类型查找：按名字在池里找结构、对象或枚举；未驻留答 -1。
nominalTypeId|func(world: MemberWorld, name: String,) -> (I32,):
    var i = 0
    while i < len(world.types.pool.entries):
        let entry = world.types.pool.entries[i]
        if isNominalClass(entry.kind) && entry.name == name:
            return i
        i = i + 1
    return -1

; 属主类型：名义类型先查；内建标量与容器按名字兜底，扩展块挂在内建类型上时 `self` 也要有型。
ownerTypeId|func(world: MemberWorld, name: String,) -> (I32,):
    let nominal = nominalTypeId(world = world, name = name)
    if nominal >= 0:
        return nominal
    var i = 0
    while i < len(world.types.pool.entries):
        if world.types.pool.entries[i].name == name:
            return i
        i = i + 1
    return -1

; 标签序号：元组条目名存标签串，逐段按 NFC 键比；未命中答 -1。
tupleLabelIndex|func(entry: TypeEntry, key: Array<U8>,) -> (I32,):
    var i = 0
    while i < len(entry.kids):
        let label = tupleLabelAt(entry = entry, index = i)
        if len(label) > 0 && sameKey(first = keyOfText(label), second = key):
            return i
        i = i + 1
    return -1

; 数字序号：整串十进制数字才成立，否则答 -1；四位以上直接否决，避免回绕。
digitIndex|func(_text: String,) -> (I32,):
    if len(_text) == 0:
        return -1
    var value = 0
    var i = 0
    while i < len(_text):
        let code = ord(_text[i])
        if code < 48 || code > 57:
            return -1
        value = value * 10 + (code - 48)
        if value > 9999:
            return -1
        i = i + 1
    return value

; 失败收尾：写错误标记与错误记录，符号下标保持未命中。
failMember|func(out: MemberResult, access: MemberAccess, kind: MemberErrorKind, typeName: String,) -> (MemberResult,):
    var done = out
    done.failed = true
    done.typeId = errorTypeId()
    done.error = makeMemberError(kind = kind, file = access.file, offset = access.offset, typeName = typeName, memberName = access.spelling)
    return done

; 待定收尾：接收者未定型或成员类型缺项，不报错也不写错误标记。
deferMember|func(out: MemberResult, receiver: I32,) -> (MemberResult,):
    var done = out
    done.deferred = true
    if receiver == errorTypeId():
        done.typeId = errorTypeId()
    else:
        done.typeId = unsetTypeId()
    return done

; 成员类型：形参逐个回表，返回类型单列；任一缺项答 -1 交给待定收尾。
methodType|func(world: MemberWorld, ref: DeclRef,) -> (TypeInsert,):
    let unit = world.units[ref.unit]
    let decl = unit.ast.decls[ref.decl]
    var params: Array<I32> = []
    var i = 0
    while i < len(decl.kids):
        let kid = decl.kids[i]
        if isParamDeclCode(unit.ast.decls[kid].kind):
            let paramType = world.types.typeOf(unit = ref.unit, decl = kid)
            if paramType < 0:
                return hitType(pool = world.types.pool, id = -1)
            params = params.append(paramType)
        i = i + 1
    let ret = world.types.typeOf(unit = ref.unit, decl = ref.decl)
    if ret < 0:
        return hitType(pool = world.types.pool, id = -1)
    return intern(pool = world.types.pool, kind = .typeClassFunction, name = "", kids = params, ret = ret)

; 枚举项类型：无载荷给枚举自身，带载荷给构造签名，返回固定是枚举。
variantType|func(world: MemberWorld, ref: DeclRef, enumId: I32,) -> (TypeInsert,):
    let unit = world.units[ref.unit]
    let decl = unit.ast.decls[ref.decl]
    var params: Array<I32> = []
    var i = 0
    while i < len(decl.kids):
        let kid = decl.kids[i]
        if isParamDeclCode(unit.ast.decls[kid].kind):
            let paramType = world.types.typeOf(unit = ref.unit, decl = kid)
            if paramType < 0:
                return hitType(pool = world.types.pool, id = -1)
            params = params.append(paramType)
        i = i + 1
    if len(params) == 0:
        return hitType(pool = world.types.pool, id = enumId)
    return intern(pool = world.types.pool, kind = .typeClassFunction, name = "", kids = params, ret = enumId)

; 元组成员：数字名字按位置取分量，其余名字走标签串。
checkTupleMember|func(out: MemberResult, entry: TypeEntry, access: MemberAccess,) -> (MemberResult,):
    let typeName = typeText(pool = out.pool, id = access.receiver)
    let index = digitIndex(access.spelling)
    if index >= 0:
        if index >= len(entry.kids):
            return failMember(out = out, access = access, kind = .memberUnknown, typeName = typeName)
        var done = out
        done.kind = .memberTupleIndex
        done.typeId = entry.kids[index]
        return done
    let label = tupleLabelIndex(entry = entry, key = access.key)
    if label < 0 || label >= len(entry.kids):
        return failMember(out = out, access = access, kind = .memberUnknown, typeName = typeName)
    var done = out
    done.kind = .memberTupleLabel
    done.typeId = entry.kids[label]
    return done

; 内建成员：按所有者与名字查表，成员值按接收者实参定成函数类型；无形参就是零参函数。
checkBuiltinMember|func(world: MemberWorld, out: MemberResult, owner: String, kids: Array<I32>, access: MemberAccess,) -> (MemberResult,):
    let at = findBuiltin(members = world.builtins, owner = owner, name = access.spelling)
    if at < 0:
        return failMember(out = out, access = access, kind = .memberUnknown, typeName = typeText(pool = out.pool, id = access.receiver))
    let typed = builtinMemberSignature(pool = out.pool, member = world.builtins[at], kids = kids)
    if typed.id < 0:
        return deferMember(out = out, receiver = access.receiver)
    var done = out
    done.pool = typed.pool
    done.kind = .memberBuiltin
    done.typeId = typed.id
    return done

; 组合表：结构体首行裸类型名记作组合字段，值是父类型名；没有嵌入的结构不入表。
collectCompositions|func(units: Array<CompilationUnit>,) -> (Array<TypeComposition>,):
    var out: Array<TypeComposition> = []
    var u = 0
    while u < len(units):
        let unit = units[u]
        let bytes = unitBytes(unit)
        var i = 0
        while i < len(unit.ast.items):
            let decl = unit.ast.decls[unit.ast.items[i]]
            if isStructDeclCode(decl.kind):
                var parents: Array<String> = []
                var f = 0
                while f < len(decl.kids):
                    let field = unit.ast.decls[decl.kids[f]]
                    if isFieldDeclCode(field.kind) && field.composed:
                        parents = parents.append(decodeRange(bytes = bytes, start = field.nameStart, end = field.nameEnd))
                    f = f + 1
                if len(parents) > 0:
                    var row = TypeComposition()
                    row.name = decodeRange(bytes = bytes, start = decl.nameStart, end = decl.nameEnd)
                    row.parents = parents
                    out = out.append(row)
            i = i + 1
        u = u + 1
    return out

; 嵌入父类型名：按 NFC 键查组合表；未嵌入答空表，成员判定据此直接落空。
composedParentNames|func(world: MemberWorld, owner: String,) -> (Array<String>,):
    let ownerKey = keyOfText(owner)
    var i = 0
    while i < len(world.compositions):
        if sameKey(first = keyOfText(world.compositions[i].name), second = ownerKey):
            return world.compositions[i].parents
        i = i + 1
    var empty: Array<String> = []
    return empty

; 组合提升：本类型缺该成员时按嵌入父类型逐层再查，深度上限挡住自嵌环。
; 全部落空仍按原接收者名报未知成员，诊断不指向父类型。
checkPromotedMember|func(world: MemberWorld, out: MemberResult, entry: TypeEntry, access: MemberAccess, origin: String, depth: I32,) -> (MemberResult,):
    if depth >= 4:
        return failMember(out = out, access = access, kind = .memberUnknown, typeName = origin)
    let parents = composedParentNames(world = world, owner = entry.name)
    var i = 0
    while i < len(parents):
        let parentId = nominalTypeId(world = world, name = parents[i])
        if parentId >= 0 && parentId < len(out.pool.entries):
            let parentEntry = out.pool.entries[parentId]
            if lookupMember(index = world.symbols, owner = parentEntry.name, key = access.key) >= 0:
                return checkNominalMember(world = world, out = out, entry = parentEntry, access = access)
            let deeper = checkPromotedMember(world = world, out = out, entry = parentEntry, access = access, origin = origin, depth = depth + 1)
            if !deeper.failed:
                return deeper
        i = i + 1
    return failMember(out = out, access = access, kind = .memberUnknown, typeName = origin)

; 名义成员：先查符号，再判可见性，最后按声明类别给类型与成员类别。
checkNominalMember|func(world: MemberWorld, out: MemberResult, entry: TypeEntry, access: MemberAccess,) -> (MemberResult,):
    let owner = entry.name
    let at = lookupMember(index = world.symbols, owner = owner, key = access.key)
    if at < 0:
        return checkPromotedMember(world = world, out = out, entry = entry, access = access, origin = owner, depth = 0)
    let symbol = world.table.symbolAt(at)
    let ref = lookupDecl(index = world.decls, file = symbol.file, offset = symbol.offset)
    if ref.unit < 0:
        return deferMember(out = out, receiver = access.receiver)
    let decl = world.units[ref.unit].ast.decls[ref.decl]
    if isVisibility(level = symbol.visibility, expected = .visibilityPrivate) && access.owner != symbol.owner:
        if isFieldDeclCode(decl.kind):
            return failMember(out = out, access = access, kind = .memberPrivate, typeName = owner)
        return failMember(out = out, access = access, kind = .memberInaccessible, typeName = owner)
    if isVisibility(level = symbol.visibility, expected = .visibilityInternal) && access.file != symbol.file:
        return failMember(out = out, access = access, kind = .memberInaccessible, typeName = owner)
    if isFieldDeclCode(decl.kind):
        return checkFieldMember(world = world, out = out, owner = owner, ref = ref, symbol = at, access = access)
    if isFunctionDeclCode(decl.kind):
        return checkMethodMember(world = world, out = out, owner = owner, ref = ref, symbol = at, decl = decl, access = access)
    if isVariantDeclCode(decl.kind):
        return checkVariantMember(world = world, out = out, owner = owner, ref = ref, symbol = at, access = access)
    return failMember(out = out, access = access, kind = .memberUnknown, typeName = owner)

; 字段成员：类型名位不暴露字段，值位按声明标注回表。
checkFieldMember|func(world: MemberWorld, out: MemberResult, owner: String, ref: DeclRef, symbol: I32, access: MemberAccess,) -> (MemberResult,):
    if access.isTypeName:
        return failMember(out = out, access = access, kind = .memberUnknown, typeName = owner)
    let typeId = world.types.typeOf(unit = ref.unit, decl = ref.decl)
    if typeId < 0:
        return deferMember(out = out, receiver = access.receiver)
    var done = out
    done.kind = .memberField
    done.typeId = typeId
    done.symbol = symbol
    return done

; 方法成员：类型名位只认本型方法，值位两种都认。
checkMethodMember|func(world: MemberWorld, out: MemberResult, owner: String, ref: DeclRef, symbol: I32, decl: DeclNode, access: MemberAccess,) -> (MemberResult,):
    if access.isTypeName && !decl.isOwn:
        return failMember(out = out, access = access, kind = .memberUnknown, typeName = owner)
    let typed = methodType(world = world, ref = ref)
    if typed.id < 0:
        return deferMember(out = out, receiver = access.receiver)
    var done = out
    done.pool = typed.pool
    if decl.isOwn:
        done.kind = .memberOwnMethod
    else:
        done.kind = .memberMethod
    done.typeId = typed.id
    done.symbol = symbol
    return done

; 枚举项成员：只在类型名位可见，返回构造签名或枚举自身。
checkVariantMember|func(world: MemberWorld, out: MemberResult, owner: String, ref: DeclRef, symbol: I32, access: MemberAccess,) -> (MemberResult,):
    if !access.isTypeName:
        return failMember(out = out, access = access, kind = .memberUnknown, typeName = owner)
    let typed = variantType(world = world, ref = ref, enumId = access.receiver)
    if typed.id < 0:
        return deferMember(out = out, receiver = access.receiver)
    var done = out
    done.pool = typed.pool
    done.kind = .memberEnumCase
    done.typeId = typed.id
    done.symbol = symbol
    return done

; 未命中：失败且类别为未知成员；只有这一种情况才回落到内建成员表。
isUnknownMember|func(result: MemberResult,) -> (Bool,):
    if !result.failed:
        return false
    return isMemberError(error = result.error, kind = .memberUnknown)

; 声明探测：在独立的结果盒里查一次，未命中不污染调用方的那份。
; 参数按引用传入，探测失败会写进同一个盒；内建回落因此必须先拿到干净结果。
probeDeclared|func(world: MemberWorld, pool: TypePool, entry: TypeEntry, access: MemberAccess,) -> (MemberResult,):
    var box = MemberResult()
    box.pool = pool
    return checkNominalMember(world = world, out = box, entry = entry, access = access)

; 判定入口：接收者非法即待定；元组、字符串、容器与名义类型各走一条。
; 字符串与容器先查声明：扩展块挂在内建类型上时声明压过原生，与宿主 body-first 同序。
checkMember|func(world: MemberWorld, access: MemberAccess,) -> (MemberResult,):
    var out = MemberResult()
    out.pool = world.types.pool
    if access.receiver < 0 || access.receiver >= len(out.pool.entries):
        return deferMember(out = out, receiver = access.receiver)
    let entry = out.pool.entries[access.receiver]
    if isTypeClass(kind = entry.kind, expected = .typeClassTuple):
        return checkTupleMember(out = out, entry = entry, access = access)
    if isTypeClass(kind = entry.kind, expected = .typeClassScalar) && entry.name == "String":
        let declared = probeDeclared(world = world, pool = out.pool, entry = entry, access = access)
        if !isUnknownMember(result = declared):
            return declared
        return checkBuiltinMember(world = world, out = out, owner = entry.name, kids = [], access = access)
    if isTypeClass(kind = entry.kind, expected = .typeClassCollection):
        let declared = probeDeclared(world = world, pool = out.pool, entry = entry, access = access)
        if !isUnknownMember(result = declared):
            return declared
        return checkBuiltinMember(world = world, out = out, owner = entry.name, kids = entry.kids, access = access)
    ; 任务句柄：泛型实例没有名义成员表，成员只取内建那一份。
    if isFutureType(pool = out.pool, id = access.receiver):
        return checkBuiltinMember(world = world, out = out, owner = entry.name, kids = entry.kids, access = access)
    if isNominalClass(entry.kind):
        return checkNominalMember(world = world, out = out, entry = entry, access = access)
    return failMember(out = out, access = access, kind = .memberUnknown, typeName = typeText(pool = out.pool, id = access.receiver))
