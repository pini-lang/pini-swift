[expr_infer|import]
_syntax = "../../../syntax"
_module_loader = "../../../module-loader"

; 类型推导：按函数、按语句序求表达式类型，写进类型表，不产诊断；推不出的留未写，调用方按「未定即放过」处理。
; 名字表按函数分组并在语句序里增量登记，`let a = f(x)` 之后 a 及其下游因此可推。
; 前导点用例按「候选枚举唯一」定型：用例是枚举的成员，知道所属枚举才知道类型。

; 名字类型：名字、类型下标与歧义标记；歧义来自同名不同型的绑定。
(NameType)
name: String = ""
typeId: I32 = -1
ambiguous: Bool = false

; 名字表：单元内参数与局部变量的类型；不含顶层符号与内建。
; `owner` 是所属类型名：成员访问按它判私有，空串表示自由函数。
(NameTable)
items: Array<NameType> = []
owner: String = ""

; 名字表构建结果：表与随标注解析增长的池。
(NameBuild)
table: NameTable = NameTable()
pool: TypePool = TypePool()

; 推导结果：池、类型表与本次求得的类型下标。
(InferResult)
pool: TypePool = TypePool()
types: ExprTypes = ExprTypes()
typeId: I32 = -1

; 记一个名字：同名同型保持，同名异型标歧义，空名与未定型不入表。
noteName|func(table: NameTable, name: String, typeId: I32,) -> (NameTable,):
    if len(name) == 0 || typeId < 0:
        return table
    var out = table
    var i = 0
    while i < len(out.items):
        if out.items[i].name == name:
            if out.items[i].typeId != typeId:
                out.items[i].ambiguous = true
            return out
        i = i + 1
    var row = NameType()
    row.name = name
    row.typeId = typeId
    out.items = out.items.append(row)
    return out

; 查名字类型：歧义与缺席都答 -1，调用方据此不推。
lookupNameType|func(table: NameTable, name: String,) -> (I32,):
    var i = 0
    while i < len(table.items):
        if table.items[i].name == name:
            if table.items[i].ambiguous:
                return -1
            return table.items[i].typeId
        i = i + 1
    return -1

; 类型标注：用当前池解析，返回增长后的池与类型下标。
annotationType|func(world: MemberWorld, unit: CompilationUnit, node: I32, pool: TypePool,) -> (TypeInsert,):
    var holder = StoreCheck()
    holder.pool = pool
    return resolveAnnotation(world = world, unit = unit, node = node, out = holder)

; 换池：判定面从 `world.types.pool` 取初始池，推导新增的条目必须一并交过去。
probeWorld|func(world: MemberWorld, pool: TypePool,) -> (MemberWorld,):
    var out = world
    var table = out.types
    table.pool = pool
    out.types = table
    return out

; 推导状态：类型表、池、函数级名字表与字节视图一并传递；名字表出函数即弃，不跨函数复用。
(WalkState)
types: ExprTypes = ExprTypes()
pool: TypePool = TypePool()
table: NameTable = NameTable()
bytes: Array<U8> = []
returnType: I32 = -1

; 函数名表：自身与参数先入表；方法体里的局部声明在语句序里增量加入。
; 自身按所属类型的池下标入表，`self.字段` 的接收者因此有型可查；非方法传 -1。
functionNameTable|func(world: MemberWorld, unit: CompilationUnit, declId: I32, ownerType: I32, pool: TypePool, bytes: Array<U8>,) -> (NameBuild,):
    var out = NameBuild()
    out.pool = pool
    let decl = unit.ast.decls[declId]
    if decl.isSelf:
        out.table = noteName(table = out.table, name = "self", typeId = ownerType)
    var i = 0
    while i < len(decl.kids):
        let param = unit.ast.decls[decl.kids[i]]
        if isParamDeclCode(param.kind):
            let name = decodeRange(bytes = bytes, start = param.nameStart, end = param.nameEnd)
            let resolved = annotationType(world = world, unit = unit, node = param.typeId, pool = out.pool)
            out.pool = resolved.pool
            out.table = noteName(table = out.table, name = name, typeId = resolved.id)
        i = i + 1
    return out

; 枚举名：类型池条目属枚举类别才答名字，其余答空串 —— 期望类型不是枚举就没有归属可言。
enumNameOfType|func(pool: TypePool, id: I32,) -> (String,):
    if id < 0 || id >= len(pool.entries):
        return ""
    let entry = pool.entries[id]
    if !isTypeClass(kind = entry.kind, expected = .typeClassEnum):
        return ""
    return entry.name

; 用例归属：期望类型是枚举且确实声明了该用例时优先，其次退回唯一候选。
; 期望优先是主路 —— 同名用例只靠唯一候选分不出来。
caseOwnerFor|func(world: MemberWorld, name: String, expected: Expectation,) -> (String,):
    if expected.hasExpected:
        let named = enumNameOfType(pool = world.types.pool, id = expected.typeId)
        if len(named) > 0:
            let symbol = lookupMemberByName(index = world.symbols, owner = named, name = name)
            let ref = symbolDecl(world = world, symbol = symbol)
            if ref.unit >= 0:
                let decl = world.units[ref.unit].ast.decls[ref.decl]
                if isVariantDeclCode(decl.kind):
                    return named
    return uniqueCaseOwner(index = world.symbols, name = name)

; 推一个表达式节点：缺位与已定型都直接返回；推不出不拦，后续语句照走。
inferAtNode|func(world: MemberWorld, unit: CompilationUnit, unitIndex: I32, node: I32, state: WalkState, expected: Expectation,) -> (WalkState,):
    var out = state
    if node < 0 || node >= unit.ast.exprCount():
        return out
    let one = inferNode(world = world, unit = unit, unitIndex = unitIndex, node = node, names = out.table, pool = out.pool, types = out.types, bytes = out.bytes, expected = expected)
    out.pool = one.pool
    out.types = one.types
    return out

; 推语句的第 n 个子节点：子节点按源序排，缺位由 inferAtNode 挡掉。
; 语句子节点：默认无期望；要带期望的调用方直接走 inferAtNode。
inferStmtKid|func(world: MemberWorld, unit: CompilationUnit, unitIndex: I32, stmtId: I32, index: I32, state: WalkState,) -> (WalkState,):
    return inferAtNode(world = world, unit = unit, unitIndex = unitIndex, node = unit.ast.stmtChild(id = stmtId, index = index), state = state, expected = noExpectation())

; 模式登记：按被遍历表达式的容器分量给模式变量定型并入表；分量不够就少登记。
registerLoopPattern|func(unit: CompilationUnit, unitIndex: I32, pattern: I32, source: I32, state: WalkState,) -> (WalkState,):
    var out = state
    let sourceType = exprTypeAt(table = out.types, unit = unitIndex, node = source)
    let components = loopComponents(pool = out.pool, id = sourceType)
    let fields = loopPatternFields(unit = unit, pattern = pattern)
    var i = 0
    while i < len(fields):
        if i < len(components) && unit.ast.isIdentifierExpr(fields[i]):
            let expr = unit.ast.exprAt(fields[i])
            let name = decodeRange(bytes = out.bytes, start = expr.nameStart, end = expr.nameEnd)
            out.types = writeExprType(table = out.types, unit = unitIndex, node = fields[i], typeId = components[i])
            out.table = noteName(table = out.table, name = name, typeId = components[i])
        i = i + 1
    return out

; 块：逐条语句按源序走；语句之间共享同一张函数级名字表，增量的用处正在这里。
walkInferBlock|func(world: MemberWorld, unit: CompilationUnit, unitIndex: I32, blockId: I32, state: WalkState,) -> (WalkState,):
    var out = state
    let kids = unit.ast.stmtAt(blockId).kids
    var i = 0
    while i < len(kids):
        out = walkInferStmt(world = world, unit = unit, unitIndex = unitIndex, stmtId = kids[i], state = out)
        i = i + 1
    return out

; 变量声明：先推初值，再按标注或初值类型登记名字，标注类型同时写回模式节点。
; 写回是给降载用的：降载读模式节点取声明类型，不必再解一次标注。
walkInferVariable|func(world: MemberWorld, unit: CompilationUnit, unitIndex: I32, stmtId: I32, state: WalkState,) -> (WalkState,):
    let stmt = unit.ast.stmtAt(stmtId)
    var out = state
    var declared = -1
    if stmt.typeId >= 0:
        let resolved = annotationType(world = world, unit = unit, node = stmt.typeId, pool = out.pool)
        out.pool = resolved.pool
        declared = resolved.id
    ; 初值：有标注就按标注作期望推 —— 前导点用例靠这一条定型，不是靠唯一候选。
    var wanted = noExpectation()
    if declared >= 0:
        wanted = expectType(declared)
    out = inferAtNode(world = world, unit = unit, unitIndex = unitIndex, node = unit.ast.stmtChild(id = stmtId, index = 1), state = out, expected = wanted)
    let pattern = unit.ast.stmtChild(id = stmtId, index = 0)
    if pattern < 0 || !unit.ast.isIdentifierExpr(pattern):
        return out
    var typeId = declared
    if typeId < 0:
        typeId = exprTypeAt(table = out.types, unit = unitIndex, node = unit.ast.stmtChild(id = stmtId, index = 1))
    if typeId < 0:
        return out
    let expr = unit.ast.exprAt(pattern)
    let name = decodeRange(bytes = out.bytes, start = expr.nameStart, end = expr.nameEnd)
    out.types = writeExprType(table = out.types, unit = unitIndex, node = pattern, typeId = typeId)
    if name != "_":
        out.table = noteName(table = out.table, name = name, typeId = typeId)
    return out

; 遍历与展开：被遍历表先推，模式变量按分量定型，体与步进随后走。
walkInferLoopLike|func(world: MemberWorld, unit: CompilationUnit, unitIndex: I32, stmtId: I32, state: WalkState,) -> (WalkState,):
    var out = inferStmtKid(world = world, unit = unit, unitIndex = unitIndex, stmtId = stmtId, index = 1, state = state)
    out = registerLoopPattern(unit = unit, unitIndex = unitIndex, pattern = unit.ast.stmtChild(id = stmtId, index = 0), source = unit.ast.stmtChild(id = stmtId, index = 1), state = out)
    out = walkInferStmt(world = world, unit = unit, unitIndex = unitIndex, stmtId = unit.ast.stmtChild(id = stmtId, index = 2), state = out)
    return walkInferStmt(world = world, unit = unit, unitIndex = unitIndex, stmtId = unit.ast.stmtChild(id = stmtId, index = 3), state = out)

; 条件语句：kids 交替是「条件、块」，末尾可能是孤立的分支块；由奇偶定尾部，不按节点池猜。
walkInferIf|func(world: MemberWorld, unit: CompilationUnit, unitIndex: I32, stmtId: I32, state: WalkState,) -> (WalkState,):
    var out = state
    let count = len(unit.ast.stmtAt(stmtId).kids)
    var k = 0
    while 2 * k + 1 < count:
        out = inferStmtKid(world = world, unit = unit, unitIndex = unitIndex, stmtId = stmtId, index = 2 * k, state = out)
        out = walkInferStmt(world = world, unit = unit, unitIndex = unitIndex, stmtId = unit.ast.stmtChild(id = stmtId, index = 2 * k + 1), state = out)
        k = k + 1
    var rest = count
    while rest >= 2:
        rest = rest - 2
    if rest == 1 && count >= 3:
        out = walkInferStmt(world = world, unit = unit, unitIndex = unitIndex, stmtId = unit.ast.stmtChild(id = stmtId, index = count - 1), state = out)
    return out

; 匹配语句：只推主题与各分支块；模式里的绑定名不猜类型 —— 枚举载荷不在推导面。
walkInferMatch|func(world: MemberWorld, unit: CompilationUnit, unitIndex: I32, stmtId: I32, state: WalkState,) -> (WalkState,):
    var out = inferStmtKid(world = world, unit = unit, unitIndex = unitIndex, stmtId = stmtId, index = 0, state = state)
    let subject = unit.ast.stmtChild(id = stmtId, index = 0)
    let subjectType = exprTypeAt(table = out.types, unit = unitIndex, node = subject)
    let count = len(unit.ast.stmtAt(stmtId).kids)
    var i = 1
    while i + 1 < count:
        let patternNode = unit.ast.stmtChild(id = stmtId, index = i)
        var inner = out
        if subjectType >= 0:
            ; 臂内绑定按用例载荷定型：没有这一步，`case ok(v)` 的 v 在体里推不出类型。
            let info = classifyPattern(unit = unit, node = patternNode)
            let payloads = patternPayloadTypes(world = world, pool = out.pool, subjectType = subjectType, caseName = info.name)
            var table = inner.table
            var b = 0
            while b < len(info.bindings):
                if b < len(payloads):
                    table = noteName(table = table, name = info.bindings[b], typeId = payloads[b])
                b = b + 1
            inner.table = table
        out = walkInferStmt(world = world, unit = unit, unitIndex = unitIndex, stmtId = unit.ast.stmtChild(id = stmtId, index = i + 1), state = inner)
        i = i + 2
    return out

; 语句分派：语句序即源序，分支与块递归；未列的类别没有要推的表达式，直接过。
walkInferStmt|func(world: MemberWorld, unit: CompilationUnit, unitIndex: I32, stmtId: I32, state: WalkState,) -> (WalkState,):
    if stmtId < 0 || stmtId >= unit.ast.stmtCount():
        return state
    let ast = unit.ast
    if ast.isBlockStmt(stmtId):
        return walkInferBlock(world = world, unit = unit, unitIndex = unitIndex, blockId = stmtId, state = state)
    if ast.isVariableStmt(stmtId):
        return walkInferVariable(world = world, unit = unit, unitIndex = unitIndex, stmtId = stmtId, state = state)
    if ast.isIfStmt(stmtId):
        return walkInferIf(world = world, unit = unit, unitIndex = unitIndex, stmtId = stmtId, state = state)
    if ast.isForStmt(stmtId) || ast.isUnrollStmt(stmtId):
        return walkInferLoopLike(world = world, unit = unit, unitIndex = unitIndex, stmtId = stmtId, state = state)
    if ast.isMatchStmt(stmtId):
        return walkInferMatch(world = world, unit = unit, unitIndex = unitIndex, stmtId = stmtId, state = state)
    if ast.isWhileStmt(stmtId) || ast.isDeferStmt(stmtId):
        let cond = inferStmtKid(world = world, unit = unit, unitIndex = unitIndex, stmtId = stmtId, index = 0, state = state)
        return walkStmtKidsFrom(world = world, unit = unit, unitIndex = unitIndex, stmtId = stmtId, from = 1, state = cond)
    if ast.isAssignStmt(stmtId):
        let target = inferStmtKid(world = world, unit = unit, unitIndex = unitIndex, stmtId = stmtId, index = 0, state = state)
        return inferStmtKid(world = world, unit = unit, unitIndex = unitIndex, stmtId = stmtId, index = 1, state = target)
    if ast.isReturnStmt(stmtId):
        var wanted = noExpectation()
        if state.returnType >= 0:
            wanted = expectType(state.returnType)
        return inferAtNode(world = world, unit = unit, unitIndex = unitIndex, node = unit.ast.stmtChild(id = stmtId, index = 0), state = state, expected = wanted)
    return inferStmtKid(world = world, unit = unit, unitIndex = unitIndex, stmtId = stmtId, index = 0, state = state)

; 连走若干语句子节点：从 from 起到末尾，缺位由 walkInferStmt 挡掉。
walkStmtKidsFrom|func(world: MemberWorld, unit: CompilationUnit, unitIndex: I32, stmtId: I32, from: I32, state: WalkState,) -> (WalkState,):
    var out = state
    let count = len(unit.ast.stmtAt(stmtId).kids)
    var i = from
    while i < count:
        out = walkInferStmt(world = world, unit = unit, unitIndex = unitIndex, stmtId = unit.ast.stmtChild(id = stmtId, index = i), state = out)
        i = i + 1
    return out

; 函数体：本函数的名字表先建好再走体，走过即弃 —— 名字表按函数分组，跨函数不再互相干扰。
walkInferFunction|func(world: MemberWorld, unit: CompilationUnit, unitIndex: I32, declId: I32, ownerType: I32, state: WalkState,) -> (WalkState,):
    let decl = unit.ast.decls[declId]
    if decl.isForeign || decl.body < 0:
        return state
    let built = functionNameTable(world = world, unit = unit, declId = declId, ownerType = ownerType, pool = state.pool, bytes = state.bytes)
    var inner = state
    inner.pool = built.pool
    inner.table = built.table
    if ownerType >= 0 && ownerType < len(inner.pool.entries):
        inner.table.owner = inner.pool.entries[ownerType].name
    if decl.typeId >= 0:
        let ret = annotationType(world = world, unit = unit, node = decl.typeId, pool = inner.pool)
        inner.pool = ret.pool
        inner.returnType = ret.id
    if decl.isAsync && inner.returnType >= 0:
        ; 异步体交的是结算值：`return ok(v)` 的期望类型是 `Result<T>`，不是句柄。
        let settled = resultType(pool = inner.pool, elem = inner.returnType)
        inner.pool = settled.pool
        inner.returnType = settled.id
    let walked = walkInferStmt(world = world, unit = unit, unitIndex = unitIndex, stmtId = decl.body, state = inner)
    var out = state
    out.pool = walked.pool
    out.types = walked.types
    return out

; 逐声明走体：顶层函数直接走，类型与扩展块下钻到成员函数，所属类型按块名解一次。
walkInferDecls|func(world: MemberWorld, unit: CompilationUnit, unitIndex: I32, state: WalkState,) -> (WalkState,):
    var out = state
    var d = 0
    while d < unit.ast.declCount():
        let decl = unit.ast.decls[d]
        if isFunctionDeclCode(decl.kind):
            out = walkInferFunction(world = world, unit = unit, unitIndex = unitIndex, declId = d, ownerType = -1, state = out)
        elif isOwnerDeclCode(decl.kind):
            let ownerName = decodeRange(bytes = out.bytes, start = decl.nameStart, end = decl.nameEnd)
            let ownerType = nominalTypeId(world = world, name = ownerName)
            var i = 0
            while i < len(decl.kids):
                let child = decl.kids[i]
                if isFunctionDeclCode(unit.ast.decls[child].kind):
                    out = walkInferFunction(world = world, unit = unit, unitIndex = unitIndex, declId = child, ownerType = ownerType, state = out)
                i = i + 1
        d = d + 1
    return out

; 函数返回类型：按声明上的类型节点解析；顶层函数才有这一位。
; 异步函数的调用方看到的是任务句柄 `Future<T>`，体里要交的却是 `Result<T>`。
returnTypeOf|func(world: MemberWorld, symbol: I32, pool: TypePool,) -> (TypeInsert,):
    let ref = symbolDecl(world = world, symbol = symbol)
    if ref.unit < 0:
        return hitType(pool = pool, id = -1)
    let decl = world.units[ref.unit].ast.decls[ref.decl]
    if !isFunctionDeclCode(decl.kind):
        return hitType(pool = pool, id = -1)
    let resolved = annotationType(world = world, unit = world.units[ref.unit], node = decl.typeId, pool = pool)
    if !decl.isAsync || resolved.id < 0:
        return resolved
    let wrapped = futureType(pool = resolved.pool, payload = resolved.id)
    return hitType(pool = wrapped.pool, id = wrapped.id)

; 外部数据符号的类型：外部块里非函数类型的条目；其余答 -1。
foreignDataSymbolType|func(world: MemberWorld, name: String,) -> (I32,):
    let symbol = lookupTopByName(index = world.symbols, name = name)
    if symbol < 0:
        return -1
    let ref = symbolDecl(world = world, symbol = symbol)
    if ref.unit < 0:
        return -1
    let unit = world.units[ref.unit]
    let decl = unit.ast.decls[ref.decl]
    if !isForeignSymbolCode(decl.kind):
        return -1
    if decl.typeId < 0 || decl.typeId >= len(unit.ast.types):
        return -1
    if isFunctionTypeCode(unit.ast.types[decl.typeId].kind):
        return -1
    return world.types.typeOf(unit = ref.unit, decl = ref.decl)

; 实参预推：先把调用节点的全部子节点推一遍，实参类型因此在提取时可用。
inferKids|func(world: MemberWorld, unit: CompilationUnit, unitIndex: I32, node: I32, names: NameTable, pool: TypePool, types: ExprTypes, bytes: Array<U8>,) -> (InferResult,):
    var out = InferResult()
    out.pool = pool
    out.types = types
    var kids = unit.ast.exprAt(node).kids
    var i = 0
    while i < len(kids):
        let one = inferNode(world = world, unit = unit, unitIndex = unitIndex, node = kids[i], names = names, pool = out.pool, types = out.types, bytes = bytes, expected = noExpectation())
        out.pool = one.pool
        out.types = one.types
        i = i + 1
    out.typeId = unsetTypeId()
    return out

; 推导一个节点：已定型的直接复用，其余按类别后序求值并写表。
inferNode|func(world: MemberWorld, unit: CompilationUnit, unitIndex: I32, node: I32, names: NameTable, pool: TypePool, types: ExprTypes, bytes: Array<U8>, expected: Expectation,) -> (InferResult,):
    var out = InferResult()
    out.pool = pool
    out.types = types
    out.typeId = unsetTypeId()
    if node < 0 || node >= unit.ast.exprCount():
        return out
    let known = exprTypeAt(table = types, unit = unitIndex, node = node)
    if known >= 0:
        out.typeId = known
        return out
    if unit.ast.isLiteralExpr(node):
        let typed = checkLiteral(unit = unit, unitIndex = unitIndex, node = node, expectation = expected, pool = out.pool, types = out.types)
        out.pool = typed.pool
        out.types = typed.types
        if !typed.failed:
            out.typeId = typed.typeId
        return out
    if unit.ast.isCaseExpr(node):
        let expr = unit.ast.exprAt(node)
        let name = decodeRange(bytes = bytes, start = expr.nameStart, end = expr.nameEnd)
        let owner = caseOwnerFor(world = world, name = name, expected = expected)
        if len(owner) > 0:
            out.typeId = nominalTypeId(world = world, name = owner)
            if out.typeId >= 0:
                out.types = writeExprType(table = out.types, unit = unitIndex, node = node, typeId = out.typeId)
        return out
    if unit.ast.isFunctionExpr(node):
        return inferFunction(world = world, unit = unit, unitIndex = unitIndex, node = node, names = names, out = out, bytes = bytes)
    if unit.ast.isGenericExpr(node):
        let expr = unit.ast.exprAt(node)
        let resolved = annotationType(world = world, unit = unit, node = expr.typeId, pool = out.pool)
        out.pool = resolved.pool
        if resolved.id >= 0:
            out.typeId = resolved.id
            out.types = writeExprType(table = out.types, unit = unitIndex, node = node, typeId = out.typeId)
        return out
    if unit.ast.isIdentifierExpr(node):
        let expr = unit.ast.exprAt(node)
        let name = decodeRange(bytes = bytes, start = expr.nameStart, end = expr.nameEnd)
        out.typeId = lookupNameType(table = names, name = name)
        if out.typeId < 0:
            out.typeId = foreignDataSymbolType(world = world, name = name)
        if out.typeId >= 0:
            out.types = writeExprType(table = out.types, unit = unitIndex, node = node, typeId = out.typeId)
        return out
    if unit.ast.isMemberExpr(node):
        return inferMember(world = world, unit = unit, unitIndex = unitIndex, node = node, names = names, out = out, bytes = bytes)
    if unit.ast.isCallExpr(node):
        return inferCall(world = world, unit = unit, unitIndex = unitIndex, node = node, names = names, out = out, bytes = bytes, expected = expected)
    if unit.ast.isJoinExpr(node):
        ; 等待：操作数须是任务句柄，站点类型是它结算后的 `Result<T>`；不是句柄留未写。
        let operated = unit.ast.childOf(id = node, index = 0)
        let future = inferNode(world = world, unit = unit, unitIndex = unitIndex, node = operated, names = names, pool = out.pool, types = out.types, bytes = bytes, expected = noExpectation())
        out.pool = future.pool
        out.types = future.types
        let payload = futurePayload(pool = out.pool, id = future.typeId)
        if payload >= 0:
            let settled = resultType(pool = out.pool, elem = payload)
            out.pool = settled.pool
            out.typeId = settled.id
            out.types = writeExprType(table = out.types, unit = unitIndex, node = node, typeId = out.typeId)
        return out
    if unit.ast.isBinaryExpr(node):
        return inferBinary(world = world, unit = unit, unitIndex = unitIndex, node = node, names = names, out = out, bytes = bytes)
    if unit.ast.isUnaryExpr(node):
        return inferUnary(world = world, unit = unit, unitIndex = unitIndex, node = node, names = names, out = out, bytes = bytes)
    if unit.ast.isArrayExpr(node) || unit.ast.isSetExpr(node) || unit.ast.isDictionaryExpr(node):
        return inferContainer(world = world, unit = unit, unitIndex = unitIndex, node = node, names = names, out = out, bytes = bytes, expected = expected)
    if unit.ast.isSubscriptExpr(node) || unit.ast.isSliceExpr(node):
        return inferIndex(world = world, unit = unit, unitIndex = unitIndex, node = node, names = names, out = out, bytes = bytes)
    if unit.ast.isCastExpr(node):
        let expr = unit.ast.exprAt(node)
        let resolved = annotationType(world = world, unit = unit, node = expr.typeId, pool = out.pool)
        out.pool = resolved.pool
        if resolved.id >= 0:
            out.typeId = resolved.id
            out.types = writeExprType(table = out.types, unit = unitIndex, node = node, typeId = out.typeId)
        return out
    return out

; 函数字面量：形参类型取声明标注，返回取 `op`；体在形参入表后走一遍。
; 无标注形参答 -1，函数类型因此缺分量，降载期按能力缺口报，不猜类型。
inferFunction|func(world: MemberWorld, unit: CompilationUnit, unitIndex: I32, node: I32, names: NameTable, out: InferResult, bytes: Array<U8>,) -> (InferResult,):
    var done = out
    let expr = unit.ast.exprAt(node)
    var table = names
    var ids: Array<I32> = []
    var body = -1
    var i = 0
    while i < len(expr.kids):
        let kid = expr.kids[i]
        ; 形参在前、体块在末位；体的下标落在语句池，不能拿去查声明池。
        if i == len(expr.kids) - 1 && unit.ast.isBlockStmt(kid):
            body = kid
        else:
            let decl = unit.ast.decls[kid]
            var typeId = -1
            if decl.typeId >= 0:
                let resolved = annotationType(world = world, unit = unit, node = decl.typeId, pool = done.pool)
                done.pool = resolved.pool
                typeId = resolved.id
            ids = ids.append(typeId)
            let name = decodeRange(bytes = bytes, start = decl.nameStart, end = decl.nameEnd)
            if typeId >= 0:
                table = noteName(table = table, name = name, typeId = typeId)
        i = i + 1
    var ret = -1
    if expr.op >= 0:
        let resolved = annotationType(world = world, unit = unit, node = expr.op, pool = done.pool)
        done.pool = resolved.pool
        ret = resolved.id
        if isEmptyTupleType(pool = done.pool, id = ret):
            ret = -1
    if body >= 0:
        var state = WalkState()
        state.pool = done.pool
        state.types = done.types
        state.table = table
        state.bytes = bytes
        state.returnType = ret
        let walked = walkInferStmt(world = world, unit = unit, unitIndex = unitIndex, stmtId = body, state = state)
        done.pool = walked.pool
        done.types = walked.types
    let inserted = intern(pool = done.pool, kind = .typeClassFunction, name = "", kids = ids, ret = ret)
    done.pool = inserted.pool
    done.typeId = inserted.id
    done.types = writeExprType(table = done.types, unit = unitIndex, node = node, typeId = done.typeId)
    return done

; 成员：接收者先推；类型已知才问成员面，成员不存在答未写。
inferMember|func(world: MemberWorld, unit: CompilationUnit, unitIndex: I32, node: I32, names: NameTable, out: InferResult, bytes: Array<U8>,) -> (InferResult,):
    let receiver = unit.ast.childOf(id = node, index = 0)
    let inner = inferNode(world = world, unit = unit, unitIndex = unitIndex, node = receiver, names = names, pool = out.pool, types = out.types, bytes = bytes, expected = noExpectation())
    var done = out
    done.pool = inner.pool
    done.types = inner.types
    if inner.typeId < 0:
        return done
    let member = unit.ast.exprAt(node)
    let memberName = decodeRange(bytes = bytes, start = member.nameStart, end = member.nameEnd)
    ; 惰性引用的值读：元素类型就是类型实参，不经名义成员表。
    if memberName == "value" && isLazyRefType(pool = done.pool, id = inner.typeId):
        let element = lazyRefElement(pool = done.pool, id = inner.typeId)
        if element >= 0:
            done.typeId = element
            done.types = writeExprType(table = done.types, unit = unitIndex, node = node, typeId = done.typeId)
        return done
    let access = memberAccess(receiver = inner.typeId, name = memberName, isTypeName = false, owner = names.owner, file = unit.path, offset = member.start)
    let result = checkMember(world = probeWorld(world = world, pool = done.pool), access = access)
    done.pool = result.pool
    if result.failed:
        return done
    done.typeId = result.typeId
    done.types = writeExprType(table = done.types, unit = unitIndex, node = node, typeId = done.typeId)
    return done

; 调用：先推被调与实参，顶层函数取声明返回类型，内建交给调用面。
; 实参：有标签按名对位传期望；纯位置调用按声明序传。
; 混写时位置实参不传期望 —— 位置与已填槽的对应要另算，传错比不传更糟。
inferActuals|func(world: MemberWorld, unit: CompilationUnit, unitIndex: I32, node: I32, params: Array<CallParam>, names: NameTable, out: InferResult, bytes: Array<U8>,) -> (InferResult,):
    var done = out
    let expr = unit.ast.exprAt(node)
    var labeled = false
    var i = 1
    while i < len(expr.kids):
        if unit.ast.isLabeledArgument(expr.kids[i]):
            labeled = true
        i = i + 1
    var positional = !labeled && len(params) > 0 && len(expr.kids) - 1 <= len(params)
    i = 1
    while i < len(expr.kids):
        let kid = expr.kids[i]
        var wanted = noExpectation()
        var valueNode = kid
        if unit.ast.isLabeledArgument(kid):
            let labelNode = unit.ast.exprAt(kid)
            let label = decodeRange(bytes = bytes, start = labelNode.nameStart, end = labelNode.nameEnd)
            let at = paramIndexOf(params = params, name = label)
            if at >= 0 && params[at].typeId >= 0:
                wanted = expectType(params[at].typeId)
            valueNode = unit.ast.childOf(id = kid, index = 0)
        elif positional:
            let at = i - 1
            if at >= 0 && at < len(params) && params[at].typeId >= 0:
                wanted = expectType(params[at].typeId)
        let one = inferNode(world = world, unit = unit, unitIndex = unitIndex, node = valueNode, names = names, pool = done.pool, types = done.types, bytes = bytes, expected = wanted)
        done.pool = one.pool
        done.types = one.types
        i = i + 1
    done.typeId = unsetTypeId()
    return done

inferCall|func(world: MemberWorld, unit: CompilationUnit, unitIndex: I32, node: I32, names: NameTable, out: InferResult, bytes: Array<U8>, expected: Expectation,) -> (InferResult,):
    var done = out
    let expr = unit.ast.exprAt(node)
    if len(expr.kids) < 1:
        return done
    let callee = expr.kids[0]
    let head = inferNode(world = world, unit = unit, unitIndex = unitIndex, node = callee, names = names, pool = done.pool, types = done.types, bytes = bytes, expected = noExpectation())
    done.pool = head.pool
    done.types = head.types
    if unit.ast.isGenericExpr(callee):
        ; 泛型构造：实参照推，结果类型取构造节点的类型位。
        done = inferActuals(world = world, unit = unit, unitIndex = unitIndex, node = node, params = [], names = names, out = done, bytes = bytes)
        done.typeId = exprTypeAt(table = done.types, unit = unitIndex, node = callee)
        if done.typeId >= 0:
            done.types = writeExprType(table = done.types, unit = unitIndex, node = node, typeId = done.typeId)
        return done
    if unit.ast.isMemberExpr(callee):
        return inferMemberCall(world = world, unit = unit, unitIndex = unitIndex, node = node, callee = callee, names = names, out = done, bytes = bytes)
    if !unit.ast.isIdentifierExpr(callee):
        return inferActuals(world = world, unit = unit, unitIndex = unitIndex, node = node, params = [], names = names, out = done, bytes = bytes)
    let calleeExpr = unit.ast.exprAt(callee)
    let name = decodeRange(bytes = bytes, start = calleeExpr.nameStart, end = calleeExpr.nameEnd)
    if name == "ok" || name == "err":
        ; 结果构造：`ok(v)` 的载荷进 ok 槽；`err(e)` 的 ok 槽取期望类型的载荷，缺期望按空元组。
        done = inferActuals(world = world, unit = unit, unitIndex = unitIndex, node = node, params = [], names = names, out = done, bytes = bytes)
        if len(expr.kids) != 2:
            return done
        let argument = exprTypeAt(table = done.types, unit = unitIndex, node = expr.kids[1])
        if argument < 0:
            return done
        var payload = argument
        if name == "err":
            payload = -1
            if expected.hasExpected && expected.typeId >= 0 && expected.typeId < len(done.pool.entries):
                let wanted = done.pool.entries[expected.typeId]
                if isTypeClass(kind = wanted.kind, expected = .typeClassResult) && len(wanted.kids) > 0:
                    payload = wanted.kids[0]
            if payload < 0:
                let empty = intern(pool = done.pool, kind = .typeClassTuple, name = "", kids = [], ret = -1)
                done.pool = empty.pool
                payload = empty.id
        let settled = resultType(pool = done.pool, elem = payload)
        done.pool = settled.pool
        done.typeId = settled.id
        done.types = writeExprType(table = done.types, unit = unitIndex, node = node, typeId = done.typeId)
        return done
    if name == "LazyRef":
        ; 省略类型实参的写法：元素类型取初值闭包的返回。
        done = inferActuals(world = world, unit = unit, unitIndex = unitIndex, node = node, params = [], names = names, out = done, bytes = bytes)
        if len(expr.kids) != 2:
            return done
        let argType = exprTypeAt(table = done.types, unit = unitIndex, node = expr.kids[1])
        if argType < 0 || argType >= len(done.pool.entries):
            return done
        let argEntry = done.pool.entries[argType]
        if !isTypeClass(kind = argEntry.kind, expected = .typeClassFunction) || argEntry.ret < 0:
            return done
        let inserted = intern(pool = done.pool, kind = .typeClassGeneric, name = "LazyRef", kids = [argEntry.ret], ret = -1)
        done.pool = inserted.pool
        done.typeId = inserted.id
        done.types = writeExprType(table = done.types, unit = unitIndex, node = node, typeId = done.typeId)
        return done
    if name == "load" || name == "store":
        return inferPointerCall(world = world, unit = unit, unitIndex = unitIndex, node = node, name = name, names = names, out = done, bytes = bytes)
    ; 函数值调用：局部绑定是函数类型就按它的形参与返回推，不走顶层符号表。
    let localType = lookupNameType(table = names, name = name)
    if localType >= 0 && localType < len(done.pool.entries):
        let localEntry = done.pool.entries[localType]
        if isTypeClass(kind = localEntry.kind, expected = .typeClassFunction):
            var localParams: Array<CallParam> = []
            var p = 0
            while p < len(localEntry.kids):
                var param = CallParam()
                param.typeId = localEntry.kids[p]
                param.takesLabel = false
                localParams = localParams.append(param)
                p = p + 1
            done = inferActuals(world = world, unit = unit, unitIndex = unitIndex, node = node, params = localParams, names = names, out = done, bytes = bytes)
            if localEntry.ret >= 0:
                done.typeId = localEntry.ret
                done.types = writeExprType(table = done.types, unit = unitIndex, node = node, typeId = done.typeId)
            return done
    let symbol = lookupTopByName(index = world.symbols, name = name)
    if symbol >= 0:
        let ref = symbolDecl(world = world, symbol = symbol)
        if ref.unit >= 0:
            let decl = world.units[ref.unit].ast.decls[ref.decl]
            if isForeignSymbolCode(decl.kind):
                return inferForeignCall(world = world, unit = unit, unitIndex = unitIndex, node = node, ref = ref, names = names, out = done, bytes = bytes)
            if (isStructDeclCode(decl.kind) || isObjectDeclCode(decl.kind) || isGivenDeclCode(decl.kind)) && len(expr.kids) == 1:
                let planted = nominalTypeId(world = world, name = name)
                if planted >= 0:
                    done.typeId = planted
                    done.types = writeExprType(table = done.types, unit = unitIndex, node = node, typeId = done.typeId)
                    return done
        done = inferActuals(world = world, unit = unit, unitIndex = unitIndex, node = node, params = declParams(world = world, ref = ref), names = names, out = done, bytes = bytes)
        let ret = returnTypeOf(world = world, symbol = symbol, pool = done.pool)
        done.pool = ret.pool
        if ret.id >= 0:
            done.typeId = ret.id
            done.types = writeExprType(table = done.types, unit = unitIndex, node = node, typeId = done.typeId)
        return done
    ; 枚举项构造：裸名用例不是顶层符号，按用例归属取类型；实参按变体字段的类型推。
    let owner = uniqueCaseOwner(index = world.symbols, name = name)
    if len(owner) > 0:
        let caseSymbol = lookupMemberByName(index = world.symbols, owner = owner, name = name)
        let ref = symbolDecl(world = world, symbol = caseSymbol)
        if ref.unit >= 0:
            done = inferActuals(world = world, unit = unit, unitIndex = unitIndex, node = node, params = declParams(world = world, ref = ref), names = names, out = done, bytes = bytes)
            let planted = nominalTypeId(world = world, name = owner)
            if planted >= 0:
                done.typeId = planted
                done.types = writeExprType(table = done.types, unit = unitIndex, node = node, typeId = done.typeId)
            return done
    done = inferActuals(world = world, unit = unit, unitIndex = unitIndex, node = node, params = [], names = names, out = done, bytes = bytes)
    let builtin = findBuiltinFunction(functions = world.functions, name = name)
    if builtin < 0:
        return done
    var site = CallSite()
    site.name = name
    site.file = unit.path
    site.offset = unit.ast.exprAt(node).start
    site.unit = unitIndex
    site.builtin = builtin
    site.args = callArguments(unit = unit, unitIndex = unitIndex, node = node, types = done.types)
    let result = checkCall(world = probeWorld(world = world, pool = done.pool), site = site)
    done.pool = result.pool
    if result.failed:
        return done
    done.typeId = result.typeId
    done.types = writeExprType(table = done.types, unit = unitIndex, node = node, typeId = done.typeId)
    return done

; 指针读写：先按源序推实参，再交给指针判定取结果；`store` 无值，不写类型表。
inferPointerCall|func(world: MemberWorld, unit: CompilationUnit, unitIndex: I32, node: I32, name: String, names: NameTable, out: InferResult, bytes: Array<U8>,) -> (InferResult,):
    var done = inferActuals(world = world, unit = unit, unitIndex = unitIndex, node = node, params = [], names = names, out = out, bytes = bytes)
    var site = CallSite()
    site.name = name
    site.file = unit.path
    site.offset = unit.ast.exprAt(node).start
    site.unit = unitIndex
    site.args = callArguments(unit = unit, unitIndex = unitIndex, node = node, types = done.types)
    var base = CallResult()
    base.pool = done.pool
    let checked = checkPointerCall(out = base, site = site, name = name)
    done.pool = checked.pool
    if checked.failed:
        return done
    if checked.typeId >= 0:
        done.typeId = checked.typeId
        done.types = writeExprType(table = done.types, unit = unitIndex, node = node, typeId = done.typeId)
    return done

; 外部调用：签名取自符号的类型位（函数类型），形参不接标签，返回类型取签名尾。
inferForeignCall|func(world: MemberWorld, unit: CompilationUnit, unitIndex: I32, node: I32, ref: DeclRef, names: NameTable, out: InferResult, bytes: Array<U8>,) -> (InferResult,):
    var done = out
    let sigId = world.types.typeOf(unit = ref.unit, decl = ref.decl)
    if sigId < 0 || sigId >= len(world.types.pool.entries):
        return done
    let sig = world.types.pool.entries[sigId]
    var params: Array<CallParam> = []
    var i = 0
    while i < len(sig.kids):
        var param = CallParam()
        param.name = "第 " + countText(i + 1) + " 个"
        param.typeId = sig.kids[i]
        param.takesLabel = false
        params = params.append(param)
        i = i + 1
    done = inferActuals(world = world, unit = unit, unitIndex = unitIndex, node = node, params = params, names = names, out = done, bytes = bytes)
    if sig.ret >= 0:
        done.typeId = sig.ret
        done.types = writeExprType(table = done.types, unit = unitIndex, node = node, typeId = done.typeId)
    return done

; 成员被调：接收者先定型，再按成员面分方法、内建与函数值三路；方法带标签期望。
; 别名调用不在此路 —— 别名不是值，留给降载按限定调用处理。
inferMemberCall|func(world: MemberWorld, unit: CompilationUnit, unitIndex: I32, node: I32, callee: I32, names: NameTable, out: InferResult, bytes: Array<U8>,) -> (InferResult,):
    var done = out
    let member = unit.ast.exprAt(callee)
    if len(member.kids) < 1:
        return inferActuals(world = world, unit = unit, unitIndex = unitIndex, node = node, params = [], names = names, out = done, bytes = bytes)
    let recvNode: I32 = member.kids[0]
    var receiverType = -1
    var isTypeName = false
    if unit.ast.isIdentifierExpr(recvNode):
        let recvExpr = unit.ast.exprAt(recvNode)
        let recvName = decodeRange(bytes = bytes, start = recvExpr.nameStart, end = recvExpr.nameEnd)
        if lookupNameType(table = names, name = recvName) < 0:
            let nominal = nominalTypeId(world = world, name = recvName)
            if nominal >= 0:
                receiverType = nominal
                isTypeName = true
    if receiverType < 0:
        let inner = inferNode(world = world, unit = unit, unitIndex = unitIndex, node = recvNode, names = names, pool = done.pool, types = done.types, bytes = bytes, expected = noExpectation())
        done.pool = inner.pool
        done.types = inner.types
        receiverType = inner.typeId
    if receiverType < 0:
        return inferActuals(world = world, unit = unit, unitIndex = unitIndex, node = node, params = [], names = names, out = done, bytes = bytes)
    let memberName = decodeRange(bytes = bytes, start = member.nameStart, end = member.nameEnd)
    ; `r.value()`：与读形态同一元素类型，实参不接。
    if memberName == "value" && isLazyRefType(pool = done.pool, id = receiverType):
        let element = lazyRefElement(pool = done.pool, id = receiverType)
        if element >= 0:
            done.typeId = element
            done.types = writeExprType(table = done.types, unit = unitIndex, node = node, typeId = done.typeId)
            return done
    let access = memberAccess(receiver = receiverType, name = memberName, isTypeName = isTypeName, owner = names.owner, file = unit.path, offset = member.start)
    let result = checkMember(world = probeWorld(world = world, pool = done.pool), access = access)
    done.pool = result.pool
    if result.failed || result.deferred:
        return inferActuals(world = world, unit = unit, unitIndex = unitIndex, node = node, params = [], names = names, out = done, bytes = bytes)
    if isMemberKind(kind = result.kind, expected = .memberMethod) || isMemberKind(kind = result.kind, expected = .memberOwnMethod):
        let ref = symbolDecl(world = world, symbol = result.symbol)
        if ref.unit < 0:
            return inferActuals(world = world, unit = unit, unitIndex = unitIndex, node = node, params = [], names = names, out = done, bytes = bytes)
        done = inferActuals(world = world, unit = unit, unitIndex = unitIndex, node = node, params = declParams(world = world, ref = ref), names = names, out = done, bytes = bytes)
        let ret = world.types.typeOf(unit = ref.unit, decl = ref.decl)
        if ret >= 0:
            done.typeId = ret
            done.types = writeExprType(table = done.types, unit = unitIndex, node = node, typeId = done.typeId)
        return done
    if result.typeId < 0 || result.typeId >= len(done.pool.entries):
        return inferActuals(world = world, unit = unit, unitIndex = unitIndex, node = node, params = [], names = names, out = done, bytes = bytes)
    let entry = done.pool.entries[result.typeId]
    if !isTypeClass(kind = entry.kind, expected = .typeClassFunction):
        return inferActuals(world = world, unit = unit, unitIndex = unitIndex, node = node, params = [], names = names, out = done, bytes = bytes)
    var params: Array<CallParam> = []
    var i = 0
    while i < len(entry.kids):
        var param = CallParam()
        param.typeId = entry.kids[i]
        param.takesLabel = false
        params = params.append(param)
        i = i + 1
    done = inferActuals(world = world, unit = unit, unitIndex = unitIndex, node = node, params = params, names = names, out = done, bytes = bytes)
    if entry.ret >= 0:
        done.typeId = entry.ret
        done.types = writeExprType(table = done.types, unit = unitIndex, node = node, typeId = done.typeId)
    return done

; 一元：操作数先推；`!` 答布尔，取负与按位取反都不改类型。
; 缺这一条时，以 `-1` 起头的声明没有类型，下游的数组字面量与成员读会连着落空。
inferUnary|func(world: MemberWorld, unit: CompilationUnit, unitIndex: I32, node: I32, names: NameTable, out: InferResult, bytes: Array<U8>,) -> (InferResult,):
    let operand = unit.ast.childOf(id = node, index = 0)
    let inner = inferNode(world = world, unit = unit, unitIndex = unitIndex, node = operand, names = names, pool = out.pool, types = out.types, bytes = bytes, expected = noExpectation())
    var done = out
    done.pool = inner.pool
    done.types = inner.types
    if inner.typeId < 0:
        return done
    let expr = unit.ast.exprAt(node)
    let spelling = opSymbol(expr.op)
    if spelling == "!":
        let made = boolType(done.pool)
        done.pool = made.pool
        done.typeId = made.id
    elif spelling == "&":
        ; 取址的结果是 `*T`：类型池里没有这一条，就地驻留一份；装配链把池写回。
        var kids: Array<I32> = []
        kids = kids.append(inner.typeId)
        let made = intern(pool = done.pool, kind = .typeClassPointer, name = "", kids = kids, ret = -1)
        done.pool = made.pool
        done.typeId = made.id
    else:
        done.typeId = inner.typeId
    done.types = writeExprType(table = done.types, unit = unitIndex, node = node, typeId = done.typeId)
    return done

; 二元：两侧都推得出才判；标签实参的 `=` 不是运算，运算面自然拒绝。
inferBinary|func(world: MemberWorld, unit: CompilationUnit, unitIndex: I32, node: I32, names: NameTable, out: InferResult, bytes: Array<U8>,) -> (InferResult,):
    let kids = inferKids(world = world, unit = unit, unitIndex = unitIndex, node = node, names = names, pool = out.pool, types = out.types, bytes = bytes)
    var done = out
    done.pool = kids.pool
    done.types = kids.types
    let nodeKids = unit.ast.exprAt(node).kids
    if len(nodeKids) < 2:
        return done
    let left = exprTypeAt(table = done.types, unit = unitIndex, node = nodeKids[0])
    let right = exprTypeAt(table = done.types, unit = unitIndex, node = nodeKids[1])
    if left < 0 || right < 0:
        return done
    let expr = unit.ast.exprAt(node)
    let result = checkBinary(pool = done.pool, op = opSymbol(expr.op), left = left, right = right, file = unit.path, offset = expr.start)
    done.pool = result.pool
    if result.failed:
        return done
    done.typeId = result.typeId
    done.types = writeExprType(table = done.types, unit = unitIndex, node = node, typeId = done.typeId)
    return done

; 容器字面量：元素推完后交给容器面统一元素类型；期望类型决定空字面量的元素。
inferContainer|func(world: MemberWorld, unit: CompilationUnit, unitIndex: I32, node: I32, names: NameTable, out: InferResult, bytes: Array<U8>, expected: Expectation,) -> (InferResult,):
    let kids = inferKids(world = world, unit = unit, unitIndex = unitIndex, node = node, names = names, pool = out.pool, types = out.types, bytes = bytes)
    var done = out
    done.pool = kids.pool
    done.types = kids.types
    var result = ContainerResult()
    result.pool = done.pool
    result.types = done.types
    if unit.ast.isArrayExpr(node):
        result = checkArrayLiteral(unit = unit, unitIndex = unitIndex, node = node, expectation = expected, pool = done.pool, types = done.types)
    elif unit.ast.isSetExpr(node):
        result = checkSetLiteral(unit = unit, unitIndex = unitIndex, node = node, expectation = expected, pool = done.pool, types = done.types)
    else:
        result = checkDictionaryLiteral(unit = unit, unitIndex = unitIndex, node = node, expectation = expected, pool = done.pool, types = done.types)
    done.pool = result.pool
    done.types = result.types
    if result.failed:
        return done
    done.typeId = result.typeId
    done.types = writeExprType(table = done.types, unit = unitIndex, node = node, typeId = done.typeId)
    return done

; 下标与切片：先推容器和界，类型由容器面按元素或自身给出。
inferIndex|func(world: MemberWorld, unit: CompilationUnit, unitIndex: I32, node: I32, names: NameTable, out: InferResult, bytes: Array<U8>,) -> (InferResult,):
    let kids = inferKids(world = world, unit = unit, unitIndex = unitIndex, node = node, names = names, pool = out.pool, types = out.types, bytes = bytes)
    var done = out
    done.pool = kids.pool
    done.types = kids.types
    var result = ContainerResult()
    result.pool = done.pool
    result.types = done.types
    if unit.ast.isSubscriptExpr(node):
        result = checkSubscript(unit = unit, unitIndex = unitIndex, node = node, pool = done.pool, types = done.types)
    else:
        result = checkSlice(unit = unit, unitIndex = unitIndex, node = node, pool = done.pool, types = done.types)
    done.pool = result.pool
    done.types = result.types
    if result.failed:
        return done
    done.typeId = result.typeId
    done.types = writeExprType(table = done.types, unit = unitIndex, node = node, typeId = done.typeId)
    return done

; 单元推导结果：类型表与推导后的池；判定面必须用同一个池解释下标。
(InferUnit)
types: ExprTypes = ExprTypes()
pool: TypePool = TypePool()

; 单元推导：逐函数按语句序推，再兜底扫一遍全池；表与池一起交回调用方。
; 整单元文本只转一次字节，逐节点复用；否则标识符与成员名会反复复制全文。
inferUnitExprs|func(world: MemberWorld, unitIndex: I32, types: ExprTypes,) -> (InferUnit,):
    var out = InferUnit()
    out.types = types
    out.pool = world.types.pool
    if unitIndex < 0 || unitIndex >= len(world.units):
        return out
    let unit = world.units[unitIndex]
    let bytes = unitBytes(unit)
    var state = WalkState()
    state.types = out.types
    state.pool = out.pool
    state.bytes = bytes
    let walked = walkInferDecls(world = world, unit = unit, unitIndex = unitIndex, state = state)
    out.types = walked.types
    out.pool = walked.pool
    ; 兜底扫描：语句序走不到的节点（字段初值、处理器体、函数字面量体）在这里补一次。
    ; 空表只做「由已定型处向外传播」：漏推不会拉低覆盖面，也不会把未登记名当已知。
    let spare = NameTable()
    var i = 0
    while i < unit.ast.exprCount():
        if exprTypeAt(table = out.types, unit = unitIndex, node = i) < 0:
            let one = inferNode(world = world, unit = unit, unitIndex = unitIndex, node = i, names = spare, pool = out.pool, types = out.types, bytes = bytes, expected = noExpectation())
            out.pool = one.pool
            out.types = one.types
        i = i + 1
    return out

; 全工作区推导结果：填好的类型表与累积后的池；两者的下标必须按同一份池解释。
(ExprFill)
types: ExprTypes = ExprTypes()
pool: TypePool = TypePool()

; 声明标注定型：变量声明的模式节点按标注写类型，覆盖推导期按名匹配出的近似值。
; 只在有标注时写：无标注声明的类型由初值决定，推导表里已有初值节点的类型。
; 声明节点按名推类型本就不可靠（同名局部互串），故这一步必须排在推导之后。
fillDeclaredTypes|func(world: MemberWorld, units: Array<CompilationUnit>, types: ExprTypes, pool: TypePool,) -> (ExprFill,):
    var out = ExprFill()
    out.types = types
    out.pool = pool
    var types = TypeWorld()
    types.units = world.units
    types.table = world.table
    var cursor = TypeCursor()
    cursor.world = types
    var u = 0
    while u < len(units):
        let unit = units[u]
        cursor.file = unit.path
        cursor.ast = unit.ast
        cursor.bytes = unitBytes(unit)
        var s = 0
        while s < unit.ast.stmtCount():
            if unit.ast.isVariableStmt(s):
                let stmt = unit.ast.stmtAt(s)
                let pattern = unit.ast.stmtChild(id = s, index = 0)
                var needed = stmt.typeId >= 0 && pattern >= 0 && unit.ast.isIdentifierExpr(pattern)
                if needed && exprTypeAt(table = out.types, unit = u, node = pattern) >= 0:
                    needed = false
                if needed:
                    let resolved = resolveAnnotationIn(cursor = cursor, pool = out.pool, node = stmt.typeId)
                    out.pool = resolved.pool
                    if resolved.id >= 0:
                        out.types = writeExprType(table = out.types, unit = u, node = pattern, typeId = resolved.id)
            s = s + 1
        u = u + 1
    return out

; 全工作区推导：逐单元推，后一单元基于前一单元增长后的池。
; 池增长只追加，故既有下标不变；调用方用返回的池解释表，不得用入参世界的池。
fillExprTypes|func(world: MemberWorld, units: Array<CompilationUnit>,) -> (ExprFill,):
    var out = ExprFill()
    out.types = makeExprTypes(units)
    out.pool = world.types.pool
    var u = 0
    while u < len(units):
        let one = inferUnitExprs(world = probeWorld(world = world, pool = out.pool), unitIndex = u, types = out.types)
        out.pool = one.pool
        out.types = one.types
        u = u + 1
    let declared = fillDeclaredTypes(world = world, units = units, types = out.types, pool = out.pool)
    out.types = declared.types
    out.pool = declared.pool
    return out
