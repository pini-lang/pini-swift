[foreign_type|import]
_syntax = "../../../syntax"
_module_loader = "../../../module-loader"

; 外部声明判型：白名单只有一张，位置只改 `String` 与句柄的成立条件。
; 五条边界：标量与指针白名单、`String` 只在形参位、句柄只在 C 面、回调只作形参、变参只对函数。
; 本层只看声明；调用点的回调实参、变参尾提升与 `readonly` 拒写随表达式检查接入。

; 位置：外部函数的形参、返回与外部数据符号；同一类型换个位置可能成立或不成立。
[ForeignPosition]
foreignPositionParam
foreignPositionResult
foreignPositionData

; 判型错误类别：类型三条、回调两条、标志三条，各有一枚诊断码。
[ForeignTypeErrorKind]
foreignTypeNotRepresentable
foreignTypeWidthNotInIR
foreignStringInReturn
foreignCallbackOutsideParameter
foreignCallbackBoolean
foreignVarargsOnNonFunction
foreignFlagUnknown
foreignFlagDuplicated
foreignFlagMisplaced

; 判型错误：类别、文件、源内字节偏移、符号名与理由；位置一律指向符号条目起点。
(ForeignTypeError)
kind: ForeignTypeErrorKind = .foreignTypeNotRepresentable
file: String = ""
offset: I32 = 0
name: String = ""
detail: String = ""

; 判型结果：错误表与失败标记；错误已按文件与偏移排序。
(ForeignTypeCheck)
errors: Array<ForeignTypeError> = []
failed: Bool = false

((ForeignTypeCheck))
; 可用：没有任何判型错误。
isOK|self() -> (Bool,):
    return len(self.errors) == 0
; 错误数：诊断与测试共用这一条。
errorCount|self() -> (I32,):
    return len(self.errors)
errorAt|self(_index: I32,) -> (ForeignTypeError,):
    return self.errors[_index]

; 类别名：诊断、测试与回执共用一份拼写。
foreignTypeErrorName|func(_kind: ForeignTypeErrorKind,) -> (String,):
    match _kind:
        case foreignTypeNotRepresentable:
            return "外部类型不可表示"
        case foreignTypeWidthNotInIR:
            return "外部类型宽度不在 IR"
        case foreignStringInReturn:
            return "外部返回不收 String"
        case foreignCallbackOutsideParameter:
            return "函数类型只在形参位"
        case foreignCallbackBoolean:
            return "回调签名含 Bool"
        case foreignVarargsOnNonFunction:
            return "变参只对函数成立"
        case foreignFlagUnknown:
            return "未知的外部标志"
        case foreignFlagDuplicated:
            return "外部标志重复"
        case foreignFlagMisplaced:
            return "外部标志用错位置"
    return "外部判型错误"

; 同一类别判定：枚举相等比较不可用，按名称比。
isForeignTypeError|func(error: ForeignTypeError, kind: ForeignTypeErrorKind,) -> (Bool,):
    return foreignTypeErrorName(error.kind) == foreignTypeErrorName(kind)

; 诊断码：复用宿主已登记的码，标志类沿用解析面的修饰符码。
foreignTypeErrorCode|func(_kind: ForeignTypeErrorKind,) -> (String,):
    match _kind:
        case foreignTypeNotRepresentable:
            return "E4-028"
        case foreignTypeWidthNotInIR:
            return "E4-029"
        case foreignStringInReturn:
            return "E4-030"
        case foreignCallbackOutsideParameter:
            return "E4-028"
        case foreignCallbackBoolean:
            return "E4-032"
        case foreignVarargsOnNonFunction:
            return "E4-033"
        case foreignFlagUnknown:
            return "E2-011"
        case foreignFlagDuplicated:
            return "E2-011"
        case foreignFlagMisplaced:
            return "E2-011"
    return "E4-028"

; 位置名：错误理由与测试断言共用。
foreignPositionName|func(_position: ForeignPosition,) -> (String,):
    match _position:
        case foreignPositionParam:
            return "形参"
        case foreignPositionResult:
            return "返回"
        case foreignPositionData:
            return "数据"
    return "形参"

; 位置判定：同一枚举按名称比，调用方不直接比较枚举值。
isForeignPosition|func(position: ForeignPosition, expected: ForeignPosition,) -> (Bool,):
    return foreignPositionName(position) == foreignPositionName(expected)

; 造错误：偏移取符号条目起点，理由只填一句，不拼文件名。
makeForeignTypeError|func(kind: ForeignTypeErrorKind, file: String, offset: I32, name: String, detail: String,) -> (ForeignTypeError,):
    var out = ForeignTypeError()
    out.kind = kind
    out.file = file
    out.offset = offset
    out.name = name
    out.detail = detail
    return out

; 追加错误：结果其余字段原样保留，错误不中断后续条目。
appendForeignTypeError|func(out: ForeignTypeCheck, unit: CompilationUnit, offset: I32, kind: ForeignTypeErrorKind, name: String, detail: String,) -> (ForeignTypeCheck,):
    var done = out
    done.errors = done.errors.append(makeForeignTypeError(kind = kind, file = unit.path, offset = offset, name = name, detail = detail))
    return done

; C 边界上的标量：只有 IR 有宽度的七种。
isForeignScalarName|func(_name: String,) -> (Bool,):
    if _name == "I8" || _name == "U8":
        return true
    if _name == "I32" || _name == "I64" || _name == "U64":
        return true
    return _name == "F64" || _name == "Bool"

; IR 没有对应宽度的四类：单列一条码，避免与「不是 C 标量」混同。
isWidthOutsideIR|func(_name: String,) -> (Bool,):
    if _name == "I16" || _name == "U16":
        return true
    return _name == "U32" || _name == "F32"

; 已知标志：只有这三个；白名单之外的写法在语义期报。
isKnownForeignFlag|func(_name: String,) -> (Bool,):
    if _name == "readonly" || _name == "macro":
        return true
    return _name == "varargs"

; 类别理由：不在白名单内的名字，按类别给一句可读的原因。
foreignClassReason|func(_kind: TypeClass,) -> (String,):
    if isTypeClass(kind = _kind, expected = typeClassStruct):
        return "按值结构体没有 C 布局"
    if isTypeClass(kind = _kind, expected = typeClassObject):
        return "对象受 ARC 隔离"
    if isTypeClass(kind = _kind, expected = typeClassEnum):
        return "枚举在 C 面没有稳定的标签布局"
    if isTypeClass(kind = _kind, expected = typeClassOptional):
        return "可选需要标签"
    if isTypeClass(kind = _kind, expected = typeClassResult):
        return "结果需要标签"
    if isTypeClass(kind = _kind, expected = typeClassCollection):
        return "集合没有 C 布局"
    if isTypeClass(kind = _kind, expected = typeClassGeneric):
        return "泛型实例在 C 面没有布局"
    return "不是 C 兼容标量或指针"

; 标量位：`String` 只在形参位借出，其余按白名单两分。
checkForeignScalar|func(out: ForeignTypeCheck, unit: CompilationUnit, typeName: String, position: ForeignPosition, name: String, offset: I32,) -> (ForeignTypeCheck,):
    if typeName == "String":
        if isForeignPosition(position = position, expected = foreignPositionData):
            return appendForeignTypeError(out = out, unit = unit, offset = offset, kind = foreignTypeNotRepresentable, name = name, detail = "外部数据符号只能是标量或指针")
        if isForeignPosition(position = position, expected = foreignPositionResult):
            return appendForeignTypeError(out = out, unit = unit, offset = offset, kind = foreignStringInReturn, name = name, detail = "C 返回的指针归属不明，取回用 fromCString")
        return out
    if isForeignScalarName(typeName):
        return out
    if isWidthOutsideIR(typeName):
        return appendForeignTypeError(out = out, unit = unit, offset = offset, kind = foreignTypeWidthNotInIR, name = name, detail = typeName)
    return appendForeignTypeError(out = out, unit = unit, offset = offset, kind = foreignTypeNotRepresentable, name = name, detail = typeName + " 不是 C 兼容标量")

; 指针目标：标量与指针可继续递归；`String`、句柄、元组与名义类型都不是 C 指针目标。
checkForeignPointerTarget|func(out: ForeignTypeCheck, unit: CompilationUnit, pool: TypePool, id: I32, name: String, offset: I32,) -> (ForeignTypeCheck,):
    if id < 0 || id >= len(pool.entries):
        return out
    let entry = pool.entries[id]
    if isTypeClass(kind = entry.kind, expected = typeClassScalar):
        if entry.name == "String":
            return appendForeignTypeError(out = out, unit = unit, offset = offset, kind = foreignTypeNotRepresentable, name = name, detail = "`String` 只在形参位借出，不能作 `*T` 的目标")
        if isForeignScalarName(entry.name):
            return out
        if isWidthOutsideIR(entry.name):
            return appendForeignTypeError(out = out, unit = unit, offset = offset, kind = foreignTypeWidthNotInIR, name = name, detail = entry.name)
        return appendForeignTypeError(out = out, unit = unit, offset = offset, kind = foreignTypeNotRepresentable, name = name, detail = entry.name + " 不能作 `*T` 的目标")
    if isTypeClass(kind = entry.kind, expected = typeClassOpaque):
        return appendForeignTypeError(out = out, unit = unit, offset = offset, kind = foreignTypeNotRepresentable, name = name, detail = "句柄是不透明指针，不能再套一层 `*`")
    if isTypeClass(kind = entry.kind, expected = typeClassPointer):
        if len(entry.kids) == 0:
            return out
        return checkForeignPointerTarget(out = out, unit = unit, pool = pool, id = entry.kids[0], name = name, offset = offset)
    return appendForeignTypeError(out = out, unit = unit, offset = offset, kind = foreignTypeNotRepresentable, name = name, detail = "指针目标只能是 C 标量或指针")

; 回调位：只收标量与指针；`Bool` 表示不同、`String` 与句柄没有回调侧的归属约定。
checkForeignCallbackElement|func(out: ForeignTypeCheck, unit: CompilationUnit, pool: TypePool, id: I32, positionText: String, name: String, offset: I32,) -> (ForeignTypeCheck,):
    if id < 0 || id >= len(pool.entries):
        return out
    let entry = pool.entries[id]
    if isTypeClass(kind = entry.kind, expected = typeClassScalar):
        if entry.name == "Bool":
            return appendForeignTypeError(out = out, unit = unit, offset = offset, kind = foreignCallbackBoolean, name = name, detail = positionText)
        if entry.name == "String":
            return appendForeignTypeError(out = out, unit = unit, offset = offset, kind = foreignTypeNotRepresentable, name = name, detail = "回调" + positionText + "不能写 String：C 传的是裸字节")
        if isForeignScalarName(entry.name):
            return out
        if isWidthOutsideIR(entry.name):
            return appendForeignTypeError(out = out, unit = unit, offset = offset, kind = foreignTypeWidthNotInIR, name = name, detail = entry.name)
        return appendForeignTypeError(out = out, unit = unit, offset = offset, kind = foreignTypeNotRepresentable, name = name, detail = "回调" + positionText + "只能是 C 标量或指针")
    if isTypeClass(kind = entry.kind, expected = typeClassOpaque):
        return appendForeignTypeError(out = out, unit = unit, offset = offset, kind = foreignTypeNotRepresentable, name = name, detail = "回调" + positionText + "不能出现句柄：计数要落在说定的那一侧")
    if isTypeClass(kind = entry.kind, expected = typeClassPointer):
        if len(entry.kids) == 0:
            return out
        return checkForeignPointerTarget(out = out, unit = unit, pool = pool, id = entry.kids[0], name = name, offset = offset)
    return appendForeignTypeError(out = out, unit = unit, offset = offset, kind = foreignTypeNotRepresentable, name = name, detail = "回调" + positionText + "只能是 C 标量或指针")

; 回调签名：逐个形参加至多一个返回；空返回按 `()` 处理，不算元组。
checkForeignCallback|func(out: ForeignTypeCheck, unit: CompilationUnit, pool: TypePool, entry: TypeEntry, name: String, offset: I32,) -> (ForeignTypeCheck,):
    var working = out
    var i = 0
    while i < len(entry.kids):
        working = checkForeignCallbackElement(out = working, unit = unit, pool = pool, id = entry.kids[i], positionText = "参数", name = name, offset = offset)
        i = i + 1
    if entry.ret < 0 || entry.ret >= len(pool.entries):
        return working
    let ret = pool.entries[entry.ret]
    if isTypeClass(kind = ret.kind, expected = typeClassTuple) && len(ret.kids) == 0:
        return working
    return checkForeignCallbackElement(out = working, unit = unit, pool = pool, id = entry.ret, positionText = "返回", name = name, offset = offset)

; 一个位置上的类型：白名单只此一张，位置只改 `String` 与句柄的成立条件。
checkForeignValue|func(out: ForeignTypeCheck, unit: CompilationUnit, pool: TypePool, id: I32, position: ForeignPosition, name: String, offset: I32,) -> (ForeignTypeCheck,):
    if id < 0 || id >= len(pool.entries):
        return out
    let entry = pool.entries[id]
    if isTypeClass(kind = entry.kind, expected = typeClassScalar):
        return checkForeignScalar(out = out, unit = unit, typeName = entry.name, position = position, name = name, offset = offset)
    if isTypeClass(kind = entry.kind, expected = typeClassOpaque):
        if isForeignPosition(position = position, expected = foreignPositionData):
            return appendForeignTypeError(out = out, unit = unit, offset = offset, kind = foreignTypeNotRepresentable, name = name, detail = "外部数据符号只能是标量或指针")
        return out
    if isTypeClass(kind = entry.kind, expected = typeClassPointer):
        if len(entry.kids) == 0:
            return out
        return checkForeignPointerTarget(out = out, unit = unit, pool = pool, id = entry.kids[0], name = name, offset = offset)
    if isTypeClass(kind = entry.kind, expected = typeClassFunction):
        if !isForeignPosition(position = position, expected = foreignPositionParam):
            return appendForeignTypeError(out = out, unit = unit, offset = offset, kind = foreignCallbackOutsideParameter, name = name, detail = "返回位没有可持有的一等函数指针值")
        return checkForeignCallback(out = out, unit = unit, pool = pool, entry = entry, name = name, offset = offset)
    if isTypeClass(kind = entry.kind, expected = typeClassTuple):
        if len(entry.kids) == 0 && isForeignPosition(position = position, expected = foreignPositionResult):
            return out
        return appendForeignTypeError(out = out, unit = unit, offset = offset, kind = foreignTypeNotRepresentable, name = name, detail = "元组不是 C 布局")
    return appendForeignTypeError(out = out, unit = unit, offset = offset, kind = foreignTypeNotRepresentable, name = name, detail = foreignClassReason(entry.kind))

; 标志：只认三个；未知、重复与放错位置各报一条，位置指向标志本身。
checkForeignFlags|func(out: ForeignTypeCheck, unit: CompilationUnit, symbol: DeclNode, name: String, isFunction: Bool,) -> (ForeignTypeCheck,):
    var working = out
    let bytes = tempUtf8Bytes(unit.text)
    var seen: Array<String> = []
    var i = 0
    while i < len(symbol.kids):
        let flag = unit.ast.decls[symbol.kids[i]]
        let text = decodeRange(bytes = bytes, start = flag.nameStart, end = flag.nameEnd)
        if !isKnownForeignFlag(text):
            working = appendForeignTypeError(out = working, unit = unit, offset = flag.start, kind = foreignFlagUnknown, name = text, detail = "可用的是 readonly / macro / varargs")
        elif containsFlagText(items = seen, name = text):
            working = appendForeignTypeError(out = working, unit = unit, offset = flag.start, kind = foreignFlagDuplicated, name = text, detail = name)
        else:
            seen = seen.append(text)
            if isFunction && text != "varargs":
                working = appendForeignTypeError(out = working, unit = unit, offset = flag.start, kind = foreignFlagMisplaced, name = text, detail = "`|" + text + "` 只适用于数据符号")
            if !isFunction && text == "varargs":
                working = appendForeignTypeError(out = working, unit = unit, offset = flag.start, kind = foreignVarargsOnNonFunction, name = name, detail = "数据符号没有调用点")
        i = i + 1
    return working

; 一条外部符号：先判标志，再按函数 / 数据两个面判类型；类型解析失败时只留标志错误。
checkForeignSymbol|func(out: ForeignTypeCheck, unit: CompilationUnit, unitIndex: I32, types: TypeTable, declId: I32, symbol: DeclNode,) -> (ForeignTypeCheck,):
    let bytes = tempUtf8Bytes(unit.text)
    let name = decodeRange(bytes = bytes, start = symbol.nameStart, end = symbol.nameEnd)
    var isFunction = false
    if symbol.typeId >= 0 && symbol.typeId < unit.ast.typeCount() && isFunctionTypeCode(unit.ast.types[symbol.typeId].kind):
        isFunction = true
    var working = checkForeignFlags(out = out, unit = unit, symbol = symbol, name = name, isFunction = isFunction)
    if symbol.typeId < 0:
        return working
    let typeId = types.typeOf(unit = unitIndex, decl = declId)
    if typeId < 0:
        return working
    if !isFunction:
        return checkForeignValue(out = working, unit = unit, pool = types.pool, id = typeId, position = foreignPositionData, name = name, offset = symbol.start)
    let entry = types.pool.entries[typeId]
    var i = 0
    while i < len(entry.kids):
        working = checkForeignValue(out = working, unit = unit, pool = types.pool, id = entry.kids[i], position = foreignPositionParam, name = name, offset = symbol.start)
        i = i + 1
    return checkForeignValue(out = working, unit = unit, pool = types.pool, id = entry.ret, position = foreignPositionResult, name = name, offset = symbol.start)

; 外部块：逐条判符号，块名不参与；条目顺序即错误顺序，最后统一排序。
checkForeignBlock|func(out: ForeignTypeCheck, unit: CompilationUnit, unitIndex: I32, types: TypeTable, decl: DeclNode,) -> (ForeignTypeCheck,):
    var working = out
    var i = 0
    while i < len(decl.kids):
        let symbol = unit.ast.decls[decl.kids[i]]
        if isForeignSymbolCode(symbol.kind):
            working = checkForeignSymbol(out = working, unit = unit, unitIndex = unitIndex, types = types, declId = decl.kids[i], symbol = symbol)
        i = i + 1
    return working

; 一个单元：只走顶层外部块，其余声明不归本层。
checkForeignUnit|func(out: ForeignTypeCheck, unit: CompilationUnit, unitIndex: I32, types: TypeTable,) -> (ForeignTypeCheck,):
    var working = out
    var i = 0
    while i < len(unit.ast.items):
        let decl = unit.ast.decls[unit.ast.items[i]]
        if isForeignDeclCode(decl.kind):
            working = checkForeignBlock(out = working, unit = unit, unitIndex = unitIndex, types = types, decl = decl)
        i = i + 1
    return working

; 错误次序：先按文件，再按偏移，同位置按类别名；同一输入两次得同一序列。
compareForeignTypeErrors|func(first: ForeignTypeError, second: ForeignTypeError,) -> (I32,):
    let order = compareSourcePaths(first = first.file, second = second.file)
    if order != 0:
        return order
    if first.offset < second.offset:
        return -1
    if first.offset > second.offset:
        return 1
    return compareSourcePaths(first = foreignTypeErrorName(first.kind), second = foreignTypeErrorName(second.kind))

; 排序：插入排序，错误条数按符号量级，稳定且与包图次序无关。
sortForeignTypeErrors|func(_values: Array<ForeignTypeError>,) -> (Array<ForeignTypeError>,):
    var out = _values
    var i = 1
    while i < len(out):
        let value = out[i]
        var j = i - 1
        while j >= 0 && compareForeignTypeErrors(first = out[j], second = value) > 0:
            out[j + 1] = out[j]
            j = j - 1
        out[j + 1] = value
        i = i + 1
    return out

; 判型入口：按路径排好单元，与类型面共用同一序，再逐块判。
checkForeignPackage|func(units: Array<CompilationUnit>, types: TypeTable,) -> (ForeignTypeCheck,):
    let sorted = sortedUnits(units)
    var out = ForeignTypeCheck()
    var u = 0
    while u < len(sorted):
        out = checkForeignUnit(out = out, unit = sorted[u], unitIndex = u, types = types)
        u = u + 1
    out.errors = sortForeignTypeErrors(out.errors)
    out.failed = len(out.errors) > 0
    return out
