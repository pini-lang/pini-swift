; 符号表：顶层、成员、导入别名三类分开存放；错误按注册顺序累积。
(SymbolTable)
symbols: Array<Symbol> = []
imports: Array<Symbol> = []
errors: Array<SymbolError> = []

((SymbolTable))
symbolCount|self() -> (I32,):
    return len(self.symbols)
symbolAt|self(_index: I32,) -> (Symbol,):
    return self.symbols[_index]
importCount|self() -> (I32,):
    return len(self.imports)
importAt|self(_index: I32,) -> (Symbol,):
    return self.imports[_index]
errorCount|self() -> (I32,):
    return len(self.errors)
errorAt|self(_index: I32,) -> (SymbolError,):
    return self.errors[_index]
; 无错误即注册完成；有错时符号集只作诊断用，不得继续向下游交付。
isOK|self() -> (Bool,):
    return len(self.errors) == 0
; 顶层查找：键相同且 owner 为空；找不到答 -1。
topIndex|self(_key: Array<U8>,) -> (I32,):
    var i = 0
    while i < len(self.symbols):
        let symbol = self.symbols[i]
        if len(symbol.owner) == 0 && sameKey(first = symbol.key, second = _key):
            return i
        i = i + 1
    return -1
; 文件内顶层查找：同一文件声明过的顶层名字，用于导入别名撞名判定。
fileTopIndex|self(file: String, key: Array<U8>,) -> (I32,):
    var i = 0
    while i < len(self.symbols):
        let symbol = self.symbols[i]
        if symbol.file == file && len(symbol.owner) == 0 && sameKey(first = symbol.key, second = key):
            return i
        i = i + 1
    return -1
; 成员查找：所有者名与键都相同；找不到答 -1。
memberIndex|self(owner: String, key: Array<U8>,) -> (I32,):
    var i = 0
    while i < len(self.symbols):
        let symbol = self.symbols[i]
        if symbol.owner == owner && sameKey(first = symbol.key, second = key):
            return i
        i = i + 1
    return -1
; 导入别名查找：同一文件内按键找；找不到答 -1。
importIndex|self(file: String, key: Array<U8>,) -> (I32,):
    var i = 0
    while i < len(self.imports):
        let symbol = self.imports[i]
        if symbol.file == file && sameKey(first = symbol.key, second = key):
            return i
        i = i + 1
    return -1

; 定义顶层符号：同键已存在时报重复并保留先声明者，先到者即接口。
; 判重粒度为包级，与宿主 `analyze(package:)` 一张符号表覆盖整包一致；跨包由注册入口分组隔离。
defineTop|func(table: SymbolTable, symbol: Symbol,) -> (SymbolTable,):
    var out = table
    if table.topIndex(symbol.key) >= 0:
        out.errors = out.errors.append(makeSymbolError(kind = symbolRedeclared, file = symbol.file, offset = symbol.offset, name = symbol.spelling))
        return out
    out.symbols = out.symbols.append(symbol)
    return out

; 定义外部符号：同名同型合并，异型或与本地符号撞名报错；外部符号不覆盖已有条目。
defineForeign|func(table: SymbolTable, symbol: Symbol,) -> (SymbolTable,):
    var out = table
    let at = table.topIndex(symbol.key)
    if at < 0:
        out.symbols = out.symbols.append(symbol)
        return out
    let existing = table.symbols[at]
    if !existing.isForeign:
        out.errors = out.errors.append(makeForeignError(kind = symbolForeignClash, file = symbol.file, offset = symbol.offset, name = symbol.spelling, detail = existing.file))
        return out
    if existing.foreignShape != symbol.foreignShape || !sameFlags(first = existing.foreignFlags, second = symbol.foreignFlags):
        out.errors = out.errors.append(makeForeignError(kind = symbolForeignMismatch, file = symbol.file, offset = symbol.offset, name = symbol.spelling, detail = existing.file))
        return out
    return out

; 标志表相等：长度与逐项文本都相同；两边登记时已排序，故顺序不影响判定。
sameFlags|func(first: Array<String>, second: Array<String>,) -> (Bool,):
    if len(first) != len(second):
        return false
    var i = 0
    while i < len(first):
        if first[i] != second[i]:
            return false
        i = i + 1
    return true

; 定义成员符号：同一所有者下同键即报成员同名，保留先声明者。
defineMember|func(table: SymbolTable, symbol: Symbol,) -> (SymbolTable,):
    var out = table
    if table.memberIndex(owner = symbol.owner, key = symbol.key) >= 0:
        out.errors = out.errors.append(makeSymbolError(kind = symbolMemberDuplicated, file = symbol.file, offset = symbol.offset, name = symbol.spelling))
        return out
    out.symbols = out.symbols.append(symbol)
    return out

; 覆盖成员：扩展块之间的同名按「后声明者覆盖」，替换原位而不追加。
redefineMember|func(table: SymbolTable, symbol: Symbol,) -> (SymbolTable,):
    let at = table.memberIndex(owner = symbol.owner, key = symbol.key)
    if at < 0:
        var out = table
        out.symbols = out.symbols.append(symbol)
        return out
    var out = table
    out.symbols[at] = symbol
    return out

; 加入一条错误：注册流程发现块内重复时走这里，不改变符号集。
addError|func(table: SymbolTable, error: SymbolError,) -> (SymbolTable,):
    var out = table
    out.errors = out.errors.append(error)
    return out

; 定义导入别名：同文件重复别名报错，与本文件顶层名字相撞同样报错。
defineImport|func(table: SymbolTable, symbol: Symbol,) -> (SymbolTable,):
    var out = table
    if table.importIndex(file = symbol.file, key = symbol.key) >= 0:
        out.errors = out.errors.append(makeSymbolError(kind = symbolImportAmbiguous, file = symbol.file, offset = symbol.offset, name = symbol.spelling))
        return out
    if table.fileTopIndex(file = symbol.file, key = symbol.key) >= 0:
        out.errors = out.errors.append(makeSymbolError(kind = symbolImportAmbiguous, file = symbol.file, offset = symbol.offset, name = symbol.spelling))
        return out
    out.imports = out.imports.append(symbol)
    return out
