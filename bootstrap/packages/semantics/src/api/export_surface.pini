[export_surface|import]
_support = "../../../support"
_syntax = "../../../syntax"
_module_loader = "../../../module-loader"

; 导出面：`[文件|export]` 里 `|c` 条目的静态判据。
; 只认本模块的自由函数与给定块；名字转写后不得撞车、不得落进 C 保留区。
; 类型能否跨边界在这一层定死，降载层只按同一张表求拼写，不再改判。

; 导出错误类别：目标形态、名字形态、重复面与类型准入各成一类。
[ExportErrorKind]
exportTargetUnknown
exportSurfaceDuplicated
exportNameCollision
exportNameShape
exportLifecycleCollision
exportForeignCollision
exportFormForbidden
exportTypeRejected

; 导出错误：类别、文件、偏移、相关名字与一句细节。
(ExportError)
kind: ExportErrorKind = .exportTargetUnknown
file: String = ""
offset: I32 = 0
name: String = ""
detail: String = ""

; 导出检查结果：错误表与失败标记；错误按文件与偏移排好。
(ExportCheck)
errors: Array<ExportError> = []
failed: Bool = false

; 标注出现的位置：三处成立条件不同，混用一处就会放行错形状。
[CExportPosition]
cExportParam
cExportResult
cExportField

; 类别名：诊断、测试与回执共用一份拼写。
exportErrorName|func(_kind: ExportErrorKind,) -> (String,):
    match _kind:
        case exportTargetUnknown:
            return "导出目标不可发布"
        case exportSurfaceDuplicated:
            return "C 面重复"
        case exportNameCollision:
            return "C 名重复"
        case exportNameShape:
            return "C 名形态非法"
        case exportLifecycleCollision:
            return "与生命周期符号同名"
        case exportForeignCollision:
            return "与外部符号同名"
        case exportFormForbidden:
            return "函数形态不进 C 面"
        case exportTypeRejected:
            return "类型不能跨越 C 边界"
    return "导出错误"

; 同一类别判定：枚举相等比较不可用，按名称比。
isExportError|func(error: ExportError, kind: ExportErrorKind,) -> (Bool,):
    return exportErrorName(error.kind) == exportErrorName(kind)

; 诊断码：沿用宿主已登记的导出面码，类别靠错误自身区分。
exportErrorCode|func(_kind: ExportErrorKind,) -> (String,):
    return "E4-026"

; 造错误：位置取条目或声明的起点。
makeExportError|func(kind: ExportErrorKind, file: String, offset: I32, name: String, detail: String,) -> (ExportError,):
    var out = ExportError()
    out.kind = kind
    out.file = file
    out.offset = offset
    out.name = name
    out.detail = detail
    return out

; 追加错误：其余字段原样保留。
appendExportError|func(out: ExportCheck, unit: CompilationUnit, offset: I32, kind: ExportErrorKind, name: String, detail: String,) -> (ExportCheck,):
    var done = out
    done.errors = done.errors.append(makeExportError(kind = kind, file = unit.path, offset = offset, name = name, detail = detail))
    return done

; 错误次序：先按文件字节序，再按偏移，最后按类别名。
compareExportErrors|func(first: ExportError, second: ExportError,) -> (I32,):
    let order = compareSourcePaths(first = first.file, second = second.file)
    if order != 0:
        return order
    if first.offset < second.offset:
        return -1
    if first.offset > second.offset:
        return 1
    return compareSourcePaths(first = exportErrorName(first.kind), second = exportErrorName(second.kind))

; 取前段：左闭右开。
takeExportErrors|func(values: Array<ExportError>, from: I32, to: I32,) -> (Array<ExportError>,):
    var out: Array<ExportError> = []
    var i = from
    while i < to && i < len(values):
        out = out.append(values[i])
        i = i + 1
    return out

; 归并：两段各自有序，合并后整段有序。
mergeExportErrors|func(left: Array<ExportError>, right: Array<ExportError>,) -> (Array<ExportError>,):
    var out: Array<ExportError> = []
    var i = 0
    var j = 0
    while i < len(left) && j < len(right):
        if compareExportErrors(first = left[i], second = right[j]) <= 0:
            out = out.append(left[i])
            i = i + 1
        else:
            out = out.append(right[j])
            j = j + 1
    while i < len(left):
        out = out.append(left[i])
        i = i + 1
    while j < len(right):
        out = out.append(right[j])
        j = j + 1
    return out

; 排序：稳定归并，同一输入两次得同一序列。
sortExportErrors|func(_values: Array<ExportError>,) -> (Array<ExportError>,):
    if len(_values) <= 1:
        return _values
    let mid = len(_values) / 2
    let left = sortExportErrors(takeExportErrors(values = _values, from = 0, to = mid))
    let right = sortExportErrors(takeExportErrors(values = _values, from = mid, to = len(_values)))
    return mergeExportErrors(left = left, right = right)

; C 兼容标量：与指针目标、外部符号共用同一张名单。
isCExportScalar|func(_name: String,) -> (Bool,):
    if _name == "I8":
        return true
    if _name == "U8":
        return true
    if _name == "I32":
        return true
    if _name == "I64":
        return true
    if _name == "U64":
        return true
    if _name == "F64":
        return true
    return _name == "Bool"

; 标注的名字：非具名类型答空串。
typeNameOf|func(unit: CompilationUnit, bytes: Array<U8>, typeId: I32,) -> (String,):
    if typeId < 0:
        return ""
    let node = unit.ast.types[typeId]
    if !isNamedTypeCode(node.kind):
        return ""
    return decodeRange(bytes = bytes, start = node.nameStart, end = node.nameEnd)

; 标注形态名：诊断里指明是哪一类写法。
typeShapeName|func(typeId: I32, unit: CompilationUnit,) -> (String,):
    if typeId < 0:
        return "无标注"
    let node = unit.ast.types[typeId]
    if isNamedTypeCode(node.kind):
        return "具名类型"
    if isGenericTypeCode(node.kind):
        return "泛型类型"
    if isOptionalTypeCode(node.kind):
        return "可选类型"
    if isPointerTypeCode(node.kind):
        return "指针类型"
    if isTupleTypeCode(node.kind):
        return "元组类型"
    if isFunctionTypeCode(node.kind):
        return "函数类型"
    if isResultTypeCode(node.kind):
        return "结果类型"
    if isArrayTypeCode(node.kind):
        return "数组类型"
    if isSetTypeCode(node.kind):
        return "集合类型"
    if isDictionaryTypeCode(node.kind):
        return "字典类型"
    return "未知标注"

; 回调元素：参数与返回都只收标量与标量指针；Bool 单列一条，i1 与 _Bool 约定不同。
callbackElementRejection|func(unit: CompilationUnit, bytes: Array<U8>, typeId: I32,) -> (String,):
    if typeId < 0:
        return ""
    let node = unit.ast.types[typeId]
    if isNamedTypeCode(node.kind):
        let name = decodeRange(bytes = bytes, start = node.nameStart, end = node.nameEnd)
        if name == "Bool":
            return "不能是 Bool：`i1` 与 `_Bool` 的约定不同，改用 I32"
        if isCExportScalar(name):
            return ""
        return "`" + name + "` 不是 C 兼容标量"
    if isPointerTypeCode(node.kind):
        if len(node.kids) == 0:
            return "指针缺元素类型"
        let element = typeNameOf(unit = unit, bytes = bytes, typeId = node.kids[0])
        if isCExportScalar(element):
            return ""
        return "指针目标不是 C 标量"
    return "`" + typeShapeName(typeId = typeId, unit = unit) + "` 不是 C 标量或指针"

; 一种标注能否写成 C 类型：空串表示可以，否则给一句原因。
; 位置是判据的一部分：`String` 只在形参位成立，`^T` 只在返回位成立。
cExportRejection|func(unit: CompilationUnit, bytes: Array<U8>, typeId: I32, position: CExportPosition,) -> (String,):
    if typeId < 0:
        return ""
    let node = unit.ast.types[typeId]
    if isNamedTypeCode(node.kind):
        let name = decodeRange(bytes = bytes, start = node.nameStart, end = node.nameEnd)
        if name == "StringHandle":
            if isCExportPosition(position = position, expected = .cExportField):
                return "`StringHandle` 不作给定块字段：字段区是进程级存储，句柄的计数无从落账"
            return ""
        if name == "String":
            if isCExportPosition(position = position, expected = .cExportParam):
                return ""
            return "`String` 只在导出函数的形参位成立，C 侧是借出的 `const char*`"
        if isCExportScalar(name):
            return ""
        return "`" + name + "` 不是 C 兼容标量"
    if isPointerTypeCode(node.kind):
        if len(node.kids) == 0:
            return "指针缺元素类型"
        let element = typeNameOf(unit = unit, bytes = bytes, typeId = node.kids[0])
        if isCExportScalar(element):
            return ""
        return "指针目标不是 C 标量；导出头文件只写得出标量指针"
    if isResultTypeCode(node.kind):
        if !isCExportPosition(position = position, expected = .cExportResult):
            return "`^T` 只能作返回类型"
        if len(node.kids) == 0:
            return "`^T` 缺载荷类型"
        let payload = typeNameOf(unit = unit, bytes = bytes, typeId = node.kids[0])
        if isCExportScalar(payload):
            return ""
        return "`^T` 的载荷须是 C 兼容标量"
    if isTupleTypeCode(node.kind):
        if len(node.kids) == 0:
            return ""
        return "元组不可跨越 C 边界"
    if isFunctionTypeCode(node.kind):
        if !isCExportPosition(position = position, expected = .cExportParam):
            return "函数类型只作导出函数的形参：返回位没有可承载它的 C 形状"
        var i = 0
        while i < len(node.kids):
            let why = callbackElementRejection(unit = unit, bytes = bytes, typeId = node.kids[i])
            if len(why) > 0:
                return "回调第 " + countText(i + 1) + " 个参数" + why
            i = i + 1
        let retWhy = callbackElementRejection(unit = unit, bytes = bytes, typeId = node.ret)
        if len(retWhy) > 0:
            return "回调返回" + retWhy
        return ""
    if isGenericTypeCode(node.kind):
        let name = typeNameOf(unit = unit, bytes = bytes, typeId = typeId)
        if len(name) == 0:
            return "泛型类型不可跨越 C 边界"
        return "`" + name + "` 不可跨越 C 边界"
    return "`" + typeShapeName(typeId = typeId, unit = unit) + "` 不可跨越 C 边界"

; 位置判定：枚举相等比较不可用，按名称比。
isCExportPosition|func(position: CExportPosition, expected: CExportPosition,) -> (Bool,):
    return cExportPositionName(position = position) == cExportPositionName(position = expected)

; 位置名：判据内部用，不进诊断。
cExportPositionName|func(position: CExportPosition,) -> (String,):
    match position:
        case cExportParam:
            return "param"
        case cExportResult:
            return "result"
        case cExportField:
            return "field"
    return "param"

; 名字形态：与转义同形、落进保留区、转写后首字符非法，三条都拒。
checkExportNameShape|func(unit: CompilationUnit, offset: I32, name: String, out: ExportCheck,) -> (ExportCheck,):
    var done = out
    if cNameCollidesWithEscape(name):
        done = appendExportError(out = done, unit = unit, offset = offset, kind = .exportNameShape, name = name, detail = "含与转义输出同形的 `_u` 加 6 位十六进制")
        return done
    let escaped = cNameEscape(name)
    if !cNameIsIdentifier(escaped):
        done = appendExportError(out = done, unit = unit, offset = offset, kind = .exportNameShape, name = name, detail = "转写后是 `" + escaped + "`，不是合法 C 标识符")
        return done
    if cNameIsReserved(escaped):
        done = appendExportError(out = done, unit = unit, offset = offset, kind = .exportNameShape, name = name, detail = "转写后是 `" + escaped + "`，落在 C 保留区")
    return done

; 已见 C 名判定：逐条比字符串。
hasCName|func(seen: Array<String>, name: String,) -> (Bool,):
    var i = 0
    while i < len(seen):
        if seen[i] == name:
            return true
        i = i + 1
    return false

; 外部符号占用：同名即撞，发布它会定义同一个符号。
foreignNameTaken|func(world: MemberWorld, name: String,) -> (Bool,):
    var i = 0
    while i < world.table.symbolCount():
        let symbol = world.table.symbolAt(i)
        if symbol.isForeign && symbol.spelling == name:
            return true
        i = i + 1
    return false

; 函数项判据：本模块自由函数、无泛型、非异步、非 main / |test，形参与返回都能写成 C 类型。
checkExportFunction|func(unit: CompilationUnit, bytes: Array<U8>, decl: DeclNode, name: String, out: ExportCheck,) -> (ExportCheck,):
    var done = out
    let offset = decl.start
    if name == "main":
        done = appendExportError(out = done, unit = unit, offset = offset, kind = .exportFormForbidden, name = name, detail = "`main` 是程序入口，不进 C 面")
    if decl.isTest:
        done = appendExportError(out = done, unit = unit, offset = offset, kind = .exportFormForbidden, name = name, detail = "`|test` 函数不进 C 面")
    if len(decl.generic) > 0:
        done = appendExportError(out = done, unit = unit, offset = offset, kind = .exportFormForbidden, name = name, detail = "泛型函数不进 C 面")
    if decl.isAsync:
        done = appendExportError(out = done, unit = unit, offset = offset, kind = .exportFormForbidden, name = name, detail = "异步函数不进 C 面")
    if decl.typeId >= 0:
        let ret = unit.ast.types[decl.typeId]
        if isTupleTypeCode(ret.kind) && len(ret.kids) > 1:
            done = appendExportError(out = done, unit = unit, offset = offset, kind = .exportFormForbidden, name = name, detail = "多返回值不跨 C 边界：" + countText(len(ret.kids)) + " 个返回位")
    var i = 0
    while i < len(decl.kids):
        let param = unit.ast.decls[decl.kids[i]]
        if isParamDeclCode(param.kind) && !param.isUsing:
            if param.typeId < 0:
                let paramName = decodeRange(bytes = bytes, start = param.nameStart, end = param.nameEnd)
                done = appendExportError(out = done, unit = unit, offset = offset, kind = .exportTypeRejected, name = name, detail = "形参 `" + paramName + "` 缺类型标注，无法写出 C 原型")
            else:
                let why = cExportRejection(unit = unit, bytes = bytes, typeId = param.typeId, position = .cExportParam)
                if len(why) > 0:
                    let paramName = decodeRange(bytes = bytes, start = param.nameStart, end = param.nameEnd)
                    done = appendExportError(out = done, unit = unit, offset = offset, kind = .exportTypeRejected, name = name, detail = "形参 `" + paramName + "`：" + why)
        i = i + 1
    if decl.typeId >= 0:
        let why = cExportRejection(unit = unit, bytes = bytes, typeId = decl.typeId, position = .cExportResult)
        if len(why) > 0:
            done = appendExportError(out = done, unit = unit, offset = offset, kind = .exportTypeRejected, name = name, detail = "返回位：" + why)
    return done

; 给定块项判据：字段非空、非泛型，字段名与类型全部合格；有一个不合格即整块拒。
checkExportGiven|func(unit: CompilationUnit, bytes: Array<U8>, decl: DeclNode, name: String, out: ExportCheck,) -> (ExportCheck,):
    var done = out
    let offset = decl.start
    if len(decl.kids) == 0:
        done = appendExportError(out = done, unit = unit, offset = offset, kind = .exportFormForbidden, name = name, detail = "给定块没有字段，C 结构体无成员")
    if len(decl.generic) > 0:
        done = appendExportError(out = done, unit = unit, offset = offset, kind = .exportFormForbidden, name = name, detail = "泛型给定块要按实参特化，当前不进 C 面")
    var seen: Array<String> = []
    var i = 0
    while i < len(decl.kids):
        let field = unit.ast.decls[decl.kids[i]]
        if isFieldDeclCode(field.kind):
            let fieldName = decodeRange(bytes = bytes, start = field.nameStart, end = field.nameEnd)
            done = checkExportNameShape(unit = unit, offset = offset, name = fieldName, out = done)
            let escaped = cNameEscape(fieldName)
            if hasCName(seen = seen, name = escaped):
                done = appendExportError(out = done, unit = unit, offset = offset, kind = .exportNameCollision, name = fieldName, detail = "字段转写后同为 `" + escaped + "`")
            seen = seen.append(escaped)
            let why = cExportRejection(unit = unit, bytes = bytes, typeId = field.typeId, position = .cExportField)
            if len(why) > 0:
                done = appendExportError(out = done, unit = unit, offset = offset, kind = .exportTypeRejected, name = name, detail = "字段 `" + name + "." + fieldName + "`：" + why)
        i = i + 1
    return done

; 目标项分派：先按符号找声明，自由函数与给定块各走一条判据，其余给出能落地的下一步。
checkExportTarget|func(unit: CompilationUnit, bytes: Array<U8>, world: MemberWorld, offset: I32, symbolName: String, out: ExportCheck,) -> (ExportCheck,):
    var done = out
    let symbolAt = lookupTop(index = world.symbols, key = keyOfText(symbolName))
    if symbolAt < 0:
        return appendExportError(out = done, unit = unit, offset = offset, kind = .exportTargetUnknown, name = symbolName, detail = "未声明为函数或给定块")
    let symbol = world.table.symbolAt(symbolAt)
    let ref = lookupDecl(index = world.decls, file = symbol.file, offset = symbol.offset)
    if ref.unit < 0 || ref.decl < 0:
        return appendExportError(out = done, unit = unit, offset = offset, kind = .exportTargetUnknown, name = symbolName, detail = "声明定位失败")
    let target = world.units[ref.unit].ast.decls[ref.decl]
    let targetBytes = unitBytes(world.units[ref.unit])
    if isFunctionDeclCode(target.kind):
        return checkExportFunction(unit = world.units[ref.unit], bytes = targetBytes, decl = target, name = symbolName, out = done)
    if isGivenDeclCode(target.kind):
        return checkExportGiven(unit = world.units[ref.unit], bytes = targetBytes, decl = target, name = symbolName, out = done)
    let detail = "它是" + symbolKindName(symbol.kind) + "；C 面只收自由函数与给定块"
    return appendExportError(out = done, unit = unit, offset = offset, kind = .exportTargetUnknown, name = symbolName, detail = detail)

; 条目：右端名字取标识符节点，`|c` 目标只认字面 `c`。
checkExportEntry|func(unit: CompilationUnit, bytes: Array<U8>, world: MemberWorld, entry: DeclNode, blockCName: String, out: ExportCheck,) -> (ExportCheck,):
    var done = out
    let cName = decodeRange(bytes = bytes, start = entry.nameStart, end = entry.nameEnd)
    let offset = entry.start
    if cName == blockCName + "_init" || cName == blockCName + "_shutdown":
        done = appendExportError(out = done, unit = unit, offset = offset, kind = .exportLifecycleCollision, name = cName, detail = "与生成的生命周期符号同名，换一个名字")
    done = checkExportNameShape(unit = unit, offset = offset, name = cName, out = done)
    var symbolName = ""
    if len(entry.kids) > 0:
        let target = unit.ast.exprAt(entry.kids[0])
        symbolName = decodeRange(bytes = bytes, start = target.nameStart, end = target.nameEnd)
    if foreignNameTaken(world = world, name = symbolName):
        done = appendExportError(out = done, unit = unit, offset = offset, kind = .exportForeignCollision, name = symbolName, detail = "已被导入的外部符号占用，发布它会定义同一个符号")
    if len(symbolName) == 0:
        return done
    return checkExportTarget(unit = unit, bytes = bytes, world = world, offset = offset, symbolName = symbolName, out = done)

; 导出块：先挑出 `|c` 条目，再逐条判；块名转写后同时是生命周期符号的前缀。
checkExportBlock|func(unit: CompilationUnit, bytes: Array<U8>, world: MemberWorld, decl: DeclNode, firstSurface: String, out: ExportCheck,) -> (ExportCheck,):
    var done = out
    var entries: Array<I32> = []
    var i = 0
    while i < len(decl.kids):
        let entry = unit.ast.decls[decl.kids[i]]
        if isExportEntryCode(entry.kind) && len(entry.kids) > 1:
            let target = unit.ast.decls[entry.kids[1]]
            if isExportTargetCode(target.kind):
                let text = decodeRange(bytes = bytes, start = target.nameStart, end = target.nameEnd)
                if text == "c":
                    entries = entries.append(decl.kids[i])
        i = i + 1
    if len(entries) == 0:
        return done
    let blockName = decodeRange(bytes = bytes, start = decl.nameStart, end = decl.nameEnd)
    if len(firstSurface) > 0:
        done = appendExportError(out = done, unit = unit, offset = decl.start, kind = .exportSurfaceDuplicated, name = blockName, detail = "`" + firstSurface + "` 与 `" + unit.path + "` 都带 `|c` 条目；一个模块只出一个 C 面")
    done = checkExportNameShape(unit = unit, offset = decl.start, name = blockName, out = done)
    let blockCName = cNameEscape(blockName)
    var seen: Array<String> = []
    var k = 0
    while k < len(entries):
        let entry = unit.ast.decls[entries[k]]
        let cName = decodeRange(bytes = bytes, start = entry.nameStart, end = entry.nameEnd)
        let escaped = cNameEscape(cName)
        if hasCName(seen = seen, name = escaped):
            done = appendExportError(out = done, unit = unit, offset = entry.start, kind = .exportNameCollision, name = cName, detail = "转写后同为 C 名 `" + escaped + "`")
        seen = seen.append(escaped)
        done = checkExportEntry(unit = unit, bytes = bytes, world = world, entry = entry, blockCName = blockCName, out = done)
        k = k + 1
    return done

; 对账入口：逐单元扫导出块；C 面文件至多一个，第二个起报重复。
checkExportSurface|func(world: MemberWorld,) -> (ExportCheck,):
    var out = ExportCheck()
    var firstSurface = ""
    var u = 0
    while u < len(world.units):
        let unit = world.units[u]
        let bytes = unitBytes(unit)
        var i = 0
        while i < len(unit.ast.items):
            let decl = unit.ast.decls[unit.ast.items[i]]
            if isExportBlockCode(decl.kind) && hasCSurface(unit = unit, bytes = bytes, decl = decl):
                out = checkExportBlock(unit = unit, bytes = bytes, world = world, decl = decl, firstSurface = firstSurface, out = out)
                if len(firstSurface) == 0:
                    firstSurface = unit.path
            i = i + 1
        u = u + 1
    out.errors = sortExportErrors(out.errors)
    out.failed = len(out.errors) > 0
    return out

; 该块是否带 `|c` 条目：第一次登记 C 面文件时用，避免把纯 `|pini` 块算进去。
hasCSurface|func(unit: CompilationUnit, bytes: Array<U8>, decl: DeclNode,) -> (Bool,):
    var i = 0
    while i < len(decl.kids):
        let entry = unit.ast.decls[decl.kids[i]]
        if isExportEntryCode(entry.kind) && len(entry.kids) > 1:
            let target = unit.ast.decls[entry.kids[1]]
            if isExportTargetCode(target.kind):
                let text = decodeRange(bytes = bytes, start = target.nameStart, end = target.nameEnd)
                if text == "c":
                    return true
        i = i + 1
    return false
