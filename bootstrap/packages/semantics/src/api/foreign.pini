[foreign|import]
_syntax = "../../../syntax"
_module_loader = "../../../module-loader"

; 外部符号签名：类型节点折成规范文本，同名合并与异型判定共用一份拼写；不认识的形状答问号。
foreignShape|func(ast: Ast, bytes: Array<U8>, typeId: I32,) -> (String,):
    if typeId < 0:
        return "?"
    let node = ast.types[typeId]
    if isNamedTypeCode(node.kind):
        return decodeRange(bytes = bytes, start = node.nameStart, end = node.nameEnd)
    if isPointerTypeCode(node.kind):
        if len(node.kids) == 1:
            return "*" + foreignShape(ast = ast, bytes = bytes, typeId = node.kids[0])
        return "?"
    if isTupleTypeCode(node.kind):
        return "(" + foreignShapeList(ast = ast, bytes = bytes, ids = node.kids) + ")"
    if isFunctionTypeCode(node.kind):
        let params = foreignShapeList(ast = ast, bytes = bytes, ids = node.kids)
        let returns = foreignShapeList(ast = ast, bytes = bytes, ids = [node.ret])
        return "(" + params + ") -> (" + returns + ")"
    return "?"

; 形参或返回列表：按声明序逗号连接，空表答空串。
foreignShapeList|func(ast: Ast, bytes: Array<U8>, ids: Array<I32>,) -> (String,):
    var text = ""
    var i = 0
    while i < len(ids):
        if i > 0:
            text = text + ","
        text = text + foreignShape(ast = ast, bytes = bytes, typeId = ids[i])
        i = i + 1
    return text

; 标志文本：按源序解码后排序，`readonly|macro` 与 `macro|readonly` 视为同一组。
foreignFlagTexts|func(ast: Ast, bytes: Array<U8>, decl: DeclNode,) -> (Array<String>,):
    var out: Array<String> = []
    var i = 0
    while i < len(decl.kids):
        let flag = ast.decls[decl.kids[i]]
        out = out.append(decodeRange(bytes = bytes, start = flag.nameStart, end = flag.nameEnd))
        i = i + 1
    return sortedFlagTexts(out)

; 标志排序：插入排序，ASCII 标志的字节序与声明序无关。
sortedFlagTexts|func(_items: Array<String>,) -> (Array<String>,):
    var out = _items
    var i = 1
    while i < len(out):
        let value = out[i]
        var j = i - 1
        while j >= 0 && compareFlagText(a = out[j], b = value) > 0:
            out[j + 1] = out[j]
            j = j - 1
        out[j + 1] = value
        i = i + 1
    return out

; 字节序比较：先比公共前缀，再比长度；返回 -1 / 0 / 1。
compareFlagText|func(a: String, b: String,) -> (I32,):
    let left = tempUtf8Bytes(a)
    let right = tempUtf8Bytes(b)
    var i = 0
    while i < len(left) && i < len(right):
        let x = tempByteToInt(left[i])
        let y = tempByteToInt(right[i])
        if x < y:
            return -1
        if x > y:
            return 1
        i = i + 1
    if len(left) < len(right):
        return -1
    if len(left) > len(right):
        return 1
    return 0

; C 标识符：ASCII 字母或下划线起头，后续可为数字；名字就是外部符号名，不做转义。
isCIdentifier|func(_name: String,) -> (Bool,):
    let bytes = tempUtf8Bytes(_name)
    if len(bytes) == 0:
        return false
    var i = 0
    while i < len(bytes):
        if !isCIdentByte(code = tempByteToInt(bytes[i]), head = i == 0):
            return false
        i = i + 1
    return true

isCIdentByte|func(code: I32, head: Bool,) -> (Bool,):
    if code >= 65 && code <= 90:
        return true
    if code >= 97 && code <= 122:
        return true
    if code == 95:
        return true
    if head:
        return false
    return code >= 48 && code <= 57

; 造外部符号：可见性固定包级，签名与标志随符号走；kind 由条目形状定，函数与数据分开。
makeForeignSymbol|func(unit: CompilationUnit, bytes: Array<U8>, decl: DeclNode, kind: SymbolKind,) -> (Symbol,):
    var out = makeSymbol(unit = unit, bytes = bytes, decl = decl, kind = kind)
    out.isForeign = true
    out.visibility = visibilityPackage
    out.foreignShape = foreignShape(ast = unit.ast, bytes = bytes, typeId = decl.typeId)
    out.foreignFlags = foreignFlagTexts(ast = unit.ast, bytes = bytes, decl = decl)
    return out

; 外部块：逐条登记，块名只是标签；条目名须是 C 标识符，同名同型合并、异型报错。
registerForeign|func(table: SymbolTable, unit: CompilationUnit, bytes: Array<U8>, decl: DeclNode,) -> (SymbolTable,):
    var out = table
    var i = 0
    while i < len(decl.kids):
        let entry = unit.ast.decls[decl.kids[i]]
        if isForeignSymbolCode(entry.kind) && entry.typeId >= 0:
            let name = decodeRange(bytes = bytes, start = entry.nameStart, end = entry.nameEnd)
            if !isCIdentifier(name):
                out = addError(table = out, error = makeSymbolError(kind = symbolForeignName, file = unit.path, offset = entry.start, name = name))
            else:
                var kind = symbolVariable
                if isFunctionTypeCode(unit.ast.types[entry.typeId].kind):
                    kind = symbolFunction
                out = defineForeign(table = out, symbol = makeForeignSymbol(unit = unit, bytes = bytes, decl = entry, kind = kind))
        i = i + 1
    return out
