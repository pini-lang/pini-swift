; 内建签名表：`String`、`Array`、`Dictionary` 的成员面与全部内建函数，全语言唯一来源。
; 形状描述形参与返回落在哪类类型上；占位按接收者实参回填，Any 表示不限（调用侧跳过比对）。
; 指针、并发与 `ok`/`err` 构造器走专属路径，不在本表。

; 形状：固定标量、容器、可选、元组、结果与指针各一类；Any 只用于形参。
[BuiltinShape]
builtinAny
builtinVoid
builtinString
builtinBool
builtinI32
builtinChar
builtinU8
builtinF64
builtinOptionalChar
builtinOptionalI32
builtinSameElem
builtinOptionalElem
builtinArrayElem
builtinArrayChar
builtinArrayString
builtinArrayU8
builtinPopTuple
builtinDictKey
builtinDictValue
builtinOptionalValue
builtinResultString
builtinResultVoid
builtinPointerU8

; 内建形参：名字服务标签与诊断，形状决定类型；sized 表示实参须是可取长的类型。
(BuiltinParam)
name: String = ""
shape: BuiltinShape = .builtinAny
sized: Bool = false

; 内建成员：所有者、成员名、形参与返回形状。
(BuiltinMember)
owner: String = ""
name: String = ""
params: Array<BuiltinParam> = []
ret: BuiltinShape = .builtinString

; 内建函数：名字、形参、返回与是否变参。
(BuiltinFunction)
name: String = ""
params: Array<BuiltinParam> = []
ret: BuiltinShape = .builtinVoid
variadic: Bool = false

; 形状名：诊断、测试与回执共用一份拼写。
builtinShapeName|func(shape: BuiltinShape,) -> (String,):
    match shape:
        case builtinAny:
            return "不限"
        case builtinVoid:
            return "空元组"
        case builtinString:
            return "字符串"
        case builtinBool:
            return "布尔"
        case builtinI32:
            return "整数"
        case builtinChar:
            return "字符"
        case builtinU8:
            return "字节"
        case builtinF64:
            return "浮点"
        case builtinOptionalChar:
            return "字符可选"
        case builtinOptionalI32:
            return "整数可选"
        case builtinSameElem:
            return "元素本身"
        case builtinOptionalElem:
            return "元素可选"
        case builtinArrayElem:
            return "元素数组"
        case builtinArrayChar:
            return "字符数组"
        case builtinArrayString:
            return "字符串数组"
        case builtinArrayU8:
            return "字节数组"
        case builtinPopTuple:
            return "数组弹出元组"
        case builtinDictKey:
            return "字典键"
        case builtinDictValue:
            return "字典值"
        case builtinOptionalValue:
            return "字典值可选"
        case builtinResultString:
            return "字符串结果"
        case builtinResultVoid:
            return "空结果"
        case builtinPointerU8:
            return "字节指针"
    return "未知形状"

; 同一形状判定：枚举相等比较不可用，按名称比。
isBuiltinShape|func(shape: BuiltinShape, expected: BuiltinShape,) -> (Bool,):
    return builtinShapeName(shape) == builtinShapeName(expected)

; 造形参：名字与形状两件套。
makeParam|func(name: String, shape: BuiltinShape,) -> (BuiltinParam,):
    var out = BuiltinParam()
    out.name = name
    out.shape = shape
    return out

; 无形参：空表留给无参成员与无参函数。
noParams|func() -> (Array<BuiltinParam>,):
    var out: Array<BuiltinParam> = []
    return out

; 单形参。
oneParam|func(name: String, shape: BuiltinShape,) -> (Array<BuiltinParam>,):
    var out: Array<BuiltinParam> = []
    out = out.append(makeParam(name, shape))
    return out

; 有长度形参：具体类型由实参决定，调用侧只要求可取长。
makeSizedParam|func(name: String,) -> (BuiltinParam,):
    var out = BuiltinParam()
    out.name = name
    out.sized = true
    return out

; 单形参（带长度约束）：`len` 与将来的同类内建共用。
oneSizedParam|func(name: String,) -> (Array<BuiltinParam>,):
    var out: Array<BuiltinParam> = []
    out = out.append(makeSizedParam(name))
    return out

; 双形参。
twoParams|func(first: String, firstShape: BuiltinShape, second: String, secondShape: BuiltinShape,) -> (Array<BuiltinParam>,):
    var out: Array<BuiltinParam> = []
    out = out.append(makeParam(first, firstShape))
    out = out.append(makeParam(second, secondShape))
    return out

; 造成员：所有者、名字、形参与返回形状。
makeBuiltin|func(owner: String, name: String, params: Array<BuiltinParam>, ret: BuiltinShape,) -> (BuiltinMember,):
    var out = BuiltinMember()
    out.owner = owner
    out.name = name
    out.params = params
    out.ret = ret
    return out

; 造函数：名字、形参、返回与变参标记。
makeFunction|func(name: String, params: Array<BuiltinParam>, ret: BuiltinShape, variadic: Bool,) -> (BuiltinFunction,):
    var out = BuiltinFunction()
    out.name = name
    out.params = params
    out.ret = ret
    out.variadic = variadic
    return out

; 成员表：三类所有者按字符串、数组、字典顺序排。
builtinMemberTable|func() -> (Array<BuiltinMember>,):
    var out: Array<BuiltinMember> = []
    out = out.append(makeBuiltin("String", "upper", noParams(), builtinString))
    out = out.append(makeBuiltin("String", "lower", noParams(), builtinString))
    out = out.append(makeBuiltin("String", "trimLeft", noParams(), builtinString))
    out = out.append(makeBuiltin("String", "trimRight", noParams(), builtinString))
    out = out.append(makeBuiltin("String", "contains", oneParam("sub", builtinString), builtinBool))
    out = out.append(makeBuiltin("String", "substring", twoParams("start", builtinI32, "end", builtinI32), builtinString))
    out = out.append(makeBuiltin("String", "slice", twoParams("start", builtinOptionalI32, "end", builtinOptionalI32), builtinString))
    out = out.append(makeBuiltin("String", "split", oneParam("sep", builtinString), builtinArrayString))
    out = out.append(makeBuiltin("String", "indexOf", oneParam("needle", builtinString), builtinI32))
    out = out.append(makeBuiltin("String", "get", oneParam("index", builtinI32), builtinOptionalChar))
    out = out.append(makeBuiltin("String", "getUnchecked", oneParam("index", builtinI32), builtinChar))
    out = out.append(makeBuiltin("Array", "join", oneParam("sep", builtinString), builtinString))
    out = out.append(makeBuiltin("Array", "append", oneParam("value", builtinSameElem), builtinArrayElem))
    out = out.append(makeBuiltin("Array", "slice", twoParams("start", builtinOptionalI32, "end", builtinOptionalI32), builtinArrayElem))
    out = out.append(makeBuiltin("Array", "last", noParams(), builtinSameElem))
    out = out.append(makeBuiltin("Array", "pop", noParams(), builtinPopTuple))
    out = out.append(makeBuiltin("Array", "get", oneParam("index", builtinI32), builtinOptionalElem))
    out = out.append(makeBuiltin("Array", "getUnchecked", oneParam("index", builtinI32), builtinSameElem))
    out = out.append(makeBuiltin("Dictionary", "get", oneParam("key", builtinDictKey), builtinOptionalValue))
    out = out.append(makeBuiltin("Dictionary", "getUnchecked", oneParam("key", builtinDictKey), builtinDictValue))
    return out

; 函数表：按收集、值、字符、读写、数学、并发、C 边界的次序排。
builtinFunctionTable|func() -> (Array<BuiltinFunction>,):
    var out: Array<BuiltinFunction> = []
    out = out.append(makeFunction("len", oneSizedParam("value"), builtinI32, false))
    out = out.append(makeFunction("print", oneParam("value", builtinAny), builtinVoid, true))
    out = out.append(makeFunction("assert", twoParams("条件", builtinBool, "消息", builtinString), builtinVoid, true))
    out = out.append(makeFunction("F64", oneParam("value", builtinAny), builtinF64, false))
    out = out.append(makeFunction("is_letter", oneParam("value", builtinChar), builtinBool, false))
    out = out.append(makeFunction("is_ascii_digit", oneParam("value", builtinChar), builtinBool, false))
    out = out.append(makeFunction("is_number", oneParam("value", builtinChar), builtinBool, false))
    out = out.append(makeFunction("chars", oneParam("value", builtinString), builtinArrayChar, false))
    out = out.append(makeFunction("tempUtf8Bytes", oneParam("value", builtinString), builtinArrayU8, false))
    out = out.append(makeFunction("tempByteToInt", oneParam("value", builtinU8), builtinI32, false))
    out = out.append(makeFunction("tempIntToByte", oneParam("value", builtinI32), builtinU8, false))
    out = out.append(makeFunction("ord", oneParam("value", builtinChar), builtinI32, false))
    out = out.append(makeFunction("chr", oneParam("code", builtinI32), builtinChar, false))
    out = out.append(makeFunction("moduleRoot", noParams(), builtinString, false))
    out = out.append(makeFunction("readFile", oneParam("path", builtinString), builtinString, false))
    out = out.append(makeFunction("writeFile", twoParams("path", builtinString, "content", builtinString), builtinVoid, false))
    out = out.append(makeFunction("appendFile", twoParams("path", builtinString, "content", builtinString), builtinVoid, false))
    out = out.append(makeFunction("readLine", noParams(), builtinString, false))
    out = out.append(makeFunction("listDir", oneParam("path", builtinString), builtinArrayString, false))
    out = out.append(makeFunction("exists", oneParam("path", builtinString), builtinBool, false))
    out = out.append(makeFunction("isDir", oneParam("path", builtinString), builtinBool, false))
    out = out.append(makeFunction("tryReadFile", oneParam("path", builtinString), builtinResultString, false))
    out = out.append(makeFunction("tryWriteFile", twoParams("path", builtinString, "content", builtinString), builtinResultVoid, false))
    out = out.append(makeFunction("tryAppendFile", twoParams("path", builtinString, "content", builtinString), builtinResultVoid, false))
    out = out.append(makeFunction("abs", oneParam("x", builtinI32), builtinI32, false))
    out = out.append(makeFunction("min", twoParams("a", builtinI32, "b", builtinI32), builtinI32, false))
    out = out.append(makeFunction("max", twoParams("a", builtinI32, "b", builtinI32), builtinI32, false))
    out = out.append(makeFunction("sqrt", oneParam("x", builtinF64), builtinF64, false))
    out = out.append(makeFunction("sin", oneParam("x", builtinF64), builtinF64, false))
    out = out.append(makeFunction("cos", oneParam("x", builtinF64), builtinF64, false))
    out = out.append(makeFunction("tan", oneParam("x", builtinF64), builtinF64, false))
    out = out.append(makeFunction("sleep", oneParam("ms", builtinI32), builtinVoid, false))
    out = out.append(makeFunction("fromCString", oneParam("p", builtinPointerU8), builtinString, false))
    return out

; 查表：所有者与成员名都按整串比；未命中答 -1。
findBuiltin|func(members: Array<BuiltinMember>, owner: String, name: String,) -> (I32,):
    var i = 0
    while i < len(members):
        if members[i].owner == owner && members[i].name == name:
            return i
        i = i + 1
    return -1

; 查函数：按整串名字比；未命中答 -1。
findBuiltinFunction|func(functions: Array<BuiltinFunction>, name: String,) -> (I32,):
    var i = 0
    while i < len(functions):
        if functions[i].name == name:
            return i
        i = i + 1
    return -1

; 原样带回：类型已在池里，只把下标装进结果。
hitType|func(pool: TypePool, id: I32,) -> (TypeInsert,):
    var out = TypeInsert()
    out.pool = pool
    out.id = id
    return out

; 首实参：空表答 -1，调用方按待定处理。
firstArg|func(kids: Array<I32>,) -> (I32,):
    if len(kids) == 0:
        return -1
    return kids[0]

; 次实参：不足两个答 -1。
secondArg|func(kids: Array<I32>,) -> (I32,):
    if len(kids) < 2:
        return -1
    return kids[1]

; 单实参容器：实参缺失答 -1，否则驻留名为 name 的容器类。
wrapArg|func(pool: TypePool, kind: TypeClass, name: String, child: I32,) -> (TypeInsert,):
    if child < 0:
        return hitType(pool, -1)
    var kids: Array<I32> = []
    kids = kids.append(child)
    return intern(pool, kind, name, kids, -1)

; 标量返回：内建名逐个驻留，同形复用已有下标。
scalarType|func(pool: TypePool, name: String,) -> (TypeInsert,):
    return intern(pool, typeClassScalar, name, [], -1)

; 数组返回：元素形状逐个驻留成 `Array<T>`。
arrayType|func(pool: TypePool, elem: I32,) -> (TypeInsert,):
    return wrapArg(pool, typeClassCollection, "Array", elem)

; 数组标量：内建名先驻留标量再包一层。
arrayOf|func(pool: TypePool, name: String,) -> (TypeInsert,):
    let elem = scalarType(pool, name)
    return arrayType(elem.pool, elem.id)

; 结果返回：元素与错误实参各驻留一次，错误实参固定内建 `Error`。
resultType|func(pool: TypePool, elem: I32,) -> (TypeInsert,):
    if elem < 0:
        return hitType(pool, -1)
    let errorType = scalarType(pool, "Error")
    var kids: Array<I32> = []
    kids = kids.append(elem)
    kids = kids.append(errorType.id)
    return intern(errorType.pool, typeClassResult, "Result", kids, -1)

; 空结果：`^()` 的元素是空元组。
resultVoid|func(pool: TypePool,) -> (TypeInsert,):
    let unit = intern(pool, typeClassTuple, "", [], -1)
    return resultType(unit.pool, unit.id)

; 指针返回：`*U8`。
pointerU8|func(pool: TypePool,) -> (TypeInsert,):
    let byteType = scalarType(pool, "U8")
    return wrapArg(byteType.pool, typeClassPointer, "", byteType.id)

; 弹出元组：数组与其元素各占一位，顺序与运行时返回值一致。
popTupleType|func(pool: TypePool, elem: I32,) -> (TypeInsert,):
    if elem < 0:
        return hitType(pool, -1)
    let array = arrayType(pool, elem)
    var kids: Array<I32> = []
    kids = kids.append(array.id)
    kids = kids.append(elem)
    return intern(array.pool, typeClassTuple, "", kids, -1)

; 形状定型：按形状驻留类型，占位取自接收者实参；Any 答 -1 表示不约束。
builtinShapeType|func(pool: TypePool, shape: BuiltinShape, kids: Array<I32>,) -> (TypeInsert,):
    if isBuiltinShape(shape, builtinAny):
        return hitType(pool, -1)
    if isBuiltinShape(shape, builtinVoid):
        return intern(pool, typeClassTuple, "", [], -1)
    if isBuiltinShape(shape, builtinString):
        return scalarType(pool, "String")
    if isBuiltinShape(shape, builtinBool):
        return scalarType(pool, "Bool")
    if isBuiltinShape(shape, builtinI32):
        return scalarType(pool, "I32")
    if isBuiltinShape(shape, builtinChar):
        return scalarType(pool, "Char")
    if isBuiltinShape(shape, builtinU8):
        return scalarType(pool, "U8")
    if isBuiltinShape(shape, builtinF64):
        return scalarType(pool, "F64")
    if isBuiltinShape(shape, builtinOptionalChar):
        let charType = scalarType(pool, "Char")
        return wrapArg(charType.pool, typeClassOptional, "", charType.id)
    if isBuiltinShape(shape, builtinOptionalI32):
        let numberType = scalarType(pool, "I32")
        return wrapArg(numberType.pool, typeClassOptional, "", numberType.id)
    if isBuiltinShape(shape, builtinSameElem):
        return hitType(pool, firstArg(kids))
    if isBuiltinShape(shape, builtinOptionalElem):
        return wrapArg(pool, typeClassOptional, "", firstArg(kids))
    if isBuiltinShape(shape, builtinArrayElem):
        return arrayType(pool, firstArg(kids))
    if isBuiltinShape(shape, builtinArrayChar):
        return arrayOf(pool, "Char")
    if isBuiltinShape(shape, builtinArrayString):
        return arrayOf(pool, "String")
    if isBuiltinShape(shape, builtinArrayU8):
        return arrayOf(pool, "U8")
    if isBuiltinShape(shape, builtinPopTuple):
        return popTupleType(pool, firstArg(kids))
    if isBuiltinShape(shape, builtinDictKey):
        return hitType(pool, firstArg(kids))
    if isBuiltinShape(shape, builtinDictValue):
        return hitType(pool, secondArg(kids))
    if isBuiltinShape(shape, builtinOptionalValue):
        return wrapArg(pool, typeClassOptional, "", secondArg(kids))
    if isBuiltinShape(shape, builtinResultString):
        let text = scalarType(pool, "String")
        return resultType(text.pool, text.id)
    if isBuiltinShape(shape, builtinResultVoid):
        return resultVoid(pool)
    if isBuiltinShape(shape, builtinPointerU8):
        return pointerU8(pool)
    return hitType(pool, -1)

; 成员签名：形参与返回各按形状定型，占位取接收者实参；无形参时给零参函数类型。
builtinMemberSignature|func(pool: TypePool, member: BuiltinMember, kids: Array<I32>,) -> (TypeInsert,):
    var working = pool
    var params: Array<I32> = []
    var i = 0
    while i < len(member.params):
        let param = builtinShapeType(working, member.params[i].shape, kids)
        working = param.pool
        if param.id < 0:
            return hitType(working, -1)
        params = params.append(param.id)
        i = i + 1
    let ret = builtinShapeType(working, member.ret, kids)
    if ret.id < 0:
        return hitType(ret.pool, -1)
    return intern(ret.pool, typeClassFunction, "", params, ret.id)
