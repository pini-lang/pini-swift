; 内建签名表：`String`、`Array`、`Dictionary` 的成员面与全部内建函数，全语言唯一来源。
; 形状描述形参与返回落在哪类类型上；占位按接收者实参回填，Any 表示不限（调用侧跳过比对）。
; 指针、`ok`/`err` 与 `LazyRef`/`UnownedRef` 构造走专属路径，不在本表；并发自由函数只在此登记签名。

; 形状：固定标量、容器、可选、元组、结果、错误与指针各一类；Any 只用于形参。
[BuiltinShape]
builtinAny
builtinVoid
builtinString
builtinBool
builtinI32
builtinChar
builtinU8
builtinF64
builtinOptionalChar
builtinOptionalI32
builtinSameElem
builtinOptionalElem
builtinArrayElem
builtinArrayChar
builtinArrayString
builtinArrayU8
builtinPopTuple
builtinDictKey
builtinDictValue
builtinOptionalValue
builtinResultString
builtinResultVoid
builtinError
builtinCancelError
builtinPointerU8

; 内建形参：名字服务标签与诊断，形状决定类型；sized 表示实参须是可取长的类型。
(BuiltinParam)
name: String = ""
shape: BuiltinShape = .builtinAny
sized: Bool = false

; 内建成员：所有者、成员名、形参与返回形状。
(BuiltinMember)
owner: String = ""
name: String = ""
params: Array<BuiltinParam> = []
ret: BuiltinShape = .builtinString

; 内建函数：名字、形参、返回与是否变参。
(BuiltinFunction)
name: String = ""
params: Array<BuiltinParam> = []
ret: BuiltinShape = .builtinVoid
variadic: Bool = false

; 形状名：诊断、测试与回执共用一份拼写。
builtinShapeName|func(_shape: BuiltinShape,) -> (String,):
    match _shape:
        case builtinAny:
            return "不限"
        case builtinVoid:
            return "空元组"
        case builtinString:
            return "字符串"
        case builtinBool:
            return "布尔"
        case builtinI32:
            return "整数"
        case builtinChar:
            return "字符"
        case builtinU8:
            return "字节"
        case builtinF64:
            return "浮点"
        case builtinOptionalChar:
            return "字符可选"
        case builtinOptionalI32:
            return "整数可选"
        case builtinSameElem:
            return "元素本身"
        case builtinOptionalElem:
            return "元素可选"
        case builtinArrayElem:
            return "元素数组"
        case builtinArrayChar:
            return "字符数组"
        case builtinArrayString:
            return "字符串数组"
        case builtinArrayU8:
            return "字节数组"
        case builtinPopTuple:
            return "数组弹出元组"
        case builtinDictKey:
            return "字典键"
        case builtinDictValue:
            return "字典值"
        case builtinOptionalValue:
            return "字典值可选"
        case builtinResultString:
            return "字符串结果"
        case builtinResultVoid:
            return "空结果"
        case builtinError:
            return "错误"
        case builtinCancelError:
            return "取消错误"
        case builtinPointerU8:
            return "字节指针"
    return "未知形状"

; 同一形状判定：枚举相等比较不可用，按名称比。
isBuiltinShape|func(shape: BuiltinShape, expected: BuiltinShape,) -> (Bool,):
    return builtinShapeName(shape) == builtinShapeName(expected)

; 造形参：名字与形状两件套。
makeParam|func(name: String, shape: BuiltinShape,) -> (BuiltinParam,):
    var out = BuiltinParam()
    out.name = name
    out.shape = shape
    return out

; 无形参：空表留给无参成员与无参函数。
noParams|func() -> (Array<BuiltinParam>,):
    var out: Array<BuiltinParam> = []
    return out

; 单形参。
oneParam|func(name: String, shape: BuiltinShape,) -> (Array<BuiltinParam>,):
    var out: Array<BuiltinParam> = []
    out = out.append(makeParam(name = name, shape = shape))
    return out

; 有长度形参：具体类型由实参决定，调用侧只要求可取长。
makeSizedParam|func(_name: String,) -> (BuiltinParam,):
    var out = BuiltinParam()
    out.name = _name
    out.sized = true
    return out

; 单形参（带长度约束）：`len` 与将来的同类内建共用。
oneSizedParam|func(_name: String,) -> (Array<BuiltinParam>,):
    var out: Array<BuiltinParam> = []
    out = out.append(makeSizedParam(_name))
    return out

; 双形参。
twoParams|func(first: String, firstShape: BuiltinShape, second: String, secondShape: BuiltinShape,) -> (Array<BuiltinParam>,):
    var out: Array<BuiltinParam> = []
    out = out.append(makeParam(name = first, shape = firstShape))
    out = out.append(makeParam(name = second, shape = secondShape))
    return out

; 造成员：所有者、名字、形参与返回形状。
makeBuiltin|func(owner: String, name: String, params: Array<BuiltinParam>, ret: BuiltinShape,) -> (BuiltinMember,):
    var out = BuiltinMember()
    out.owner = owner
    out.name = name
    out.params = params
    out.ret = ret
    return out

; 造函数：名字、形参、返回与变参标记。
makeFunction|func(name: String, params: Array<BuiltinParam>, ret: BuiltinShape, variadic: Bool,) -> (BuiltinFunction,):
    var out = BuiltinFunction()
    out.name = name
    out.params = params
    out.ret = ret
    out.variadic = variadic
    return out

; 成员表：四类所有者按字符串、数组、字典、任务句柄顺序排。
builtinMemberTable|func() -> (Array<BuiltinMember>,):
    var out: Array<BuiltinMember> = []
    out = out.append(makeBuiltin(owner = "String", name = "upper", params = noParams(), ret = .builtinString))
    out = out.append(makeBuiltin(owner = "String", name = "lower", params = noParams(), ret = .builtinString))
    out = out.append(makeBuiltin(owner = "String", name = "trimLeft", params = noParams(), ret = .builtinString))
    out = out.append(makeBuiltin(owner = "String", name = "trimRight", params = noParams(), ret = .builtinString))
    out = out.append(makeBuiltin(owner = "String", name = "contains", params = oneParam(name = "sub", shape = .builtinString), ret = .builtinBool))
    out = out.append(makeBuiltin(owner = "String", name = "substring", params = twoParams(first = "start", firstShape = .builtinI32, second = "end", secondShape = .builtinI32), ret = .builtinString))
    out = out.append(makeBuiltin(owner = "String", name = "slice", params = twoParams(first = "start", firstShape = .builtinOptionalI32, second = "end", secondShape = .builtinOptionalI32), ret = .builtinString))
    out = out.append(makeBuiltin(owner = "String", name = "split", params = oneParam(name = "sep", shape = .builtinString), ret = .builtinArrayString))
    out = out.append(makeBuiltin(owner = "String", name = "indexOf", params = oneParam(name = "needle", shape = .builtinString), ret = .builtinI32))
    out = out.append(makeBuiltin(owner = "String", name = "get", params = oneParam(name = "index", shape = .builtinI32), ret = .builtinOptionalChar))
    out = out.append(makeBuiltin(owner = "String", name = "getUnchecked", params = oneParam(name = "index", shape = .builtinI32), ret = .builtinChar))
    out = out.append(makeBuiltin(owner = "Array", name = "join", params = oneParam(name = "sep", shape = .builtinString), ret = .builtinString))
    out = out.append(makeBuiltin(owner = "Array", name = "append", params = oneParam(name = "value", shape = .builtinSameElem), ret = .builtinArrayElem))
    out = out.append(makeBuiltin(owner = "Array", name = "slice", params = twoParams(first = "start", firstShape = .builtinOptionalI32, second = "end", secondShape = .builtinOptionalI32), ret = .builtinArrayElem))
    out = out.append(makeBuiltin(owner = "Array", name = "last", params = noParams(), ret = .builtinSameElem))
    out = out.append(makeBuiltin(owner = "Array", name = "pop", params = noParams(), ret = .builtinPopTuple))
    out = out.append(makeBuiltin(owner = "Array", name = "get", params = oneParam(name = "index", shape = .builtinI32), ret = .builtinOptionalElem))
    out = out.append(makeBuiltin(owner = "Array", name = "getUnchecked", params = oneParam(name = "index", shape = .builtinI32), ret = .builtinSameElem))
    out = out.append(makeBuiltin(owner = "Dictionary", name = "get", params = oneParam(name = "key", shape = .builtinDictKey), ret = .builtinOptionalValue))
    out = out.append(makeBuiltin(owner = "Dictionary", name = "getUnchecked", params = oneParam(name = "key", shape = .builtinDictKey), ret = .builtinDictValue))
    ; 任务句柄：取消是句柄上的动作，返回空元组；等待与超时归自由函数，不在这里。
    out = out.append(makeBuiltin(owner = "Future", name = "cancel", params = noParams(), ret = .builtinVoid))
    return out

; 函数表：按收集、值、字符、读写、数学、并发、C 边界的次序排。
builtinFunctionTable|func() -> (Array<BuiltinFunction>,):
    var out: Array<BuiltinFunction> = []
    out = out.append(makeFunction(name = "len", params = oneSizedParam("value"), ret = .builtinI32, variadic = false))
    out = out.append(makeFunction(name = "print", params = oneParam(name = "value", shape = .builtinAny), ret = .builtinVoid, variadic = true))
    out = out.append(makeFunction(name = "assert", params = twoParams(first = "条件", firstShape = .builtinBool, second = "消息", secondShape = .builtinString), ret = .builtinVoid, variadic = true))
    out = out.append(makeFunction(name = "F64", params = oneParam(name = "value", shape = .builtinAny), ret = .builtinF64, variadic = false))
    ; 错误构造：消息串进、错误值出；取消错误与业务错误并列，判别只经 `isCancel`。
    out = out.append(makeFunction(name = "Error", params = oneParam(name = "message", shape = .builtinString), ret = .builtinError, variadic = false))
    out = out.append(makeFunction(name = "CancelError", params = oneParam(name = "message", shape = .builtinString), ret = .builtinCancelError, variadic = false))
    out = out.append(makeFunction(name = "is_letter", params = oneParam(name = "value", shape = .builtinChar), ret = .builtinBool, variadic = false))
    out = out.append(makeFunction(name = "is_ascii_digit", params = oneParam(name = "value", shape = .builtinChar), ret = .builtinBool, variadic = false))
    out = out.append(makeFunction(name = "is_number", params = oneParam(name = "value", shape = .builtinChar), ret = .builtinBool, variadic = false))
    out = out.append(makeFunction(name = "chars", params = oneParam(name = "value", shape = .builtinString), ret = .builtinArrayChar, variadic = false))
    out = out.append(makeFunction(name = "tempUtf8Bytes", params = oneParam(name = "value", shape = .builtinString), ret = .builtinArrayU8, variadic = false))
    out = out.append(makeFunction(name = "tempByteToInt", params = oneParam(name = "value", shape = .builtinU8), ret = .builtinI32, variadic = false))
    out = out.append(makeFunction(name = "tempIntToByte", params = oneParam(name = "value", shape = .builtinI32), ret = .builtinU8, variadic = false))
    out = out.append(makeFunction(name = "ord", params = oneParam(name = "value", shape = .builtinChar), ret = .builtinI32, variadic = false))
    out = out.append(makeFunction(name = "chr", params = oneParam(name = "code", shape = .builtinI32), ret = .builtinChar, variadic = false))
    out = out.append(makeFunction(name = "moduleRoot", params = noParams(), ret = .builtinString, variadic = false))
    out = out.append(makeFunction(name = "argv", params = noParams(), ret = .builtinArrayString, variadic = false))
    out = out.append(makeFunction(name = "readFile", params = oneParam(name = "path", shape = .builtinString), ret = .builtinString, variadic = false))
    out = out.append(makeFunction(name = "writeFile", params = twoParams(first = "path", firstShape = .builtinString, second = "content", secondShape = .builtinString), ret = .builtinVoid, variadic = false))
    out = out.append(makeFunction(name = "appendFile", params = twoParams(first = "path", firstShape = .builtinString, second = "content", secondShape = .builtinString), ret = .builtinVoid, variadic = false))
    out = out.append(makeFunction(name = "readLine", params = noParams(), ret = .builtinString, variadic = false))
    out = out.append(makeFunction(name = "listDir", params = oneParam(name = "path", shape = .builtinString), ret = .builtinArrayString, variadic = false))
    out = out.append(makeFunction(name = "exists", params = oneParam(name = "path", shape = .builtinString), ret = .builtinBool, variadic = false))
    out = out.append(makeFunction(name = "isDir", params = oneParam(name = "path", shape = .builtinString), ret = .builtinBool, variadic = false))
    out = out.append(makeFunction(name = "tryReadFile", params = oneParam(name = "path", shape = .builtinString), ret = .builtinResultString, variadic = false))
    out = out.append(makeFunction(name = "tryWriteFile", params = twoParams(first = "path", firstShape = .builtinString, second = "content", secondShape = .builtinString), ret = .builtinResultVoid, variadic = false))
    out = out.append(makeFunction(name = "tryAppendFile", params = twoParams(first = "path", firstShape = .builtinString, second = "content", secondShape = .builtinString), ret = .builtinResultVoid, variadic = false))
    out = out.append(makeFunction(name = "abs", params = oneParam(name = "x", shape = .builtinI32), ret = .builtinI32, variadic = false))
    out = out.append(makeFunction(name = "min", params = twoParams(first = "a", firstShape = .builtinI32, second = "b", secondShape = .builtinI32), ret = .builtinI32, variadic = false))
    out = out.append(makeFunction(name = "max", params = twoParams(first = "a", firstShape = .builtinI32, second = "b", secondShape = .builtinI32), ret = .builtinI32, variadic = false))
    out = out.append(makeFunction(name = "sqrt", params = oneParam(name = "x", shape = .builtinF64), ret = .builtinF64, variadic = false))
    out = out.append(makeFunction(name = "sin", params = oneParam(name = "x", shape = .builtinF64), ret = .builtinF64, variadic = false))
    out = out.append(makeFunction(name = "cos", params = oneParam(name = "x", shape = .builtinF64), ret = .builtinF64, variadic = false))
    out = out.append(makeFunction(name = "tan", params = oneParam(name = "x", shape = .builtinF64), ret = .builtinF64, variadic = false))
    out = out.append(makeFunction(name = "sleep", params = oneParam(name = "ms", shape = .builtinI32), ret = .builtinVoid, variadic = false))
    ; 并发自由函数：返回形状待定（任务句柄与结果都由降载面给），此处只锁名字与个数。
    out = out.append(makeFunction(name = "isCancel", params = oneParam(name = "e", shape = .builtinError), ret = .builtinBool, variadic = false))
    out = out.append(makeFunction(name = "joinAll", params = oneParam(name = "futures", shape = .builtinAny), ret = .builtinAny, variadic = false))
    out = out.append(makeFunction(name = "joinWithin", params = twoParams(first = "future", firstShape = .builtinAny, second = "ms", secondShape = .builtinI32), ret = .builtinAny, variadic = false))
    out = out.append(makeFunction(name = "fromCString", params = oneParam(name = "p", shape = .builtinPointerU8), ret = .builtinString, variadic = false))
    return out

; 查表：所有者与成员名都按整串比；未命中答 -1。
findBuiltin|func(members: Array<BuiltinMember>, owner: String, name: String,) -> (I32,):
    var i = 0
    while i < len(members):
        if members[i].owner == owner && members[i].name == name:
            return i
        i = i + 1
    return -1

; 查函数：按整串名字比；未命中答 -1。
findBuiltinFunction|func(functions: Array<BuiltinFunction>, name: String,) -> (I32,):
    var i = 0
    while i < len(functions):
        if functions[i].name == name:
            return i
        i = i + 1
    return -1

; 原样带回：类型已在池里，只把下标装进结果。
hitType|func(pool: TypePool, id: I32,) -> (TypeInsert,):
    var out = TypeInsert()
    out.pool = pool
    out.id = id
    return out

; 首实参：空表答 -1，调用方按待定处理。
firstArg|func(_kids: Array<I32>,) -> (I32,):
    if len(_kids) == 0:
        return -1
    return _kids[0]

; 次实参：不足两个答 -1。
secondArg|func(_kids: Array<I32>,) -> (I32,):
    if len(_kids) < 2:
        return -1
    return _kids[1]

; 单实参容器：实参缺失答 -1，否则驻留名为 name 的容器类。
wrapArg|func(pool: TypePool, kind: TypeClass, name: String, child: I32,) -> (TypeInsert,):
    if child < 0:
        return hitType(pool = pool, id = -1)
    var kids: Array<I32> = []
    kids = kids.append(child)
    return intern(pool = pool, kind = kind, name = name, kids = kids, ret = -1)

; 标量返回：内建名逐个驻留，同形复用已有下标。
scalarType|func(pool: TypePool, name: String,) -> (TypeInsert,):
    return intern(pool = pool, kind = .typeClassScalar, name = name, kids = [], ret = -1)

; 数组返回：元素形状逐个驻留成 `Array<T>`。
arrayType|func(pool: TypePool, elem: I32,) -> (TypeInsert,):
    return wrapArg(pool = pool, kind = .typeClassCollection, name = "Array", child = elem)

; 数组标量：内建名先驻留标量再包一层。
arrayOf|func(pool: TypePool, name: String,) -> (TypeInsert,):
    let elem = scalarType(pool = pool, name = name)
    return arrayType(pool = elem.pool, elem = elem.id)

; 结果返回：元素与错误实参各驻留一次，错误实参固定内建 `Error`。
resultType|func(pool: TypePool, elem: I32,) -> (TypeInsert,):
    if elem < 0:
        return hitType(pool = pool, id = -1)
    let errorType = scalarType(pool = pool, name = "Error")
    var kids: Array<I32> = []
    kids = kids.append(elem)
    kids = kids.append(errorType.id)
    return intern(pool = errorType.pool, kind = .typeClassResult, name = "Result", kids = kids, ret = -1)

; 空结果：`^()` 的元素是空元组。
resultVoid|func(_pool: TypePool,) -> (TypeInsert,):
    let unit = intern(pool = _pool, kind = .typeClassTuple, name = "", kids = [], ret = -1)
    return resultType(pool = unit.pool, elem = unit.id)

; 指针返回：`*U8`。
pointerU8|func(_pool: TypePool,) -> (TypeInsert,):
    let byteType = scalarType(pool = _pool, name = "U8")
    return wrapArg(pool = byteType.pool, kind = .typeClassPointer, name = "", child = byteType.id)

; 弹出元组：数组与其元素各占一位，顺序与运行时返回值一致。
popTupleType|func(pool: TypePool, elem: I32,) -> (TypeInsert,):
    if elem < 0:
        return hitType(pool = pool, id = -1)
    let array = arrayType(pool = pool, elem = elem)
    var kids: Array<I32> = []
    kids = kids.append(array.id)
    kids = kids.append(elem)
    return intern(pool = array.pool, kind = .typeClassTuple, name = "", kids = kids, ret = -1)

; 形状定型：按形状驻留类型，占位取自接收者实参；Any 答 -1 表示不约束。
builtinShapeType|func(pool: TypePool, shape: BuiltinShape, kids: Array<I32>,) -> (TypeInsert,):
    if isBuiltinShape(shape = shape, expected = .builtinAny):
        return hitType(pool = pool, id = -1)
    if isBuiltinShape(shape = shape, expected = .builtinVoid):
        return intern(pool = pool, kind = .typeClassTuple, name = "", kids = [], ret = -1)
    if isBuiltinShape(shape = shape, expected = .builtinString):
        return scalarType(pool = pool, name = "String")
    if isBuiltinShape(shape = shape, expected = .builtinBool):
        return scalarType(pool = pool, name = "Bool")
    if isBuiltinShape(shape = shape, expected = .builtinI32):
        return scalarType(pool = pool, name = "I32")
    if isBuiltinShape(shape = shape, expected = .builtinChar):
        return scalarType(pool = pool, name = "Char")
    if isBuiltinShape(shape = shape, expected = .builtinU8):
        return scalarType(pool = pool, name = "U8")
    if isBuiltinShape(shape = shape, expected = .builtinF64):
        return scalarType(pool = pool, name = "F64")
    if isBuiltinShape(shape = shape, expected = .builtinOptionalChar):
        let charType = scalarType(pool = pool, name = "Char")
        return wrapArg(pool = charType.pool, kind = .typeClassOptional, name = "", child = charType.id)
    if isBuiltinShape(shape = shape, expected = .builtinOptionalI32):
        let numberType = scalarType(pool = pool, name = "I32")
        return wrapArg(pool = numberType.pool, kind = .typeClassOptional, name = "", child = numberType.id)
    if isBuiltinShape(shape = shape, expected = .builtinSameElem):
        return hitType(pool = pool, id = firstArg(kids))
    if isBuiltinShape(shape = shape, expected = .builtinOptionalElem):
        return wrapArg(pool = pool, kind = .typeClassOptional, name = "", child = firstArg(kids))
    if isBuiltinShape(shape = shape, expected = .builtinArrayElem):
        return arrayType(pool = pool, elem = firstArg(kids))
    if isBuiltinShape(shape = shape, expected = .builtinArrayChar):
        return arrayOf(pool = pool, name = "Char")
    if isBuiltinShape(shape = shape, expected = .builtinArrayString):
        return arrayOf(pool = pool, name = "String")
    if isBuiltinShape(shape = shape, expected = .builtinArrayU8):
        return arrayOf(pool = pool, name = "U8")
    if isBuiltinShape(shape = shape, expected = .builtinPopTuple):
        return popTupleType(pool = pool, elem = firstArg(kids))
    if isBuiltinShape(shape = shape, expected = .builtinDictKey):
        return hitType(pool = pool, id = firstArg(kids))
    if isBuiltinShape(shape = shape, expected = .builtinDictValue):
        return hitType(pool = pool, id = secondArg(kids))
    if isBuiltinShape(shape = shape, expected = .builtinOptionalValue):
        return wrapArg(pool = pool, kind = .typeClassOptional, name = "", child = secondArg(kids))
    if isBuiltinShape(shape = shape, expected = .builtinResultString):
        let text = scalarType(pool = pool, name = "String")
        return resultType(pool = text.pool, elem = text.id)
    if isBuiltinShape(shape = shape, expected = .builtinResultVoid):
        return resultVoid(pool)
    if isBuiltinShape(shape = shape, expected = .builtinError):
        return scalarType(pool = pool, name = "Error")
    if isBuiltinShape(shape = shape, expected = .builtinCancelError):
        return scalarType(pool = pool, name = "CancelError")
    if isBuiltinShape(shape = shape, expected = .builtinPointerU8):
        return pointerU8(pool)
    return hitType(pool = pool, id = -1)

; 成员签名：形参与返回各按形状定型，占位取接收者实参；无形参时给零参函数类型。
builtinMemberSignature|func(pool: TypePool, member: BuiltinMember, kids: Array<I32>,) -> (TypeInsert,):
    var working = pool
    var params: Array<I32> = []
    var i = 0
    while i < len(member.params):
        let param = builtinShapeType(pool = working, shape = member.params[i].shape, kids = kids)
        working = param.pool
        if param.id < 0:
            return hitType(pool = working, id = -1)
        params = params.append(param.id)
        i = i + 1
    let ret = builtinShapeType(pool = working, shape = member.ret, kids = kids)
    if ret.id < 0:
        return hitType(pool = ret.pool, id = -1)
    return intern(pool = ret.pool, kind = .typeClassFunction, name = "", kids = params, ret = ret.id)
