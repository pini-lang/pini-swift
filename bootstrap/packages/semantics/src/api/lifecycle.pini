[lifecycle|import]
_syntax = "../../../syntax"
_module_loader = "../../../module-loader"

; 生命周期成员：`deinit` 只挂在对象类型上，零形参、零返回、不同步，每类型至多一个。
; 形状不合格时释放胶水会按错的原型调用它，故在声明处拦下，不进 IR。
[LifecycleErrorKind]
lifecycleNotObject
lifecycleHasParams
lifecycleHasReturn
lifecycleAsync
lifecycleDuplicated

; 生命周期错误：类别、文件、声明头偏移与所属类型名。
(LifecycleError)
kind: LifecycleErrorKind = .lifecycleNotObject
file: String = ""
offset: I32 = 0
owner: String = ""

; 检查结果：错误表与失败标记；错误按文件与偏移排好。
(LifecycleCheck)
errors: Array<LifecycleError> = []
failed: Bool = false

; 类别名：诊断与测试共用一份拼写。
lifecycleErrorName|func(_kind: LifecycleErrorKind,) -> (String,):
    match _kind:
        case lifecycleNotObject:
            return "`deinit` 只挂在对象类型上"
        case lifecycleHasParams:
            return "`deinit` 不带形参"
        case lifecycleHasReturn:
            return "`deinit` 不返回值"
        case lifecycleAsync:
            return "`deinit` 不能是异步函数"
        case lifecycleDuplicated:
            return "每个类型只能一个 `deinit`"
    return "析构声明不合法"

; 类型名表的一行：顶层类型声明的名字与是否对象。
(TypeOwner)
name: String = ""
isObject: Bool = false

; 过一趟的结果：检查表与已见类型名；跨单元、跨扩展块共用一份已见表。
(LifecyclePass)
check: LifecycleCheck = LifecycleCheck()
seen: Array<String> = []

; 名义声明：结构、对象、枚举与给定块同属「带成员的类型声明」。
isNominalDecl|func(_code: I32,) -> (Bool,):
    if isStructDeclCode(_code) || isObjectDeclCode(_code):
        return true
    if isEnumDeclCode(_code) || isGivenDeclCode(_code):
        return true
    return false

; 生命周期成员只出现在类型声明与扩展块里；特征与裸函数不在这一面。
hasLifecycleMembers|func(_code: I32,) -> (Bool,):
    if isNominalDecl(_code):
        return true
    return isExtensionDeclCode(_code)

; 类型名表：顶层类型声明的名字与种类；扩展块头名按它查种类。
ownerTableOf|func(unit: CompilationUnit, bytes: Array<U8>,) -> (Array<TypeOwner>,):
    var out: Array<TypeOwner> = []
    var i = 0
    while i < len(unit.ast.items):
        let decl = unit.ast.decls[unit.ast.items[i]]
        if isNominalDecl(decl.kind):
            var one = TypeOwner()
            one.name = decodeSpelling(bytes = bytes, start = decl.nameStart, end = decl.nameEnd)
            one.isObject = isObjectDeclCode(decl.kind)
            out = out.append(one)
        i = i + 1
    return out

; 扩展块的目标是否为对象：名字不在表里答 false，那一侧另报未声明类型。
ownerIsObject|func(owners: Array<TypeOwner>, name: String,) -> (Bool,):
    var i = 0
    while i < len(owners):
        if owners[i].name == name:
            return owners[i].isObject
        i = i + 1
    return false

; 空返回：没写箭头，或写成空元组。
isEmptyReturn|func(types: Array<TypeNode>, id: I32,) -> (Bool,):
    if id < 0:
        return true
    let node = types[id]
    if isTupleTypeCode(node.kind) && len(node.kids) == 0:
        return true
    return false

; 判一个成员：先看它是不是 `deinit`，再按 对象 → 形参 → 返回 → 异步 → 重复 的顺序判，命中即止。
checkLifecycleMember|func(acc: LifecyclePass, unit: CompilationUnit, bytes: Array<U8>, member: DeclNode, owner: String, isObjectOwner: Bool,) -> (LifecyclePass,):
    var out = acc
    let name = decodeSpelling(bytes = bytes, start = member.nameStart, end = member.nameEnd)
    if name != "deinit":
        return out
    var kind: LifecycleErrorKind = .lifecycleNotObject
    var bad = true
    if !isObjectOwner:
        kind = .lifecycleNotObject
    elif len(member.kids) > 0:
        kind = .lifecycleHasParams
    elif !isEmptyReturn(types = unit.ast.types, id = member.typeId):
        kind = .lifecycleHasReturn
    elif member.isAsync:
        kind = .lifecycleAsync
    elif hasName(items = out.seen, value = owner):
        kind = .lifecycleDuplicated
    else:
        bad = false
    if bad:
        var one = LifecycleError()
        one.kind = kind
        one.file = unit.path
        one.offset = member.start
        one.owner = owner
        out.check.errors = out.check.errors.append(one)
    else:
        out.seen = out.seen.append(owner)
    return out

; 一个顶层声明：类型声明与扩展块逐个成员过一遍。
checkLifecycleDecl|func(acc: LifecyclePass, unit: CompilationUnit, bytes: Array<U8>, decl: DeclNode, owners: Array<TypeOwner>,) -> (LifecyclePass,):
    var out = acc
    if !hasLifecycleMembers(decl.kind):
        return out
    let owner = decodeSpelling(bytes = bytes, start = decl.nameStart, end = decl.nameEnd)
    var isObjectOwner = isObjectDeclCode(decl.kind)
    if isExtensionDeclCode(decl.kind):
        isObjectOwner = ownerIsObject(owners = owners, name = owner)
    var i = 0
    while i < len(decl.kids):
        let member = unit.ast.decls[decl.kids[i]]
        if isFunctionDeclCode(member.kind):
            out = checkLifecycleMember(acc = out, unit = unit, bytes = bytes, member = member, owner = owner, isObjectOwner = isObjectOwner)
        i = i + 1
    return out

; 入口：逐单元过；已见表跨单元累计，同一类型在别处再写一次 `deinit` 也算重复。
checkLifecycleShapes|func(units: Array<CompilationUnit>,) -> (LifecycleCheck,):
    var acc = LifecyclePass()
    var u = 0
    while u < len(units):
        let unit = units[u]
        let bytes = unitBytes(unit)
        let owners = ownerTableOf(unit = unit, bytes = bytes)
        var i = 0
        while i < len(unit.ast.items):
            acc = checkLifecycleDecl(acc = acc, unit = unit, bytes = bytes, decl = unit.ast.decls[unit.ast.items[i]], owners = owners)
            i = i + 1
        u = u + 1
    acc.check.failed = len(acc.check.errors) > 0
    return acc.check
