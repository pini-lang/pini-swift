[literal|import]
_syntax = "../../../syntax"
_module_loader = "../../../module-loader"

; 字面量判定：按期望类型给六类字面量定型，并把结果写进表达式类型表。
; 整数与浮点缺省 I32 / F64；字符串与插值缺省 String；布尔缺省 Bool；空值必须有望。
; 插值段内表达式尚未进语法树，本批判定只给整体 String，段内检查待语法补面。

; 期望类型：无期望时 hasExpected 为假；有期望时 typeId 是类型池下标。
(Expectation)
hasExpected: Bool = false
typeId: I32 = -1

; 字面量错误：不匹配、缺少期望与非字面量各一类。
[LiteralErrorKind]
literalExpectedMismatch
literalNeedsExpectation
literalNotLiteral

; 字面量错误：类别、文件、源内偏移与期望/实得文本。
(LiteralError)
kind: LiteralErrorKind = .literalExpectedMismatch
file: String = ""
offset: I32 = 0
expected: String = ""
got: String = ""

; 判定结果：更新后的池与类型表、本节点类型与错误。
(LiteralResult)
pool: TypePool = TypePool()
types: ExprTypes = ExprTypes()
typeId: I32 = -1
error: LiteralError = LiteralError()
failed: Bool = false

; 无期望：调用方不提供上下文类型。
noExpectation|func() -> (Expectation,):
    return Expectation()

; 有期望：调用方给出类型池下标。
expectType|func(typeId: I32,) -> (Expectation,):
    var out = Expectation()
    out.hasExpected = true
    out.typeId = typeId
    return out

; 错误类别名：测试与诊断共用一份拼写。
literalErrorName|func(kind: LiteralErrorKind,) -> (String,):
    match kind:
        case literalExpectedMismatch:
            return "字面量类型不匹配"
        case literalNeedsExpectation:
            return "空值缺少期望类型"
        case literalNotLiteral:
            return "不是字面量"
    return "字面量错误"

; 同一类别判定：枚举相等比较不可用，按名称比。
isLiteralError|func(error: LiteralError, kind: LiteralErrorKind,) -> (Bool,):
    return literalErrorName(error.kind) == literalErrorName(kind)

; 诊断码：复用宿主已登记的码，不新增码表条目。
literalErrorCode|func(kind: LiteralErrorKind,) -> (String,):
    match kind:
        case literalExpectedMismatch:
            return "E4-001"
        case literalNeedsExpectation:
            return "E4-003"
        case literalNotLiteral:
            return "E6-002"
    return "E4-003"

; 造错误：位置取字面量起点，期望与实得文本由调用方给。
makeLiteralError|func(kind: LiteralErrorKind, file: String, offset: I32, expected: String, got: String,) -> (LiteralError,):
    var out = LiteralError()
    out.kind = kind
    out.file = file
    out.offset = offset
    out.expected = expected
    out.got = got
    return out

; 驻留并落表：缺省类型由本函数造，随后写进表达式类型表。
finishInterned|func(out: LiteralResult, unitIndex: I32, node: I32, name: String,) -> (LiteralResult,):
    let inserted = intern(out.pool, typeClassScalar, name, [], -1)
    var done = out
    done.pool = inserted.pool
    done.typeId = inserted.id
    done.types = writeExprType(out.types, unitIndex, node, inserted.id)
    return done

; 采用期望类型：类型已在池里，只落表。
finishExpected|func(out: LiteralResult, unitIndex: I32, node: I32, typeId: I32,) -> (LiteralResult,):
    var done = out
    done.typeId = typeId
    done.types = writeExprType(out.types, unitIndex, node, typeId)
    return done

; 失败收尾：写错误标记并记下期望/实得文本。
failLiteral|func(out: LiteralResult, unit: CompilationUnit, unitIndex: I32, node: I32, kind: LiteralErrorKind, expected: String, got: String,) -> (LiteralResult,):
    var done = out
    done.failed = true
    done.typeId = errorTypeId()
    done.types = writeExprType(out.types, unitIndex, node, errorTypeId())
    var offset = 0
    if node >= 0 && node < unit.ast.exprCount():
        offset = unit.ast.exprAt(node).start
    done.error = makeLiteralError(kind, unit.path, offset, expected, got)
    return done

; 判定一个节点：按类别分流，期望类型只在同族内接受。
checkLiteral|func(unit: CompilationUnit, unitIndex: I32, node: I32, expectation: Expectation, pool: TypePool, types: ExprTypes,) -> (LiteralResult,):
    var out = LiteralResult()
    out.pool = pool
    out.types = types
    if node < 0 || node >= unit.ast.exprCount():
        return failLiteral(out, unit, unitIndex, node, literalNotLiteral, "字面量", "越界节点")
    let ast = unit.ast
    if ast.isIntegerExpr(node):
        if expectation.hasExpected:
            if isNumericType(pool, expectation.typeId):
                return finishExpected(out, unitIndex, node, expectation.typeId)
            return failLiteral(out, unit, unitIndex, node, literalExpectedMismatch, typeText(pool, expectation.typeId), "I32")
        return finishInterned(out, unitIndex, node, "I32")
    if ast.isFloatExpr(node):
        if expectation.hasExpected:
            if isFloatType(pool, expectation.typeId):
                return finishExpected(out, unitIndex, node, expectation.typeId)
            return failLiteral(out, unit, unitIndex, node, literalExpectedMismatch, typeText(pool, expectation.typeId), "F64")
        return finishInterned(out, unitIndex, node, "F64")
    if ast.isStringExpr(node) || ast.isInterpolatedExpr(node):
        if expectation.hasExpected:
            if isStringType(pool, expectation.typeId):
                return finishExpected(out, unitIndex, node, expectation.typeId)
            return failLiteral(out, unit, unitIndex, node, literalExpectedMismatch, typeText(pool, expectation.typeId), "String")
        return finishInterned(out, unitIndex, node, "String")
    if ast.isBoolExpr(node):
        if expectation.hasExpected:
            if isBoolType(pool, expectation.typeId):
                return finishExpected(out, unitIndex, node, expectation.typeId)
            return failLiteral(out, unit, unitIndex, node, literalExpectedMismatch, typeText(pool, expectation.typeId), "Bool")
        return finishInterned(out, unitIndex, node, "Bool")
    if ast.isNilExpr(node):
        if !expectation.hasExpected:
            return failLiteral(out, unit, unitIndex, node, literalNeedsExpectation, "", "nil")
        if isNullableType(pool, expectation.typeId):
            return finishExpected(out, unitIndex, node, expectation.typeId)
        return failLiteral(out, unit, unitIndex, node, literalExpectedMismatch, typeText(pool, expectation.typeId), "nil")
    return failLiteral(out, unit, unitIndex, node, literalNotLiteral, "字面量", "非字面量表达式")
