[shape|import]
_syntax = "../../../syntax"
_module_loader = "../../../module-loader"

; 形态表：把结构、对象、枚举的字段名、类型与声明序从语法树搬进可查的表。
; 成员表按名字答「有没有、什么类型」，这里按位置答「第几格、叫什么、什么类型」；布局只读这张表。
; 枚举用例连同载荷类型与声明序一并留下，载荷槽序由它决定。

; 形态类别：结构、对象、枚举、可选、结果与未知六类。
[ShapeKind]
shapeStruct
shapeObject
shapeEnum
shapeOptional
shapeResult
shapeUnknown

; 形态字段：名字与类型下标；在表里的位置即声明序。
(ShapeField)
name: String = ""
typeId: I32 = -1

; 形态用例：名字与逐位载荷类型；载荷声明序即槽序。
(ShapeCase)
name: String = ""
payload: Array<I32> = []

; 形态条目：类型下标、类别、字段表与用例表；结构只填字段，枚举只填用例。
(ShapeEntry)
typeId: I32 = -1
kind: ShapeKind = .shapeUnknown
fields: Array<ShapeField> = []
cases: Array<ShapeCase> = []

; 形态表：按类型下标升序，条目只读；同一份世界建两次得到同一串条目。
(ShapeTable)
entries: Array<ShapeEntry> = []

; 实例替换过程：池随解析增长，替换项按声明下标累积。
(TypeOverridePass)
pool: TypePool = TypePool()
overrides: Array<TypeBinding> = []

; 类别名：诊断、测试与回执共用一份拼写。
shapeKindName|func(_kind: ShapeKind,) -> (String,):
    match _kind:
        case shapeStruct:
            return "结构"
        case shapeObject:
            return "对象"
        case shapeEnum:
            return "枚举"
        case shapeOptional:
            return "可选"
        case shapeResult:
            return "结果"
        case shapeUnknown:
            return "未知形态"
    return "未知形态"

; 同一类别判定：枚举相等比较不可用，按名称比。
isShapeKind|func(kind: ShapeKind, expected: ShapeKind,) -> (Bool,):
    return shapeKindName(kind) == shapeKindName(expected)

; 类别编码：跨包读形态的调用方按数比，不依赖枚举项能否跨包。
; 码序与枚举项序一致，1 到 6；新增形态追加在末尾，已有码不变。
shapeKindCode|func(kind: ShapeKind,) -> (I32,):
    match kind:
        case shapeStruct:
            return 1
        case shapeObject:
            return 2
        case shapeEnum:
            return 3
        case shapeOptional:
            return 4
        case shapeResult:
            return 5
        case shapeUnknown:
            return 6
    return 6

; 名义声明：结构、对象与枚举三类，其余不算。
isNominalDeclCode|func(_code: I32,) -> (Bool,):
    if isStructDeclCode(_code) || isObjectDeclCode(_code) || isGivenDeclCode(_code):
        return true
    return isEnumDeclCode(_code)

; 名义声明查找：按名字在全部单元里找顶层声明；未命中答空引用。
findNominalDecl|func(world: MemberWorld, name: String,) -> (DeclRef,):
    var out = DeclRef()
    var u = 0
    while u < len(world.units):
        let unit = world.units[u]
        let bytes = unitBytes(unit)
        var i = 0
        while i < len(unit.ast.items):
            let id = unit.ast.items[i]
            let decl = unit.ast.decls[id]
            if isNominalDeclCode(decl.kind) && decodeRange(bytes = bytes, start = decl.nameStart, end = decl.nameEnd) == name:
                out.unit = u
                out.decl = id
                return out
            i = i + 1
        u = u + 1
    return out

; 用例载荷：形参按声明序回类型表，缺项留 -1 占位。
variantPayload|func(world: MemberWorld, unitIndex: I32, decl: DeclNode,) -> (Array<I32>,):
    var out: Array<I32> = []
    var i = 0
    while i < len(decl.kids):
        let kid = decl.kids[i]
        if isParamDeclCode(world.units[unitIndex].ast.decls[kid].kind):
            out = out.append(world.types.typeOf(unit = unitIndex, decl = kid))
        i = i + 1
    return out

; 单条形态：结构取字段表，枚举取用例表，两者都按声明序；类型一律回类型表的绑定。
shapeOfDecl|func(world: MemberWorld, ref: DeclRef, typeId: I32,) -> (ShapeEntry,):
    var out = ShapeEntry()
    out.typeId = typeId
    let unit = world.units[ref.unit]
    let decl = unit.ast.decls[ref.decl]
    let bytes = unitBytes(unit)
    if isStructDeclCode(decl.kind) || isGivenDeclCode(decl.kind):
        out.kind = .shapeStruct
    elif isObjectDeclCode(decl.kind):
        out.kind = .shapeObject
    else:
        out.kind = .shapeEnum
    var i = 0
    while i < len(decl.kids):
        let kid = decl.kids[i]
        let child = unit.ast.decls[kid]
        if isFieldDeclCode(child.kind):
            var field = ShapeField()
            field.name = decodeRange(bytes = bytes, start = child.nameStart, end = child.nameEnd)
            field.typeId = world.types.typeOf(unit = ref.unit, decl = kid)
            out.fields = out.fields.append(field)
        elif isVariantDeclCode(child.kind):
            var variant = ShapeCase()
            variant.name = decodeRange(bytes = bytes, start = child.nameStart, end = child.nameEnd)
            variant.payload = variantPayload(world = world, unitIndex = ref.unit, decl = child)
            out.cases = out.cases.append(variant)
        i = i + 1
    return out

; 建表：按池序取名义类型，模板与实例分开成形；条目因此恒按类型下标升序。
; 泛型模板本身没有形态，只有带实参的实例成条；实参未定的占位条目同样跳过。
makeShapeTable|func(_world: MemberWorld,) -> (ShapeTable,):
    var out = ShapeTable()
    var i = 0
    while i < len(_world.types.pool.entries):
        let entry = _world.types.pool.entries[i]
        if isNominalClass(entry.kind):
            let ref = findNominalDecl(world = _world, name = entry.name)
            if ref.unit >= 0:
                let decl = _world.units[ref.unit].ast.decls[ref.decl]
                if len(decl.generic) == 0:
                    out.entries = out.entries.append(shapeOfDecl(world = _world, ref = ref, typeId = i))
                elif len(entry.kids) > 0:
                    let at = _world.types.findTypeInstance(i)
                    if at >= 0:
                        let inst = _world.types.instances[at]
                        let iw = worldWithOverrides(world = _world, overrides = inst.overrides)
                        out.entries = out.entries.append(shapeOfDecl(world = iw, ref = ref, typeId = i))
        i = i + 1
    return out

((ShapeTable))
; 条目数：下标合法区间是 0 到 count() - 1。
count|self() -> (I32,):
    return len(self.entries)
; 条目读：下标越界是运行时陷阱，调用方先经 findShape 取下标。
entryAt|self(_index: I32,) -> (ShapeEntry,):
    return self.entries[_index]

; 按类型下标查条目：升序表线性扫，未命中答 -1。
findShape|func(table: ShapeTable, typeId: I32,) -> (I32,):
    var i = 0
    while i < len(table.entries):
        if table.entries[i].typeId == typeId:
            return i
        i = i + 1
    return -1

; 取条目：未命中答空条目，调用方不必先判下标。
shapeAt|func(table: ShapeTable, typeId: I32,) -> (ShapeEntry,):
    let at = findShape(table = table, typeId = typeId)
    if at < 0:
        return ShapeEntry()
    return table.entries[at]

; 实例绑定：模板形参名对到实参类型；只在实例内生效，不改全局绑定。
instanceBinds|func(world: MemberWorld, ref: DeclRef, decl: DeclNode, argIds: Array<I32>,) -> (Array<GenericBinding>,):
    var out: Array<GenericBinding> = []
    let unit = world.units[ref.unit]
    let bytes = unitBytes(unit)
    var g = 0
    while g < len(decl.generic) && g < len(argIds):
        let param = unit.ast.decls[decl.generic[g]]
        var bind = GenericBinding()
        bind.name = decodeRange(bytes = bytes, start = param.nameStart, end = param.nameEnd)
        bind.typeId = argIds[g]
        out = out.append(bind)
        g = g + 1
    return out

; 类型替换：形参名命中实例绑定即换实参，其余逐 kids 递归；同形结果仍走池驻留。
substituteType|func(pool: TypePool, id: I32, binds: Array<GenericBinding>,) -> (TypeInsert,):
    var out = TypeInsert()
    if id < 0 || id >= len(pool.entries):
        out.pool = pool
        out.id = id
        return out
    let entry = pool.entries[id]
    if isTypeClass(kind = entry.kind, expected = .typeClassOpaque):
        var b = 0
        while b < len(binds):
            if binds[b].name == entry.name:
                out.pool = pool
                out.id = binds[b].typeId
                return out
            b = b + 1
        out.pool = pool
        out.id = id
        return out
    var working = pool
    var kids: Array<I32> = []
    var changed = false
    var i = 0
    while i < len(entry.kids):
        let one = substituteType(pool = working, id = entry.kids[i], binds = binds)
        working = one.pool
        kids = kids.append(one.id)
        if one.id != entry.kids[i]:
            changed = true
        i = i + 1
    var ret = entry.ret
    if entry.ret >= 0:
        let one = substituteType(pool = working, id = entry.ret, binds = binds)
        working = one.pool
        ret = one.id
        if one.id != entry.ret:
            changed = true
    if !changed:
        out.pool = working
        out.id = id
        return out
    let inserted = intern(pool = working, kind = entry.kind, name = entry.name, kids = kids, ret = ret)
    return inserted

; 逐声明替换：先取该声明的全局绑定，再按实例绑定递归替换；没绑定的声明跳过。
addDeclOverrides|func(stage: TypeOverridePass, table: TypeTable, units: Array<CompilationUnit>, unitIndex: I32, declId: I32, binds: Array<GenericBinding>,) -> (TypeOverridePass,):
    var out = stage
    let declared = table.typeOf(unit = unitIndex, decl = declId)
    if declared >= 0:
        let swapped = substituteType(pool = out.pool, id = declared, binds = binds)
        out.pool = swapped.pool
        if swapped.id >= 0:
            var bind = TypeBinding()
            bind.unit = unitIndex
            bind.decl = declId
            bind.typeId = swapped.id
            out.overrides = out.overrides.append(bind)
    let unit = units[unitIndex]
    let decl = unit.ast.decls[declId]
    var i = 0
    while i < len(decl.kids):
        out = addDeclOverrides(stage = out, table = table, units = units, unitIndex = unitIndex, declId = decl.kids[i], binds = binds)
        i = i + 1
    return out

; 扩展块：同名块整块记一条实例类型，块内成员的类型同批替换；方法体的 self 因此是实例。
addOwnerBlockOverrides|func(stage: TypeOverridePass, table: TypeTable, units: Array<CompilationUnit>, binds: Array<GenericBinding>, typeId: I32, owner: String,) -> (TypeOverridePass,):
    var out = stage
    var u = 0
    while u < len(units):
        let unit = units[u]
        let bytes = unitBytes(unit)
        var d = 0
        while d < unit.ast.declCount():
            let decl = unit.ast.decls[d]
            if isExtensionDeclCode(decl.kind):
                let blockName = decodeRange(bytes = bytes, start = decl.nameStart, end = decl.nameEnd)
                if blockName == owner:
                    var bind = TypeBinding()
                    bind.unit = u
                    bind.decl = d
                    bind.typeId = typeId
                    out.overrides = out.overrides.append(bind)
                    out = addDeclOverrides(stage = out, table = table, units = units, unitIndex = u, declId = d, binds = binds)
            d = d + 1
        u = u + 1
    return out

; 实参里含不透明类型即模板占位，不是具体实例；这类条目不建替换表。
hasOpaqueArg|func(pool: TypePool, ids: Array<I32>,) -> (Bool,):
    var i = 0
    while i < len(ids):
        let id = ids[i]
        if id >= 0 && id < len(pool.entries):
            if isTypeClass(kind = pool.entries[id].kind, expected = .typeClassOpaque):
                return true
        i = i + 1
    return false

; 实例表：逐条带实参的名义条目算一次替换表，字段、载荷与方法签名都在其中。
; 池在替换中增长，故按增长后的长度续扫；含不透明实参的条目留作模板占位。
attachTypeInstances|func(world: MemberWorld,) -> (MemberWorld,):
    var out = world
    var table = out.types
    var pool = table.pool
    var i = 0
    while i < len(pool.entries):
        let entry = pool.entries[i]
        if isNominalClass(entry.kind) && len(entry.kids) > 0 && table.findTypeInstance(i) < 0 && !hasOpaqueArg(pool = pool, ids = entry.kids) && len(composedParentNames(world = out, owner = entry.name)) == 0:
            let ref = findNominalDecl(world = out, name = entry.name)
            if ref.unit >= 0:
                let decl = out.units[ref.unit].ast.decls[ref.decl]
                if len(decl.generic) == len(entry.kids):
                    let binds = instanceBinds(world = out, ref = ref, decl = decl, argIds = entry.kids)
                    var stage = TypeOverridePass()
                    stage.pool = pool
                    var 表面 = table
                    表面.pool = pool
                    stage = addDeclOverrides(stage = stage, table = 表面, units = out.units, unitIndex = ref.unit, declId = ref.decl, binds = binds)
                    stage = addOwnerBlockOverrides(stage = stage, table = 表面, units = out.units, binds = binds, typeId = i, owner = entry.name)
                    var inst = TypeInstance()
                    inst.typeId = i
                    inst.unit = ref.unit
                    inst.decl = ref.decl
                    inst.argIds = entry.kids
                    inst.overrides = stage.overrides
                    table.instances = table.instances.append(inst)
                    pool = stage.pool
        i = i + 1
    table.pool = pool
    out.types = table
    return out

; 换替换表的世界：只换类型表的替换项，其余逐字段沿用。
worldWithOverrides|func(world: MemberWorld, overrides: Array<TypeBinding>,) -> (MemberWorld,):
    var out = world
    var table = out.types
    table.overrides = overrides
    out.types = table
    return out

; 预驻留：把标注位上的用户泛型实例先算进池，实例表因此在推导之前就绪。
; 只驻留类型，不记替换表 —— 替换表由 attachTypeInstances 一次算全。
preinternTypeInstances|func(world: MemberWorld,) -> (MemberWorld,):
    var out = world
    var u = 0
    while u < len(out.units):
        let unit = out.units[u]
        let bytes = unitBytes(unit)
        var t = 0
        while t < unit.ast.typeCount():
            let node = unit.ast.typeAt(t)
            if isGenericTypeCode(node.kind):
                let name = decodeRange(bytes = bytes, start = node.nameStart, end = node.nameEnd)
                if containerMinArity(name) < 0:
                    out = preinternOne(world = out, unit = unit, unitIndex = u, bytes = bytes, node = node, name = name)
            t = t + 1
        u = u + 1
    return out

; 单条预驻留：实参先解析，名字命中用户泛型声明才驻留；任一步不成立即留给推导期报错。
preinternOne|func(world: MemberWorld, unit: CompilationUnit, unitIndex: I32, bytes: Array<U8>, node: TypeNode, name: String,) -> (MemberWorld,):
    var out = world
    var types = TypeWorld()
    types.units = out.units
    types.table = out.table
    types.genericBindings = out.genericBindings
    var cursor = TypeCursor()
    cursor.world = types
    cursor.ast = unit.ast
    cursor.bytes = bytes
    cursor.file = unit.path
    var pool = out.types.pool
    var ids: Array<I32> = []
    var k = 0
    while k < len(node.kids):
        let resolved = resolveNode(cursor = cursor, pool = pool, typeId = node.kids[k])
        pool = resolved.pool
        if resolved.root < 0:
            return out
        ids = ids.append(resolved.root)
        k = k + 1
    let ref = findDeclIn(world = types, name = name)
    if ref.unit < 0:
        return out
    let decl = out.units[ref.unit].ast.decls[ref.decl]
    if len(decl.generic) != len(ids):
        return out
    let inserted = intern(pool = pool, kind = nominalClassOfDecl(decl), name = name, kids = ids, ret = -1)
    var 类型面 = out.types
    类型面.pool = inserted.pool
    out.types = 类型面
    return out
