[interface|import]
_syntax = "../../../syntax"
_module_loader = "../../../module-loader"

; 包接口文本：包名、公开声明名与公开名义类型的槽布局，一行一条。
; 只收 public：`_` 名字、`_` 文件与 `_` 目录里的声明都不进，内部实现改动不动文本。
; 行按字节序排好，同一包两次生成逐字相同；下游按整份文本判失效。

; 接口错误：包名、首个差异行号与两侧文本；漂移只报一处，避免同一改动刷屏。
(InterfaceError)
file: String = ""
offset: I32 = 0
name: String = ""
detail: String = ""

; 漂移结果：是否变了、首个差异行（1 起，0 表示无）、两侧该行与两侧多出的行。
(InterfaceDrift)
changed: Bool = false
line: I32 = 0
expected: String = ""
got: String = ""
missing: Array<String> = []
extra: Array<String> = []

; 接口记录：包名与整份文本；文本以换行结尾，最后一行之后不再补空行。
(InterfaceRecord)
name: String = ""
text: String = ""

; 声明是否进包面：块头名与扩展块名不是包级符号，测试函数不进接口。
; 四类块名只是标签；扩展块名是已有类型名，重复列出会让同名行出现两次。
isInterfaceDecl|func(_decl: DeclNode,) -> (Bool,):
    if isImportBlockCode(_decl.kind) || isExportBlockCode(_decl.kind):
        return false
    if isForeignDeclCode(_decl.kind) || isGivenDeclCode(_decl.kind):
        return false
    if isExtensionDeclCode(_decl.kind):
        return false
    return !_decl.isTest

; 公开名：顶层声明名按名字与路径推可见性，非 public 答空串。
publicNameOf|func(unit: CompilationUnit, bytes: Array<U8>, decl: DeclNode,) -> (String,):
    if !isInterfaceDecl(decl):
        return ""
    let name = decodeRange(bytes = bytes, start = decl.nameStart, end = decl.nameEnd)
    if len(name) == 0:
        return ""
    if !isExported(visibilityOf(spelling = name, path = unit.path)):
        return ""
    return name

; 逐单元收集公开名：单元按调用方给的次序，结果另行排序，次序不影响文本。
collectPublicNames|func(_units: Array<CompilationUnit>,) -> (Array<String>,):
    var out: Array<String> = []
    var u = 0
    while u < len(_units):
        let unit = _units[u]
        let bytes = unitBytes(unit)
        var i = 0
        while i < len(unit.ast.items):
            let name = publicNameOf(unit = unit, bytes = bytes, decl = unit.ast.decls[unit.ast.items[i]])
            if len(name) > 0:
                out = out.append(name)
            i = i + 1
        u = u + 1
    return out

; 名字排序：按 UTF-8 字节序插入排序，与平台 locale 无关。
sortedNames|func(_items: Array<String>,) -> (Array<String>,):
    var out = _items
    var i = 1
    while i < len(out):
        let value = out[i]
        var j = i - 1
        while j >= 0 && compareFlagText(a = out[j], b = value) > 0:
            out[j + 1] = out[j]
            j = j - 1
        out[j + 1] = value
        i = i + 1
    return out

; 压空白：连续空白折成一个空格，首尾不留；类型写法里的换行不进接口行。
squashSpace|func(_text: String,) -> (String,):
    var out = ""
    var pending = false
    var i = 0
    while i < len(_text):
        let ch = _text[i]
        if ch == " " || ch == "\t" || ch == "\n" || ch == "\r":
            if len(out) > 0:
                pending = true
        else:
            if pending:
                out = out + " "
                pending = false
            out = out + "\(ch)"
        i = i + 1
    return out

; 类型文本：取类型节点的源内区间原文；没有类型节点答空元组。
; 只压空白不重排，等价写法仍算不同——接口判失效宁严不漏。
typeTextOf|func(unit: CompilationUnit, bytes: Array<U8>, node: I32,) -> (String,):
    if node < 0 || node >= unit.ast.typeCount():
        return "()"
    let type = unit.ast.typeAt(node)
    return squashSpace(decodeRange(bytes = bytes, start = type.start, end = type.end))

; 签名行：函数名、参数名与类型、返回类型；非函数答空串。
; 参数名是调用点标签的一部分，改标签同样使下游失效。
signatureLine|func(unit: CompilationUnit, bytes: Array<U8>, decl: DeclNode,) -> (String,):
    if !isFunctionDeclCode(decl.kind):
        return ""
    let name = decodeRange(bytes = bytes, start = decl.nameStart, end = decl.nameEnd)
    var text = "sig " + name + "("
    var written = 0
    var i = 0
    while i < len(decl.kids):
        let param = unit.ast.decls[decl.kids[i]]
        if isParamDeclCode(param.kind):
            if written > 0:
                text = text + ", "
            let paramName = decodeRange(bytes = bytes, start = param.nameStart, end = param.nameEnd)
            text = text + paramName + ": " + typeTextOf(unit = unit, bytes = bytes, node = param.typeId)
            written = written + 1
        i = i + 1
    return text + ") -> " + typeTextOf(unit = unit, bytes = bytes, node = decl.typeId)

; 逐单元收集签名行：公开名先过同一判据，再拼签名；结果另行排序。
collectSignatures|func(_units: Array<CompilationUnit>,) -> (Array<String>,):
    var out: Array<String> = []
    var u = 0
    while u < len(_units):
        let unit = _units[u]
        let bytes = unitBytes(unit)
        var i = 0
        while i < len(unit.ast.items):
            let decl = unit.ast.decls[unit.ast.items[i]]
            if len(publicNameOf(unit = unit, bytes = bytes, decl = decl)) > 0:
                let line = signatureLine(unit = unit, bytes = bytes, decl = decl)
                if len(line) > 0:
                    out = out.append(line)
            i = i + 1
        u = u + 1
    return out

fieldSlotText|func(_layout: LayoutEntry,) -> (String,):
    var text = ""
    var written = 0
    var i = 0
    while i < len(_layout.slots):
        let slot = _layout.slots[i]
        if isSlotRole(role = slot.role, expected = .slotField):
            if written > 0:
                text = text + ","
            text = text + slot.name
            written = written + 1
        i = i + 1
    return text

; 用例序：枚举用例名按声明序，逗号连接；空表答空串。
caseSlotText|func(_layout: LayoutEntry,) -> (String,):
    var text = ""
    var i = 0
    while i < len(_layout.cases):
        if i > 0:
            text = text + ","
        text = text + _layout.cases[i].name
        i = i + 1
    return text

; 布局行：公开名义类型的槽数与成员序；槽是布局单位，字节口径不进这里。
; 结构与非枚举名义类型写字段名，枚举写用例名；非名义类型答空串。
interfaceLayoutLine|func(world: MemberWorld, shapes: ShapeTable, name: String,) -> (String,):
    let typeId = nominalTypeId(world = world, name = name)
    if typeId < 0:
        return ""
    let entry = world.types.pool.entries[typeId]
    if !isNominalClass(entry.kind):
        return ""
    let layout = layoutOf(shapes = shapes, pool = world.types.pool, typeId = typeId)
    if layout.slotCount < 0:
        return ""
    var text = "layout " + name + " " + shapeKindName(layout.shape) + " slots=" + "\(layout.slotCount)"
    if isShapeKind(kind = layout.shape, expected = .shapeEnum):
        text = text + " cases=" + caseSlotText(layout)
    else:
        text = text + " fields=" + fieldSlotText(layout)
    return text

; 接口文本：头行、公开名行、签名行与布局行四段；各段自行排序，段序固定。
; 名字段认声明存在，签名段认调用契约，布局段认槽位；改签名或改槽位都会使文本变。
interfaceText|func(name: String, units: Array<CompilationUnit>, world: MemberWorld,) -> (String,):
    var text = "package=" + name + "\n"
    let names = sortedNames(collectPublicNames(units))
    var i = 0
    while i < len(names):
        text = text + names[i] + "\n"
        i = i + 1
    let signatures = sortedNames(collectSignatures(units))
    i = 0
    while i < len(signatures):
        text = text + signatures[i] + "\n"
        i = i + 1
    let shapes = makeShapeTable(world)
    var j = 0
    while j < len(names):
        let line = interfaceLayoutLine(world = world, shapes = shapes, name = names[j])
        if len(line) > 0:
            text = text + line + "\n"
        j = j + 1
    return text

; 接口记录：文本连同包名一起带回，下游按名对照。
interfaceRecord|func(name: String, units: Array<CompilationUnit>, world: MemberWorld,) -> (InterfaceRecord,):
    var out = InterfaceRecord()
    out.name = name
    out.text = interfaceText(name = name, units = units, world = world)
    return out

; 行表：按换行拆开，空串答空表；末尾换行不产生空行。
interfaceLines|func(_text: String,) -> (Array<String>,):
    var out: Array<String> = []
    if len(_text) == 0:
        return out
    let parts = _text.split("\n")
    var i = 0
    while i < len(parts):
        if len(parts[i]) > 0:
            out = out.append(parts[i])
        i = i + 1
    return out

; 行是否在表里：整行相等即命中。
hasLine|func(lines: Array<String>, line: String,) -> (Bool,):
    var i = 0
    while i < len(lines):
        if lines[i] == line:
            return true
        i = i + 1
    return false

; 差集：左表有而右表没有的行，按左表原序；行表已排序，结果因此也有序。
linesOnlyIn|func(left: Array<String>, right: Array<String>,) -> (Array<String>,):
    var out: Array<String> = []
    var i = 0
    while i < len(left):
        if !hasLine(lines = right, line = left[i]):
            out = out.append(left[i])
        i = i + 1
    return out

; 漂移判定：逐行比首个不同处，两侧多出的行各列一份；行数相同且逐行相同才算未变。
interfaceDrift|func(recorded: String, current: String,) -> (InterfaceDrift,):
    var out = InterfaceDrift()
    let left = interfaceLines(recorded)
    let right = interfaceLines(current)
    out.missing = linesOnlyIn(left = left, right = right)
    out.extra = linesOnlyIn(left = right, right = left)
    var i = 0
    while i < len(left) && i < len(right):
        if left[i] != right[i]:
            out.changed = true
            out.line = i + 1
            out.expected = left[i]
            out.got = right[i]
            return out
        i = i + 1
    if len(left) != len(right):
        out.changed = true
        out.line = i + 1
        if i < len(left):
            out.expected = left[i]
        if i < len(right):
            out.got = right[i]
    return out

; 漂移错误：包级诊断，位置取包根起点；描述只带首个差异行号。
interfaceDriftError|func(record: InterfaceRecord, drift: InterfaceDrift,) -> (InterfaceError,):
    var out = InterfaceError()
    out.file = record.name
    out.offset = 0
    out.name = record.name
    if len(drift.missing) > 0 || len(drift.extra) > 0:
        out.detail = "第 " + "\(drift.line)" + " 行起不同（少 " + "\(len(drift.missing))" + " 行，多 " + "\(len(drift.extra))" + " 行）"
    else:
        out.detail = "第 " + "\(drift.line)" + " 行不同"
    return out

; 诊断码：接口漂移一枚专用码，与「非 public」和「依赖未声明」分开。
interfaceErrorCode|func() -> (String,):
    return "E3-021"
