[foreign_call|import]
_syntax = "../../../syntax"
_module_loader = "../../../module-loader"

; 外部调用点判型：回调实参的来历与签名、变参尾的实参类型。
; 回调只收顶层自由函数的名字，方法、闭包、局部值、main 与 |test 都不行，签名要逐位相同。
; 尾部只收 C 标量与指针，`String` 按借出；宽度不在 IR 的类型在声明处已拦，这里不再分段。

; 尾部实参理由：空串表示放行；指针、String 与七种标量之外各给一句原因。
tailTypeReason|func(pool: TypePool, id: I32,) -> (String,):
    if id < 0 || id >= len(pool.entries):
        return "类型未定"
    let entry = pool.entries[id]
    if isTypeClass(kind = entry.kind, expected = .typeClassPointer):
        return ""
    if !isTypeClass(kind = entry.kind, expected = .typeClassScalar):
        return "C 变参只收标量、指针与 String"
    if entry.name == "String":
        return ""
    if isForeignScalarName(entry.name):
        return ""
    return "C 变参不收 Char 与不在 IR 宽度的类型"

; 回调目标：理由为空表示合格，symbol 是解析到的顶层自由函数；不合格时 symbol 为 -1。
(CallbackTarget)
reason: String = ""
symbol: I32 = -1

; 回调来历：实参必须是本单元能解析到的顶层自由函数。
; 单元下标缺失时无从回看实参节点，按待定放行，不拿位置猜。
callbackTarget|func(world: MemberWorld, site: CallSite, node: I32,) -> (CallbackTarget,):
    var out = CallbackTarget()
    if site.unit < 0 || site.unit >= len(world.units):
        return out
    let unit = world.units[site.unit]
    if node < 0 || node >= unit.ast.exprCount():
        out.reason = "实参不是名字"
        return out
    if !unit.ast.isIdentifierExpr(node):
        out.reason = "回调实参只能写顶层自由函数的名字"
        return out
    let expr = unit.ast.exprAt(node)
    let name = decodeRange(bytes = unitBytes(unit), start = expr.nameStart, end = expr.nameEnd)
    if name == "main":
        out.reason = "main 不作回调"
        return out
    let symbol = lookupTopByName(index = world.symbols, name = name)
    if symbol < 0:
        out.reason = "名字未解析到顶层函数"
        return out
    let entry = world.table.symbolAt(symbol)
    if !isSymbolKind(kind = entry.kind, expected = .symbolFunction):
        out.reason = "名字不是函数"
        return out
    if len(entry.owner) > 0:
        out.reason = "方法是成员，不作回调"
        return out
    let ref = symbolDecl(world = world, symbol = symbol)
    if ref.unit < 0:
        out.reason = "函数声明未找到"
        return out
    let decl = world.units[ref.unit].ast.decls[ref.decl]
    if decl.isTest:
        out.reason = "|test 函数不作回调"
        return out
    if decl.isSelf:
        out.reason = "方法不作回调"
        return out
    if decl.isForeign:
        out.reason = "外部函数不作回调"
        return out
    out.symbol = symbol
    return out

; 回调签名：形参逐位与返回都要与形参声明相同；空串表示相同。
callbackSignatureReason|func(world: MemberWorld, ref: DeclRef, sig: TypeEntry,) -> (String,):
    let unit = world.units[ref.unit]
    let decl = unit.ast.decls[ref.decl]
    var params: Array<I32> = []
    var i = 0
    while i < len(decl.kids):
        let kid = decl.kids[i]
        if isParamDeclCode(unit.ast.decls[kid].kind):
            params = params.append(world.types.typeOf(unit = ref.unit, decl = kid))
        i = i + 1
    if len(params) != len(sig.kids):
        return "形参个数不同"
    if !sameTypeIds(first = params, second = sig.kids):
        return "形参类型不同"
    if world.types.typeOf(unit = ref.unit, decl = ref.decl) != sig.ret:
        return "返回类型不同"
    return ""

; 回调位：逐位判形参是函数类型的那几格，来历与签名都过才继续。
checkCallbackArgs|func(world: MemberWorld, out: CallResult, site: CallSite, sig: TypeEntry,) -> (CallResult,):
    var working = out
    var i = 0
    while i < len(sig.kids) && i < len(site.args):
        let slot = sig.kids[i]
        if slot >= 0 && slot < len(working.pool.entries) && isTypeClass(kind = working.pool.entries[slot].kind, expected = .typeClassFunction):
            let arg = site.args[i]
            let target = callbackTarget(world = world, site = site, node = arg.node)
            if len(target.reason) > 0:
                return failCall(out = working, site = site, offset = arg.offset, kind = .callCallback, expected = "顶层自由函数名", got = target.reason)
            if target.symbol >= 0:
                let ref = symbolDecl(world = world, symbol = target.symbol)
                if ref.unit >= 0:
                    let mismatch = callbackSignatureReason(world = world, ref = ref, sig = working.pool.entries[slot])
                    if len(mismatch) > 0:
                        return failCall(out = working, site = site, offset = arg.offset, kind = .callCallback, expected = "签名逐位相同", got = mismatch)
        i = i + 1
    return working

; 只读写入：名字命中外部数据符号且带 readonly（macro 已规范化并入）时答一句原因。
; 其余情况答空串，让赋值面继续按可变性与类型判。
readonlyWriteReason|func(world: MemberWorld, name: String,) -> (String,):
    let symbol = lookupTopByName(index = world.symbols, name = name)
    if symbol < 0:
        return ""
    let entry = world.table.symbolAt(symbol)
    if !entry.isForeign:
        return ""
    if !isSymbolKind(kind = entry.kind, expected = .symbolVariable):
        return ""
    if containsFlagText(items = entry.foreignFlags, name = "readonly"):
        return "外部数据符号标为只读"
    return ""

; 尾部：固定前缀之后的实参逐个判；未定型的跳过，位置取实参起点。
checkTailArgs|func(out: CallResult, site: CallSite, fixed: I32,) -> (CallResult,):
    var working = out
    var i = fixed
    while i < len(site.args):
        let arg = site.args[i]
        if arg.typeId >= 0:
            let reason = tailTypeReason(pool = working.pool, id = arg.typeId)
            if len(reason) > 0:
                let got = typeText(pool = working.pool, id = arg.typeId) + "（" + reason + "）"
                return failCall(out = working, site = site, offset = arg.offset, kind = .callVarargsTail, expected = "C 标量、指针或 String", got = got)
        i = i + 1
    return working

; 外部调用：签名取自符号绑定；形参不接标签，变参标志决定尾部放不放。
checkForeignCall|func(world: MemberWorld, out: CallResult, site: CallSite, ref: DeclRef,) -> (CallResult,):
    var working = out
    let sigId = world.types.typeOf(unit = ref.unit, decl = ref.decl)
    if sigId < 0 || sigId >= len(working.pool.entries):
        return deferCall(working)
    let sig = working.pool.entries[sigId]
    if !isTypeClass(kind = sig.kind, expected = .typeClassFunction):
        return failCall(out = working, site = site, offset = site.offset, kind = .callNotCallable, expected = "外部函数", got = "数据符号")
    let symbol = world.table.symbolAt(site.symbol)
    let varargs = containsFlagText(items = symbol.foreignFlags, name = "varargs")
    var params: Array<CallParam> = []
    var i = 0
    while i < len(sig.kids):
        var param = CallParam()
        param.name = "第 " + countText(i + 1) + " 个"
        param.typeId = sig.kids[i]
        param.takesLabel = false
        params = params.append(param)
        i = i + 1
    working = checkCallbackArgs(world = world, out = working, site = site, sig = sig)
    if working.failed:
        return working
    var limit = len(site.args)
    if varargs && len(sig.kids) < limit:
        limit = len(sig.kids)
    let matched = matchCall(out = working, site = site, params = params, variadic = false, tailStart = limit, retId = sig.ret)
    if matched.failed:
        return matched
    if !varargs:
        return matched
    return checkTailArgs(out = matched, site = site, fixed = len(sig.kids))
