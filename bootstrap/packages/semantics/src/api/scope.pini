[scope|import]
_syntax = "../../../syntax"

; 局部符号：参数、自身、局部变量、循环变量与模式绑定各一类。
[LocalKind]
localParam
localSelf
localVariable
localLoopVar
localBinding

; 作用域帧：函数、块、循环与匹配臂各一层。
[ScopeKind]
scopeFunction
scopeBlock
scopeLoop
scopeArm

; 局部符号：键用于查找，拼写只服务诊断；slot 是函数内唯一的存储位。
(LocalSymbol)
key: Array<U8> = []
spelling: String = ""
kind: LocalKind = .localVariable
mutable: Bool = true
typeId: I32 = -1
file: String = ""
offset: I32 = 0
decl: I32 = -1
slot: I32 = -1
frame: I32 = -1

; 作用域帧：start 指向局部表起点，baseSlot 是进帧前的槽位水位。
(ScopeFrame)
kind: ScopeKind = .scopeBlock
start: I32 = 0
baseSlot: I32 = 0
file: String = ""
offset: I32 = 0

; 作用域栈：帧与局部同表存放，查找由内向外；槽位在函数内单调。
(ScopeStack)
frames: Array<ScopeFrame> = []
locals: Array<LocalSymbol> = []
nextSlot: I32 = 0

; 局部声明错误：同帧重名与无帧声明各一类；跨帧遮蔽不算错误。
[ScopeErrorKind]
scopeLocalDuplicated
scopeNoFrame

; 局部错误：类别、文件、源内偏移与原始拼写；位置指向声明头。
(ScopeError)
kind: ScopeErrorKind = .scopeLocalDuplicated
file: String = ""
offset: I32 = 0
spelling: String = ""

; 声明结果：新栈、命中下标与错误；failed 为真时栈与下标都保持原样。
(ScopeDeclare)
stack: ScopeStack = ScopeStack()
index: I32 = -1
error: ScopeError = ScopeError()
failed: Bool = false

; 局部种类名：诊断、测试与回执共用一份拼写。
localKindName|func(_kind: LocalKind,) -> (String,):
    match _kind:
        case localParam:
            return "参数"
        case localSelf:
            return "自身"
        case localVariable:
            return "局部变量"
        case localLoopVar:
            return "循环变量"
        case localBinding:
            return "模式绑定"
    return "局部"

; 同一局部种类判定：枚举相等比较不可用，按名称比。
isLocalKind|func(kind: LocalKind, expected: LocalKind,) -> (Bool,):
    return localKindName(kind) == localKindName(expected)

; 跨包判定：枚举项不能跨包引用，下游按种类逐个问。
isParamLocal|func(_kind: LocalKind,) -> (Bool,):
    return localKindName(_kind) == localKindName(.localParam)

isSelfLocal|func(_kind: LocalKind,) -> (Bool,):
    return localKindName(_kind) == localKindName(.localSelf)

isVariableLocal|func(_kind: LocalKind,) -> (Bool,):
    return localKindName(_kind) == localKindName(.localVariable)

isLoopVarLocal|func(_kind: LocalKind,) -> (Bool,):
    return localKindName(_kind) == localKindName(.localLoopVar)

isBindingLocal|func(_kind: LocalKind,) -> (Bool,):
    return localKindName(_kind) == localKindName(.localBinding)

; 帧种类名：与计划件的四类帧同名。
scopeKindName|func(_kind: ScopeKind,) -> (String,):
    match _kind:
        case scopeFunction:
            return "函数"
        case scopeBlock:
            return "块"
        case scopeLoop:
            return "循环"
        case scopeArm:
            return "匹配臂"
    return "作用域"

; 同一帧种类判定：与 isLocalKind 同规。
isScopeKind|func(kind: ScopeKind, expected: ScopeKind,) -> (Bool,):
    return scopeKindName(kind) == scopeKindName(expected)

; 造错误：位置取声明头的字节偏移，拼写取原文。
makeScopeError|func(kind: ScopeErrorKind, file: String, offset: I32, spelling: String,) -> (ScopeError,):
    var out = ScopeError()
    out.kind = kind
    out.file = file
    out.offset = offset
    out.spelling = spelling
    return out

; 错误类别判定：与 isLocalKind 同规。
isScopeError|func(error: ScopeError, kind: ScopeErrorKind,) -> (Bool,):
    return scopeErrorName(error.kind) == scopeErrorName(kind)

; 错误类别名：测试与诊断共用一份拼写。
scopeErrorName|func(_kind: ScopeErrorKind,) -> (String,):
    match _kind:
        case scopeLocalDuplicated:
            return "局部名字重复"
        case scopeNoFrame:
            return "没有可声明的帧"
    return "作用域错误"

; 进帧：帧起点取当前局部数，槽位水位一并记下。
enterScope|func(stack: ScopeStack, kind: ScopeKind, file: String, offset: I32,) -> (ScopeStack,):
    var out = stack
    var frame = ScopeFrame()
    frame.kind = kind
    frame.start = len(out.locals)
    frame.baseSlot = out.nextSlot
    frame.file = file
    frame.offset = offset
    out.frames = out.frames.append(frame)
    return out

; 退帧：截断到帧起点；函数帧退出时归还槽位，块帧不归还。
leaveScope|func(_stack: ScopeStack,) -> (ScopeStack,):
    if len(_stack.frames) == 0:
        return _stack
    let last = len(_stack.frames) - 1
    let frame = _stack.frames[last]
    var out = _stack
    out.frames = keepFrames(values = out.frames, count = last)
    out.locals = keepLocals(values = out.locals, count = frame.start)
    if isScopeKind(kind = frame.kind, expected = .scopeFunction):
        out.nextSlot = frame.baseSlot
    return out

; 截断帧表：保留前 count 项；count 越界按长度夹紧。
keepFrames|func(values: Array<ScopeFrame>, count: I32,) -> (Array<ScopeFrame>,):
    var out: Array<ScopeFrame> = []
    var i = 0
    while i < count && i < len(values):
        out = out.append(values[i])
        i = i + 1
    return out

; 截断局部表：与 keepFrames 同规。
keepLocals|func(values: Array<LocalSymbol>, count: I32,) -> (Array<LocalSymbol>,):
    var out: Array<LocalSymbol> = []
    var i = 0
    while i < count && i < len(values):
        out = out.append(values[i])
        i = i + 1
    return out

; 当前帧：空栈答 -1。
currentFrame|func(_stack: ScopeStack,) -> (I32,):
    return len(_stack.frames) - 1

; 同帧判重：只在当前帧的局部区间内按键找。
sameFrameHas|func(stack: ScopeStack, key: Array<U8>,) -> (Bool,):
    if len(stack.frames) == 0:
        return false
    let start = stack.frames[len(stack.frames) - 1].start
    var i = len(stack.locals) - 1
    while i >= start:
        if sameKey(first = stack.locals[i].key, second = key):
            return true
        i = i - 1
    return false

; 声明局部：同帧同键报重名；成功则追加并分配新槽位。
declareLocal|func(stack: ScopeStack, kind: LocalKind, spelling: String, typeId: I32, mutable: Bool, file: String, offset: I32, decl: I32,) -> (ScopeDeclare,):
    var out = ScopeDeclare()
    out.stack = stack
    if len(stack.frames) == 0:
        out.failed = true
        out.error = makeScopeError(kind = .scopeNoFrame, file = file, offset = offset, spelling = spelling)
        return out
    let key = keyOfText(spelling)
    if sameFrameHas(stack = stack, key = key):
        out.failed = true
        out.error = makeScopeError(kind = .scopeLocalDuplicated, file = file, offset = offset, spelling = spelling)
        return out
    var local = LocalSymbol()
    local.key = key
    local.spelling = spelling
    local.kind = kind
    local.mutable = mutable
    local.typeId = typeId
    local.file = file
    local.offset = offset
    local.decl = decl
    local.slot = stack.nextSlot
    local.frame = len(stack.frames) - 1
    var grown = stack
    grown.locals = grown.locals.append(local)
    grown.nextSlot = grown.nextSlot + 1
    out.stack = grown
    out.index = len(grown.locals) - 1
    return out

; 声明参数：名字从声明区间解码，参数默认可变。
declareParam|func(stack: ScopeStack, decl: DeclNode, declId: I32, typeId: I32, file: String, bytes: Array<U8>,) -> (ScopeDeclare,):
    let spelling = decodeRange(bytes = bytes, start = decl.nameStart, end = decl.nameEnd)
    return declareLocal(stack = stack, kind = .localParam, spelling = spelling, typeId = typeId, mutable = true, file = file, offset = decl.start, decl = declId)

; 声明自身：self 与 own 共用一条，默认不可赋值。
declareSelf|func(stack: ScopeStack, spelling: String, typeId: I32, file: String, offset: I32,) -> (ScopeDeclare,):
    return declareLocal(stack = stack, kind = .localSelf, spelling = spelling, typeId = typeId, mutable = false, file = file, offset = offset, decl = -1)

; 查找局部：由内向外逐帧、帧内由后向前；命中答局部表下标，未命中答 -1。
lookupLocal|func(stack: ScopeStack, key: Array<U8>,) -> (I32,):
    var upper = len(stack.locals)
    var f = len(stack.frames) - 1
    while f >= 0:
        let start = stack.frames[f].start
        var i = upper - 1
        while i >= start:
            if sameKey(first = stack.locals[i].key, second = key):
                return i
            i = i - 1
        upper = start
        f = f - 1
    return -1

; 查找名字：整串取 NFC 键后走 lookupLocal。
lookupName|func(stack: ScopeStack, spelling: String,) -> (I32,):
    return lookupLocal(stack = stack, key = keyOfText(spelling))

((ScopeStack))
; 帧数：当前嵌套层数。
frameCount|self() -> (I32,):
    return len(self.frames)
; 局部数：退帧会截断局部表，故这里只数在册的局部。
localCount|self() -> (I32,):
    return len(self.locals)
; 槽位水位：当前函数内已分配的下一个槽位。
slotCount|self() -> (I32,):
    return self.nextSlot
; 局部读取：下标越界是运行时陷阱，调用方先经 lookupLocal 取下标。
localAt|self(_index: I32,) -> (LocalSymbol,):
    return self.locals[_index]
; 帧读取：与 localAt 同规。
frameAt|self(_index: I32,) -> (ScopeFrame,):
    return self.frames[_index]
