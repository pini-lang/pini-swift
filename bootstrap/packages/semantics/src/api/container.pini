[container|import]
_syntax = "../../../syntax"
_module_loader = "../../../module-loader"

; 容器与索引判定：容器字面量的元素统一、下标读与切片，以及长度实参的约束。
; 期望按容器形状下传到元素；无期望时元素按同类型或同族数值提升合并，空字面量没有期望就报无法推断。
; 池与类型表须同源：表里的下标只在产生它的池里成立；下标三通道的 `get` 走成员调用，负索引留给运行时。

; 容器错误：元素不一致、缺少期望、类型不可下标、下标类型与下标缺失五类。
[ContainerErrorKind]
containerElementMismatch
containerNeedsExpectation
containerNotIndexable
containerIndexType
containerMissingIndex

; 容器错误：类别、文件、源内偏移与期望/实得文本；不可下标时存接收者类型与运算符拼写。
(ContainerError)
kind: ContainerErrorKind = .containerElementMismatch
file: String = ""
offset: I32 = 0
expected: String = ""
got: String = ""

; 判定结果：池、类型表、本节点类型、错误与待定标记。
(ContainerResult)
pool: TypePool = TypePool()
types: ExprTypes = ExprTypes()
typeId: I32 = -1
error: ContainerError = ContainerError()
failed: Bool = false
deferred: Bool = false

; 元素定型结果：池与类型表随补判增长，typeId 为 -1 表示尚不可定。
(ElementType)
pool: TypePool = TypePool()
types: ExprTypes = ExprTypes()
typeId: I32 = -1

; 错误类别名：诊断、测试与回执共用一份拼写。
containerErrorName|func(kind: ContainerErrorKind,) -> (String,):
    match kind:
        case containerElementMismatch:
            return "元素类型不一致"
        case containerNeedsExpectation:
            return "缺少期望类型"
        case containerNotIndexable:
            return "类型不可下标"
        case containerIndexType:
            return "下标类型不匹配"
        case containerMissingIndex:
            return "缺少下标"
    return "容器错误"

; 同一类别判定：枚举相等比较不可用，按名称比。
isContainerError|func(error: ContainerError, kind: ContainerErrorKind,) -> (Bool,):
    return containerErrorName(error.kind) == containerErrorName(kind)

; 诊断码：复用宿主已登记的码，不新增码表条目。
containerErrorCode|func(kind: ContainerErrorKind,) -> (String,):
    match kind:
        case containerElementMismatch:
            return "E4-001"
        case containerNeedsExpectation:
            return "E4-003"
        case containerNotIndexable:
            return "E4-004"
        case containerIndexType:
            return "E4-001"
        case containerMissingIndex:
            return "E4-001"
    return "E4-001"

; 造错误：位置取节点起点，期望与实得文本由调用方给。
makeContainerError|func(kind: ContainerErrorKind, file: String, offset: I32, expected: String, got: String,) -> (ContainerError,):
    var out = ContainerError()
    out.kind = kind
    out.file = file
    out.offset = offset
    out.expected = expected
    out.got = got
    return out

; 容器名：数组、字典与集合各一个拼写，其余答空串。
containerNameOf|func(pool: TypePool, id: I32,) -> (String,):
    if id < 0 || id >= len(pool.entries):
        return ""
    let entry = pool.entries[id]
    if !isTypeClass(entry.kind, typeClassCollection):
        return ""
    return entry.name

; 元素类型：数组与集合的第一个实参；其余答 -1。
elementTypeOf|func(pool: TypePool, id: I32,) -> (I32,):
    let name = containerNameOf(pool, id)
    if name != "Array" && name != "Set":
        return -1
    let entry = pool.entries[id]
    if len(entry.kids) == 0:
        return -1
    return entry.kids[0]

; 键类型：字典的第一个实参；其余答 -1。
keyTypeOf|func(pool: TypePool, id: I32,) -> (I32,):
    if containerNameOf(pool, id) != "Dictionary":
        return -1
    let entry = pool.entries[id]
    if len(entry.kids) < 1:
        return -1
    return entry.kids[0]

; 值类型：字典的第二个实参；其余答 -1。
valueTypeOf|func(pool: TypePool, id: I32,) -> (I32,):
    if containerNameOf(pool, id) != "Dictionary":
        return -1
    let entry = pool.entries[id]
    if len(entry.kids) < 2:
        return -1
    return entry.kids[1]

; 可取长：数组、字典、集合与字符串；`len` 的形参约束也用它。
isSizedType|func(pool: TypePool, id: I32,) -> (Bool,):
    if isStringType(pool, id):
        return true
    return len(containerNameOf(pool, id)) > 0

; 可切片：数组与字符串。
isSliceableType|func(pool: TypePool, id: I32,) -> (Bool,):
    if isStringType(pool, id):
        return true
    return containerNameOf(pool, id) == "Array"

; 元素定型：表里已判定的直接用；未判定且是基本字面量时按期望补判；其余交回未定。
elementTypeAt|func(unit: CompilationUnit, unitIndex: I32, node: I32, expected: I32, pool: TypePool, types: ExprTypes,) -> (ElementType,):
    var out = ElementType()
    out.pool = pool
    out.types = types
    if node < 0 || node >= unit.ast.exprCount():
        out.typeId = unsetTypeId()
        return out
    let known = exprTypeAt(types, unitIndex, node)
    if known == errorTypeId():
        out.typeId = errorTypeId()
        return out
    if known >= 0 && known < len(pool.entries):
        out.typeId = known
        return out
    if !unit.ast.isLiteralExpr(node):
        out.typeId = unsetTypeId()
        return out
    var wanted = noExpectation()
    if expected >= 0:
        wanted = expectType(expected)
    let checked = checkLiteral(unit, unitIndex, node, wanted, pool, types)
    out.pool = checked.pool
    out.types = checked.types
    if checked.failed:
        out.typeId = errorTypeId()
        return out
    out.typeId = checked.typeId
    return out

; 元素合并：同类型取自身，同族数值取宽侧，其余答 -1。
unifyElement|func(pool: TypePool, current: I32, next: I32,) -> (I32,):
    if current < 0:
        return next
    if sameType(pool, current, next):
        return current
    return promoteNumeric(pool, current, next)

; 失败收尾：写错误标记与错误记录。
failContainer|func(out: ContainerResult, unit: CompilationUnit, unitIndex: I32, node: I32, kind: ContainerErrorKind, expected: String, got: String,) -> (ContainerResult,):
    var done = out
    done.failed = true
    done.typeId = errorTypeId()
    done.types = writeExprType(out.types, unitIndex, node, errorTypeId())
    var offset = 0
    if node >= 0 && node < unit.ast.exprCount():
        offset = unit.ast.exprAt(node).start
    done.error = makeContainerError(kind, unit.path, offset, expected, got)
    return done

; 待定收尾：元素或接收者尚未定型，不报错也不写错误标记。
deferContainer|func(out: ContainerResult,) -> (ContainerResult,):
    var done = out
    done.deferred = true
    done.typeId = unsetTypeId()
    return done

; 成功收尾：写结果类型。
finishContainer|func(out: ContainerResult, unitIndex: I32, node: I32, typeId: I32,) -> (ContainerResult,):
    var done = out
    done.typeId = typeId
    done.types = writeExprType(out.types, unitIndex, node, typeId)
    return done

; 单元素收尾：按容器名与唯一实参驻留，池换新后写表。
finishSingle|func(out: ContainerResult, unitIndex: I32, node: I32, name: String, elem: I32,) -> (ContainerResult,):
    var args: Array<I32> = []
    args = args.append(elem)
    let inserted = intern(out.pool, typeClassCollection, name, args, -1)
    var done = out
    done.pool = inserted.pool
    return finishContainer(done, unitIndex, node, inserted.id)

; 序列字面量：数组与集合共用一条；期望给出元素类型时逐元素比对，否则合并元素。
checkSequenceLiteral|func(unit: CompilationUnit, unitIndex: I32, node: I32, expectation: Expectation, pool: TypePool, types: ExprTypes, name: String, emptyLabel: String,) -> (ContainerResult,):
    var out = ContainerResult()
    out.pool = pool
    out.types = types
    if node < 0 || node >= unit.ast.exprCount():
        return failContainer(out, unit, unitIndex, node, containerElementMismatch, name + " 字面量", "越界节点")
    var expectedElem = -1
    var expectedResult = -1
    if expectation.hasExpected && containerNameOf(pool, expectation.typeId) == name:
        expectedResult = expectation.typeId
        expectedElem = elementTypeOf(pool, expectation.typeId)
    let kids = unit.ast.exprAt(node).kids
    var merged = -1
    var i = 0
    while i < len(kids):
        let probe = elementTypeAt(unit, unitIndex, kids[i], expectedElem, out.pool, out.types)
        out.pool = probe.pool
        out.types = probe.types
        if probe.typeId == errorTypeId():
            return failContainer(out, unit, unitIndex, node, containerElementMismatch, "同类型元素", "已判错的元素")
        if probe.typeId < 0:
            return deferContainer(out)
        if expectedElem >= 0:
            if !isAssignable(out.pool, probe.typeId, expectedElem):
                return failContainer(out, unit, unitIndex, node, containerElementMismatch, typeText(out.pool, expectedElem), typeText(out.pool, probe.typeId))
        else:
            let joined = unifyElement(out.pool, merged, probe.typeId)
            if joined < 0:
                return failContainer(out, unit, unitIndex, node, containerElementMismatch, typeText(out.pool, merged), typeText(out.pool, probe.typeId))
            merged = joined
        i = i + 1
    if expectedResult >= 0:
        return finishContainer(out, unitIndex, node, expectedResult)
    if merged < 0:
        return failContainer(out, unit, unitIndex, node, containerNeedsExpectation, "", emptyLabel)
    return finishSingle(out, unitIndex, node, name, merged)

; 数组字面量：元素缺省 I32 一类由字面量判定给出，空表必须有期望。
checkArrayLiteral|func(unit: CompilationUnit, unitIndex: I32, node: I32, expectation: Expectation, pool: TypePool, types: ExprTypes,) -> (ContainerResult,):
    return checkSequenceLiteral(unit, unitIndex, node, expectation, pool, types, "Array", "空数组")

; 集合字面量：规则与数组同形，只是容器名换成集合。
checkSetLiteral|func(unit: CompilationUnit, unitIndex: I32, node: I32, expectation: Expectation, pool: TypePool, types: ExprTypes,) -> (ContainerResult,):
    return checkSequenceLiteral(unit, unitIndex, node, expectation, pool, types, "Set", "空集合")

; 字典字面量：子节点按键值成对排布，键与值各自统一；空表必须有期望。
checkDictionaryLiteral|func(unit: CompilationUnit, unitIndex: I32, node: I32, expectation: Expectation, pool: TypePool, types: ExprTypes,) -> (ContainerResult,):
    var out = ContainerResult()
    out.pool = pool
    out.types = types
    if node < 0 || node >= unit.ast.exprCount():
        return failContainer(out, unit, unitIndex, node, containerElementMismatch, "字典字面量", "越界节点")
    var expectedKey = -1
    var expectedValue = -1
    var expectedResult = -1
    if expectation.hasExpected && containerNameOf(pool, expectation.typeId) == "Dictionary":
        expectedResult = expectation.typeId
        expectedKey = keyTypeOf(pool, expectation.typeId)
        expectedValue = valueTypeOf(pool, expectation.typeId)
    let kids = unit.ast.exprAt(node).kids
    var mergedKey = -1
    var mergedValue = -1
    var i = 0
    while i + 1 < len(kids):
        let keyStep = elementTypeAt(unit, unitIndex, kids[i], expectedKey, out.pool, out.types)
        out.pool = keyStep.pool
        out.types = keyStep.types
        if keyStep.typeId == errorTypeId():
            return failContainer(out, unit, unitIndex, node, containerElementMismatch, "同类型键", "已判错的键")
        if keyStep.typeId < 0:
            return deferContainer(out)
        if expectedKey >= 0:
            if !isAssignable(out.pool, keyStep.typeId, expectedKey):
                return failContainer(out, unit, unitIndex, node, containerElementMismatch, typeText(out.pool, expectedKey), typeText(out.pool, keyStep.typeId))
        else:
            let joined = unifyElement(out.pool, mergedKey, keyStep.typeId)
            if joined < 0:
                return failContainer(out, unit, unitIndex, node, containerElementMismatch, typeText(out.pool, mergedKey), typeText(out.pool, keyStep.typeId))
            mergedKey = joined
        let valueStep = elementTypeAt(unit, unitIndex, kids[i + 1], expectedValue, out.pool, out.types)
        out.pool = valueStep.pool
        out.types = valueStep.types
        if valueStep.typeId == errorTypeId():
            return failContainer(out, unit, unitIndex, node, containerElementMismatch, "同类型值", "已判错的值")
        if valueStep.typeId < 0:
            return deferContainer(out)
        if expectedValue >= 0:
            if !isAssignable(out.pool, valueStep.typeId, expectedValue):
                return failContainer(out, unit, unitIndex, node, containerElementMismatch, typeText(out.pool, expectedValue), typeText(out.pool, valueStep.typeId))
        else:
            let joinedValue = unifyElement(out.pool, mergedValue, valueStep.typeId)
            if joinedValue < 0:
                return failContainer(out, unit, unitIndex, node, containerElementMismatch, typeText(out.pool, mergedValue), typeText(out.pool, valueStep.typeId))
            mergedValue = joinedValue
        i = i + 2
    if expectedResult >= 0:
        return finishContainer(out, unitIndex, node, expectedResult)
    if mergedKey < 0 || mergedValue < 0:
        return failContainer(out, unit, unitIndex, node, containerNeedsExpectation, "", "空字典")
    var args: Array<I32> = []
    args = args.append(mergedKey)
    args = args.append(mergedValue)
    let inserted = intern(out.pool, typeClassCollection, "Dictionary", args, -1)
    var done = out
    done.pool = inserted.pool
    return finishContainer(done, unitIndex, node, inserted.id)

; 下标定型：期望类型交给字面量补判；返回结果的 typeId 存下标自身的类型，供调用方再判整型或键类型。
checkIndexType|func(out: ContainerResult, unit: CompilationUnit, unitIndex: I32, node: I32, expected: I32, index: I32,) -> (ContainerResult,):
    let probe = elementTypeAt(unit, unitIndex, index, expected, out.pool, out.types)
    var working = out
    working.pool = probe.pool
    working.types = probe.types
    if probe.typeId == errorTypeId():
        return failContainer(working, unit, unitIndex, node, containerIndexType, "下标", "已判错的下标")
    if probe.typeId < 0:
        return deferContainer(working)
    working.typeId = probe.typeId
    return working

; 下标读：接收者按类型分流，数组取元素、字典取值、字符串取字符；其余报不可下标。
checkSubscript|func(unit: CompilationUnit, unitIndex: I32, node: I32, pool: TypePool, types: ExprTypes,) -> (ContainerResult,):
    var out = ContainerResult()
    out.pool = pool
    out.types = types
    if node < 0 || node >= unit.ast.exprCount():
        return failContainer(out, unit, unitIndex, node, containerNotIndexable, "下标", "越界节点")
    let target = unit.ast.exprAt(node).kids[0]
    let targetType = exprTypeAt(out.types, unitIndex, target)
    if targetType == errorTypeId():
        return failContainer(out, unit, unitIndex, node, containerElementMismatch, "可下标类型", "已判错的接收者")
    if targetType < 0 || targetType >= len(out.pool.entries):
        return deferContainer(out)
    if len(unit.ast.exprAt(node).kids) < 2 || unit.ast.exprAt(node).kids[1] < 0:
        return failContainer(out, unit, unitIndex, node, containerMissingIndex, "下标", "缺失")
    let name = containerNameOf(out.pool, targetType)
    if name == "Array":
        let number = intern(out.pool, typeClassScalar, "I32", [], -1)
        out.pool = number.pool
        let typed = checkIndexType(out, unit, unitIndex, node, number.id, unit.ast.exprAt(node).kids[1])
        if typed.failed || typed.deferred:
            return typed
        if !isIntegerType(typed.pool, typed.typeId):
            return failContainer(typed, unit, unitIndex, node, containerIndexType, "I32", typeText(typed.pool, typed.typeId))
        let elem = elementTypeOf(typed.pool, targetType)
        if elem < 0:
            return deferContainer(typed)
        return finishContainer(typed, unitIndex, node, elem)
    if name == "Dictionary":
        let key = keyTypeOf(out.pool, targetType)
        let value = valueTypeOf(out.pool, targetType)
        if key < 0 || value < 0:
            return deferContainer(out)
        let typed = checkIndexType(out, unit, unitIndex, node, key, unit.ast.exprAt(node).kids[1])
        if typed.failed || typed.deferred:
            return typed
        if !isAssignable(typed.pool, typed.typeId, key):
            return failContainer(typed, unit, unitIndex, node, containerIndexType, typeText(typed.pool, key), typeText(typed.pool, typed.typeId))
        return finishContainer(typed, unitIndex, node, value)
    if isStringType(out.pool, targetType):
        let number = intern(out.pool, typeClassScalar, "I32", [], -1)
        out.pool = number.pool
        let typed = checkIndexType(out, unit, unitIndex, node, number.id, unit.ast.exprAt(node).kids[1])
        if typed.failed || typed.deferred:
            return typed
        if !isIntegerType(typed.pool, typed.typeId):
            return failContainer(typed, unit, unitIndex, node, containerIndexType, "I32", typeText(typed.pool, typed.typeId))
        let char = intern(typed.pool, typeClassScalar, "Char", [], -1)
        var done = typed
        done.pool = char.pool
        return finishContainer(done, unitIndex, node, char.id)
    return failContainer(out, unit, unitIndex, node, containerNotIndexable, typeText(out.pool, targetType), "[]")

; 单边界：缺失即跳过，存在则必须是整型。
checkBoundType|func(out: ContainerResult, unit: CompilationUnit, unitIndex: I32, node: I32, bound: I32, numberType: I32,) -> (ContainerResult,):
    if bound < 0:
        return out
    let typed = checkIndexType(out, unit, unitIndex, node, numberType, bound)
    if typed.failed || typed.deferred:
        return typed
    if !isIntegerType(typed.pool, typed.typeId):
        return failContainer(typed, unit, unitIndex, node, containerIndexType, "I32", typeText(typed.pool, typed.typeId))
    return typed

; 切片：数组切出同一数组类型，字符串切出字符串；两个边界都可省略，省略即开放边界。
checkSlice|func(unit: CompilationUnit, unitIndex: I32, node: I32, pool: TypePool, types: ExprTypes,) -> (ContainerResult,):
    var out = ContainerResult()
    out.pool = pool
    out.types = types
    if node < 0 || node >= unit.ast.exprCount():
        return failContainer(out, unit, unitIndex, node, containerNotIndexable, "切片", "越界节点")
    let target = unit.ast.exprAt(node).kids[0]
    let targetType = exprTypeAt(out.types, unitIndex, target)
    if targetType == errorTypeId():
        return failContainer(out, unit, unitIndex, node, containerElementMismatch, "可切片类型", "已判错的接收者")
    if targetType < 0 || targetType >= len(out.pool.entries):
        return deferContainer(out)
    var result = targetType
    if !isSliceableType(out.pool, targetType):
        return failContainer(out, unit, unitIndex, node, containerNotIndexable, typeText(out.pool, targetType), "[:]")
    if isStringType(out.pool, targetType):
        let text = intern(out.pool, typeClassScalar, "String", [], -1)
        out.pool = text.pool
        result = text.id
    let number = intern(out.pool, typeClassScalar, "I32", [], -1)
    out.pool = number.pool
    var working = out
    if len(unit.ast.exprAt(node).kids) > 1:
        let lower = checkBoundType(working, unit, unitIndex, node, unit.ast.exprAt(node).kids[1], number.id)
        if lower.failed || lower.deferred:
            return lower
        working = lower
    if len(unit.ast.exprAt(node).kids) > 2:
        let upper = checkBoundType(working, unit, unitIndex, node, unit.ast.exprAt(node).kids[2], number.id)
        if upper.failed || upper.deferred:
            return upper
        working = upper
    return finishContainer(working, unitIndex, node, result)
