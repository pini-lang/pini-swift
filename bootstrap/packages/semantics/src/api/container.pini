[container|import]
_syntax = "../../../syntax"
_module_loader = "../../../module-loader"

; 容器与索引判定：容器字面量的元素统一、下标读与切片，以及长度实参的约束。
; 期望按容器形状下传到元素；无期望时元素按同类型或同族数值提升合并，空字面量没有期望就报无法推断。
; 池与类型表须同源：表里的下标只在产生它的池里成立；下标三通道的 `get` 走成员调用，负索引留给运行时。

; 容器错误：元素不一致、缺少期望、类型不可下标、下标类型与下标缺失五类。
[ContainerErrorKind]
containerElementMismatch
containerNeedsExpectation
containerNotIndexable
containerIndexType
containerMissingIndex

; 容器错误：类别、文件、源内偏移与期望/实得文本；不可下标时存接收者类型与运算符拼写。
(ContainerError)
kind: ContainerErrorKind = .containerElementMismatch
file: String = ""
offset: I32 = 0
expected: String = ""
got: String = ""

; 判定结果：池、类型表、本节点类型、错误与待定标记。
(ContainerResult)
pool: TypePool = TypePool()
types: ExprTypes = ExprTypes()
typeId: I32 = -1
error: ContainerError = ContainerError()
failed: Bool = false
deferred: Bool = false

; 元素定型结果：池与类型表随补判增长，typeId 为 -1 表示尚不可定。
(ElementType)
pool: TypePool = TypePool()
types: ExprTypes = ExprTypes()
typeId: I32 = -1

; 错误类别名：诊断、测试与回执共用一份拼写。
containerErrorName|func(_kind: ContainerErrorKind,) -> (String,):
    match kind:
        case containerElementMismatch:
            return "元素类型不一致"
        case containerNeedsExpectation:
            return "缺少期望类型"
        case containerNotIndexable:
            return "类型不可下标"
        case containerIndexType:
            return "下标类型不匹配"
        case containerMissingIndex:
            return "缺少下标"
    return "容器错误"

; 同一类别判定：枚举相等比较不可用，按名称比。
isContainerError|func(error: ContainerError, kind: ContainerErrorKind,) -> (Bool,):
    return containerErrorName(error.kind) == containerErrorName(kind)

; 诊断码：复用宿主已登记的码，不新增码表条目。
containerErrorCode|func(_kind: ContainerErrorKind,) -> (String,):
    match kind:
        case containerElementMismatch:
            return "E4-001"
        case containerNeedsExpectation:
            return "E4-003"
        case containerNotIndexable:
            return "E4-004"
        case containerIndexType:
            return "E4-001"
        case containerMissingIndex:
            return "E4-001"
    return "E4-001"

; 造错误：位置取节点起点，期望与实得文本由调用方给。
makeContainerError|func(kind: ContainerErrorKind, file: String, offset: I32, expected: String, got: String,) -> (ContainerError,):
    var out = ContainerError()
    out.kind = kind
    out.file = file
    out.offset = offset
    out.expected = expected
    out.got = got
    return out

; 容器名：数组、字典与集合各一个拼写，其余答空串。
containerNameOf|func(pool: TypePool, id: I32,) -> (String,):
    if id < 0 || id >= len(pool.entries):
        return ""
    let entry = pool.entries[id]
    if !isTypeClass(kind = entry.kind, expected = typeClassCollection):
        return ""
    return entry.name

; 元素类型：数组与集合的第一个实参；其余答 -1。
elementTypeOf|func(pool: TypePool, id: I32,) -> (I32,):
    let name = containerNameOf(pool = pool, id = id)
    if name != "Array" && name != "Set":
        return -1
    let entry = pool.entries[id]
    if len(entry.kids) == 0:
        return -1
    return entry.kids[0]

; 键类型：字典的第一个实参；其余答 -1。
keyTypeOf|func(pool: TypePool, id: I32,) -> (I32,):
    if containerNameOf(pool = pool, id = id) != "Dictionary":
        return -1
    let entry = pool.entries[id]
    if len(entry.kids) < 1:
        return -1
    return entry.kids[0]

; 值类型：字典的第二个实参；其余答 -1。
valueTypeOf|func(pool: TypePool, id: I32,) -> (I32,):
    if containerNameOf(pool = pool, id = id) != "Dictionary":
        return -1
    let entry = pool.entries[id]
    if len(entry.kids) < 2:
        return -1
    return entry.kids[1]

; 可取长：数组、字典、集合与字符串；`len` 的形参约束也用它。
isSizedType|func(pool: TypePool, id: I32,) -> (Bool,):
    if isStringType(pool = pool, id = id):
        return true
    return len(containerNameOf(pool = pool, id = id)) > 0

; 可切片：数组与字符串。
isSliceableType|func(pool: TypePool, id: I32,) -> (Bool,):
    if isStringType(pool = pool, id = id):
        return true
    return containerNameOf(pool = pool, id = id) == "Array"

; 元素定型：表里已判定的直接用；未判定且是基本字面量时按期望补判；其余交回未定。
elementTypeAt|func(unit: CompilationUnit, unitIndex: I32, node: I32, expected: I32, pool: TypePool, types: ExprTypes,) -> (ElementType,):
    var out = ElementType()
    out.pool = pool
    out.types = types
    if node < 0 || node >= unit.ast.exprCount():
        out.typeId = unsetTypeId()
        return out
    let known = exprTypeAt(table = types, unit = unitIndex, node = node)
    if known == errorTypeId():
        out.typeId = errorTypeId()
        return out
    if known >= 0 && known < len(pool.entries):
        out.typeId = known
        return out
    if !unit.ast.isLiteralExpr(node):
        out.typeId = unsetTypeId()
        return out
    var wanted = noExpectation()
    if expected >= 0:
        wanted = expectType(expected)
    let checked = checkLiteral(unit = unit, unitIndex = unitIndex, node = node, expectation = wanted, pool = pool, types = types)
    out.pool = checked.pool
    out.types = checked.types
    if checked.failed:
        out.typeId = errorTypeId()
        return out
    out.typeId = checked.typeId
    return out

; 元素合并：同类型取自身，同族数值取宽侧，其余答 -1。
unifyElement|func(pool: TypePool, current: I32, next: I32,) -> (I32,):
    if current < 0:
        return next
    if sameType(pool = pool, first = current, second = next):
        return current
    return promoteNumeric(pool = pool, left = current, right = next)

; 失败收尾：写错误标记与错误记录。
failContainer|func(out: ContainerResult, unit: CompilationUnit, unitIndex: I32, node: I32, kind: ContainerErrorKind, expected: String, got: String,) -> (ContainerResult,):
    var done = out
    done.failed = true
    done.typeId = errorTypeId()
    done.types = writeExprType(table = out.types, unit = unitIndex, node = node, typeId = errorTypeId())
    var offset = 0
    if node >= 0 && node < unit.ast.exprCount():
        offset = unit.ast.exprAt(node).start
    done.error = makeContainerError(kind = kind, file = unit.path, offset = offset, expected = expected, got = got)
    return done

; 待定收尾：元素或接收者尚未定型，不报错也不写错误标记。
deferContainer|func(_out: ContainerResult,) -> (ContainerResult,):
    var done = out
    done.deferred = true
    done.typeId = unsetTypeId()
    return done

; 成功收尾：写结果类型。
finishContainer|func(out: ContainerResult, unitIndex: I32, node: I32, typeId: I32,) -> (ContainerResult,):
    var done = out
    done.typeId = typeId
    done.types = writeExprType(table = out.types, unit = unitIndex, node = node, typeId = typeId)
    return done

; 单元素收尾：按容器名与唯一实参驻留，池换新后写表。
finishSingle|func(out: ContainerResult, unitIndex: I32, node: I32, name: String, elem: I32,) -> (ContainerResult,):
    var args: Array<I32> = []
    args = args.append(elem)
    let inserted = intern(pool = out.pool, kind = typeClassCollection, name = name, kids = args, ret = -1)
    var done = out
    done.pool = inserted.pool
    return finishContainer(out = done, unitIndex = unitIndex, node = node, typeId = inserted.id)

; 序列字面量：数组与集合共用一条；期望给出元素类型时逐元素比对，否则合并元素。
checkSequenceLiteral|func(unit: CompilationUnit, unitIndex: I32, node: I32, expectation: Expectation, pool: TypePool, types: ExprTypes, name: String, emptyLabel: String,) -> (ContainerResult,):
    var out = ContainerResult()
    out.pool = pool
    out.types = types
    if node < 0 || node >= unit.ast.exprCount():
        return failContainer(out = out, unit = unit, unitIndex = unitIndex, node = node, kind = containerElementMismatch, expected = name + " 字面量", got = "越界节点")
    var expectedElem = -1
    var expectedResult = -1
    if expectation.hasExpected && containerNameOf(pool = pool, id = expectation.typeId) == name:
        expectedResult = expectation.typeId
        expectedElem = elementTypeOf(pool = pool, id = expectation.typeId)
    let kids = unit.ast.exprAt(node).kids
    var merged = -1
    var i = 0
    while i < len(kids):
        let probe = elementTypeAt(unit = unit, unitIndex = unitIndex, node = kids[i], expected = expectedElem, pool = out.pool, types = out.types)
        out.pool = probe.pool
        out.types = probe.types
        if probe.typeId == errorTypeId():
            return failContainer(out = out, unit = unit, unitIndex = unitIndex, node = node, kind = containerElementMismatch, expected = "同类型元素", got = "已判错的元素")
        if probe.typeId < 0:
            return deferContainer(out)
        if expectedElem >= 0:
            if !isAssignable(pool = out.pool, from = probe.typeId, to = expectedElem):
                return failContainer(out = out, unit = unit, unitIndex = unitIndex, node = node, kind = containerElementMismatch, expected = typeText(pool = out.pool, id = expectedElem), got = typeText(pool = out.pool, id = probe.typeId))
        else:
            let joined = unifyElement(pool = out.pool, current = merged, next = probe.typeId)
            if joined < 0:
                return failContainer(out = out, unit = unit, unitIndex = unitIndex, node = node, kind = containerElementMismatch, expected = typeText(pool = out.pool, id = merged), got = typeText(pool = out.pool, id = probe.typeId))
            merged = joined
        i = i + 1
    if expectedResult >= 0:
        return finishContainer(out = out, unitIndex = unitIndex, node = node, typeId = expectedResult)
    if merged < 0:
        return failContainer(out = out, unit = unit, unitIndex = unitIndex, node = node, kind = containerNeedsExpectation, expected = "", got = emptyLabel)
    return finishSingle(out = out, unitIndex = unitIndex, node = node, name = name, elem = merged)

; 数组字面量：元素缺省 I32 一类由字面量判定给出，空表必须有期望。
checkArrayLiteral|func(unit: CompilationUnit, unitIndex: I32, node: I32, expectation: Expectation, pool: TypePool, types: ExprTypes,) -> (ContainerResult,):
    return checkSequenceLiteral(unit = unit, unitIndex = unitIndex, node = node, expectation = expectation, pool = pool, types = types, name = "Array", emptyLabel = "空数组")

; 集合字面量：规则与数组同形，只是容器名换成集合。
checkSetLiteral|func(unit: CompilationUnit, unitIndex: I32, node: I32, expectation: Expectation, pool: TypePool, types: ExprTypes,) -> (ContainerResult,):
    return checkSequenceLiteral(unit = unit, unitIndex = unitIndex, node = node, expectation = expectation, pool = pool, types = types, name = "Set", emptyLabel = "空集合")

; 字典字面量：子节点按键值成对排布，键与值各自统一；空表必须有期望。
checkDictionaryLiteral|func(unit: CompilationUnit, unitIndex: I32, node: I32, expectation: Expectation, pool: TypePool, types: ExprTypes,) -> (ContainerResult,):
    var out = ContainerResult()
    out.pool = pool
    out.types = types
    if node < 0 || node >= unit.ast.exprCount():
        return failContainer(out = out, unit = unit, unitIndex = unitIndex, node = node, kind = containerElementMismatch, expected = "字典字面量", got = "越界节点")
    var expectedKey = -1
    var expectedValue = -1
    var expectedResult = -1
    if expectation.hasExpected && containerNameOf(pool = pool, id = expectation.typeId) == "Dictionary":
        expectedResult = expectation.typeId
        expectedKey = keyTypeOf(pool = pool, id = expectation.typeId)
        expectedValue = valueTypeOf(pool = pool, id = expectation.typeId)
    let kids = unit.ast.exprAt(node).kids
    var mergedKey = -1
    var mergedValue = -1
    var i = 0
    while i + 1 < len(kids):
        let keyStep = elementTypeAt(unit = unit, unitIndex = unitIndex, node = kids[i], expected = expectedKey, pool = out.pool, types = out.types)
        out.pool = keyStep.pool
        out.types = keyStep.types
        if keyStep.typeId == errorTypeId():
            return failContainer(out = out, unit = unit, unitIndex = unitIndex, node = node, kind = containerElementMismatch, expected = "同类型键", got = "已判错的键")
        if keyStep.typeId < 0:
            return deferContainer(out)
        if expectedKey >= 0:
            if !isAssignable(pool = out.pool, from = keyStep.typeId, to = expectedKey):
                return failContainer(out = out, unit = unit, unitIndex = unitIndex, node = node, kind = containerElementMismatch, expected = typeText(pool = out.pool, id = expectedKey), got = typeText(pool = out.pool, id = keyStep.typeId))
        else:
            let joined = unifyElement(pool = out.pool, current = mergedKey, next = keyStep.typeId)
            if joined < 0:
                return failContainer(out = out, unit = unit, unitIndex = unitIndex, node = node, kind = containerElementMismatch, expected = typeText(pool = out.pool, id = mergedKey), got = typeText(pool = out.pool, id = keyStep.typeId))
            mergedKey = joined
        let valueStep = elementTypeAt(unit = unit, unitIndex = unitIndex, node = kids[i + 1], expected = expectedValue, pool = out.pool, types = out.types)
        out.pool = valueStep.pool
        out.types = valueStep.types
        if valueStep.typeId == errorTypeId():
            return failContainer(out = out, unit = unit, unitIndex = unitIndex, node = node, kind = containerElementMismatch, expected = "同类型值", got = "已判错的值")
        if valueStep.typeId < 0:
            return deferContainer(out)
        if expectedValue >= 0:
            if !isAssignable(pool = out.pool, from = valueStep.typeId, to = expectedValue):
                return failContainer(out = out, unit = unit, unitIndex = unitIndex, node = node, kind = containerElementMismatch, expected = typeText(pool = out.pool, id = expectedValue), got = typeText(pool = out.pool, id = valueStep.typeId))
        else:
            let joinedValue = unifyElement(pool = out.pool, current = mergedValue, next = valueStep.typeId)
            if joinedValue < 0:
                return failContainer(out = out, unit = unit, unitIndex = unitIndex, node = node, kind = containerElementMismatch, expected = typeText(pool = out.pool, id = mergedValue), got = typeText(pool = out.pool, id = valueStep.typeId))
            mergedValue = joinedValue
        i = i + 2
    if expectedResult >= 0:
        return finishContainer(out = out, unitIndex = unitIndex, node = node, typeId = expectedResult)
    if mergedKey < 0 || mergedValue < 0:
        return failContainer(out = out, unit = unit, unitIndex = unitIndex, node = node, kind = containerNeedsExpectation, expected = "", got = "空字典")
    var args: Array<I32> = []
    args = args.append(mergedKey)
    args = args.append(mergedValue)
    let inserted = intern(pool = out.pool, kind = typeClassCollection, name = "Dictionary", kids = args, ret = -1)
    var done = out
    done.pool = inserted.pool
    return finishContainer(out = done, unitIndex = unitIndex, node = node, typeId = inserted.id)

; 下标定型：期望类型交给字面量补判；返回结果的 typeId 存下标自身的类型，供调用方再判整型或键类型。
checkIndexType|func(out: ContainerResult, unit: CompilationUnit, unitIndex: I32, node: I32, expected: I32, index: I32,) -> (ContainerResult,):
    let probe = elementTypeAt(unit = unit, unitIndex = unitIndex, node = index, expected = expected, pool = out.pool, types = out.types)
    var working = out
    working.pool = probe.pool
    working.types = probe.types
    if probe.typeId == errorTypeId():
        return failContainer(out = working, unit = unit, unitIndex = unitIndex, node = node, kind = containerIndexType, expected = "下标", got = "已判错的下标")
    if probe.typeId < 0:
        return deferContainer(working)
    working.typeId = probe.typeId
    return working

; 下标读：接收者按类型分流，数组取元素、字典取值、字符串取字符；其余报不可下标。
checkSubscript|func(unit: CompilationUnit, unitIndex: I32, node: I32, pool: TypePool, types: ExprTypes,) -> (ContainerResult,):
    var out = ContainerResult()
    out.pool = pool
    out.types = types
    if node < 0 || node >= unit.ast.exprCount():
        return failContainer(out = out, unit = unit, unitIndex = unitIndex, node = node, kind = containerNotIndexable, expected = "下标", got = "越界节点")
    let target = unit.ast.exprAt(node).kids[0]
    let targetType = exprTypeAt(table = out.types, unit = unitIndex, node = target)
    if targetType == errorTypeId():
        return failContainer(out = out, unit = unit, unitIndex = unitIndex, node = node, kind = containerElementMismatch, expected = "可下标类型", got = "已判错的接收者")
    if targetType < 0 || targetType >= len(out.pool.entries):
        return deferContainer(out)
    if len(unit.ast.exprAt(node).kids) < 2 || unit.ast.exprAt(node).kids[1] < 0:
        return failContainer(out = out, unit = unit, unitIndex = unitIndex, node = node, kind = containerMissingIndex, expected = "下标", got = "缺失")
    let name = containerNameOf(pool = out.pool, id = targetType)
    if name == "Array":
        let number = intern(pool = out.pool, kind = typeClassScalar, name = "I32", kids = [], ret = -1)
        out.pool = number.pool
        let typed = checkIndexType(out = out, unit = unit, unitIndex = unitIndex, node = node, expected = number.id, index = unit.ast.exprAt(node).kids[1])
        if typed.failed || typed.deferred:
            return typed
        if !isIntegerType(pool = typed.pool, id = typed.typeId):
            return failContainer(out = typed, unit = unit, unitIndex = unitIndex, node = node, kind = containerIndexType, expected = "I32", got = typeText(pool = typed.pool, id = typed.typeId))
        let elem = elementTypeOf(pool = typed.pool, id = targetType)
        if elem < 0:
            return deferContainer(typed)
        return finishContainer(out = typed, unitIndex = unitIndex, node = node, typeId = elem)
    if name == "Dictionary":
        let key = keyTypeOf(pool = out.pool, id = targetType)
        let value = valueTypeOf(pool = out.pool, id = targetType)
        if key < 0 || value < 0:
            return deferContainer(out)
        let typed = checkIndexType(out = out, unit = unit, unitIndex = unitIndex, node = node, expected = key, index = unit.ast.exprAt(node).kids[1])
        if typed.failed || typed.deferred:
            return typed
        if !isAssignable(pool = typed.pool, from = typed.typeId, to = key):
            return failContainer(out = typed, unit = unit, unitIndex = unitIndex, node = node, kind = containerIndexType, expected = typeText(pool = typed.pool, id = key), got = typeText(pool = typed.pool, id = typed.typeId))
        return finishContainer(out = typed, unitIndex = unitIndex, node = node, typeId = value)
    if isStringType(pool = out.pool, id = targetType):
        let number = intern(pool = out.pool, kind = typeClassScalar, name = "I32", kids = [], ret = -1)
        out.pool = number.pool
        let typed = checkIndexType(out = out, unit = unit, unitIndex = unitIndex, node = node, expected = number.id, index = unit.ast.exprAt(node).kids[1])
        if typed.failed || typed.deferred:
            return typed
        if !isIntegerType(pool = typed.pool, id = typed.typeId):
            return failContainer(out = typed, unit = unit, unitIndex = unitIndex, node = node, kind = containerIndexType, expected = "I32", got = typeText(pool = typed.pool, id = typed.typeId))
        let char = intern(pool = typed.pool, kind = typeClassScalar, name = "Char", kids = [], ret = -1)
        var done = typed
        done.pool = char.pool
        return finishContainer(out = done, unitIndex = unitIndex, node = node, typeId = char.id)
    return failContainer(out = out, unit = unit, unitIndex = unitIndex, node = node, kind = containerNotIndexable, expected = typeText(pool = out.pool, id = targetType), got = "[]")

; 单边界：缺失即跳过，存在则必须是整型。
checkBoundType|func(out: ContainerResult, unit: CompilationUnit, unitIndex: I32, node: I32, bound: I32, numberType: I32,) -> (ContainerResult,):
    if bound < 0:
        return out
    let typed = checkIndexType(out = out, unit = unit, unitIndex = unitIndex, node = node, expected = numberType, index = bound)
    if typed.failed || typed.deferred:
        return typed
    if !isIntegerType(pool = typed.pool, id = typed.typeId):
        return failContainer(out = typed, unit = unit, unitIndex = unitIndex, node = node, kind = containerIndexType, expected = "I32", got = typeText(pool = typed.pool, id = typed.typeId))
    return typed

; 切片：数组切出同一数组类型，字符串切出字符串；两个边界都可省略，省略即开放边界。
checkSlice|func(unit: CompilationUnit, unitIndex: I32, node: I32, pool: TypePool, types: ExprTypes,) -> (ContainerResult,):
    var out = ContainerResult()
    out.pool = pool
    out.types = types
    if node < 0 || node >= unit.ast.exprCount():
        return failContainer(out = out, unit = unit, unitIndex = unitIndex, node = node, kind = containerNotIndexable, expected = "切片", got = "越界节点")
    let target = unit.ast.exprAt(node).kids[0]
    let targetType = exprTypeAt(table = out.types, unit = unitIndex, node = target)
    if targetType == errorTypeId():
        return failContainer(out = out, unit = unit, unitIndex = unitIndex, node = node, kind = containerElementMismatch, expected = "可切片类型", got = "已判错的接收者")
    if targetType < 0 || targetType >= len(out.pool.entries):
        return deferContainer(out)
    var result = targetType
    if !isSliceableType(pool = out.pool, id = targetType):
        return failContainer(out = out, unit = unit, unitIndex = unitIndex, node = node, kind = containerNotIndexable, expected = typeText(pool = out.pool, id = targetType), got = "[:]")
    if isStringType(pool = out.pool, id = targetType):
        let text = intern(pool = out.pool, kind = typeClassScalar, name = "String", kids = [], ret = -1)
        out.pool = text.pool
        result = text.id
    let number = intern(pool = out.pool, kind = typeClassScalar, name = "I32", kids = [], ret = -1)
    out.pool = number.pool
    var working = out
    if len(unit.ast.exprAt(node).kids) > 1:
        let lower = checkBoundType(out = working, unit = unit, unitIndex = unitIndex, node = node, bound = unit.ast.exprAt(node).kids[1], numberType = number.id)
        if lower.failed || lower.deferred:
            return lower
        working = lower
    if len(unit.ast.exprAt(node).kids) > 2:
        let upper = checkBoundType(out = working, unit = unit, unitIndex = unitIndex, node = node, bound = unit.ast.exprAt(node).kids[2], numberType = number.id)
        if upper.failed || upper.deferred:
            return upper
        working = upper
    return finishContainer(out = working, unitIndex = unitIndex, node = node, typeId = result)
