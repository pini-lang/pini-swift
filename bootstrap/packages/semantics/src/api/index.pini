[index|import]
_syntax = "../../../syntax"
_module_loader = "../../../module-loader"

; 查找索引：符号、导入别名与声明各建一张有序表，检查期只做二分，不再线性扫。
; 索引在建表后一次性排序，此后只读；同一张表建两次得到同一串槽位。

; 符号槽：所有者键、名字键与符号下标；顶层符号的所有者键为空。
(SymbolSlot)
ownerKey: Array<U8> = []
key: Array<U8> = []
symbol: I32 = -1

; 导入槽：文件键与别名键；别名只在该文件内可见。
(ImportSlot)
fileKey: Array<U8> = []
key: Array<U8> = []
symbol: I32 = -1

; 符号索引：两张按（所有者, 键）与（文件, 键）升序的槽表。
(SymbolIndex)
slots: Array<SymbolSlot> = []
imports: Array<ImportSlot> = []

; 声明槽：文件键与源内偏移定位到单元与声明下标。
(DeclSlot)
fileKey: Array<U8> = []
offset: I32 = 0
unit: I32 = -1
decl: I32 = -1

; 声明索引：按（文件, 偏移）升序的槽表。
(DeclIndex)
slots: Array<DeclSlot> = []

; 声明指向：未命中时两项都为 -1。
(DeclRef)
unit: I32 = -1
decl: I32 = -1

; 字节序比较：逐字节无符号比，短串在前；相等答 0。
compareKeys|func(first: Array<U8>, second: Array<U8>,) -> (I32,):
    var i = 0
    while i < len(first) && i < len(second):
        let a = tempByteToInt(first[i])
        let b = tempByteToInt(second[i])
        if a < b:
            return -1
        if a > b:
            return 1
        i = i + 1
    if len(first) < len(second):
        return -1
    if len(first) > len(second):
        return 1
    return 0

; 取区间：保留 [start, end)；越界按长度夹紧。
takeSymbolSlots|func(values: Array<SymbolSlot>, start: I32, end: I32,) -> (Array<SymbolSlot>,):
    var out: Array<SymbolSlot> = []
    var i = start
    while i < end && i < len(values):
        out = out.append(values[i])
        i = i + 1
    return out

; 符号槽比较：先比所有者键，再比名字键。
compareSymbolSlots|func(first: SymbolSlot, second: SymbolSlot,) -> (I32,):
    let ownerOrder = compareKeys(first = first.ownerKey, second = second.ownerKey)
    if ownerOrder != 0:
        return ownerOrder
    return compareKeys(first = first.key, second = second.key)

; 归并：两段已有序，稳定取小者，故同键保持登记序。
mergeSymbolSlots|func(left: Array<SymbolSlot>, right: Array<SymbolSlot>,) -> (Array<SymbolSlot>,):
    var out: Array<SymbolSlot> = []
    var i = 0
    var j = 0
    while i < len(left) && j < len(right):
        if compareSymbolSlots(first = left[i], second = right[j]) <= 0:
            out = out.append(left[i])
            i = i + 1
        else:
            out = out.append(right[j])
            j = j + 1
    while i < len(left):
        out = out.append(left[i])
        i = i + 1
    while j < len(right):
        out = out.append(right[j])
        j = j + 1
    return out

; 排序：两路归并，槽数上万时仍是 n log n。
sortSymbolSlots|func(_values: Array<SymbolSlot>,) -> (Array<SymbolSlot>,):
    if len(values) <= 1:
        return values
    let mid = len(values) / 2
    let left = sortSymbolSlots(takeSymbolSlots(values = values, start = 0, end = mid))
    let right = sortSymbolSlots(takeSymbolSlots(values = values, start = mid, end = len(values)))
    return mergeSymbolSlots(left = left, right = right)

; 取区间：导入槽版本。
takeImportSlots|func(values: Array<ImportSlot>, start: I32, end: I32,) -> (Array<ImportSlot>,):
    var out: Array<ImportSlot> = []
    var i = start
    while i < end && i < len(values):
        out = out.append(values[i])
        i = i + 1
    return out

; 导入槽比较：先比文件键，再比别名键。
compareImportSlots|func(first: ImportSlot, second: ImportSlot,) -> (I32,):
    let fileOrder = compareKeys(first = first.fileKey, second = second.fileKey)
    if fileOrder != 0:
        return fileOrder
    return compareKeys(first = first.key, second = second.key)

; 归并：导入槽版本。
mergeImportSlots|func(left: Array<ImportSlot>, right: Array<ImportSlot>,) -> (Array<ImportSlot>,):
    var out: Array<ImportSlot> = []
    var i = 0
    var j = 0
    while i < len(left) && j < len(right):
        if compareImportSlots(first = left[i], second = right[j]) <= 0:
            out = out.append(left[i])
            i = i + 1
        else:
            out = out.append(right[j])
            j = j + 1
    while i < len(left):
        out = out.append(left[i])
        i = i + 1
    while j < len(right):
        out = out.append(right[j])
        j = j + 1
    return out

; 排序：导入槽版本。
sortImportSlots|func(_values: Array<ImportSlot>,) -> (Array<ImportSlot>,):
    if len(values) <= 1:
        return values
    let mid = len(values) / 2
    let left = sortImportSlots(takeImportSlots(values = values, start = 0, end = mid))
    let right = sortImportSlots(takeImportSlots(values = values, start = mid, end = len(values)))
    return mergeImportSlots(left = left, right = right)

; 取区间：声明槽版本。
takeDeclSlots|func(values: Array<DeclSlot>, start: I32, end: I32,) -> (Array<DeclSlot>,):
    var out: Array<DeclSlot> = []
    var i = start
    while i < end && i < len(values):
        out = out.append(values[i])
        i = i + 1
    return out

; 声明槽比较：先比文件键，再比偏移。
compareDeclSlots|func(first: DeclSlot, second: DeclSlot,) -> (I32,):
    let fileOrder = compareKeys(first = first.fileKey, second = second.fileKey)
    if fileOrder != 0:
        return fileOrder
    if first.offset < second.offset:
        return -1
    if first.offset > second.offset:
        return 1
    return 0

; 归并：声明槽版本。
mergeDeclSlots|func(left: Array<DeclSlot>, right: Array<DeclSlot>,) -> (Array<DeclSlot>,):
    var out: Array<DeclSlot> = []
    var i = 0
    var j = 0
    while i < len(left) && j < len(right):
        if compareDeclSlots(first = left[i], second = right[j]) <= 0:
            out = out.append(left[i])
            i = i + 1
        else:
            out = out.append(right[j])
            j = j + 1
    while i < len(left):
        out = out.append(left[i])
        i = i + 1
    while j < len(right):
        out = out.append(right[j])
        j = j + 1
    return out

; 排序：声明槽版本。
sortDeclSlots|func(_values: Array<DeclSlot>,) -> (Array<DeclSlot>,):
    if len(values) <= 1:
        return values
    let mid = len(values) / 2
    let left = sortDeclSlots(takeDeclSlots(values = values, start = 0, end = mid))
    let right = sortDeclSlots(takeDeclSlots(values = values, start = mid, end = len(values)))
    return mergeDeclSlots(left = left, right = right)

; 建符号索引：符号与导入各扫一遍，排序后只读。
makeSymbolIndex|func(_table: SymbolTable,) -> (SymbolIndex,):
    var slots: Array<SymbolSlot> = []
    var i = 0
    while i < table.symbolCount():
        let symbol = table.symbolAt(i)
        var slot = SymbolSlot()
        slot.ownerKey = keyOfText(symbol.owner)
        slot.key = symbol.key
        slot.symbol = i
        slots = slots.append(slot)
        i = i + 1
    var imports: Array<ImportSlot> = []
    var j = 0
    while j < table.importCount():
        let symbol = table.importAt(j)
        var slot = ImportSlot()
        slot.fileKey = keyOfText(symbol.file)
        slot.key = symbol.key
        slot.symbol = j
        imports = imports.append(slot)
        j = j + 1
    var out = SymbolIndex()
    out.slots = sortSymbolSlots(slots)
    out.imports = sortImportSlots(imports)
    return out

; 建声明索引：逐单元扫声明池；单元次序即 type 面的单元下标。
makeDeclIndex|func(_units: Array<CompilationUnit>,) -> (DeclIndex,):
    var slots: Array<DeclSlot> = []
    var u = 0
    while u < len(units):
        let unit = units[u]
        let fileKey = keyOfText(unit.path)
        var d = 0
        while d < unit.ast.declCount():
            var slot = DeclSlot()
            slot.fileKey = fileKey
            slot.offset = unit.ast.decls[d].start
            slot.unit = u
            slot.decl = d
            slots = slots.append(slot)
            d = d + 1
        u = u + 1
    var out = DeclIndex()
    out.slots = sortDeclSlots(slots)
    return out

; 符号下界：第一个不小于给定（所有者, 键）的槽位。
lowerBoundSymbol|func(slots: Array<SymbolSlot>, ownerKey: Array<U8>, key: Array<U8>,) -> (I32,):
    var lo = 0
    var hi = len(slots)
    while lo < hi:
        let mid = (lo + hi) / 2
        let order = compareKeys(first = slots[mid].ownerKey, second = ownerKey)
        if order < 0:
            lo = mid + 1
        elif order > 0:
            hi = mid
        else:
            if compareKeys(first = slots[mid].key, second = key) < 0:
                lo = mid + 1
            else:
                hi = mid
    return lo

; 顶层查找：所有者键为空；命中答符号下标，否则 -1。
lookupTop|func(index: SymbolIndex, key: Array<U8>,) -> (I32,):
    var empty: Array<U8> = []
    let at = lowerBoundSymbol(slots = index.slots, ownerKey = empty, key = key)
    if at < len(index.slots):
        if len(index.slots[at].ownerKey) == 0 && sameKey(first = index.slots[at].key, second = key):
            return index.slots[at].symbol
    return -1

; 成员查找：所有者名折成 NFC 键后二分；命中答符号下标，否则 -1。
lookupMember|func(index: SymbolIndex, owner: String, key: Array<U8>,) -> (I32,):
    let ownerKey = keyOfText(owner)
    let at = lowerBoundSymbol(slots = index.slots, ownerKey = ownerKey, key = key)
    if at < len(index.slots):
        let slot = index.slots[at]
        if sameKey(first = slot.ownerKey, second = ownerKey) && sameKey(first = slot.key, second = key):
            return slot.symbol
    return -1

; 导入下界：第一个不小于给定（文件, 别名）的槽位。
lowerBoundImport|func(slots: Array<ImportSlot>, fileKey: Array<U8>, key: Array<U8>,) -> (I32,):
    var lo = 0
    var hi = len(slots)
    while lo < hi:
        let mid = (lo + hi) / 2
        let order = compareKeys(first = slots[mid].fileKey, second = fileKey)
        if order < 0:
            lo = mid + 1
        elif order > 0:
            hi = mid
        else:
            if compareKeys(first = slots[mid].key, second = key) < 0:
                lo = mid + 1
            else:
                hi = mid
    return lo

; 导入别名查找：文件与别名都要对上；命中答导入表下标，否则 -1。
lookupImport|func(index: SymbolIndex, file: String, key: Array<U8>,) -> (I32,):
    let fileKey = keyOfText(file)
    let at = lowerBoundImport(slots = index.imports, fileKey = fileKey, key = key)
    if at < len(index.imports):
        let slot = index.imports[at]
        if sameKey(first = slot.fileKey, second = fileKey) && sameKey(first = slot.key, second = key):
            return slot.symbol
    return -1

; 声明下界：第一个不小于给定（文件, 偏移）的槽位。
lowerBoundDecl|func(slots: Array<DeclSlot>, fileKey: Array<U8>, offset: I32,) -> (I32,):
    var lo = 0
    var hi = len(slots)
    while lo < hi:
        let mid = (lo + hi) / 2
        let order = compareKeys(first = slots[mid].fileKey, second = fileKey)
        if order < 0:
            lo = mid + 1
        elif order > 0:
            hi = mid
        else:
            if slots[mid].offset < offset:
                lo = mid + 1
            else:
                hi = mid
    return lo

; 声明查找：按文件与起始偏移定位；未命中两项都为 -1。
lookupDecl|func(index: DeclIndex, file: String, offset: I32,) -> (DeclRef,):
    var out = DeclRef()
    let fileKey = keyOfText(file)
    let at = lowerBoundDecl(slots = index.slots, fileKey = fileKey, offset = offset)
    if at < len(index.slots):
        let slot = index.slots[at]
        if sameKey(first = slot.fileKey, second = fileKey) && slot.offset == offset:
            out.unit = slot.unit
            out.decl = slot.decl
    return out

((SymbolIndex))
; 槽数：符号总数。
slotCount|self() -> (I32,):
    return len(self.slots)
; 导入数：别名总数。
importCount|self() -> (I32,):
    return len(self.imports)
; 槽读取：下标越界是运行时陷阱，调用方先经查找取符号下标。
slotAt|self(_index: I32,) -> (SymbolSlot,):
    return self.slots[index]
; 导入槽读取：与 slotAt 同规。
importAt|self(_index: I32,) -> (ImportSlot,):
    return self.imports[index]

((DeclIndex))
; 槽数：声明总数。
slotCount|self() -> (I32,):
    return len(self.slots)
; 槽读取：与 SymbolIndex.slotAt 同规。
slotAt|self(_index: I32,) -> (DeclSlot,):
    return self.slots[index]
