[expr_types|import]
_syntax = "../../../syntax"
_module_loader = "../../../module-loader"

; 表达式类型表：每个表达式节点一条类型池下标，与表达式池同下标。
; 未写用 -1，已判错用 -2；IR 只读有效下标，错误标记不再向下游传递。

; 单元类型表：一条槽对应一个表达式节点。
(UnitExprTypes)
types: Array<I32> = []

; 类型表：按单元存放；调用方先 sortedUnits，与类型面和解析表共用同一序。
(ExprTypes)
units: Array<UnitExprTypes> = []

; 覆盖读数：必填槽数、已判定数与首个未写槽下标。
(TypeCoverage)
required: I32 = 0
covered: I32 = 0
firstMissing: I32 = -1

; 未写标记：节点还没判定。
unsetTypeId|func() -> (I32,):
    return -1

; 错误标记：节点判过且失败，下游不得当有效类型用。
errorTypeId|func() -> (I32,):
    return -2

; 建表：逐单元按表达式池长度铺未写槽。
makeExprTypes|func(_units: Array<CompilationUnit>,) -> (ExprTypes,):
    var out = ExprTypes()
    var u = 0
    while u < len(_units):
        var unitTable = UnitExprTypes()
        var i = 0
        let count = _units[u].ast.exprCount()
        while i < count:
            unitTable.types = unitTable.types.append(unsetTypeId())
            i = i + 1
        out.units = out.units.append(unitTable)
        u = u + 1
    return out

; 写一条类型：原地写入并返回同一张表；越界时原表返回，旧快照不得与它共存。
writeExprType|func(table: ExprTypes, unit: I32, node: I32, typeId: I32,) -> (ExprTypes,):
    if unit < 0 || unit >= len(table.units):
        return table
    if node < 0 || node >= len(table.units[unit].types):
        return table
    var out = table
    out.units[unit].types[node] = typeId
    return out

; 读一条类型：越界答未写，调用方不必先判边界。
exprTypeAt|func(table: ExprTypes, unit: I32, node: I32,) -> (I32,):
    if unit < 0 || unit >= len(table.units):
        return unsetTypeId()
    if node < 0 || node >= len(table.units[unit].types):
        return unsetTypeId()
    return table.units[unit].types[node]

; 表长：单元越界答 0。
unitTypeCount|func(table: ExprTypes, unit: I32,) -> (I32,):
    if unit < 0 || unit >= len(table.units):
        return 0
    return len(table.units[unit].types)

; 表达式类型：先读表；未写时标识符回查作用域里的局部，其余一律答未写。
typeOfExprNode|func(unit: CompilationUnit, unitIndex: I32, node: I32, scope: ScopeStack, types: ExprTypes, pool: TypePool,) -> (I32,):
    let known = exprTypeAt(table = types, unit = unitIndex, node = node)
    if known >= 0 && known < len(pool.entries):
        return known
    if node < 0 || node >= unit.ast.exprCount():
        return unsetTypeId()
    if !unit.ast.isIdentifierExpr(node):
        return unsetTypeId()
    let expr = unit.ast.exprAt(node)
    let name = decodeRange(bytes = tempUtf8Bytes(unit.text), start = expr.nameStart, end = expr.nameEnd)
    let at = lookupName(stack = scope, spelling = name)
    if at < 0:
        return unsetTypeId()
    let typeId = scope.locals[at].typeId
    if typeId < 0 || typeId >= len(pool.entries):
        return unsetTypeId()
    return typeId

; 已判定数：含错误标记，只排除未写。
settledCount|func(table: ExprTypes, unit: I32,) -> (I32,):
    if unit < 0 || unit >= len(table.units):
        return 0
    var total = 0
    var i = 0
    while i < len(table.units[unit].types):
        if table.units[unit].types[i] != unsetTypeId():
            total = total + 1
        i = i + 1
    return total

; 有效类型数：只数非负下标，错误标记不计。
validCount|func(table: ExprTypes, unit: I32,) -> (I32,):
    if unit < 0 || unit >= len(table.units):
        return 0
    var total = 0
    var i = 0
    while i < len(table.units[unit].types):
        if table.units[unit].types[i] >= 0:
            total = total + 1
        i = i + 1
    return total

; 覆盖：错误标记也算判定过；首个未写给诊断定位。
typeCoverage|func(table: ExprTypes, unit: I32,) -> (TypeCoverage,):
    var out = TypeCoverage()
    if unit < 0 || unit >= len(table.units):
        return out
    let types = table.units[unit].types
    out.required = len(types)
    var i = 0
    while i < len(types):
        if types[i] != unsetTypeId():
            out.covered = out.covered + 1
        elif out.firstMissing < 0:
            out.firstMissing = i
        i = i + 1
    return out
