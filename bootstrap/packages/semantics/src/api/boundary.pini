[boundary|import]
_syntax = "../../../syntax"
_module_loader = "../../../module-loader"

; 包边界：按单元到包的映射判导入，不靠路径前缀猜归属。
; 三条判据：目标必须是工作区成员、目标必须写在本包声明依赖里、导入不得伸进对方的内部目录。
; 诊断按文件与偏移排好再返回，包图次序变化不改变序列。

; 边界错误：目标不是成员、依赖未声明与伸进内部实现三类。
[BoundaryKind]
boundaryUnknownTarget
boundaryUndeclared
boundaryInternal

; 边界错误：类别、文件、偏移、别名与归一后的目标路径。
(BoundaryError)
kind: BoundaryKind = .boundaryUnknownTarget
file: String = ""
offset: I32 = 0
alias: String = ""
target: String = ""

; 边界结果：错误表与失败标记；错误已按文件与偏移排序。
(BoundaryCheck)
errors: Array<BoundaryError> = []
failed: Bool = false

; 类别名：诊断、测试与回执共用一份拼写。
boundaryKindName|func(_kind: BoundaryKind,) -> (String,):
    match _kind:
        case boundaryUnknownTarget:
            return "导入目标不是工作区成员"
        case boundaryUndeclared:
            return "依赖未声明"
        case boundaryInternal:
            return "引用内部实现"
    return "边界错误"

; 同一类别判定：枚举相等比较不可用，按名称比。
isBoundaryError|func(error: BoundaryError, kind: BoundaryKind,) -> (Bool,):
    return boundaryKindName(error.kind) == boundaryKindName(kind)

; 诊断码：复用宿主已登记码，不新增码表条目；类别靠边界错误自身区分。
boundaryErrorCode|func(_kind: BoundaryKind,) -> (String,):
    return "E3-005"

; 造错误：位置取导入条目的起点，别名与目标由调用方给。
makeBoundaryError|func(kind: BoundaryKind, file: String, offset: I32, alias: String, target: String,) -> (BoundaryError,):
    var out = BoundaryError()
    out.kind = kind
    out.file = file
    out.offset = offset
    out.alias = alias
    out.target = target
    return out

; 追加错误：其余字段原样保留。
appendBoundaryError|func(out: BoundaryCheck, unit: CompilationUnit, offset: I32, kind: BoundaryKind, alias: String, target: String,) -> (BoundaryCheck,):
    var done = out
    done.errors = done.errors.append(makeBoundaryError(kind = kind, file = unit.path, offset = offset, alias = alias, target = target))
    return done

; 最后一个斜杠：无斜杠答 -1；路径是 ASCII，按字符下标扫即可。
lastSlash|func(_path: String,) -> (I32,):
    var at = -1
    var i = 0
    while i < len(_path):
        if _path[i] == "/":
            at = i
        i = i + 1
    return at

; 目录：最后一个斜杠之前的部分；无斜杠答空串。
dirOf|func(_path: String,) -> (String,):
    let at = lastSlash(_path)
    if at < 0:
        return ""
    return _path.substring(0, at)

; 折叠路径：丢掉空段与 `.`，遇到 `..` 弹回上一段。
collapseParts|func(_parts: Array<String>,) -> (Array<String>,):
    var out: Array<String> = []
    var i = 0
    while i < len(_parts):
        let part = _parts[i]
        if len(part) > 0 && part != ".":
            if part == "..":
                out = dropLastPart(out)
            else:
                out = out.append(part)
        i = i + 1
    return out

; 丢末段：空表原样返回。
dropLastPart|func(_parts: Array<String>,) -> (Array<String>,):
    var out: Array<String> = []
    if len(_parts) == 0:
        return out
    var i = 0
    while i < len(_parts) - 1:
        out = out.append(_parts[i])
        i = i + 1
    return out

; 拼路径：斜杠连接分段，空表答空串。
joinParts|func(_parts: Array<String>,) -> (String,):
    var out = ""
    var i = 0
    while i < len(_parts):
        if i > 0:
            out = out + "/"
        out = out + _parts[i]
        i = i + 1
    return out

; 归一导入：按文件所在目录折叠相对路径，得到工作区相对目录。
normalizeImport|func(unitPath: String, target: String,) -> (String,):
    return joinParts(collapseParts((dirOf(unitPath) + "/" + target).split("/")))

; 包命中：按分段前缀取最长匹配的包下标，未命中答 -1。
packageIndexAt|func(ws: WorkspaceUnits, target: String,) -> (I32,):
    let parts = target.split("/")
    var best = -1
    var bestLen = 0
    var i = 0
    while i < len(ws.packages):
        let root = ws.packages[i].rootPath.split("/")
        if partsStartWith(parts = parts, prefix = root) && len(root) > bestLen:
            best = i
            bestLen = len(root)
        i = i + 1
    return best

; 内部目录：包根之后的分段里只要有一段以下划线开头，即伸进内部实现。
internalWithin|func(rootPath: String, target: String,) -> (Bool,):
    let root = rootPath.split("/")
    let parts = target.split("/")
    var i = len(root)
    while i < len(parts):
        if startsWithUnderscore(parts[i]):
            return true
        i = i + 1
    return false

; 依赖已声明：整串相等即命中。
hasRequirement|func(requires: Array<String>, name: String,) -> (Bool,):
    var i = 0
    while i < len(requires):
        if requires[i] == name:
            return true
        i = i + 1
    return false

; 导入块：逐条取别名与路径，归一后按三条判据分流。
checkImportBlock|func(ws: WorkspaceUnits, group: PackageUnits, unit: CompilationUnit, bytes: Array<U8>, decl: DeclNode, out: BoundaryCheck,) -> (BoundaryCheck,):
    var working = out
    var i = 0
    while i < len(decl.kids):
        let entry = unit.ast.decls[decl.kids[i]]
        if isImportEntryCode(entry.kind) && len(entry.kids) > 0:
            let path = unit.ast.exprAt(entry.kids[0])
            let raw = decodeRange(bytes = bytes, start = path.start + 1, end = path.end - 1)
            let target = normalizeImport(unitPath = unit.path, target = raw)
            let alias = decodeRange(bytes = bytes, start = entry.nameStart, end = entry.nameEnd)
            let at = packageIndexAt(ws = ws, target = target)
            if at < 0:
                working = appendBoundaryError(out = working, unit = unit, offset = entry.start, kind = .boundaryUnknownTarget, alias = alias, target = target)
            elif ws.packages[at].name != group.name:
                if internalWithin(rootPath = ws.packages[at].rootPath, target = target):
                    working = appendBoundaryError(out = working, unit = unit, offset = entry.start, kind = .boundaryInternal, alias = alias, target = target)
                elif !hasRequirement(requires = group.requires, name = ws.packages[at].name):
                    working = appendBoundaryError(out = working, unit = unit, offset = entry.start, kind = .boundaryUndeclared, alias = alias, target = target)
        i = i + 1
    return working

; 单元导入：只认导入块，其余声明不归本层。
checkUnitImports|func(ws: WorkspaceUnits, group: PackageUnits, unit: CompilationUnit, out: BoundaryCheck,) -> (BoundaryCheck,):
    let bytes = unitBytes(unit)
    var working = out
    var i = 0
    while i < len(unit.ast.items):
        let decl = unit.ast.decls[unit.ast.items[i]]
        if isImportBlockCode(decl.kind):
            working = checkImportBlock(ws = ws, group = group, unit = unit, bytes = bytes, decl = decl, out = working)
        i = i + 1
    return working

; 错误次序：先按文件字节序，再按偏移升序；同位置再按类别名定序。
compareBoundaryErrors|func(first: BoundaryError, second: BoundaryError,) -> (I32,):
    let order = compareSourcePaths(first = first.file, second = second.file)
    if order != 0:
        return order
    if first.offset < second.offset:
        return -1
    if first.offset > second.offset:
        return 1
    return compareSourcePaths(first = boundaryKindName(first.kind), second = boundaryKindName(second.kind))

; 取前段：左闭右开。
takeBoundaryErrors|func(values: Array<BoundaryError>, from: I32, to: I32,) -> (Array<BoundaryError>,):
    var out: Array<BoundaryError> = []
    var i = from
    while i < to && i < len(values):
        out = out.append(values[i])
        i = i + 1
    return out

; 归并：两段各自有序，合并后整段有序。
mergeBoundaryErrors|func(left: Array<BoundaryError>, right: Array<BoundaryError>,) -> (Array<BoundaryError>,):
    var out: Array<BoundaryError> = []
    var i = 0
    var j = 0
    while i < len(left) && j < len(right):
        if compareBoundaryErrors(first = left[i], second = right[j]) <= 0:
            out = out.append(left[i])
            i = i + 1
        else:
            out = out.append(right[j])
            j = j + 1
    while i < len(left):
        out = out.append(left[i])
        i = i + 1
    while j < len(right):
        out = out.append(right[j])
        j = j + 1
    return out

; 排序：稳定归并，同一输入两次得同一序列。
sortBoundaryErrors|func(_values: Array<BoundaryError>,) -> (Array<BoundaryError>,):
    if len(_values) <= 1:
        return _values
    let mid = len(_values) / 2
    let left = sortBoundaryErrors(takeBoundaryErrors(values = _values, from = 0, to = mid))
    let right = sortBoundaryErrors(takeBoundaryErrors(values = _values, from = mid, to = len(_values)))
    return mergeBoundaryErrors(left = left, right = right)

; 对账入口：按包序走全部单元，收齐错误后统一排序。
checkWorkspaceImports|func(_ws: WorkspaceUnits,) -> (BoundaryCheck,):
    var out = BoundaryCheck()
    var p = 0
    while p < len(_ws.packages):
        let group = _ws.packages[p]
        var u = 0
        while u < len(group.units):
            out = checkUnitImports(ws = _ws, group = group, unit = group.units[u], out = out)
            u = u + 1
        p = p + 1
    out.errors = sortBoundaryErrors(out.errors)
    out.failed = len(out.errors) > 0
    return out
