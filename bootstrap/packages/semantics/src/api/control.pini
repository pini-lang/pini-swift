[control|import]
_syntax = "../../../syntax"
_module_loader = "../../../module-loader"

; 分支、循环、匹配与延迟：条件定型、遍历绑定、循环深度、匹配臂作用域与延迟记录。
; 条件或目标判不出时只放过该项，模式本身照查：名字解析归解析表，本层不越界报未定义。
; 循环变量落循环帧、匹配绑定落臂帧，体内可见、出帧截断；延迟体另开块帧，自身只记录。

; 条件定型：先读类型表，未写且是基本字面量时按无期望补判；全为 Bool 才放行。
checkCondition|func(unit: CompilationUnit, unitIndex: I32, node: I32, out: StoreCheck,) -> (StoreCheck,):
    var working = out
    if node < 0 || node >= unit.ast.exprCount():
        return working
    let typed = checkInitializer(unit = unit, unitIndex = unitIndex, node = node, expected = -1, name = "", out = working)
    working = typed.check
    if typed.typeId < 0 || typed.typeId >= len(working.pool.entries):
        return working
    if isBoolType(pool = working.pool, id = typed.typeId):
        return working
    let got = storeTypeText(pool = working.pool, id = typed.typeId)
    let offset = unit.ast.exprAt(node).start
    return appendStoreError(out = working, unit = unit, offset = offset, kind = .storeConditionNotBool, name = "", op = "", expected = "Bool", got = got)

; 遍历元素：字典按键、值两字段，数组与集合按一个元素字段；其余形态答空表。
loopComponents|func(pool: TypePool, id: I32,) -> (Array<I32>,):
    var out: Array<I32> = []
    if id < 0 || id >= len(pool.entries):
        return out
    let name = containerNameOf(pool = pool, id = id)
    if name == "Dictionary":
        out = out.append(keyTypeOf(pool = pool, id = id))
        out = out.append(valueTypeOf(pool = pool, id = id))
        return out
    if name == "Array" || name == "Set":
        out = out.append(elementTypeOf(pool = pool, id = id))
        return out
    return out

; 模式字段：元组模式逐位取子节点，单名模式自成一位；越界答空表。
loopPatternFields|func(unit: CompilationUnit, pattern: I32,) -> (Array<I32>,):
    var out: Array<I32> = []
    if pattern < 0 || pattern >= unit.ast.exprCount():
        return out
    if unit.ast.isTupleExpr(pattern):
        return unit.ast.exprAt(pattern).kids
    return out.append(pattern)

; 声明一个遍历字段：只收名字与 `_`，占位不占局部；名字按元素类型入循环帧。
declareLoopField|func(out: StoreCheck, unit: CompilationUnit, kid: I32, typeId: I32,) -> (StoreCheck,):
    if !unit.ast.isIdentifierExpr(kid):
        let offset = unit.ast.exprAt(kid).start
        return appendStoreError(out = out, unit = unit, offset = offset, kind = .storeBadLoopPattern, name = "", op = "", expected = "名字或占位", got = "其他形态")
    let expr = unit.ast.exprAt(kid)
    let name = decodeRange(bytes = unitBytes(unit), start = expr.nameStart, end = expr.nameEnd)
    if name == "_":
        return out
    return declareStoreAs(out = out, unit = unit, kind = .localLoopVar, name = name, typeId = typeId, mutable = true, offset = expr.start)

; 条件语句：逐个分支查条件再走块；末位落单的是 else 块，没有条件可查。
walkIfStmt|func(world: MemberWorld, unit: CompilationUnit, unitIndex: I32, stmtId: I32, out: StoreCheck,) -> (StoreCheck,):
    let kids = unit.ast.stmtAt(stmtId).kids
    let count = len(kids)
    var done = out
    if count > 0:
        done = checkCondition(unit = unit, unitIndex = unitIndex, node = kids[0], out = done)
    if count > 1:
        done = walkStoreStmt(world = world, unit = unit, unitIndex = unitIndex, stmtId = kids[1], out = done)
    var i = 2
    while i < count:
        if i + 1 < count:
            done = checkCondition(unit = unit, unitIndex = unitIndex, node = kids[i], out = done)
            done = walkStoreStmt(world = world, unit = unit, unitIndex = unitIndex, stmtId = kids[i + 1], out = done)
            i = i + 2
        else:
            done = walkStoreStmt(world = world, unit = unit, unitIndex = unitIndex, stmtId = kids[i], out = done)
            i = i + 1
    return done

; 循环语句：条件在循环外判，体与 step 块都在循环帧内走。
walkWhileStmt|func(world: MemberWorld, unit: CompilationUnit, unitIndex: I32, stmtId: I32, out: StoreCheck,) -> (StoreCheck,):
    let kids = unit.ast.stmtAt(stmtId).kids
    var done = checkCondition(unit = unit, unitIndex = unitIndex, node = kids[0], out = out)
    done.scope = enterScope(stack = done.scope, kind = .scopeLoop, file = unit.path, offset = unit.ast.stmtAt(stmtId).start)
    done.loopDepth = out.loopDepth + 1
    if len(kids) > 1:
        done = walkStoreStmt(world = world, unit = unit, unitIndex = unitIndex, stmtId = kids[1], out = done)
    if len(kids) > 2:
        done = walkStoreStmt(world = world, unit = unit, unitIndex = unitIndex, stmtId = kids[2], out = done)
    done.scope = leaveScope(done.scope)
    done.loopDepth = out.loopDepth
    return done

; 遍历语句：集合定型后按字段个数绑定循环变量，体与 step 块共用同一个循环帧。
walkForStmt|func(world: MemberWorld, unit: CompilationUnit, unitIndex: I32, stmtId: I32, out: StoreCheck,) -> (StoreCheck,):
    let kids = unit.ast.stmtAt(stmtId).kids
    if len(kids) < 2:
        return out
    let pattern = kids[0]
    let iter = kids[1]
    var done = out
    let typed = checkInitializer(unit = unit, unitIndex = unitIndex, node = iter, expected = -1, name = "", out = done)
    done = typed.check
    var components: Array<I32> = []
    if typed.typeId >= 0 && typed.typeId < len(done.pool.entries):
        components = loopComponents(pool = done.pool, id = typed.typeId)
        if len(components) == 0:
            let got = storeTypeText(pool = done.pool, id = typed.typeId)
            let offset = unit.ast.exprAt(iter).start
            done = appendStoreError(out = done, unit = unit, offset = offset, kind = .storeNotIterable, name = "", op = "", expected = "数组、字典或集合", got = got)
    let fields = loopPatternFields(unit = unit, pattern = pattern)
    if len(components) > 0 && len(fields) != len(components):
        let expected = countText(len(components))
        let got = countText(len(fields))
        let offset = unit.ast.exprAt(pattern).start
        done = appendStoreError(out = done, unit = unit, offset = offset, kind = .storeIterableArity, name = "", op = "", expected = expected, got = got)
    done.scope = enterScope(stack = done.scope, kind = .scopeLoop, file = unit.path, offset = unit.ast.stmtAt(stmtId).start)
    done.loopDepth = out.loopDepth + 1
    var i = 0
    while i < len(fields):
        var typeId = -1
        if i < len(components):
            typeId = components[i]
        done = declareLoopField(out = done, unit = unit, kid = fields[i], typeId = typeId)
        i = i + 1
    if len(kids) > 2:
        done = walkStoreStmt(world = world, unit = unit, unitIndex = unitIndex, stmtId = kids[2], out = done)
    if len(kids) > 3:
        done = walkStoreStmt(world = world, unit = unit, unitIndex = unitIndex, stmtId = kids[3], out = done)
    done.scope = leaveScope(done.scope)
    done.loopDepth = out.loopDepth
    return done

; 跳出与继续：只在循环内成立；带标签的形态随语法补面接入，判据不变。
checkLoopControl|func(unit: CompilationUnit, stmtId: I32, keyword: String, out: StoreCheck,) -> (StoreCheck,):
    if out.loopDepth > 0:
        return out
    return appendStoreError(out = out, unit = unit, offset = unit.ast.stmtAt(stmtId).start, kind = .storeLoopControlOutside, name = "", op = keyword, expected = "循环内", got = "循环外")

; 合并臂错误：把补报的几条接在匹配面记录之后，顺序按臂的源序。
appendArmErrors|func(left: Array<MatchError>, right: Array<MatchError>,) -> (Array<MatchError>,):
    var out = left
    var i = 0
    while i < len(right):
        out = out.append(right[i])
        i = i + 1
    return out

; 记臂绑定：把臂帧新增的局部接进声明清单，起点取进帧前的局部数。
recordArmLocals|func(declared: Array<LocalSymbol>, scope: ScopeStack, from: I32,) -> (Array<LocalSymbol>,):
    var out = declared
    var i = from
    while i < len(scope.locals):
        out = out.append(scope.locals[i])
        i = i + 1
    return out

; 匹配语句：主体类型先补进类型表，再复用匹配面判臂与穷尽性，最后逐臂进帧绑定、走臂体。
; 主体判不出时匹配面按待定放过，绑定名仍入臂帧供体内解析，类型留未定。
; 同一错误只报一次：臂绑定只在匹配面待定时补报，其余情况以匹配面的记录为准。
walkMatchStmt|func(world: MemberWorld, unit: CompilationUnit, unitIndex: I32, stmtId: I32, out: StoreCheck,) -> (StoreCheck,):
    let ast = unit.ast
    let kids = ast.stmtAt(stmtId).kids
    var working = out
    if len(kids) < 1:
        return working
    let subjectType = typeOfExprNode(unit = unit, unitIndex = unitIndex, node = kids[0], scope = working.scope, types = working.types, pool = working.pool)
    if subjectType >= 0:
        working.types = writeExprType(table = working.types, unit = unitIndex, node = kids[0], typeId = subjectType)
    let checked = checkMatch(world = world, unit = unit, unitIndex = unitIndex, stmt = stmtId, types = working.types)
    working.matchCheck = checked
    var i = 1
    while i + 1 < len(kids):
        let before = len(working.scope.locals)
        let bound = bindArm(world = world, unit = unit, subjectType = subjectType, patternNode = kids[i], scope = working.scope)
        working.scope = bound.scope
        working.declared = recordArmLocals(declared = working.declared, scope = working.scope, from = before)
        if checked.deferred:
            var merged = working.matchCheck
            merged.errors = appendArmErrors(left = merged.errors, right = bound.errors)
            working.matchCheck = merged
        working = walkStoreStmt(world = world, unit = unit, unitIndex = unitIndex, stmtId = kids[i + 1], out = working)
        working.scope = leaveScope(working.scope)
        i = i + 2
    return working

; 延迟语句：语句本身记入清单供 IR 排清理栈，体按独立块帧走，体内绑定不外泄。
; 与 return 的交互不在本层门禁：IR 契约把这条列为覆盖缺口，检查面只保证体被走一遍。
walkDeferStmt|func(world: MemberWorld, unit: CompilationUnit, unitIndex: I32, stmtId: I32, out: StoreCheck,) -> (StoreCheck,):
    var working = out
    working.defers = working.defers.append(stmtId)
    let body = unit.ast.stmtChild(id = stmtId, index = 0)
    if body < 0:
        return working
    return walkStoreStmt(world = world, unit = unit, unitIndex = unitIndex, stmtId = body, out = working)
