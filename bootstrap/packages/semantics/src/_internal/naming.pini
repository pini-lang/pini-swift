[naming|import]
_unicode = "../../../unicode"

; 字节区间解码：按标量取回名字原文；遇到非法序列就地收尾，返回已解出的前缀。
decodeRange|func(bytes: Array<U8>, start: I32, end: I32,) -> (String,):
    var out = ""
    var i = start
    while i < end:
        let unit = decodeScalarAt(bytes = bytes, offset = i)
        if unit.length == 0:
            return out
        out = out + "\(chr(unit.code))"
        i = i + unit.length
    return out

; 名字键：区间内折成 NFC 字节键。判等与查找只用键，原始拼写不参与比较。
keyOf|func(bytes: Array<U8>, start: I32, end: I32,) -> (Array<U8>,):
    return identifierKeyBytes(bytes = bytes, start = start, end = end)

; 下划线前缀：只看首字符，空串答否。
startsWithUnderscore|func(_text: String,) -> (Bool,):
    if len(text) == 0:
        return false
    return text.substring(0, 1) == "_"

; 末段：最后一个斜杠之后的部分；无斜杠时整串即末段。
lastSegment|func(_path: String,) -> (String,):
    let parts = path.split("/")
    if len(parts) == 0:
        return path
    return parts[len(parts) - 1]

; 目录链：末段之外的分段里只要有一段以 `_` 开头，声明即降为包级可见。
directoryHasUnderscore|func(_path: String,) -> (Bool,):
    let parts = path.split("/")
    var i = 0
    while i < len(parts) - 1:
        if startsWithUnderscore(parts[i]):
            return true
        i = i + 1
    return false

; 可见性推导：符号 `_` 取 private，文件名 `_` 取 internal，目录 `_` 取 package，其余 public。
visibilityOf|func(spelling: String, path: String,) -> (Visibility,):
    if startsWithUnderscore(spelling):
        return visibilityPrivate
    if startsWithUnderscore(lastSegment(path)):
        return visibilityInternal
    if directoryHasUnderscore(path):
        return visibilityPackage
    return visibilityPublic

; 整串取键：短名字与测试的便利入口，等价于对全长调 keyOf。
keyOfText|func(_text: String,) -> (Array<U8>,):
    let bytes = tempUtf8Bytes(text)
    return keyOf(bytes = bytes, start = 0, end = len(bytes))
