; 家族样例：整份读写走新节点，指针走取址与读写；两条路都要能被链接执行。
; 可接住写走失败路径时不得陷阱，程序应继续跑到最后一条打印。
main|func() -> (I32,):
    let path = "/tmp/pini-family-fixture.txt"
    writeFile(path, "一行")
    let back = readFile(path)
    print(back)
    var x: I32 = 5
    let p = &x
    store(p, 9)
    if load(p) == 9:
        print("九")
    let bad = tryWriteFile("/tmp/pini-no-such-dir/x.txt", "x")
    print("续")
    return 0
