; 判定标签：布尔读数一律折成文字，两侧输出才好逐行比。
标记|func(_b: Bool,) -> (String,):
    if _b:
        return "真"
    return "假"

; 一行读数：标签、结果、字素长度；长度按 Pini 的 len 计，两侧的差直接可读。
行|func(_标签: String, _值: String,) -> ():
    print(_标签 + "=[" + _值 + "] len=", len(_值))
    return

; 一致区：ASCII 与中日韩，两套实现的口径本应相同，逐行必须相等。
一致区|func() -> ():
    print("== 一致区 ==")
    print("trim|[" + "  pad  ".trim() + "]")
    print("trim-tab|[" + "\tpad\t".trim() + "]")
    print("startsWith|" + 标记("hello".startsWith("he")))
    print("startsWith-empty|" + 标记("hello".startsWith("")))
    print("startsWith-long|" + 标记("hello".startsWith("hello!")))
    print("startsWith-cjk|" + 标记("皮尼".startsWith("皮")))
    print("endsWith|" + 标记("hello".endsWith("lo")))
    print("endsWith-empty|" + 标记("hello".endsWith("")))
    print("endsWith-cjk|" + 标记("皮尼".endsWith("尼")))
    print("replace-empty|[" + "abc".replace("", "x") + "]")
    print("replace|[" + "aaaa".replace("aa", "b") + "]")
    print("replace-miss|[" + "abc".replace("z", "x") + "]")
    print("repeat-zero|[" + "ab".repeat(0) + "]")
    print("repeat|[" + "ab".repeat(2) + "]")
    print("padLeft|[" + "7".padLeft(3, "0") + "]")
    print("padLeft-wide|[" + "7".padLeft(1, "0") + "]")
    print("padLeft-fill|[" + "7".padLeft(4, "ab") + "]")
    print("padRight|[" + "7".padRight(3, "0") + "]")
    print("padRight-fill|[" + "7".padRight(4, "ab") + "]")
    print("lastIndexOf|", "abcabc".lastIndexOf("bc"))
    print("lastIndexOf-empty|", "abc".lastIndexOf(""))
    print("isEmpty|" + 标记("".isEmpty()))
    print("isEmpty-space|" + 标记(" ".isEmpty()))
    print("count|", "aaaa".count("aa"))
    print("count-empty|", "abc".count(""))
    print("stripPrefix|[" + "prefix-body".stripPrefix("prefix-") + "]")
    print("stripSuffix|[" + "body-suffix".stripSuffix("-suffix") + "]")
    print("ensurePrefix|[" + "body".ensurePrefix("pre-") + "]")
    print("ensurePrefix-hit|[" + "pre-body".ensurePrefix("pre-") + "]")
    print("ensureSuffix|[" + "body".ensureSuffix("-post") + "]")
    print("ensureSuffix-hit|[" + "body-post".ensureSuffix("-post") + "]")
    print("reversed|[" + "abc".reversed() + "]")
    print("capitalized|[" + "abc".capitalized() + "]")
    print("capitalized-empty|[" + "".capitalized() + "]")
    print("center|[" + "x".center(5, "-") + "]")
    print("center-wide|[" + "x".center(1, "-") + "]")
    print("truncate|[" + "abcdef".truncate(3) + "]")
    print("truncate-zero|[" + "abc".truncate(0) + "]")
    print("truncate-long|[" + "abc".truncate(99) + "]")
    print("repeat-negative|[" + "ab".repeat(-1) + "]")
    print("padLeft-zero|[" + "7".padLeft(0, "0") + "]")
    print("padRight-zero|[" + "7".padRight(0, "0") + "]")
    print("center-zero|[" + "7".center(0, "-") + "]")
    print("center-negative|[" + "7".center(-3, "-") + "]")
    return

; 分叉区：组合序列、ZWJ 家庭与旗帜；Pini 按字素，C 内核按码位，差在此显形。
分叉区|func() -> ():
    print("== 分叉区 ==")
    行("reversed-comb", "é".reversed())
    行("truncate-comb", "é".truncate(1))
    print("lastIndexOf-comb|", "éx".lastIndexOf("x"))
    print("startsWith-comb|" + 标记("é".startsWith("e")))
    行("reversed-zwj", "👨‍👩‍👧".reversed())
    行("truncate-zwj", "👨‍👩‍👧".truncate(1))
    行("reversed-flag", "🇨🇳".reversed())
    行("capitalized-accent", "éclair".capitalized())
    行("padLeft-comb", "é".padLeft(3, "-"))
    行("center-comb", "é".center(4, "-"))
    return

; 对照入口：同一份源在两个装配下各跑一遍，脚本按分段比对输出。
main|func() -> ():
    一致区()
    分叉区()
    return
