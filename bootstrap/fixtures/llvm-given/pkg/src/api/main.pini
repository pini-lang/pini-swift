; 默认实例样例：惰性物化、恰一次，显式实例另起一份；输出「造 7 7 造 7」。
; 取用点由编译器补在省略的 using 位，字段初值只在首次取用时求值。
次数|func() -> (I32,):
    print("造")
    return 7

[配置|given]
名称: String = "默认"
值: I32 = 次数()

取值|func(using 配: 配置,) -> (I32,):
    return 配.值

main|func() -> ():
    print(取值())
    print(取值())
    print(取值(配 = 配置()))
    return
