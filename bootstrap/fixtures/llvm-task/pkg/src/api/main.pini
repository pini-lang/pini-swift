; 并发样例：派发、同步等待、异步体内等待、分离与结果匹配；输出三行。
; 两臂都用命名的绑定：占位符 `_` 在宿主的绑定面上不成立。
子|func(_n: I32,) => (I32,):
    print(_n)
    return ok(_n)

静|func() => (I32,):
    return ok(0)

外|func() => (I32,):
    let f = 子(41)
    let r = await f
    match r:
        case ok(v,):
            print(v)
        case err(e,):
            print("输")
    return ok(0)

main|func() -> ():
    let q = 静()
    detach q
    let g = 外()
    let r = wait g
    match r:
        case ok(v,):
            print("终")
        case err(e,):
            print("输")
    return
