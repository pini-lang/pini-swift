; P1-4 标准库补全演示：字符串成员方法 + 数学自由函数
; 字符串方法以成员形式提供（s.upper()），数学库以自由函数形式提供（abs(x)）

main|func() -> ()
    var s = "Hello, World"
    print(s.upper())
    print(s.lower())
    print(s.contains("World"))
    print(s.substring(0, 5))
    print(s.split(","))

    var words = ["a", "b", "c"]
    print(words.join("-"))

    print(abs(-42))
    print(min(3, 9))
    print(max(3, 9))
    print(sqrt(25.0))
    print(sin(0.0))
    print(cos(0.0))
    print(tan(0.0))
    return
