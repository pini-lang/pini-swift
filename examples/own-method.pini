; 演示：|own 本型方法以类型名为接收者，覆盖结构体 / 对象体 / 给定体 / 枚举体
; 运行：pini run examples/own-method.pini
; 预期输出：7 / 2 / 9 / 3（四类载体各返回自己的常量）
(点)
x: I32 = 0

((点))
取数|own() -> (I32,):
    return 7

{计}
n: I32 = 0

{{计}}
取数|own() -> (I32,):
    return 2

[配置|given]
v: I32 = 5

[[配置]]
取数|own() -> (I32,):
    return 9

[形状]
圆(I32,)
方(I32,)

((形状))
取数|own() -> (I32,):
    return 3

main|func() -> ():
    print(点.取数())
    print(计.取数())
    print(配置.取数())
    print(形状.取数())
    return
