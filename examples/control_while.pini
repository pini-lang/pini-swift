; 控制流 while + break / continue / 带标签跳出
; 运行：pini run examples/control_while.pini
; 预期：0
;       1
;       2
;       1
;       3
;       5
;       0
;       1
;
; 说明：
;   - break 跳出最近的 while；continue 跳到循环头。
;   - 标签|控制流: 给控制流语句打标签（标签落在 while/for 上）；break 标签 / continue 标签 可跳出/续行到指定层（ADR-014）。

main|func() -> ()
    ; 基础 while
    var i = 0
    while i < 3:
        print(i)
        i = i + 1

    ; continue：跳过偶数，仅打印奇数
    var j = 0
    while j < 6:
        j = j + 1
        if j % 2 == 0:
            continue
        print(j)

    ; 带标签 break：从内层直接跳出外层循环（标签|控制流，ADR-014）
    var k = 0
    outer|while k < 3:
        var m = 0
        while m < 5:
            if m == 2:
                break outer
            print(m)
            m = m + 1
        k = k + 1
    return
