; ffi_module — FFI & unsafe 完整模块示例。运行 pini run examples/ffi_module/；pini check 同目录；pini test cstring.pini
; ① [ffilib|foreign] 声明外部 C 签名（块内自动 |unsafe，块名决定加载 lib/libffilib.{dylib,so}，raw 调用须与声明同文件）。
; ② *T + load/store/addressof（须不安全上下文）；③ |unsafe 内核 + 安全封装（消费方零 unsafe）；④ |test 块；⑤ main 演示两种调用。

; ── ① 外部接口声明（配置点：哪些 C 符号可用，签名即契约；均来自项目内 lib/ffilib）──
[ffilib|foreign]
ffi_malloc: (U64,) -> (*U8,)
ffi_free: (*U8,) -> ()
ffi_strlen: (*U8,) -> (U64,)
toCString: (String,) -> (*U8,) ; shim 白名单：Pini String → 调用方拥有的 C 字符串
ffi_puts: (*U8,) -> (I32,)
ffi_memcpy: (*U8, *U8, U64,) -> (*U8,)
ffi_memset: (*U8, I32, U64,) -> (*U8,)
ffi_atoi: (*U8,) -> (I32,) ; 裸 C 绑定：经 dlsym 从 libffilib 解析
ffi_strcmp: (*U8, *U8,) -> (I32,) ; 裸 C 绑定：经 dlsym 从 libffilib 解析

; ── ② 安全封装层：unsafe 内核（|unsafe 自由函数，函数体自动不安全上下文）──
; 把 Pini String 转 C 串量长度后立即释放，调用方无需触碰指针（返回 U64，由 strlen 提供）。
c串长度|unsafe(源: String,) -> (U64,):
    var p = toCString(源)
    var n = ffi_strlen(p)
    ffi_free(p)
    return n

; 分配 owned C 字符串副本并返回指针（调用方负责 free）。
c串复制|unsafe(源: String,) -> (*U8,):
    return toCString(源)

; 经 dlsym 裸 C 绑定把字符串解析为整数（返回 I32，调用方拿到的已是强类型值）。
c整型|unsafe(源: String,) -> (I32,):
    var p = toCString(源)
    var n = ffi_atoi(p)
    ffi_free(p)
    return n

; 堆字节分配 + 写入一个字节，返回 owned 缓冲（调用方在非 unsafe 上下文读取 / 释放）。
; 注：store 在 |unsafe 函数体内返回 ()，无需 load，故可正常收回 *U8 类型。
堆字节|unsafe(值: U8,) -> (*U8,):
    var buf = ffi_malloc(8)
    store(buf, 值)
    return buf

; ── ③ 安全函数（非 unsafe 上下文）：检查前置条件，仅解引用那一行加 unsafe 前缀 ──
; 「最小不安全范围」推荐写法：函数本身不在 unsafe 上下文，出错也只在那一行。
分配并写|func(值: I32,) -> (*U8,):
    if 值 < 0:
        print("分配并写: 负值被钳为 0")
        值 = 0
    var buf = unsafe ffi_malloc(8) ; unsafe 消耗点：单次不安全调用
    unsafe store(buf, 值) ; unsafe 消耗点：单次指针写（*U8 ⇒ 低字节）
    return buf

; ④ 语言级测试块（由 `pini test` 收集）：测试块本身非 unsafe 上下文，故经 unsafe 消耗点调用 unsafe 内核 / foreign 函数。
; 解释器 `==` 仅对 I32 可靠（U64 / U8 结果无法参与 `==`），故 |test 断言聚焦 I32 返回的 dlsym 裸绑定 atoi、strcmp；
; 其余路径（shim toCString/strlen、store/load、memcpy/memset）在 ⑤ main 经 golden 输出端到端验证。
裸绑定测试|test() -> ():
    var n: I32 = c整型("123")
    assert(n == 123, "dlsym atoi(\"123\") 应为 123")
    return

比较测试|test() -> ():
    var a = unsafe toCString("abc")
    var b = unsafe toCString("abc")
    var c: I32 = unsafe ffi_strcmp(a, b)
    assert(c == 0, "ffi_strcmp 相等应返回 0")
    unsafe ffi_free(a)
    unsafe ffi_free(b)
    return

; ── ⑤ 演示入口：raw 调用（unsafe 消耗点）+ 安全封装调用（消费方零 unsafe）──
main|func() -> ():
    ; 安全封装调用：消费方代码完全不出现 unsafe 关键字
    print("长度 =", c串长度("Pini FFI"))
    print("atoi =", c整型("4096"))
    ; 安全封装 + 非 unsafe 上下文读回（load 在此收回具体类型）
    var buf1 = 堆字节(7)
    print("填充字节 =", unsafe load(buf1))
    unsafe ffi_free(buf1)
    ; raw 调用（unsafe 消耗点演示指针原语与 foreign 函数）
    ; 注：load 对 *U8 按「有符号字节」解读，故值 ≥128 会显示为负数；这里用 100 避免歧义。
    var buf = 分配并写(100)
    print("堆字节 =", unsafe load(buf))
    unsafe ffi_free(buf)
    ; 指针原语：memset 填充 + memcpy 缓冲拷贝
    var a = unsafe ffi_malloc(4)
    unsafe ffi_memset(a, 7, 4)
    var b = unsafe ffi_malloc(4)
    unsafe ffi_memcpy(b, a, 4)
    print("拷贝字节 =", unsafe load(b))
    unsafe ffi_free(a)
    unsafe ffi_free(b)
    var raw = unsafe toCString("hello, FFI")
    unsafe ffi_puts(raw) ; ffi_puts 直写真实 stdout（绕过 outputSink；pini run 可见，进程内测试捕获不含此行）
    unsafe ffi_free(raw)
    return
