; 切片与负索引（G48 安全模型：负索引尾部计数、越界读返回 nil、切片半开区间 [i, j)）
; 运行：pini run examples/slice.pini
; 预期（逐行）：
;   [20, 30]            a[1:3]   半开区间
;   [10, 20]            a[:2]    开放起始
;   [40, 50]            a[3:]    开放末尾
;   [10, 20, 30, 40, 50] a[:]    全切片
;   [40, 50]            a[-2:]   负起始尾部计数
;   [10, 20, 30, 40]    a[:-1]   负末尾尾部计数
;   [20, 30, 40, 50]    a[1:100] 越界夹紧
;   []                  a[100:]  起始越界 → 空
;   50                  a[-1]    负索引单元素
;   null                a[100]   越界读返回 nil
;   ell                 s[1:4]   字符串切片
;   llo                 s[-3:]   字符串负起始
;   hell                s[:-1]   字符串负末尾
;   null                s[100]   字符串越界读返回 nil

main|func() -> ()
    var a = [10, 20, 30, 40, 50]
    print(a[1:3])
    print(a[:2])
    print(a[3:])
    print(a[:])
    print(a[-2:])
    print(a[:-1])
    print(a[1:100])
    print(a[100:])
    print(a[-1])
    print(a[100])

    var s = "hello"
    print(s[1:4])
    print(s[-3:])
    print(s[:-1])
    print(s[100])
    return
