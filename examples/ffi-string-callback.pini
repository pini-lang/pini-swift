; FFI 边界：`String` 形参借出成 `const char*`、内建 `fromCString` 取回、Pini 顶层函数当 C 回调。
; 运行：pini run examples/ffi-string-callback.pini / pini run-llvm examples/ffi-string-callback.pini
; 变参与字符串句柄另见 examples/ffi-varargs-handle.pini（只在 LLVM 通道成立）。
[libc|foreign]
strlen: (String,) -> (U64,) ; 形参位写 String：边界上借出 const char*，只在本次调用期有效
toCString: (String,) -> (*U8,) ; shim 白名单：复制一份 C 串归调用方，用完 free
free: (*U8,) -> ()
qsort: (*U8, U64, U64, (*U8, *U8,) -> (I32,),) -> () ; 末位形参是 C 函数指针

; 回调：只收顶层自由函数，形参与返回同 qsort 要的类型逐位相同。
; 注意 比较写成内联 load —— `var a = load(p)` 在 LLVM 通道会按窄宽度发 store，是既有缺陷。
比较字节|func(左: *U8, 右: *U8,) -> (I32,):
    if unsafe load(左) < unsafe load(右):
        return -1
    if unsafe load(左) > unsafe load(右):
        return 1
    return 0

main|func() -> ():
    ; 借出：String 直接进 String 形参，边界上临时编码，调用结束即失效
    print("长度 =", unsafe strlen("héllo"))
    ; toCString 造一个可写的 C 缓冲（内容 "ba"），归调用方持有
    var p = unsafe toCString("ba")
    print("排序前 =", fromCString(p))
    ; 回调：自由函数名直接填进函数指针位，不包适配器
    unsafe qsort(p, 2, 1, 比较字节)
    ; 取回：C 指针读成 Pini 串，复制一份归 Pini，随后可释放 C 的缓冲
    print("排序后 =", fromCString(p))
    unsafe free(p)
    return
