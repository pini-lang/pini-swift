; 标准库比较算法：成员判定与下标、去重、极值、稳定排序、有序判定、逐位相等
; 运行：pini run examples/stdlib-equality.pini
; 预期：八组读数依次为 成员 / 下标 / 去重 / 最小 / 最大 / 排序 / 有序 / 相等
main|func() -> ():
    print(contains<I32>([1, 2, 3], 2))
    print(indexOfElement<I32>([1, 2, 2], 2))
    print(unique<I32>([3, 1, 3, 2, 1]))
    print(minElement<I32>([3, 1, 2]))
    print(maxElement<I32>([3, 1, 2]))
    print(sorted<I32>([3, 1, 2, 1]))
    print(isSorted<I32>([1, 2, 2]))
    print(equalArrays<I32>([1, 2], [1, 2]))
    return
