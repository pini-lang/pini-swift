; 多维数组：`.get` 取 Optional + match 解构、嵌套下标读、写回外层槽。运行 pini run examples/multidim.pini
; 预期（解释器 / LLVM 一致）：6 / 8 / [[100, 2, 3], [4, 5, 6], [7, 8, 9]]
; 下标通道与越界语义见语言参考「下标访问」一节。

main|func() -> ():
    var m = [[1, 2, 3], [4, 5, 6], [7, 8, 9]]

    ; 安全路径：`.get(i)` 给 Optional，match 取元素（随处可用，无需 unsafe 上下文）
    var 行 = m[1]
    match 行.get(2):
        case some(v): print(v)      ; 期望 6
        case none: print(0)

    ; 强制解包路径：零散 `unsafe` 消耗点局部提供 unsafe 上下文（函数整体仍是安全的 |func）
    print(unsafe m[2][1])   ; 期望 8：m[2]→some([7,8,9])，! 剥出内层数组；[1]→some(8)，再 ! 取裸值

    ; 嵌套写：`!` 是只读右值、不能作 lvalue。
    ; 先强制解包取内层数组（须 unsafe），改本地副本，再显式写回外层槽。
    var row = m[0]
    row[0] = 100
    m[0] = row
    print(m)   ; 期望 [[100, 2, 3], [4, 5, 6], [7, 8, 9]]
    return
