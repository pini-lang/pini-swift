; 多维数组（严格枚举 + 强制解包 `!` 用法示范）—— issue-host-optional-slice-2026-08-28
; 运行：pini run examples/multidim.pini
;
; 核心规则：
;   · 下标读返回 Optional<T>（越界/缺键 → none，界内 → some(x)）；元素须靠 match 或 `!` 取出。
;   · 强制解包 `!` 剥开 some(x) 取裸值，命中 none 即 trap；`a[i]` 是只读右值，不能作 lvalue。
;   · `!` 与 `&` 同构，须处于 unsafe 上下文——可用 `|unsafe` 函数体，也可用零散的 `unsafe (...)`
;     消耗点局部消费。本例采用后者：函数本身是安全的 `|func`，仅那一处 `!` 被 `unsafe` 包住。
;   · 嵌套 `a[i][j]` 无隐式语法糖：必须先 `a[i]` 显式剥出内层数组，再下标。

main|func() -> ():
    var m = [[1, 2, 3], [4, 5, 6], [7, 8, 9]]

    ; 安全路径：match 取元素（随处可用，无需 unsafe 上下文）
    match m[1]:
        case some(row):
            match row[2]:
                case some(v): print(v)      ; 期望 6
                case none:
                    break
        case none:
            break

    ; 强制解包路径：零散 `unsafe` 消耗点局部提供 unsafe 上下文（函数整体仍是安全的 |func）
    print(unsafe m[2][1])   ; 期望 8：m[2]→some([7,8,9])，! 剥出内层数组；[1]→some(8)，再 ! 取裸值

    ; 嵌套写：`!` 是只读右值、不能作 lvalue。
    ; 先强制解包取内层数组（须 unsafe），改本地副本，再显式写回外层槽。
    var row = m[0]
    row[0] = 100
    m[0] = row
    print(m)   ; 期望 [[100, 2, 3], [4, 5, 6], [7, 8, 9]]
    return
