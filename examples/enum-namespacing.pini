; 跨枚举同名 case：case 名按枚举隔离，构造与匹配都按限定名寻址，
; 形状.圆 与 几何.圆 因此可共存、互不串味。本示例须零错误通过 `pini check`。
[形状]
圆(F64,)
矩形(F64, F64,)

[几何]
圆(F64, F64,)
线(F64,)

; 普通匹配：按被匹配值类型（形状）解析 case，跨枚举同名 圆 不串味
取形状半径|func(_s: 形状,) -> (F64,):
    match _s:
        case .圆(r,):
            return r
        case .矩形(w, h,):
            return w
    return 0.0

main|func() -> ():
    ; 限定构造 形状.圆 / 几何.圆 各自独立，证明同名 case 不冲突
    print(取形状半径(形状.圆(2.0)))
    print(取形状半径(形状.矩形(3.0, 4.0)))
    print(形状.圆(2.0))
    print(几何.圆(0.0, 3.0))
    ; 穷尽性校验：限定值 形状.圆(1.0) 把校验锁定到 形状，
    ; 跨枚举同名 case 不会误报穷尽性。
    match 形状.圆(1.0):
        case .圆(r,):
            print(r)
            return
        case .矩形(w, h,):
            print(w)
            return
    return
