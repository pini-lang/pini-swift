; defer：延迟执行（函数返回前按后进先出逆序运行）
; 运行：pini run examples/defer.pini
; 预期：bodyfirstmiddlelast
;       blockinnerouter
main|func() -> ()
    var result = ""

    var i = 0
    while i < 1:
        defer result = result + "last"
        defer result = result + "middle"
        defer result = result + "first"
        result = result + "body"
        i = i + 1
    print(result)

    result = ""

    var j = 0
    while j < 1:
        defer result = result + "outer"
        var k = 0
        while k < 1:
            defer result = result + "inner"
            result = result + "block"
            k = k + 1
        j = j + 1
    print(result)

    return
