; 公开 API：无 `_` 前缀 ⇒ public，跨文件（如 main.pini）可调用
公开API|func() -> (I32,)
    ; （合法）同文件内可访问本文件的 hard-private 函数 _私有助手（同文件恒可见）
    let r = _私有助手()
    return r + 100

; hard-private：符号名 `_` 前缀 ⇒ 硬私有，仅本文件可见
_私有助手|func() -> (I32,)
    return 7

; ── 字段级可见性演示（边缘情况，spec 2.5）──
; 公开类型 {金库}：无 `_` 前缀 ⇒ public，跨文件可见其类型名。
; 其字段 _密码 以 `_` 前缀 ⇒ type-private（仅 {金库} 自身方法可访问）。
; 方法查余额/验证 读取字段值：本版本类型检查器不把「字段读取」当作值表达式，
; 故声明为 -> ()（void，返回值运行时照常返回），与 object.pini 的 获取值 同款写法。
{金库}
余额: I32 = 0
_密码: I32 = 1234

{{金库}}
查余额|self() -> ()
    return self.余额
验证|self() -> ()
    return self._密码
