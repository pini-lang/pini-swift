; 真并发：两个 `=>` 进程交错执行（真实并发，非「末尾才并行」）。运行 pini run examples/concurrency.pini
; 预期：A / B 标记交错出现（如 A B A B …），证明两个 worker 同时推进；若某任务独占线程则不会交错，末尾 done 表示全部等待完成。
; 语义要点：`=>` 调用即派发到 worker 线程并返回 Future；`wait` 前缀 = 同步阻塞等待，`await` 用于异步体内挂起等待，均返回 Result。
workerA|func() => ():
    var i = 0
    while i < 4:
        print("A")
        sleep(30)
        i = i + 1
    return

workerB|func() => ():
    var i = 0
    while i < 4:
        print("B")
        sleep(30)
        i = i + 1
    return

; 带返回值与错误的进程：正常路径 ok(v)，失败路径 err(Error("..."))
compute|func(n: I32,) => (I32,):
    if n < 0:
        return err(Error("n 必须非负"))
    return ok(n * 2)

main|func() -> ():
    var a = workerA()
    var b = workerB()
    wait a
    wait b
    var r = wait compute(21)
    match r:
        case ok(v,):
            print(v)
        case err(e,):
            print(e)
    var bad = wait compute(0 - 1)
    match bad:
        case ok(v,):
            print(v)
        case err(e,):
            print(e)
    print("done")
    return
