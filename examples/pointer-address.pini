; 取址：`&x` 之后再写 x —— 解释器与 LLVM 都读真地址的新值
; 运行：pini run examples/pointer-address.pini / pini run-llvm examples/pointer-address.pini
; 预期输出：两通道都打 9；两通道按真引用同值，期望记在 examples/golden/pointer-address.pini.out
main|func() -> ():
    var x: I64 = 7
    var p = unsafe (&x)
    x = 9
    print(unsafe load(p))
    return
