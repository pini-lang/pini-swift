; higher-order.pini -- 高阶函数：函数作为一等值，传入另一函数并被调用
; 演示：1) 把具名函数当作实参传递(高阶)；2) 在函数体内调用函数类型参数 f(x)(B1 静态缺口已闭合)；3) 匿名函数直接调用
; 运行：pini run examples/higher-order.pini
; 预期输出：
; 10
; 21
; 36
应用|func(f: (I32,) -> (I32,), x: I32) -> (I32,)
    return f(x)

加倍|func(n: I32) -> (I32,)
    return n * 2

加一|func(n: I32) -> (I32,)
    return n + 1

main|func() -> ()
    print(应用(加倍, 5))      ; 10：传入具名函数
    print(应用(加一, 20))     ; 21：再传入另一个函数
    var g = func (n,) -> (I32,):
        return n * n
    print(g(6))              ; 36：匿名函数直接调用
    return
