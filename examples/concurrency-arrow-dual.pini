; 语法点 ③：前缀等待与中缀比较各占各的位置，类比 - 的 -x（前缀）与 a-b（中缀）：
;   操作数起始位（前面没有左值）→ 前缀「wait / 挂起 await」；
;   已取得左操作数 → 中缀「`<=` 比较」。位置不同读法不同，前缀等待不占中缀位。
fetch|func() => (I32,):
    sleep(20)
    return ok(7)

main|func() -> ():
    var f = fetch()
    var joined = wait f ; 前缀：wait f = 阻塞等待，拿到 Result<I32>
    var seven = 7
    var cmp = seven <= 7 ; 中缀：seven <= 7 = 比较（得到 true）
    print(cmp)
    match joined:
        case ok(v,):
            print(v) ; 打印 7
        case err(e,):
            print(e)
    return
